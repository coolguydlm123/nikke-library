rkorange","caption":"Overheat Lv. 2","size":"small"},{"tag":"Active","tone":"accent"},"Attacks more enemies when the Overheat effect is activated.","Every 12 s",["Self: attack speed +25% for 6 s","Self: +2 targets for 6 s","Self: splash area +150 for 6 s"],160],[{"img":"icn_skill_overheat_darkorange","caption":"Overheat Lv. 3","size":"small"},{"tag":"Active","tone":"accent"},"Enhances the Overheat effect and increases its duration.","Every 12 s",["Self: attack speed +35% for 8 s","Self: +3 targets for 8 s","Self: splash area +200 for 8 s"],320],[{"img":"icn_skill_rangeincrease_darkgrey","caption":"Increases attack range by 1 level.","size":"small"},{"tag":"Passive"},"Slightly increases the tower's attack range.","Always on",["Range +150"],210],[{"img":"icn_skill_rangeincrease_darkgrey","caption":"Increases attack range by 2 levels.","size":"small"},{"tag":"Passive"},"Increases the tower's attack range.","Always on",["Range +300"],280],[{"img":"icn_skill_rangeincrease_darkgrey","caption":"Increases attack range by 3 levels.","size":"small"},{"tag":"Passive"},"Significantly increases the tower's attack range.","Always on",["Range +450"],350]]},{"type":"table","title":"Pulse Gun Tower","sub":"A tower armed with a pulse rifle. It can penetrate Raptures' armor. Can attack aerial units.","note":"Unlocks: Lv. 3 from EX-2; Sniper Tower from EX-3; Rail Cannon Tower from EX-4.","columns":["Tower","Level",{"label":"Gold","num":true},{"label":"ATK","num":true},{"label":"DEF pen.","num":true},"Attack speed",{"label":"Range","num":true},"Attack","Hits","Special"],"rows":[[{"img":"tower_pulsegun_tower_lv1","caption":"Pulse Gun Tower I","size":"small"},"Lv. 1",80,16,"50%",{"text":"Average","sub":"30 RPM"},2350,"Bullet","Ground and air","Bosses first"],[{"img":"tower_pulsegun_tower_lv2","caption":"Pulse Gun Tower II","size":"small"},"Lv. 2",140,24,"60%",{"text":"Average","sub":"30 RPM"},2450,"Bullet","Ground and air","Bosses first"],[{"img":"tower_pulsegun_tower_lv3","caption":"Puls