is":"11111100000000000"},{"pid":"47e7893e-1bd7-468c-905e-bae94365a0ec","pos":[-1.257,26.08,33.613],"name":"Shop","layer":"npc","npcId":2790,"label":"Vending Machine","npcType":"Npc","does":[],"vis":"00001111111111111"},{"pid":"701b4800-f5fc-47a1-a94e-ff65fea0a644","pos":[-1.257,26.08,33.613],"name":"Shop - dis","layer":"npc","npcId":2789,"label":"NPC 9999999","npcType":"Npc","does":[],"vis":"11110000000000000"},{"pid":"a68e2192-8eef-449c-aec8-0acf03fbf306","pos":[-0.72,26.08,49.24],"name":"Story - 1","layer":"npc","npcId":2780,"label":"Journal","npcType":"Npc","does":[]},{"pid":"6da99f84-ef36-49ec-b09b-23e76fab7408","pos":[4.76,0.16,-11.06],"name":"Story - 2","layer":"npc","npcId":2782,"label":"BA-01 Lift","npcType":"Npc","does":[],"vis":"00000000001111111"},{"pid":"541b2fe1-2806-4b24-b3a6-3f10ecb1ae5d","pos":[4.76,0.16,-11.06],"name":"Story - 2 dis","layer":"npc","npcId":2781,"label":"NPC 9999999","npcType":"Npc","does":[],"vis":"11100000000000000"},{"pid":"2a9ce2f8-a153-42d8-a122-6f22424a9b5a","pos":[-8.305,26.2,19.262],"name":"4 Marian 1","layer":"npc","npcId":2791,"say":[["Maria-n","*Sigh...*"],["Maria-n","Oh, Doctor. It's nothing. Yeah... I'm okay."]],"label":"NPC 7035001","npcType":"Npc","does":[],"vis":"00000001000000000"},{"pid":"31ed103b-e327-4699-aeed-82261e4990df","pos":[6.865,26.04,31.502],"name":"4 Marian 2","layer":"npc","npcId":2792,"say":[["Maria-n","These Splendamin bars... I think\nI'm growing a little sick of them."],["Maria-n","Though, of course, this is my first\ntime having one in this body."]],"label":"NPC 7035001","npcType":"Npc","does":[],"vis":"00000001000000000"},{"pid":"0b4e354c-9939-44d5-a9c1-65eba442cf05","pos":[2.695,26.04,29.362],"name":"4 Marian 3","layer":"npc","npcId":2793,"say":[["Maria-n","Yeah, I don't think I could even count\nhow many of those we've eaten."],["Maria-n","Haha, same here."]],"label":"NPC 7035001","npcType":"Npc","does":[],"vis":"00000001000000000"},{"pid":"74645c37-92b3-4cfb-92fc-e4b7883f7daa","pos":[-11.685,26.14,48.962],"name":"4 Marian 4","layer":"npc","npcId":2794,"label":"NPC 7035005","npcType":"Npc","does":[],"vis":"00000001000000000"},{"pid":"d84e27b9-518a-41c2-9dc9-3f521b9cbd43","pos":[-14.885,13.56,8.972],"name":"4 Marian NPCTalk","layer":"npc","npcId":2795,"talk":[["Maria-n","Doctor, do you have a moment?"],["Doctor Maria","Huh? What is it?"],["Maria-n","I just don't really understand why I've been going on missions with those Commanders."],["Maria-n","This is something you and I should be doing together, but then suddenly they come along and... honestly, they're kind of... well..."],["Doctor Maria","Commanders help Nikkes produce better results. The Ark has proven as much again and again. Rather than complaining, try to get better at working with them."],["Doctor Maria","The results are what matter. We're not doing this for fun."],["Maria-n","That's... true... Yeah, you're right. The results are what matter."],["Maria-n","Haha. Sorry for complaining when you must be exhausted too."],["Doctor Maria","... Go and get ready."],["Maria-n","Yes, Doctor."]],"label":"NPC 7035014","npcType":"Npc","does":["NPCTalk"],"vis":"00000001000000000"},{"pid":"2a90da7e-99d0-44be-b584-63f8d9dd1d91","pos":[-8.33,26.061,44.804],"name":"6 Marian NPCTalk","layer":"npc","npcId":2803,"talk":[["Maria-n","We're not allowed to open this door."],["Maria-n","Why are you stopping me? We don't even know how to open it, anyway."],["Maria-n","I do. I'm the one who locked something behind it."],["Maria-n","What did you lock behind it?"],["Maria-n","... That's not something any of you need to know."],["Maria-n","If you're not going to tell us anything, step aside. I need to get out of here."],["Maria-n","Hurry up and step aside!"]],"label":"NPC 7035013","npcType":"Npc","does":["NPCTalk"],"vis":"00000000011100000"},{"pid":"939623a0-47f7-414b-b014-4ed4cdd641c7","pos":[-19.511,13.94,21.025],"name":"6 Marian confuse","layer":"npc","npcId":2801,"say":[["Maria-n","Everyone... has the same face..."],["Maria-n","Everyone... has the same voice..."]],"label":"NPC 7035002","npcType":"Npc","does":[],"vis":"00000000011100000"},{"pid":"c6f64dca-4822-4ce8-bd93-6ba2ec5bf262","pos":[20.675,17.23,13.322],"name":"6 Marian crying","layer":"npc","npcId":2798,"say":[["Maria-n","I'm not sure who you are, but I'll cry for you."],["Maria-n","*Sob, sob.*"]],"label":"NPC 7035012","npcType":"Npc","does":[],"vis":"00000000011100000"},{"pid":"27642528-030b-4b00-87f0-95b6929d0f06","pos":[-17.715,0.47,-1.558],"name":"6 Marian edge","layer":"npc","npcId":2796,"say":[["Maria-n","I'm sorry, but please go somewhere else."],["Maria-n","This is my spot. I must stay here."]],"label":"NPC 7035005","npcType":"Npc","does":[],"vis":"00000000011100000"},{"pid":"8187f8be-fb6a-49e5-9799-1d1f39ef0a98","pos":[-8.295,26.14,19.322],"name":"6 Marian happy","layer":"npc","npcId":2800,"say":[["Maria-n","Whoa, these stairs are so steep."],["Maria-n","One wrong step, and I might die.\nI should be careful."]],"label":"NPC 7035001","npcType":"Npc","does":[],"vis":"00000000011100000"},{"pid":"d7f70164-41e8-4d0b-9f65-6fbca536264e","pos":[1.645,26.14,33.092],"name":"6 Marian hungry","layer":"npc","npcId":2799,"say":[["Maria-n","I'm hungry... I need to eat Splendamin."],["Maria-n","Hngh... Why did I suddenly just gag...?"]],"label":"NPC 7035001","npcType":"Npc","does":[],"vis":"00000000011100000"},{"pid":"ff3bf5a7-b3b3-409a-894b-ec95881ae9c3","pos":[-8.895,0.172,-12.748],"name":"6 Marian mad","layer":"npc","npcId":2802,"say":[["Maria-n","Round and round and round and\nround and round and round!"]],"label":"NPC 7035001","npcType":"Npc","does":[],"vis":"00000000011100000"},{"pid":"c60acf42-45bb-4aea-8f0e-320f60d44036","pos":[35.291,17.23,20.509],"name":"6 Marian sad","layer":"npc","npcId":2797,"say":[["Maria-n","Oh... Why am I crying...?"]],"label":"NPC 7035011","npcType":"Npc","does":[],"vis":"00000000011100000"},{"pid":"5e0be828-df49-454f-a7b1-b1afe51d2269","pos":[23.594,0.34,-20.591],"name":"7 Marian NPCTalk","layer":"npc","npcId":2819,"talk":[["Maria-n","Listen to me. We have to stop arguing with each other."],["Maria-n","We must all work together to get out of here. I know the exit."],["Maria-n","This right here. I'm sure it's the exit. The ones who left before us said they'd come back if they hit a dead end."],["Maria-n","Since no one came back, that must mean this is the exit."],["Maria-n","Come on, everyone. Let's go. Let's get out of here."],["Maria-n","Let's all leave together. Come on now."],["Maria-n","Let's go. Hurry."],["Maria-n","Let's go. Let's go. Let's go. Let's go to die. Let's go."]],"label":"NPC 7035014","npcType":"Npc","does":["NPCTalk"],"vis":"00000000000011000"},{"pid":"ca7bb934-de0c-4e89-9b7e-7393bcfc0034","pos":[-17.815,0.4,-21.118],"name":"7 Marian aimed","layer":"npc","npcId":2812,"label":"NPC 7035006","npcType":"Npc","does":[],"vis":"00000000000011000"},{"pid":"632441cb-2180-4064-8f1a-94e8048f5d56","pos":[-18.825,13.59,20.422],"name":"7 Marian battle 1","layer":"npc","npcId":2815,"label":"NPC 7035007","npcType":"Npc","does":[],"vis":"00000000000011000"},{"pid":"49cb1eee-87ec-4762-a2a3-75c0e23f872a","pos":[13.005,17.25,15.092],"name":"7 Marian battle 2","layer":"npc","npcId":2816,"label":"NPC 7035007","npcType":"Npc","does":[],"vis":"00000000000011000"},{"pid":"f04c78a8-88de-47f4-a1a0-8bbe0491d862","pos":[13.005,17.25,10.302],"name":"7 Marian battle 3","layer":"npc","npcId":2817,"label":"NPC 7035007","npcType":"Npc","does":[],"vis":"00000000000011000"},{"pid":"710e7e5b-381b-4a45-b171-0694c97bb89b","pos":[10.845,26.14,36.092],"name":"7 Marian battle 4","layer":"npc","npcId":2818,"label":"NPC 7035007","npcType":"Npc","does":[],"vis":"00000000000011000"},{"pid":"9200eeaf-721b-46a0-b97b-2e339303f0be","pos":[-27.846,13.7,20.728],"name":"7 Marian crying","layer":"npc","npcId":2810,"label":"NPC 7035012","npcType":"Npc","does":[],"vis":"00000000000011000"},{"pid":"b480f9cc-f243-42a9-ad41-86718412c3bb","pos":[-8.225,26.14,45.202],"name":"7 Marian down 1","layer":"