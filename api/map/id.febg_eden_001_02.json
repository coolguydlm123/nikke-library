ge","npcType":"Npc","does":[]},{"pid":"8867816b-da7c-4816-9d1c-3e5ac164dcd8","pos":[-7.89,0.535,-8.73],"name":"Story 1","layer":"npc","npcId":1977,"label":"Hologram Projector","npcType":"Npc","does":[]},{"pid":"13fa5e7d-49ae-4641-819f-0d9f082e160c","pos":[21.81,0.16,-10.5],"name":"Story 2","layer":"npc","npcId":1979,"label":"Cecil","npcType":"Npc","does":[],"vis":"00000000000001111111"},{"pid":"0f217f46-90e3-4926-b112-b6869df1f9bd","pos":[21.81,0.16,-10.5],"name":"Story 2 dis","layer":"npc","npcId":1978,"label":"Cecil","npcType":"Npc","does":[],"vis":"00000000000000000000"},{"pid":"b6908814-5e6c-4614-86c2-3798ca6d67db","pos":[5.39,0.53,17.59],"name":"Cecil V1","layer":"npc","npcId":1986,"say":[["Cecil","I'm fine. But Eden..."],["Cecil","I didn't anticipate another attack this soon..."]],"label":"NPC 7027003","npcType":"Npc","does":[],"vis":"11000000000000000000"},{"pid":"ae45ca2c-0a13-49cc-b9c9-4bb451081be4","pos":[-2.25,0.53,16.29],"name":"Cecil V2","layer":"npc","npcId":1996,"say":[["Cecil","You..."],["Cecil","Assist with the supplies."]],"label":"NPC 7027003","npcType":"Npc","does":[],"vis":"00110000000000000000"},{"pid":"4497d69b-1c3f-4ae0-a9d1-50c8cc85447c","pos":[-21.85,8.53,43.38],"name":"Cecil V3","layer":"npc","npcId":1999,"say":[["Cecil","Yes, it's coming from up there. That must be the Queen."],["Cecil","The Raptures are likely to intensify their attacks. Stay vigilant."]],"label":"NPC 7027003","npcType":"Npc","does":[],"vis":"00001100000000000000"},{"pid":"f13e7333-ebce-4913-9fe8-1ef50fab90cb","pos":[35.78,-10.47,47.38],"name":"Cecil V4","layer":"npc","npcId":2002,"say":[["Cecil","All resources are being mobilized."],["Cecil","... Understood."]],"label":"NPC 7027003","npcType":"Npc","does":[],"vis":"00000011000000000000"},{"pid":"e818d93a-8f94-46e1-a2ba-9bb61365f342","pos":[25.91,-10.47,56.3],"name":"Cecil V5","layer":"npc","npcId":2004,"say":[["Cecil","... Noah."],["Cecil","I will make them pay with what you've protected."]],"label":"NPC 7027003","npcTy