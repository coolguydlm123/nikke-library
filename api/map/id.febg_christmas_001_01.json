00000000000000000000"},{"pid":"72fd3f7a-111c-4f50-8d68-638d07a4cf3e","pos":[11.99,0.05,11.78],"name":"NPC_Shop","layer":"npc","npcId":5,"label":"Neve","npcType":"Character","icon":"icons-char/si_c193_00_s","does":[]},{"pid":"6dbd20f3-629f-4667-8066-ce95c551a874","pos":[-9.69,0.05,-4.83],"name":"NPC_Story_01","layer":"npc","npcId":1,"label":"Rupee: Winter Shopper","npcType":"Character","icon":"icons-char/si_c203_00_s","does":[]},{"pid":"22cbc362-c5e3-43e9-8a05-bfb610a16c44","pos":[-5.58,0.05,-8.61],"name":"NPC_Stroy_02","layer":"npc","npcId":3,"label":"Anne: Miracle Fairy","npcType":"Character","icon":"icons-char/si_c121_00_s","does":[],"vis":"000000000000111111111111111"},{"pid":"30b022e2-8b65-44e6-b419-40b0212ef68e","pos":[-5.58,0.05,-8.61],"name":"NPC_Stroy_02_NoEvent","layer":"npc","npcId":2,"label":"Anne: Miracle Fairy","npcType":"Character","icon":"icons-char/si_c121_00_s","does":[],"vis":"111111111111000000000000000"},{"pid":"ba3d56d2-80c6-4977-9680-d1bc488d5c3a","pos":[19.72,0.05,-1.31],"name":"NPC_alice_V1","layer":"npc","npcId":8,"say":[["Alice","Rabbity, I think I saw something that looked like a star candy fall over there!"],["Alice","Welcome to a world of happiness!"]],"sayRandom":true,"label":"Alice","npcType":"Character","icon":"icons-char/si_c191_00_s","does":[],"vis":"111111111100000000000000000"},{"pid":"2c3e60c0-5e30-404e-8d67-eb2142a05e61","pos":[20.84,0.05,-3.15],"name":"NPC_alice_V2","layer":"npc","npcId":9,"say":[["Alice","Those shiny things on top of the snow... are they edible?"],["Alice","My teacup is filled with snow... it's more like a snow cone now."]],"sayRandom":true,"label":"Alice","npcType":"Character","icon":"icons-char/si_c191_00_s","does":[],"vis":"000000000011111111100000000"},{"pid":"97e2a69e-f416-479e-bcd8-db1efc1bc31e","pos":[7.41,0.05,-11.51],"name":"NPC_alice_V3","layer":"npc","npcId":10,"say":[["Alice","Isn't this place just so grand?"],["Alice","Whoa, that tree is huuuuge! And check out all the presents on it!"]],"sayRandom":true,"label":"Alice","npcType":"Character","icon":"icons-char/si_c191_00_s","does":[],"vis":"000000000000000000011110000"},{"pid":"e112fe80-54ca-44aa-8670-2b1f160f9741","pos":[6.45,0.05,-9.46],"name":"NPC_alice_V4","layer":"npc","npcId":11,"say":[["Alice","Every time I jump, I end up stumbling over the gifts. Hehe!"],["Alice","It's Christmas time, Rabbity! The time of year we can really relax and have some fun!"]],"sayRandom":true,"label":"Alice","npcType":"Character","icon":"icons-char/si_c191_00_s","does":[],"vis":"000000000000000000000001000"},{"pid":"611f50f9-d543-4a27-a4e6-b51c3fc34ebf","pos":[-12.3,0.05,-19.64],"name":"NPC_alice_V5","layer":"npc","npcId":12,"say":[["Alice","Hey, where'd all the snow go?"],["Alice","Guess it was a dream. It may have been short, but it sure was sweet."]],"sayRandom":true,"label":"Alice","npcType":"Character","icon":"icons-char/si_c191_00_s","does":[],"vis":"000000000000000000000000100"},{"pid":"6c1db96a-baa0-40e1-a8cb-b45df80bc1c7","pos":[13.65,0.05,0.65],"name":"NPC_ludmila_V1","layer":"npc","npcId":13,"say":[["Ludmilla","I should confirm this with Servant first."],["Ludmilla","Alice, you'd better not drink th... you already drank all of it?"]],"sayRandom":true,"label":"Ludmilla","npcType":"Character","icon":"icons-char/si_c190_00_s","does":[],"vis":"000000000011111111100000000"},{"pid":"30121cb6-a70a-416e-962a-a9799e64e999","pos":[0.97,0.05,-8.36],"name":"NPC_ludmila_V2","layer":"npc","npcId":14,"say":[["Ludmilla","Seems like we'll have a rather boisterous Christmas this year."],["Ludmilla","Servant, can you help me collect some decorations for the Christmas tree? There are plenty on the floor."]],"sayRandom":true,"label":"Ludmilla","npcType":"Character","icon":"icons-char/si_c190_00_s","does":[],"vis":"000000000000000000011110000"},{"pid":"821bd84f-e0c6-4c58-b87b-49c14467c507","pos":[-10.68,0.05,6.05],"name":"NPC_ludmila_V3","layer":"npc","npcId":15,"say":[["Ludmilla","I have been through many winters, but it has been a long time since I celebrated Christmas properly."],["Ludmilla","Merry Christmas. How about we have a cup of tea to remember this moment?"]],"sayRandom":true,"label":"Ludmilla","npcType":"Character","icon":"icons-char/si_c190_00_s","does":[],"vis":"000000000000000000000001000"},{"pid":"3e6939cc-caad-4e7d-a986-080f4a4b18f4","pos":[-20.71,0.05,-15.89],"name":"NPC_ludmila_V4","layer":"npc","npcId":16,"say":[["Ludmilla","... Is it already time to go back?"],["Ludmilla","I think I have a better understanding of Alice's fairyland now."]],"sayRandom":true,"label":"Ludmilla","npcType":"Character","icon":"icons-char/si_c190_00_s","does":[],"vis":"000000000000000000000000110"},{"pid":"806e518a-88ef-4b4e-a585-41fb7e334bcd","pos":[-17.369,0,-18.024],"name":"SquadSpawner","layer":"start","label":"Squad start"}],"timeline":{"states":[{"label":"Event opens","requires":"Nothing done yet","art":null,"items":{"shown":0,"added":0},"model":null,"walkable":null},{"label":"Day 1 16:00","requires":"from 2022-12-07 16:00 UTC","art":null,"items":{"shown":4,"added":4},"model":null,"walkable":null},{"label":"stage 7","requires":"event stage 7 cleared","art":null,"items":{"shown":4,"added":0},"model":null,"walkable":null},{"label":"Day 2 20:00","requires":"from 2022-12-08 20:00 UTC","art":null,"items":{"shown":5,"added":1},"model":null,"walkable":null},{"label":"Day 3 20:00","requires":"from 2022-12-09 20:00 UTC","art":null,"items":{"shown":6,"added":1},"model":null,"walkable":null},{"label":"Day 4 20:00","requires":"from 2022-12-10 20:00 UTC","art":null,"items":{"shown":7,"added":1},"model":null,"walkable":null},{"label":"Day 5 20:00","requires":"from 2022-12-11 20:00 UTC","art":null,"items":{"shown":8,"added":1},"model":null,"walkable":null},{"label":"Day 6 20:00","requires":"from 2022-12-12 20:00 UTC","art":null,"items":{"shown":9,"added":1},"model":null,"walkable":null},{"label":"Day 7 20:00","requires":"from 2022-12-13 20:00 UTC","art":null,"items":{"shown":10,"added":1},"model":null,"walkabl