10,"itemType":"BGM","label":"Music record","difficulty":"None","rewards":[{"name":"ARK BLUE (BGM)","amount":1}],"scene":null,"no":7,"vis":"0000000000011"},{"pid":"c281476a-f4b2-41e1-bc4b-19024afa98d6","pos":[-12.064,0.416,5.422],"name":"BGMItem_08","layer":"relic","id":55031011,"itemType":"BGM","label":"Music record","difficulty":"None","rewards":[{"name":"ARK BUSTER (BGM)","amount":1}],"scene":null,"no":8,"vis":"0000000000011"},{"pid":"84757522-6ba3-4823-a115-baff07679050","pos":[18.31,0.22,-27.76],"name":"Item_01","layer":"relic","id":55031001,"itemType":"HiddenItem","label":"Lost relic","difficulty":"None","rewards":[{"name":"Gem","amount":100}],"scene":null,"no":9,"vis":"0111111111111"},{"pid":"e04e2134-2340-4f13-a79d-5a3a0c0031c7","pos":[20.36,0.07,4.43],"name":"Item_02","layer":"relic","id":55031002,"itemType":"HiddenItem","label":"Lost relic","difficulty":"None","rewards":[{"name":"Gem","amount":100}],"scene":null,"no":10,"vis":"0000000001111"},{"pid":"7a9cce5a-d7b7-4bc1-9381-f8c160b73819","pos":[-8.36,10.092,20.43],"name":"Item_03","layer":"relic","id":55031003,"itemType":"HiddenItem","label":"Lost relic","difficulty":"None","rewards":[{"name":"Gem","amount":100}],"scene":null,"no":11,"vis":"0000000000011"},{"pid":"3ce3d76f-7b42-4c65-adfd-5020c4adedee","pos":[-8.81,10.673,-29.71],"name":"ArkRangerBlack_Phase1","layer":"npc","npcId":2430,"say":[["Ark Ranger Black","You'll never become a hero by doing things half-heartedly."],["Ark Ranger Black","Lift your head to the sky! ... No, that's not it.\nLift your head to the sky..! Hmm... no, that's\nnot quite right either."]],"sayRandom":true,"label":"Character 570","npcType":"Character","icon":"icons-char/si_c570_00_s","does":[],"vis":"1110000000000"},{"pid":"4748f7a7-154b-45de-8eff-c026214dfa82","pos":[31.038,0.347,-4.883],"name":"ArkRangerBlack_Phase3","layer":"npc","npcId":2431,"say":[["Ark Ranger Black","The cool suits, and the attack names..."],["Ark Ranger Black","It was all just playing at being a hero."],["Ark Ranger Black","I was never a real hero."]],"sayRandom":true,"label":"Character 570","npcType":"Character","icon":"icons-char/si_c570_00_s","does":[],"vis":"0000010000000"},{"pid":"3a21dedf-7f27-4c37-be5a-f6b01f40326e","pos":[16.67,13.97,16.3],"name":"ArkRangerBlack_Phase4","layer":"npc","npcId":2432,"say":[["Ark Ranger Black","It doesn't matter if I'm not a real hero."],["Ark Ranger Black","So long as I can inspire courage in people, I'll gladly play the fool."]],"sayRandom":true,"label":"Character 570","npcType":"Character","icon":"icons-char/si_c570_00_s","does":[],"vis":"0000001111111"},{"pid":"4562f68c-eecf-4662-9d37-289eea1c0fb8","pos":[14.81,-0.066,-18.87],"name":"ArkRangerBlack_Phase5","layer":"npc","npcId":2433,"say":[["Ark Ranger Black","You should try raising the pitch of your voice a little more."],["Ark Ranger Black","You've got talent. Honestly, I'm impressed."],["Ark Ranger Black","I don't think you're quite at that level."]],"label":"Character 570","npcType":"Character","icon":"icons-char/si_c570_00_s","does":[],"vis":"0011000000000"},{"pid":"b157c2bb-3ee8-43d7-8304-e5d85b1615a4","pos":[7.43,10.82,9.02],"name":"ArkRangerBlack_Phase7","layer":"npc","npcId":2434,"say":[["Ark Ranger Black","So long as there is courage in this world, we are invincible."],["Ark Ranger Black","Together with the Ark Buster once again... no, that would mean the Ark is in danger again."],["Ark Ranger Black","The Ark Rangers will always protect peace on the Ark! No matter what!"]],"label":"Character 570","npcType":"Character","icon":"icons-char/si_c570_00_s","does":[],"vis":"0000000100000"},{"pid":"dfb2bd1e-bcb6-4268-a58f-996c66ac96d3","pos":[7.43,10.82,9.02],"name":"ArkRangerBlack_Phase8","layer":"npc","npcId":2435,"say":[["Ark Ranger Black","Well done, Ark Buster."],["Ark Ranger Black","It's time to return to the world of television.\nBut that's all right. So long as we can inspire\ncourage, it doesn't matter where we are."],["Ark Ranger Black","To everyone out there watching, now is the time to become heroes."]],"label":"Character 570","npcType":"Character","icon":"icons-char/si_c570_00_s","does":[],"vis":"0000000011110"},{"pid":"ef08bc32-93d4-4ea4-88ed-0fdf9b595840","pos":[17.44,0.03,-0.82],"name":"Drake_Phase7","layer":"npc","npcId":2455,"say":[["Drake","Everywhere I go, it's nothing but heroes!\nAt this rate, villains will go extinct! We're\nbecoming an endangered species, I tell you!"],["Drake","If this keeps up, heroes will just keep multiplying! We need a villain quota system!"]],"sayRandom":true,"label":"Character 101","npcType":"Character","icon":"icons-char/si_c101_00_s","does":[],"vis":"0000000100000"},{"pid":"99f3e685-bb62-45e9-baf7-7dbfcae84c83","pos":[11.7,0,7.55],"name":"Laplace_Phase7","layer":"npc","npcId":2457,"say":[["Laplace","What incredible presence! It's massive! It looks so powerful!"],["Laplace","Maxwell! Let's build a robot that combines too! I've already come up with its name: Giga Matis!"]],"sayRandom":true,"label":"Character 100","npcType":"Character","icon":"icons-char/si_c100_00_s","does":[],"vis":"0000000100000"},{"pid":"86f67fe6-36cd-4fb6-bac8-bff39af0d844","pos":[-2.15,0,4.02],"name":"Maxwell_Phase7","layer":"npc","npcId":2456,"say":[["Maxwell","The Ark Buster certainly is impressive. But personally, I'd rather build a giant cannon with treads."],["Maxwell","The fact that Mustang created a robot that can combine is impressive. In more ways than one."]],"sayRandom":true,"label":"Character 102","npcType":"Character","icon":"icons-char/si_c102_00_s","does":[],"vis":"0000000100000"},{"pid":"529d689b-a1d8-40f0-8b6a-f110a9d78b95","pos":[13.38,-0.077,-17.55],"name":"Moran_Phase5","layer":"npc","npcId":2450,"say":[["Moran","Ohoho! Ohohoho!"],["Moran","Oh, really? What happens if I end up getting some kind of award?"],["Moran","... Ah, right. Thanks."]],"label":"Character 281","npcType":"Character","icon":"icons-char/si_c281_02_s","does":[],"vis":"0011000000000"},{"pid":"5fe9f023-17a0-4a75-9295-04ba9c70d04e","pos":[16.42,13.97,20.88],"name":"Moran_Phase8","layer":"npc","npcId":2451,"say":[["Moran","That was the best movie ever! But honestly, nothing beats the real thing!"],["Moran","... So I don't have to worry about swimsuit photo shoots anymore, right?"]],"sayRandom":true,"label":"Character 281","npcType":"Character","icon":"icons-char/si_c281_02_s","does":[],"vis":"0000000011110"},{"pid":"ee493456-019b-4baa-b1b3-70d851760b96","pos":[-4.489,10.26,13.12],"name":"Mustang_Phase6","layer":"npc","npcId":2453,"say":[["Mustang","At last! C'est le moment to launch these magnifique robots!"],["Mustang","Finally! Les héros of the Ark are back en l'action!"]],"sayRandom":true,"label":"NPC 7007001","npcType":"Npc","does":[],"vis":"0000111000000"},{"pid":"a33cb43c-9eab-4cc4-a7c8-bdbaeb7129b0","pos":[-4.489,10.26,13.12],"name":"Mustang_Phase7","layer":"npc","npcId":2454,"say":[["Mustang","Bien combattu, Ark Rangers. Et toi aussi, Ark Buster."],["Mustang","There's a certain grandeur to combining robots, non?"]],"sayRandom":true,"label":"NPC 7007001","npcType":"Npc","does":[],"vis":"0000000100000"},{"pid":"c685fa41-7e2a-45c9-83ba-d8b063a604d4","pos":[32.7,0,-21.06],"name":"PickupRobot_A_Phase1","layer":"npc","npcId":2440,"say":[["Pick-Up Robot","Standing by. Please enter a command."],["Pick-Up Robot","— Voice commands are not supported. Please input a text command."],["Pick-Up Robot","— Please refer to the manual and enter the relevant command."]],"sayRandom":true,"label":"NPC 7031006","npcType":"Npc","does":[],"vis":"1110000000000"},{"pid":"1592bf23-a4de-4046-9266-ddb84cdcc360","pos":[32.7,0,-21.06],"name":"PickupRobot_A_Phase2","layer":"npc","npcId":2441,"say":[["Pick-Up Robot","No command input detected. Initiating autonomous work mode."]],"sayRandom":true,"label":"NPC 7031006","npcType":"Npc","does":[],"vis":"0001100000000"},{"pid":"d34c0a4c-af42-40f9-8ad9-9e9c359eb759","pos":[22.543,10.09,17.554],"name":"RepairRobot_B_Phase1","layer":"npc","npcId":2446,"say":[["Maintenance Robot","Awaiting repair command input."],["Maintenance Robot","Unable to proceed without command input."]],"sayRandom":true,"label":"NPC 7031004","npcType":"Npc","does":[],"vis":"1110000000000"},{"pid":"774f5655-3e57-4ced-8ec1-13410279518d","pos":[22.543,10.09,17.554],"name":"RepairRobot_B_Phase2","layer":"npc","npcId":2447,"say":[["Maintenance Robot","Awaiting repair command input."],["Maintenance Robot","Unable to proceed without command input."]],"sayRandom":true,"label":"NPC 7031004","npcType":"Npc","does":[],"vis":"0001100000000"},{"pid":"1b96eb12-312f-4ad0-a571-7167e8ea0f4a","pos":[22.543,10.09,17.554],"name":"RepairRobot_B_Phase3","layer":"npc","npcId":2448,"say":[["Maintenance Robot","Awaiting repair command input."],["Maintenance Robot","Unable to proceed without command input."]],"sayRandom":true,"label":"NPC 7031004","npcType":"Npc","does":[],"vis":"0000010000000"},{"pid":"b862ca19-6b8c-47da-9228-135ba22ecee4","pos":[22.543,10.09,17.554],"name":"RepairRobot_B_Phase4","layer":"npc","npcId":2449,"say":[["Maintenance Robot","Executing command—"],["Maintenance Robot","Executing input command."]],"sayRandom":true,"label":"NPC 7031004","npcType":"Npc","does":[],"vis":"0000001111111"},{"pid":"2f2eca11-7a14-45b9-8861-697eba9b0c8c","pos":[-3.57,0,-14.69],"name":"Sora_Phase7","layer":"npc","npcId":2458,"say":[["Sora","Zoomie is the best aircraft in the world! ★"],["Sora","The Ark Rangers are cool and all, but nothing beats Zoomie! ★"]],"sayRandom":true,"label":"Character 532","npcType":"Character","icon":"icons-char/si_c532_00_s","does":[],"vis":"0000000100000"},{"pid":"3a3c16af-611f-403d-9763-935ec7e0454f","pos":[-4.36,10.1,21.41],"name":"Trony_Phase7","layer":"npc","npcId":2452,"say":[["Trony","We'll keep the Ark Buster maintained and operational in case of an emergency."],["Trony","That way, should danger befall the Ark once more, heroes can answer the call."]],"label":"Character 501","npcType":"Character","icon":"icons-char/si_c501_00_s","does":[],"vis":"0000000100000"},{"pid":"2c34e8c9-96cc-48b5-a20c-e215d17dec49","pos":[29.95,0,-20.59],"name":"Worker_A_Phase1","layer":"npc","npcId":2436,"say":[["Storage Worker","*Sigh* I've never handled a robot like this before..."],["Storage Worker","You want me to give commands? Uh... Y-you! Get to work!"],["Storage Worker","Uh... commands? Let's see... Do I just type in \"Work?\""]],"sayRandom":true,"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"1110000000000"},{"pid":"e5d2e047-7553-4abf-8bb1-ac9e3c137afc","pos":[29.95,0,-20.59],"name":"Worker_A_Phase2","layer":"npc","npcId":2437,"say":[["Storage Worker","Right, the manual... When am I ever going to memorize all of this?"],["Storage Worker","Learning something new at my age... It feels really daunting, but I have to give it a shot."]],"sayRandom":true,"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"0001100000000"},{"pid":"e2d83a75-b9a7-4954-aebd-7bfb1f6dfcb7","pos":[21.75,10.16,13.41],"name":"Worker_A_Phase3","layer":"npc","npcId":2438,"say":[["Storage Worker","Oh, this robot uses the same manual too. Good thing I took the time to study it."],["Storage Worker","Learning can be fun after all!"]],"sayRandom":true,"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"0000010000000"},{"pid":"ac57db47-10aa-4252-a054-dbc005b26f24","pos":[23.29,10.16,15.23],"name":"Worker_A_Phase4","layer":"npc","npcId":2439,"say":[["Storage Worker","How's it going?"],["Storage Worker","Really? Then would it be all right if I helped?\nI picked this up fairly recently, so everything's\nstill fresh in my mind."]],"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"0000001111111"},{"pid":"5f6813ea-e59e-4a37-94b8-2f963d97fb49","pos":[25.87,10.17,17.77],"name":"Worker_B_Phase1","layer":"npc","npcId":2442,"say":[["Storage Worker","So I have no choice but to use this robot, huh."],["Storage Worker","Well, robots are all basically the same. How hard could it be?"],["Storage Worker","I'll just mess with it a bit and see how it works."]],"sayRandom":true,"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"1110000000000"},{"pid":"90a646ef-6436-47cf-857d-5ac58244ca58","pos":[25.87,10.17,17.77],"name":"Worker_B_Phase2","layer":"npc","npcId":2443,"say":[["Storage Worker","Huh? That wasn't the right command? That's weird."],["Storage Worker","Oh no, this isn't the right manual! This is\nnot good at all. There's no way I can\nlearn all this from scratch again."]],"sayRandom":true,"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"0001100000000"},{"pid":"dd32d1a6-d481-4e92-923d-a5ae4853b06f","pos":[25.87,10.17,17.77],"name":"Worker_B_Phase3","layer":"npc","npcId":2444,"say":[["Storage Worker","*Sigh* I don't get it. This feels hopeless."],["Storage Worker","Where am I even supposed to start with this?"]],"sayRandom":true,"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"0000010000000"},{"pid":"5a6ca813-996b-4849-b46d-d4c45820f007","pos":[25.61,10.078,15.21],"name":"Worker_B_Phase4","layer":"npc","npcId":2445,"say":[["Storage Worker","Oh... this manual's so different from the one I've been using..."],["Storage Worker","Really? Thank you so much! I was starting to get worried since I'm completely lost."]],"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"0000001111111"},{"pid":"d6c7c113-ac24-4433-9c20-3693995c9371","pos":[1.2,0.08,-5.05],"name":"Worker_C_Phase5","layer":"npc","npcId":2459,"say":[["Storage Worker","Honestly, a lot of these problems would go away\nif we just gave up on making them walk on two legs."],["Storage Worker","... You've got a point there. That was a slip of the tongue."]],"label":"NPC 7031001","npcType":"Npc","does":[],"vis":"0011000000000"},{"pid":"57a60233-b762-43af-ab27-a86c46957890","pos":[14.57,0,-11.77],"name":"Worker_C_Phase6","layer":"npc","npcId":2460,"say":[["Storage Worker","Honestly, a lot of these problems would go away\nif we just gave up on making them walk on two legs."],["Storage Worker","... You've got a point there. That was a slip of the tongue."]],"label":"NP