":"npc","npcId":26,"say":[["Drake","This place would be perfect for the Villain Union base."],["Drake","What? There's not enough space for the base?"]],"label":"Drake","npcType":"Character","icon":"icons-char/si_c101_00_s","does":[],"vis":"001111000000000000000000"},{"pid":"f576ca9f-de22-46fb-a13a-30ff7bbc6b51","pos":[0.81,0.01,-5.55],"name":"NPC_Drake_V2","layer":"npc","npcId":27,"say":[["Drake","You! Join the Villain Union now!"],["Drake","I'm looking for fellow villains who want to take their villainy to the next level."]],"sayRandom":true,"label":"Drake","npcType":"Character","icon":"icons-char/si_c101_00_s","does":[],"vis":"000000111111111100000000"},{"pid":"fda7e6f0-faa1-4e44-86c0-003c07a50902","pos":[5.82,0.01,-9.57],"name":"NPC_Drake_V3","layer":"npc","npcId":28,"say":[["Drake","Great, just what I need. What a racket."],["Drake","I'll be back. Mwahahaha!"]],"label":"Drake","npcType":"Character","icon":"icons-char/si_c101_00_s","does":[],"vis":"000000000000000011000000"},{"pid":"20deb73d-d062-4f11-8ba3-32c757725131","pos":[1.67,0.01,-4.8],"name":"NPC_Miranda_V1","layer":"npc","npcId":32,"say":[["Miranda","Poli! We've got an emergency call."],["Miranda","The Ark is calling for our support."]],"label":"Miranda","npcType":"Character","icon":"icons-char/si_c032_00_s","does":[],"vis":"000000000000000000111100"},{"pid":"40430fc7-7128-4c61-b8af-a79edc43e4a8","pos":[-1.73,0.01,6.68],"name":"NPC_Neon_V1","layer":"npc","npcId":23,"say":[["Neon","Check it out, Master! The ground's covered in all these sparkling bits and pieces!"],["Neon","I wonder what they used to do here."]],"sayRandom":true,"label":"Neon","npcType":"Character","icon":"icons-char/si_c011_00_s","does":[],"vis":"011111110000000000000000"},{"pid":"1e077c12-d796-4fbe-8911-3dd9218facba","pos":[7.87,0.01,-2.87],"name":"NPC_Neon_V2","layer":"npc","npcId":24,"say":[["Neon","Why don't we rummage through the pieces, collect what's useful, and try to repair them?"],["Neon","Master! We've got a new mission incoming."]],"sayRandom":true,"label":"Neon","npcType":"Character","icon":"icons-char/si_c011_00_s","does":[],"vis":"000000001111111100000000"},{"pid":"4a1b8336-8d23-4f77-8abb-99fa116ad434","pos":[1.267,0.01,4.731],"name":"NPC_Neon_V3","layer":"npc","npcId":25,"say":[["Neon","After we gather up these items, we can sell them to increase our firepower."],["Neon","I can't wait to test our brand-new firepower!"]],"sayRandom":true,"label":"Neon","npcType":"Character","icon":"icons-char/si_c011_00_s","does":[],"vis":"000000000000000011111110"},{"pid":"6759e210-d2e8-45ff-930b-3ce815d193f6","pos":[-15.09,0.01,8.79],"name":"NPC_Poli_V1","layer":"npc","npcId":29,"say":[["Poli","Excuse me,"],["Poli","have you seen Drake?"]],"label":"Poli","npcType":"Character","icon":"icons-char/si_c030_00_s","does":[],"vis":"000000000000110000000000"},{"pid":"800cd919-335d-4a7a-ba3e-48c8ad805ca1","pos":[-6.67,0.01,2.52],"name":"NPC_Poli_V2","layer":"npc","npcId":30,"say":[["Poli","Drake! We've received complaints about what you're doing here."],["Poli","Stop it right now! Grrrr..."]],"label":"Poli","npcType":"Character","icon":"icons-char/si_c030_00_s","does":[],"vis":"000000000000001111000000"},{"pid":"371c5254-f492-4abd-9621-9389b2bb9ff2","pos":[5.49,0.01,-9.92],"name":"NPC_Poli_V3","layer":"npc","npcId":31,"say":[["Poli","An emergency call? What happened?"],["Poli","Got it. I'll be right there."]],"label":"Poli","npcType":"Character","icon":"icons-char/si_c030_00_s","does":[],"vis":"000000000000000000111100"},{"pid":"61846681-ca6f-4425-ae17-80dd5dd4e0f3","pos":[-13.26,0.01,-1.9],"name":"NPC_Shop","layer":"npc","npcId":21,"label":"Rapi","npcType":"Character","icon":"icons-char/si_c010_00_s","does":[]},{"pid":"cb2eb35d-a14c-420e-a734-0578c7db9efb","pos":[-5.78,0.01,9.96],"name":"NPC_Story_01","layer":"npc","npcId":17,"label":"Himeno","npcType":"Character","icon":"icons-char/si_c802_00_s","does":[]},{"pid":"60207455-8881-4abd-b935-ba56f2b75624","pos":[-10.76,0.01,11.42],"name":"NPC_Story_02","layer