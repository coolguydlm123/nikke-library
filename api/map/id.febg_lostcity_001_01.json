.27],"name":"Item_30","layer":"relic","id":55003130,"itemType":"HiddenItem","label":"Lost relic","difficulty":"None","rewards":[{"name":"Engraved Memory","amount":50}],"scene":null,"no":53,"vis":"000000000000000000000000000000000000011"},{"pid":"6574bf1c-90f6-4cf3-a8a2-817460e43ac7","pos":[-56.81,0.49,-46.9],"name":"Item_31","layer":"relic","id":55003131,"itemType":"HiddenItem","label":"Lost relic","difficulty":"None","rewards":[{"name":"Engraved Memory","amount":50}],"scene":null,"no":54,"vis":"000000000000000000000000000000000000001"},{"pid":"7b0bbc21-718d-486c-a0a3-964c933502cd","pos":[-6.31,0.34,-15.41],"name":"NPC_Balloon_Hongreyon_V1","layer":"npc","npcId":52,"say":[["Scarlet","Hath there been any communication from the Ark? Truly? Forsooth..."],["Scarlet","*Hiccup* I merely imbibed one cup. One, I doth proclaim!"]],"sayRandom":true,"label":"Scarlet","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"111111110000000000000000000000000000000"},{"pid":"2cd5b776-28c1-4b64-9f5a-bbd9d0e823b5","pos":[-3.51,0.49,-35.67],"name":"NPC_Balloon_Hongreyon_V2","layer":"npc","npcId":53,"say":[["Scarlet","Now that we have had our fill, shall we continue with our perambulation?"],["Scarlet","Just small kids... Oh my."]],"sayRandom":true,"label":"Scarlet","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"000000001100000000000000000000000000000"},{"pid":"c1dbaaaf-0877-4d10-a211-64136710bf5d","pos":[-6.05,0.35,-15.38],"name":"NPC_Balloon_Hongreyon_V3","layer":"npc","npcId":54,"say":[["Scarlet","It would be most ideal should they not consider acting out in such a manner."],["Scarlet","Pinne, that poor child... she was indeed a shining beacon for all of mankind."]],"sayRandom":true,"label":"Scarlet","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"000000000011111111111111111111111111111"},{"pid":"a68910a2-a346-4678-9fd1-f3ae750d11b9","pos":[-27.84,0.34,23.35],"name":"NPC_Balloon_Hongreyon_V4","layer":"npc","npcId":55,"say":[["Scarlet","Dorothy, are you really okay?"],["Scarlet","Very well, then let us continue onward."]],"sayRandom":true,"label":"Scarlet","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"001110000000000000000000000000000000000"},{"pid":"f2738df8-02a6-49ef-b846-24354817c012","pos":[-6.02,0.33,-17.06],"name":"NPC_Balloon_Hongreyon_V5","layer":"npc","npcId":56,"say":[["Scarlet","Dost thou plan on extirpating all the ungulates in this area?"],["Scarlet","Dorothy! I urge thee, caution upon your exit! Not even you shall escape my wrath should thou happen to trudge upon the garden."]],"sayRandom":true,"label":"Scarlet","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"000001100000000000000000000000000000000"},{"pid":"2f3027b7-6a62-4e18-816c-0f12369479bb","pos":[11.93,0.1,7.01],"name":"NPC_Balloon_Hongreyon_V6","layer":"npc","npcId":57,"say":[["Scarlet","It is all thanks to you, that we all remain here."],["Scarlet","Let us fight until we wield this blade to remove the Queen's head from her shoulders."]],"sayRandom":true,"label":"Scarlet","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"000000011000000000000000000000000000000"},{"pid":"f8e7f739-51e4-44ac-8a2b-412205c3b2e3","pos":[0.04,0.33,7.36],"name":"NPC_Balloon_Pinne_V1","layer":"npc","npcId":58,"say":[["Pinne","Each and every one of you is a living symbol of victory. You must stay alive."],["Pinne","Don't carry all the weight by yourself. \nWith just one magic word, everyone will be by Dorothy's side."],["Pinne","Leave it to me. Should the worst occur, it would be preferable for me to give my life rather than any of you."]],"sayRandom":true,"label":"Pinne","npcType":"Character","icon":"icons-char/si_c307_00_s","does":[],"vis":"000011111100000000000000000000000000000"},{"pid":"534c86a1-2b85-49db-9339-71419480125d","pos":[-7.79,0.49,-35.79],"name":"NPC_Balloon_Pinne_V2","layer":"npc","npcId":59,"say":[["Pinne","Dorothy, look over here. The sprouts are