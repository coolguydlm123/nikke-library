,"difficulty":"None","rewards":[{"name":"Crown Kingdom Commemorative Coin","amount":50}],"scene":null,"no":45,"vis":"000000000000000000000000000000000001111"},{"pid":"b2186bd3-ce49-4250-a848-9f362200a296","pos":[-0.87,3.95,-1.65],"name":"Item_29","layer":"relic","id":55010129,"itemType":"HiddenItem","label":"Lost relic","difficulty":"None","rewards":[{"name":"Crown Kingdom Commemorative Coin","amount":50}],"scene":null,"no":46,"vis":"000000000000000000000000000000000000111"},{"pid":"050fd792-2b48-4563-8de7-94cdac42f185","pos":[26.38,0.55,-28.89],"name":"Item_30","layer":"relic","id":55010130,"itemType":"HiddenItem","label":"Lost relic","difficulty":"None","rewards":[{"name":"Crown Kingdom Commemorative Coin","amount":50}],"scene":null,"no":47,"vis":"000000000000000000000000000000000000011"},{"pid":"5d60a37b-c6d4-4c76-86a5-1bffecd96847","pos":[-3.99,4.14,-3.42],"name":"Chime V1","layer":"npc","npcId":733,"say":[["Chime","Well... There's no choice now that the rescue has been done."],["Chime","I'm proud to be a citizen of our kingdom!"]],"label":"NPC 7006001","npcType":"Npc","does":[],"vis":"110000000000000000000000000000000000000"},{"pid":"2c29291a-5a28-411b-9db0-6ab043eeb261","pos":[-21.913,0.3,-14.226],"name":"Kilo V1","layer":"npc","npcId":734,"say":[["Kilo","No matter how you cut it, I still think it's better to escape..."],["T.A.L.O.S.","I think it's more advantageous to work together."],["Kilo","What if I get tainted too?"],["T.A.L.O.S.","But you can find a place where you belong."]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"110000000000000000000000000000000000000"},{"pid":"2073152a-2d9f-4ba4-bc5f-ad6677cfc7a1","pos":[7.35,0.3,-32.42],"name":"Chime V2","layer":"npc","npcId":735,"say":[["Chime","That's a really cool robot."],["Chime","... I want to ride it."]],"label":"NPC 7006001","npcType":"Npc","does":[],"vis":"001100000000000000000000000000000000000"},{"pid":"34ad15e8-99de-44fb-94b4-077c404bc96d","pos":[-7.71,0.3,-30.83],"name":"Kilo V2","layer":"npc","npcId":737,"say":[["Kilo","Uh... Should we just run away now...?"],["T.A.L.O.S.","That's not advisable. The surface is not safe."],["Kilo","But you're telling me it's safe to be with these weird Nikkes?"],["T.A.L.O.S.","I don't think they pose any threat."]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"001100000000000000000000000000000000000"},{"pid":"9cef87b6-4a0e-44b7-96f4-156c6c9a007f","pos":[-5.23,4.08,0.95],"name":"Marian V1","layer":"npc","npcId":736,"say":[["Marian","I'll protect everyone who is important to me."],["Marian","Using any and all means."]],"label":"Character 260","npcType":"Character","icon":"icons-char/si_c260_02_s","does":[],"vis":"001100000000000000000000000000000000000"},{"pid":"589251b1-a6b3-46e2-8a22-59418cb9f32f","pos":[36,0.3,-40.96],"name":"Chime V3","layer":"npc","npcId":738,"say":[["Chime","Ah!! Why are there suddenly Raptures here?!"],["Chime","Don't tell me something happened to the walls?!"]],"label":"NPC 7006001","npcType":"Npc","does":[],"vis":"000001100000000000000000000000000000000"},{"pid":"4f275c8e-1a4c-448f-b28b-f2e81193e4c5","pos":[7.35,0.3,-32.42],"name":"Kilo V3","layer":"npc","npcId":740,"say":[["Kilo","The Heretics and the Pilgrims together... Amazing."],["T.A.L.O.S.","Their power is on another level compared to that of ordinary Nikkes."],["Kilo","Are their inherent capabilities so different?"],["T.A.L.O.S.","There's a substantial gap in their combat experience."]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"000001100000000000000000000000000000000"},{"pid":"d0015a99-d60f-435c-8ab8-2b95b943f470","pos":[21.61,11.18,-68.05],"name":"Marian V2","layer":"npc","npcId":739,"say":[["Marian","Thank you, everyone."],["Marian","... Why is it suddenly..."]],"label":"Character 260","npcType":"Character","icon":"icons-char/si_c260_02_s","does":[],"vis":"000001100000000000000000000000000000000"},{"pid":"a1a96771-029b-4af9-8ff9-743aafe216d4","pos":[41.02,0.3,-33.59],"name":"Chime V4","layer":"npc","npcId":741,"say":[["Chime","Oh...! Thank goodness, there's nothing wrong with it."],["Chime","Let me go fix up the walls first."]],"label":"NPC 7006001","npcType":"Npc","does":[],"vis":"000000010000000000000000000000000000000"},{"pid":"6a0b63f8-20a6-4629-9245-85653005538f","pos":[19.29,0.3,-29.09],"name":"Kilo V4","layer":"npc","npcId":743,"say":[["Kilo","Uh... Sorry... It's all my fault..."],["T.A.L.O.S.","It's difficult for the rescue signal to penetrate the defensive walls."],["Kilo","... What? Really? Then why..."],["T.A.L.O.S.","I'm not sure, but there could be other causes."]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"000000010000000000000000000000000000000"},{"pid":"a1cdd200-59a2-493b-8d69-d3f3e4570773","pos":[-21.9,0.3,-14.24],"name":"Marian V3","layer":"npc","npcId":742,"say":[["Marian","..."],["Marian","Is it really because of the rescue signal...?"]],"label":"Character 260","npcType":"Character","icon":"icons-char/si_c260_02_s","does":[],"vis":"000000010000000000000000000000000000000"},{"pid":"ea6488c2-06bb-4729-9709-bb42d76c8833","pos":[-5.31,4.43,1.39],"name":"Chime V5","layer":"npc","npcId":744,"say":[["Chime","When the surface is reclaimed, this place shall be a beacon of hope for mankind."],["Chime","So I must protect it. At all costs."]],"label":"NPC 7006001","npcType":"Npc","does":[],"vis":"000000001000000000000000000000000000000"},{"pid":"c627e267-078f-4b8c-b700-91c37b101bf1","pos":[-27.038,0.3,-14.507],"name":"Kilo V5","layer":"npc","npcId":746,"say":[["Kilo","Superfood... Mankind's future food..."],["T.A.L.O.S.","Theoretically, it can completely replace Splendamin."],["Kilo","So they really think the surface can be reclaimed. How absurd."],["T.A.L.O.S.","You really think that?"]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"000000001000000000000000000000000000000"},{"pid":"1da6ddeb-3dcc-4581-85e1-26d87eca1671","pos":[1.35,0.3,-25.23],"name":"Marian V4","layer":"npc","npcId":745,"say":[["Marian","Surface reclamation..."],["Marian","Is it really possible? No, is it the right thing to do?"]],"label":"Character 260","npcType":"Character","icon":"icons-char/si_c260_02_s","does":[],"vis":"000000001000000000000000000000000000000"},{"pid":"174aa317-e686-4d23-b167-ac08c0053cb5","pos":[-21.913,0.3,-14.226],"name":"Kilo V6","layer":"npc","npcId":748,"say":[["Kilo","Chime... Chime...!"],["T.A.L.O.S.","Chime's maneuverability and judgment are highly exceptional."],["Kilo","R-Right? She will be okay, won't she?"],["T.A.L.O.S.","... Yes."]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"000000000110000000000000000000000000000"},{"pid":"69084029-e14e-4362-9b1d-12f44a5d3d29","pos":[-14.57,0.3,-22.04],"name":"Marian V5","layer":"npc","npcId":747,"say":[["Marian","Chime..."],["Marian","Please be safe...!"]],"label":"Character 260","npcType":"Character","icon":"icons-char/si_c260_02_s","does":[],"vis":"000000000110000000000000000000000000000"},{"pid":"796f072d-1229-4a6c-acbb-2c4b7e4e0ca9","pos":[-20.16,0.3,-15.43],"name":"Hongryeon V1","layer":"npc","npcId":751,"say":[["Scarlet","Pardon my delay."],["Scarlet","The situation is worse than what I imagined, but it's not worst case scenario, at least."]],"label":"Character 222","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"000000000000111111110000000000000000000"},{"pid":"a264c1fb-cf9a-4ee9-8f11-7166baba3bce","pos":[0.63,4.46,-4.7],"name":"Kilo V7","layer":"npc","npcId":750,"say":[["Kilo","... T.A.L.O.S., can we save Chime?"],["T.A.L.O.S.","Thanks to the Pilgrims' participation, her survival chance has skyrocketed."],["Kilo","All right. You have to save her, okay?"],["T.A.L.O.S.","I'll do my best."]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"000000000000111111110000000000000000000"},{"pid":"5ccea3b6-70ea-487f-9731-0df5dcb4a85e","pos":[-14.57,0.3,-22.04],"name":"Marian V6","layer":"npc","npcId":749,"say":[["Marian","Snow White, Scarlet, Rapunzel...!"],["Marian","Thanks for coming."]],"label":"Character 260","npcType":"Character","icon":"icons-char/si_c260_02_s","does":[],"vis":"000000000000111111110000000000000000000"},{"pid":"8e36b6bd-f406-4e91-b6fc-697af8f2b9d8","pos":[-5,4.2,1.05],"name":"Rapunzel V1","layer":"npc","npcId":753,"say":[["Rapunzel","Chime...! What happened?!"],["Rapunzel","I can operate the nanomachine, so let me help. Hurry!"]],"label":"Character 221","npcType":"Character","icon":"icons-char/si_c221_00_s","does":[],"vis":"000000000000111111110000000000000000000"},{"pid":"515dd089-b8eb-4c6d-8f7f-e6a618b6edcf","pos":[-27.038,0.3,-14.507],"name":"Snowwhite V1","layer":"npc","npcId":752,"say":[["Snow White","Focus on saving Chime."],["Snow White","We'll take care of the Raptures."]],"label":"Character 220","npcType":"Character","icon":"icons-char/si_c220_00_s","does":[],"vis":"000000000000111111110000000000000000000"},{"pid":"3273bb75-62b7-4a94-b751-d384e7888541","pos":[-5,4.2,1.05],"name":"Rapunzel V2","layer":"npc","npcId":754,"say":[["Rapunzel","The Raptures won't stop attacking."],["Rapunzel","Ah, don't worry about Chime. She will come to."]],"label":"Character 221","npcType":"Character","icon":"icons-char/si_c221_00_s","does":[],"vis":"000000000000000000000111111111111111111"},{"pid":"317f1657-c746-4e16-9811-b3bc974238fc","pos":[-3.99,3.97,-3.42],"name":"Chime V6","layer":"npc","npcId":755,"say":[["Chime","Fight them head-on! We cannot lose!"],["Chime","... I'll make you regret not killing me."]],"label":"NPC 7006001","npcType":"Npc","does":[],"vis":"000000111111100000000000000000000000000"},{"pid":"d5dcf0bc-e00d-41c3-98d8-712d558182e5","pos":[-1.2,4.14,-5.95],"name":"Chime V7","layer":"npc","npcId":756,"say":[["Chime","Miss, witnessing your courageous leap is truly awe-inspiring!"],["Chime","Leave today's celebration to me!"]],"label":"NPC 7006001","npcType":"Npc","does":[],"vis":"000000000000011111111111111100000000000"},{"pid":"5dbdcc7f-a44a-4f01-bb82-3a20a43992ee","pos":[-22.99,3.93,46.71],"name":"Hongryeon V2","layer":"npc","npcId":759,"say":[["Scarlet","It's really regrettable that it was used here, but victory is what we seek."],["Scarlet","So, what wine shall fill our cups in this celebration?"]],"label":"Character 222","npcType":"Character","icon":"icons-char/si_c222_00_s","does":[],"vis":"000000000000011111111111111100000000000"},{"pid":"b78d362f-5c60-4b9a-92bb-c8d33b545538","pos":[14.62,3.98,-11.92],"name":"Kilo V8","layer":"npc","npcId":758,"say":[["Kilo","Thank you, T.A.L.O.S."],["T.A.L.O.S.","In sleep mode."],["Kilo","... Thank you, this is my one and only precious place."],["T.A.L.O.S.","-Thank you, my one and only pilot-"]],"label":"Character 361","npcType":"Character","icon":"icons-char/si_c361_00_s","does":[],"vis":"000000000000011111111111111100000000000"},{"pid":"c5480767-e591-4fcb-be0f-e8b4f8567410","pos":[-29.681,0.3,5.176],"name":"Marian V7","layer":"npc","npcId":757,"say":[["Marian","... We won. They're all dead."],["Marian","... All dead."]],"label":"Character 260","npcType":"Character","icon":"icons-char/si_c260_02_s","does":[],"vis":"000000000000011111111111111100000000000"},{"pid":"14c0cfaa-dc05-42af-bb4c-322c94ee6d1e","pos":[-8.66,4.1,2.8],"name":"Rapunzel V3","layer":"npc","npcId":761,"say":[["Rapunzel","The Naked King... A king without anything on..."],["Rapunzel","The biggest advantage is that all the clothes disappear once it's activated."]],"label":"Character 221","npcType":"Character","icon":"icons-char/si_c221_00_s","does":[],"vis":"000000000000011111111111111100000000000"},{"pid":"703940e4-ba55-4b9f-9f55-c921e3c3bc73","pos":[-44,17.51,-50],"name":"Snowwhite V2","layer":"npc","npcId":760,"say":[["Snow White","I'll stand guard just in case."],["Snow White","... Can you bring some food?"]],"label":"Character 2