,"count":2,"items":[{"label":"Gatekeeper I","href":null,"lv":44},{"label":"Gatekeeper II","href":null,"lv":44}]}]}],"skills":{"530801":{"id":530801,"name":"Ersatz Wormhole","description":"Fires lasers from four pseudo-wormholes, dealing damage to a single Nikke. The wormholes can be destroyed.","weapon":"AR","damage":"Metal","fire":"Instant","shots":1,"value":"13%"},"530805":{"id":530805,"name":"Summon Wormhole","description":"Opens a wormhole and summons Raptures. The summoned Raptures will generate a code barrier and then proceed to self-destruct, dealing damage to a single Nikke. While the barrier is up, only Water Code Nikkes can deal damage.","weapon":"RL","damage":"Metal","fire":"Calling","shots":1,"value":105},"530806":{"id":530806,"name":"Summon Asteroids","description":"Opens multiple wormholes and summons asteroids. Any Nikkes who are hit will have their ATK reduced. This effect can stack. The asteroids can be intercepted.","weapon":"RL","damage":"Metal","fire":"ProjectileCurve","shots":1,"value":"11%","interceptable":true},"530807":{"id":530807,"name":"Wormhole Laser","description":"Fires powerful lasers from the wormhole at all Nikkes, dealing damage.\nGatekeeper generates a code barrier to defend against attacks while using Wormhole Laser. While the barrier is up, only Wind Code Nikkes can deal damage.","weapon":"AR","damage":"Metal","fire":"InstantAll","shots":1,"value":"60%"},"530815":{"id":530815,"name":"Summon Wormhole","description":"Opens a wormhole above itself to summon meteors before launching them at all Nikkes, dealing damage and temporarily immobilizing them.\nGatekeeper generates a code barrier to defend against attacks while summoning meteors. While the barrier is up, only Wind Code Nikkes can deal damage.","weapon":"AR","damage":"Metal","fire":"InstantAll","shots":1,"value":"23%"},"530817":{"id":530817,"name":"Cosmic Trash","description":"Creates a portal into subspace and summons cosmic trash.\nThe portal must be closed via Special Interruption.\nIf the opening is not closed, it deals damage to all Nikkes.","weapon":"AR","damage":"Metal","fire":"InstantAll","shots":1,"value":"20%"}},"parts":[{"type":"Body","name":"Body","main":true,"hp":10000,"damageHp":0,"breakable":true,"visibleHp":false},{"type":"Weapon 01","name":"Mini Wormhole Gate I","main":false,"hp":300,"damageHp":500,"breakable":true,"visibleHp":true},{"type":"Weapon 02","name":"Mini Wormhole Gate II","main":false,"hp":300,"damageHp":500,"breakable":true,"visibleHp":true},{"type":"Weapon 03","name":"Mini Wormhole Gate III","main":false,"hp":300,"damageHp":500,"breakable":true,"visibleHp":true},{"type":"Weapon 04","name":"Mini Wormhole Gate IV","main":false,"hp":300,"damageHp":500,"breakable":true,"visibleHp":true},{"type":"Weapon 05","name":"Mini Wormhole Gate IV","main":false,"hp":300,"damageHp":0,"breakable":false,"visibleHp":false}],"related":[{"id":251003,"name":"Gatekeeper","variant":null,"icon":"si_eba003"},{"id":251013,"name":"Gatekeeper","variant":"H.S.T.A.","icon":"si_eba003_hsta"},{"id":251033,"name":"Gatekeeper","variant":"P.S.I.D.","icon":"si_eba003_psid"},{"id":251043,"name":"Gatekeeper","variant":"Z.E.U.S.","icon":"si_eba003_zeus"},{"id":251053,"name":"Gatekeeper","variant":"Over","icon":"si_eba003"}]}