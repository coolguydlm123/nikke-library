zing!\nI'm gonna really cut loose!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_07_7","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_07_7","text":"... but if I do that, Rapi will really let me have it.","jump":"d_counseling_neon_07_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_07_8","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_07_8","text":"You always know the right thing to say, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_07_9","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_neon_07_9","text":"I teach Neon how to keep the dorm clean.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}