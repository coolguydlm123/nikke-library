main_19af_01_69","text":"You can, however, eat as many as you'd like while you stay here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_70","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_70","text":"This is the Central Research Facility.","jump":null,"exit":false,"enter":null,"bg":"EdenIndoor","bgArt":"edenindoor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_71","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_71","text":"You remember the Nikkes you ran into?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_72","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_72","text":"I mean the ones that were with Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_73","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_73","text":"How could I forget?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_74","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_74","text":"I'm not sure if you noticed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_75","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_75","text":"but they are Pilgrims, manufactured using advanced technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_76","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_76","text":"Cecil created them with her own hands, in this very room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_77","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_19af_01_77","text":"Manufacturing Pilgrims...","jump":"d_main_19af_01_79","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_78","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_19af_01_78","text":"Sounds like Cecil is a woman of many talents.","jump":"d_main_19af_01_80","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_79","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_79","text":"Surprising, isn't it?","jump":"d_main_19af_01_81","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_80","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_80","text":"Her intellect is a constant source of amazement to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_81","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_81","text":"Apparently, the Ark is still 50 years away from achieving this kind of technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_82","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_82","text":"She even designed the optical camouflage that envelops this entire base.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_83","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_83","text":"Last but not least, we have the Lobby.","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_84","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_84","text":"You can see the entire base from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_85","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_86","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_86","text":"Ah, it seems that Isabel and Noah are training in the Incubator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_87","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_87","text":"Incubator?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_88","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_88","text":"It works rather like the Ark's Simulation Room,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_89","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_89","text":"but it's possible to make even finer adjustments, and create slightly more powerful enemies there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_90","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_90","text":"Actually, that's not entirely correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_91","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_91","text":"When I say \"slightly more powerful\", we're talking about the difference between run-of-the-mill Raptures and tyrant class.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_92","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_92","text":"I'd say that's more than a slight difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_93","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_93","text":"Very true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_94","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_94","text":"However, such difficulty spikes are necessary for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_95","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_95","text":"Everyone who resides in Eden must be able to fend for themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_96","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_96","text":"This even applies to humans like Cecil and Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_97","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_97","text":"In doing this, we avoid becoming like your Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_98","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_98","text":"where the few are being exploited by the many.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_99","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_99","text":"I assume you're referring to Nikkes and humans?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_100","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_100","text":"You catch on quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_101","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_101","text":"To me, paradise is a place where there is an even balance of power. Where humans and Nikkes can live in perfect harmony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_102","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_102","text":"Of course, everyone has their own definition of what is just...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_103","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_103","text":"So, what do you think?","jump":null,"exit":false,"enter":null,"bg":"Eden","bgArt":"eden","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_104","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_104","text":"Did paradise live up to what you envisioned in your mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_105","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_105","text":"I'm curious to hear how you think it compares.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_106","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_19af_01_106","text":"It's exactly as I imagined it.","jump":"d_main_19af_01_108","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_107","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_19af_01_107","text":"It's a little different.","jump":"d_main_19af_01_111","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_108","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_108","text":"So, in that sense,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_109","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_109","text":"you could safely say you consider this place a utopia, yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_110","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_110","text":"Right.","jump":"d_main_19af_01_114","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_111","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_111","text":"... Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_112","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_112","text":"Nevertheless, it's at least closer to utopia than the Ark, is it not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_113","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_113","text":"I hate to admit it, but... yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_114","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_114","text":"Well then, I suppose we can move on to more important topics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_115","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_115","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_116","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_116","text":"I don't know if you heard from Harran,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_117","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_117","text":"but I have been waiting a long time for your arrival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_inark","movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_118","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_118","text":"Why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_119","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_119","text":"I believe you are the key,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_120","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_120","text":"to overcoming the crisis that befalls Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_121","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_01_121","text":"What exactly do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_122","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_122","text":"The Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_123","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_01_123","text":"You have gone up against one of them before and won, have you not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_124","type":"Choice","speaker":