eech","speaker":"cecil","key":"Locale_MainScenario:d_main_19af_01_28","text":"She's always up to no good. Worst of all, she has the ear of all the other Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_29","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_19af_01_29","text":"Have you heard of her latest escapade?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_30","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_19af_01_30","text":"She brought outsiders to Eden without so much as a word to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_31","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_19af_01_31","text":"Outsiders?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_32","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_19af_01_32","text":"Yes, and not even one or two. Five in total.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_33","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_19af_01_33","text":"I'm willing to bet that one of them is the commander you intended to turn into Rapture food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_01_34","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_19af_01_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":nul