{"id":"d_counseling_ludmilla_03","cat":"counsel","group":{"id":"char5033","label":"Ludmilla"},"label":"Advising Ludmilla: 03","stage":null,"prev":"d_counseling_ludmilla_02","next":"d_counseling_ludmilla_04","speakers":{"ludmilla":"Ludmilla"},"icons":{"ludmilla":"si_c190_00_s"},"lines":[{"id":"d_counseling_ludmilla_03_1","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_1","text":"Every time you come here, you appear to be on the verge of becoming a popsicle.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ludmilla"],"affinity":"_0"},{"id":"d_counseling_ludmilla_03_2","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_2","text":"Is there anything I could do to make you more comfortable?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_03_3","text":"Any chance you have a space heater?","jump":"d_counseling_ludmilla_03_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ludmilla_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_03_4","text":"Any chance I could get a hug from you?","jump":"d_counseling_ludmilla_03_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ludmilla_03_5","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_5","text":"A space heater? I assume it's a machine of some sort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_6","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_6","text":"Very well. I shall procure one forthwith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_7","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_7","text":"However, I doubt its warmth could withstand my cold for long.","jump":"d_counseling_ludmilla_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_8","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_8","text":"A-ha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_9","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_9","text":"So, it is my embrace that you desire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_10","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_10","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_11","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_03_11","text":"Come to me any time you are cold, and I will have a warm embrace waiting for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_03_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_03_12","text":"I talk with Ludmilla about how to withstand the frigid Northern temperatures.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}