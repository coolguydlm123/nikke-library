{"id":"msg_m_ex_grave_01","cat":"messenger","group":{"id":"room_grave","label":"Grave · Nikke"},"label":"1. Can you see this message?","stage":null,"prev":null,"next":"msg_m_ex_grave_02","speakers":{"grave":"Grave"},"icons":{"grave":"si_c514_00_s"},"lines":[{"id":"m_ex_grave_01_1","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_1","text":"Can you see this message?","jump":null},{"id":"m_ex_grave_01_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_grave_01_2","text":"Yes, I see it.","jump":null},{"id":"m_ex_grave_01_3","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_3","text":"Thank goodness.","jump":null},{"id":"m_ex_grave_01_4","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_4","text":"Have you heard the news?","jump":null},{"id":"m_ex_grave_01_5","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_5","text":"From now on,","jump":null},{"id":"m_ex_grave_01_6","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_6","text":"I'll be here to assist you.","jump":null},{"id":"m_ex_grave_01_7","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_7","text":"I'll be fighting alongside you.","jump":null},{"id":"m_ex_grave_01_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_grave_01_8","text":"Won't it be too exhausting for you?","jump":null},{"id":"m_ex_grave_01_9","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_9","text":"It would be an honor to be able to fight","jump":null},{"id":"m_ex_grave_01_10","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_10","text":"alongside you, Superhuman.","jump":null},{"id":"m_ex_grave_01_11","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_11","text":"Besides,","jump":null},{"id":"m_ex_grave_01_12","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_12","text":"I have gone through much more trying tribulations on my own.","jump":null},{"id":"m_ex_grave_01_13","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_13","text":"But it's okay now, because I'm no longer alone.","jump":null},{"id":"m_ex_grave_01_14","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_14","text":"You're here, and so is Cinderella.","jump":null},{"id":"m_ex_grave_01_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_grave_01_15","text":"You're putting your trust in me?","jump":null},{"id":"m_ex_grave_01_16","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_16","text":"Of course.","jump":null},{"id":"m_ex_grave_01_17","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_17","text":"And you should put your trust in me as well.","jump":null},{"id":"m_ex_grave_01_18","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_18","text":"Once I decide to protect something,","jump":null},{"id":"m_ex_grave_01_19","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_19","text":"I stick through it until the very end.","jump":null},{"id":"m_ex_grave_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_grave_01_20","text":"Just like how you protected Cinderella.","jump":null},{"id":"m_ex_grave_01_21","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_21","text":"That's right.","jump":null},{"id":"m_ex_grave_01_22","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_22","text":"Cinderella also said that","jump":null},{"id":"m_ex_grave_01_23","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_23","text":"in this new rewritten story of ours,","jump":null},{"id":"m_ex_grave_01_24","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_24","text":"it would only be beautiful if all of us are there.","jump":null},{"id":"m_ex_grave_01_25","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_25","text":"So I'll have to protect both of you.","jump":null},{"id":"m_ex_grave_01_26","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_26","text":"Of course, I understand if you don't have full faith in me.","jump":null},{"id":"m_ex_grave_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_grave_01_27","text":"Not at all. I feel quite safe around you.","jump":null},{"id":"m_ex_grave_01_28","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_28","text":"You do?","jump":null},{"id":"m_ex_grave_01_29","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_29","text":"Thanks for saying that.","jump":null},{"id":"m_ex_grave_01_30","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_30","text":"You flatter me.","jump":null},{"id":"m_ex_grave_01_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_grave_01_31","text":"What can I say? You deserve every compliment that comes your way, Grave.","jump":null},{"id":"m_ex_grave_01_32","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_32","text":"You see?","jump":null},{"id":"m_ex_grave_01_33","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_33","text":"You just complimented me again.","jump":null},{"id":"m_ex_grave_01_34","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_34","text":"I... I'm not entirely sure how to respond in a situation like this.","jump":null},{"id":"m_ex_grave_01_35","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_35","text":"I've gotta get going.","jump":null},{"id":"m_ex_grave_01_36","type":"Speech","speaker":"grave","key":"Locale_SuddenMessage:m_ex_grave_01_36","text":"Take care.","jump":null},{"id":"m_ex_grave_01_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_grave_01_37","text":"Haha, okay.","jump":null}],"chat":true}