":null,"affinity":null},{"id":"event_arkranger1_prologue_39","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_prologue_39","text":"Push yourself too hard and you'll break.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_prologue_40","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_prologue_40","text":"Then I'll just train harder so that doesn't happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_prologue_41","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_prologue_41","text":"This kid's going to snap one of these days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_prologue_42","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger1_prologue_42","text":"Definitely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_prologue_43","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_prologue_43","text":"Director, I'd like to do one more take of the Ark Black Meteor scene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_prologue_44","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_prologue_44","text":"I'm fairly certain my leg was bent unnaturally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_prologue_45","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger1_prolog