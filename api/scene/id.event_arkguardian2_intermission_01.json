2_intermission_01_132","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_intermission_01_132","text":"Same for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_intermission_01_133","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_intermission_01_133","text":"I don't suppose I get a care package?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_intermission_01_134","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian2_intermission_01_134","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_intermission_01_135","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_intermission_01_135","text":"Figures. It's a hard-knock life for us non-Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_intermission_01_136","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_intermission_01_136","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_intermission_01_137","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_intermission_01_137","text":"All right. Gear up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_intermission_01_138","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_intermission_01_138","t