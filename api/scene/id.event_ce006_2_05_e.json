{"id":"event_ce006_2_05_e","cat":"event","group":{"id":"ev40080","label":"MEMORIES TELLER · Part 2"},"label":"Sad Memories: B","stage":null,"prev":"event_ce006_2_05_s","next":"event_ce006_2_06_s","speakers":{"ce006_npc_01":"Adam","ce006_01":"EVE","hermin":"Hermin","elegg":"Elegg","privaty":"Privaty","anis":"Anis","rapi":"Rapi","neon":"Neon","ce006_03":"Lily"},"icons":{"ce006_npc_01":"si_c853_00_s","ce006_01":"si_c850_00_s","hermin":"si_c998_00_s","elegg":"si_c500_00_s","privaty":"si_c170_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","ce006_03":"si_c852_00_s"},"lines":[{"id":"event_ce006_2_05_e_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_05_e_1","text":"The data transfer commences","jump":null,"exit":false,"enter":null,"bg":"bunkerofartist","bgArt":"bunkerofartist","image":null,"bgm":"none","movie":null,"shown":["ce006_npc_01","ce006_01","hermin"],"affinity":null},{"id":"event_ce006_2_05_e_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_05_e_2","text":"with the past data being moved to the storage devices that Roam and the others brought back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_05_e_3","text":"The process is slow going,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_4","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_05_e_4","text":"but the artistic legacies that those in the bunker sought to protect are slowly preparing to emerge once again and influence the present.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_5","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_5","text":"These photos in the picture frames must be of the people who stayed behind in the bunker.","jump":null,"exit":false,"enter":null,"bg":"MemorialHall","bgArt":"memorialhall","image":null,"bgm":"collab_bgm_sb_field_floodedcs_inst","movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_6","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_6","text":"Yeah. The frames are really worn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_7","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_7","text":"They must have been handled quite a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_8","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_8","text":"These images were no doubt caressed longingly—hundreds, if not thousands of times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_9","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_9","text":"Yes. After a while, I stopped touching it out of fear that I'd harm the frames.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_10","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_10","text":"How is your body feeling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_11","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_11","text":"... Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_12","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_12","text":"You should get some more rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_13","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_13","text":"I'm fine. I've rested plenty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_14","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_14","text":"You've held fast and kept watch over this art for so long, and now it's finally seeing the light of day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_15","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_15","text":"How does that make you feel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_16","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_16","text":"Well... At first, I was filled with this sacred sense of duty, but later, I felt I had no other choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_17","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_17","text":"I was afraid of the outside, and it was not as if I could open the door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_18","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_18","text":"Why didn't you end it all?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_19","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_19","text":"Adam!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_20","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_20","text":"Sorry, that came out wrong. I didn't mean to be insensitive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_21","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_21","text":"What I mean is, how were you able to keep going for all these years?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_22","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_22","text":"I'm not sure...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_23","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_24","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_24","text":"I figured that I had already waited so long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_25","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_25","text":"If I \"tapped out\", as it were, without seeing my dream come true, that'd hardly seem fair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_26","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_26","text":"Yes, there were times when the pain was too great, and I wanted to give up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_27","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_27","text":"But then I would imagine the sight of future generations appreciating these artworks, and I would be overcome with emotion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_28","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_28","text":"If I were able to witness that with my own eyes, would that not be art in its truest form?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_29","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_30","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_30","text":"If you had failed, all your suffering would have been in vain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_31","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_31","text":"I would have endured no matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_32","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_32","text":"I never stopped believing that one day, a miracle would come. With that, I would have pressed on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_33","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_33","text":"Even if you lost so much along the way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_34","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_34","text":"Yes, I would have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_35","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_35","text":"I'd already nearly lost everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_36","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_36","text":"I would have kept waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_37","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_37","text":"I would have believed that this was my purpose, and kept waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_38","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_38","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_39","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_39","text":"I find your words very comforting. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_40","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_40","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_41","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_41","text":"Are these all the photos you have of your friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_42","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_43","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_43","text":"Hermin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_44","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_45","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_45","text":"... Hermin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_46","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_46","text":"Huh? Oh, I'm sorry, what did you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_47","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_47","text":"Are these all photos of your friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_48","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_48","text":"Oh... yes. That's all of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_49","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_49","text":"I regret not taking more photos.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_50","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_50","text":"If there's any advice I would give you, it's to take more photos. Nothing is better at preserving memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_51","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_05_e_51","text":"We'll do our best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_52","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_53","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_53","text":"Is there any chance it would be possible...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_54","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_54","text":"To find out what happened to those who left?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_55","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_05_e_55","text":"We're looking into it. This all happened so long ago, so it may take some time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_56","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_56","text":"... I see. Thank you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_57","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_05_e_57","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_58","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_05_e_58","text":"The data transfer is almost complete.","jump":null,"exit":false,"enter":null,"bg":"bunkerofartist","bgArt":"bunkerofartist","image":null,"bgm":null,"movie":null,"shown":["privaty","elegg","anis","rapi","neon"],"affinity":null},{"id":"event_ce006_2_05_e_59","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_05_e_59","text":"I think we can start getting ready to leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_60","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_05_e_60","text":"How's Hermin doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_61","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_05_e_61","text":"Not great. He faded in and out several times during our conversation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_62","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_05_e_62","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_05_e_63","text":"The emergency medication we brought is mostly for external injuries, so they're not much help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_64","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_05_e_64","text":"Sedatives or painkillers could do more harm than good, so we can't use those.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_65","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_05_e_65","text":"We need to get him to the Ark as soon as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_66","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_05_e_66","text":"Let's start packing. We'll move out the moment the data transfer is finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_67","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_05_e_67","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_68","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_05_e_68","text":"We can use the Tetrapod. It'll be a heck of a lot faster than walking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_69","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_05_e_69","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_70","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_05_e_70","text":"But what if we run into Storm Bringer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_05_e_71","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_05_e_71","text":"I think it's worth the risk. What about you, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":