{"id":"d_nikke_sakura_01","cat":"bond","group":{"id":"char1012","label":"Sakura"},"label":"Cherry Blossom","stage":null,"prev":null,"next":"d_nikke_sakura_02","speakers":{"sakura":"Sakura","member":"Gang Member"},"icons":{"sakura":"si_c282_00_s","member":"si_c999_00_s"},"lines":[{"id":"d_nikke_sakura_01_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_1","text":"... One peaceful afternoon.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_menu_commandersroom","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_2","text":"I don't have any missions lined up today. I should take care of some chores I've been putting off...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_3","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_3","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_4","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_4","text":"I'll go and assess the situation.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_5","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_5","text":"... This is all rather sudden.","jump":null,"exit":false,"enter":null,"bg":"TatamiRoom","bgArt":"tatamiroom","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["sakura"],"affinity":null},{"id":"d_nikke_sakura_01_6","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_6","text":"You just waltz in here and say that you'll be staying for a while?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_7","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_7","text":"I understand that you're a commander, but this is a bit much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_8","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_8","text":"Consider it one of my many duties.","jump":"d_nikke_sakura_01_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_9","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_9","text":"I came because I couldn't stop thinking about you.","jump":"d_nikke_sakura_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_10","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_10","text":"Ah yes, what you call \"mental care\", right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_11","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_11","text":"Surely you didn't have to come all the way out here for that...","jump":"d_nikke_sakura_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_12","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_12","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_13","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_13","text":"You're messing with me, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_14","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_14","text":"Do I look like some floozy who swoons at every word some jarhead utters?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_15","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_15","text":"... Besides, even if what you said was true, it makes you sound juvenile.","jump":"d_nikke_sakura_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_16","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_16","text":"Seimeikai is an organization that operates in the underworld.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_17","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_17","text":"Getting civilians involved, in any capacity, isn't good for business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_18","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_18","text":"Then again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_19","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_19","text":"I'd feel rather rude kicking you out after you came so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_20","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_20","text":"... I'll take you to the room you'll be staying in. For the time being, you and I will have to stick together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_21","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_21","text":"Our members need to learn how to show you some respect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_22","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_22","text":"Come to think of it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_23","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_23","text":"Have you ever dealt with anyone from... the wrong side of the tracks, shall we say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_24","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_24","text":"I've dealt with far worse than these thugs.","jump":"d_nikke_sakura_01_26","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_25","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_25","text":"I won't lie, I am a bit scared.","jump":"d_nikke_sakura_01_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_26","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_26","text":"That's good to hear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_27","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_27","text":"I won't need to hold your hand every step of the way.","jump":"d_nikke_sakura_01_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_28","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_28","text":"You are, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_29","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_29","text":"It's understandable. In that case, I'll stick close to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_30","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_30","text":"No one makes for an easier target than the frightened.","jump":"d_nikke_sakura_01_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_31","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_01_31","text":"Anyway, make yourself at home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_32","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_32","text":"Sometime later.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_33","type":"Speech","speaker":"member","key":"Locale_NikkeEpisode:d_nikke_sakura_01_33","text":"This is the room you'll be staying in.","jump":null,"exit":false,"enter":null,"bg":"TatamiRoom","bgArt":"tatamiroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_34","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_34","text":"Right beside Sakura's room?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_35","type":"Speech","speaker":"member","key":"Locale_NikkeEpisode:d_nikke_sakura_01_35","text":"Yes, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_36","type":"Speech","speaker":"member","key":"Locale_NikkeEpisode:d_nikke_sakura_01_36","text":"Given your background, our leader has some concerns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_37","type":"Speech","speaker":"member","key":"Locale_NikkeEpisode:d_nikke_sakura_01_37","text":"We have been advised to keep you in our sight at all times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_38","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_01_38","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_01_39","type":"Speech","speaker":"member","key":"Locale_NikkeEpisode:d_nikke_sakura_01_39","text":"Starting tomorrow, you'll be shadowing the leader.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"