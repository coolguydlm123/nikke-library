tstepwalkrun2_04_e_96","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_96","text":"I didn't have a choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_97","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_97","text":"I lost consciousness, and when I came to, I was already a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_98","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_98","text":"Same as me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_99","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_99","text":"That's surprising.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_100","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_100","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_101","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_101","text":"I was... what you could call a hoodlum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_102","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_102","text":"My entire life revolved around avoiding work and hanging out with my friends,