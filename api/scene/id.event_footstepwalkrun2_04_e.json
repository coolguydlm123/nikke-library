n2_04_e_70","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_70","text":"Won't that make it hard for our allies to react?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_71","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_71","text":"In situations like that, you've got to have faith that your allies will come in clutch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_72","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_72","text":"That's easier said than done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_73","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_73","text":"This applies to more than combat, by the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_74","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_74","text":"The same can be said for nearly every aspect of life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_75","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_75","text":"Basically, what I'm trying to say is that you need to trust your gut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_76","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_76","text":"Have you ever done that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_77","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_77","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_78","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_78","text":"Oh, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_79","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_79","text":"I struck a Nikke who was speaking ill of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_80","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_80","text":"... You?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_81","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_81","text":"And... I don't exactly remember when, but I once gave a present to a squadmate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_82","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_82","text":"... You?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,