_e_108","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_108","text":"So, having worked that hard, um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_109","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_109","text":"You know, this is the first time I've ever talked about any of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_110","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_110","text":"Anyway, the thing I ended up thinking most often of all was:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_111","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_111","text":"Let's beat the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_112","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_112","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_113","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_113","text":"My squadmates really influenced me a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_114","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_114","text":"There's a saying that really summed up my life then:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_115","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_115","text":"My existence was made complete by the existence of others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_116","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_116","text":"... Your squadmates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_117","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_117","text":"Try and be friends with them as much as you can. They'll prove invaluable, mark my words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_118","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_118","text":"Besides, it gets awful lonely going solo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_119","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_119","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_120","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_120","text":"I'm hitting the sack. Sleep tight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,