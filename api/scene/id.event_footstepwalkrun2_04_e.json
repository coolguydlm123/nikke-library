{"id":"event_footstepwalkrun2_04_e","cat":"event","group":{"id":"ev40066","label":"FOOTSTEP, WALK, RUN · Part 1"},"label":"Like a Miracle: B","stage":null,"prev":"event_footstepwalkrun2_04_s","next":"event_footstepwalkrun2_05_s","speakers":{"rapi_m":"Rapi","redhood":"Red Hood"},"icons":{"rapi_m":"si_c994_00_s","redhood":"si_c470_00_s"},"lines":[{"id":"event_footstepwalkrun2_04_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun2_04_e_1","text":"Evening.","jump":null,"exit":false,"enter":null,"bg":"Wasteland_03_n","bgArt":"wasteland_03_n","image":null,"bgm":"none","movie":null,"shown":["rapi_m","redhood"],"affinity":null},{"id":"event_footstepwalkrun2_04_e_2","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_2","text":"Red Hood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_3","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_3","text":"Yeah?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_4","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_4","text":"Why did you help me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_areah","movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_5","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_5","text":"What? Where's this coming from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_6","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_6","text":"You woke up after 30 years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_7","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_7","text":"You could've searched for your old squadmates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_8","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_8","text":"Or completed something you weren't able to finish before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_9","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_9","text":"I considered that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_10","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_10","text":"But I parted ways with my squadmates pretty gracefully,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_11","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_11","text":"so I feel my story with them came to a satisfying conclusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_12","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_12","text":"Besides, they're all probably busy with other things right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_13","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_13","text":"I'm not worried about them. I'm sure they're doing well on their own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_14","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_14","text":"Also, there's no guarantee I'd be able to find them anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_15","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_15","text":"So I decided to help the person who was right in front of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_16","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_16","text":"Who acts like if she died tomorrow, she wouldn't feel any remorse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_17","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_17","text":"I still feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_18","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_18","text":"*Sigh*... Foolish student. Why do you choose to live life so halfheartedly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_19","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_19","text":"Go live your life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_20","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_20","text":"Living is a wonderful thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_21","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_21","text":"If you keep living, you'll find something. I guarantee it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_22","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_22","text":"Not least of all because you'll be a bonafide graduate of the Red Hood Academy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_23","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_23","text":"Tell me more about your squadmates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_24","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_24","text":"Why? So you can go find them and ask them to be your squadmates?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_25","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_26","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_26","text":"I knew it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_27","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_27","text":"I won't tell you. They're mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_28","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_28","text":"I can say this much, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_29","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_29","text":"They were strong. In many ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_30","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_30","text":"They're the type where it was impossible to imagine them bending or breaking, like you say about me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_31","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_31","text":"Do you think I'll ever have my own squadmates like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_32","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_32","text":"You'll have to become unbendable first. Unbreakable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_33","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_33","text":"Birds of a feather flock together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_34","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_34","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_35","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_35","text":"So keep at it. To be honest, the first order of business is working on that boring personality of yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_36","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_36","text":"I will try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_37","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_37","text":"It's a shame I never got to visit my hometown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_38","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_38","text":"Where is your hometown?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_39","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_39","text":"I don't know. I have no idea where we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_40","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_40","text":"I can find out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_41","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_41","text":"It's fine. I'm too scared to go. What if it's gone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_42","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_42","text":"Even so, I think you should at least try to visit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_43","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_43","text":"Nah. We don't have time for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_44","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_45","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_45","text":"What was your hometown like?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_46","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_46","text":"Just an ordinary village.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_47","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_47","text":"Nothing special. Like any old village you find anywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_48","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_48","text":"Although that makes me miss it even more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_49","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_50","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_50","text":"Don't think too hard about it. We can't go anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_51","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_51","text":"Let's get some sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_52","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_52","text":"Why aren't you getting this?","jump":null,"exit":false,"enter":null,"bg":"WasteLand_03","bgArt":"wasteland_03","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_53","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_53","text":"You run, make a sharp turn, and then? You aim and shoot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_54","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_54","text":"This gun's center of mass makes that kind of movement impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_55","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_55","text":"The Red Hood style does not discriminate against any type of firearm! Foolish student!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_56","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_e_57","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_e_57","text":"You try it.","jump":n