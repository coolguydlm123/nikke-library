{"id":"d_contents_lostsector_01","cat":"sub","group":{"id":"d_contents_lostsector","label":"Contents Lostsector"},"label":"d_contents_lostsector_01","stage":null,"prev":null,"next":null,"speakers":{"signal":"Signal","delta":"Delta"},"icons":{"signal":"si_c022_00_s","delta":"si_c020_00_s"},"lines":[{"id":"d_contents_lostsector_01_1","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_1","text":"Uh. C-Commander?","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":"bgm_inark","movie":null,"shown":["signal","delta"],"affinity":null},{"id":"d_contents_lostsector_01_2","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_2","text":"Umm... Commander?\n Why are you here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_3","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_lostsector_01_3","text":"Just ended up here. No reason in particular.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_4","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_5","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_5","text":"Aren't you here because you're interested in the Lost Sector?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_6","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_lostsector_01_6","text":"The Lost Sector?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_7","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_7","text":"Yes, this is the hub of the Lost Sector.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_8","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_lostsector_01_8","text":"Can you tell me more?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_9","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_9","text":"You got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_10","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_10","text":"Signal, go ahead and explain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_11","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_11","text":"Huh? You want me to do it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_12","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_12","text":"Well yeah, didn't we agree to split the work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_13","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_13","text":"Ohh. Umm.\nRight, I'll do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_14","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_14","text":"The Lost Sector is a place that was originally intended to become an Ark but failed to do so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_15","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_15","text":"In the past, there were several Ark candidates... Umm, how many were there again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_16","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_16","text":"It was in the dozens.\nBut we're not sure of the exact number.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_17","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_17","text":"Yes, there were dozens of Ark candidates in the past. But all the other places have been destroyed by the Raptures except for here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_18","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_18","text":"Some of the places were destroyed soon after construction began, but most were destroyed when they were near completion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_19","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_19","text":"So there is plenty of lost technology and leftover materials to scavenge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_20","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_20","text":"The most important of these is the black box called Harmony Cube.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_21","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_21","text":"We regularly embark on expeditions for this very purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_22","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_22","text":"Uh, isn't that right, Delta?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_23","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_23","text":"Precisely. Well done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_24","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_24","text":"To further elaborate, since the Lost Sector was an Ark candidate close to completion, there are a lot of valuable resources and even facilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_25","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_25","text":"Some of them are strewn about and get in the way of expeditions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_26","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_26","text":"Plenty of the machinery and robots that were involved in the construction are still there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_27","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_27","text":"What's more, the Lost Sector is fully overrun by the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_28","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_28","text":"Therefore, only Commanders of a Nikke squad are permitted to investigate the territory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_29","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_lostsector_01_29","text":"Why are you two here, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_30","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_30","text":"As I mentioned, the Lost Sector is full of lost technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_31","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_31","text":"It's quite hard to investigate without the help of a reconnaissance squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_32","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_32","text":"As a part of the Scouts, Signal and I are assisting Commanders in investigating the Lost Sector.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_33","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_lostsector_01_33","text":"Will you also help me if I go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_34","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_34","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_35","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_35","text":"A-are you going to go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_36","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_36","text":"Actually, not many people have been going to the Lost Sector lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_37","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_37","text":"So we've been on standby here for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_38","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_38","text":"If you want to go, we'll do our best to assist you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_39","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_lostsector_01_39","text":"All right then. I'm going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_40","type":"Speech","speaker":"signal","key":"Locale_SubScenario:d_contents_lostsector_01_40","text":"Wow! R-really!?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_41","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_41","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_lostsector_01_42","type":"Speech","speaker":"delta","key":"Locale_SubScenario:d_contents_lostsector_01_42","text":"Set out as soon as preparations are complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}