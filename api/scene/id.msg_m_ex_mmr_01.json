{"id":"msg_m_ex_mmr_01","cat":"messenger","group":{"id":"room_mmr","label":"M.M.R. · Group"},"label":"1. @Ether","stage":null,"prev":null,"next":"msg_m_ex_mmr_02","speakers":{"mana":"Mana","ether":"Ether"},"icons":{"mana":"si_c290_00_s","ether":"si_c291_00_s"},"lines":[{"id":"m_ex_mmr_01_1","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_1","text":"@Ether","jump":null},{"id":"m_ex_mmr_01_2","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_2","text":"On the last Thursday of this month,","jump":null},{"id":"m_ex_mmr_01_3","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_3","text":"there will be a conference on our latest findings.","jump":null},{"id":"m_ex_mmr_01_4","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_4","text":"We're due to receive subsidies from the Central Government,","jump":null},{"id":"m_ex_mmr_01_5","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_5","text":"and Missilis will be granting us additional funds as well.","jump":null},{"id":"m_ex_mmr_01_6","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_6","text":"Make sure you are prepared.","jump":null},{"id":"m_ex_mmr_01_7","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_7","text":"OK.","jump":null},{"id":"m_ex_mmr_01_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_8","text":"An entire conference dedicated to the institute, very impressive.","jump":null},{"id":"m_ex_mmr_01_9","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_9","text":"Hardly.","jump":null},{"id":"m_ex_mmr_01_10","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_10","text":"We're simply","jump":null},{"id":"m_ex_mmr_01_11","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_11","text":"reporting back to our superiors.","jump":null},{"id":"m_ex_mmr_01_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_12","text":"Can I join?","jump":null},{"id":"m_ex_mmr_01_13","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_13","text":"Sure :)","jump":null},{"id":"m_ex_mmr_01_14","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_14","text":"If you're willing to be a test subject for my human-Rapture defect research,","jump":null},{"id":"m_ex_mmr_01_15","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_15","text":"I could bring you up as a model example at the conference.","jump":null},{"id":"m_ex_mmr_01_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_16","text":"No thanks.","jump":null},{"id":"m_ex_mmr_01_17","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_17","text":"Hee-hee.","jump":null},{"id":"m_ex_mmr_01_18","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_18","text":"There is still some time before the conference.","jump":null},{"id":"m_ex_mmr_01_19","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_19","text":"Think about it :)","jump":null},{"id":"m_ex_mmr_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_20","text":"No thanks.","jump":null},{"id":"m_ex_mmr_01_21","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_21","text":"@Ether","jump":null},{"id":"m_ex_mmr_01_22","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_22","text":"Syuen dropped off an unknown substance just now.","jump":null},{"id":"m_ex_mmr_01_23","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_23","text":"She asked me to examine it at once.","jump":null},{"id":"m_ex_mmr_01_24","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_24","text":"However, it's not in line with my research field,","jump":null},{"id":"m_ex_mmr_01_25","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_25","text":"so I've passed it along to your division.","jump":null},{"id":"m_ex_mmr_01_26","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_26","text":"OK.","jump":null},{"id":"m_ex_mmr_01_27","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_27","text":"Syuen?","jump":"m_ex_mmr_01_29"},{"id":"m_ex_mmr_01_28","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_28","text":"Unknown substance?","jump":"m_ex_mmr_01_31"},{"id":"m_ex_mmr_01_29","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_29","text":"Yeah.","jump":null},{"id":"m_ex_mmr_01_30","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_30","text":"She's always tossing things in here and leaving without a care in the world.","jump":"m_ex_mmr_01_34"},{"id":"m_ex_mmr_01_31","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_31","text":"Usually things dug up on the surface.","jump":null},{"id":"m_ex_mmr_01_32","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_32","text":"Sometimes they're Rapture parts.","jump":null},{"id":"m_ex_mmr_01_33","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_33","text":"Sometimes they're man-made objects from the old times.","jump":null},{"id":"m_ex_mmr_01_34","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_34","text":"Anyway, what's the deadline?","jump":null},{"id":"m_ex_mmr_01_35","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_35","text":"They said they'd give us one week.","jump":null},{"id":"m_ex_mmr_01_36","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_36","text":"That may seem like plenty of time for Syuen,","jump":null},{"id":"m_ex_mmr_01_37","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_37","text":"but the problem is, how does this coincide with our preparations for the conference?","jump":null},{"id":"m_ex_mmr_01_38","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_38","text":"Can we do it?","jump":null},{"id":"m_ex_mmr_01_39","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_39","text":"If not, we'll make it work anyway.","jump":null},{"id":"m_ex_mmr_01_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_40","text":"You all work really hard.","jump":null},{"id":"m_ex_mmr_01_41","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_41","text":"That's how we operate.","jump":null},{"id":"m_ex_mmr_01_42","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_42","text":"Our superiors don't arrange work according to our schedule.","jump":null},{"id":"m_ex_mmr_01_43","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_43","text":"Is it not the same with your boss, Andersen?","jump":null},{"id":"m_ex_mmr_01_44","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_44","text":"No comment.","jump":"m_ex_mmr_01_46"},{"id":"m_ex_mmr_01_45","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mmr_01_45","text":"True.","jump":"m_ex_mmr_01_46"},{"id":"m_ex_mmr_01_46","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_46","text":"You see, it's a universal problem.","jump":null},{"id":"m_ex_mmr_01_47","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_47","text":"But our employees are all very capable.","jump":null},{"id":"m_ex_mmr_01_48","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_48","text":"I'm sure we'll be able to go home by midnight :)","jump":null},{"id":"m_ex_mmr_01_49","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_49","text":"@Ether","jump":null},{"id":"m_ex_mmr_01_50","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_50","text":"?","jump":null},{"id":"m_ex_mmr_01_51","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_51","text":"Andersen, the Deputy Chief who the Commander mentioned just now.","jump":null},{"id":"m_ex_mmr_01_52","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_52","text":"He asked for a copy of the survey materials covering M.M.R.'s new technology development status.","jump":null},{"id":"m_ex_mmr_01_53","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_53","text":"Stop, I don't want to hear it.","jump":null},{"id":"m_ex_mmr_01_54","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_54","text":"The deadline is the day after tomorrow.","jump":null},{"id":"m_ex_mmr_01_55","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_55","text":"I can't take this anymore.","jump":null},{"id":"m_ex_mmr_01_56","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_56","text":"Make sure to have it ready when he needs it.","jump":null},{"id":"m_ex_mmr_01_57","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_57","text":"Is the printing room available?","jump":null},{"id":"m_ex_mmr_01_58","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_58","text":"The printing room?","jump":null},{"id":"m_ex_mmr_01_59","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_59","text":"Yes.","jump":null},{"id":"m_ex_mmr_01_60","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_60","text":"I'm considering writing my resignation letter and opening my own research institute :)","jump":null},{"id":"m_ex_mmr_01_61","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_61","text":"Don't even think about it!","jump":null},{"id":"m_ex_mmr_01_62","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_62","text":"Why not?","jump":null},{"id":"m_ex_mmr_01_63","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mmr_01_63","text":"If you leave, I'll have to do all your work.","jump":null},{"id":"m_ex_mmr_01_64","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_mmr_01_64","text":"Hahaha...","jump":null}],"chat":true}