speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_c_3_01_78","text":"You're not the kind of person to dump her on us and then slink off, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_3_01_79","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_c_3_01_79","text":"Of course not!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_3_01_80","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_c_3_01_80","text":"The Commander would never do such a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_3_01_81","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_c_3_01_81","text":"... Fine, I'll come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_3_01_82","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_c_3_01_82","text":"In that case, let's go. We'll give you a proper tour of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_3_01_83","type":"Speech","speaker":"c_3","key":"Locale_NikkeEpisode:d_nikke_c_3_01_83","text":"Right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_3_01_84","type":"Speech","speaker":"c_3","key":"Locale_NikkeEpisode:d_nikke_c_3_01_84","text":"Uh... Okay... Then, I guess I should get up...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_3_01_85","type":"Monologue","speaker":null,"key":"