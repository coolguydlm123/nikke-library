xt":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_35","type":"Speech","speaker":"ce004_03_s","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_35","text":"From how you've described it so far, it sounds anything but fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_36","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_36","text":"Now that I'm in my third year, I understand it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_37","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_37","text":"It's only boring if you focus on the boring parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_38","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_38","text":"If you concentrate on the fun parts, then you're bound to have fun!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_39","type":"Speech","speaker":"ce004_03_s","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_39","text":"You have a real talent for making boring things sound entertaining.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_40","type":"Speech","speaker":"ce004_03_s","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_40","text":"Now I'm curious about what you consider the fun parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,