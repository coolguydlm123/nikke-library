ull},{"id":"d_nikke_ce004_03_03_7","type":"Speech","speaker":"ce004_03_s","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_7","text":"In my experience, training can get pretty intense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_8","type":"Speech","speaker":"ce004_03_s","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_8","text":"You must have a few students who get injured or fall behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_9","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_9","text":"Fall behind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_10","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_10","text":"I'm not quite sure I follow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_11","type":"Speech","speaker":"ce004_03_s","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_11","text":"As in \"drop out\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_12","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_12","text":"Oh, gotcha. Yeah, that can happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_mystery","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce004_03_03_13","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_ce004_03_03_13","text":"If you don't get a good grade on your final exams, you flunk a grade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,