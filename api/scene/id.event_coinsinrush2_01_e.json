Locale_MainScenario:event_coinsinrush2_01_e_76","text":"... Tch, can't exactly say no when you put it like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_01_e_77","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_01_e_77","text":"So, what's the plan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_01_e_78","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_01_e_78","text":"First off, Rouge, how's the réaction du public?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_01_e_79","type":"Speech","speaker":"rouge_b","key":"Locale_MainScenario:event_coinsinrush2_01_e_79","text":"The response has been positive so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_01_e_80","type":"Speech","speaker":"rouge_b","key":"Locale_MainScenario:event_coinsinrush2_01_e_80","text":"Most guests are excited about the new event and are actively participating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_01_e_81","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_01_e_81","text":"C'est bien.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_01_e_82","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_coinsinrush2_01_e_82","text":"Everyone, I have une nouvelle mission for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"imag