,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_observationpost_05_82","type":"Speech","speaker":"rosanna","key":"Locale_SuddenStory:d_ex_observationpost_05_82","text":"It's just unnecessary to feel hurt every time there's a traitor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_observationpost_05_83","type":"Speech","speaker":"rosanna","key":"Locale_SuddenStory:d_ex_observationpost_05_83","text":"I'm very busy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_observationpost_05_84","type":"Speech","speaker":"signal","key":"Locale_SuddenStory:d_ex_observationpost_05_84","text":"Wow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_observationpost_05_85","type":"Speech","speaker":"rosanna","key":"Locale_SuddenStory:d_ex_observationpost_05_85","text":"I'm really busy. I'll be off now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_observationpost_05_86","type":"Speech","speaker":"rosanna","key":"Locale_SuddenStory:d_ex_observationpost_05_86","text":"Mister, Signal, please take care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_observationpost_05_87","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_observationpost_05_87","text":"You too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_observationpost_05_88","type":"Speech","speaker":"signal","key":"Locale_SuddenStory:d_ex_observationpost_05_88","text":"Be careful on your way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null