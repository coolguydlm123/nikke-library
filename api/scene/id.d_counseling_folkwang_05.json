{"id":"d_counseling_folkwang_05","cat":"counsel","group":{"id":"char5039","label":"Folkwang"},"label":"Advising Folkwang: 05","stage":null,"prev":"d_counseling_folkwang_04","next":"d_counseling_folkwang_06","speakers":{"folkwang":"Folkwang"},"icons":{"folkwang":"si_c242_00_s"},"lines":[{"id":"d_counseling_folkwang_05_1","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_05_1","text":"Coach, what kind of weather do you like the most?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["folkwang"],"affinity":"_0"},{"id":"d_counseling_folkwang_05_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_folkwang_05_2","text":"Sunny days.","jump":"d_counseling_folkwang_05_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_folkwang_05_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_folkwang_05_3","text":"Cloudy days.","jump":"d_counseling_folkwang_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_folkwang_05_4","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_05_4","text":"I don't like sunny days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_05_5","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_05_5","text":"They're always too hot for me.","jump":"d_counseling_folkwang_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_folkwang_05_6","type":"Speech","speaker":"folkwang","key":"Locale_Counseling:d_counseling_folkwang_05_6","text":"Me, too! Cloudy days are