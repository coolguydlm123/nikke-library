{"id":"d_nikke_sky_04","cat":"bond","group":{"id":"char5188","label":"Sky"},"label":"Naming the Feeling","stage":null,"prev":"d_nikke_sky_03","next":"d_nikke_sky_05","speakers":{"ade":"Ade","sky":"Sky","maleguest":"Male Customer","femaleguest":"Female Customer"},"icons":{"ade":"si_c310_00_s","sky":"si_c530_00_s","maleguest":"si_c911_00_s","femaleguest":"si_c912_00_s"},"lines":[{"id":"d_nikke_sky_04_1","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_1","text":"*Jingle*","jump":null,"exit":false,"enter":null,"bg":"MaidCafe","bgArt":"maidcafe","image":null,"bgm":"bgm_story_languor","movie":null,"shown":["sky","ade"],"affinity":null},{"id":"d_nikke_sky_04_2","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_2","text":"Welcome back, Miss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_3","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_3","text":"Will it be just you today?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_4","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_4","text":"If so, allow me to show you to your ta—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_5","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_5","text":"Just a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_6","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_6","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_7","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_7","text":"You don't need to show me to a table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_8","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_8","text":"I'm not here as a customer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_9","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_9","text":"I know this is a bit sudden, but I'd like to observe the cafe for the day, if that's all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_10","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_10","text":"Ob...serve?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_11","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_12","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_12","text":"If you don't mind, may I ask why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_13","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_13","text":"Actually, I tried calling someone I know \"Master\" just to see what it was like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_14","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_14","text":"But maids call people that all the time, don't they?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_15","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_15","text":"I thought I should learn a little about a maid's perspective before using it myself,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_16","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_16","text":"so I came here to learn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_17","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_17","text":"... May I ask what made you consider calling them \"Master\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_18","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_18","text":"Because he's such a dependable, caring person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_19","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_19","text":"Whenever he gives me one of his warm smiles,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_20","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_20","text":"it makes me feel all warm inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_21","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_21","text":"I thought that might be how a dog feels about its owner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_22","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_22","text":"So I started calling him Master, to express those same feelings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_23","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_23","text":"His smile warms your heart...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_24","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_24","text":"I think that's a rather different kind of affection...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_25","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_26","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_26","text":"Ade smiles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_27","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_27","text":"Rather than explain it to you, I think it would be far better for you to experience it for yourself, Miss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_28","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_28","text":"If you don't mind, would you care to spend the day as a maid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_29","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_29","text":"By experiencing it firsthand, you'll come to understand how a maid feels toward her master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_30","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_30","text":"And then, I invite you to compare those feelings with your own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_31","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_31","text":"You'll be able to see whether they're truly one and the same... or whether, in fact, they're quite different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_32","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_32","text":"Compare it... with my own feelings...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_33","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_33","text":"You're right. It's better to experience something for yourself than just watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_34","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_34","text":"All right, I'll give it a try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_35","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_35","text":"Sky bows her head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_36","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_36","text":"I look forward to working with you today!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_37","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_37","text":"Hehe, the pleasure is all mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_38","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_38","text":"Several hours later...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["maleguest"],"affinity":null},{"id":"d_nikke_sky_04_39","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_39","text":"Here's your omurice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_40","type":"Speech","speaker":"maleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_41","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_41","text":"Please enjoy your meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_42","type":"Speech","speaker":"maleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_42","text":"Aren't you going to cast the delicious spell?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_43","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_43","text":"Huh? The delicious spell?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_44","type":"Speech","speaker":"maleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_44","text":"You know, something like, \"Fluffy-wuffy, make it extra yummy ♡\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_45","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_45","text":"... Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_46","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_46","text":"Fluffy-wuffy, make it extra yummy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_47","type":"Speech","speaker":"maleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_47","text":"Put your heart into it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_48","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_48","text":"F-fluffy-wuffy, make it extra yummy ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_49","type":"Speech","speaker":"maleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_49","text":"Thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_50","type":"Speech","speaker":"femaleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_50","text":"Excuse me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["femaleguest"],"affinity":null},{"id":"d_nikke_sky_04_51","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_51","text":"A customer at another table raises her hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_52","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_52","text":"Yes, coming!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_53","type":"Speech","speaker":"femaleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_53","text":"Can I take a picture with you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_54","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_54","text":"A picture? Sure, no problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_55","type":"Speech","speaker":"femaleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_55","text":"Awesome! Can you do a cat pose and say \"meow\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_56","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_56","text":"A cat pose...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_57","type":"Speech","speaker":"femaleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_57","text":"Is that okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_58","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_58","text":"... Yes, it's fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_59","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_59","text":"M-meow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_60","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_60","text":"The camera clicks twice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_61","type":"Speech","speaker":"femaleguest","key":"Locale_NikkeEpisode:d_nikke_sky_04_61","text":"Oh my gosh, so cute!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_62","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_63","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_63","text":"The last customer leaves the Maid Cafe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ade"],"affinity":null},{"id":"d_nikke_sky_04_64","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_64","text":"We shall look forward to your return, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_65","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_65","text":"Thank you, please come again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_66","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_66","text":"*Jingle*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_67","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_67","text":"Phew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_68","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_68","text":"Sky leans against a table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_69","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_69","text":"My, was it terribly tiring?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_70","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_70","text":"I'm physically fine, but mentally, I'm exhausted...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_71","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_71","text":"You guys do this every single day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_72","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_72","text":"Of course, it's both our duty and our calling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_73","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_73","text":"Still, doing that every day can't be easy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_74","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_74","text":"As long as our masters are happy, that's all that matters to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_75","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_75","text":"We could ask for nothing more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_76","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_76","text":"That's what being a maid is all about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_77","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_77","text":"... I want him to be happy, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_78","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_78","text":"But that's not enough for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_79","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_79","text":"When he's happy, I want to be the one he's smiling at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_80","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_80","text":"I want him to tell me when something good happens,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_81","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_81","text":"and if I can, I want to be right there beside him, sharing in that happiness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_82","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_82","text":"I guess that's not quite the same as being a maid, is it...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_83","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_83","text":"In that case, I think you have your answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_84","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_84","text":"Sorry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_85","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_85","text":"What you're describing is wanting to be the most special person in someone's life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_86","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_86","text":"Surely you have some idea what that feeling is called, Miss?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_87","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_87","text":"... Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_88","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sky_04_88","text":"Sky's face turns red.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_89","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_sky_04_89","text":"Hehe, I think you've worked it out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_90","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_90","text":"... Yes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sky_04_91","type":"Speech","speaker":"sky","key":"Locale_NikkeEpisode:d_nikke_sky_04_91","text":"my feelings for him...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}