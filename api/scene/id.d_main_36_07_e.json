shown":null,"affinity":null},{"id":"d_main_36_07_e_86","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_36_07_e_86","text":"GraGre, don't forget to inhabit the mindset of a villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_87","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_07_e_87","text":"That's not my name, and I know nothing about being a villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_88","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_36_07_e_88","text":"Then let me remind you! The villain mindset is about helping the weak and standing up against the strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_89","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_07_e_89","text":"That doesn't sound particularly villainous to me, but okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_90","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_36_07_e_90","text":"Hurry up and go, or else these two will prattle on endlessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_91","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_36_07_e_91","text":"Cinderella and Grave look at me and nod,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_92","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_36_07_e_92","text":"and I nod back firmly in response.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_93","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_36_07_e_93","text":"Let's go, Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_94","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_36_07_e_94","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_95","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_36_07_e_95","text":"Cinderella and Grave follow the line,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["leviathan"],"affinity":null},{"id":"d_main_36_07_e_96","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_36_07_e_96","text":"and eventually disappear into the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_97","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_07_e_97","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_98","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_36_07_e_98","text":"You're not going to follow them, Leviathan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_07_e_99","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_36_07_e_99","text":"What? No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm