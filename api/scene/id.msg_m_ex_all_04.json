{"id":"msg_m_ex_all_04","cat":"messenger","group":{"id":"room_ex_all","label":"Outpost Group Chat · Group"},"label":"4. Commander!","stage":null,"prev":"msg_m_ex_all_03","next":"msg_m_ex_all_05","speakers":{"anis":"Anis","privaty":"Privaty"},"icons":{"anis":"si_c012_00_s","privaty":"si_c170_00_s"},"lines":[{"id":"m_ex_all_04_1","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_1","text":"Commander!","jump":null},{"id":"m_ex_all_04_2","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_2","text":"I found out your secret","jump":null},{"id":"m_ex_all_04_3","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_3","text":"when it comes to dispatching us.","jump":null},{"id":"m_ex_all_04_4","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_4","text":"Huh?","jump":"m_ex_all_04_6"},{"id":"m_ex_all_04_5","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_5","text":"This can't be good.","jump":"m_ex_all_04_6"},{"id":"m_ex_all_04_6","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_6","text":"Whenever you deploy us, you use that","jump":null},{"id":"m_ex_all_04_7","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_7","text":"Dispatch All button on your tablet,","jump":null},{"id":"m_ex_all_04_8","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_8","text":"don't you?","jump":null},{"id":"m_ex_all_04_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_9","text":"!!","jump":"m_ex_all_04_11"},{"id":"m_ex_all_04_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_10","text":"Um... no, I don't.","jump":"m_ex_all_04_14"},{"id":"m_ex_all_04_11","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_11","text":"I knew it!","jump":null},{"id":"m_ex_all_04_12","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_12","text":"I always see you pressing that button,","jump":null},{"id":"m_ex_all_04_13","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_13","text":"so that's why I figured I'm always being sent on assignments.","jump":"m_ex_all_04_17"},{"id":"m_ex_all_04_14","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_14","text":"What are you talking about?","jump":null},{"id":"m_ex_all_04_15","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_15","text":"I saw you press it with my own eyes!","jump":null},{"id":"m_ex_all_04_16","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_16","text":"If you weren't pressing it, how come I'm always being sent on assignments?","jump":"m_ex_all_04_17"},{"id":"m_ex_all_04_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_17","text":"What can I say, you've got rotten luck.","jump":null},{"id":"m_ex_all_04_18","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_18","text":"You're saying I'm unlucky?","jump":null},{"id":"m_ex_all_04_19","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_19","text":"May I remind you,","jump":null},{"id":"m_ex_all_04_20","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_20","text":"that Rapi and I have been here since the very beginning?","jump":null},{"id":"m_ex_all_04_21","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_21","text":"When the Outpost was entirely bereft of all other manpower,","jump":null},{"id":"m_ex_all_04_22","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_22","text":"Rapi and I were here, keeping down the fort.","jump":null},{"id":"m_ex_all_04_23","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_23","text":"So please, if you would, a little more respect.","jump":null},{"id":"m_ex_all_04_24","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_24","text":"Wow.","jump":null},{"id":"m_ex_all_04_25","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_25","text":"No wonder I've been getting selected","jump":null},{"id":"m_ex_all_04_26","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_26","text":"for so many missions.","jump":null},{"id":"m_ex_all_04_27","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_27","text":"It's because the Commander","jump":null},{"id":"m_ex_all_04_28","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_28","text":"has been deploying all of us automatically.","jump":null},{"id":"m_ex_all_04_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_29","text":"Isn't it better that it's automatic?","jump":null},{"id":"m_ex_all_04_30","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_30","text":"Huh?","jump":null},{"id":"m_ex_all_04_31","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_31","text":"What makes you say that?","jump":null},{"id":"m_ex_all_04_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_32","text":"Because then I'm not intentionally harassing any of you.","jump":null},{"id":"m_ex_all_04_33","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_33","text":"Hmm...","jump":null},{"id":"m_ex_all_04_34","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_34","text":"Huh?","jump":null},{"id":"m_ex_all_04_35","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_35","text":"You think so?","jump":null},{"id":"m_ex_all_04_36","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_36","text":"Yeah...","jump":null},{"id":"m_ex_all_04_37","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_37","text":"I suppose if you were deploying me intentionally,","jump":null},{"id":"m_ex_all_04_38","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_38","text":"I would be a bit more peeved.","jump":null},{"id":"m_ex_all_04_39","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_39","text":"On the other hand,","jump":null},{"id":"m_ex_all_04_40","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_40","text":"if it's all being handled by a machine, that makes it seem okay.","jump":null},{"id":"m_ex_all_04_41","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_41","text":"You're right.","jump":null},{"id":"m_ex_all_04_42","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_42","text":"There aren't any emotions involved if it's an automatic system.","jump":null},{"id":"m_ex_all_04_43","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_43","text":"Having said that,","jump":null},{"id":"m_ex_all_04_44","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_44","text":"if you could use a bit more consideration during our next deployment,","jump":null},{"id":"m_ex_all_04_45","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_45","text":"it'd be greatly appreciated.","jump":null},{"id":"m_ex_all_04_46","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_04_46","text":"Okay.","jump":null},{"id":"m_ex_all_04_47","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_47","text":"Good.","jump":null},{"id":"m_ex_all_04_48","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_all_04_48","text":"Well then, I'll head off on my assignment.","jump":null},{"id":"m_ex_all_04_49","type":"Speech","speaker":"privaty","key":"Locale_SuddenMessage:m_ex_all_04_49","text":"Same here.","jump":null}],"chat":true}