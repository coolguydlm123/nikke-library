{"id":"d_counseling_delta_ninjathief_18","cat":"counsel","group":{"id":"char5154","label":"Delta: Ninja Thief"},"label":"Advising Delta: Ninja Thief: 18","stage":null,"prev":"d_counseling_delta_ninjathief_17","next":"d_counseling_delta_ninjathief_19","speakers":{"delta_n":"Delta"},"icons":{"delta_n":"si_c023_00_s"},"lines":[{"id":"d_counseling_delta_ninjathief_18_1","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_1","text":"During our missions, we often run into the A.C.P.U.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["delta_n"],"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_2","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_2","text":"I understand that it is Poli and Quiry's duty to stop us,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_3","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_3","text":"yet I cannot deny a certain sense of regret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_4","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_4","text":"I feel somewhat conflicted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_18_5","text":"I just hope they'll turn a blind eye.","jump":"d_counseling_delta_ninjathief_18_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_delta_ninjathief_18_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_18_6","text":"We're all just doing our best in our own roles.","jump":"d_counseling_delta_ninjathief_18_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_delta_ninjathief_18_7","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_7","text":"I've thought about that as well,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_8","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_8","text":"but I do not wish to see the A.C.P.U. neglect their duties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_9","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_9","text":"Hmm... this is indeed a most vexing matter.","jump":"d_counseling_delta_ninjathief_18_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_10","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_10","text":"As you say, Commander,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_11","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_11","text":"we differ only in what we can do and the methods we employ.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_12","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_12","text":"In the end, all of us work for justice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_13","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_18_13","text":"Therefore, one day, even the A.C.P.U. may become good partners with us.","jump":"d_counseling_delta_ninjathief_18_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_18_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_18_14","text":"Delta and I talk about the relationship between the police and the Thieves of Justice.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}