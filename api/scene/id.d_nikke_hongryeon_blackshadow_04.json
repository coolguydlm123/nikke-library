,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_81","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_81","text":"I'm not one for such savagery. I'll pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_82","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_82","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_83","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_83","text":"Savagery?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_84","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_84","text":"I despise fighting at close quarters. It always leaves me all messy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_85","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_85","text":"I am a being that cherishes elegance whilst fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_86","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_86","text":"Elegance? What place dost that hath on the battlefield?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_87","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_87","text":"Do you know what people call us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_88","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_88","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_89","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_89","text":"They call us the Goddess of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_90","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_90","text":"The least we can do is live up to that name and make ourselves look good while doing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_91","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_91","text":"Instead of slogging through the mud and filth to victory, we must overwhelm our foes with a graceful flourish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_92","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_92","text":"If we want to be Goddesses, then a certain poise is called for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_93","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_93","text":"Thou hast been blinded by thy vanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_94","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_94","text":"Not only must we emerge victorious,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_95","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_95","text":"but our triumph must also be adorned with grace and beauty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_96","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_96","text":"Only by doing so can we continue to be radiant beacons of hope for all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_97","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_97","text":"Thou and I are very disparate individuals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_98","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_98","text":"You can say that again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_99","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_99","text":"I reckon that's why thou lost to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_100","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_100","text":"Whoa there, I only lost to you because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_101","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_101","text":"Because what? Tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_102","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_102","text":"... Nothing. Never mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_103","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_103","text":"Nay. Out with it, I do insist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_04_104","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_04_104","text":"I said it's nothing, forget it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}