{"id":"d_main_22_09","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"E.H.","stage":"22-27 STAGE · Start","prev":"d_main_22_08","next":"d_main_22_10","speakers":{"eh":"E.H.","moran":"Moran","rosanna":"Rosanna","sakura":"Sakura"},"icons":{"eh":"si_c940_00_s","moran":"si_c281_00_s","rosanna":"si_c280_00_s","sakura":"si_c282_00_s"},"lines":[{"id":"d_main_22_09_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_09_1","text":"40 minutes prior to the incident.","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":"bgm_story_conflict","movie":null,"shown":["eh"],"affinity":null},{"id":"d_main_22_09_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_09_2","text":"The Ark. Elevator hub J-910.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_3","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_4","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_4","text":"Time to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_5","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_5","text":"Elysion Harper!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["moran"],"affinity":null},{"id":"d_main_22_09_6","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_6","text":"Moran.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_7","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_7","text":"You know not to call me that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_8","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_8","text":"It's a name I left behind long ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_9","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_9","text":"Where are you going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_10","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_10","text":"I'm going back home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_11","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_11","text":"That's a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_12","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_12","text":"How about you leave those bags you're carrying, though?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_13","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_13","text":"Sorry, but I'm going to be needing these.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_14","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_14","text":"They're weapons that can protect us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_15","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_15","text":"All they're doing to do is get you killed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_16","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_16","text":"What makes you so sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_17","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_17","text":"I... because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_18","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_18","text":"Listen to us, you idiot. If you carry those around, what do you think is going to happen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rosanna","sakura"],"affinity":null},{"id":"d_main_22_09_19","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_19","text":"Is it bloodshed that you want? Because that's what you're going to get.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_20","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_20","text":"You guys were fast...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_21","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_21","text":"Long time no see. It's been a while since the Underworld Queen were all in the same place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_22","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_22","text":"Shut up and listen to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_23","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_23","text":"If you insist on using those, Heavenly Ascension will be designated as a terrorist group armed with advanced weaponry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_24","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_24","text":"I never said anything until now because all you ever had were obsolete weapons that didn't pose any threat. What you have there, however, changes everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_25","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_25","text":"It doesn't matter that those are Nikke weapons. What matters is that you possessing those makes you a credible threat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_26","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_26","text":"That will make the Central Government consider you public enemy number one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_27","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_27","text":"They'll wipe you all out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_28","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_28","text":"No matter how long it takes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_29","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_29","text":"And it won't be just Heavenly Ascension. The entire Outer Rim will be reduced to rubble.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_30","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_30","text":"Thousands of lives will be lost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_31","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_32","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_32","text":"I met with one of the Deputy Chiefs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_33","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_33","text":"When I said I had something serious to discuss, he penciled me right in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_34","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_35","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_35","text":"I requested that they station Nikkes in the Outer Rim as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_36","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_36","text":"Why Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_37","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_37","text":"I was scared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_38","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_38","text":"When I heard that the Raptures had gotten within spitting distance of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_39","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_39","text":"And when I heard that Matis had wiped them out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_40","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_40","text":"How not a single soul in the entire Outer Rim was taken into consideration throughout the entire process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_41","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_41","text":"That awakened a fear within me unlike anything I'd experienced before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_42","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_42","text":"I had forgotten.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_43","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_43","text":"Forgotten who our real enemy was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_44","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_44","text":"Why we locked ourselves in this dank underground prison.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_45","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_45","text":"So I begged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_46","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_46","text":"I pleaded with the Deputy Chief, while he sat there sipping on his tea like I was invisible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_47","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_47","text":"I said that everyone in the Outer Rim just wanted to live. They're people, too! So, could he please station a few Nikkes there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_48","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_48","text":"If he did, I would dismantle Heavenly Ascension and fade into obscurity. They could even close the barrier if they wanted to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_49","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_49","text":"As long as we had a chance to live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_50","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_50","text":"You know what he said to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_51","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_51","text":"... Enough","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_09_52","text":"None of you are human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_53","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_54","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_55","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_09_56","text":"Why would we dedicate our resources to something that's not human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_09_57","text":"It's best we leave the barriers open. We'll still need somewhere to dispose of our garbage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_58","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_58","text":"Then, he tried to kill me. But I escaped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_59","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_59","text":"He never intended on listening to a single word I had to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_60","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_60","text":"As far as they're concerned, the Outer Rim isn't a place where people live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_61","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_61","text":"It's a garbage heap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_62","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_62","text":"That's where we've been living.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_63","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_63","text":"Who?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_64","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_64","text":"Who said those things?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_65","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_65","text":"Moran. Answer me one thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_66","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_66","text":"Are we human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_67","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_67","text":"Of course you are!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_68","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_68","text":"You're all human beings! Living, breathing human beings!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_69","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_69","text":"Then why are we treated like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_70","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_70","text":"Th-they're the