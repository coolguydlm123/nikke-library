alse,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_78","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_78","text":"Yes. No one cares. No one has ever helped us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_79","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_79","text":"We care! We can help!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_80","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_09_80","text":"Underworld Queen! Me! Rosanna! Sakura! We'll all help!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_81","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_81","text":"I'm sorry, but I don't believe you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_82","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_82","text":"You ungrateful turd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_83","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_83","text":"Why do you think we went through all that rigamarole back at Coin Rush?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_84","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_09_84","text":"What are we doing here right now? You think we came here to get front-row seats to our own friend's suicide?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_85","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_85","text":"You're just following Mustang's orders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_86","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_09_86","text":"To protect the Outer Rim. By force if necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_87","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_87","text":"Yes. That is true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_88","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_88","text":"We were sent here to quell the conflict.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_89","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_89","text":"To erase any trace of it, so that we can ensure there'd be no loss of life inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_90","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_90","text":"Our mission is to suppress violence with violence,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_09_91","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_09_91","text":"and you're the one about