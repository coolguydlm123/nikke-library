{"id":"d_main_44_af_07","cat":"main","group":{"id":"ch44","label":"Chapter 44 · Path"},"label":"Threats and Deals","stage":null,"prev":"d_main_44_af_06","next":"d_main_44_af_08","speakers":{"doban":"Doban","rosanna":"Rosanna","sakura":"Sakura"},"icons":{"doban":"si_c939_00_s","rosanna":"si_c280_00_s","sakura":"si_c282_00_s"},"lines":[{"id":"d_main_44_af_07_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_1","text":"In Deputy Chief Doban's office.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_groundfall_a","movie":null,"shown":["doban","rosanna","sakura"],"affinity":null},{"id":"d_main_44_af_07_2","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_2","text":"You've got some nerve asking to see me. Fine, let's hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_3","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_3","text":"But I'm warning you: the moment you start spouting nonsense, I'll turn you into a beehive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_4","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_4","text":"Ooh, so scary, my dear Deputy Chief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_5","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_5","text":"We have come to speak with you. Perhaps it would be best if your subordinates were to withdraw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_6","text":"Doban's gaze sweeps over the mass-produced Nikkes that nearly fill the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_7","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_7","text":"I don't know what you bastards might pull, so I'm not taking any chances.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_8","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_8","text":"You've got a history of pointing guns at a deputy chief, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_9","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_9","text":"Would that be all right with you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_10","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_10","text":"We're about to discuss a rather sensitive matter. It wouldn't be wise for your subordinates to hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_11","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_11","text":"I appreciate the concern, but they're nothing more than decorations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_12","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_12","text":"Very well, if you wish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_13","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_13","text":"We have come to speak about Mist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_14","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_15","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_15","text":"First, let us examine this together...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_16","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_16","text":"Hold on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_17","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_17","text":"All of you, out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_18","text":"The mass-produced Nikkes hesitate for a moment, then make their way out of the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_19","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_19","text":"Haha, I see your decorations have legs of their own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_20","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_20","text":"You bastards, what the hell do you think you're doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_21","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_21","text":"It seems you already have some inkling,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_22","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_22","text":"so I need not show you the list.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_23","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_24","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_24","text":"It seems that quite a few of your men have purchased Mist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_25","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_25","text":"Guess life is boring when they have a boss like you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_26","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_26","text":"Never heard that before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_27","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_27","text":"Then I suggest you take this opportunity to listen carefully.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_28","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_28","text":"A number of your subordinates—no, in fact, a considerable majority of them—have records of purchasing Mist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_29","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_29","text":"And not merely once or twice. We have confirmed that they are habitual users.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_30","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_30","text":"I trust there is no need for me to explain what happens to military personnel caught using Mist, is there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_31","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_31","text":"... I had no idea about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_32","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_32","text":"Ah, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_33","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_33","text":"In that case, would it be all right if the Underworld Queen were to conduct an investigation and report the findings to the Central Government,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_34","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_34","text":"or perhaps to the press?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_35","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_35","text":"You punks think you can threaten me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_36","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_36","text":"Of course not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_37","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_37","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_38","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_38","text":"... I believe it would be wise for us to be on the same page.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_39","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_39","text":"Oh, my bad. Of course, we're not threatening you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_40","text":"*Bang!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_41","text":"Doban slams his fist on the table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_42","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_42","text":"You damn bastards! How dare you threaten a deputy chief of the Ark! You really must have a death wish!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_43","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_43","text":"Fine, what charge should I slap on you? Treason? Collusion? Just say the word!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_44","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_44","text":"Please calm yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_45","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_45","text":"We have come to make a deal with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_46","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_46","text":"From this moment onward, I ask that you take all authority from your subordinates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_47","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_47","text":"Whatever may occur,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_48","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_48","text":"ensure that they are unable to act.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_49","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_49","text":"Having them take some time off would also be an effective approach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_50","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_50","text":"As for the duration...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_51","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_51","text":"three days should suffice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_52","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_52","text":"Isn't that too short? Give 'em a week off, and they'll thank you for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_53","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_53","text":"{AccountData.NickName}-kun has also taken part, has he not? I cannot help but think that even three days is rather ample.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_54","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_54","text":"Heh, true that. Three days'll be more than enough for him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_55","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_55","text":"... What the hell are you playing at?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_56","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_56","text":"My men are the best of the best. What's the point of telling them to sit around and do nothing for three days?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_57","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_57","text":"Planning to let the Ark descend into chaos while they twiddle their thumbs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_58","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_58","text":"Among your subordinates, those who use Mist","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_59","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_59","text":"are nothing more than Sixo's puppets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_60","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_60","text":"To think that such individuals, mere playthings of a back-alley thug, should be entrusted with key positions in the Ark is utterly preposterous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_61","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_61","text":"You haven't exactly been blind to it, have you? Your men aren't what they used to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_62","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_62","text":"The power structure is intricately entwined, and one cannot simply strike at it without care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_63","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_63","text":"If we were to take out the puppet master herself, order would be restored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_64","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_64","text":"We shall see to it during those three days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_65","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_66","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_66","text":"You're going after Sixo? What a load of crap. That thing can't be caught.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_67","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_67","text":"As we said, we will see to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_68","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_68","text":"All you need to do is strip them of their authority for three days,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_69","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_69","text":"and thereafter, you may fully enjoy the benefits that follow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_70","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_70","text":"What's your game here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_71","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_71","text":"Sixo is presently preparing a large-scale terror attack on the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_72","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_72","text":"On the day of its execution, she intends to use your subordinates, who have been reduced to puppets, to sow confusion in the response.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_73","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_73","text":"It is our purpose to see this prevented.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_74","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_74","text":"You're getting almost nothing out of this. Spill your real plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_75","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_75","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_76","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_76","text":"While there are those like you who act solely for personal gain,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_77","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_77","text":"you would do well to remember that there are also those who act without seeking any.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_78","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_78","text":"You thugs sure talk big.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_79","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_79","text":"If you give us your word, we shall hand you this list in three days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_80","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_80","text":"I ask that you make your decision here, at this very moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_81","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_82","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_82","text":"Fine, I'll do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_83","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_83","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_84","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_84","text":"Rosanna, please check.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_85","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_85","text":"Let's see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_86","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_86","text":"Mm-hmm, all caught on tape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_87","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_87","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_88","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_44_af_07_88","text":"Very well, we shall be on our way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_89","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_44_af_07_89","text":"So the Deputy Chief doesn't even offer tea to his guests... Duly noted!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_90","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_90","text":"Sakura and Rosanna leave the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_91","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_92","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_92","text":"Doban rises from his seat, staring blankly into space.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_93","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_07_93","text":"Then he grabs whatever is within reach and hurls it, smashing it to smithereens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_94","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_94","text":"Damn it! Damn it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_95","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_95","text":"Those back‑alley thugs...! How dare they...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_96","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_96","text":"Aaaaaargh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_97","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_97","text":"*Huff... huff...*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_98","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_98","text":"This can't go on!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_99","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_99","text":"My influence... is slipping fast...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_100","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_100","text":"I've got to rack up a big achievement... something spectacular...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_07_101","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_44_af_07_101","text":"Anything just to prove myself...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}