{"id":"msg_m_ex_external_02","cat":"messenger","group":{"id":"room_external","label":"Extrinsic · Group"},"label":"2. Huh...","stage":null,"prev":"msg_m_ex_external_01","next":"msg_m_ex_external_03","speakers":{"guillotine":"Guillotine","maiden":"Maiden"},"icons":{"guillotine":"si_c180_00_s","maiden":"si_c181_00_s"},"lines":[{"id":"m_ex_external_02_1","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_1","text":"Huh...","jump":null},{"id":"m_ex_external_02_2","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_2","text":"Wah... I can't take it anymore.","jump":null},{"id":"m_ex_external_02_3","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_3","text":"How am I ever going to get over this?","jump":null},{"id":"m_ex_external_02_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_4","text":"What happened?","jump":null},{"id":"m_ex_external_02_5","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_5","text":"Maiden unfollowed me on Warbler.","jump":null},{"id":"m_ex_external_02_6","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_6","text":"She knows too much","jump":null},{"id":"m_ex_external_02_7","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_7","text":"about my true identity.","jump":null},{"id":"m_ex_external_02_8","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_8","text":"She must be eliminated.","jump":null},{"id":"m_ex_external_02_9","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_9","text":"Hey! Why do I have to die?","jump":null},{"id":"m_ex_external_02_10","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_10","text":"Your posts are so bizarre","jump":null},{"id":"m_ex_external_02_11","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_11","text":"and off-putting,","jump":null},{"id":"m_ex_external_02_12","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_12","text":"that no sane person would follow you.","jump":null},{"id":"m_ex_external_02_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_13","text":"What exactly does she post?","jump":null},{"id":"m_ex_external_02_14","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_14","text":"Guardian of Balance (@Darkmage) Warbled:\nThe moon tonight is exceptionally blood red.\nCould that be why my blood is boiling?","jump":null},{"id":"m_ex_external_02_15","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_15","text":"What on earth possessed you to write this?","jump":null},{"id":"m_ex_external_02_16","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_16","text":"For a long time, there is no reply from Guillotine.","jump":null},{"id":"m_ex_external_02_17","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_17","text":"If it weren't","jump":null},{"id":"m_ex_external_02_18","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_18","text":"for those posts on Warbler,","jump":null},{"id":"m_ex_external_02_19","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_19","text":"I wouldn't be able to control myself.","jump":null},{"id":"m_ex_external_02_20","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_20","text":"Why not just write them down in a diary or something?","jump":null},{"id":"m_ex_external_02_21","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_21","text":"That won't do.","jump":null},{"id":"m_ex_external_02_22","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_22","text":"If I want to contain myself,","jump":null},{"id":"m_ex_external_02_23","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_23","text":"I must have witnesses.","jump":null},{"id":"m_ex_external_02_24","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_24","text":"Fine, whatever.","jump":null},{"id":"m_ex_external_02_25","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_25","text":"Then what about this one?","jump":null},{"id":"m_ex_external_02_26","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_26","text":"Guardian of Balance (@Darkmage) Warbled:\nSometimes, I contemplate ending it all.\nBut doing this would disrupt the balance of the world.\nSuch is the lonely fate of a life fettered by cosmic equilibrium...","jump":null},{"id":"m_ex_external_02_27","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_27","text":"Yikes.","jump":"m_ex_external_02_29"},{"id":"m_ex_external_02_28","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_28","text":"I dunno, I think it sounds kinda cool.","jump":"m_ex_external_02_31"},{"id":"m_ex_external_02_29","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_29","text":"What's wrong","jump":null},{"id":"m_ex_external_02_30","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_30","text":"with that post?","jump":"m_ex_external_02_34"},{"id":"m_ex_external_02_31","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_31","text":"I knew you had good taste.","jump":null},{"id":"m_ex_external_02_32","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_32","text":"As for you Maiden,","jump":null},{"id":"m_ex_external_02_33","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_33","text":"what's wrong with that post?","jump":null},{"id":"m_ex_external_02_34","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_34","text":"I'm tired of bickering back-and-forth with you.","jump":null},{"id":"m_ex_external_02_35","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_35","text":"Just let me ask you one thing.","jump":null},{"id":"m_ex_external_02_36","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_36","text":"Don't balance and equilibrium","jump":null},{"id":"m_ex_external_02_37","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_37","text":"mean the same thing?","jump":null},{"id":"m_ex_external_02_38","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_38","text":"And why do you keep repeating them ad nauseam?","jump":null},{"id":"m_ex_external_02_39","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_39","text":"It doesn't make any sense.","jump":null},{"id":"m_ex_external_02_40","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_40","text":"Once again, Guillotine doesn't reply for a long time.","jump":null},{"id":"m_ex_external_02_41","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_41","text":"What a fool you are, Maiden!","jump":null},{"id":"m_ex_external_02_42","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_42","text":"The more you repeat your words, the more power they wield.","jump":null},{"id":"m_ex_external_02_43","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_43","text":"As a practitioner of the kotodama,","jump":null},{"id":"m_ex_external_02_44","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_44","text":"I'd think you of all people would understand that.","jump":null},{"id":"m_ex_external_02_45","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_45","text":"Also, if we're going to talk about disturbing others,","jump":null},{"id":"m_ex_external_02_46","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_46","text":"talk about the pot calling the kettle black!","jump":null},{"id":"m_ex_external_02_47","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_47","text":"Every thirty minutes my phone is flooded","jump":null},{"id":"m_ex_external_02_48","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_48","text":"with ads for some ridiculous new character in that game of yours.","jump":null},{"id":"m_ex_external_02_49","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_49","text":"Despite that, I was still nice enough to like every single one of your posts.","jump":null},{"id":"m_ex_external_02_50","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_50","text":"Also, you have a certain way with words as well:","jump":null},{"id":"m_ex_external_02_51","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_51","text":"Black Rose (@BlackRose) Warbled:\nOMG, you guys!\nI have incredible news!\nThis new version comes with a new character, and what a total beefcake!\nHurry and snatch him up while you still can!","jump":null},{"id":"m_ex_external_02_52","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_52","text":"You seem to be awfully fond...","jump":null},{"id":"m_ex_external_02_53","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_53","text":"Don't you dare say it...","jump":null},{"id":"m_ex_external_02_54","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_54","text":"Guulotiin!!!!","jump":null},{"id":"m_ex_external_02_55","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_55","text":"of repeating yourself as well!","jump":null},{"id":"m_ex_external_02_56","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_56","text":"That's it.","jump":null},{"id":"m_ex_external_02_57","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_57","text":"You better shut your mouth, before I shut it for you.","jump":null},{"id":"m_ex_external_02_58","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_58","text":"Don't forget that Commander is in the chat room as well.","jump":null},{"id":"m_ex_external_02_59","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_59","text":"How could you speak like that?","jump":null},{"id":"m_ex_external_02_60","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_60","text":"It doesn't matter...","jump":"m_ex_external_02_62"},{"id":"m_ex_external_02_61","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_61","text":"I think I'm a little out of my depth.","jump":"m_ex_external_02_64"},{"id":"m_ex_external_02_62","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_62","text":"And what is that ellipsis supposed to mean?","jump":null},{"id":"m_ex_external_02_63","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_63","text":"I don't think you're actually okay with it.","jump":"m_ex_external_02_65"},{"id":"m_ex_external_02_64","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_64","text":"I knew it!","jump":null},{"id":"m_ex_external_02_65","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_65","text":"Hehe...","jump":null},{"id":"m_ex_external_02_66","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_66","text":"I wouldn't go that far.","jump":null},{"id":"m_ex_external_02_67","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_67","text":"Partner has been around the block a few times.","jump":null},{"id":"m_ex_external_02_68","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_68","text":"Fine!","jump":null},{"id":"m_ex_external_02_69","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_69","text":"I surrender.","jump":null},{"id":"m_ex_external_02_70","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_70","text":"What do you want me to do?","jump":null},{"id":"m_ex_external_02_71","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_71","text":"If it means you'll quit badgering me, then I'll do it.","jump":null},{"id":"m_ex_external_02_72","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_72","text":"My request is simple:","jump":null},{"id":"m_ex_external_02_73","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_73","text":"Follow me again on Warbler.","jump":null},{"id":"m_ex_external_02_74","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_74","text":"Right.","jump":null},{"id":"m_ex_external_02_75","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_75","text":"Now.","jump":null},{"id":"m_ex_external_02_76","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_76","text":"Done.","jump":null},{"id":"m_ex_external_02_77","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_02_77","text":"Satisfied?","jump":null},{"id":"m_ex_external_02_78","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_78","text":"Great.","jump":null},{"id":"m_ex_external_02_79","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_79","text":"I trust we won't have to go through this again in the future?","jump":null},{"id":"m_ex_external_02_80","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_02_80","text":"Hehe... Hahaha!","jump":null},{"id":"m_ex_external_02_81","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_02_81","text":"... Maiden has stopped reading her messages.","jump":null}],"chat":true}