null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_118","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_11_118","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_119","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_11_119","text":"Then those lights...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_120","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_120","text":"Corruption of NIMPH! That light yonder!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_121","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_121","text":"Mine own NIMPH, now corrupted! It comes for me! There is no evading it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_122","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_11_122","text":"Then you...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_123","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_123","text":"Go at once! No more words!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_124","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_11_124","text":"Grrgh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_125","type"