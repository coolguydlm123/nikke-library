"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_97","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_97","text":"... A pity..","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_98","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_98","text":"The sword was too worn. Too frail to endure mine strikes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_99","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_99","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_100","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_100","text":"That it should end thus... I find it nothing short of regrettable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_101","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_101","text":"Snow White levels her gun at the stunned Egovista.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_102","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_102","text":"She glances toward Nayuta to call for backup,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_103","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_103","text":"but sees her staring into the distance, her face frozen in horror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_104","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_104","text":"We are undone...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_105","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_105","text":"Just as I feared...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_106","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_106","text":"We ought not have joined hands with an outsider.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_107","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_107","text":"Snow White follows Nayuta's gaze.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_46_01","bgArt":"eventscene_chap_46_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_108","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_108","text":"Dozens of glowing red orbs of light hurtle toward Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_redeyes","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_109","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_109","text":"Mantra!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_110","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_110","text":"A thunderous roar echoes in the distance, sending vibrations rippling through the air.","jump":null,"exit":false,"enter":null,"bg":nu