{"id":"d_main_46_11","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"Sword and Wings: B","stage":"46-40 BOSS · End","prev":"d_main_46_10","next":"d_main_46_af_01","speakers":{"egovista":"Egovista","snowwhite_h":"Snow White","nayuta":"Nayuta","janghwa_n":"Rose","mirror_r":"Mirror"},"icons":{"egovista":"si_c9025_00_s","snowwhite_h":"si_c471_00_s","nayuta":"si_c223_00_s","janghwa_n":"si_c971_01_s","mirror_r":"si_c982_00_s"},"lines":[{"id":"d_main_46_11_1","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_1","text":"Hahahahaha!","jump":null,"exit":false,"enter":null,"bg":"SpaceStationRoad","bgArt":"spacestationroad","image":null,"bgm":"bgm_story_redeyes_loop","movie":null,"shown":["snowwhite_h","nayuta","janghwa_n","egovista"],"affinity":null},{"id":"d_main_46_11_2","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_2","text":"Splendid! Truly splendid!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_3","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_3","text":"Never have I have fought so earnestly! Not since the day of my birth!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_4","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_4","text":"Though admittedly, I am newly born into the world Hahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_5","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_11_5","text":"Stop laughing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_6","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_6","text":"Young Lady Scarlet's and Young Lady Isabel's weapons...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_7","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_11_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_8","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_8","text":"I would fain give thee applause. Alas, I only have but one arm. Most vexing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_9","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_9","text":"I shall clap with mine mouth instead. Thou shalt have to make do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_10","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_10","text":"*Clap, clap, clap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_11","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_11_11","text":"You lunatic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_12","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_12","text":"I must confess, transforming doth dull the pleasure of the slice of mine blade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_13","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_13","text":"'Tis less like a cut and more a bludgeoning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_14","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_14","text":"Only in this body can I truly feel the joy of cutting something down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_15","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_15","text":"A poorly made thing, this body. Hahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_16","text":"*Whoooosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_17","text":"Snow White fires a barrage of missiles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_18","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_18","text":"Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_19","text":"Egovista's arm detaches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_20","text":"The sword it's holding lashes out like a whip.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_21","text":"With precise cuts, it slices through the incoming missiles before they can even explode.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_22","text":"The sword then swings toward Snow White's head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_23","text":"Snow White tilts her head slightly, evading the strike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_24","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_24","text":"My apologies, 'twas a reflex. Mine aim was merely to deflect the explosives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_25","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_25","text":"Though thou art not blameless either, attacking in the midst of conversation. Doth such conduct not violate the way of the sword?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_26","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_26","text":"Spare us the falsehoods. 'Tis plain to any soul that strike was aimed with intent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_27","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_27","text":"Nay, nay. 'Twas a mere mishap, as I said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_28","text":"Egovista vanishes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_29","text":"then lands between Nayuta and Snow White.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_30","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_30","text":"Ambushes are not my specialty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_31","text":"The sword swings wildly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_32","text":"Nayuta and Snow White both block and evade, but are grazed and sliced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_33","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_11_33","text":"Blast...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_34","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_11_34","text":"Tch...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_35","text":"Precisely refined close-quarters combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_36","text":"Neither Snow White nor Nayuta have experience against a sword-wielding opponent. They couldn't have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_37","text":"Against Raptures, gun fights are the standard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_38","text":"Some Raptures do engage in close combat, but their attacks are nothing more than straightforward physical aggression.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_39","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_39","text":"But Egovista plays mind games. She targets blind spots and vital points.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_40","text":"Nayuta knows self-defense, but not at a level to face a master like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_41","text":"Against a master of the blade, neither can mount a single counterattack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_42","text":"*Clang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_43","text":"Sword meets sword.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_44","text":"Rose blocks Egovista's strike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_45","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_45","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_46","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_11_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_47","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_47","text":"Well, well. If it isn't Mirror's puppet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_48","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_48","text":"What exactly dost thou think thou art doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_49","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_11_49","text":"Who knows. Perhaps facing a sword-wielder after so long stirred my spirit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_50","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_50","text":"Hahaha! A hollow husk with no blood to boil. What rubbish doth thou speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_51","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_11_51","text":"Rich words coming from something that imitates humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_52","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_52","text":"... Hah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_53","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_53","text":"Their blades clash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_54","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_54","text":"From a distance, Mirror watches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mirror_r"],"affinity":null},{"id":"d_main_46_11_55","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_56","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_56","text":"This is no good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_57","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_57","text":"Ugh... They really are completely helpless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_58","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_58","text":"Even with half their forces remaining...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_59","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_59","text":"They're struggling this much against a single newborn Heretic...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_60","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_60","text":"Altruia's retreat was likely due to that strange wall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_61","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_61","text":"These new Raptures will just keep getting better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_62","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_62","text":"The Queen will secure the Dark Matter, and those half-baked things aren't going to pose an obstacle to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_63","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_63","text":"Eden is still devastated, and the Ark shows no sign of mobilizing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_64","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_64","text":"On top of that, Marian's gene is now in the Queen's hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_65","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_66","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_66","text":"Hmm. I've decided.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_67","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_67","text":"It's a shame to abandon everything I've invested, but the Queen is on a whole other level. Perhaps her descent was the problem from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_68","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_68","text":"There's no other choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_69","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_69","text":"This is the right call.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_70","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_71","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_71","text":"Ugh, what a waste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_72","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_72","text":"Both Marian and the Ark. Such a shame.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_73","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_73","text":"After all that effort I've put in...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_74","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_74","text":"The Queen obtaining a new body was the deciding factor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_75","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_75","text":"Otherwise, she could've been stopped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_76","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_76","text":"... Right. Time is infinite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_77","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_11_77","text":"I'll just have to look for the next opportunity...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_78","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_78","text":"With a quiet crackle of static, Mirror vanishes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["snowwhite_h","nayuta","janghwa_n","egovista"],"affinity":null},{"id":"d_main_46_11_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_79","text":"*Clang, clang, clang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_80","text":"Rose and Egovista's blades clash in a flurry of exchanges.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_81","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_81","text":"They are evenly matched, but one side begins to falter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_82","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_82","text":"The difference in physical specs is overwhelming, but the difference in swordsmanship is overwhelming enough to cancel it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_83","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_83","text":"Rose drives Egovista back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_84","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_84","text":"Impossible! How...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_85","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_11_85","text":"You were going on about the way of the sword. You should know how meaningless ideals are when they're bereft of power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_86","type":"Speech","speaker":"egovista","key":"Locale_MainScenario:d_main_46_11_86","text":"Silence, thou empty husk!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_87","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_87","text":"Egovista swings her blade in desperation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_88","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_88","text":"Her movements are wide and sweeping, the kind that happens when emotion overtakes the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_11_89","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_11_89","text