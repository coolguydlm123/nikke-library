","key":"Locale_NikkeEpisode:d_nikke_miranda_05_117","text":"You gave me courage... and trust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_118","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_118","text":"Thank you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_119","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_119","text":"A few days later, I heard that Miranda sent the videos to Mr. 0","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_120","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_120","text":"and managed to remain in the A.C.P.U.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_121","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_121","text":"Not long after, Miranda comes to my room again","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_122","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_122","text":"to consult me with a new issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_123","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_123","text":"Commander! Um... Everyone's been acting so strange lately!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"