{"id":"d_nikke_miranda_05","cat":"bond","group":{"id":"char5017","label":"Miranda"},"label":"Police Officer Miranda","stage":null,"prev":"d_nikke_miranda_04","next":null,"speakers":{"poli":"Poli","miranda":"Miranda"},"icons":{"poli":"si_c030_00_s","miranda":"si_c032_00_s"},"lines":[{"id":"d_nikke_miranda_05_1","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_1","text":"Oh my gosh! What on earth is going on?","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["miranda","poli"],"affinity":null},{"id":"d_nikke_miranda_05_2","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_2","text":"The bomb hasn't even gone off yet, and you got all scared and ran away!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_3","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_3","text":"And you even squashed the Commander so much that you practically dislocated his shoulder!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_4","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_5","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_6","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_6","text":"But if you were going to be that scared, then why on earth did you touch the bomb, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_7","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_7","text":"Uh... well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_8","text":"I said I'd take care of the bomb.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_9","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_9","text":"Stay right there, both of you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_10","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_10","text":"I told you to run! So why are you defusing the bomb instead of running away?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_11","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_11","text":"What if you cut the wrong wire!?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_12","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_12","text":"Are you both trying to get yourselves killed or what!?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_13","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_13","text":"P-Poli, calm do—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_14","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_14","text":"Calm down, my foot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_15","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_15","text":"If you thought you could survive the bomb with your Nikke abilities,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_16","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_16","text":"you should've used them to escape as fast as possible!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_17","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_17","text":"You don't ever listen to anyone! And how dare you just hang up on me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_18","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_18","text":"Grrrrr!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_19","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_19","text":"S-sorry! It was my fault!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_20","text":"Sorry, my bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_21","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_21","text":"Geez!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_22","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_22","text":"Still... lucky you're alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_23","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_23","text":"It was a 50-50 chance, and you guessed it right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_24","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_24","text":"... Just lucky, I guess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_25","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_25","text":"It's all thanks to the Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_26","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_27","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_27","text":"Miranda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_28","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_28","text":"Yeah?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_29","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_29","text":"The Commander did his part, of course,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_impression","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_30","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_30","text":"but I really think it was your courage and effort that saved the citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_31","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_31","text":"As a fellow police officer, I just want to say thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_32","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_32","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_33","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_33","text":"No! I-I'm the one who should be thanking you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_34","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_34","text":"I tried to show how hard I was working by filming videos, but I just ended up causing a mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_35","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_35","text":"And you had to clean up after me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_36","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_36","text":"You even told me that we're a squad, not just part of A.C.P.U...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_37","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_37","text":"But I've been lying to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_38","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_38","text":"M-me? You've been lying to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_39","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_39","text":"No way! There's no way you could be lying to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_40","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_05_40","text":"Calm down, Poli.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_41","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_41","text":"Yes, Poli, you were being deceived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_42","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_42","text":"The truth is... I'm not really an A.C.P.U. officer. I'm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_43","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_43","text":"An inspector under the Central Government Supervision Department?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_44","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_44","text":"H-how did you...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_45","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_45","text":"Oh, is that all? Honestly, I bet everyone knows about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_46","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_46","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_47","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_47","text":"Well... if you look at it that way, we were both kinda keeping things from each other. So! Let's call it even, kay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_48","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_48","text":"You're not angry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_49","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_49","text":"Why would I be angry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_50","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_05_50","text":"I mean... I was lying to you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_51","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_51","text":"Miranda! We in the A.C.P.U. are all police, y'know!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_52","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_52","text":"We're experts at telling truth from lies!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_53","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_53","text":"I can even spot someone undercover just by their gestures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_05_54","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_miranda_05_54","text":"Figuring out if someone's serious about their work? That's as easy as a piece of Splendamin!","jump":null,"exit":false,"enter":null,"bg":null,