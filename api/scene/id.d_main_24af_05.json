ll,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_8","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_8","text":"Don't tell me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_9","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_9","text":"Neon, do you remember Indivilia?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_10","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_10","text":"Sure, I remember.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_11","text":"What happened to her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_12","text":"... Master, are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_13","text":"I can't remember anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_14","text":"Rapi went into overdrive and, with Dorothy's help, drove her away from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_15","text":"That's why we have to go find Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_16","text":"And what were you doing at that time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_17","text":"I was fighting Nihilister and Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_18","text":"Come to think of it, whatever happened to those two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_19","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_20","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_20","text":"I must have driven them away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_21","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_21","text":"Am I the bane of the Heretics' existence?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_23","text":"Are you sure you're okay, Master?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_24","text":"Yes, I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_25","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_main_24af_05_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_26","text":"Hey, Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_27","text":"Can we talk for a bit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_28","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_29","text":"No, I want to speak to him alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24af_05_30","text":"Huh? You're not going out to eat or something without me, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_31","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_32","text":"It's about Neon.","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_33","text":"When she died, I think the NIMPH fabricated her memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_34","text":"That's why she doesn't remember her body being bisected. According to her memory, she was fighting the entire way through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_35","text":"Just act as if you don't know anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_36","text":"It's like... protecting her from her trauma?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_37","text":"That's what I believe, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_38","text":"There have been cases where Nikkes have experienced multiple deaths, and it becomes dangerous for them to carry those memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_39","text":"This is considered one of NIMPH's functions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_40","text":"What about you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_41","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_43","text":"I remember everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_44","text":"I'm not sure how, but somehow I remained in battle mode even after I was sliced in half.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_45","text":"So... I remember all of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_46","text":"What Rapi did and what happened to her afterwards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_47","text":"It's unsettling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_48","text":"Part of my body was lying somewhere else, but I was still able to see and hear everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_49","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_49","text":"And I was powerless to do anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_50","text":"Shortly after that, I lost consciousness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_51","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_51","text":"When I came to, I'm back to normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_52","text":"It's a traumatic memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_53","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_53","text":"Like waking up from a terrible nightmare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_54","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_54","text":"But I know that it wasn't a dream, which only makes it more unsettling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_55","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_55","text":"... Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_56","text":"Don't worry about me, Commander. I've already died several times before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_57","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_57","text":"I wouldn't go so far as to say that I'm used to it, but I've gotten to the point where I can endure it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_58","text":"So hurry up. We have to find Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_59","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24af_05_59","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_05_60","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_24af_05_60","text":"Anis walks away quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}