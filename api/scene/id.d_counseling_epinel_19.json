{"id":"d_counseling_epinel_19","cat":"counsel","group":{"id":"char5038","label":"Epinel"},"label":"Advising Epinel: 19","stage":null,"prev":"d_counseling_epinel_18","next":"d_counseling_epinel_20","speakers":{"epinel":"Epinel"},"icons":{"epinel":"si_c241_00_s"},"lines":[{"id":"d_counseling_epinel_19_1","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_1","text":"I can be pouring sweat, but as soon as I'm on my skateboard, all the wind dries the sweat off.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["epinel"],"affinity":"_0"},{"id":"d_counseling_epinel_19_2","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_2","text":"You think I should tell Folkwang to give skateboarding a try?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_epinel_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_epinel_19_3","text":"I think it's a great idea.","jump":"d_counseling_epinel_19_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_epinel_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_epinel_19_4","text":"I don't think that's a good idea.","jump":"d_counseling_epinel_19_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_epinel_19_5","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_5","text":"Perfect. I'll have her swing by during one of my practice sessions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_epinel_19_6","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_6","text":"She'll probably end up sweating up a storm and quitting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_epinel_19_7","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_7","text":"But you never know.","jump":"d_counseling_epinel_19_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_epinel_19_8","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_8","text":"Yeah, it would take a while to teach her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_epinel_19_9","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_9","text":"Not only that, she'd have to be motivated to do it as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_epinel_19_10","type":"Speech","speaker":"epinel","key":"Locale_Counseling:d_counseling_epinel_19_10","text":"Oh well, it was a nice thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_epinel_19_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_epinel_19_11","text":"Epinel and I discuss whether or not skateboarding will help Folkwang with her excessive perspiration.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}