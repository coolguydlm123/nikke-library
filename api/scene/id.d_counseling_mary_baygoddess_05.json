{"id":"d_counseling_mary_baygoddess_05","cat":"counsel","group":{"id":"char5064","label":"Mary: Bay Goddess"},"label":"Advising Mary: Bay Goddess: 05","stage":null,"prev":"d_counseling_mary_baygoddess_04","next":"d_counseling_mary_baygoddess_06","speakers":{"mary_s":"Mary"},"icons":{"mary_s":"si_c132_00_s"},"lines":[{"id":"d_counseling_mary_baygoddess_05_1","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_05_1","text":"I don't know if it's because it's cooler in the clinic,","jump":null,"exit":false,"enter":null,"bg":"Beach_d","bgArt":"beach_d","image":null,"bgm":"bgm_story_summermood","movie":null,"shown":["mary_s"],"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_05_2","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_05_2","text":"but we've had an influx of patients lately. It's rather disconcerting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_05_3","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_05_3","text":"What should I do to drive away those who aren't actually sick?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_05_4","text":"Rely on your trusty old needles.","jump":"d_counseling_mary_baygoddess_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_baygoddess_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_05_5","text":"Why not take the chance to give them a checkup?","jump":"d_counseling_mary_baygoddess_05_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm"