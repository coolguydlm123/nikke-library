,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_05_12","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_05_12","text":"Thanks for the suggestion, Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_05_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_05_13","text":"I talk with Mary about how to deal with malingerers.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}