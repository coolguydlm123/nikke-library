ity":null},{"id":"d_main_26_3_s_28","type":"Speech","speaker":"crown","key":"Locale_MainScenario:d_main_26_3_s_28","text":"I granted her request, as any worthy king would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_3_s_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_26_3_s_29","text":"What would make her want to join your kingdom?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_3_s_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_26_3_s_30","text":"I can see why. You wake up in an unfamiliar place, totally unaware of how things work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_3_s_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_26_3_s_31","text":"Suddenly, someone offers help in exchange for you becoming one of their subjects. Wouldn't you do the same?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_3_s_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_26_3_s_32","text":"I suppose I would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_3_s_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_26_3_s_33","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_3_s_34","type":"Speech","speaker":"chime","key":"Locale_MainScenario:d_main_26_3_s_34","text":"At any rate, we are more than happy to take you all on as citizens as well.","jump":null,"exit":false,"enter":null,"bg":null,