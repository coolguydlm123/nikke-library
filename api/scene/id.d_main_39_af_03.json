ffinity":null},{"id":"d_main_39_af_03_7","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_7","text":"and Eternity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_8","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_8","text":"They're Nikkes Enikk personally sent to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_03_9","text":"Wait, Enikk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_10","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_10","text":"Yeah. Enikk determined that the Outer Rim was responsible for the attack on the Ark, so she sent these two to keep tabs on us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_03_11","text":"Can I greet them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_12","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_12","text":"I wouldn't recommend it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_13","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_13","text":"They attack if you get too close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_14","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_14","text":"They've already killed five people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_03_15","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_16","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_16","text":"They just showed up one day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_17","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_17","text":"The only info we got was that two Nikkes would be permanently stationed in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_18","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_18","text":"They came out of nowhere and just planted themselves right there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_19","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_19","text":"They don't even talk. Unless they're working, they just stand there like that all the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_20","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_03_20","text":"Work, as in...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_21","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_21","text":"If you equip a weapon, or start to plot an attack of some sort,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_22","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_22","text":"they suddenly show up and start busting heads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_03_23","text":"You're saying a Nikke's the one doing the attacking?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_24","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_24","text":"Yeah, and they don't discriminate. They attack humans and Nikkes alike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_25","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_25","text":"We don't even know what weapons they use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_26","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_26","text":"A flash goes off, and the target's literally reduced to dust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_27","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_27","text":"We're pretty sure it's some kind of ultra-high-heat device... but honestly, we have no clue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_03_28","text":"Uh... so that means we're in danger too, right? I mean, we're armed and all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_29","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_30","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_03_30","text":"They only take action when someone actually shows hostility toward the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_31","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_03_31","text":"Whoa... do they have psychic powers or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_32","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_32","text":"They eavesdrop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_33","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_03_33","text":"On everyone in the Outer Rim. ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_03_34","type":"Speech","speaker":"neon","key":"Locale_MainScena