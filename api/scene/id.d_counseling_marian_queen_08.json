{"id":"d_counseling_marian_queen_08","cat":"counsel","group":{"id":"char5185","label":"Marian: Queen"},"label":"Marian: Queen's Memories: 08","stage":null,"prev":"d_counseling_marian_queen_07","next":"d_counseling_marian_queen_09","speakers":{"marian":"Marian"},"icons":{"marian":"si_c013_00_s"},"lines":[{"id":"d_counseling_marian_queen_08_1","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_marian_queen_08_1","text":"Marian closes her eyes and recalls a hazy memory.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"event_bgm_maria-n_coldrain","movie":null,"shown":["marian_queen"],"affinity":"_0"},{"id":"d_counseling_marian_queen_08_2","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_2","text":"Okay, I know this would never happen, but if... and I really mean if!","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":null,"movie":null,"shown":["marian"],"affinity":"_0"},{"id":"d_counseling_marian_queen_08_3","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_3","text":"If I lost all my memories and met you again, what would you say to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marian_queen_08_4","text":"... I don't even want to imagine it.","jump":"d_counseling_marian_queen_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_marian_queen_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marian_queen_08_5","text":"Hi, Marian.","jump":"d_counseling_marian_queen_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_marian_queen_08_6","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_6","text":"Oh, sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_08_7","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_7","text":"I know it'll never happen. I just thought it might be fun to imagine.","jump":"d_counseling_marian_queen_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_08_8","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_8","text":"Hehe, that reaction was so like you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_08_9","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_9","text":"You mean you'd treat me like we were completely starting over?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_08_10","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_10","text":"I know it won't happen, but that makes me sad just thinking about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_08_11","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_08_11","text":"I don't think I'll ever imagine something like that again.","jump":"d_counseling_marian_queen_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counsel