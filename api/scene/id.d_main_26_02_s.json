":null},{"id":"d_main_26_2_s_13","type":"Speech","speaker":"crown","key":"Locale_MainScenario:d_main_26_2_s_13","text":"Break it down for me. What exactly is going on here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_2_s_14","type":"Speech","speaker":"chime","key":"Locale_MainScenario:d_main_26_2_s_14","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_2_s_15","type":"Speech","speaker":"chime","key":"Locale_MainScenario:d_main_26_2_s_15","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_2_s_16","type":"Speech","speaker":"chime","key":"Locale_MainScenario:d_main_26_2_s_16","text":"Don't you worry about it. I'll take care of everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_2_s_17","type":"Speech","speaker":"crown","key":"Locale_MainScenario:d_main_26_2_s_17","text":"... Very good. All I have to do is make the final decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_2_s_18","type":"Speech","speaker":"chime","key":"Locale_MainScenario:d_main_26_2_s_18","text":"Precisely. Someone of your bearing shouldn't have to concern themselves with unnecessary details.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_2_s_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_26_2_s_19","text":"You two haven't any clue what the Commander just said, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie