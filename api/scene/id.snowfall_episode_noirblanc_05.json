aker":"lumi_03","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_87","text":"How come we always come to the hot spring on our day off?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_83","type":"Speech","speaker":"secondoldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_88","text":"Because it's not fair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_84","type":"Speech","speaker":"secondoldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_89","text":"We eat and sleep here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_85","type":"Speech","speaker":"secondoldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_90","text":"but we never get to enjoy the hot spring ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_86","type":"Speech","speaker":"oldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_91","text":"Well, sure, that's part of the reason,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_87","type":"Speech","speaker":"oldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_92","text":"Isn't it nice for the three of us to enjoy the hot spring together?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_88","type":"Speech","speaker":"oldestsister","key":"Locale_SubScenario:sno