null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_70","type":"Speech","speaker":"secondoldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_75","text":"You shouldn't say that kind of stuff to someone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_71","type":"Speech","speaker":"oldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_76","text":"Yeah, don't be like that, Lumi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_72","type":"Speech","speaker":"oldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_77","text":"Having said that... she does have a point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_73","type":"Speech","speaker":"secondoldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_78","text":"What? Don't tell me you agree with her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_74","type":"Speech","speaker":"secondoldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_79","text":"How come you two are being so mean to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_noirblanc_05_75","type":"Speech","speaker":"secondoldestsister","key":"Locale_SubScenario:snowfall_episode_noirblanc_05_80","text":"Okay, fine. Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_epi