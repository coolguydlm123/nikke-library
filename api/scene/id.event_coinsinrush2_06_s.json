_13","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_06_s_13","text":"Cut the crap and bring it on!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_s_14","type":"Speech","speaker":"velvet","key":"Locale_MainScenario:event_coinsinrush2_06_s_14","text":"Oh, I was actually just about to do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_s_15","type":"Speech","speaker":"velvet","key":"Locale_MainScenario:event_coinsinrush2_06_s_15","text":"You know how it is, right? Like in spy movies...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_s_16","type":"Speech","speaker":"velvet","key":"Locale_MainScenario:event_coinsinrush2_06_s_16","text":"The finales always end with a big action scene between the hero and the villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_s_17","type":"Speech","speaker":"velvet","key":"Locale_MainScenario:event_coinsinrush2_06_s_17","text":"Though, honestly, right now it feels more like the heroes are ganging up on me. That's kinda cheap, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_s_18","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush2_06_s_18","text":"Is that all you have to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush2_06_s_19","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsin