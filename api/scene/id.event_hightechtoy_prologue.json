{"id":"event_hightechtoy_prologue","cat":"event","group":{"id":"ev40002","label":"Hightech Toy"},"label":"The Heroes' Lowest Performance","stage":null,"prev":null,"next":"event_hightechtoy_01_s","speakers":{"tvvoice":"TV","maxwell_w":"Maxwell","unknown":"???","missilysnikke":"Missilis Nikke","laplace":"Laplace","drake":"Drake","syuen":"Syuen"},"icons":{"tvvoice":"si_c999_00_s","maxwell_w":"si_c102_01_s","unknown":"si_c999_00_s","missilysnikke":"si_c302_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s","syuen":"si_c901_00_s"},"lines":[{"id":"event_hightechtoy_prologue_1","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_prologue_1","text":"Controversy has been brewing recently due to a rash of mass-produced Nikke disappearances up on the surface.","jump":null,"exit":false,"enter":null,"bg":"SimulationRoom","bgArt":"simulationroom","image":null,"bgm":"bgm_story_kneeldownfools","movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_2","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_prologue_2","text":"Considering how costly these Nikkes are to manufacture, it can be expected that these disappearances will put a serious dent in the Big Three's profit margins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_3","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_prologue_3","text":"This is especially applicable for Missilis, who manufactured a high proportion of the mass-produced Nikkes who have gone AWOL.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_4","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_prologue_4","text":"Experts speculate that Missilis may receive the lowest evaluation in the company's history this quarter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_5","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_prologue_5","text":"Ouch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["maxwell_w","drake","laplace"],"affinity":null},{"id":"event_hightechtoy_prologue_6","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_prologue_6","text":"Ingrid, the CEO of Elysion, had some choice words for Missilis,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_7","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_hightechtoy_prologue_7","text":"saying, \"This is what they get for forgoing any proper battle training.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_8","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_prologue_8","text":"Wow, even Ingrid is chiming in on this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_9","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_prologue_9","text":"Syuen must be about to bust a gasket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_prologue_10","type":"Speech","speaker":"unknown","key":"Locale_SubScenario:event_hightechtoy_prologue_10","text":"Don't act smart!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"sho