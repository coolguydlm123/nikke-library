o you remember what the doctor said before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_53","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_53","text":"...!","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":["mary"],"affinity":null},{"id":"event_arcanearchive_05_s_54","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_05_s_54","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_55","type":"Speech","speaker":"mary","key":"Locale_SubScenario:event_arcanearchive_05_s_55","text":"We call this a Mind Switch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_56","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_56","text":"There you go, making that face again.","jump":null,"exit":false,"enter":null,"bg":"Library","bgArt":"library","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_57","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_57","text":"I shouldn't have said anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_58","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_58","text":"I know I keep asking you this, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_59","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_59","text":"Are you sure you're okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_60","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_61","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_61","text":"Okay, fine. This time, I won't change the subject and ramble about the commute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_62","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_63","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_63","text":"Of course I'm not okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_sceneofmemory","movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_64","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_65","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_65","text":"It's my memories that make me who I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_66","type":"Speech","speake