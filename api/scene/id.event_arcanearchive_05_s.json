{"id":"event_arcanearchive_05_s","cat":"event","group":{"id":"ev40077","label":"ARCANE ARCHIVE"},"label":"That Which Must Be Done: A","stage":null,"prev":"event_arcanearchive_04_e","next":"event_arcanearchive_05_e","speakers":{"arcana":"Arcana","mary":"Mary"},"icons":{"arcana":"si_c581_00_s","mary":"si_c130_00_s"},"lines":[{"id":"event_arcanearchive_05_s_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_1","text":"Arcana and I make our way down the hallway connected to the reading room.","jump":null,"exit":false,"enter":null,"bg":"Library","bgArt":"library","image":null,"bgm":"bgm_story_discussion","movie":null,"shown":["arcana"],"affinity":null},{"id":"event_arcanearchive_05_s_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_2","text":"Rows of old bookshelves stretch on seemingly infinitely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_3","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_3","text":"There's so much here...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_4","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_4","text":"There certainly is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_5","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_5","text":"Even so, the library is going to undergo another expansion soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_6","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_6","text":"And this time, it's not to enlarge the area accessible to the public, but rather to make the Forbidden Library bigger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_7","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_7","text":"It makes you wonder why there's so much to hide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_8","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_8","text":"You say that, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_9","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_9","text":"From looking at the labels on the bookshelves,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_10","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_10","text":"the contents contained here seem to be harmless records of human history rather than sensitive classified information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_11","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_11","text":"World History, Pop Music, Film...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_12","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_12","text":"Is this the kind of information that really has to be kept secret?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_13","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_13","text":"Below one of the labels which is marked \"Theater\",","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_14","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_14","text":"there is a piece of paper affixed to the bookshelf which reads, \"Not for me!\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_15","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_15","text":"Secrets must be protected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_16","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_16","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_17","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_17","text":"It's kind of like our squad's motto.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_18","text":"Doesn't it kind of go without saying that secrets should be protected?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_19","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_19","text":"Yes, but the emphasis is on just how necessary it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_20","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_21","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_21","text":"These books are valuable pieces of human history.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_22","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_22","text":"When you have something of such immense value, what do you think is the best way to protect it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_23","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_23","text":"... Let no one know of its existence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_24","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_24","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_25","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_25","text":"No one will steal them or desecrate them if they don't know they exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_26","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_26","text":"Kind of ironic when you think about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_27","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_27","text":"Very much so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_28","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_28","text":"Although... our founder saw things a bit differently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_29","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_29","text":"Founder?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_30","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_30","text":"The man who both created the Best Seller Squad and entrusted us with overseeing the library.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_31","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_31","text":"I heard he retired from his previous line of work and went on to become the library director.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_32","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_32","text":"What about now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_33","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_33","text":"Now... I guess you could say the position is vacant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_34","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_34","text":"At the moment, our squad oversees everything here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_35","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_35","text":"The founder stepped away a long time ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_36","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_36","text":"What kind of person was he?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_37","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_37","text":"I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_38","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_39","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_39","text":"You don't have to look at me like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_40","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_40","text":"The reason I don't know is because I never met him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_41","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_41","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_42","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_42","text":"Of course not. He was around during the time of Operation Ark Guardian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_43","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_s_43","text":"I've been in this squad for a while, but not that long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_44","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_s_44","text":"Sorry, I thought you'd been here from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_s_45","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:e