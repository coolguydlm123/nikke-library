{"id":"d_main_22_05_s","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"Underworld Queen: A","stage":"22-15 STAGE · Start","prev":"d_main_22_04_e","next":"d_main_22_05_e","speakers":{"poli":"Poli","neon":"Neon","anis":"Anis","enikk_op_l":"Enikk","moran":"Moran","rosanna":"Rosanna","sakura":"Sakura","blanc":"Blanc","noir":"Noir"},"icons":{"poli":"si_c030_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","enikk_op_l":"si_c904_00_s","moran":"si_c281_00_s","rosanna":"si_c280_00_s","sakura":"si_c282_00_s","blanc":"si_c270_00_s","noir":"si_c271_00_s"},"lines":[{"id":"d_main_22_05_s_1","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_1","text":"Underworld Queen started a feud with the 777 squad.","jump":null,"exit":false,"enter":null,"bg":"BurningCity","bgArt":"burningcity","image":null,"bgm":"bgm_collapse","movie":null,"shown":["poli","neon","anis","enikk_op_l"],"affinity":null},{"id":"d_main_22_05_s_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_05_s_2","text":"What do you think happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_3","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_3","text":"Coin Rush, the casino owned by the 777 squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_4","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_4","text":"is one of the biggest money-makers in the entire Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_5","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_5","text":"But it's not just a casino. It's more like an adult theme park packed with different kinds of recreational games. In other words, it's everything Mustang has ever dreamed of, given true form.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_6","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_6","text":"A veritable mecca of the entertainment world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_7","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_7","text":"As for Underworld Queen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_8","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_8","text":"they're the squad in charge of the Ark's entire criminal underbelly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_05_s_9","text":"In the world of organized crime, no one is higher on the totem pole than them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_10","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_10","text":"Despite their illicit activities, they always manage to evade persecution, making them a group of special interest to the A.C.P.U.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_11","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_11","text":"Having said all that, this is rather unexpected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_12","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_12","text":"Neither Rosanna nor Sakura are running gangs that are strapped for cash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_13","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_05_s_13","text":"Why do you think they started having beef with 777?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_05_s_14","text":"More importantly, what does all this have to do with the Rapture invasion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_15","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_05_s_15","text":"Keep watching.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_s_16","text":"1 day before. Coin Rush.","jump":null,"exit":false,"enter":null,"bg":"CoinRushIndoor","bgArt":"coinrushindoor","image":null,"bgm":"bgm_story_conflict","movie":null,"shown":["moran"],"affinity":null},{"id":"d_main_22_05_s_17","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_17","text":"Rosanna! Sakura!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rosanna","sakura","blanc","noir"],"affinity":null},{"id":"d_main_22_05_s_18","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_18","text":"You don't have to shout...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_19","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_19","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_20","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_20","text":"What's all this I hear about you two extorting this place for protection money?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_21","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_21","text":"What are these shenanigans? Some kind of petty after-school special? You oughta be ashamed calling yourself part of Underworld Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_22","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_22","text":"Hey, watch it. Don't talk to me like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_23","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_23","text":"I suggest you shut your mouth before I shut it for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_24","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_24","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_25","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_25","text":"Hasn't your precious Peony Association been accepting protection money as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_26","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_26","text":"Sure, but we get it in store goods. We protect them, and we receive some food in exchange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_27","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_27","text":"So you get a little cut of their produce, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_28","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_28","text":"Yes, and not so much that it would affect their profit margins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_29","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_29","text":"This place mostly uses cash. That's why I didn't think it'd be a big deal to receive our payment in cash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_30","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_30","text":"There's a world of difference!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_31","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_31","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_32","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_32","text":"Getting cash payouts is something only thugs do, not decent people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_33","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_33","text":"It never ceases to amaze me how painful it is speaking with you, Moran.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_34","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_34","text":"Well, at any rate, just stop what you're doing. Mustang didn't entrust this task to us just so we could bungle it up in spectacular fashion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_35","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_35","text":"If you want to be a noble templar, start acting like one!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_36","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_36","text":"Moran.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":["underqueen"],"affinity":null},{"id":"d_main_22_05_s_37","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_37","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_38","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_38","text":"Don't drag Mustang into this. And don't bring up crap like templars.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_39","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_39","text":"You and I eat at the same table. Who are you to bring up templars with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_40","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_40","text":"Instead of bickering, let's help each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_41","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_41","text":"That's pretty rich, coming from the one who sicced their cronies on this place to extort them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_42","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_42","text":"Then again, for Hedonia's warped sense of right and wrong, maybe that did make sense to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_43","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_43","text":"Sounds like a real group of lowlives if you ask me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_44","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_44","text":"What did I tell you about watching how you speak to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_45","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_45","text":"Tell me, Rosanna,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_46","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_46","text":"when did you become a two-bit thug?","jump":null,"exit":false,"enter":null,"bg":"CoinRushIndoor","bgArt":"coinrushindoor","image":null,"bgm":null,"movie":null,"shown":["rosanna","sakura","blanc","noir","moran"],"affinity":null},{"id":"d_main_22_05_s_47","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_47","text":"You dumb bi...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_48","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_48","text":"Stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_49","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_49","text":"You're both embarrassing yourselves. There are too many eyes here anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_50","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_50","text":"You shut up. Don't give me orders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_51","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_51","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_52","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_52","text":"Blanc. Noir. Don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_53","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_53","text":"The Peony Association will protect you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_54","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_05_s_54","text":"Now all three gangs are involved? How pathetic do you all think we are...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_55","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_55","text":"We'll do it for free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_56","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_05_s_56","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_57","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_05_s_57","text":"R-really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_58","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_58","text":"Sure. If we're helping someone in need, our services come free of charge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_59","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_59","text":"Such is the way of the templar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_60","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_60","text":"... This is driving me crazy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_61","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_61","text":"Why don't you tell her that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_62","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_62","text":"I would, but I doubt any of it would get through that thick skull of hers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_63","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_63","text":"What!? Are you talking to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_64","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_64","text":"I'll be the first to say I'm not the sharpest knife in the drawer, but at least I'm not a bum!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_65","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_65","text":"That's enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_66","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_66","text":"Follow me. We need to talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_67","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_67","text":"Huh? Why don't you say it here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_68","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_68","text":"Just follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_69","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_69","text":"Don't make me say it again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_70","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_s_70","text":"Come on. Let's find somewhere quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_71","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_71","text":"What is it with you two? Something's going on, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_72","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_s_72","text":"You're not trying to exclude me, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_73","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_s_73","text":"Would you just shut up and follow me?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_74","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_s_74","text":"*Crash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_s_75","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_s_75","text":"There's a cacophonous blast, and smoke fills the casino.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}