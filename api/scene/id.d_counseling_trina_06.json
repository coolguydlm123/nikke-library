{"id":"d_counseling_trina_06","cat":"counsel","group":{"id":"char5134","label":"Trina"},"label":"Advising Trina: 06","stage":null,"prev":"d_counseling_trina_05","next":"d_counseling_trina_07","speakers":{"trina":"Trina"},"icons":{"trina":"si_c412_00_s"},"lines":[{"id":"d_counseling_trina_06_1","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_06_1","text":"Sun, what's the first thing you'd like to do if you reclaim the surface?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["trina"],"affinity":"_0"},{"id":"d_counseling_trina_06_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_06_2","text":"I want to feel the vastness of nature, which is something we can't do in the Ark.","jump":"d_counseling_trina_06_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_trina_06_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_06_3","text":"I'd plant an apple tree.","jump":"d_counseling_trina_06_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_trina_06_4","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_06_4","text":"I'd do the same!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_06_5","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_06_5","text":"What would it be like to immerse oneself in untouched natural surroundings, free from human interference for so long?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_06_6","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_06_6","text":"When that day comes, please take me with you.","jump":"d_counseling_trina_06_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_06_7","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_06_7","text":"That's a lovely gesture,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_06_8","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_06_8","text":"but won't there already be plenty of trees up on the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_06_9","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_06_9","text":"I would want to talk to those trees first.","jump":"d_counseling_trina_06_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_06_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_trina_06_10","text":"Trina and I discuss what we'd like to do up on the surface.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}