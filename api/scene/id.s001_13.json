rown","key":"Locale_SideStory:s001_13_29","text":"It must be the adolescence kicking in. During adolescence, people tend to change every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_30","type":"Narration","speaker":null,"key":"Locale_SideStory:s001_13_30","text":"Chime glances around and then whispers softly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_31","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_31","text":"You mean to say that she is growing, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_32","type":"Speech","speaker":"crown","key":"Locale_SideStory:s001_13_32","text":"Um... Yes, that's exactly what I meant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_33","type":"Speech","speaker":"crown","key":"Locale_SideStory:s001_13_33","text":"She is growing up well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_34","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_34","text":"I don't think this can explain...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_35","type":"Speech","speaker":"crown","key":"Locale_SideStory:s001_13_35","text":"Argh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_36","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_36","text":"Are you okay, Your Highness?","jump":null,"exit":false,"enter":null,"bg":null,"