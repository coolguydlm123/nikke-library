{"id":"s001_13","cat":"side","group":{"id":"side1","label":"SECOND AFFECTION"},"label":"Second Affection: 13","stage":null,"prev":"s001_12","next":"s001_14","speakers":{"chime":"Chime","marian_p":"Marian","crown":"Crown"},"icons":{"chime":"si_c331_00_s","marian_p":"si_c260_00_s","crown":"si_c330_00_s"},"lines":[{"id":"s001_13_1","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_1","text":"Eeeeeeeek!","jump":null,"exit":false,"enter":null,"bg":"CrownCastleDiningRoom_d","bgArt":"crowncastlediningroom_d","image":null,"bgm":"bgm_story_boing","movie":null,"shown":["marian_p","chime","crown"],"affinity":null},{"id":"s001_13_2","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_2","text":"Marian!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_3","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_3","text":"How many times must I tell you not to put those disgusting maggots on the table?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_4","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_13_4","text":"Maggots are super nutritious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_5","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_13_5","text":"They're way healthier than any processed or canned food, that's for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_6","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_6","text":"What does that matter, you dolt? We're Nikkes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_7","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_7","text":"Why don't you quit hitting the bottle before talking about nutrition?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_8","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_13_8","text":"Alcohol is the perfect cure for an ailing mind...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_9","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_9","text":"That sounds just like something a drunk would say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_10","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_10","text":"Your Highness, must I endure such unwarranted criticism?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_11","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_13_11","text":"This woman has made my meal times a living hell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_12","type":"Speech","speaker":"crown","key":"Locale_SideStory:s001_13_12","text":"Marian put a lot of thought into this meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_13","type":"Speech","speaker":"crown","key":"Locale_SideStory:s001_13_13","text":"Be thankful and eat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_13_14","type":"Speech","speaker":"chime","key":"Locale_SideStory:s001_1