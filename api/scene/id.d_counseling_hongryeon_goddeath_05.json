{"id":"d_counseling_hongryeon_goddeath_05","cat":"counsel","group":{"id":"char5186","label":"Scarlet: Goddeath"},"label":"Advising Scarlet: Goddeath: 05","stage":null,"prev":"d_counseling_hongryeon_goddeath_04","next":"d_counseling_hongryeon_goddeath_06","speakers":{"hongryeon_g":"Scarlet"},"icons":{"hongryeon_g":"si_c472_00_s"},"lines":[{"id":"d_counseling_hongryeon_goddeath_05_1","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_1","text":"A day such as this doth call for a drink.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon_g"],"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_2","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_2","text":"On what sort of day dost thou find thyself longing for one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_3","text":"When I'm feeling down.","jump":"d_counseling_hongryeon_goddeath_05_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_goddeath_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_4","text":"When I'm in a good mood.","jump":"d_counseling_hongryeon_goddeath_05_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_goddeath_05_5","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_5","text":"Aye, that may be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_6","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_6","text":"But if thou drink only when sorrow weighs upon thee,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_7","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_7","text":"the drink shall swallow thy grief, only to leave thee sunk deeper in sorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_8","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_8","text":"Wherefore not raise a cup when fortune smiles upon thee, and celebrate the day?","jump":"d_counseling_hongryeon_goddeath_05_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_9","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_9","text":"Aye, thou hast the right of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_10","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_10","text":"In days past, I drank whether my spirits were high or low,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_11","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_11","text":"but now I endeavor to drink only on happy days, that I might make them happier still.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_12","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_12","text":"I'm feeling merry today. Wilt thou join me for a drink?","jump":"d_counseling_hongryeon_goddeath_05_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_05_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_05_13","text":"Scarlet and I spend some time together over a few drinks.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}