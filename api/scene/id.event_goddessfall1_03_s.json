"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_19","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_20","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_20","text":"Are you saying... there's a new menu...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_21","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_21","text":"Marian has vanished to whither unknown!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_22","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_23","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_23","text":"W-Whither Unknown sounds like a great place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_24","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_24","text":"Your Highness! Whither unknown is a place I know not of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_25","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_25","text":"You've even memorized the name of every place. You truly are impressive, Chime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_26","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_26","text":"Uh...  Maybe she's gone for another long walk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_27","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_27","text":"She's been doing that rather often lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_28","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_28","text":"She usually apprises us of her jaunts, but not a word was uttered this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_29","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_29","text":"She has been absent since the morn and remains unseen to this hour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_30","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_30","text":"T.A.L.O.S...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_31","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_31","text":"Roger. I'll go outside the walls and scan the area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_32","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_32","text":"Let's go, Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_33","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_33","text":"Okay, let's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_34","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_34","text":"Wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_35","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_35","text":"Chime... have you noticed anything strange about Marian recently?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_36","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_36","text":"By strange... doth thou mean...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_37","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_38","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_38","text":"Not moons hence, did a great light shoot down from a most distant place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_39","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_39","text":"The look in Marian's eyes when she gazed upon it was most unusual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_40","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_40","text":"Then she spoke of strange matters. About going hither or taking yonder. Words whose meaning I knew not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_41","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_41","text":"Uh...  And that she didst love me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_42","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_42","text":"Now that you mention it, she told T.A.L.O.S. and me that she loved us yesterday.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_43","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_43","text":"That was the first time I've heard such direct expressions of affection. It was nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_44","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_44","text":"You liked it, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_45","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_45","text":"I love you, Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_46","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_47","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_47","text":"Chime, do you remember which direction it was?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_48","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_48","text":"Yes. Marian said um...  ummm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_49","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_49","text":"I-is there not a place known as Busty Mountain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_50","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_50","text":"The light came forth from between those peaks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_51","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_52","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_52","text":"I should probably head over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_53","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_53","text":"But Your Highness...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_54","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_54","text":"'Tis Eden that lieth in that direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_55","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_55","text":"Even better. I'll stop by and say hello while I'm there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_56","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_56","text":"I'll be back. Take good care of Crown Kingdom while I'm away, Chime, Kilo and T.A.L.O.S.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_57","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_57","text":"Thou planning to go by thy lonesome?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_58","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_58","text":"Yes. Riding astride Trombe by myself would be fastest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_59","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_60","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_61","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_61","text":"Chime and Kilo are worried about Marian and wish to accompany you. But they are holding back because they are concerned they will slow you down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_62","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_62","text":"I feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_63","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_63","text":"... You've all reminded me once again what fine retainers I have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_64","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_64","text":"Let us go together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_65","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_65","text":"U-understood! I shall prepare forthwith!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_66","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_66","text":"We may yet be separated, so I shall make preparations for such occasions!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_67","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_67","text":"I'll post notices on the walls!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_68","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_68","text":"Indeed! D-do not forget to write that the grubs lie in the cupboard, furthest to the left, in the deepest recesses!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_69","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_69","text":"We'll only be gone for about five days at most. Should I just write down to wait for us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_70","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_70","text":"Right, right! That shall suffice!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_71","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_71","text":"Place the food in the ice box and lay out some towels, and...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_72","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_72","text":"I'll physically reinforce the security of the superfood storage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_73","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall1_03_s_73","text":"Much appreciated!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_74","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_74","text":"I'll refill the water supply!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_75","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_75","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_76","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_76","text":"Marian...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_77","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_77","text":"Present time. On the surface, near Eden.","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_04","bgArt":"eventscene_goddessfall_04","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_78","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_78","text":"*Boom!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_purpose","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_79","text":"Chatterbox's massive body lands with a resounding thud that shakes the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_80","text":"The earth cracks, sending rocks and dust flying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_81","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_81","text":"Chatterbox crouches again, then kicks off the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_82","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_82","text":"From atop Chatterbox's shoulder, Marian blankly watches the landscape flash by.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_83","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_83","text":"I hear gunfire and explosions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_84","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_84","text":"There must be a battle going on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_85","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_85","text":"The Queen is descending. The human imposters must be trying to stop her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_86","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall1_03_s_86","text":"The sound is coming from Eden. Eden and the Queen may be fighting one another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_87","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_88","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_88","text":"Sorry to ask, but can you quicken the pace, Chatterbox?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_89","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall1_03_s_89","text":"As you command, Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_90","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_90","text":"I was surprised when you summoned us, but I didn't think you would propose attacking the original Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_91","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_91","text":"Hehe. I'm sorry, but you didn't seem like the type.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_92","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_92","text":"And what type did I seem like, exactly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_93","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_93","text":"Because the first thing you did after the Queen Gene awakened was to tell us not to attack the kingdom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_94","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_94","text":"I had you pegged as a hopeless pacifist...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_95","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_95","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_96","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_96","text":"I was a little surprised as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_97","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_97","text":"You were subjects of the original Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_98","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_98","text":"Just as I sensed her presence, you must have too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_99","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_99","text":"So why are you obeying my requests and commands?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_100","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_100","text":"Hehe, not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_101","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_101","text":"Maybe because you were so quick to fill the void?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_102","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_102","text":"When the original Queen's influence was gone, your control took effect on us instead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_103","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_103","text":"It's very interesting, and also very unpleasant, for one's heart to be so easily swayed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_104","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_104","text":"This must be the fate of a Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_105","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_105","text":"*Boom!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_106","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_03_s_106","text":"After landing, Chatterbox leaps again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_107","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_107","text":"Can I ask you something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_108","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_108","text":"Ask away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_109","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_109","text":"Why didn't you ask the human imposters in the kingdom you were residing in for help?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_110","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_110","text":"I'm sure they would have undoubtedly risked their lives for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_111","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_111","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_112","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_112","text":"I could still ask them for help after taking down the original Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_113","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_113","text":"... Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_114","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_114","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_115","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_115","text":"You want to keep it hidden from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_116","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_116","text":"The fact that you're the Raptures' Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_117","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_117","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_118","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_118","text":"Haha. You acknowledge what you are so firmly, yet at the same time, try to deny it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_119","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_119","text":"How fragile you are, my Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_120","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_120","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_121","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_121","text":"If I may give you a piece of advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_122","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_122","text":"With such weakness, it'll be impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_123","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_123","text":"You will never be able to defeat what hovers above.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_124","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_goddessfall1_03_s_124","text":"Unless you fight it as a Queen, there is no hope of victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_125","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall1_03_s_125","text":"... Thanks for the advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}