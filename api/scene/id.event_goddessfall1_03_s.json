e":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_6","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_7","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall1_03_s_7","text":"Don't tell me we're having spikes for dinner again...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_8","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_8","text":"Eek! Another s-spider course?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_9","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_9","text":"Save me, T.A.L.O.S.!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_10","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_10","text":"Loading response to avoid the spider course.\nOptions have been recently updated from 7 to 12.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_11","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_goddessfall1_03_s_11","text":"Er... wh-which number did I choose last time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_03_s_12","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall1_03_s_12","text":