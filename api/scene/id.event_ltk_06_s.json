begin with. A sorry fate, to be sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_70","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_70","text":"But if they didn't go to the Outer Rim, they would have just been scrapped, quietly swept under the rug like discarded refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_71","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_71","text":"They would have disappeared without a trace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_72","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_72","text":"I took those miserable fates and turned them into an opportunity to make money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_73","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_73","text":"Money that I can use to better other people's lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_74","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_74","text":"I buy life, and repay it with new life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_75","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_06_s_75","text":"What about the people in the Outer Rim? Do their lives not count?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_76","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_76","text":"I simply provide them with Nikkes and weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_77","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_77","text":"What they decide to do with them is out of my hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_78","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_78","text":"They have other options available to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_79","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_79","text":"They could have used the Nikkes for labor and dismantled the weapons, using the parts to improve their own livelihoods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_80","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_80","text":"But they didn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_81","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_06_s_81","text":"Why did you leave it to your employees to make the deliveries?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_82","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_82","text":"Out of kindness. It's as simple as that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_83","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_83","text":"I merely wanted to give back to those who had worked so hard for my company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_84","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_06_s_84","text":"Don't lie to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_85","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_86","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_86","text":"It was to create distance between me and the deals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_87","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_87","text":"I couldn't have people know I was involved in such a shady business. How could I continue with my philanthropy otherwise?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_88","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_06_s_88","text":"So it doesn't matter what happens to the delivery person?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_89","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_89","text":"I made sure to request not to inspect the cargo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_90","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_90","text":"Some choose not to heed my warning and end up feeling remorse. Some end up taking their own lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_91","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_91","text":"There's nothing I can do about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_92","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_06_s_92","text":"... Are you going to keep doing this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_93","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_93","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_94","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_94","text":"I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_95","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_95","text":"Think about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_96","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_96","text":"Killing me will mean you'll be cutting off support for those people with incurable diseases.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_97","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_97","text":"A lot of people will lose their jobs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_98","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_06_s_98","text":"If we let you live, those Nikkes and countless people in the Outer Rim will keep dying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_99","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_99","text":"... Mass-produced Nikkes and the people of the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_100","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_100","text":"People in the Ark, who have a future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_101","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_06_s_101","text":"Take your pick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_102","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_06_s_102","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_103","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_06_s_103","text":"That's enough questions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_104","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_06_s_104","text":"Turn around. Don't even think about trying to look back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_06_s_105","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_06_s_105","text":"It's time for us to decide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}