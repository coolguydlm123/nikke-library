{"id":"d_main_23_03_e","cat":"main","group":{"id":"ch23","label":"Chapter 23 · Prison"},"label":"Sight Behind the Wall: B","stage":"23-11 STAGE · End","prev":"d_main_23_03_s","next":"d_main_23_04","speakers":{"moran":"Moran","rapi":"Rapi","neon":"Neon","anis":"Anis","outerrimman":"Outer Rim Citizen"},"icons":{"moran":"si_c281_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","outerrimman":"si_c918_00_s"},"lines":[{"id":"d_main_23_03_e_1","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_1","text":"Phew! That was a close shave.","jump":null,"exit":false,"enter":null,"bg":"OuterrimWall","bgArt":"outerrimwall","image":null,"bgm":"bgm_greyhaze_a","movie":null,"shown":["moran","rapi","anis","neon"],"affinity":null},{"id":"d_main_23_03_e_2","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_2","text":"I had no idea we'd run into Raptures over here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_3","text":"Moran, what are you doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_4","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_5","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_5","text":"Do you know who's to blame for all this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_6","text":"Exotic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_7","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_7","text":"You'd better take a seat for this one. It was those jerks from Exo...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_8","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_8","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_9","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_9","text":"How'd you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_10","text":"Mustang told me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_11","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_11","text":"Ah, that makes sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_12","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_12","text":"That's good then. I don't have to explain everything. I'm here to catch those bastards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_13","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_13","text":"Since Exotic has ties to the Outer Rim, I figured this would be a good place to start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_14","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_14","text":"This is actually perfect. I was kind of worried going solo. I feel a lot more confident with you all backing me up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_15","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_15","text":"Someone left this partition open, so this entire place is teeming with Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_16","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_16","text":"I might have ended up in over my head, since dealing with Raptures isn't exactly my forte.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_17","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_03_e_17","text":"What about Sakura and Rosanna?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_18","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_18","text":"Beats me. They were wary of me and didn't provide any details.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_19","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_19","text":"Those two drive me up the wall sometimes. They're always chattering with each other, yet they never tell me anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_20","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_03_e_20","text":"Is everyone in the Outer Rim safe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_21","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_21","text":"Yes. Fortunately, there was a broadcast all over the Ark about the Rapture raid,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_22","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_22","text":"so everyone was able to make it to safety in time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_03_e_23","text":"Did you find out anything about Exotic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_24","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_24","text":"I've been looking through all the evacuation camps, but haven't uncovered anything yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_25","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_25","text":"If we can find Heavenly Ascension's main base, things would go much smoother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_26","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_26","text":"Exotic paid Heavenly Ascension plenty of visits,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_27","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_27","text":"but they're always moving their base of operations to different locations. I'm not sure where they are now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_28","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_28","text":"If we track down Heavenly Ascension's main base, you think we'll turn up something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_29","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_29","text":"Most likely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_30","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_30","text":"I'm sure we'll find something related to these recent attacks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_31","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_31","text":"Even better, those Exotic punks could be there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_32","text":"Okay, let's go then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_33","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_33","text":"Let's go to the evacuation camps first. There might be someone there associated with Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_34","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_35","text":"Outer Rim Evacuation camp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_03_e_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["moran","rapi","anis","neon"],"affinity":null},{"id":"d_main_23_03_e_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_03_e_37","text":"This is bad...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_03_e_38","text":"This rinky dink setup is like a house of cards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_03_e_39","text":"A single Rapture could tear through this place like a bull in a china shop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_40","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_40","text":"Don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_41","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_41","text":"If a Rapture manages to break through, these people can still run away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_03_e_42","text":"Is that supposed to make me feel better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_43","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_43","text":"Hey! Who's the leader around here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_44","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_44","text":"I am. Who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["outerrimman"],"affinity":null},{"id":"d_main_23_03_e_45","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_45","text":"Don't you recognize me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_46","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_46","text":"Oh! Moran!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_47","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_47","text":"I'm surprised to see you here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_48","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_48","text":"I didn't have much of a choice. This is the only decent refuge left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_49","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_49","text":"What about your kid and your brother?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_50","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_50","text":"They went somewhere else. The Raptures attacked when I was leaving for work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_51","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_51","text":"Are they okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_52","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_52","text":"I'm not sure. All I can do is hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_53","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_53","text":"Like I always have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_54","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_54","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_55","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_55","text":"What's gotten into E.H., anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_56","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_56","text":"They should stick to issuing warnings or detonating government facilities. Whatever possessed them to blow a hole in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_57","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_57","text":"I heard rumblings about how there was a big attack being planned, one which wouldn't involve any causalities, but I had no idea it'd be something so out of left field.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_58","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_58","text":"And to resort to suicide bombings? How reckless and irresponsible can you get?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_59","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_59","text":"It's not what you think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_60","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_60","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_61","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_61","text":"Because of this, everyone in the Ark thinks that we're involved somehow, and now we have no idea when, or if, the other shoe is gonna to drop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_62","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_62","text":"Not only are we dealing with Raptures, but now we've got the Central Government breathing down our necks, trying to snuff us out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_63","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_63","text":"It's all thanks to the fact that E.H. comes from the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_64","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_64","text":"This is a golden opportunity for them. They've always considered us a thorn in their side, and now they can get rid of us all in one fell swoop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_65","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_65","text":"I'm telling you, that's not what's happening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_66","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_66","text":"Fine, what is it then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_67","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_67","text":"It's...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_68","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_68","text":"We're looking for those responsible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_69","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_69","text":"And we need your cooperation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_70","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_70","text":"Looking for what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_71","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_71","text":"Who are you? Some kind of soldier?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_72","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_72","text":"What's the military doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_73","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_73","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_74","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_74","text":"Uh... We don't know anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_75","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_75","text":"E.H. is the one responsible. It's got nothing to do with anyone else in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_76","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_76","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_77","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_77","text":"I know. That's why I need evidence to prove it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_78","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_78","text":"Evidence? Like what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_79","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_79","text":"Do you know where Heavenly Ascension's main base is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_80","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_81","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_81","text":"Come on, spit it out. I know you're not that high up, but you're no underling either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_82","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_82","text":"... If I tell you, you'll leave us alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_83","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_83","text":"I promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_84","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_84","text":"No, your promise doesn't mean anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_85","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_85","text":"I want soldier boy here to promise me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_86","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_86","text":"But do you even have the authority to back up such a promise?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_87","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_87","text":"I can make it happen. I promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_88","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_88","text":"... Well, I still don't fully trust you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_89","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_89","text":"We've done nothing wrong. This is all E.H.'s doing. Why do we have to be dragged into it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_90","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_03_e_90","text":"Anyway, I'll tell you if you promise to protect us. Is that a deal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_91","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_91","text":"I check the coordinates given to us by the Outer Rim citizen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_92","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_92","text":"It's not too far from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_93","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_94","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_03_e_94","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_95","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_95","text":"I'm just a bit sad, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_96","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_96","text":"E.H. worked really hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_97","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_97","text":"I know it's weird to describe a terrorist as hard-working, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_98","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_98","text":"but she did everything she could to deliver Outer Rim's message without letting anyone get hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_99","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_99","text":"Unfortunately, that was met with significant backlash, and it only made things worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_100","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_100","text":"She really tried to make the Outer Rim a better place for people to live in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_101","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_101","text":"But that's not what everyone believes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_102","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_102","text":"If you knew E.H. just a little bit, you'd know that she would never do anything to harm the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_103","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_03_e_103","text":"As far as we're concerned, E.H. is the head of a terrorist organization. Nothing more, nothing less.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_104","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_03_e_104","text":"The ideals and methodology behind it are of no concern to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_105","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_03_e_105","text":"E.H. is a terrorist who poses a serious threat to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_106","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_106","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_107","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_107","text":"Terrorism shouldn't be justified under any circumstance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_108","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_108","text":"E.H. knows that more than anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_109","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_109","text":"She tried to walk a different path but died before she could take the first step.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_03_e_110","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_03_e_110","text":"It's just sad, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}