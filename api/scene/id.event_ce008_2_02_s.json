8_2_02_s_20","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_02_s_20","text":"Was there a particular child you wanted to adopt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_21","text":"No, not exactly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_22","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_22","text":"It's just that the children here look unusually strong and healthy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_23","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_02_s_23","text":"I'm glad it comes across that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_24","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_02_s_24","text":"This center is indeed run privately by me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_25","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_02_s_25","text":"And since I only have limited resources to work with,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_26","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_02_s_26","text":"I cannot always provide proper treatment to children who fall ill, so they sometimes leave us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_27","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_02_s_27","text":"It's... truly heartbreaking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_28","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_28","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_29","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_29","text":"Were the children who left really sick?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_30","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_30","text":"Or is that their cover for children who get injured or killed during training and on missions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_31","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_31","text":"I really hope not, but I can't shake these thoughts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_32","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_32","text":"Are you still putting tracking devices on the children?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_02_s_33","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_02_s_33","text":"