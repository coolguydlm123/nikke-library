":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_52","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_52","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_53","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_53","text":"But we stabbed you in the back...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_54","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_54","text":"Are you really okay working with us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_55","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_02_s_55","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_56","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_56","text":"Wow... Very impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_57","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_57","text":"Oh, unless you're here to try and reform us former criminals...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_58","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_58","text":"Is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"im