{"id":"event_enterheaven_02_s","cat":"event","group":{"id":"ev40104","label":"ENTER HEAVEN"},"label":"Pioneer of the Outer Rim: A","stage":null,"prev":"event_enterheaven_01_e","next":"event_enterheaven_02_e","speakers":{"viper":"Viper","jackal":"Jackal","eh_n":"E.H."},"icons":{"viper":"si_c112_00_s","jackal":"si_c111_00_s","eh_n":"si_c113_00_s"},"lines":[{"id":"event_enterheaven_02_s_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_enterheaven_02_s_1","text":"Following Viper and Jackal's lead, I head deeper into the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_greyhaze","movie":null,"shown":["viper","jackal"],"affinity":null},{"id":"event_enterheaven_02_s_2","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_02_s_2","text":"There really aren't any streetlights around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_3","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_3","text":"It's dark, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_4","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_4","text":"Heavenly Ascension never developed this area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_5","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_enterheaven_02_s_5","text":"That's why there aren't any lights.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_02_s_6","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_02_s_6","text"