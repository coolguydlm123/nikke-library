{"id":"event_staranis2_03_s","cat":"event","group":{"id":"ev40109","label":"STAR ANIS · Part 2"},"label":"Fan: A","stage":null,"prev":"event_staranis2_02_e","next":"event_staranis2_03_e","speakers":{"hanson":"Hanson","elysionline0_op_l":"Elysion Line 0","missilisline0_op_r":"Missilis Line 0","mustang_past":"Mustang"},"icons":{"hanson":"si_c9023_00_s","elysionline0_op_l":"si_c999_00_s","missilisline0_op_r":"si_c999_00_s","mustang_past":"si_c9022_00_s"},"lines":[{"id":"event_staranis2_03_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_1","text":"Hanson stands rigid in the hospital's spotless corridor.","jump":null,"exit":false,"enter":null,"bg":"NikkeCorridor","bgArt":"nikkecorridor","image":null,"bgm":"none","movie":null,"shown":["hanson"],"affinity":null},{"id":"event_staranis2_03_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_2","text":"His gaze fixes on the tightly shut door, eyes hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_3","text":"He checks his phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_4","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_4","text":"A notification pops up: T.T. STAR has taken No. 1 on the indie charts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_5","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_5","text":"... I'm sorry, everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_6","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_6","text":"Just... a little longer. Please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_7","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_7","text":"It's almost over. Just hold on a bit more. I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_8","text":"He slowly closes his eyes, replaying what just happened.","jump":null,"exit":false,"enter":null,"bg":"EventScene_staranis_05","bgArt":"eventscene_staranis_05","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_9","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_9","text":"The documents came through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_staranis_undercurrent","movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_10","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_10","text":"I was under the impression our audit team already had a full picture of Tetra's misconduct, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_11","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_11","text":"this goes far beyond what I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_12","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_12","text":"Wow, there's a lot in here that could ruin someone. We've already cross-checked everything. It's solid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_13","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_13","text":"Now, if we make our move with this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_14","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_14","text":"Yes, that would be the end of Tetra.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_15","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_15","text":"Mustang too, I'd bet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_16","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_16","text":"Mustang and Tetra are one and the same. There's no difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_17","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_18","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_18","text":"Good. Hanson, I'm impressed you managed to gather this much damning material on Tetra","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_19","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_19","text":"and to leave no trace behind. Your capabilities exceed my expectations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_20","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_20","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_21","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_21","text":"So, you're telling us to use this to attack Tetra?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_22","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_22","text":"Us? Teaming up with Elysion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_23","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_23","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_24","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_24","text":"Hmm... want the honest truth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_25","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_25","text":"We've got a shot. More than a shot, actually. He's been doing some pretty dirty things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_26","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_26","text":"Not like we're ones to talk... but this guy? He's basically acting like a king, doing whatever the hell he wants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_27","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_27","text":"If we start shaking things up with this, Tetra'll fall apart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_28","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_28","text":"More importantly, he's been working closely with V.T.C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_29","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_29","text":"and the Central Government is already at odds with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_30","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_30","text":"We already cleaned out V.T.C. once before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_31","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_31","text":"So all that's left are stragglers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_32","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_32","text":"And Mustang has aligned himself with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_33","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_33","text":"That's treason and insurrection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_34","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_34","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_35","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_35","text":"Yeah, he's not someone you mess with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_36","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_36","text":"How so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_37","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_37","text":"Tetra Line is one of the Ark's Big Three, and Mustang is its CEO.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_38","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_38","text":"They don't just produce Nikkes or run entertainment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_39","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_39","text":"They're deeply embedded in the Ark's infrastructure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_40","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_40","text":"When Pretty was at her peak, Mustang used extensive lobbying to secure control over a significant portion of that infrastructure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_41","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_41","text":"If Tetra falls, the Ark falls with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_42","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_42","text":"I see... so Enikk won't just stand by and let it happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_43","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_43","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_44","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_44","text":"That's what makes him such a pain. He's running rampant, and we still can't lay a finger on him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_45","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_45","text":"If he goes down, Tetra goes down with him. That's exactly why even Enikk can't step in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_46","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_46","text":"Tetra's basically his biggest shield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_47","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_48","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_48","text":"Of course, if Tetra collapses, we stand to gain a great deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_49","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_49","text":"If one of the Big Three were to fall, it'd be nothing less than a gift from the heavens for Elysion and Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_50","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_50","text":"Problem is, we can't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_51","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_51","text":"... I have a favor to ask of you both.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_52","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_52","text":"Go on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_53","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_53","text":"You went to all this effort, so sure, I'll indulge you. Go on, ask for whatever you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_54","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_54","text":"You could even move your pop stars over to our company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_55","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_55","text":"I'd like you to arrange a meeting with Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_56","type":"Speech","speaker":"elysionline0_op_l","key":"Locale_MainScenario:event_staranis2_03_s_56","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_57","type":"Speech","speaker":"missilisline0_op_r","key":"Locale_MainScenario:event_staranis2_03_s_57","text":"... Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_58","text":"With a faint mechanical whir,","jump":null,"exit":false,"enter":null,"bg":"NikkeCorridor","bgArt":"nikkecorridor","image":null,"bgm":"none","movie":null,"shown":["hanson","mustang_past"],"affinity":null},{"id":"event_staranis2_03_s_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_59","text":"the door in front of Hanson slides open, and Mustang steps out","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_60","text":"with his personal physician is at his side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_61","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_61","text":"Mustang pauses, a hint of surprise crossing his face at the sight of Hanson. Meanwhile, the physician fidgets uneasily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_62","text":"Hanson lowers his head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_63","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_63","text":"I've come to take you back to the office. Shall we go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_64","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_65","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_65","text":"Mustang looks at the physician.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_66","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_03_s_66","text":"Sweating heavily, he desperately avoids Mustang's gaze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_67","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_67","text":"All right, drive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_68","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_68","text":"Let's see if you've still got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_69","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_69","text":"Oi, not this way. Take a right, it's faster.","jump":null,"exit":false,"enter":null,"bg":"EventScene_staranis_01_3","bgArt":"eventscene_staranis_01_3","image":null,"bgm":"event_bgm_trueentertainment","movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_70","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_70","text":"The road is blocked. This is our only way through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_71","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_71","text":"They just go around blocking everything. What, we're supposed to put up with it just because we've got cars?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_72","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_72","text":"How long do you have left?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_73","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_73","text":"Two months, tops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_74","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_74","text":"Heh, clever. You actually figured it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_75","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_75","text":"Your complexion and breathing seem different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_76","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_76","text":"So how'd you figure that out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_77","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_77","text":"Do you have any idea how many years I've spent looking at your face?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_78","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_78","text":"None of the others noticed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_79","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_79","text":"That's because no one ever really looked at you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_80","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_80","text":"... Hmph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_81","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_81","text":"You've got quite a few health issues, it seems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_82","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_82","text":"Hardly surprising after all the fun I've had in Ephialtes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_83","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_83","text":"You're at death's door, and you still look perfectly calm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_84","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_84","text":"Do I look calm? At this point, I've got more painkillers in me than I do blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_85","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_85","text":"Does that mean there's no cure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_86","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_86","text":"There will be. A new drug's coming out soon. Just for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_87","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_87","text":"They said it'll be ready in two weeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_88","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_88","text":"I didn't team up with V.T.C. for nothing. Do you know how much money I've poured into them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_89","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_89","text":"So you've known about this for a while, haven't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_90","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_90","text":"Yeah, it's been a while. That's when I started investing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_91","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_91","text":"If you intend to live that long, wouldn't Evergreen be the obvious choice?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_92","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_92","text":"That's not a cure. It only extends your lifespan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_93","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_93","text":"And I couldn't care less about Evergreen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_94","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_94","text":"Why? Thought you'd want to live forever?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_95","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_95","text":"Getting old's pathetic. Losing my edge? Even worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_96","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_96","text":"But I'm not about to let some illness make me a has-been.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_97","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_97","text":"Huh. Look at you, actually spending that much on a new drug.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_98","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_98","text":"I hate getting old, and I hate trying to slow it down even more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_99","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_99","text":"But a sickness like this still has to be dealt with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_100","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_100","text":"You don't intend to let T.T. STAR go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_101","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_101","text":"Don't delude yourself. They're not going anywhere. You saw that with your own eyes, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_102","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_102","text":"Popularity through the roof, hitting number one on the indie charts, no less. Not bad, I'll admit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_103","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_103","text":"We need them, in ways you probably don't even realize.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_104","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_104","text":"And you've been running around like a madman, pulling all these ridiculous stunts just to build them up. Well done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_105","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_105","text":"Ridiculous? Hardly. It's the most direct approach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_106","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_106","text":"You sold info on my illness to Elysion and Missilis, and Yoyo paid the price.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_107","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_107","text":"Turned tragedy into comedy. Bravo, well played.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_108","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_108","text":"So tell me, what's next?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_109","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_109","text":"Honestly, the simplest way would be to put a bullet in my head right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_110","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_110","text":"That would wrap everything up perfectly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_111","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_111","text":"That won't resolve anything. I don't want to take action that we can't remedy afterward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_112","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_112","text":"Why not bribe the doctor and swipe the new drug? Once a man's been bought, the next time's even easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_113","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_113","text":"That would certainly be the most reliable approach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_114","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_114","text":"But I won't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_115","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_115","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_116","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_116","text":"I find it rather boring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_117","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_117","text":"Hahaha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_118","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_118","text":"... Hanson,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_119","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_119","text":"you really think you can save those heaps of scrap?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_120","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_120","text":"Yes, I will save them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_121","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_121","text":"You couldn't save Pretty, could you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_122","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_122","text":"... That's why I'll save them this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_123","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_123","text":"Well, good luck with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_124","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_124","text":"Oh, and those pop stars of yours?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_125","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_125","text":"They're going mainstream next week. Thought you'd like a heads-up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_126","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis2_03_s_126","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_03_s_127","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_03_s_127","text":"You know the main