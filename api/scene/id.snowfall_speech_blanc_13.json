e to leave the walking trail.","jump":null,"exit":true,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_blanc_13_7","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_blanc_13_7","text":"Hi, Pit Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_blanc_13_8","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_blanc_13_8","text":"Hey, Blanc. What are you doing here? I saw Noir at the waterfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_blanc_13_9","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_blanc_13_9","text":"After we had lunch,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_blanc_13_10","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_blanc_13_10","text":"she said she wanted to go listen to the waterfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_blanc_13_11","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_blanc_13_11","text":"I, on the other hand, wanted to go for a stroll by the hot spring,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_blanc_13_12","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_blanc_13_12","text":"especially since we'll be leaving soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfa