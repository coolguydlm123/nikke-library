ype":"Speech","speaker":"unknown","key":"Locale_SubScenario:event_miraclesnow2_05_e_82","text":"You'll have to send this much every month.","jump":null,"exit":false,"enter":null,"bg":"GoodOffice","bgArt":"goodoffice","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_83","type":"Speech","speaker":"unknown","key":"Locale_SubScenario:event_miraclesnow2_05_e_83","text":"If you don't, then I'm afraid we won't be able to continue taking care of your daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_84","type":"Speech","speaker":"unknown","key":"Locale_SubScenario:event_miraclesnow2_05_e_84","text":"Given her condition, I doubt she'd last very long without proper treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_85","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_85","text":"I can hardly afford it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_86","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_86","text":"I have to pay this every month?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_87","type":"Speech","speaker":"unknown","key":"Locale_SubScenario:event_miraclesnow2_05_e_87","text":"Considering it's to save your daughter's life, I'd say it's a bargain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_88","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miracl