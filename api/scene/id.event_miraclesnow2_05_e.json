l,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_109","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_109","text":"But never a mother. Not unless I reminded her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_110","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_110","text":"Not once did she ever call me mother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_111","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_111","text":"Do you have any idea how it feels to have your hope slowly eaten away day by day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_112","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_112","text":"Eventually, you reach a point where hope ceases to exist, and you just... give in to the emptiness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_113","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_113","text":"In the end, she'll always forget me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_114","type":"Self","speaker":null,"key":"Locale_SubScenario:event_miraclesnow2_05_e_114","text":"Not now. She remembers now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":nul