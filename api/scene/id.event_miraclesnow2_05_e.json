ype":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_121","text":"I would have all of these memories of me and her,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_122","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_122","text":"and there I would be, having to remind her who I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_123","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_123","text":"My own daughter! Who told me she loved me just one day before!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_124","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_124","text":"I couldn't bear such a cruel twist of fate. No one could.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_125","type":"Self","speaker":null,"key":"Locale_SubScenario:event_miraclesnow2_05_e_125","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_126","type":"Speech","speaker":"rupee","key":"Locale_SubScenario:event_miraclesnow2_05_e_126","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_05_e_127","type":"Speech","speaker":"angelina","key":"Locale_SubScenario:event_miraclesnow2_05_e_127","text":"I... won't see her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":n