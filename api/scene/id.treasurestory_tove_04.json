":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_80","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_80","text":"If that's the case, I'd suggest giving up the notion of making the alloy yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_81","type":"Speech","speaker":"tove","key":"Locale_NikkeEpisode:treasurestory_tove_04_81","text":"But I... I have to fix this fire starter!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_82","type":"Speech","speaker":"tove","key":"Locale_NikkeEpisode:treasurestory_tove_04_82","text":"It holds so many important memories for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_83","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_83","text":"But why go through the trouble of making the alloy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_84","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_84","text":"All you have to do is replace the rod, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_85","type":"Speech","speaker":"tove","key":"Locale_NikkeEpisode:treasurestory_tove_04_85","text":"Yeah, but if I want a replacement rod, I need the alloy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_86","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_86","text":"No no, you're not following. What you need isn't the alloy, but another rod altogether.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_87","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_tove_04_87","text":"Right. One that's already been made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_88","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_88","text":"Wouldn't that solve your problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_89","type":"Speech","speaker":"tove","key":"Locale_NikkeEpisode:treasurestory_tove_04_89","text":"But I've searched all over the Ark, and there's none left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_90","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_90","text":"Sure, that goes without saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_91","type":"Speech","speaker":"tove","key":"Locale_NikkeEpisode:treasurestory_tove_04_91","text":"Then how are we supposed to find one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_92","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_92","text":"Weren't you listening to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_tove_04_93","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_tove_04_93","text":"On the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}