{"id":"d_nikke_hongryeon_04","cat":"bond","group":{"id":"char5041","label":"Scarlet"},"label":"Survival of the Fittest","stage":null,"prev":"d_nikke_hongryeon_03","next":"d_nikke_hongryeon_05","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_nikke_hongryeon_04_1","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_1","text":"The next day.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_2","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_2","text":"Didst the damsels mention when they shall be arriving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_04_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_3","text":"Tomorrow morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_4","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_4","text":"That means we hast some time to spare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_5","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_5","text":"Let me see... The croplands hast been tilled and the compost is ready as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_6","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_6","text":"I hast also prepared sufficient food for the next few days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_7","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_7","text":"There is naught left that needs to be dealt with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_8","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_9","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_9","text":"I suppose a touch of the devil's brew wouldn't hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_10","text":"Right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_11","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_11","text":"As the saying goes, should'st thou find yourself in a position of indolence, then by all means busy yourself with spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_12","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_12","text":"Now that we are short of tasks, we shall keep ourselves busy with the bottle!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_13","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_14","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_14","text":"But ere that, there is something we must doth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_15","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_15","text":"Whatever is gone ought to be replaced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_16","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_16","text":"In other words, we ought to craft the very drink we are to imbibe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_17","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_17","text":"Othergates, we may find ourselves at the bottom of the bottle without a single drop in sight!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_18","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_18","text":"How do we brew spirits?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_19","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_19","text":"Well, there's more than one way to skin a cat...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_20","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_20","text":"Personally, I am most partial to methods that are the simplest and most expedient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_21","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_21","text":"Hath the word \"honey wine\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_22","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_22","text":"ever fallen upon thy ears perchance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_23","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_23","text":"As the name suggests, all thou require to brew honey wine is honey,","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_24","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_24","text":"and we can procure honey from beehives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_25","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_25","text":"Much like everyone else, bees do not take kindly to those intruding upon their homestead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_26","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_26","text":"So be sure to keep thy wits about thou and avoid their stingers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_27","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_27","text":"After putting on the cloth Scarlet hands you, you gradually make your way closer to the beehive","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_28","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_28","text":"with an object that appears to be a makeshift torch made of rolled-up leaves in your hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_29","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_29","text":"It is emitting a large plume of smoke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_30","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_30","text":"At the same time, the bees buzzes around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_31","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_31","text":"However, the smoke irritates thy eyes and impairs thy vision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_32","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_32","text":"Mind thy apparel, thou ox! Should'st a bee slip in, thou shall be stung for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_33","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_33","text":"Hast thou ever experienced the displeasure of a bee's sting, my Lord?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_34","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_34","text":"Not that I recall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_35","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_35","text":"All the more reason not to experience it a first time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_36","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_36","text":"Many whom hast been stung perish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_37","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_37","text":"It can kill me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_38","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_38","text":"Yes, that is indeed so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_39","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_40","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_40","text":"What? Didst thou think they would let thou take take away their property without putting up a fight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_41","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_41","text":"Shouldn't it be safer if you did it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_42","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_42","text":"Aye, I would not encounter much resistance by doing it myself,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_43","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_43","text":"not even their stings can stop me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_44","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_44","text":"But where is the fun in that? No, this task ought to fall on thy shoulders, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_45","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_45","text":"To thrive towards the surface, one hast to first learn how to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_46","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_46","text":"It is impossible for an apex predator to exist on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_47","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_47","text":"Even those at the top of the food chain shall cease to exist should'st they fail to learn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_48","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_48","text":"... I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_49","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_49","text":"All right, now take it slow, but never waver.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_50","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_50","text":"Cast 'em out with the smoke, then claim the beehive for thy own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_51","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_51","text":"You hold your hands out slowly.","jump":"d_nikke_hongryeon_04_53","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_52","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_52","text":"You extend your hands out swiftly.","jump":"d_nikke_hongryeon_04_56","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_53","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_53","text":"Quickly now, we do not hast all night!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_54","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_55","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_55","text":"Mustering all your courage, you extend your hands out!","jump":"d_nikke_hongryeon_04_56","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_56","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_56","text":"In a split second, you exert a little too much force, knocking the beehive a little too hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_57","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_57","text":"Blimey!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_armageddon","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_58","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_58","text":"*Buzz buzz*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_59","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_59","text":"In the space of a few moments, a massive swarm of bees pours out of the beehive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_60","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_60","text":"Before you know it, they come rushing at you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_61","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_61","text":"Keep still.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_62","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_62","text":"*Crack crack*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_63","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_63","text":"The area resonates with a loud cracking sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_64","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_64","text":"By the time you open your eyes, it dawns on you that the swam has vanished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_65","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_65","text":"Tsk, it didst not hast to end this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_66","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_66","text":"Are they... all dead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_67","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_67","text":"Well, I could not hast given up on thou, now could i, my Lord?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_68","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_68","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_69","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_69","text":"Even though it pains me to hast done so, mine hands are tied. At the very least, we are able to retrieve the beehive, so gramercy for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_70","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_70","text":"Come, let us head back.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_71","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_71","text":"Let me see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_72","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_72","text":"With her blade, Scarlet removes a piece from the beehive and hands it over to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_73","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_73","text":"With that, a golden liquid flows out of the densely packed hexagons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_74","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_74","text":"Pop the entire thing into thy mouth and chew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_75","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_75","text":"Honeycombs are a good source of sustenance, although it goes in far easier than it comes out...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_76","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_76","text":"Even so, you place the piece Scarlet handed you earlier into your mouth and unhurriedly chew on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_77","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_78","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_78","text":"What dost thou think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_79","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_79","text":"This...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_80","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_80","text":"It should'st be a far cry from the artificial sweetness created in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_81","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_81","text":"Forget not the bees that laid their lives this day and savor this flavor well. Let it wash over thou.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_82","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_83","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_83","text":"I am merely saying it in jest,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_84","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_84","text":"so do not take it to heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_85","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_85","text":"It is only natural for the strong to take from the weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_86","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_86","text":"Since the bees were far weaker than us, they met their inevitable demise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_87","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_87","text":"That is the way of the world, so there is no sin in it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_88","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_88","text":"... Do you feel the same way about humans and Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_89","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_90","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_90","text":"That i doth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_91","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_91","text":"Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_92","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_92","text":"Dost thou intend on doing something about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_93","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_94","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_94","text":"Stop gazing upon me in such a manner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_95","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_95","text":"Mine duties at hand are set in stone as I hast mentioned before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_96","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_96","text":"eradicating all Raptures and assisting mankind in reclaiming the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_97","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_97","text":"Won't you be violating the laws of nature?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_98","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_98","text":"I beg your pardon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_99","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_99","text":"Haha. Doth that make any sense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_100","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_100","text":"Yet I suppose thou art right to ask that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_101","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_101","text":"Alas, it is indeed a gladsome matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_102","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_102","text":"Ponder over this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_103","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_103","text":"Little didst anyone know an insignificant insect to whom we never gave a second thought,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_104","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_104","text":"something that can be slain with a brandish of the blade,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_105","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_105","text":"shall one day topple humans from the top of the food chain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_04_106","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_04_106","text":"A rather ironic and amusing anecdote, is it not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}