ull,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_112","type":"Speech","speaker":"oliver","key":"Locale_SubScenario:event_goodworld_intermission_01_112","text":"I'm just... glad I could see the agreement through... before things got worse...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_113","type":"Speech","speaker":"oliver","key":"Locale_SubScenario:event_goodworld_intermission_01_113","text":"Now... I think I can go... without any regrets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_114","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_intermission_01_114","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_115","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_intermission_01_115","text":"Thank you for all your hard work, Oliver.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_116","type":"Speech","speaker":"oliver","key":"Locale_SubScenario:event_goodworld_intermission_01_116","text":"Um... Miss Snow Crane,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_117","type":"Speech","speaker":"oliver","key":"Locale_SubScenario:event_goodworld_intermission_01_117","text":"could I... ask one last favor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":