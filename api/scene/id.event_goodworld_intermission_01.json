d_intermission_01_87","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_intermission_01_87","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_88","type":"Speech","speaker":"oliver","key":"Locale_SubScenario:event_goodworld_intermission_01_88","text":"I see... What a pity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_89","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_intermission_01_89","text":"Now then, I'll proceed with closing out the agreement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_90","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_intermission_01_90","text":"Oliver.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_91","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_intermission_01_91","text":"As agreed, I have one final question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_92","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_intermission_01_92","text":"In your opinion,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_intermission_01_93","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_intermission_01_93","text":"do you feel the Ark has become a better