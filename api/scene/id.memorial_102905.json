{"id":"memorial_102905","cat":"memorial","group":{"id":"memorial102900","label":"Memoirs · \"Down With Enikk\" Poster"},"label":"Enikk Is a Ticking Time Bomb!","stage":null,"prev":"memorial_102904","next":null,"speakers":{},"icons":{},"lines":[{"id":"memorial_102905_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_29_05_description","text":"The Ark could collapse at a moment's notice, should Enikk deem it so!"},{"id":"memorial_102905_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_29_05_description","text":"Enikk has been granted carte blanche, and has run amok!"},{"id":"memorial_102905_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_29_05_description","text":"Humans must take the power back!"}]}