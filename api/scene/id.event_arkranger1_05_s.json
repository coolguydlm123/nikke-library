1_05_s_28","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_28","text":"My pathetic little game of playing hero...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_29","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_29","text":"Hope found courage in it, and saw something to believe in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_30","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_30","text":"But it was all false courage and false hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_31","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_31","text":"I feel so ashamed and foolish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_32","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_32","text":"All of this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_33","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_33","text":"It's like a bad joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_34","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_34","text":"Wearing this absurd suit, shouting out attack names...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_35","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_35","text":"I'm no more than a clown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_36","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_36","text":"I know that feeling...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_37","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_37","text":"Hey, you remember what I said before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_38","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_38","text":"A hero is someone who stands by their convictions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_39","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_39","text":"I remember. Your words are what made me choose to become an Ark Ranger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_40","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_40","text":"Those convictions of yours...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_41","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_41","text":"You don't have to make them so grand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_42","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_42","text":"I decided to be a hero who gives people courage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_43","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_43","text":"You don't necessarily have to be a real hero to inspire courage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_44","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_44","text":"An on-screen hero is wonderful enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_45","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_45","text":"It doesn't change the fact that we inspire courage in people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_46","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_05_s_46","text":"And don't think I'm saying that simply to justify my own decisions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_47","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_05_s_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_05_s_48","type":"Speech","speaker":"red",