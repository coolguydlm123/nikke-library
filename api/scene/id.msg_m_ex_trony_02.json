{"id":"msg_m_ex_trony_02","cat":"messenger","group":{"id":"room_trony","label":"Trony · Nikke"},"label":"2. T_T","stage":null,"prev":"msg_m_ex_trony_01","next":"msg_m_ex_trony_03","speakers":{"trony":"Trony"},"icons":{"trony":"si_c501_00_s"},"lines":[{"id":"m_ex_trony_02_1","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_1","text":"T_T","jump":null},{"id":"m_ex_trony_02_2","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_2","text":"Commander!","jump":null},{"id":"m_ex_trony_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_3","text":"What's up?","jump":null},{"id":"m_ex_trony_02_4","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_4","text":"Um...","jump":null},{"id":"m_ex_trony_02_5","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_5","text":"I went to a photosynthesis gathering with Elegg yesterday.","jump":null},{"id":"m_ex_trony_02_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_6","text":"A what now?","jump":null},{"id":"m_ex_trony_02_7","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_7","text":"It's a gathering that Elegg organized after attending the Ark Gaming Expo.","jump":null},{"id":"m_ex_trony_02_8","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_8","text":"The main idea is to go outside as a group once a week and bask in the sun.","jump":null},{"id":"m_ex_trony_02_9","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_9","text":"There are four members: me, Elegg, Exia, and Maiden.","jump":null},{"id":"m_ex_trony_02_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_10","text":"I could have figured that out without you saying.","jump":null},{"id":"m_ex_trony_02_11","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_11","text":"Yeah...","jump":null},{"id":"m_ex_trony_02_12","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_12","text":"We all went outside yesterday,","jump":null},{"id":"m_ex_trony_02_13","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_13","text":"but they want to go again today...","jump":null},{"id":"m_ex_trony_02_14","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_14","text":"T_T","jump":null},{"id":"m_ex_trony_02_15","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_15","text":"Can you help me?","jump":null},{"id":"m_ex_trony_02_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_16","text":"Help you how?","jump":null},{"id":"m_ex_trony_02_17","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_17","text":"You could tell them that I have an important appointment with you,","jump":null},{"id":"m_ex_trony_02_18","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_18","text":"and I can use that as an excuse!","jump":null},{"id":"m_ex_trony_02_19","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_19","text":"Oh, wait.","jump":null},{"id":"m_ex_trony_02_20","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_20","text":"No, that won't work.","jump":null},{"id":"m_ex_trony_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_21","text":"??","jump":null},{"id":"m_ex_trony_02_22","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_22","text":"I don't want to lie to Elegg.","jump":null},{"id":"m_ex_trony_02_23","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_23","text":"Er...","jump":null},{"id":"m_ex_trony_02_24","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_24","text":"But I don't want to head out either...","jump":null},{"id":"m_ex_trony_02_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_25","text":"What do you all usually do when you're out?","jump":null},{"id":"m_ex_trony_02_26","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_26","text":"Usually, we'd be at the Arcade","jump":null},{"id":"m_ex_trony_02_27","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_27","text":"or watch an anime movie.","jump":null},{"id":"m_ex_trony_02_28","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_28","text":"Yeah,","jump":null},{"id":"m_ex_trony_02_29","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_29","text":"things like that.","jump":null},{"id":"m_ex_trony_02_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_30","text":"I thought you said you all go out to sunbathe.","jump":null},{"id":"m_ex_trony_02_31","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_31","text":"That's ri...","jump":null},{"id":"m_ex_trony_02_32","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_32","text":"There is no response for a long time.","jump":null},{"id":"m_ex_trony_02_33","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_33","text":"Mr. Commander.","jump":null},{"id":"m_ex_trony_02_34","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_34","text":"Mr. Commander.","jump":null},{"id":"m_ex_trony_02_35","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_35","text":"Mr. Commanderrrrrrrr!","jump":null},{"id":"m_ex_trony_02_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_36","text":"Yes?","jump":null},{"id":"m_ex_trony_02_37","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_37","text":"This is Elegg.","jump":null},{"id":"m_ex_trony_02_38","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_38","text":"Trony and I are going to the Arcade.","jump":null},{"id":"m_ex_trony_02_39","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_39","text":"Do you wanna come?","jump":null},{"id":"m_ex_trony_02_40","type":"Speech","speaker":"trony","key":"Locale_SuddenMessage:m_ex_trony_02_40","text":"If you do, we'll wait for you.","jump":null},{"id":"m_ex_trony_02_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_41","text":"Elegg?","jump":null},{"id":"m_ex_trony_02_42","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_42","text":"I wait for a while, but there is no further reply.","jump":null},{"id":"m_ex_trony_02_43","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trony_02_43","text":"I should head to the Arcade that Elegg mentioned.","jump":null}],"chat":true}