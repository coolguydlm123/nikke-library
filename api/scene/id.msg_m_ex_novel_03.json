{"id":"msg_m_ex_novel_03","cat":"messenger","group":{"id":"room_novel","label":"Novel · Nikke"},"label":"3. Hello, Watson.","stage":null,"prev":"msg_m_ex_novel_02","next":"msg_m_ex_novel_04","speakers":{"novel":"Novel"},"icons":{"novel":"si_c212_00_s"},"lines":[{"id":"m_ex_novel_03_1","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_1","text":"Hello, Watson.","jump":null},{"id":"m_ex_novel_03_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_2","text":"??","jump":null},{"id":"m_ex_novel_03_3","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_3","text":"Until now, I hadn't gotten any reply from Novel.","jump":null},{"id":"m_ex_novel_03_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_4","text":"What are you up to?","jump":null},{"id":"m_ex_novel_03_5","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_5","text":"Hope you're having a nice day.","jump":null},{"id":"m_ex_novel_03_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_6","text":"Is this Novel?","jump":null},{"id":"m_ex_novel_03_7","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_7","text":"After a moment, no reply.","jump":null},{"id":"m_ex_novel_03_8","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_8","text":"Yes.","jump":null},{"id":"m_ex_novel_03_9","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_9","text":"I'm practicing my typing.","jump":null},{"id":"m_ex_novel_03_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_10","text":"You took a while to reply.","jump":null},{"id":"m_ex_novel_03_11","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_11","text":"I want to","jump":null},{"id":"m_ex_novel_03_12","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_12","text":"send an entire sentence","jump":null},{"id":"m_ex_novel_03_13","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_13","text":"without any typos.","jump":null},{"id":"m_ex_novel_03_14","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_14","text":"That's why I took so long to reply.","jump":null},{"id":"m_ex_novel_03_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_15","text":"This doesn't feel right. Just stick to your previous style.","jump":null},{"id":"m_ex_novel_03_16","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_16","text":"Okay, got it, Watson,","jump":null},{"id":"m_ex_novel_03_17","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_17","text":"Ahhh, this feels, much better,","jump":null},{"id":"m_ex_novel_03_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_18","text":"Agreed.","jump":null},{"id":"m_ex_novel_03_19","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_19","text":"The lesson, I've learned today, is that","jump":null},{"id":"m_ex_novel_03_20","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_20","text":"I shouldn't, force myself, to make any changes.","jump":null},{"id":"m_ex_novel_03_21","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_21","text":"Actually, I, felt, weird, too.","jump":null},{"id":"m_ex_novel_03_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_22","text":"Why did you try to change your writing then?","jump":null},{"id":"m_ex_novel_03_23","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_23","text":"Several, Nikkes, said, that my messages are a pain to read,","jump":null},{"id":"m_ex_novel_03_24","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_24","text":"so, I thought, maybe I should try, making a change.","jump":null},{"id":"m_ex_novel_03_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_25","text":"I think your messages are just fine as they are.","jump":null},{"id":"m_ex_novel_03_26","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_26","text":"You, think so?","jump":null},{"id":"m_ex_novel_03_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_27","text":"There's no need to fix what isn't broken.","jump":null},{"id":"m_ex_novel_03_28","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_28","text":"Okay, got it, Watson,","jump":null},{"id":"m_ex_novel_03_29","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_29","text":"but, I still, need to practice,,,","jump":null},{"id":"m_ex_novel_03_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_30","text":"All right, practice with me an hour every day.","jump":null},{"id":"m_ex_novel_03_31","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_31","text":"!!","jump":null},{"id":"m_ex_novel_03_32","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_32","text":"Could I, really, do that?","jump":null},{"id":"m_ex_novel_03_33","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_33","text":"Okay, then, I'll come pay you a visit, tomorrow,,,","jump":null},{"id":"m_ex_novel_03_34","type":"Speech","speaker":"novel","key":"Locale_SuddenMessage:m_ex_novel_03_34","text":"Thanks, Watson,,,","jump":null},{"id":"m_ex_novel_03_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_novel_03_35","text":"Think nothing of it.","jump":null}],"chat":true}