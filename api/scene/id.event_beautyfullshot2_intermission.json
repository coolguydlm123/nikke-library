yfullshot2_intermission_110","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_intermission_110","text":"You went on a vendetta and wiped out your former organization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_intermission_111","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_intermission_111","text":"That's right,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_intermission_112","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_intermission_112","text":"and you know how I felt afterward?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_intermission_113","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_intermission_113","text":"I don't care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_intermission_114","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_intermission_114","text":"I felt lonely. Isn't that funny?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_intermission_115","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_intermission_115","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_intermission_116","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyful