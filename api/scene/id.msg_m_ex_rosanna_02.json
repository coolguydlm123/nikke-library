{"id":"msg_m_ex_rosanna_02","cat":"messenger","group":{"id":"room_rosanna","label":"Rosanna · Nikke"},"label":"2. Mister","stage":null,"prev":"msg_m_ex_rosanna_01","next":"msg_m_ex_rosanna_03","speakers":{"rosanna":"Rosanna"},"icons":{"rosanna":"si_c280_00_s"},"lines":[{"id":"m_ex_rosanna_02_1","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_1","text":"Mister","jump":null},{"id":"m_ex_rosanna_02_2","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_2","text":"Where are you?","jump":null},{"id":"m_ex_rosanna_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_3","text":"I'm in the Commander's Room.","jump":null},{"id":"m_ex_rosanna_02_4","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_4","text":"Why are you still there?","jump":null},{"id":"m_ex_rosanna_02_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_5","text":"??","jump":null},{"id":"m_ex_rosanna_02_6","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_6","text":"Don't tell me","jump":null},{"id":"m_ex_rosanna_02_7","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_7","text":"you've forgotten our plans?","jump":null},{"id":"m_ex_rosanna_02_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_8","text":"What plans?","jump":null},{"id":"m_ex_rosanna_02_9","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_9","text":"Ugh...","jump":null},{"id":"m_ex_rosanna_02_10","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_10","text":"I can't believe you actually forgot.","jump":null},{"id":"m_ex_rosanna_02_11","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_11","text":"I guess I'm the only one who was taking this seriously.","jump":null},{"id":"m_ex_rosanna_02_12","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_12","text":"No matter how hard I rack my brain, I can't remember what I promised Rosanna.","jump":null},{"id":"m_ex_rosanna_02_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_13","text":"Sorry, but I'm coming up blank.","jump":null},{"id":"m_ex_rosanna_02_14","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_14","text":"Good grief!","jump":null},{"id":"m_ex_rosanna_02_15","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_15","text":"You really don't remember at all?","jump":null},{"id":"m_ex_rosanna_02_16","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_16","text":"Didn't my subordinate say anything to you?","jump":null},{"id":"m_ex_rosanna_02_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_17","text":"Nobody told me anything.","jump":null},{"id":"m_ex_rosanna_02_18","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_18","text":"Rosanna doesn't reply.","jump":null},{"id":"m_ex_rosanna_02_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_19","text":"Rosanna?","jump":null},{"id":"m_ex_rosanna_02_20","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_20","text":"My apologies.","jump":null},{"id":"m_ex_rosanna_02_21","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_21","text":"My subordinate didn't do his job.","jump":null},{"id":"m_ex_rosanna_02_22","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_22","text":"It seems my message wasn't properly relayed to you.","jump":null},{"id":"m_ex_rosanna_02_23","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_23","text":"... You're not going to kill your subordinate, are you?","jump":"m_ex_rosanna_02_25"},{"id":"m_ex_rosanna_02_24","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_24","text":"... You're not going to shoot your subordinate, are you?","jump":"m_ex_rosanna_02_25"},{"id":"m_ex_rosanna_02_25","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_25","text":"That's none of your concern.","jump":null},{"id":"m_ex_rosanna_02_26","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_26","text":"At any rate, he'll live,","jump":null},{"id":"m_ex_rosanna_02_27","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_27","text":"so don't worry too much.","jump":null},{"id":"m_ex_rosanna_02_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_28","text":"So... what were these plans?","jump":null},{"id":"m_ex_rosanna_02_29","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_29","text":"Well...","jump":null},{"id":"m_ex_rosanna_02_30","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_30","text":"It's a little weird","jump":null},{"id":"m_ex_rosanna_02_31","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_31","text":"saying this to you myself.","jump":null},{"id":"m_ex_rosanna_02_32","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_32","text":"Why don't you take a guess?","jump":null},{"id":"m_ex_rosanna_02_33","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_33","text":"Watch a movie together?","jump":"m_ex_rosanna_02_35"},{"id":"m_ex_rosanna_02_34","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_34","text":"Have dinner together?","jump":"m_ex_rosanna_02_35"},{"id":"m_ex_rosanna_02_35","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_35","text":"Such an innocent guess!","jump":null},{"id":"m_ex_rosanna_02_36","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_36","text":"I'm afraid you're incorrect.","jump":null},{"id":"m_ex_rosanna_02_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_37","text":"Can I have a hint?","jump":null},{"id":"m_ex_rosanna_02_38","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_38","text":"A hint?","jump":null},{"id":"m_ex_rosanna_02_39","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_39","text":"All right, fine.","jump":null},{"id":"m_ex_rosanna_02_40","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_40","text":"I'll give you a few keywords.","jump":null},{"id":"m_ex_rosanna_02_41","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_41","text":"Night.","jump":null},{"id":"m_ex_rosanna_02_42","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_42","text":"Whiskey.","jump":null},{"id":"m_ex_rosanna_02_43","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_43","text":"Hotel.","jump":null},{"id":"m_ex_rosanna_02_44","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_44","text":"Is that enough?","jump":null},{"id":"m_ex_rosanna_02_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_45","text":"... Should I go to the hotel right now?","jump":null},{"id":"m_ex_rosanna_02_46","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_46","text":"Feel free to stop by anytime.","jump":null},{"id":"m_ex_rosanna_02_47","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_47","text":"I'll prepare the whiskey.","jump":null},{"id":"m_ex_rosanna_02_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_02_48","text":"What are we going to do once I get there?","jump":null},{"id":"m_ex_rosanna_02_49","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_49","text":"Mister, please.","jump":null},{"id":"m_ex_rosanna_02_50","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_50","text":"Are you really that dense?","jump":null},{"id":"m_ex_rosanna_02_51","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_51","text":"Night. Alcohol. Hotel.","jump":null},{"id":"m_ex_rosanna_02_52","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_52","text":"What do you think we'll be doing?","jump":null},{"id":"m_ex_rosanna_02_53","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_53","text":"I suggest you come quickly.","jump":null},{"id":"m_ex_rosanna_02_54","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_54","text":"If you're too late, I won't be here.","jump":null},{"id":"m_ex_rosanna_02_55","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_55","text":"Room 805.","jump":null},{"id":"m_ex_rosanna_02_56","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_56","text":"I'll be waiting.","jump":null},{"id":"m_ex_rosanna_02_57","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_02_57","text":"And I'm wearing something I think you'll enjoy.","jump":null}],"chat":true}