{"id":"memorial_102701","cat":"memorial","group":{"id":"memorial102700","label":"Data · Rapture Anomaly Report - Part 1"},"label":"Rapture Anomaly Report 01","stage":null,"prev":null,"next":"memorial_102702","speakers":{},"icons":{},"lines":[{"id":"memorial_102701_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_27_01_description","text":"We encountered a Rapture horde while conducting an assignment."},{"id":"memorial_102701_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_27_01_description","text":"The result of the ensuing clash was mutual destruction."},{"id":"memorial_102701_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_27_01_description","text":"All my teammates were wiped out, as were the Raptures."},{"id":"memorial_102701_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_27_01_description","text":"I am the only one left."},{"id":"memorial_102701_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_27_01_description","text":"My legs are broken, and I'm unable to crawl out of this cave. All I can do is send distress signals."}]}