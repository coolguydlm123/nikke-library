,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_13","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_13","text":"Isn't this all a bit outside your wheelhouse?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_14","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_14","text":"Doesn't fighting Raptures keep you busy enough as is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_15","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_viper_03_15","text":"This is something I have to do as well.","jump":"d_nikke_viper_03_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_16","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_viper_03_16","text":"I can't sit back and watch Nikkes suffer.","jump":"d_nikke_viper_03_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_17","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_17","text":"I thought your main responsibility was reclaiming the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_18","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_viper_03_18","text":"That's true,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_19","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_viper_03_19","text":"but I can't just sit back and watch Nikkes suffer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_20","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_20","text":"I understand. You're a good person, so it's natural for you to feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_secondhand","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_21","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_21","text":"I was debating whether or not to show you this, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_22","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_viper_03_22","text":"Viper hands over her phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_23","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_23","text":"The club manager here has a thing for Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_24","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_24","text":"He's conducted so many deals with collectors, there's no way he's using all those Nikkes just to run his clubs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_25","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_25","text":"I guarantee more than a few of those Nikkes he bought are for his own \"personal\" use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_26","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_viper_03_26","text":"I look at Viper's phone screen. It displays a document detailing all the sordid activities going on at the club.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_27","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_viper_03_27","text":"I've heard rumblings about this before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_28","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_viper_03_28","text":"If I don't apprehend him tonight, then more Nikkes will suffer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_29","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_29","text":"I'm glad I decided to show you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_30","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_30","text":"I was going to make you a proposition, but now that may not be such a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_31","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_viper_03_31","text":"What was it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_03_32","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_03_32","text"