{"id":"d_counseling_volume_03","cat":"counsel","group":{"id":"char5075","label":"Volume"},"label":"Advising Volume: 03","stage":null,"prev":"d_counseling_volume_02","next":"d_counseling_volume_04","speakers":{"volume":"Volume"},"icons":{"volume":"si_c431_00_s"},"lines":[{"id":"d_counseling_volume_03_1","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_1","text":"Sometimes I feel like the Ark is a kind of gilded cage.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["volume"],"affinity":"_0"},{"id":"d_counseling_volume_03_2","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_2","text":"Freedom is a foreign concept here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_3","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_3","text":"When I look up, all I see is a ceiling instead of the actual sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_volume_03_4","text":"Let's drill a hole through it!","jump":"d_counseling_volume_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_volume_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_volume_03_5","text":"Let's use music to blast a hole through it!","jump":"d_counseling_volume_03_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_volume_03_6","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_6","text":"Have you lost your mind?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_7","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_7","text":"A drill? That's absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_8","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_8","text":"If the Curtain falls, that's a wrap for every last one of us.","jump":"d_counseling_volume_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_9","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_9","text":"All right, that's enough daydreaming for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_10","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_10","text":"Although... that does sound kinda fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_11","type":"Speech","speaker":"volume","key":"Locale_Counseling:d_counseling_volume_03_11","text":"Should we give it a go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_volume_03_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_volume_03_12","text":"Volume and I discuss how to feel freer inside the Ark.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}