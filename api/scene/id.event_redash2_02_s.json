{"id":"event_redash2_02_s","cat":"event","group":{"id":"ev40032","label":"RED ASH · Part 2"},"label":"Proud Memories: A","stage":null,"prev":"event_redash2_01_e","next":"event_redash2_02_e","speakers":{"liliweiss":"Liliweiss","commander":"Commander","hongryeon_o":"Scarlet","dorothy":"Dorothy","rapunzel_o":"Rapunzel","snowwhite_o":"Snow White"},"icons":{"liliweiss":"si_c943_00_s","commander":"si_c942_00_s","hongryeon_o":"si_c225_00_s","dorothy":"si_c233_00_s","rapunzel_o":"si_c966_00_s","snowwhite_o":"si_c224_00_s"},"lines":[{"id":"event_redash2_02_s_1","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_1","text":"All clear.","jump":null,"exit":false,"enter":null,"bg":"Desert_05","bgArt":"desert_05","image":null,"bgm":"none","movie":null,"shown":["liliweiss","commander","snowwhite_o","rapunzel_o","dorothy","hongryeon_o"],"affinity":null},{"id":"event_redash2_02_s_2","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash2_02_s_2","text":"Well done. Let's head back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_3","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_3","text":"That scoundrel still refuses to show herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_4","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_02_s_4","text":"You mean Cinderella?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_5","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_5","text":"Yes. My entire body itches for revenge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_02_s_6","text":"Are you even sure that you could win against it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_7","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_7","text":"All I can do is give it my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_8","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_8","text":"We can drop the Cinderella moniker going forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_9","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_9","text":"It's been given a formal code name: Anachiro.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_redash_ashsmoke","movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_10","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash2_02_s_10","text":"... Anachiro.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_11","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_11","text":"Why would this being scurry off with its tail tucked between its legs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_12","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_12","text":"It's done nothing of the sort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_13","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_13","text":"Anachiro is on the lips of nearly everyone in the Ark. We've just been so preoccupied with our battlefield engagements, that we haven't noticed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_14","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_14","text":"She leaves a trail of utter destruction in her wake. No one even has time to put up a fight before they're annihilated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_15","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_15","text":"The most curious thing is that she always lets one person live. Just one. Be it a Nikke or a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_16","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_16","text":"It's as if she wants to leave a witness to spread the word about her achievements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_17","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash2_02_s_17","text":"How could this have happened to Cinderella?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_18","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash2_02_s_18","text":"She was a Grimms model, and the second generation to boot. She should be fighting alongside the humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_19","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_19","text":"Back in the research center,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_20","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_20","text":"you saw that Rapture and Nikke amalgamation yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_21","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_21","text":"It's safe to assume that this Anachiro is the successful version of what we saw in that lab.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_22","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_22","text":"Her power has been enhanced to unprecedented levels, and she's been programmed to be hostile toward humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_23","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_23","text":"So are we just going to let her cause all this chaos?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_24","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_24","text":"Not a chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_25","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_25","text":"Anachiro is quickly becoming a symbol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_26","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_26","text":"To the Raptures, she represents victory, and for humans? Terror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_27","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_27","text":"She is our diametric opposite. The shadow to our light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_28","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_28","text":"I'd love nothing more than to take her down, but our hands are full as is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_29","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_29","text":"Besides, we won't have to wait long until we encounter her again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_30","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_30","text":"It's only a matter of time until she finds us and attacks the entrance to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_31","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash2_02_s_31","text":"Is there any way we can stand up against her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_32","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_33","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash2_02_s_33","text":"Our safest bet is","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_34","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash2_02_s_34","text":"pitting her against Lilith one-on-one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_35","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash2_02_s_35","text":"So in other words, all we can do is throw Lilith to the wolves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_36","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash2_02_s_36","text":"Don't give up hope just yet. Lilith specializes in one-on-one combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_37","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash2_02_s_37","text":"Oh, I know. If there's anyone who can take it down, it's Lilith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_38","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_38","text":"Hehe, thanks for the vote of confidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_39","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_40","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_40","text":"So, what you mean is:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_41","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_41","text":"The only reason we couldn't vanquish the fiend was because Lilith was preoccupied with rescuing us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_42","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash2_02_s_42","text":"Yes. That's exactly what I'm saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_43","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_02_s_43","text":"... The truth is a harsh mistress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_02_s_44","type":"Speech","speaker":"liliweiss","k