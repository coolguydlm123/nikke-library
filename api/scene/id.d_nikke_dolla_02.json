ive. I like this attitude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_75","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_75","text":"Commanders who value Nikkes are really rare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_76","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_76","text":"You have now been upgraded to \"very important client.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_77","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_77","text":"So, you're really not gonna tell me your plans?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_78","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_78","text":"Why would someone like you buy such a shady chip?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_79","type":"Monologue","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_79","text":"Dolla looks me over expectantly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_80","type":"Self","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_80","text":"I'm not here for the chip.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_81","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_81","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_82","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_82","text":"Then why are you here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_83","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_02_83","text":"I wanted to warn you about the dangers of the Dark Net.","jump":"d_nikke_dolla_02_85","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_84","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_02_84","text":"Because I worry about you, Dolla.","jump":"d_nikke_dolla_02_95","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_85","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_85","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_86","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_86","text":"... Chatting with you like this is meaningless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_87","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_87","text":"Look, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_88","type":"Monologue","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_88","text":"Dolla pushes her face towards