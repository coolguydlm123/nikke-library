ill give you a special gift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_102","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_102","text":"Take the chip. You can have it for free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_103","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_02_103","text":"I still have some work to do tonight. I'll be going now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_104","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_02_104","text":"Dolla leaves like the wind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_105","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_02_105","text":"... It's late.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_02_106","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_02_106","text":"I'll go back to the dorm\nand take a look at what Dolla gave me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}