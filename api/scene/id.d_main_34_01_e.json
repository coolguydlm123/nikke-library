{"id":"d_main_34_01_e","cat":"main","group":{"id":"ch34","label":"Chapter 34 · Inheritance"},"label":"Pride: B","stage":"34-3 STAGE · End","prev":"d_main_34_01_s","next":"d_main_34_02","speakers":{"emma_t":"Emma","anis":"Anis","eunhwa_t":"Eunhwa","neon":"Neon","vesti_t":"Vesti","rapi":"Rapi"},"icons":{"emma_t":"si_c093_00_s","anis":"si_c012_00_s","eunhwa_t":"si_c095_00_s","neon":"si_c011_00_s","vesti_t":"si_c094_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_34_01_e_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_1","text":"I figured you all would be fast, but I didn't expect you to arrive that quickly.","jump":null,"exit":false,"enter":null,"bg":"BlackPuddle","bgArt":"blackpuddle","image":null,"bgm":"bgm_chapter34_field_clash","movie":null,"shown":["emma_t","vesti_t","eunhwa_t","rapi","anis","neon"],"affinity":null},{"id":"d_main_34_01_e_2","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_2","text":"We've long had a Tactical Upgrade Procedure in place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_3","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_3","text":"It was simply a matter of enacting it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_4","text":"Did you swap out your bodies?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_5","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_5","text":"Yeah, and we received some new equipment as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_6","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_6","text":"Eunhwa didn't get a new weapon, though. She just added a nifty scope to the one she has.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_7","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_7","text":"She also made adjustments so that she could use special ammunition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_8","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_8","text":"Like that round which exploded after entering Behemoth's body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_9","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_9","text":"So you noticed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_10","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_10","text":"Since her exterior is next to impervious, the answer lies in destroying her from the inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_11","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_11","text":"By sacrificing a bit of stopping power in exchange for maximum penetration, you get a round that lodges itself inside the target's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_12","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_12","text":"Once it's firmly implanted inside, it detonates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_13","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_13","text":"It was even more effective than I anticipated. It could definitely come in handy later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_14","text":"Any other upgrades you all got?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_15","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_15","text":"I've also got a cloak outfitted with camouflage capabilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_16","text":"Like stealth camouflage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_17","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_17","text":"Exactly. In a place like this, where you're out in the elements, it allows you to blend in effortlessly with your surroundings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_18","text":"I see you've decided to fight dirty as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_19","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_19","text":"You moron, there's no such thing as fighting dirty in war. Only the losing side would say something so foolish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_20","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_20","text":"It stands to reason that the side which is most prepared will win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_21","text":"Fair point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_22","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_34_01_e_22","text":"Vesti, you seem to have a whole bunch of accessories now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_23","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_34_01_e_23","text":"Oh, yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_24","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_34_01_e_24","text":"I can carry more missiles now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_25","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_34_01_e_25","text":"I can also launch more of them at one time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_26","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_34_01_e_26","text":"This equipment I've got on my body also acts like a shield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_27","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_34_01_e_27","text":"It affects my mobility a bit, but I don't do much moving around anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_28","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_34_01_e_28","text":"Even in the event I were to self-destruct, any damage I sustained wouldn't be fatal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_29","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_34_01_e_29","text":"Wow. You've turned into a walking fortress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_34_01_e_30","text":"... My title of having the mightiest firepower might be in peril.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_31","text":"When in the world were you given that title?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_32","text":"Something about you seems different, Emma.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_33","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_33","text":"Haha, you think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_34","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_34","text":"This is a unique outfit. This part here, the shiny bit, contains a special liquid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_35","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_35","text":"Wanna touch it? It feels really good. Nice and moist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_36","text":"I don't think I should... but then again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_37","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_01_e_37","text":"I don't think that's necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_38","text":"Why are you even entertaining that idea, Commander?! Get a hold of yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_40","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_40","text":"I can store liquids in my outfit,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_41","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_41","text":"and whenever I need to, I can spray whatever's inside to produce the intended effect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_42","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_42","text":"I can swap out different liquids depending on the nature of the operation, so it's highly versatile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_43","text":"Why don't you just spray some pheromones and be done with it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_44","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_44","text":"Oh my goodness!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_45","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_34_01_e_45","text":"The way the crystals crumbled apart earlier, was that you, Emma?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_46","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_46","text":"Hehe, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_47","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_47","text":"I sprayed a concentrate of Alva Particles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_48","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_48","text":"I thought Alva Particles were only meant to disrupt communications?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_49","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_49","text":"More or less, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_50","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_50","text":"The primary function of Alva Particles is that they block electrical signals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_51","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_51","text":"That's why Nikkes become incapacitated if the concentration is too high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_52","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_52","text":"Since these crystals feed on electricity, cutting off their power supply is key.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_53","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_53","text":"It took some time to find the optimal value that would cut off the crystal's energy supply, while leaving Nikkes unaffected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_54","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_54","text":"I'd say it was time well spent, though!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_55","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_34_01_e_55","text":"Does that mean we're now immune to Behemoth's crystal attacks?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_56","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_34_01_e_56","text":"Hehe, pretty much. So long as I'm around, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_57","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_57","text":"I see you all came well-prepared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_58","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_58","text":"When you're hunting big game, you've got to be properly equipped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_59","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_59","text":"In terms of brute strength, Behemoth may be the most powerful of all the Heretics we've encountered so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_60","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_60","text":"We can't come waltzing into an encounter with her unprepared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_61","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_61","text":"However, now it seems a new Heretic is in the mix as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_62","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_62","text":"Based on the combat data you provided, Leviathan's abilities are more difficult for us to counter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_63","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_64","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_34_01_e_64","text":"Eunhwa regards us seriously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_65","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_65","text":"On top of that, we're separated from Cinderella and Grave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_66","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_66","text":"This isn't good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_67","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_67","text":"Hey! What are we, chopped liver?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_68","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_68","text":"Hmph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_69","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_34_01_e_69","text":"If the last engagement is any indication, your contribution was practically nonexistent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_70","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_01_e_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_34_01_e_71","text":"Pssh. You get some new gear, and suddenly you think you're all that and a bag of chips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_01_e_72","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_34_01_e_72","text":"We're plenty good at fighting too!","jump":null,"exit":false,"enter":null,"bg