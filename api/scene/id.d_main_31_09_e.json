we don't have the necessary equipment on hand to do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_09_e_21","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_09_e_21","text":"As for the coffin and strange weapon of hers,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_09_e_22","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_09_e_22","text":"we should be able to open both of them, since their security levels aren't that high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_09_e_23","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_09_e_23","text":"Should I open them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_09_e_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_09_e_24","text":"No. I think we should leave it for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_09_e_25","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_09_e_25","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_09_e_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_31_09_e_26","text":"When do you think she'll come to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_09_e_27","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_31_09_e_27","text":"I've given her