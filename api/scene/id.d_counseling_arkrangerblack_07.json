{"id":"d_counseling_arkrangerblack_07","cat":"counsel","group":{"id":"char5174","label":"Ark Ranger Black"},"label":"Advising Ark Ranger Black: 07","stage":null,"prev":"d_counseling_arkrangerblack_06","next":"d_counseling_arkrangerblack_08","speakers":{"arkrangerblack":"Ark Ranger Black"},"icons":{"arkrangerblack":"si_c570_00_s"},"lines":[{"id":"d_counseling_arkrangerblack_07_1","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_1","text":"Ever since I became an Ark Ranger, kids have really taken a liking to me.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["arkrangerblack"],"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_2","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_2","text":"They used to be afraid of me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_3","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_3","text":"but now they come up to me first and even ask for my autograph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arkrangerblack_07_4","text":"That must be nice.","jump":"d_counseling_arkrangerblack_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_arkrangerblack_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arkrangerblack_07_5","text":"They must've been scared.","jump":"d_counseling_arkrangerblack_07_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_arkrangerblack_07_6","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_6","text":"Yeah, it feels like all my hard work is finally paying off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_7","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_7","text":"Whenever I meet kids, it strengthens my resolve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_8","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_8","text":"It makes me want to protect them, no matter what.","jump":"d_counseling_arkrangerblack_07_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_9","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_9","text":"I guess my face doesn't exactly come across as gentle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_10","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_10","text":"Still, I'm grateful they come up to me now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_07_11","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_07_11","text":"Seeing their smiles gives me strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"imag