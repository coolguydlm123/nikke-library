{"id":"d_counseling_nayuta_15","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 15","stage":null,"prev":"d_counseling_nayuta_14","next":"d_counseling_nayuta_16","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_15_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_1","text":"I once partook of a spirit distilled by Young Lady Scarlet herself.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_15_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_2","text":"When I praised its flavor,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_3","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_3","text":"she avouched that only those seasoned in drink might craft such excellent liquors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_4","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_4","text":"Pray, what sayest thou to this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_15_5","text":"Sounds about right.","jump":"d_counseling_nayuta_15_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_15_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_15_6","text":"Sounds like an excuse a drunkard would say.","jump":"d_counseling_nayuta_15_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_15_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_7","text":"Methinks","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_8","text":"'tis but a flimsy pretext for unbridled overindulgence,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_9","text":"and verily, such copious drinking under so specious a guise doth meet with mine disfavor.","jump":"d_counseling_nayuta_15_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_10","text":"Ha! So thou perceivest it thus as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_11","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_11","text":"I, too, do deem it but an excuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_12","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_12","text":"How slyly hath she spake...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_13","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_15_13","text":"Perchance that very slyness doth make the draught all the richer.","jump":"d_counseling_nayuta_15_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_15_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_15_14","text":"Nayuta tells me about the liquor Scarlet once brewed.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}