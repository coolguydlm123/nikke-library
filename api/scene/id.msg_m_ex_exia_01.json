age:m_ex_exia_01_26","text":"Nice.","jump":null},{"id":"m_ex_exia_01_27","type":"Speech","speaker":"exia","key":"Locale_SuddenMessage:m_ex_exia_01_27","text":"Let me know your ID.","jump":null},{"id":"m_ex_exia_01_28","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_exia_01_28","text":"Boiled Egg","jump":"m_ex_exia_01_30"},{"id":"m_ex_exia_01_29","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_exia_01_29","text":"Firepower Energizer","jump":"m_ex_exia_01_30"},{"id":"m_ex_exia_01_30","type":"Speech","speaker":"exia","key":"Locale_SuddenMessage:m_ex_exia_01_30","text":"Okay, I have added you.","jump":null},{"id":"m_ex_exia_01_31","type":"Speech","speaker":"exia","key":"Locale_SuddenMessage:m_ex_exia_01_31","text":"Can you log in now?","jump":null},{"id":"m_ex_exia_01_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_exia_01_32","text":"Sure.","jump":null},{"id":"m_ex_exia_01_33","type":"Speech","speaker":"exia","key":"Locale_SuddenMessage:m_ex_exia_01_33","text":"Then let's start.","jump":null},{"id":"m_ex_exia_01_34","type":"Speech","speaker":"exia","key":"Locale_SuddenMessage:m_ex_exia_01_34","text":"Just sit back and relax,","jump":null},{"id":"m_ex_exia_01_35","type":"Speech","speaker":"exia","key":"Locale_SuddenMessage:m_ex_exia_01_35","text":"I will take you to the end.","jump":null}],"chat":true}