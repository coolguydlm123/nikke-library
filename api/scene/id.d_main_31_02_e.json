13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_02_e_13","text":"Such effusive praise! You don't have to be so nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_02_e_14","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_02_e_14","text":"There are some caveats, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_02_e_15","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_02_e_15","text":"The squirt and the squad leader are competent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_02_e_16","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_02_e_16","text":"I can't say the same about you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_02_e_17","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_02_e_17","text":"It's not a major issue for now, since the skill gap isn't too significant,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_02_e_18","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_02_e_18","text":"but as those two grow stronger, both of you will only end up dragging them down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_02_e_19","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_02_e_19","text":"It's not that you haven't grown. You just haven't improved enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgAr