o:d_main_09af_05_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_30","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_30","text":"Ah, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_31","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_31","text":"It seems I was killed for hacking the Central Government database.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_32","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_33","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_33","text":"This may take a while to explain...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_09af_05_34","text":"Everyone pulls out their cellphones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_35","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_35","text":"I see you all know what you're doing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_36","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_36","text":"We're not too far off from telepathic communication!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_37","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_37","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_38","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_09af_05_38","text":"Rapi...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_39","text":"When did you...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_40","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_40","text":"... I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_41","text":"All right then, talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_42","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_42","text":"A lot of the information about the Heretics reads more like urban legend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_43","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_43","text":"However!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_44","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_44","text":"There was one piece of factual information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_45","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_45","text":"I tell you what, I had a heck of a time. From Royal Road to the Outer Rim. It seemed every single place I went had been explored already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_46","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_46","text":"The Outer Rim is particularly unwelcoming to Nikkes, except for the Exotic squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_47","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_47","text":"The moment I set foot in there, I spilled my Splendamin stew all over the place and almost soaked all my notes. I didn't let that deter me, no sir! I was hot on the case!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_48","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_48","text":"Would you PLEASE get to the point?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_49","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_50","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_50","text":"There's no information on exact dates, but there are squads which have survived encounters with the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_51","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_51","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_52","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_52","text":"They nearly won as well. If we contact them, I feel we might glean some meaningful information from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_53","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_09af_05_53","text":"Who are they? The people that survived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_54","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_54","text":"Absolute and Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_55","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_55","text":"It was their first, and last, joint operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_56","text":"Elysion and Missilis's strongest squads...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_57","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_09af_05_57","text":"Should we go talk to them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_58","text":"It's not that simple. Both squads are strictly managed by each company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_59","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_59","text":"We can't just waltz up and get some face time with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_60","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_09af_05_60","text":"But we're the Commando Unit. Won't they make an exception?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_61","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_61","text":"Commander. I have something to report relating to this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_62","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_62","text":"Regarding our operation at the munitions factory, things wouldn't have turned out this way if we had been assisted by the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_63","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_63","text":"Although we are the Commando squad, our capabilities are clearly limited without the help of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_64","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_09af_05_64","text":"Are you suggesting we get backup?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_65","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_65","text":"That's right. I'm hoping you can work together with Deputy Chief Andersen or the CEO of Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_66","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_05_66","text":"If we had their help, everything would have been smooth sailing after learning about Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_67","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_09af_05_67","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_68","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_09af_05_68","text":"How does everyone feel about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_69","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_69","text":"Honestly, even just having an operator would make things run a lot smoother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_70","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_70","text":"Most of all, I believe that the quality of the intel itself will play a vital role.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_71","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_09af_05_71","text":"We can't continue asking Exia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_72","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_72","text":"Yes, I am indeed quite busy at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_73","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_73","text":"Most importantly of all, there's nothing we can do about that sack of monkey brains.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_74","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_74","text":"Do you mean Syuen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_05_75","text":"... How did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_76","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_76","text":"There is only one individual in the Ark deserving of such a nickname.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_77"