shown":null,"affinity":null},{"id":"d_main_09af_05_7","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_7","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_8","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_8","text":"What's wrong? You look like you just saw a ghost!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_9","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_9","text":"Novel, what on earth is going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_10","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_10","text":"I solved the code you sent me, but we came here to understand the meaning behind the message.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_11","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_11","text":"Code?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_12","type":"Speech","speaker":"exia","key":"Locale_MainScenario:d_main_09af_05_12","text":"I sent a code to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_13","type":"Speech","speaker":"novel","key":"Locale_MainScenario:d_main_09af_05_13","text":"Yes, you did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_05_14","type":"Speech","speaker":"exia"