{"id":"event_enterheaven_03_e","cat":"event","group":{"id":"ev40104","label":"ENTER HEAVEN"},"label":"Elysion Harper: B","stage":null,"prev":"event_enterheaven_03_s","next":"event_enterheaven_intermission_01","speakers":{"eh_n":"E.H.","elysionharper":"Elysion Harper","littlegirl2":"Little Girl","littleboy2":"Little Boy"},"icons":{"eh_n":"si_c113_00_s","elysionharper":"si_c940_00_s","littlegirl2":"si_c999_00_s","littleboy2":"si_c999_00_s"},"lines":[{"id":"event_enterheaven_03_e_1","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_1","text":"Do you know what my name used to be?","jump":null,"exit":false,"enter":null,"bg":"RuinTechIndoor","bgArt":"ruintechindoor","image":null,"bgm":"bgm_chapter37_field_swarmnest","movie":null,"shown":["eh_n"],"affinity":null},{"id":"event_enterheaven_03_e_2","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_2","text":"I've been getting that question a lot today...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_3","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_3","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_4","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_4","text":"I have no idea.","jump":"event_enterheaven_03_e_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_5","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_5","text":"I think I heard it was... Elysion Harper.","jump":"event_enterheaven_03_e_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_6","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_6","text":"Hmm... I guess that shouldn't be a surprise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_7","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_7","text":"When I decided to abandon my real name, I chose E.H. as shorthand for \"enter heaven,\" the meaning behind Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_8","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_8","text":"But before that, my name was Elysion Harper.","jump":"event_enterheaven_03_e_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_9","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_9","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_10","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_10","text":"Elysion Harper... That was my name until I chose to cast it aside.","jump":"event_enterheaven_03_e_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_11","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_11","text":"Elysion, as in... the company?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_12","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_12","text":"Yes. That Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_13","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_13","text":"It was a name that came with a lot of weight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_14","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_14","text":"Having that name meant I was the next CEO. In other words, I was the heir to Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_15","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_15","text":"The heir...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_16","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_16","text":"That would mean that you and Ingrid are...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_17","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_17","text":"Half-sisters. We share the same mother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_18","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_18","text":"I'm the younger one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_19","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_19","text":"Our mother was the former CEO of Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_20","text":"Ah, that must be why Ingrid said she wasn't fit to judge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_21","text":"You're... family.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_22","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_22","text":"... Yeah, I guess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_23","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_23","text":"Honestly, I didn't realize she still thought that way...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_24","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_24","text":"What kind of company do you think Elysion is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_25","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_25","text":"An arms manufacturer strangely obsessed with tactics.","jump":"event_enterheaven_03_e_27","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_26","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_26","text":"A company strangely obsessed with uniforms.","jump":"event_enterheaven_03_e_30","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_27","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_27","text":"Tactics... Yeah, Ingrid does like that word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_28","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_28","text":"Anyway, you're right. It's an arms manufacturer that focuses on tactical excellence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_29","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_29","text":"But that wasn't always the company's top priority.","jump":"event_enterheaven_03_e_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_30","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_30","text":"I... can't say I've ever heard it described like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_31","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_31","text":"Now that I think about it, though, you might be right. A lot of Elysion Nikkes work in public service.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_32","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_32","text":"At any rate, that wasn't ever the company's top priority.","jump":"event_enterheaven_03_e_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_33","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_33","text":"In the past, Elysion pursued only one thing: power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_34","text":"Power?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_35","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_35","text":"Yeah. More precisely, the power of humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_36","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_36","text":"When the Raptures attacked, humans abandoned the surface and fled to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_37","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_37","text":"My mother believed that, in order to avoid extinction,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_38","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_38","text":"only the strong must survive, so that humanity could grow stronger and evolve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_39","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_39","text":"That's what she used to say, at least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_40","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_40","text":"That sounds similar to Elysion's current philosophy, but also a bit different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_41","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_41","text":"That's right. Ingrid believes humanity must use technology to defeat the Raptures,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_42","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_42","text":"but she's not so fixated on the sole pursuit of strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_43","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_43","text":"Mother was different. She pursued strength to the point of obsession.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_44","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_44","text":"That's why she wanted the strongest of her children to be her successor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_45","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_45","text":"Ingrid and I were constantly tested and compared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_46","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_46","text":"I came out on top, which is how I became the heir,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_47","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_47","text":"and the reason I was given the name of Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_48","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_48","text":"If it weren't for a certain incident, I would've inherited Elysion as planned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_49","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_49","text":"What incident?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_50","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_50","text":"Did you know that Elysion built the Outer Rim barrier?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_51","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_03_e_51","text":"What...? No, I had no idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_52","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_52","text":"Of course, it was the Central Government's proposal that initiated the process, but Elysion spearheaded the construction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_53","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_53","text":"Mother had long believed that the weak were meant to be culled,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_54","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_54","text":"and felt that garbage should be kept separate from human habitats,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_55","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_55","text":"so she naturally welcomed the proposal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_56","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_56","text":"She knew people were living there in secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_03_e_57","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_03_e_57","tex