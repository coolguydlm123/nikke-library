{"id":"d_nikke_RedHood_03","cat":"bond","group":{"id":"char5101","label":"Red Hood"},"label":"Change The World","stage":null,"prev":"d_nikke_RedHood_02","next":"d_nikke_RedHood_04","speakers":{"redhood":"Red Hood","anis":"Anis","neon":"Neon","Self":"Commander"},"icons":{"redhood":"si_c470_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_nikke_RedHood_03_1","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_1","text":"During the 1st Rapture Invasion, the humans were completely outgunned.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":"none","movie":null,"shown":["redhood","anis","neon"],"affinity":null},{"id":"d_nikke_RedHood_03_2","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_2","text":"They were utterly defenseless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_3","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_3","text":"They poured all their manpower and resources into the war, but didn't manage to score even a single victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_4","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_4","text":"It was a true age of despair, in every sense of the word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_5","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_5","text":"But then,","jump":null,"exit":false,"enter":null,"bg":"Desert_02_n","bgArt":"desert_02_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_6","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_6","text":"out of that terrible anguish, came a savior, or saviors, rather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_7","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_8","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_9","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_9","text":"Before our involvement, Raptures were regarded as an unstoppable force, something you couldn't possibly fend off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_10","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_10","text":"Everyone spent their days running, always running. They gave up all notion of fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_11","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_11","text":"But when we appeared, the tide began to turn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_12","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_12","text":"We started winning against the Raptures. Defeating an enemy that had once seemed invincible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_13","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_13","text":"Can you imagine how the people reacted to us then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_14","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_14","text":"They probably lost their minds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_15","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_15","text":"Completely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_16","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_16","text":"They showered us with fancy title: the Goddess of Victory, mankind's last hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_17","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_17","text":"Every time we strode into battle, victory was assured. In totality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_18","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_18","text":"Upon our return, there were always hundreds and thousands of people lining the street to welcome us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_19","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_19","text":"Sumptuous banquets, bouquets of flowers, celebratory music,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_20","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_20","text":"heartfelt fan letters, excited handshakes, tender embraces,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_21","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_21","text":"and tearful confessions of thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_22","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_22","text":"They all thanked us for fighting on humanity's behalf.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_23","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_24","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_24","text":"That really felt nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_25","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_25","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_26","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_26","text":"there was only a handful of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_27","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_27","text":"No matter how strong each of you was, there was no way a few Nikkes could turn the entire war around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_28","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_28","text":"Precisely. It didn't matter how impressive we were on the battlefield; there was no way we could wipe out all the Raptures in the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_29","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_29","text":"But all the same, our ability to beat the Raptures reinstilled hope amongst the United Forces of Humanity, and gave them the courage to fight once again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_30","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_30","text":"They spared no expense investing in weapons designed to terminate Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_31","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_31","text":"They braced themselves for a deadly confrontation with their mortal enemy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_32","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_32","text":"A world that had been on the brink of giving up was now standing up and reigniting its struggle against this deadly foe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_33","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_33","text":"Yes, there were too few of us,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_34","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_34","text":"and yes, it was unrealistic to expect to serve a role beyond that of an icon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_35","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_35","text":"But that was enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_36","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_36","text":"As long as we lived, and as long as we were still winning,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_37","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_37","text":"the people in this world would have the strength to fight another day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_38","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_38","text":"That's why we were called the Goddess of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_39","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_39","text":"You changed the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_40","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_40","text":"Oooh, that's a good line. I'll have to remember that one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_41","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_41","text":"It must have been very hard for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_42","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_43","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_43","text":"It was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_44","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_44","text":"Because we had to win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_45","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_45","text":"Failure was not an option.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_46","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_46","text":"Not under any circumstance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_47","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_47","text":"So we fought with everything we had.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_48","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_48","text":"But even then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_49","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_49","text":"I say you succeeded. You saved mankind, and the entire world, from the brink of destruction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_50","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_50","text":"... Yeah. Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapunzel_o","dorothy","hongryeon_o","liliweiss","snowwhite_o"],"affinity":null},{"id":"d_nikke_RedHood_03_51","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_51","text":"Ever since I became a Nikke, fighting is all I've ever known.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_52","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_52","text":"It's the same story with the others as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_53","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_53","text":"We had to kiss our hobbies goodbye. Assembling models, going for a sunlit stroll with a parasol, reading, going fishing, listening to music...they all became things of the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_54","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_54","text":"We fought for humanity with everything we had, of that there is no doubt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_55","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_55","text":"It was the only thing that occupied our time. It consumed us, and we all believed we were doing the right thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_56","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_56","text":"History has proven that we were correct in feeling that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_57","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_57","text":"So...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_58","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_58","text":"I suppose we were happy then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_59","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_59","text":"I went from being a backstreet punk to an honorable warrior who fought for the masses. I met all sorts of great people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_60","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_60","text":"Anyway, we were eventually assigned to take part in a defensive operation for the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_61","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_61","text":"... I only participated a bit in the initial stage, however, due to personal reasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_62","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_62","text":"Word is that the Ark is safe. Is that true?","jump":null,"exit":false,"enter":null,"bg":"Desert_02_n","bgArt":"desert_02_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_63","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_63","text":"Tell me more about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_64","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_03_65","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_03_65","text":"The Ark? Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}