{"id":"event_arkranger2_01_e","cat":"event","group":{"id":"ev40113","label":"ARK RANGER · Part 2"},"label":"Heroes Needed: B","stage":null,"prev":"event_arkranger2_01_s","next":"event_arkranger2_02_s","speakers":{"rapi_red":"Rapi","neon_v_w":"Neon","anis_i_w":"Anis"},"icons":{"rapi_red":"si_c016_00_s","neon_v_w":"si_c018_00_s","anis_i_w":"si_c017_00_s"},"lines":[{"id":"event_arkranger2_01_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_1","text":"Up on the surface.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["rapi_red","neon_v_w","anis_i_w"],"affinity":null},{"id":"event_arkranger2_01_e_2","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_2","text":"Is that okay with you, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_3","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_3","text":"It seems our rendezvous with Eden keeps getting pushed back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_4","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_4","text":"As much as I'd like to hurry to them, we can't just ignore this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_5","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_01_e_5","text":"Ingrid is the one who reached out, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_6","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_6","text":"Yes, and if it's coming straight from Ingrid, it's likely not something trivial.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_7","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_01_e_7","text":"Hmm... I wonder what it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_8","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_8","text":"She said they suddenly lost contact with one of the surface recon teams, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_9","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_9","text":"And then the team sent to find them went missing, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_10","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_10","text":"Then the next one, and the one after that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_11","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_11","text":"Right. She said it wasn't just that one area, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_12","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_12","text":"Meaning the same thing is happening all over the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_13","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_13","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_14","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_14","text":"She said there were some recent developments, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_15","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_15","text":"... Apparently, they're now able to search the place where the first team went missing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_16","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_16","text":"Wait, so at first they couldn't search the place, but now they suddenly can?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_17","text":"Yeah. It's certainly suspicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_18","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_01_e_18","text":"What's going on...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_19","text":"According to Ingrid, they found deceased Nikkes and inoperative Raptures in the area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_20","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_20","text":"But there were no signs of a struggle, and neither the Nikkes nor the Raptures showed any external injuries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_21","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_21","text":"... That makes no sense. Were they attacked by ghosts or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_22","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_22","text":"There's no such thing as ghosts, Anis. Probably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_23","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_23","text":"Something about this isn't normal. We should go check it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_24","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_24","text":"One of the affected areas happens to be on the way to Eden. Let's go check it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_25","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_25","text":"Why us, though? There are plenty of others who could handle this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_26","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_26","text":"Matis and Absolute, for example.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_27","text":"Absolute hasn't returned from the north yet. It seems their mission is taking longer than expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_28","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_28","text":"Meanwhile, Matis is on defense duty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_29","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_29","text":"There have been a lot of incidents in the Ark lately, and the public is shaken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_30","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_30","text":"Matis needs to show the people that they're protecting the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_31","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_31","text":"There are other squads, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_32","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_32","text":"Considering the severity and risk of this assignment, they must've decided we're the only ones for the job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_33","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_33","text":"Plus, we're already on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_34","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_34","text":"Come to think of it, there aren't really that many squads that specialize in combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_35","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_35","text":"That's true. Up until now, there was no need for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_36","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_36","text":"Raptures kept away from the Ark, and humanity had no intention of leaving it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_37","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_37","text":"Focusing on internal stability was the main priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_38","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_38","text":"Now, though...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_39","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_39","text":"With a full-scale war on the horizon, it's essential to have squads specifically for combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_40","text":"A squad with a bit of showmanship wouldn't hurt, either, to help boost morale inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_41","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_01_e_41","text":"Well then, I guess we'll have to fight with a little more flair from now on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_42","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_01_e_42","text":"If we get any flashier than we already are, we're gonna blind whoever sees us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_43","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_43","text":"... Are we considered part of the Ark's military forces?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_44","text":"Honestly, it's a bit ambiguous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_45","text":"It may be odd for me to be the one to say this, but we hold significant influence over both the Ark and the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_46","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_46","text":"Realistically, it would be difficult for us to exert any greater influence than we already do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_47","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_47","text":"All of the Big Three are working to develop next-generation combat squads,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_48","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_48","text":"but have yet to find much success.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_49","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_49","text":"Creating a squad that excels at combat while also serving as a public symbol is no easy endeavor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_50","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_51","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_e_51","text":"In other words, what we need is heroes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_52","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_52","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_e_53","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_01_e_53","text":"The Ark needs more heroes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}