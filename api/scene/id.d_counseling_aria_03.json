{"id":"d_counseling_aria_03","cat":"counsel","group":{"id":"char5070","label":"Aria"},"label":"Advising Aria: 03","stage":null,"prev":"d_counseling_aria_02","next":"d_counseling_aria_04","speakers":{"aria":"Aria"},"icons":{"aria":"si_c432_00_s"},"lines":[{"id":"d_counseling_aria_03_1","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_03_1","text":"If you have to choose between wealth and fame,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["aria"],"affinity":"_0"},{"id":"d_counseling_aria_03_2","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_03_2","text":"which one will you pick?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_03_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_03_3","text":"Fame.","jump":"d_counseling_aria_03_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_aria_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_03_4","text":"I don't need either of them.","jump":"d_counseling_aria_03_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_aria_03_5","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_03_5","text":"Oh, really? It seems that fame is of great importance to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_03_6","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_03_6","text":"I didn't think fame would mean much to you since you are always seen talking to numerous Nikkes.","jump":null,"exit":fa