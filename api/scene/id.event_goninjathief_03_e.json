,"type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_60","text":"the one upon whom we shall carry out justice is a pickpocket, who stole a man's bag the other day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_61","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_61","text":"It was said to contain many precious things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_62","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_62","text":"We intend to steal it back and return it to its rightful owner, so compose your calling card with that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_63","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_63","text":"Now then, allow me to show you the ones I have used in the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_64","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_64","text":"*Slide*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_65","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_65","text":"\"Tonight, we Phantom Thieves will retrieve the real item which has caused the rightful owner so much distress.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_66","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_66","text":"\"Thieves of Justice\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_67","type":"Speech","speaker":"delta_n","key":"Locale_SubScenario:event_goninjathief_03_e_67","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_68","type":"Speech","speaker":"delta_n","key":"Locale_SubScenario:event_goninjathief_03_e_68","text":"This calling card carries significant meaning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_69","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_69","text":"The more refined one's literary skill, the more elegant a calling card one may compose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_70","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_70","text":"Now then, I look forward to seeing what kind of calling card you will pen—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_71","type":"Speech","speaker":"delta_n","key":"Locale_SubScenario:event_goninjathief_03_e_71","text":"I have much to prepare, so I shall take my leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_72","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_72","text":"*Swish!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_73","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_73","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_74","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_74","text":"It seems I'm not merely imagining that my words are being cut off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_75","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_75","text":"To listen to another's words in their entirety is, too, a virtue a phantom thief ought to possess!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_76","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_76","text":"You always cut off my—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_77","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_77","text":"Next time I see her, I shall give her a stern talking-to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_78","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_78","text":"In any case, you two have done well today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_79","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_03_e_79","text":"When the Thieves of Justice next mobilize, let us meet then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_80","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_goninjathief_03_e_80","text":"Today was really wonderful!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_81","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_goninjathief_03_e_81","text":"I'll see you all next time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_82","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_82","text":"*Clatter*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_83","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_83","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_84","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_84","text":"No one listens to me anymore...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_85","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_85","text":"They don't even bother using the door...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_03_e_86","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_03_e_86","text":"I feel so lonely...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}