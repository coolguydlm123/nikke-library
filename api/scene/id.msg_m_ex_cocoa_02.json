{"id":"msg_m_ex_cocoa_02","cat":"messenger","group":{"id":"room_cocoa","label":"Cocoa · Nikke"},"label":"2. Master,","stage":null,"prev":"msg_m_ex_cocoa_01","next":"msg_m_ex_cocoa_03","speakers":{"cocoa":"Cocoa"},"icons":{"cocoa":"si_c311_00_s"},"lines":[{"id":"m_ex_cocoa_02_1","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_1","text":"Master,","jump":null},{"id":"m_ex_cocoa_02_2","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_2","text":"what are you doing?","jump":null},{"id":"m_ex_cocoa_02_3","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_3","text":"Are you busy?","jump":null},{"id":"m_ex_cocoa_02_4","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_4","text":"Can we talk?","jump":null},{"id":"m_ex_cocoa_02_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_5","text":"Sure, what's up?","jump":null},{"id":"m_ex_cocoa_02_6","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_6","text":"Would you like to play the Cipher Game with me?","jump":null},{"id":"m_ex_cocoa_02_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_7","text":"Cipher Game?","jump":null},{"id":"m_ex_cocoa_02_8","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_8","text":"Yeah.","jump":null},{"id":"m_ex_cocoa_02_9","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_9","text":"Let's begin!","jump":null},{"id":"m_ex_cocoa_02_10","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_10","text":"You have to imagine that our communications are under the surveillance of","jump":null},{"id":"m_ex_cocoa_02_11","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_11","text":"the Central Government.","jump":null},{"id":"m_ex_cocoa_02_12","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_12","text":"So we have to use a secret language to communicate.","jump":null},{"id":"m_ex_cocoa_02_13","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_13","text":"I'll tell you how to play. Pay attention, now!","jump":null},{"id":"m_ex_cocoa_02_14","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_14","text":"Cocoa = Acoco","jump":null},{"id":"m_ex_cocoa_02_15","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_15","text":"Customer = Crow","jump":null},{"id":"m_ex_cocoa_02_16","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_16","text":"The Cafe = Nest","jump":null},{"id":"m_ex_cocoa_02_17","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_17","text":"Ketchup = Bird dropping","jump":null},{"id":"m_ex_cocoa_02_18","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_18","text":"That's all for now.","jump":null},{"id":"m_ex_cocoa_02_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_19","text":"I'll try to remember.","jump":null},{"id":"m_ex_cocoa_02_20","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_20","text":"Okay.","jump":null},{"id":"m_ex_cocoa_02_21","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_21","text":"Then...","jump":null},{"id":"m_ex_cocoa_02_22","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_22","text":"Let's begin.","jump":null},{"id":"m_ex_cocoa_02_23","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_23","text":"There are 2 crows in the nest now.","jump":null},{"id":"m_ex_cocoa_02_24","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_24","text":"When they were ordering omelet rice,","jump":null},{"id":"m_ex_cocoa_02_25","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_25","text":"they wanted me to use bird droppings to draw one of those Transmorpher robots.","jump":null},{"id":"m_ex_cocoa_02_26","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_26","text":"But Acoco don't know the first thing about Transmorphers.","jump":null},{"id":"m_ex_cocoa_02_27","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_27","text":"I was hoping you could give me a few pointers.","jump":null},{"id":"m_ex_cocoa_02_28","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_28","text":"Model it after Exia.","jump":"m_ex_cocoa_02_30"},{"id":"m_ex_cocoa_02_29","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_29","text":"Model it after Laplace.","jump":"m_ex_cocoa_02_32"},{"id":"m_ex_cocoa_02_30","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_30","text":"Exia isn't a robot.","jump":null},{"id":"m_ex_cocoa_02_31","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_31","text":"She's a Nikke.","jump":"m_ex_cocoa_02_34"},{"id":"m_ex_cocoa_02_32","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_32","text":"Laplace isn't a Transmorpher.","jump":null},{"id":"m_ex_cocoa_02_33","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_33","text":"She's just a Nikke who can alter her appearance.","jump":"m_ex_cocoa_02_34"},{"id":"m_ex_cocoa_02_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_34","text":"Sorry, I was just kidding.","jump":null},{"id":"m_ex_cocoa_02_35","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_35","text":"...","jump":null},{"id":"m_ex_cocoa_02_36","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_36","text":"It seems you don't know anything either.","jump":null},{"id":"m_ex_cocoa_02_37","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_37","text":"I'll just have to improvise.","jump":null},{"id":"m_ex_cocoa_02_38","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_38","text":"Cocoa doesn't respond for a while.","jump":null},{"id":"m_ex_cocoa_02_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_39","text":"What did you end up drawing, Acoco?","jump":null},{"id":"m_ex_cocoa_02_40","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_40","text":"Your face.","jump":null},{"id":"m_ex_cocoa_02_41","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_41","text":"With a robot body.","jump":null},{"id":"m_ex_cocoa_02_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_42","text":"!!","jump":null},{"id":"m_ex_cocoa_02_43","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_43","text":"I just don't get Transmorphers,","jump":null},{"id":"m_ex_cocoa_02_44","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_44","text":"so I decided to draw my favorite face.","jump":null},{"id":"m_ex_cocoa_02_45","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_45","text":"The crows said they liked it, at any rate.","jump":null},{"id":"m_ex_cocoa_02_46","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_46","text":"In fact, they want another one.","jump":null},{"id":"m_ex_cocoa_02_47","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_47","text":"Pardon me.","jump":null},{"id":"m_ex_cocoa_02_48","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_48","text":"I'd love to keep playing the Cipher Game with you,","jump":null},{"id":"m_ex_cocoa_02_49","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_49","text":"but I've got to go squirt out some more bird droppings for them.","jump":null},{"id":"m_ex_cocoa_02_50","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_50","text":"I'm honored to be chosen as your muse.","jump":"m_ex_cocoa_02_52"},{"id":"m_ex_cocoa_02_51","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_51","text":"I never gave you permission to use my likeness...","jump":"m_ex_cocoa_02_54"},{"id":"m_ex_cocoa_02_52","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_52","text":"That's great!","jump":null},{"id":"m_ex_cocoa_02_53","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_53","text":"I'm having a great time drawing you.","jump":"m_ex_cocoa_02_57"},{"id":"m_ex_cocoa_02_54","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_54","text":"Huh?","jump":null},{"id":"m_ex_cocoa_02_55","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_55","text":"What are you talking about?","jump":null},{"id":"m_ex_cocoa_02_56","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_cocoa_02_56","text":"Nothing...","jump":"m_ex_cocoa_02_57"},{"id":"m_ex_cocoa_02_57","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_57","text":"Well, gotta run.","jump":null},{"id":"m_ex_cocoa_02_58","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_58","text":"Cipher Game,","jump":null},{"id":"m_ex_cocoa_02_59","type":"Speech","speaker":"cocoa","key":"Locale_SuddenMessage:m_ex_cocoa_02_59","text":"over.","jump":null}],"chat":true}