{"id":"d_nikke_noah_01","cat":"bond","group":{"id":"char5043","label":"Noah"},"label":"Kidnapped by the Surface's Strongest","stage":null,"prev":null,"next":"d_nikke_noah_02","speakers":{"Monologue":"Monologue","noah":"Noah","Self":"Commander","Narration":"Narration"},"icons":{"noah":"si_c232_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_nikke_noah_01_1","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_01_1","text":"Another fresh, cool morning.\nThe same old road going to the office.","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_2","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_01_2","text":"I grab and turn the doorknob of the Commander's Room...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_3","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_3","text":"Oh, the Imposter Commander. Long time no see!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["noah"],"affinity":null},{"id":"d_nikke_noah_01_4","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_4","text":"You still look like the weakest guy in the world!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_5","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_01_5","text":"... An annoying little imp is sitting on my desk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_6","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_6","text":"Why are you here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_7","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_7","text":"Oh, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_8","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_8","text":"The magnificent me, a pilgrim traveling on the surface...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_9","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_9","text":"... suddenly felt a sense of pity for you cowardly humans who hid underground...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_10","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_10","text":"Fine. I'll contact your Commander just to make sure...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_11","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_11","text":"No no no no no!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_12","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_12","text":"All right, all right! Let me get straight to the point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_13","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_13","text":"... Ahem. Well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_14","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_14","text":"I'm here because a reliable source told me something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_15","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_15","text":"They said that if Nikkes stay with you for some time...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_16","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_16","text":"will become incredibly powerful, even without a Parts Upgrade. It doesn't even matter which Nikke it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_17","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_01_17","text":"Who told you that?","jump":"d_nikke_noah_01_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_18","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_01_18","text":"The \"reliable source\" you mentioned, was it Maxwell?","jump":"d_nikke_noah_01_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_19","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_19","text":"That's none of your business.","jump":"d_nikke_noah_01_23","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_20","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_20","text":"... Oh, you already guessed it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_21","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_21","text":"Well, it's not my fault that you know, because you guessed it on your own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_22","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_22","text":"I promised I won't spill the beans. You didn't get the answer from me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_23","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_23","text":"Anyway, I'm asking you to make me stronger as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_24","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_24","text":"Oh, don't get me wrong. It's not a request.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_25","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_25","text":"It's an order, from the strong to the weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_26","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_26","text":"You have no right to refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_27","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_27","text":"You are already powerful enough, so why bother?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_28","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_28","text":"... Pfft. What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_29","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_29","text":"There's no such thing as \"powerful enough.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_30","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_30","text":"Those Raptures were just rolling balls at the beginning, but they upgrade themselves every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_31","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_31","text":"I'm a Pilgrim. I can't allow myself to become obsolete like you guys.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_32","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_32","text":"So, I'm going to kidnap you and bring you to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_33","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_33","text":"Then we'll see if I get stronger or not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_34","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_01_34","text":"You've completely lost your mind.","jump":"d_nikke_noah_01_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_35","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_01_35","text":"Sure. Let's see if it works.","jump":"d_nikke_noah_01_43","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_36","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_36","text":"Oh? Didn't you hear what I said? I said you have no right to refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_37","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_37","text":"Anyway, fine. You can resist as much as you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_38","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_38","text":"But you should know who you are talking to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_39","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_39","text":"Although we're all Pilgrims, we are different from those meek Pioneers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_40","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_40","text":"We won't hesitate to hurt anyone. Not even humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_41","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_41","text":"You don't need to threaten me. I'm willing to help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_42","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_42","text":"What? Why the sudden change?","jump":"d_nikke_noah_01_46","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_43","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_43","text":"... Eh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_44","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_44","text":"Why are you so obedient?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_45","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_45","text":"Knowing you, I thought you would put up quite a fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_46","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_46","text":"That's because we adults have the responsibility to help you starry-eyed youngsters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_47","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_47","text":"... You gave in so easily, and you still call yourself an adult?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_48","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_48","text":"Anyways, as long as you come with me, it doesn't matter what you say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_49","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_49","text":"And since it's settled...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_50","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_01_50","text":"Noah lifts my body with ease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_51","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_51","text":"We're not wasting any time! Let's roll out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_52","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_52","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_53","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_53","text":"Pfft! Don't be afraid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_54","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_54","text":"You are with me, the Strongest Shield on the Surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_55","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_55","text":"The Raptures can't even touch you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_56","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_noah_01_56","text":"Thus begins day 0 of being kidnapped and brought to the surface.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03","bgArt":"cityforest_03","image":null,"bgm":"bgm_distress","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_57","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_57","text":"Let's start with collecting Parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["noah"],"affinity":null},{"id":"d_nikke_noah_01_58","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_58","text":"Why collect Parts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_59","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_59","text":"Why? Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_60","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_60","text":"If I want to improve my specifications quickly, isn't it wise to upgrade some Parts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_61","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_61","text":"But frankly, I still don't know how you will make me stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_62","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_62","text":"Aimlessly wandering around with you hasn't seemed to get me any results yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_63","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_63","text":"So, I decided to go for a big score. We just have to keep at it and stay patient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_64","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_64","text":"For example, I might find a Part that I can try out on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_65","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_65","text":"Maybe it'll blow you up! Or maybe not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_66","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_66","text":"Either way, I'll still get a Part. It's a win-win for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_67","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_01_67","text":"You wish.","jump":"d_nikke_noah_01_69","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_68","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_01_68","text":"Go for it.","jump":"d_nikke_noah_01_69","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_69","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_69","text":"Eh. Why do you sound like it's not your business?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_70","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_70","text":"You cant go home. Not before I become stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_71","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_71","text":"You and I are in the same boat, understand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_72","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_72","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_73","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_noah_01_73","text":"... Soon.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_74","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_74","text":"Yeah! A treasure trove!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["noah"],"affinity":null},{"id":"d_nikke_noah_01_75","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_75","text":"A treasure trove?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_76","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_76","text":"Oh. A major battle of the First Rapture Invasion happened here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_77","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_77","text":"So, there are dead Nikke bodies all over the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_78","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_78","text":"Just harvest the Parts that are still intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_79","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_79","text":"You're asking me to... harvest Nikke Parts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_80","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_80","text":"Yeah. Dismantle them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_81","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_81","text":"... What? Don't you know how?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_82","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_82","text":"Fair enough... It is quite difficult for humans to disassemble Nikkes with their bare hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_83","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_83","text":"That's not the problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_84","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_84","text":"No? Then what is the problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_85","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_85","text":"You're talking about damaging dead bodies. Even if you're trying to improve yourself, that's just not right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_86","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_86","text":"Oh... Well, Imposter, tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_87","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_87","text":"How can you become stronger while being so squeamish?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_88","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_88","text":"This is the surface. It's a jungle up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_89","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_89","text":"You either dismantle dead bodies and become stronger, or be hunted and killed by the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_90","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_90","text":"There is no third option.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_91","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_91","text":"In the world we live in, there's no room for morality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_92","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_92","text":"A weak man like you would be cut in half by a Rapture Blade in the blink of an eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_93","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_93","text":"Besides, there are lots of Parts scattered all over the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_94","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_94","text":"If we don't collect them now, they will just be picked up by other people, or even machines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_95","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_95","text":"Are you okay with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_96","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_noah_01_96","text":"*Ding*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_97","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_97","text":"What was that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_98","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_98","text":"Ah, see? Just like I said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_99","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_99","text":"Others are looking for the Parts here, and it's not just a few of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_100","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_100","text":"1 Tyrant, 5 Lords, and they are followed by some minions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_101","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_101","text":"Looks like they are planning to take over this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_102","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_102","text":"Even so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_103","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_01_103","text":"Noah brings out a pair of shields.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_104","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_104","text":"It won't take long to wipe them all out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_spot_counterattack","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_105","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_105","text":"You planned for this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_106","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_106","text":"Eh? No?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_107","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_107","text":"Just set the shields here and hold your ground until we defeat them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_108","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_108","text":"These shields may look small, but they're full of features.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_109","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_109","text":"One of them is the ultra-temperature energy beam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_110","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_110","text":"So, all we need is to build a strong defense...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_111","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_111","text":"Then we just count sheep and wait until the shields' energy beams melt them all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_112","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_112","text":"Instant win for us, you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_113","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_01_113","text":"That is such a crazy plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_114","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_114","text":"Yeah, exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_115","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_115","text":"I bet I'm the only one in the world who can do this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_116","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_116","text":"They don't call me \"The Strongest Shield on the Surface\" for nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_117","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_noah_01_117","text":"*Ka-chunk*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_118","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_01_118","text":"With a heavy sound, the two shields plant themselves on the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_119","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_119","text":"... Come get me, you scumbags.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_01_120","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_01_120","text":"You can't even scratch my shields no matter what you do. Tee-hee!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}