ll,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_7","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_7","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_8","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_8","text":"My god...","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_9","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_09_s_9","text":"Wow!!! The whole floor is covered in parts!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_10","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_09_s_10","text":"Check out all these emergency rations!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_11","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_09_s_11","text":"... But they're all empty. What's going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_12","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_12","text":"The Pilgrims have been here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_13","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_13","text":"I heard that they modify their weapons using Rapture parts. Looks like the stories were true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_14","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_14","text":"They may be resourceful, but that doesn't make them one of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_15","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_15","text":"As for me, I think we'll get more use out of what's on that table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_16","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_16","text":"Is that a map of the neighborhood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_17","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_17","text":"Yes. I think this was a spot they planned to come back to, so they left it behind. They even marked the next destination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_18","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_18","text":"You made a useful discovery for once.\nGood job, Viper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_19","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_19","text":"For once?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_20","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_20","text":"I'm always useful!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_21","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_22","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_22","text":"This map is just what we need. We can have a lot of fun with this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_23","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_23","text":"For example...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_24","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_24","text":"Oh, I don't know. Like punishing a certain goody two-shoes Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_25","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_25","text":"That could be arranged.\nI happen to have some information from a reliable source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_26","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_26","text":"Under these coordinates,\nthere lies a slumbering beast of tremendous size.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_27","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_27","text":"But, isn't it dangerous flying by the seat of our pants like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_28","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_28","text":"We were originally just going to kill some time up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_29","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_29","text":"That's your problem, Viper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_30","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_30","text":"You're clever, and quite resourceful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_31","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_31","text":"But you're too cautious. You're incapable of any impromptu decisions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_32","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_s_32","text":"You'll never make it into the history books by acting that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_s_33","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_09_s_33","text":"... Thanks for the advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}