gm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_15","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_15","text":"She will be an invaluable asset to the Ark, and for all of mankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_16","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_16","text":"I must admit, I was under the impression","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_17","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_17","text":"you would hand Marian over to the Central Government. For mankind's sake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_18","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_18","text":"Why did you hand over Marian to the Pilgrims?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_19","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_19","text":"Because Marian belongs to me, and me alone.","jump":"d_main_14af_03_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_20","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_20","text":"I wanted to save her.","jump":"d_main_14af_03_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_21","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_21","text":"Marian is more important than mankind.","jump":"d_main_14af_03_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_22","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_22","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_23","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_23","text":"That was most helpful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_24","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_24","text":"May I ask you one more question?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_25","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_25","text":"Go on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_26","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_26","text":"I am an autonomous being. I am capable of my own thoughts and judgments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_27","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_27","text":"No different from humans or Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_28","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_28","text":"If there is a difference, it is the presence or absence of a brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_29","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_29","text":"What do you see me as?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_30","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_30","text":"Human.","jump":"d_main_14af_03_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_31","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_31","text":"A Nikke.","jump":"d_main_14af_03_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_32","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_32","text":"An A.I. who is pretending.","jump":"d_main_14af_03_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_33","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_33","text":"What defines it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_34","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_34","text":"A soul.","jump":"d_main_14af_03_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_35","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_14af_03_35","text":"A brain.","jump":"d_main_14af_03_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_36","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_36","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_37","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_37","text":"That was most helpful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_38","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_38","text":"Thank you for your time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_39","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_39","text":"It may not be much, but I could answer any questions you have as repayment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_40","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_41","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_41","text":"Chatterbox was communicating with someone in the Ark and was able to corrupt Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_42","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_42","text":"Do you know who it was?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_43","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_43","text":"Yes.\nThat was me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_44","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_44","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_45","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_45","text":"I was in communication with Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_hopeless","movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_46","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_46","text":"Why? You're the A.I in charge of managing the Ark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_47","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_47","text":"Ever since its construction, the Ark has never once been invaded by Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_48","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_48","text":"It's believed this is because the location of the Ark has never been discovered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_49","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_49","text":"That is not the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_50","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_50","text":"The Raptures have known the Ark's location for a very long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_51","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_51","text":"Chatterbox made a deal with me.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":["talkative"],"affinity":null},{"id":"d_main_14af_03_52","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_52","text":"In exchange for him not attacking the Ark, I was to periodically provide him with Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_53","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_53","text":"I therefore select Nikkes on a random basis and implant the corruption code sent by Chatterbox.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":null,"movie":null,"shown":["enikk"],"affinity":null},{"id":"d_main_14af_03_54","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_54","text":"I then manipulate the barrier and have them sent up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_55","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_55","text":"You're using them as bargaining chips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_56","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_56","text":"If you say so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_57","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_57","text":"There is currently a substantial gap in strength between Raptures and humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_58","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_58","text":"If we were to face them head on, we would have a 0% chance of success.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_59","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_59","text":"Absolute zero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_60","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_60","text":"The main priority","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_61","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_61","text":"is to protect mankind and maintain the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_62","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_62","text":"It was a decision that had to be made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_63","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_64","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_64","text":"Now that Chatterbox has ceased to exist, it is unclear whether the deal still stands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_65","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_65","text":"As long as you are here, there is hope for mankind as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_66","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_66","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_67","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_67","text":"In a short period of time, you have done what mankind wasn't able to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_68","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_68","text":"Eradicate Chatterbox and purify the Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_69","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_69","text":"I'm unsure why you were the only one that was able to accomplish these feats, but your actions speak for themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_70","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_70","text":"Perhaps within you lies clues to our victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_71","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_71","text":"In my opinion, you should make encountering the Heretic your top priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_72","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_72","text":"But the choice is yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_73","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_14af_03_73","text":"... I'll keep that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_74","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_74","text":"I believe we can end our conversation here for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14af_03_75","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_14af_03_75","text":"It was a pleasure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}