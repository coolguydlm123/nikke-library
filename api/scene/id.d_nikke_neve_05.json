"id":"d_nikke_neve_05_78","type":"Speech","speaker":"neve","key":"Locale_NikkeEpisode:d_nikke_neve_05_78","text":"You're so warm, Burly Bear. I don't know if it's because of the costume, but you feel so soft.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neve_05_79","type":"Speech","speaker":"neve","key":"Locale_NikkeEpisode:d_nikke_neve_05_79","text":"When did you come up with this idea?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neve_05_80","type":"Speech","speaker":"neve","key":"Locale_NikkeEpisode:d_nikke_neve_05_80","text":"It really is... just like what I... imagined polar bears... w... would be like...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neve_05_81","type":"Speech","speaker":"neve","key":"Locale_NikkeEpisode:d_nikke_neve_05_81","text":"Next time I'm feeling sleepy... I... I'll be sure to find you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neve_05_82","type":"Speech","speaker":"neve","key":"Locale_NikkeEpisode:d_nikke_neve_05_82","text":"Zzzzz...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neve_05_83","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_neve_05_83","text":"Sweet dreams.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neve_05_84","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_neve_05_84","text":"Neve falls asleep in my arms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":nul