 my way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_90","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_90","text":"You understand, don't you? Never, ever harm Marian. You're to cherish her dearly and keep her safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_91","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_91","text":"Got it, I'll be careful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_92","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_92","text":"Mirror crackles with static and vanishes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_93","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_93","text":"Chatterbox looks down at the battered Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_94","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_94","text":"Just as he reaches out for her, a thunderous roar erupts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_95","text":"He lifts his head toward the source of the sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":n