e":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_18","text":"With a grotesque sound, the Queen's mouth opens.","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_06_3","bgArt":"eventscene_goddessfall_06_3","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_19","text":"A thin, threadlike red beam that's almost imperceptible to the eye","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_20","text":"shoots forth and slices across the giant Marian.","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_20_5","bgArt":"eventscene_goddessfall_20_5","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_21","text":"Moments later, her massive frame begins to split in two at the torso.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_22","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall2_04_e_22","text":"... Oh no...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_23","text":"The giant crumbles beneath the crushing force of the beam. Inside, Marian prepares one last strike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_24","text":"Light gathers at the cannons on her shoulders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_25","text":"Twin beams lance toward the Queen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_26","text":"who raises her hand and begins to absorb them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_27","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall2_04_e_27","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_28","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall2_04_e_28","text":"The Queen can... do this too...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_29","text":"A massive red beam erupts from the Queen's hand,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_30","text":"engulfing Marian in its light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_31","text":"She feels her body falling.","jump":null,"exit":false,"enter":null,"bg":"BrokenEden","bgArt":"brokeneden","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_32","text":"But her eyes can't open, and her body is completely battered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_33","text":"At that moment, she feels someone grab her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_34","text":"*Thud!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_35","text":"She feels herself land on the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_36","text":"With every last ounce of strength, Marian forces her eyes open.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["marian_q"],"affinity":null},{"id":"event_goddessfall2_04_e_37","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_37","text":"You cannot die here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["talkative"],"affinity":null},{"id":"event_goddessfall2_04_e_38","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall2_04_e_38","text":"... Chatterbox...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_39","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_39","text":"Your body must become the Queen's next vessel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_40","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_40","text":"You exist for that alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_41","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_41","text":"So...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_42","text":"*Crack!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_43","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall2_04_e_43","text":"Argh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_44","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_44","text":"Stop this pointless act,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_45","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_45","text":"and don't even think about pointing your gun at the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_46","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_46","text":"You exist only as a vessel for the Queen Gene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_47","text":"*Crack!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_48","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall2_04_e_48","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_49","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_49","text":"How I long to crush your skull, yet I must restrain myself lest the vessel break.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_50","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_e_50","text":"*Craaacck!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_51","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_goddessfall2_04_e_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_52","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_52","text":"Hm. Unconscious already? To think this is the Queen's vessel...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_53","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_53","text":"... Shall I remove her eyes, ears, and mouth,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_54","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_54","text":"just to be safe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_55","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_55","text":"Don't do that. What if you end up breaking her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mirror_r"],"affinity":null},{"id":"event_goddessfall2_04_e_56","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_56","text":"... Mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_57","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_57","text":"You followed my orders and retrieved Marian... well, \"safely,\" if we're being generous with that term.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_58","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_58","text":"Nicely done, anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_59","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_59","text":"Can she really become the Queen's new body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_60","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_60","text":"Of course, the Queen is old.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_61","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_61","text":"More importantly, she herself says she wants a new body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_62","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_62","text":"... I can't hear the Queen's voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_63","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_63","text":"There's nothing we can do about that. Only Heretics, or entities above that level, can hear her voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_64","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_64","text":"In any case, do not harm her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_65","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_65","text":"No one can guarantee what effect it might have on the vessel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_66","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_66","text":"So stick to the original plan and protect Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_67","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_67","text":"My goodness, I heard you even tried to eat her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_68","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_68","text":"That would have been a disaster. If the Queen found out, your head wouldn't be the only thing at risk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_69","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_69","text":"She might even exile you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_70","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_70","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_71","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_71","text":"Do you understand now how serious this is? I'll cover for you this time, but never do that again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_72","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_72","text":"You want the Queen's recognition... and to hear her voice, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_73","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_goddessfall2_04_e_73","text":"... Fine, I'll be careful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_74","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_74","text":"Yes, please make sure to do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_75","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_75","text":"Oh, now that I think about it, how about the Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_e_76","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_04_e_76","text":"Did you find it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"ima