},{"id":"event_lastkingdom1_prologue_32","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_prologue_32","text":"It doesn't seem to be mobile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_prologue_33","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_prologue_33","text":"It's most likely meant for decoration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_prologue_34","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_prologue_34","text":"Decadent? I don't think it's that fancy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_prologue_35","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_prologue_35","text":"Not decadent, Your Highness. It's a decoration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_prologue_36","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_prologue_36","text":"Ah, indeed. Well done, Chime. I was testing you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_prologue_37","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom1_prologue_37","text":"But of course. After all, I am your loyal subject.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom1_prologue_38","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom1_prologu