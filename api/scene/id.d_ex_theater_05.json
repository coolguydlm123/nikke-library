_theater_05_35","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_35","text":"I know who you are. You're a famous opera singer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_36","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_36","text":"I heard that a ticket to one of your shows costs an arm and a leg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_37","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_37","text":"And to think, here I was getting a sneak preview for free, hehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_38","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_38","text":"Must be my lucky day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_39","type":"Speech","speaker":"aria","key":"Locale_SuddenStory:d_ex_theater_05_39","text":"Did you really escape from the Rehabilitation Center?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_40","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_40","text":"I sure did. That's why I'm here before you today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_41","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_41","text":"But once I'm done sorting out my affairs, I'll head back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_42","type":"Speech","speaker":"aria","key":"Locale_SuddenStory:d_ex_theater_05_42","text":"You make it sound like you're heading back home after running errands...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_43","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_43","text":"They feed me and put a roof over my head, so it is kinda like my home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_44","type":"Speech","speaker":"aria","key":"Locale_SuddenStory:d_ex_theater_05_44","text":"Do they ever try and stop you from leaving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_45","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_45","text":"All the time. The guards are constantly blocking up my routes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_46","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_46","text":"I'm constantly creating new ones so that I can come out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_47","type":"Speech","speaker":"quency","key":"Locale_SuddenStory:d_ex_theater_05_47","text":"Like, for example, hiding in this theater while you were rehearsing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_theater_05_48","type":"Speech","speaker":"aria","key":"Locale_SuddenStory:d_e