riends later on.","jump":null},{"id":"m_ex_anchor_01_26","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_anchor_01_26","text":"They're nice and soft.","jump":null},{"id":"m_ex_anchor_01_27","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_anchor_01_27","text":"And squishy too.","jump":null},{"id":"m_ex_anchor_01_28","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_anchor_01_28","text":"Super cute.","jump":null},{"id":"m_ex_anchor_01_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_anchor_01_29","text":"Sounds great.","jump":null},{"id":"m_ex_anchor_01_30","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_anchor_01_30","text":"Well.","jump":null},{"id":"m_ex_anchor_01_31","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_anchor_01_31","text":"Helm is calling for me,","jump":null},{"id":"m_ex_anchor_01_32","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_anchor_01_32","text":"so I've got to go.","jump":null},{"id":"m_ex_anchor_01_33","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_anchor_01_33","text":"Bye.","jump":null}],"chat":true}