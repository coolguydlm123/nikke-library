_subquest_1313_s_11","type":"Speech","speaker":"noah","key":"Locale_SubScenario:m_subquest_1313_s_11","text":"That's right.","jump":null},{"id":"m_subquest_1313_s_12","type":"Speech","speaker":"noah","key":"Locale_SubScenario:m_subquest_1313_s_12","text":"It's gonna be a showdown, mano a mano.","jump":null},{"id":"m_subquest_1313_s_13","type":"Speech","speaker":"noah","key":"Locale_SubScenario:m_subquest_1313_s_13","text":"Can I come and watch?","jump":null},{"id":"m_subquest_1313_s_14","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_14","text":"Darling?","jump":null},{"id":"m_subquest_1313_s_15","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_15","text":"Do you need my help?","jump":null},{"id":"m_subquest_1313_s_16","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_16","text":"I could drop bricks down from the sky.","jump":null},{"id":"m_subquest_1313_s_17","type":"Speech","speaker":"harran","key":"Locale_SubScenario:m_subquest_1313_s_17","text":"You idiot! Do you want to kill Johan?","jump":null},{"id":"m_subquest_1313_s_18","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_18","text":"If that is what I must do to protect my love,","jump":null},{"id":"m_subquest_1313_s_19","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_19","text":"I will gladly accept his blood on my hands.","jump":null},{"id":"m_subquest_1313_s_20","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_20","text":"Bring your squad with you.","jump":null},{"id":"m_subquest_1313_s_21","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_21","text":"We're going to need as much manpower as we can get.","jump":null},{"id":"m_subquest_1313_s_22","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1313_s_22","text":"Where are we going?","jump":null},{"id":"m_subquest_1313_s_23","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_23","text":"I'll fill you in when you get here.","jump":null},{"id":"m_subquest_1313_s_24","type":"Speech","speaker":"harran","key":"Locale_SubScenario:m_subquest_1313_s_24","text":"This sounds like it's going to be interesting.","jump":null},{"id":"m_subquest_1313_s_25","type":"Speech","speaker":"harran","key":"Locale_SubScenario:m_subquest_1313_s_25","text":"He may not look like much,","jump":null},{"id":"m_subquest_1313_s_26","type":"Speech","speaker":"harran","key":"Locale_SubScenario:m_subquest_1313_s_26","text":"but he has guts.","jump":null},{"id":"m_subquest_1313_s_27","type":"Speech","speaker":"harran","key":"Locale_SubScenario:m_subquest_1313_s_27","text":"This won't be an easy fight, not even for you, Johan.","jump":null},{"id":"m_subquest_1313_s_28","type":"Speech","speaker":"harran","key":"Locale_SubScenario:m_subquest_1313_s_28","text":"You'll have to keep your wits about you.","jump":null},{"id":"m_subquest_1313_s_29","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_29","text":"Nobody's fighting anyone.","jump":null},{"id":"m_subquest_1313_s_30","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:m_subquest_1313_s_30","text":"You're not scared, are you?","jump":null},{"id":"m_subquest_1313_s_31","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_31","text":"No.","jump":null},{"id":"m_subquest_1313_s_32","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:m_subquest_1313_s_32","text":"Then why did you change the rendezvous point from the rooftop to somewhere else?","jump":null},{"id":"m_subquest_1313_s_33","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_33","text":"I never asked them to come to the rooftop in the first place.","jump":null},{"id":"m_subquest_1313_s_34","type":"Speech","speaker":"noah","key":"Locale_SubScenario:m_subquest_1313_s_34","text":"How many rounds do you have to win to emerge victorious?","jump":null},{"id":"m_subquest_1313_s_35","type":"Speech","speaker":"noah","key":"Locale_SubScenario:m_subquest_1313_s_35","text":"Just one round would be a bit boring.","jump":null},{"id":"m_subquest_1313_s_36","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_36","text":"I told you, we're not fighting.","jump":null},{"id":"m_subquest_1313_s_37","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_37","text":"Darling.","jump":null},{"id":"m_subquest_1313_s_38","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_38","text":"I've got a spare stun gun that you can borrow.","jump":null},{"id":"m_subquest_1313_s_39","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:m_subquest_1313_s_39","text":"Johan's weak point is the upper part of his neck. Aim for that and he'll go down easy.","jump":null},{"id":"m_subquest_1313_s_40","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_40","text":"Don't broadcast your own side's weaknesses for all to hear.","jump":null},{"id":"m_subquest_1313_s_41","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:m_subquest_1313_s_41","text":"Do you need a referee?","jump":null},{"id":"m_subquest_1313_s_42","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_42","text":"No.","jump":null},{"id":"m_subquest_1313_s_43","type":"Speech","speaker":"noah","key":"Locale_SubScenario:m_subquest_1313_s_43","text":"Are you going to use your special move?","jump":null},{"id":"m_subquest_1313_s_44","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_44","text":"I don't have a special move.","jump":null},{"id":"m_subquest_1313_s_45","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1313_s_45","text":"You take things awfully literally.","jump":null},{"id":"m_subquest_1313_s_46","type":"Speech","speaker":"johan","key":"Locale_SubScenario:m_subquest_1313_s_46","text":"I'll be waiting.","jump":null}],"chat":true}