{"id":"d_counseling_sin_swiftbunny_02","cat":"counsel","group":{"id":"char5183","label":"Sin: Swift Bunny"},"label":"Advising Sin: Swift Bunny: 02","stage":null,"prev":"d_counseling_sin_swiftbunny_01","next":"d_counseling_sin_swiftbunny_03","speakers":{"sin_b":"Sin"},"icons":{"sin_b":"si_c405_00_s"},"lines":[{"id":"d_counseling_sin_swiftbunny_02_01","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_01","text":"They say bunny girls bring good luck, right?","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sin_b"],"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_02","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_02","text":"So how about this? I'll bring you some luck, and you grant me one favor. Deal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_03","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_03","text":"All right, what is it?","jump":"d_counseling_sin_swiftbunny_02_05","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sin_swiftbunny_02_04","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_04","text":"... No.","jump":"d_counseling_sin_swiftbunny_02_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sin_swiftbunny_02_05","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_05","text":"Wait, you don't even know what I'm gonna ask for, and you just agree?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_06","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_06","text":"Well, I trust you won't ask for anything unreasonable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_07","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_07","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_08","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_08","text":"Then 50 points to you, Instructor, for trusting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_09","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_09","text":"I'll ask for that favor later!","jump":"d_counseling_sin_swiftbunny_02_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_10","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_10","text":"You say that like you already know what I'm going to ask for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_11","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_02_11","text":"You're always oddly firm in situations like these.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_02_12","type":"Speech","speak