{"id":"d_main_22_12_s","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"Descend from the Sky: A","stage":"22-36 BOSS · Start","prev":"d_main_22_11","next":"d_main_22_12_e","speakers":{"enikk":"Enikk","poli":"Poli","miranda":"Miranda","neon":"Neon","anis":"Anis","rapi":"Rapi","nihilister":"Nihilister"},"icons":{"enikk":"si_c904_00_s","poli":"si_c030_00_s","miranda":"si_c032_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","nihilister":"si_c261_00_s"},"lines":[{"id":"d_main_22_12_s_1","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_1","text":"Welcome.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":"bgm_story_enikksroom","movie":null,"shown":["enikk","rapi","neon","poli","miranda","anis"],"affinity":null},{"id":"d_main_22_12_s_2","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_12_s_2","text":"Hello.\nNice to meet you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_3","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_12_s_3","text":"Ni-ni-nice t-to meet you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_4","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_12_s_4","text":"What's wrong with you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_5","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_12_s_5","text":"I-it's an honor to meet the ow-ow-owner of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_6","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_6","text":"I do not \"own\" the Ark. I am merely an AI which oversees its daily operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_7","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_12_s_7","text":"Oh, is that right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_8","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_8","text":"Please answer the question I asked you a moment ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_9","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_9","text":"Ah yes, pertaining to your chances of coming out of this alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_10","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_10","text":"6 hours from now, this entire situation will be resolved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_11","text":"... Sorry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_12","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_12","text":"Mighty Tools has been dispatched to where the hole was made, and are still diligently making repairs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_13","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_13","text":"Absolute and Matis have also been assigned to that area to prevent any further influx of Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_14","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_14","text":"Everything is proceeding quite smoothly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_event"],"affinity":null},{"id":"d_main_22_12_s_15","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_15","text":"All available Nikkes have been called to fight against the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_16","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_16","text":"Of the Nikkes currently in battle, 52 have sustained moderate injuries, while 114 have sustained minor injuries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_17","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_17","text":"There are no major injuries or fatalities as of yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_18","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_18","text":"Power and other infrastructure are being restored at a rapid pace. All communications throughout the Ark will be back online within 5 minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_19","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_19","text":"After the immediate threat is dealt with, all damages will be repaired within 34 days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_20","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_20","text":"Would you like to look at the detailed repair plan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_21","text":"This raid happened without warning. How were you so well prepared?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_22","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_22","text":"Various autonomous armaments have been installed throughout the Ark. We have developed an environment which allows these armaments to be deployed within a moment's notice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_23","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_23","text":"I have made all necessary preparations for the worst-case scenario,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_24","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_24","text":"which this is decidedly not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_25","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_25","text":"Therefore, our response has proceeded relatively smoothly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk","rapi","neon","poli","miranda","anis"],"affinity":null},{"id":"d_main_22_12_s_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_26","text":"... Amazing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_27","text":"What a relief. When I first saw that gaping hole in the Dome of Eternity, I thought we were doomed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_12_s_28","text":"Enikk, why did you call the Commander to come see you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_29","text":"Oh yeah, didn't you say the Commander had something to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_30","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_30","text":"Yes. The Heretic Nihilister will soon be entering the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_12_s_31","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_32","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_33","text":"She will?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_34","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_34","text":"While conducting a scan of the surface to identify any additional invasive forces,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_hopeless","movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_35","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_35","text":"I detected a rather large airborne sphere of immense energy approaching at great speed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_36","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_36","text":"Upon further analysis of the sphere size and moving speed, I can confirm with some certainty that it is the Heretic Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_37","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_37","text":"If she maintains her current speed, neither Matis nor Absolute will be able to stop her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_38","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_38","text":"She will find her way inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_39","text":"What do I need to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_40","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_40","text":"Use this place as a bunker, and do battle with Nihilister. I will lure it to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_41","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_41","text":"You are the only ones who have managed to beat a Heretic in battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_42","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_42","text":"You are the only ones we can count on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_43","text":"Okay. I'll try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_44","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_44","text":"Intrusion confirmed. Heretic Nihilister has entered the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_45","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_45","text":"I will lure it here using a calling signal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_46","text":"W-wait, right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_47","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_47","text":"Phhhooooo! Phoooooo!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_48","text":"What are you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_49","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_49","text":"I'm focusing on my breathing. Think of it as tantric firepower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_50","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_12_s_50","text":"Commander? Have the Vapaus ready just in case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_51","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_12_s_51","text":"Miranda, stay focused.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_52","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_12_s_52","text":"Ye-yes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_53","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_22_12_s_53","text":"Engagement in T-minus 3 seconds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_54","text":"Get ready, everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_55","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_55","text":"Nihilister stops and stands before us, emanating scorching flames that are almost unbearably hot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["nihilister"],"affinity":null},{"id":"d_main_22_12_s_56","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_56","text":"Shockwaves and waves of heat spread, nearly suffocating me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_57","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_57","text":"What? I came because I heard the call, but it was you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_conflict","movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_58","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_58","text":"You all certainly are living high on the hog.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_59","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_59","text":"The surface is in flames, and here you all are, gorging yourselves with wine and frivolity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_60","text":"... Why did you come?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_61","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_61","text":"You'd have to be deaf, dumb and blind to miss that explosion that just occurred.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_62","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_62","text":"I came to see what all the hubbub was, and saw there was a gaping hole in the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_63","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_63","text":"Naturally, I was curious to see if the Ark was all it was cracked up to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_64","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_64","text":"Well, now you've seen it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_65","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_12_s_65","text":"You can leave now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_66","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_66","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_67","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_67","text":"I thought about that, but I decided against it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_68","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_68","text":"I like this place more than I thought I would.\nI think I'll stay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_69","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_69","text":"Trust me, you'll change your mind after being here for a few days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_70","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_70","text":"This feeling...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_71","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_71","text":"Was it here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_72","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_72","text":"The pitiful Chatterbox and Indivilia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_73","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_73","text":"Indivilia?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_74","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_12_s_74","text":"The name given to the prototype which eventually became Material H.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_75","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_75","text":"I think I might like to take it back while I'm here. After all, they are precious colleagues of mine in a way, haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_76","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_76","text":"What makes you think you've got what it takes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_77","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_77","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_78","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_78","text":"That bullet of ours almost put you six feet under.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_79","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_79","text":"You don't have any friends to help you this time around either. You sure you're gonna be okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_80","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_80","text":"It's high time I repay you for what you did to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_81","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_81","text":"Do you have any idea how painful it was extracting that poison out of my body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_82","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_82","text":"Now that there aren't any other commanders around, or those pesky pilgrims, I will burn you to the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_83","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_83","text":"The Vapaus, fire it now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_84","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_84","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_85","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_85","text":"Just joking. Man, I got you good!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_86","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_86","text":"I assure you, your death will be a painful one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_87","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_87","text":"Fire the Vapaus!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_88","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_88","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_89","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_89","text":"Wow, that really does work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_90","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_12_s_90","text":"Fire the Vapaus. Pew pew pew!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_91","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_12_s_91","text":"Fire away! Pew pew pew!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_92","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_12_s_92","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_93","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_12_s_93","text":"Incredible! The Heretic is paralyzed with fear!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_94","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_12_s_94","text":"... *Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_95","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_95","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_96","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_96","text":"My flames will consume you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_97","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_97","text":"You pathetic meatsacks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_12_s_98","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:d_main_22_12_s_98","text":"I will incinerate and reduce every one of you into a pile of ashes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}