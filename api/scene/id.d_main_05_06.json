{"id":"d_main_05_06","cat":"main","group":{"id":"ch5","label":"Chapter 5 · Wonderland"},"label":"Rabbity","stage":"5-10 STAGE · Start","prev":"d_main_05_05","next":"d_main_05_07","speakers":{"alice":"Alice","ludmilla":"Ludmilla","Self":"Commander"},"icons":{"alice":"si_c191_00_s","ludmilla":"si_c190_00_s"},"lines":[{"id":"d_main_05_06_1","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_1","text":"Hey, one of your legs is different than the other. Pretty cool!","jump":null,"exit":false,"enter":null,"bg":"IceLand_03","bgArt":"iceland_03","image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":["alice","ludmilla"],"affinity":null},{"id":"d_main_05_06_2","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_2","text":"It's an exoskeleton. Have you broken your leg?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_3","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_06_3","text":"This is a legendary weapon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_4","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_4","text":"You don't say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_5","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_5","text":"You can use that to take down the Queen of Hearts!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_6","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_6","text":"But of course, do you think I would recruit any ordinary person?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_7","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_8","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_8","text":"My Queen, could they be the Rabbity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_9","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_9","text":"What makes you think that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_10","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_10","text":"I don't know, I just feel it. I mean, what are the chances of us crossing paths with a human who just happens to possess a legendary weapon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_11","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_11","text":"Well, why don't you just ask them then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_12","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_12","text":"Um, excuse me... are you... the Rabbity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_13","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_13","text":"The Rabbity who is destined to help us topple the Queen of Hearts and take us to the world of Elysium?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_14","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_06_14","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_15","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_15","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_16","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_16","text":"Finally! I've been waiting for so long!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_17","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_17","text":"Together we'll go to Elysium!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_18","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_05_06_18","text":"I hope we get along well.","jump":"d_main_05_06_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_19","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_05_06_19","text":"Next stop, Elysium.","jump":"d_main_05_06_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_20","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_20","text":"Yes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_21","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_21","text":"There's a bunker up ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_22","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_22","text":"You must be tired. You can rest there for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_23","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_23","text":"How are you feeling, Rabbity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_24","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_24","text":"They have just come here from another world. I'm sure they are exhausted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_25","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_25","text":"They need to rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_26","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_06_26","text":"You're so considerate of others, my Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_27","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_27","text":"And don't you forget it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_28","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_28","text":"All right, let's walk for a little longer then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_06_29","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_06_29","text":"This place is teeming with Raptures, some of whom are Lords. Stay frosty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}