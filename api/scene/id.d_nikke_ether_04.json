Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_15","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_15","text":"And if I don't tell you, you'll refuse treatment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_16","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_16","text":"*Cough cough* Yeah, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_17","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_17","text":"What if I force treatment on you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_18","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_18","text":"I will refuse no matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_19","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_19","text":"Geez... Do you really have to go this far?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_20","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_20","text":"Why are you doing this to a tired office worker who's about to collapse from overwork?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_21","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_21","text":"I fed you, gave you a place to sleep, treated you, and this is the thanks I get? Honestly, being nice just spoils you rotten.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_22","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_22","text":"You're not going to tell me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_23","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_23","text":"Sheesh... Impatient much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_24","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_24","text":"Is this how clients throw their weight around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_25","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_25","text":"Ether.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_26","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_26","text":"I've no idea what you think is going on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_27","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_27","text":"But I did tell you that our lab's where people go when they catch something nasty on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_28","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_28","text":"What I didn't mention is that each floor's dedicated to a different virus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_29","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_29","text":"... But hey, you didn't need to know that, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_30","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_30","text":"That virus... You mean my illness?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_31","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_31","text":"That's right. We're working on the virus you brought from the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_32","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_32","text":"How it's structured, how it affects the body,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_33","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_33","text":"how it mutates as it worsens, how fast it spreads,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_34","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_34","text":"how to make a cure, and the side effects that come with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_35","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_35","text":"We break all of that down into individual cases and study each one in detail. From there, we develop a cure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_36","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_36","text":"As the very first host of the virus,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_37","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_37","text":"the Original will be fully cured and sent back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_38","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_38","text":"That's the purpose of this floor. And my job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_39","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_39","text":"Why do you need Nikkes for this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_40","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_40","text":"That's 'cause they're cheap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_41","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_41","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_42","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_42","text":"Easy to get, and prices are low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_43","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_43","text":"Do you really think we're using Nikkes as test subjects because we have some kind of Nikkephobia?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_44","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_44","text":"Sure, the virus needs to be modified because of the physical differences between Nikkes and humans,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_45","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_45","text":"but mentally, they're pretty much the same. Plus, we can communicate with them verbally, so it's really convenient to check their responses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_46","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_46","text":"And honestly, Nikkes are the cheapest living test subjects we can get in this world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_47","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_47","text":"That's literally the only reason we use them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_48","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_48","text":"Did they volunteer for it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_49","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_49","text":"Volunteer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_50","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_50","text":"Oh, are you asking if any of them actually said, \"I wanna be a test subject!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_51","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_51","text":"Come on, no way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_52","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_52","text":"No. 7, Nikkes have the same brains as humans, so they know exactly what in vivo experiments are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_53","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_53","text":"You really think they're doing this because they want to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_54","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_54","text":"*Cough* But why would you do that...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_55","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_55","text":"Ugh, seriously, this is so frustrating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_56","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_56","text":"So what exactly are you going to use as a sample to study the virus you caught?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_57","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_57","text":"Who's going to make the cure? And who's going to check if it has any side effects? Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_58","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_58","text":"Let me remind you again that we painstakingly tested everything to make sure it's safe. You trusted my medicine and took it yourself, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_59","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_59","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_60","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_60","text":"If you're wondering whether your meds are safe, every single Nikke on this floor already tested them out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_61","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_61","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_62","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_62","text":"Want me to go into more detail?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_63","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_63","text":"From CASE 01, we analyze how the virus spreads and what symptoms it causes.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":null,"movie":null,"shown":["idollocean","product23"],"affinity":null},{"id":"d_nikke_ether_04_64","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_64","text":"Then we look for anything it has in common with known viruses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_65","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_65","text":"After that, we make a cure based on that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_66","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_66","text":"So first, we do the first round of verification in CASE 02.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":["ether"],"affinity":null},{"id":"d_nikke_ether_04_67","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_67","text":"Out of all the developed medicines, we pick the one with the best effect and the least side effects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_68","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_68","text":"Then, we send it to CASE 03 and 04","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_69","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_69","text":"to check side effects","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_70","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_70","text":"at the maximum and minimum dosages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_71","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_71","text":"Finally, in CASE 05, we test it using the finalized dosage method.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_72","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_72","text":"Only after this step does the medicine actually go into your mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_73","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_73","text":"That's the testing method you heard about and can trust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_74","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_04_74","text":"I feel sick to my stomach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_75","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_75","text":"Blargh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_76","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_76","text":"What's with you? You were all thankful when you took it before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_77","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_77","text":"And now you're disgusted after hearing how it was made?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_78","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_ether_04_78","text":"I slowly steady my breath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_79","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_ether_04_79","text":"If I recover and leave, what will happen to those Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_80","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_80","text":"What do you mean, what will happen?","jump":null,"exit":false,"enter":null,"bg