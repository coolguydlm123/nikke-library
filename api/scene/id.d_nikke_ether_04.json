ike that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_116","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_116","text":"Humans have always survived by sacrificing others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_117","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_117","text":"You think you're any different?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_118","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_118","text":"Those Splendamin you've been eating to get this far,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_119","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_119","text":"do you really think they were perfect from the start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_120","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_120","text":"That they weren't developed through experiments like this? Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_121","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_ether_04_121","text":"No, you know exactly what's going on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ether_04_122","type":"Speech","speaker":"ether","key":"Local