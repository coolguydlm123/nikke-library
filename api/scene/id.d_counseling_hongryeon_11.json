{"id":"d_counseling_hongryeon_11","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 11","stage":null,"prev":"d_counseling_hongryeon_10","next":"d_counseling_hongryeon_12","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_11_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_1","text":"When ye have imbibed one's fair share of spirits, what typically proceeds?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_11_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_11_2","text":"I go to sleep.","jump":"d_counseling_hongryeon_11_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_11_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_11_3","text":"I end up crying my eyes out.","jump":"d_counseling_hongryeon_11_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_11_4","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_4","text":"A most ordinary response.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_5","text":"Yes, surely a desirable habit to have in one's company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_6","text":"I must ask ye, what dost thou imagine mine habits are whilst in a state of inebriation?","jump":"d_counseling_hongryeon_11_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_7","text":"Spirits do reveal the emotions trapped inside us all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_8","text":"Allowing the tears to flow when one must is paramount.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_9","text":"Should one keep it bottled up for too long, ye might manifest stomach ulcers and the like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_10","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_10","text":"I shan't be the most proficient in comforting those in need,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_11","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_11_11","text":"but I am a most capable drinking companion, so do reach out to me when the time is right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_11_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_11_12","text":"Scarlet and I have a conversation about drinking habits.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}