","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_02_s_87","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_23_02_s_87","text":"It'll just be a little scuffle, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_02_s_88","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_23_02_s_88","text":"... Okay. I'm sure you know what you're doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_02_s_89","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_23_02_s_89","text":"{AccountData.NickName}. \nAs far as tracking down Exotic is concerned, where are you planning to start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_02_s_90","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_02_s_90","text":"I was planning on checking out the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_02_s_91","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_23_02_s_91","text":"Sounds like a plan. All right then, let's get moving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_02_s_92","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_23_02_s_92","text":"Good luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_02_s_93","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_02_s_93","te