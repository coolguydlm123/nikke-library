ednikke","key":"Locale_SubScenario:d_subquest_1382_40","text":"That's not good enough. I need to know why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1382_41","type":"Speech","speaker":"escapednikke","key":"Locale_SubScenario:d_subquest_1382_41","text":"What reason could there possibly be to have my friends killed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1382_42","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1382_42","text":"... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1382_43","type":"Speech","speaker":"escapednikke","key":"Locale_SubScenario:d_subquest_1382_43","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1382_44","type":"Speech","speaker":"escapednikke","key":"Locale_SubScenario:d_subquest_1382_44","text":"Did you have something to do with it?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1382_45","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1382_45","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1382_46","type":"Speech","speaker":"escapednikke","key":"Locale_SubScenario:d_subquest_1382_46","text":"Then explain yourself!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1382_47","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1382_47","text":"I can't.",