{"id":"d_counseling_guilty_mightybunny_20","cat":"counsel","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Advising Guilty: Mighty Bunny: 20","stage":null,"prev":"d_counseling_guilty_mightybunny_19","next":null,"speakers":{"guilty_b":"Guilty"},"icons":{"guilty_b":"si_c404_00_s"},"lines":[{"id":"d_counseling_guilty_mightybunny_20_1","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_1","text":"How did you like spending time with us at the event, Counselor...?","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty_b"],"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_20_2","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_2","text":"I know I tricked you a little in the beginning... Sorry about that. I just wanted you to choose plan C... by which I mean us... by which I mean me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_3","text":"Sometimes plan C is the best choice.","jump":"d_counseling_guilty_mightybunny_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_mightybunny_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_4","text":"Plan A would've been the better choice.","jump":"d_counseling_guilty_mightybunny_20_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_mightybunny_20_5","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_5","text":"...! I'm happy to hear you say that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_20_6","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_6","text":"It makes me glad that I managed to put up with these new, oppressive restraints and getting my armpits tickled...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_20_7","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_7","text":"I really like you, Counselor... You're the best!","jump":"d_counseling_guilty_mightybunny_20_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_20_8","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_8","text":"... I guess that means you didn't really have a good time with me, then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_20_9","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_9","text":"And here I really did my best... That makes me sad...","jump":"d_counseling_guilty_mightybunny_20_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_20_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_20_10","text":"Guilty and I think back on Plan C.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}