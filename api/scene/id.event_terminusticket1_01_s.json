p":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_6","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_6","text":"Hello there, Young Man.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_7","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_7","text":"What's with the crowd?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_8","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_8","text":"It's the first time we're officially taking a civilian up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_9","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_9","text":"Everyone's probably equal parts curious and excited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_10","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_10","text":"Hmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_11","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_11","text":"Well, I suppose that makes sense. It's a good day, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_12","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_12","text":"Are you here to watch as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_13","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_13","text":"No, I'm coming on the mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_14","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_14","text":"Oh! Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_15","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_15","text":"Then I look forward to seeing you work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_16","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_16","text":"Commander, you're here early.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["diesel","brid"],"affinity":null},{"id":"event_terminusticket1_01_s_17","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_17","text":"Diesel, Brid. Good to see you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_18","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_18","text":"And this is...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_19","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_19","text":"Oh, you must be Ms. Nora!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_20","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_20","text":"Yeah, that's me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_21","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_21","text":"It's nice to meet you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_22","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_22","text":"Soline has told me so much about you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_23","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_23","text":"I'm Diesel, and this is Brid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_24","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_24","text":"You're quite the pretty young lady.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_25","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_25","text":"I bet you've broken more than a few hearts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_26","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_26","text":"I imagine you were a force to be reckoned with in your younger days as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_27","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_27","text":"Oh, back in my prime, men were lining up for me all the way down the block, heh heh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_28","type":"Speech","speaker":"brid","key":"Locale_MainScenario:event_terminusticket1_01_s_28","text":"Ms. Nora.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_29","type":"Speech","speaker":"brid","key":"Locale_MainScenario:event_terminusticket1_01_s_29","text":"I'm told returning to the surface has been your lifelong dream.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_30","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_30","text":"It sure has.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_31","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_31","text":"Though now that it's actually happening, it doesn't feel real.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_32","type":"Speech","speaker":"brid","key":"Locale_MainScenario:event_terminusticket1_01_s_32","text":"It is an honor to be operating the train that will make your dream a reality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_33","type":"Speech","speaker":"brid","key":"Locale_MainScenario:event_terminusticket1_01_s_33","text":"I will see to it that you arrive safely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_34","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_35","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_35","text":"Soline, you've got quite some friends. Peaches, every one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_36","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_36","text":"Myself included, of course. Hehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_37","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_37","text":"By the way, I brought each of you a little gift, if you're interested.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_38","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_38","text":"A gift?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_39","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_39","text":"But we haven't done anything to deserve such a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_40","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_40","text":"Consider it a thank-you in advance for operating the train.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_41","type":"Speech","speaker":"brid","key":"Locale_MainScenario:event_terminusticket1_01_s_41","text":"Oh, okay... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_42","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_42","text":"Looks like the same bag Soline received.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_43","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_43","text":"Then that means...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_44","type":"Speech","speaker":"brid","key":"Locale_MainScenario:event_terminusticket1_01_s_44","text":"New clothes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_45","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_45","text":"I didn't want Soline sticking out like a sore thumb. You're a crew, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_46","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_s_46","text":"I asked her for your sizes, so everything should fit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_47","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_47","text":"Thank you so much!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_48","type":"Speech","speaker":"diesel","key":"Locale_MainScenario:event_terminusticket1_01_s_48","text":"Brid, let's go get changed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_49","type":"Speech","speaker":"brid","key":"Locale_MainScenario:event_terminusticket1_01_s_49","text":"Sure, we can put them on before we depart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_50","text":"The atmosphere on the train is pleasant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["julia","nero","signal","mary"],"affinity":null},{"id":"event_terminusticket1_01_s_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_51","text":"I turn to look elsewhere,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_52","text":"and see the faces of several familiar Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_53","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_53","text":"Julia, Nero, Signal, Mary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_54","type":"Speech","speaker":"julia","key":"Locale_MainScenario:event_terminusticket1_01_s_54","text":"I knew I'd felt a sweet melody riding upon the wind today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_55","type":"Speech","speaker":"julia","key":"Locale_MainScenario:event_terminusticket1_01_s_55","text":"I'm glad to see you'll be joining us, Conductor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_56","type":"Speech","speaker":"nero","key":"Locale_MainScenario:event_terminusticket1_01_s_56","text":"Hey there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_57","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_57","text":"C-Commander...! Hi!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_58","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_58","text":"Phew! I was awfully nervous about who'd be coming with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_59","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_59","text":"I'm relieved that it's you, Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_60","type":"Speech","speaker":"mary","key":"Locale_MainScenario:event_terminusticket1_01_s_60","text":"Nice to see you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_61","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_61","text":"Looks like everyone's here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_62","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_62","text":"Yup!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_63","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_63","text":"Wait, you already knew we'd be coming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_64","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_64","text":"Yes, it was in the mission plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_65","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_65","text":"You're in charge of reconnaissance and security around the train whenever it makes stops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_66","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_66","text":"That's right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_67","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_67","text":"Delta said my role is important since civilians are coming with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_68","type":"Speech","speaker":"signal","key":"Locale_MainScenario:event_terminusticket1_01_s_68","text":"I-I'll do my best!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_69","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_69","text":"Nero will provide information and guidance should we encounter any wildlife on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_70","type":"Speech","speaker":"nero","key":"Locale_MainScenario:event_terminusticket1_01_s_70","text":"Biscuit or Leona probably would've been a better fit for this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_71","type":"Speech","speaker":"nero","key":"Locale_MainScenario:event_terminusticket1_01_s_71","text":"but they couldn't make it, so you get me instead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_72","type":"Speech","speaker":"nero","key":"Locale_MainScenario:event_terminusticket1_01_s_72","text":"I'll do a good job, of course. Just don't make it a hassle for me, please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_73","type":"Self","speaker":null,"key":"Locale_MainScenario:event_terminusticket1_01_s_73","text":"Julia will uphold morale and ensure everyone remains psychologically sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_74","type":"Speech","speaker":"julia","key":"Locale_MainScenario:event_terminusticket1_01_s_74","text":"For my audience setting foot on the surface for the very first time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_75","type":"Speech","speaker":"julia","key":"Locale_MainScenario:event_terminusticket1_01_s_75","text":"I shall play a tune worthy of the occasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_76","type":"Speech","speaker":"julia","key":"Locale_MainScenario:event_terminusticket1_01_s_76","text":"I look forward to your direction, Conductor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_s_77","type":"Se