lse,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_27","text":"Marian doesn't respond.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_28","text":"The transport ship lands and the ramp door opens.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_29","text":"Both the man and Marian perish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_30","text":"It happens again the next time, and the time after that, and again after that, and yet again.","jump":null,"exit":false,"enter":null,"bg":"Aircraft_Inside","bgArt":"aircraft_inside","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_31","text":"The man greets Marian in the transport ship,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_32","text":"Marian doesn't respond,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_33","text":"and they meet their demise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_34","text":"She loses track of how many times they've died.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_35","text":"Marian doesn't say anything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_36","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_36","text":"Hi, Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_37","text":"... while the man greets her the same as always.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_38","text":"She stares at him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_39","text":"Are you surprised I keep coming back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_40","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_40","text":"... Yes, obviously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_41","text":"For a brief moment, the man is at a loss for words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_42","text":"But before long, he cracks a soft smile and speaks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_43","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_43","text":"I was surprised too. I was sure I'd died, but then I opened my eyes and I was in the transport ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_44","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_44","text":"My body was completely fine, to an almost unsettling degree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_45","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_45","text":"At first, I was stupid and thought, \"Wait, maybe I actually survived.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_46","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_46","text":"... But then, after it happened a few times, I was certain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_47","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_47","text":"I'd been brought back to life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_48","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_48","text":"And so had you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_49","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_49","text":"But... how is this even possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_50","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_50","text":"I'm a Nikke. There are ways for us to be brought back to life, but you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_51","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_51","text":"You're human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_52","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_52","text":"Once a human dies, they can't come back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_53","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_53","text":"So what are you, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_54","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_54","text":"Uh... your Commander? Or are you not calling me that anymore?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_55","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_55","text":"I really liked hearing that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_56","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_57","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_57","text":"Are you the same person I know from before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_58","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_58","text":"I guess it depends on how you define \"the same person.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_59","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_59","text":"If a person's memory is what defines them, then yes, I'm that same person from before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_60","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_60","text":"Us going to the flower meadow, me giving you a flower, us fighting together, me wrapping your ankle with a bandage...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_61","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_61","text":"You trying so hard to pretend I didn't exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_62","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_62","text":"I remember all of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_63","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_64","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_64","text":"I don't know what's going on, but whatever this is, I'm glad...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_65","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_65","text":"Glad that, in any case, what happened that first time wasn't the end of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_66","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_66","text":"... Haven't you been told anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_67","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_67","text":"Nothing about why your memories carry over, or what the objective of this mission is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_68","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_68","text":"No. Nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_69","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_69","text":"Oh, there is one thing. I was told that arriving at the target location means the mission is complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_70","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_70","text":"And that after that, I'll be working as a commander in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_71","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_71","text":"Actually, I'd like to ask you. Your objective is to reach the target point too, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_72","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_72","text":"What happens when you get there? What's there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_73","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_73","text":"... I don't know either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_74","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_74","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_75","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_75","text":"Silence falls between them again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_76","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_76","text":"The transport ship lands and the ramp door opens.","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_77","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_77","text":"The two walk out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_78","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_78","text":"Let's try this again, Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_79","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_80","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_80","text":"What for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_maria-n_forwhat","movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_81","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_81","text":"What am I supposed to be doing any of this for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_82","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_82","text":"For me... I'm the same as you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_83","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_83","text":"I've already died not just dozens, but hundreds of times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_84","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_84","text":"I die, get revived, head out for the target location, die again, come back again, head out again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_85","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_85","text":"No one tells me what's there, or what any of this is supposed to mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_86","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_86","text":"What does it even mean to \"recreate Liliweiss\"? Am I even becoming more like her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_87","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_87","text":"Who knows... maybe once we reach the target location, I'll become Liliweiss, just like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_88","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_88","text":"But do you really think we'll get there? Do you actually think it's possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_89","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_89","text":"Do you actually think we'll make it there alive when the surface is swarming with so many Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_90","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_90","text":"You and me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_91","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_91","text":"we're just going to keep dying meaningless deaths.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_92","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_92","text":"That's what we were born to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_93","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_no7","movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_94","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_94","text":"Let's reach the end at least once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_95","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_95","text":"If we can reach the target location, we'll get to see what's next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_96","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_96","text":"... Next?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_97","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_97","text":"Yeah, whatever's after this. No more of the same loop. There'll be something new for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_98","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_98","text":"And if there isn't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_99","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_99","text":"Oh, there will be. I'm sure of it. Otherwise there'd be no reason to do any of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_100","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_100","text":"So let's give this another shot together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_101","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_101","text":"Our memories carry over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_102","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_102","text":"That means we both now have more memories than the two of us from before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_103","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_103","text":"If we keep making more and more memories and then reach the end of all this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_104","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_104","text":"maybe we'll have more options than we do now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_105","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_s_105","text":"And if there's nothing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_106","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_01_s_106","text":"There will be. I'm positive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_s_107","type":"Narration","speaker":null,"key"