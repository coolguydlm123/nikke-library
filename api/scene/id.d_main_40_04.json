nScenario:d_main_40_04_12","text":"Both of you, bring it, or I'll end you both.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_13","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_13","text":"Who do you think uses all of these tools?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_14","text":"Who else? Raptilion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_15","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_15","text":"I don't think anyone could handle these tools while wearing a Rapture suit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_16","text":"Come on, I'm sure he takes off the suit when working.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_17","text":"Wouldn't he get attacked by the Raptures the moment he did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_18","text":"... That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_19","text":"Nayuta, do you use these tools?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_20","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_20","text":"Doth it seem that I would?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_21","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_21","text":"... To be honest, no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_22","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_22","text":"I abhor physical labor, indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_23","text":"Then who could be using...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_04_24","text":"*Bang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_25","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_25","text":"The door to Raptilion's house bursts open suddenly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_26","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_26","text":"Someone comes running inside towards us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pinocchio"],"affinity":null},{"id":"d_main_40_04_27","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_27","text":"Howdy, Friend!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_luckybreak","movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_28","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_28","text":"Move slowly. Else, thou shalt trip again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_29","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_29","text":"Did your meditation go well? You're back early today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_30","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_30","text":"Haha. There was a matter to attend to, thus I returned with haste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_31","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_31","text":"Huh? Who are these guys?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_32","text":"A Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_33","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_33","text":"My name isn't Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_34","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_34","text":"It's Pinocchio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_35","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_35","text":"Who the heck is this...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_36","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_36","text":"Who are you? Are you Uncle's friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_37","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_37","text":"Uncle? Are you talking about Raptilion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_38","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_38","text":"That's right! Since you know Uncle's name, then you must be friends of his!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_39","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_39","text":"If so, would you wanna be friends with me too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_40","text":"Are you... a Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_41","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_41","text":"No, I told you my name's not Nikke! It's Pinnochio!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_42","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_42","text":"Anyway, can we be friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_43","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_43","text":"I wasn't asking if that's your name...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_45","text":"Commander, help me out here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_46","text":"I'm not sure how I can...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_47","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_47","text":"Don't you have a way with all women? Maybe a little more than necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_48","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_49","text":"Um... Hi, Pinocchio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_50","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_50","text":"Howdy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_51","text":"Are you a human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_52","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_52","text":"My name's not Human either! It's Pinocchio!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_53","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_53","text":"Wanna be friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_54","text":"That's not a name...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_55","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_55","text":"I'm asking what you are. Your species.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_56","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_56","text":"My species? Oh, I know what that word means!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_57","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_57","text":"I'm a Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_58","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_58","text":"... Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_59","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_40_04_59","text":"What?! A hero can never fraternize with a Rapture!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_60","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_40_04_60","text":"Neither can a villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_61","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_61","text":"So heroes and villains are Rapture's enemies?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_62","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_62","text":"I heard that enemies are meant to be fought!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_63","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_40_04_63","text":"So be it! Bring it on, foul Rapture!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_64","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_40_04_64","text":"I'll strike fear into you as only a villain can!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_65","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_65","text":"Drake, Laplace, and Pinocchio all strike strange poses in an attempt to intimidate each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_66","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_66","text":"Hmm. Let's just treat them as children engaging in playtime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_67","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_67","text":"This is the first time I've ever felt glad that Laplace and Drake are goofballs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_68","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_68","text":"Same here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_69","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_69","text":"... If I may be allowed to interject?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_70","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_70","text":"Pinocchio hath grown up 'mongst Raptures, and thus she doth believe herself to be one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_chapter40_field_turningpoint","movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_71","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_71","text":"Even Harmonizer doth bear the guise of a Rapture. Thus, it may well be that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_72","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_72","text":"You're telling me she has no idea what species are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_73","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_73","text":"Did I not speak of it? Harmonizer did request mine aid, thus our first meeting came to pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_74","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_74","text":"That request was that I attend to Pinocchio's condition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_75","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_75","text":"If White Giant was a surprise, Pinocchio was a revelation, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_76","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_76","text":"For the moment, I do presume that Pinocchio is a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_77","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_77","text":"Presume? You mean you're not sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_78","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_78","text":"When first mine eyes beheld Pinocchio, she stood but thus tall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_79","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_79","text":"Nayuta points to her waist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_80","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_80","text":"What are you saying? That she grew?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_81","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_81","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_82","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_82","text":"Her body composition is akin to that of a Nikke's. She even doth possess a core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_83","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_83","text":"And yet you're telling us she's grown? How does that make any sense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_84","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_84","text":"I too am as perplexed as thee, yet the fact doth remain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_85","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_85","text":"Day by day, she did grow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_86","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_86","text":"Yet, with each growth, she did suffer excruciating pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_87","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_87","text":"I did ascertain what parts were involved in her increase in size, and for the present, I have affixed a device to restrain her growth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_88","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_88","text":"How long it shall last, I know not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_89","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_89","text":"But she is a Nikke, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_90","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_90","text":"It doth seem so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_91","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_91","text":"How did Pinocchio come to be on Whaley?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_92","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_92","text":"In Harmonizer's words, he did discover her one day whilst wandering within the White Giant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_93","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_93","text":"It is said she was even smaller in those times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_94","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_94","text":"What in the world...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_95","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_95","text":"What's with this place? It's been one big exposition dump as soon as we got here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_96","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_96","text":"Might this be your first time encountering something such as this as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_97","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_97","text":"Forget about never having seen it. I didn't think something like this existed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_98","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_98","text":"... 'Tis not the technology of the Ark, I gather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_99","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_99","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_100","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_100","text":"I understand. I am appreciative of your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_101","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_101","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_102","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_102","text":"If we could get a sample of some kind from her, we could take it back to the Ark and analyze it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_103","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_103","text":"Maxwell...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_104","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_104","text":"Don't get me wrong. It's just for my own curiosity! Nothing more. Honest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_105","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_105","text":"What manner of sample, if I may inquire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_106","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_106","text":"Anything's fine, I suppose. As long as it's a portion of her body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_107","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_107","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_108","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_108","text":"I sorrow to admit, but Misillis is unworthy of trust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_109","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_109","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_110","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_110","text":"Thou knowest it far better than I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_111","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_111","text":"Ugh, damn this company!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_112","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_112","text":"I shall pass it to Great Hero instead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_113","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_113","text":"What blatant discrimination!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_114","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_114","text":"Give me but a moment, and I shall fetch the sample at once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_115","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_115","text":"Nayuta enters Raptilion's house.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pinocchio"],"affinity":null},{"id":"d_main_40_04_116","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_116","text":"A few moments later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_117","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_117","text":"Oh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_118","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_40_04_118","text":"What's this? Did seeing my Hero Pose #128 drain your fighting spirit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_119","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_119","text":"I hear Uncle's footsteps!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_120","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_120","text":"Pinocchio, who has been engaged in the bizarre pose-off this entire time, turns around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_121","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_121","text":"Raptilion approaches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["raptilion","leviathan","ziz"],"affinity":null},{"id":"d_main_40_04_122","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_40_04_122","text":"Uncle!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_123","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_123","text":"Behind Raptilion are Leviathan and Ziz.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_124","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_124","text":"The three of them seem to be talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_125","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_125","text":"Leviathan...? Ziz...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_126","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_126","text":"It really is them. And they seem to all be getting along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_127","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_127","text":"I told you. Everyone gets along with Raptilion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_128","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_128","text":"Okay, you're right, but you don't have to look so smug about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_129","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_129","text":"Raptilion appears to notice us and begins bouncing with joy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_130","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_130","text":"Meanwhile, Leviathan and Ziz stop in their tracks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_131","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_40_04_131","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_132","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_40_04_132","text":"Eh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}