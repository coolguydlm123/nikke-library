{"id":"d_main_40_04","cat":"main","group":{"id":"ch40","label":"Chapter 40 · Choice"},"label":"The Third Species","stage":"40-14 STAGE · Start","prev":"d_main_40_03","next":"d_main_40_05","speakers":{"maxwell_p":"Maxwell","nayuta_n":"Nayuta","rapi_red":"Rapi","laplace_p":"Laplace","drake_p":"Drake","pinocchio":"Pinocchio","leviathan":"Leviathan","ziz":"Ziz"},"icons":{"maxwell_p":"si_c105_00_s","nayuta_n":"si_c9008_00_s","rapi_red":"si_c016_00_s","laplace_p":"si_c103_00_s","drake_p":"si_c104_00_s","leviathan":"si_c562_00_s","ziz":"si_c561_00_s"},"lines":[{"id":"d_main_40_04_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_04_1","text":"Upon arriving at the house that Nayuta had pointed out, we begin to look around.","jump":null,"exit":false,"enter":null,"bg":"RaptilionHouse","bgArt":"raptilionhouse","image":null,"bgm":"bgm_chapter40_field_turningpoint","movie":null,"shown":["nayuta_n","rapi_red","maxwell_p","laplace_p","drake_p"],"affinity":null},{"id":"d_main_40_04_2","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_04_2","text":"There's a fireplace? Where does he get firewood from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_3","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_04_3","text":"Harmonizer doth bring some back whenever the White Giant descends to the surface for sustenance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_4","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_04_4","text":"There are also gardening tools here, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_04_5","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_04_5",