{"id":"d_nikke_emma_tactical_02","cat":"bond","group":{"id":"char5147","label":"Emma: Tactical Upgrade"},"label":"Comforting Scent","stage":null,"prev":"d_nikke_emma_tactical_01","next":"d_nikke_emma_tactical_03","speakers":{"emma_t":"Emma"},"icons":{"emma_t":"si_c093_00_s"},"lines":[{"id":"d_nikke_emma_tactical_02_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_1","text":"When I open my eyes,","jump":null,"exit":false,"enter":null,"bg":"White","bgArt":"white","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_2","text":"I see something white, soft... and huge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_3","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_3","text":"Without thinking, I reach out my hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_4","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_4","text":"... Oh my?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_5","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_5","text":"I'm not fully dressed yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_6","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_6","text":"Commander, you knew that all along, didn't you? You cheeky thing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_7","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_7","text":"N-no, that's not...!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_8","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_8","text":"I just got out of the shower, so could you wait a sec?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_9","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_9","text":"I'll be right there after I throw something on!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_10","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_10","text":"With lingering unease, I take another breath,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_11","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_11","text":"but the pungent stench that tormented me has vanished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_12","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_12","text":"Soon after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_13","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_13","text":"Sorry, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["emma_t"],"affinity":null},{"id":"d_nikke_emma_tactical_02_14","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_14","text":"Did I startle you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_15","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_15","text":"What in the world happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_16","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_16","text":"Ah, actually,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_17","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_17","text":"before coming here, I was making a perfume for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_18","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_18","text":"I kept thinking about what kind of scent you'd like,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_19","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_19","text":"and what would suit you best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_20","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_20","text":"I kept mixing different scents and sniffing them so much","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_21","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_21","text":"that they all started to smell the same to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_22","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_22","text":"I figured things weren't working out,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_23","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_23","text":"so I turned off my olfactory sensor for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_24","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_24","text":"After that, I should've taken a shower to wash off the scents lingering on me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_25","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_25","text":"but I guess I was too eager to show you what I made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_26","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_26","text":"I grabbed the perfumes I thought you'd like and rushed over here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_27","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_27","text":"but totally forgot to shower first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_28","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_28","text":"And on top of that, since my olfactory sensor is off,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_29","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_29","text":"I have no idea the perfumes lingering on my clothes and skin would mix and create such a strong smell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_30","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_30","text":"I'm so sorry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_31","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_31","text":"I recall the pungent smell that was strong enough to make me faint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_32","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_32","text":"How is it even possible... for a perfume to be so pungent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_33","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_33","text":"Ah, well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_34","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_34","text":"Out of curiosity, I sprayed some perfume that had a different resonance catalyst mixed in and gave it a sniff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_35","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_35","text":"A resonance catalyst?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_36","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_36","text":"It's a liquid that heightens sensory sensitivity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_37","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_37","text":"In this case, the liquified compounds reacted and seemed to double the strength of the scent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_38","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_38","text":"Normally, it would just be a strong, pungent smell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_39","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_39","text":"But when your senses are heightened, catching a whiff of something that potent so suddenly can actually make you faint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_40","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_40","text":"You even lost consciousness for a moment, Commander, remember?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_41","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_41","text":"Ah... so that's how it happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_42","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_42","text":"Oh my, you still don't look too good. Are you sure you're all right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_43","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_43","text":"Yeah, I'm fine now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_44","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_44","text":"Hmm, there you go again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_45","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_45","text":"You don't have to force yourself to act fine around me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_46","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_46","text":"Just to be safe, how about we get you checked at the hospital?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_47","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_47","text":"I'll come with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_48","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_48","text":"No, I think I'm just tired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_49","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_49","text":"I'll be better once I get some rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_50","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_50","text":"Oh, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_51","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_51","text":"You were asleep when I came in, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_52","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_52","text":"Emma gently places a hand on my cheek, looking worried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_53","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_53","text":"I heard you've been busier than usual lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_54","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_54","text":"Your face looks awful. Poor thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_55","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_55","text":"You must be really exhausted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_56","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_56","text":"A comforting scent wafts from Emma.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_57","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_tactical_02_57","text":"At the same time, a wave of tiredness washes over me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_tactical_02_58","type":"Speech","speaker":"emma_t","key":"Locale_NikkeEpisode:d_nikke_emma_tactical_