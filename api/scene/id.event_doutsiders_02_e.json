{"id":"event_doutsiders_02_e","cat":"event","group":{"id":"ev40006","label":"D-OUTSIDERS"},"label":"Outer Rim Patrol: B","stage":null,"prev":"event_doutsiders_02_s","next":"event_doutsiders_intermission_01","speakers":{"viper":"Viper","fatman":"Bulky Man","jackal":"Jackal","Self":"Commander","Monologue":"Monologue","youngman":"Young Man","joseph":"Joseph"},"icons":{"viper":"si_c112_00_s","fatman":"si_c919_00_s","jackal":"si_c111_00_s","youngman":"si_c999_00_s","joseph":"si_c935_00_s"},"lines":[{"id":"event_doutsiders_02_e_1","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_1","text":"Hi there, how's it hangin'?","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":["viper","jackal","fatman","joseph"],"affinity":null},{"id":"event_doutsiders_02_e_2","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_2","text":"Gah! Viper? And Jackal too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_3","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_3","text":"Things have been so pleasant these past few days, what's with all this ruckus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_4","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_4","text":"My apologies, but this guy is trying to drive my business into the ground!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_5","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_5","text":"He promised a certain quantity by a certain date, but now he shows up empty-handed and leaves us hanging high and dry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_6","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_6","text":"Interesting. Very interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_7","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_7","text":"Tell me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_8","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_8","text":"have you lost your mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_9","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_9","text":"... Sorry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_10","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_10","text":"Boy, this guy is slow on the uptake. Almost as slow as you, Jackal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_11","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_02_e_11","text":"Hey! What'd I do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_12","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_12","text":"You see my friend here? What kind of uniform is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_13","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_13","text":"Just an ordinary Central Government unif... oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_14","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_14","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_15","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_15","text":"So you're an inspections officer from the Central Government? My mistake!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_16","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_02_e_16","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_17","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_17","text":"This isn't what you think it is!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_18","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_18","text":"There's a lot more going on here than it appears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_19","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_19","text":"*sigh* You're giving me a headache.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_20","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_20","text":"How many times do I have to warn you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_21","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_doutsiders_02_e_21","text":"Viper extends one of her fingers, which has an unusually long nail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_22","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_doutsiders_02_e_22","text":"She taps the top of the man's head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_23","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_23","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_24","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_24","text":"You ought to know better. If you're going to do something, then do it properly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_25","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_25","text":"It's not easy always making up cover stories for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_26","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_27","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_27","text":"Oh... Yes... But it's just that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_28","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_28","text":"Making excuses, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_29","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_29","text":"Jackal, give that box behind him a once over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_30","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_02_e_30","text":"*sniff sniff*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_31","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_02_e_31","text":"Huh? What's that sweet smell... is this Illuminadesine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_32","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_02_e_32","text":"Didn't Underworld Queen crack down on this stuff a long time ago?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_33","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_33","text":"That they did. How exactly, pray tell, did some of it end up in your possession?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_34","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_34","text":"I take it this means you're siding with them now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_35","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_35","text":"And no longer need our protection?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_36","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_36","text":"Wha... no, no! It's nothing like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_37","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_37","text":"I swear to you, this will never happen again! I swear on my life!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_38","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_38","text":"I'm sure it won't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_39","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_39","text":"Now get out of here before we cart you off to the Rehabilitation Center♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_40","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_e_40","text":"Yes, yes! Thank you! You all have a great day now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_41","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_doutsiders_02_e_41","text":"The man scurries off into the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_42","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_02_e_42","text":"You've got a knack for this.","jump":"event_doutsiders_02_e_44","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_43","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_02_e_43","text":"You're really going to let him go?","jump":"event_doutsiders_02_e_46","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_44","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_44","text":"You know it. This isn't my first rodeo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_45","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_45","text":"I could have wrapped it up even sooner if he hadn't kept talking back.","jump":"event_doutsiders_02_e_52","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_46","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_46","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_47","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_47","text":"It's disappointing, but what can you do? Drug dealing is rampant in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_48","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_48","text":"If you want to crack down on something like that, you'll need more than the three of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_49","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_49","text":"Unless... you'd want to help us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_50","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_02_e_50","text":"Sorry, but I'm on another operation at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_51","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_e_51","text":"Aw, too bad...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_e_52","type":"Speech","spea