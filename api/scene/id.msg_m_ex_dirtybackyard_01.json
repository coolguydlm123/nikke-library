{"id":"msg_m_ex_dirtybackyard_01","cat":"messenger","group":{"id":"room_dirtybackyard_01","label":"Client Payments · Group"},"label":"1. Sugar has invited {AccountData.NickName} to jo…","stage":null,"prev":null,"next":null,"speakers":{"moran":"Moran","sugar":"Sugar"},"icons":{"moran":"si_c281_00_s","sugar":"si_c140_00_s"},"lines":[{"id":"msg_m_ex_dirtybackyard_01_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 103810101","key":null},{"id":"m_ex_dirtybackyard_01_1","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_1","text":"Sugar has invited {AccountData.NickName} to join the group.","jump":null},{"id":"m_ex_dirtybackyard_01_2","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_2","text":"Sugar has invited Moran to join the group.","jump":null},{"id":"m_ex_dirtybackyard_01_3","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_3","text":"?","jump":null},{"id":"m_ex_dirtybackyard_01_4","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_4","text":"What's going on?","jump":null},{"id":"m_ex_dirtybackyard_01_5","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_5","text":"I don't get what the name of this group is getting at.","jump":null},{"id":"m_ex_dirtybackyard_01_6","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_6","text":"\"Client Payments\"?","jump":null},{"id":"m_ex_dirtybackyard_01_7","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_7","text":"It means exactly what it says.","jump":null},{"id":"m_ex_dirtybackyard_01_8","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_8","text":"Since we've received a formal request,","jump":null},{"id":"m_ex_dirtybackyard_01_9","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_9","text":"we should be paid accordingly once we've completed said request.","jump":null},{"id":"m_ex_dirtybackyard_01_10","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_10","text":"You haven't even started yet,","jump":null},{"id":"m_ex_dirtybackyard_01_11","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_11","text":"and you're already talking about payment?","jump":null},{"id":"m_ex_dirtybackyard_01_12","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_12","text":"Of course.","jump":null},{"id":"m_ex_dirtybackyard_01_13","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_13","text":"You can't imagine the amount of people who ask for our help and then vanish into thin air.","jump":null},{"id":"m_ex_dirtybackyard_01_14","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_14","text":"We make group chats like this","jump":null},{"id":"m_ex_dirtybackyard_01_15","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_15","text":"as a contingency to prevent such things from occurring.","jump":null},{"id":"m_ex_dirtybackyard_01_16","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_16","text":"I see.","jump":null},{"id":"m_ex_dirtybackyard_01_17","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_17","text":"So, just to confirm:","jump":null},{"id":"m_ex_dirtybackyard_01_18","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_18","text":"We'll be launching an investigation into the Outer Rim","jump":null},{"id":"m_ex_dirtybackyard_01_19","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_19","text":"in an attempt to clear Moran's name,","jump":null},{"id":"m_ex_dirtybackyard_01_20","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_20","text":"who is our client this time around.","jump":null},{"id":"m_ex_dirtybackyard_01_21","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_21","text":"Have I got everything?","jump":null},{"id":"m_ex_dirtybackyard_01_22","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_22","text":"Yes, that's all correct.","jump":null},{"id":"m_ex_dirtybackyard_01_23","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_23","text":"Upon completion of this request,","jump":null},{"id":"m_ex_dirtybackyard_01_24","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_24","text":"we will receive remuneration in the amount of 10 million credits.","jump":null},{"id":"m_ex_dirtybackyard_01_25","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_25","text":"Is that correct?","jump":null},{"id":"m_ex_dirtybackyard_01_26","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_26","text":"Correct.","jump":null},{"id":"m_ex_dirtybackyard_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_27","text":"Are you sure that's the correct amount?","jump":null},{"id":"m_ex_dirtybackyard_01_28","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_28","text":"Hmm?","jump":null},{"id":"m_ex_dirtybackyard_01_29","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_29","text":"Wait a minute.","jump":null},{"id":"m_ex_dirtybackyard_01_30","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_30","text":"Why is it 10 million credits?","jump":null},{"id":"m_ex_dirtybackyard_01_31","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_31","text":"I'm sorry, I didn't see it clearly. Let's check again.","jump":null},{"id":"m_ex_dirtybackyard_01_32","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_32","text":"Sorry, but you already agreed.","jump":null},{"id":"m_ex_dirtybackyard_01_33","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_33","text":"No takebacks.","jump":null},{"id":"m_ex_dirtybackyard_01_34","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_34","text":"Don't be absurd.","jump":null},{"id":"m_ex_dirtybackyard_01_35","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_35","text":"10 million credits is an astronomical amount.","jump":null},{"id":"m_ex_dirtybackyard_01_36","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_36","text":"Is it?","jump":null},{"id":"m_ex_dirtybackyard_01_37","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_37","text":"Listen.","jump":null},{"id":"m_ex_dirtybackyard_01_38","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_38","text":"Even if I were okay","jump":null},{"id":"m_ex_dirtybackyard_01_39","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_39","text":"with paying that much,","jump":null},{"id":"m_ex_dirtybackyard_01_40","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_40","text":"I don't have that much money.","jump":null},{"id":"m_ex_dirtybackyard_01_41","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_41","text":"Come on, you're the boss of the Peony Association.","jump":null},{"id":"m_ex_dirtybackyard_01_42","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_42","text":"You must be flush with cash.","jump":null},{"id":"m_ex_dirtybackyard_01_43","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_43","text":"What are you trying to do?","jump":null},{"id":"m_ex_dirtybackyard_01_44","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_44","text":"You know what dire straits we're in.","jump":null},{"id":"m_ex_dirtybackyard_01_45","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_45","text":"Actually, no, I don't know.","jump":null},{"id":"m_ex_dirtybackyard_01_46","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_46","text":"...","jump":null},{"id":"m_ex_dirtybackyard_01_47","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_47","text":"Cadet, say something.","jump":null},{"id":"m_ex_dirtybackyard_01_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_48","text":"Why don't we all meet and discuss the finer points of the payment?","jump":null},{"id":"m_ex_dirtybackyard_01_49","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_49","text":"Yes, something like this should be discussed in person.","jump":null},{"id":"m_ex_dirtybackyard_01_50","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_50","text":"Ugh, fine.","jump":null},{"id":"m_ex_dirtybackyard_01_51","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_51","text":"Forget about it.","jump":null},{"id":"m_ex_dirtybackyard_01_52","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_dirtybackyard_01_52","text":"Just hurry and get yourself over to the Outpost.","jump":null}],"chat":true}