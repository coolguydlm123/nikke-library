{"id":"d_counseling_nihilister_17","cat":"counsel","group":{"id":"char5056","label":"Nihilister"},"label":"Advising Nihilister: 17","stage":null,"prev":"d_counseling_nihilister_16","next":"d_counseling_nihilister_18","speakers":{"nihilister":"Nihilister"},"icons":{"nihilister":"si_c261_00_s"},"lines":[{"id":"d_counseling_nihilister_17_1","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_17_1","text":"Nihilister, how is life up on the surface?","jump":null,"exit":false,"enter":null,"bg":"Volcano_03","bgArt":"volcano_03","image":null,"bgm":"bgm_volcanicnest","movie":null,"shown":["nihilister"],"affinity":"_0"},{"id":"d_counseling_nihilister_17_2","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_2","text":"I don't know what you want me to tell you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_3","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_3","text":"Are you genuinely curious about what I do up on the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_17_4","text":"I'm just curious about what it's like to live on the surface all the time.","jump":"d_counseling_nihilister_17_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nihilister_17_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_17_5","text":"It's not often I get to talk to someone who spends most of their time up on the surface.","jump":"d_counseling_nihilister_17_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nihilister_17_6","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_6","text":"That's not a good enough reason to ask such a stupid question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_7","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_7","text":"I burn. I destroy. I kill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_8","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_8","text":"That's what life on the surface consists of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_9","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_9","text":"If you're looking for a sappy love story, then go read a book.","jump":"d_counseling_nihilister_17_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_10","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_10","text":"You've spent a good chunk of time up there, you should know. You've probably seen your fair share of mangled-up bodies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_11","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_11","text":"I hate to tell you, but you've seen pretty much all there is to see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_12","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_17_12","text":"As for myself, I have a ball up here torching, destroying, and killing whatever I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_17_13","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_17_13","text":"Nihilister and I have a conversation about the surface.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}