{"id":"d_subquest_1301","cat":"sub","group":{"id":"req_romantist","label":"Request · Romantist"},"label":"Request 1301","stage":null,"prev":null,"next":"d_subquest_1302","speakers":{"anis":"Anis","rapi":"Rapi","neon":"Neon","Self":"Commander"},"icons":{"anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_subquest_1301_1","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1301_1","text":"Is this the place?","jump":null,"exit":false,"enter":null,"bg":"Desert_01","bgArt":"desert_01","image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["neon","anis","rapi"],"affinity":null},{"id":"d_subquest_1301_2","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1301_2","text":"According to the photo our client gave us, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1301_3","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1301_3","text":"Dang, that was easy. I wish all our requests were this simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1301_4","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1301_4","text":"I'd hardly call this client easy to deal with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1301_5","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1301_5","text":"I guess you're right. That came across even in the text messages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1301_6","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1301_6","text":"You think so? I thought he and I would get along great.","jum