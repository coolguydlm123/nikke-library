{"id":"s002_02","cat":"side","group":{"id":"side2","label":"WORDLESS"},"label":"WORDLESS: 2","stage":null,"prev":"s002_01","next":"s002_03","speakers":{"mary":"Mary","mihara":"Mihara","pepper":"Pepper"},"icons":{"mary":"si_c130_00_s","mihara":"si_c161_00_s","pepper":"si_c131_00_s"},"lines":[{"id":"s002_02_1","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_1","text":"How are you feeling?","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"bgm_frostpillar","movie":null,"shown":["mihara","mary","pepper"],"affinity":null},{"id":"s002_02_2","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_2","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_3","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_3","text":"No issues with my vision, hearing, smell, taste, or touch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_4","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_4","text":"Any headaches?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_5","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_5","text":"Hehe, none whatsoever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_6","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_6","text":"The doctors did such a great job treating me that I don't feel any pain at all, unfortunately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_7","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_7","text":"Unfortunately?! Why would you say such a thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_8","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_8","text":"Your brain damage was so severe that it was almost impossible to regenerate with the NIMPH alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_9","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_9","text":"Why do you think you were taken to the Repair Center immediately after being deployed from the Missilis Research Institute?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_10","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_10","text":"That's how serious the situation was!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_11","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_11","text":"Hmm... I guess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_12","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_12","text":"What the... why are you being so nonchalant?! You should be taking this more seriously!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_13","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_13","text":"If you ask me, you should be resting at the Repair Center for a while longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_14","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_14","text":"Why did Missilis suddenly request you to return in such a hurry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_15","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_15","text":"The higher-ups probably believe that they've allowed me ample time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_16","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_16","text":"Usually, we're asked to return straight after being deployed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_17","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_17","text":"The fact that they allowed me to visit the Repair Center in the first place is already quite generous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_18","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_19","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_19","text":"Through the data I received, I've learned what kind of person I was in the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_20","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_20","text":"From the records stored in NIMPH, I've also recalled how to use my abilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_21","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_21","text":"I'm also not feeling any pain,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_22","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_22","text":"so I think it's time to get back to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_23","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_23","text":"If you feel even the slightest bit of pain,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_24","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_24","text":"be sure to come straight to the hospital, okay? It doesn't matter what time of day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_25","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_25","text":"Yes yes, I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_26","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_26","text":"Ugh... honestly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_27","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_27","text":"Haha,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_28","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_28","text":"you should really try and take this a little more seriously, Mihara.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_29","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_29","text":"Even though a new NIMPH was used to regenerate the old data,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_30","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_30","text":"since the brain itself was physically damaged, we're still unsure as to whether there will be any side effects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_31","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_31","text":"Even while we were conducting surgery, the NIMPH thought it was being physically attacked at one point and went wild.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_32","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_32","text":"If there are still parts of your brain which have sustained damage,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_33","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_33","text":"we might not be able to treat them, depending on the severity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_34","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_35","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_35","text":"So, if you feel any pain at all, you must come to us immediately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_36","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_36","text":"Understood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_37","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_37","text":"All right, yes. I'll keep that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_38","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_38","text":"Don't you two worry yourselves too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_39","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_39","text":"Fine. If I keep belaboring the point, I'll just be nagging you, so I'll stop here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_40","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_40","text":"Thanks for taking care of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_41","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_02_41","text":"Don't mention it. We're doctors. Taking care of patients is what we do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_42","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_42","text":"Hehe, that's right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_43","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_43","text":"Hehe, well, you're quite the skilled doctors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_44","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_44","text":"Oh, by the way, Mihara.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_45","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_02_45","text":"When you return to Missilis... Are you going to visit her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_46","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_46","text":"Yes. I need to go see her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_02_47","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_02_47","text":"... Yuni.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}