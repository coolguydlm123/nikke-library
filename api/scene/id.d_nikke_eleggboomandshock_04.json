exists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_56","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_56","text":"So, as someone who understands the majesty of BOOM, it's my duty to spread the word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_57","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_57","text":"A sacred mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_58","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_58","text":"Precisely!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_59","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_60","type":"Speech","speaker":"rapi_ss","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_60","text":"By the way, Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_61","type":"Speech","speaker":"rapi_ss","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_61","text":"You said the weather was going to get worse?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_62","type":"Speech","speaker":"rapi_ss","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_62","text":"Do you mean it's going to rain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_63","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_63","text":"No, I don't think it'll rain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_64","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_64","text":"Even if it does, it'll only be a light drizzle at most.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_65","type":"Speech","speaker":"rapi_ss","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_65","text":"Everything looks fine to me right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_66","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_66","text":"Emphasis on the \"right now\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_67","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_67","text":"In a few hours, after the sun sets, the clouds will settle lower in the sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_68","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_68","text":"It's a shame. I would have enjoyed having some tea under the stars.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_69","type":"Speech","speaker":"rapi_ss","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_69","text":"How ladylike of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_70","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_70","text":"How many times do I have to tell you to lay off the \"lady\" stuff?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_71","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_71","text":"If you say there will be clouds,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_72","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_72","text":"that means there might be lightning as well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_73","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_73","text":"Highly unlikely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_74","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_74","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_75","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_75","text":"The clouds are fairly thin. I doubt there'll even be enough to dim the moonlight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_76","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_76","text":"Aw, that's too bad...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_77","text":"What does the density of clouds have to do with lightning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_78","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_78","text":"Lightning occurs when water droplets inside a cloud rub against each other and build up static electricity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_79","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_79","text":"If the clouds are thin, there isn't much friction between the droplets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_80","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_80","text":"Therefore, the chances of lightning occurring are low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_81","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_81","text":"Anyway, I should go check the water fountain I installed BOOM in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_82","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_82","text":"Elegg, I have a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_83","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_83","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_84","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_84","text":"With the fountain, you're using the water as a display for BOOM, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_85","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_85","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_86","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_86","text":"And clouds are basically clusters of water droplets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_87","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_87","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_88","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_88","text":"I think I just came up with a great idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_89","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_89","text":"What's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_90","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_90","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_91","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_91","text":"How about you use the clouds as a display?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_92","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_92","text":"The clouds, you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_93","type":"Speech","speaker":"rapi_ss","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_94","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_94","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_95","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_95","text":"Just a suggestion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_96","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_96","text":"That's a brilliant idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}