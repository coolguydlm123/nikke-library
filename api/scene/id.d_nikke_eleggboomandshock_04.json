eleggboomandshock_04_19","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_19","text":"Well, I won't deny that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_20","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_20","text":"Consider this tea a token of my appreciation for your help, and we'll leave it at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_21","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_22","text":"Thanks for the drink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_23","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_23","text":"You two said you were out searching for something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_24","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_24","text":"Oh, right. This tea was so good that I totally forgot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_25","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_25","text":"What exactly are you trying to find?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_26","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_26","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_27","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_27","text":"The reason we ended up all the way out here","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_28","type":"Speech","speaker":"elegg_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_28","text":"is because we're searching for places to install BOOM.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_cottoncandy","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_29","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_29","text":"I fill in Rapi and Dorothy on everything that's transpired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_30","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_30","text":"So you're looking for somewhere special to install the game. The type of place that doesn't exist in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eleggboomandshock_04_31","type":"Speech","speaker":"dorothy_s","key":"Locale_NikkeEpisode:d_nikke_eleggboomandshock_04_31","text":"That exp