pport everyone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_05_41","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_05_41","text":"Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_05_42","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_05_42","text":"I knew you'd say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_05_43","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_05_43","text":"Once this battle is over, we won't be able to meet again, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_05_44","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_05_44","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_05_45","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_05_45","text":"But I'll never forget the time I spent working with you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_05_46","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_05_46","text":"Hehe, glad to hear that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_05_47","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_05_47","text":"Whenever things get to