{"id":"d_counseling_arkrangerblack_03","cat":"counsel","group":{"id":"char5174","label":"Ark Ranger Black"},"label":"Advising Ark Ranger Black: 03","stage":null,"prev":"d_counseling_arkrangerblack_02","next":"d_counseling_arkrangerblack_04","speakers":{"arkrangerblack":"Ark Ranger Black"},"icons":{"arkrangerblack":"si_c570_00_s"},"lines":[{"id":"d_counseling_arkrangerblack_03_1","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_03_1","text":"I'm grateful the Ark Rangers series is doing so well right now, but nothing lasts forever.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["arkrangerblack"],"affinity":"_0"},{"id":"d_counseling_arkrangerblack_03_2","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_03_2","text":"Someday, the Ark Rangers will come to an end too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_03_3","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_03_3","text":"... What am I supposed to do when it's over?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arkrangerblack_03_4","text":"Someone'll come along to carry on the Ark Rangers.","jump":"d_counseling_arkrangerblack_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_arkrangerblack_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arkrangerblack_03_5","text":"That's never gonna happen.","jump":"d_counseling_arkrangerblack_03_10","exit":false,"en