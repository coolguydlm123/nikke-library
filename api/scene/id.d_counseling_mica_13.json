{"id":"d_counseling_mica_13","cat":"counsel","group":{"id":"char3008","label":"Mica"},"label":"Advising Mica: 13","stage":null,"prev":"d_counseling_mica_12","next":"d_counseling_mica_14","speakers":{"mica":"Mica"},"icons":{"mica":"si_c061_00_s"},"lines":[{"id":"d_counseling_mica_13_1","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_13_1","text":"I had a terrible nightmare last night. This terrifying ghost emerged and came after me.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mica"],"affinity":"_0"},{"id":"d_counseling_mica_13_2","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_13_2","text":"What if it comes out again tonight? I don't think I can sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_13_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mica_13_3","text":"I'll stay with you until you fall asleep.","jump":"d_counseling_mica_13_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mica_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mica_13_4","text":"It's just a dream, so why don't you fight the ghost?","jump":"d_counseling_mica_13_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mica_13_5","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_13_5","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_13_6","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_13_6","text":"Really? Hehe. Thanks, Old-Timer!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_13_7","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_13_7","text":"I might actually be able to get a peaceful night's sleep, thanks to you!","jump":"d_counseling_mica_13_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_13_8","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_13_8","text":"Sure, but you don't realize it's a dream when you're actually dreaming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_13_9","type":"Speech","speaker":"mica","key":"Locale_Counseling:d_counseling_mica_13_9","text":"It feels just like real life, that's why it's so scary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_13_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mica_13_10","text":"Mica and I talk about dreams.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}