1102_s_6","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1102_s_6","text":"Maybe it's made out of Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1102_s_7","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1102_s_7","text":"It seems a bit unwieldy. Are you sure this can be used as a disguise?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1102_s_8","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1102_s_8","text":"Of course!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1102_s_9","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1102_s_9","text":"My suit not only mimics a Rapture's appearance but their sound. It even reproduces the flashes that their core emits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1102_s_10","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1102_s_10","text":"Of course, everything is manually operated, so it's a bit of a workout for the person inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1102_s_11","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1102_s_11","text":"But it's nothing a bit of practice can't take care of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1102_s_12","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1102_s_12","text":"Fi