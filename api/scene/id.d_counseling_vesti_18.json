{"id":"d_counseling_vesti_18","cat":"counsel","group":{"id":"char5022","label":"Vesti"},"label":"Advising Vesti: 18","stage":null,"prev":"d_counseling_vesti_17","next":"d_counseling_vesti_19","speakers":{"vesti":"Vesti"},"icons":{"vesti":"si_c091_00_s"},"lines":[{"id":"d_counseling_vesti_18_1","type":"Speech","speaker":"vesti","key":"Locale_Counseling:d_counseling_vesti_18_1","text":"Commander, if someone hurt your feelings, how would you respond?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["vesti"],"affinity":"_0"},{"id":"d_counseling_vesti_18_2","type":"Speech","speaker":"vesti","key":"Locale_Counseling:d_counseling_vesti_18_2","text":"Is there a way to keep your feelings from being hurt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_vesti_18_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_vesti_18_3","text":"Whatever they did to me, I'd do the same thing right back at them.","jump":"d_counseling_vesti_18_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_vesti_18_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_vesti_18_4","text":"I wouldn't let it get me down and just move on.","jump":"d_counseling_vesti_18_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_vesti_18_5","type":"Speech","speaker":"vesti","key":"Locale_Counseling:d_counseling_vesti_18_5","text":"But then you're no better than they are!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_vesti_18_6","type":"Speech","speaker":"vesti","key":"Locale_Counseling:d_counseling_vesti_