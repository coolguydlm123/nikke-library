{"id":"event_footstepwalkrun1_05_s","cat":"event","group":{"id":"ev40066","label":"FOOTSTEP, WALK, RUN · Part 1"},"label":"Skull Head: A","stage":null,"prev":"event_footstepwalkrun1_04_e","next":"event_footstepwalkrun1_05_e","speakers":{"rio":"Rio","rapi_m":"Rapi","wendi":"Wendi"},"icons":{"rio":"si_c302_00_s","rapi_m":"si_c994_00_s","wendi":"si_c305_00_s"},"lines":[{"id":"event_footstepwalkrun1_05_s_1","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_s_1","text":"No, you're supposed to say you're okay during moments like that.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":"bgm_frostpillar","movie":null,"shown":["rapi_m","rio","wendi"],"affinity":null},{"id":"event_footstepwalkrun1_05_s_2","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_s_2","text":"But I'm not, so why would I say I am?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_s_3","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_s_3","text":"It's a matter of politeness. A social courtesy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_s_4","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_s_4","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_s_5","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_s_5","text":"Just keep that in mind, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_s_6","type":"Speech","speaker":"rapi_m","key":