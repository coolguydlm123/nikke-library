{"id":"d_main_21_05_s","cat":"main","group":{"id":"ch21","label":"Chapter 21 · Giant Whale"},"label":"A Commander's Responsibility","stage":"21-15 STAGE · End","prev":"d_main_21_04_e","next":"d_main_21_06","speakers":{"cecil_op_l":"Cecil","anis":"Anis","rapi":"Rapi","neon":"Neon","johan":"Johan"},"icons":{"cecil_op_l":"si_c929_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","johan":"si_c925_00_s"},"lines":[{"id":"d_main_21_05_s_1","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_05_s_1","text":"This is the second cannon.","jump":null,"exit":false,"enter":null,"bg":"Launcher","bgArt":"launcher","image":null,"bgm":"bgm_intotheswarm_b","movie":null,"shown":["anis","neon","rapi","johan","harran","noah","cecil_op_l"],"affinity":null},{"id":"d_main_21_05_s_2","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_05_s_2","text":"The damage doesn't seem too bad. Let's hurry and get this thing up and running.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_3","text":"Are we just going to stand and watch again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_05_s_4","text":"We'll lend a hand this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_05_s_5","text":"I actually liked just watching.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_6","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_6","text":"No. I want all Nikkes to stand back this time as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_7","text":"I have to ask...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_8","text":"what is the point of all this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_05_s_9","text":"I can see how it's necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_10","text":"But how?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_11","text":"If we can repair this stuff more quickly, why not let us take over? It's just like putting us into combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_05_s_12","text":"That would be more efficient, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_05_s_13","text":"But having the Commander go at it alone could result in an expanded skillset.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_14","text":"Sure, but not by much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_05_s_15","text":"Every little bit counts. Even something small as this could get the Commander out of a bind in the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_16","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_17","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_17","text":"You're wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_05_s_18","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_19","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_19","text":"Not just a little. It expands significantly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_20","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_20","text":"Nearly 100 times more materials were utilized in the Second Surface Reclamation Campaign than the first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_21","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_21","text":"That wasn't only because the number of Nikkes increased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_22","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_22","text":"The number of weapons used increased as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_23","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_23","text":"Many of those weapons were left up on the surface, and remain there to this day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_24","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_24","text":"Some are damaged beyond repair, but most of them can still be used after a few light repairs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_25","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_25","text":"That gives us another option, one that wasn't previously available.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_26","text":"But will that thing work against Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_27","text":"Those weapons are decades old. Will they be capable of taking down Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_28","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_28","text":"Who said anything about that? That's not the responsibility of a commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_29","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_29","text":"A commander's responsibility is to use everything available to them in order to assist their Nikkes in taking down Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_30","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_30","text":"Being on the lookout for gaps in their ranks, lapses in judgment, mechanical malfunctions...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_31","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_31","text":"Just doing this much helps a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_05_s_32","text":"I guess you're right...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_33","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_33","text":"Listen carefully. {AccountData.NickName}.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_34","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_34","text":"Never rest on your laurels. Keep thinking. Keep analyzing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_35","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_35","text":"This will train your ability to exercise good judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_36","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_36","text":"If you build up your skillset, your sense of judgment will improve along with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_37","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_37","text":"A commander does exactly that. Command.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_38","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_38","text":"They don't sit by and suck their thumb while mindlessly sending Nikkes out into battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_05_s_39","text":"I know that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_40","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_41","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_41","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_42","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_42","text":"As long as you're aware.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_05_s_43","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_05_s_43","text":"Let's move on after you're done with this cannon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}