_01_e_72","text":"Wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_73","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_73","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_74","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_01_e_74","text":"Are you going to head outside dressed like that? In swimsuits?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_75","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_75","text":"Why not? We came here dressed like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_76","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_01_e_76","text":"At least let me give you a towel so you can cover yourselves up a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_77","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_77","text":"Speaking of swimsuits,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_78","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_78","text":"don't forget to bring your own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_79","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_boomtheghost1_01_e_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_80","text":"Dorothy stares in disbelief at the two swimsuit-clad figures leaving her room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_81","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_81","text":"Once they have left, she shifts her gaze to the tablet left on the table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_82","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_82","text":"She looks at the cruise ship in silence for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_83","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_83","text":"Commander's room.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_cottoncandy","movie":null,"shown":["rapi_ss"],"affinity":null},{"id":"event_boomtheghost1_01_e_84","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_01_e_84","text":"I'm planning on publishing an e-book.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["tove","elegg"],"affinity":null},{"id":"event_boomtheghost1_01_e_85","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_01_e_85","text":"I was gonna title it How to Survive on the Surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_86","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_01_e_86","text":"but it turns out there are already a bunch of books out there with similar titles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_87","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_01_e_87","text":"I was feeling discouraged, but then I saw the recruitment notice for this mission, and it hit me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_88","type":"Speech","speaker":"tove","key":"Locale_MainScenario:event_boomtheghost1_01_e_88","text":"I can write a book called How to Survive on a Cruise Ship!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_89","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_89","text":"Sounds a bit niche... but okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_90","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_90","text":"I've heard your survival skills are second to none and that you're adept at crafting tools. I'm sure you'll be a valuable asset to the team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pepper"],"affinity":null},{"id":"event_boomtheghost1_01_e_91","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_91","text":"I have a high opinion of Nikkes from the Unlimited Squad in general.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_92","type":"Speech","speaker":"pepper","key":"Locale_MainScenario:event_boomtheghost1_01_e_92","text":"I'm here because Elegg came to me and said there could be a passenger onboard who may need medical attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_93","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_boomtheghost1_01_e_93","text":"Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_94","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_94","text":"You're putting a lot more thought into this than I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_95","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_boomtheghost1_01_e_95","text":"Hey! What's that supposed to mean?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["yan"],"affinity":null},{"id":"event_boomtheghost1_01_e_96","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_96","text":"Having a member of Seraphim with us is reassuring. We won't have to worry about getting a bit rough and tumble.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_97","type":"Speech","speaker":"pepper","key":"Locale_MainScenario:event_boomtheghost1_01_e_97","text":"Excuse me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_98","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_98","text":"I'm just glad Mary isn't the one who came along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_99","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_99","text":"She's a force to be reckoned with, what with her massive, heaving, pendulous... er... personality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_100","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_100","text":"*Sigh*... I hate to admit it, but I don't stand a chance against her in that department.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_101","type":"Speech","speaker":"pepper","key":"Locale_MainScenario:event_boomtheghost1_01_e_101","text":"... Are you okay, Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_102","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_102","text":"Don't worry. She does that every once in a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_103","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_103","text":"I'm not here for any particularly dramatic reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_104","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_104","text":"Apparently there's a shopping area inside this cruise ship,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_105","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_105","text":"so I'm considering this a business trip to check out potential new products.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_106","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_106","text":"This ship may be old, but fashion trends are always cyclical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_107","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_107","text":"Also, the whole point of a cruise is for them to have everything you could possibly want on board.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_108","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_108","text":"It'll be helpful to see which products they push the hardest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_109","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_109","text":"If you come along...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_110","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_110","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_111","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_111","text":"Hey, what's the big idea? How come I don't get any compliments like the others?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_112","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_112","text":"The only real benefit to you coming is that you'll potentially find good items for cheap. And I have my doubts as to whether a 100-year-old cruise ship is going to have much to offer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_113","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_01_e_113","text":"There's only so much a merchant can offer, sadly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_114","type":"Speech","speaker":"yan","key":"Locale_MainScenario:event_boomtheghost1_01_e_114","text":"Rookie. Do something about her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_01_e_115","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_01_e_115","text":"What am I supposed to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"