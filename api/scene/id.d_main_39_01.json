,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_37","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_37","text":"They might actually help us, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_38","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_39","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_39","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_40","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_40","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_41","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_41","text":"N-not that I'm arguing with you! I'm just curious... Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_42","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_43","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_43","text":"I don't trust anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_44","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_44","text":"What about us, though?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_45","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_45","text":"You guys are different, you fool. Because you're family.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_46","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_46","text":"R-really? Hehe. We're family?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_47","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_47","text":"Are you saying we're not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_48","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_48","text":"No, no! I knew, I was just asking!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_49","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_49","text":"Um, hey, Levi,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_50","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_50","text":"you know that Imposter with the two cores I picked up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_51","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_51","text":"Why don't we feed it to Behemoth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_52","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_52","text":"Then, maybe Behemoth will get all healed up and can get us out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_53","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_53","text":"I really miss Behemoth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_54","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_55","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_55","text":"I did think about it, but no way are we doing that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_56","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_39_01_56","text":"Huh? Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_57","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_57","text":"Do you really think Behemoth would just sit still if she woke up after eating that Imposter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_01_58","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_39_01_58","text":"It'd be complete pandemonium.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image"