{"id":"d_main_39_09","cat":"main","group":{"id":"ch39","label":"Chapter 39 · Gene"},"label":"Going in Circles","stage":"39-30 STAGE · Start","prev":"d_main_39_08","next":"d_main_39_10","speakers":{"laplace_p":"Laplace","drake_p":"Drake","maxwell_p":"Maxwell","nayuta_n":"Nayuta","rapi_red":"Rapi"},"icons":{"laplace_p":"si_c103_00_s","drake_p":"si_c104_00_s","maxwell_p":"si_c105_00_s","nayuta_n":"si_c9008_00_s","rapi_red":"si_c016_00_s"},"lines":[{"id":"d_main_39_09_1","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_chapter39_field_gliding_a","movie":null,"shown":["laplace_p","drake_p","nayuta_n","maxwell_p","rapi_red"],"affinity":null},{"id":"d_main_39_09_2","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_3","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_3","text":"What now? What's gotten into you two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_4","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_4","text":"After all that we went through to get upgraded, we haven't even had a chance to show off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_5","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_5","text":"What kind of villain would want a peaceful world like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_6","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_6","text":"What are you talking about? The Raptures attacked us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_7","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_7","text":"Yeah, but they're just a bunch of small fry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_8","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_8","text":"Maybe it's because we're on the Mother Whale, but they feel even weaker than usual!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_9","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_9","text":"And what's wrong with being safe? Would you prefer a Heretic show up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_10","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_10","text":"You fool! There's no fun in being safe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_11","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_11","text":"I want a real fight!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_12","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_12","text":"A battle where both sides go all out, and push each other to the brink and past their limits...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_13","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_13","text":"As long as I win, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_14","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_14","text":"So winning is what's important?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_15","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_15","text":"Of course! Who the hell likes losing battles?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_16","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_16","text":"And Nayuta still won't answer our questions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_17","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_17","text":"Or rather, she's answering them, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_18","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_18","text":"Pilgrims are all so self-centered! They've lived alone on the surface for so long, they only care about themselves!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_19","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_19","text":"How can you be so sure all Pilgrims are like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_20","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_20","text":"I don't. It's just a personal prejudice of mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_21","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_21","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_22","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_22","text":"I do believe ye are indeed strong, yet 'tis also true that the foes which beset us are unusually weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_09_23","text":"This doesn't make any sense. Weren't the Raptures here supposed to be Raptilion's friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_24","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_24","text":"I, too, find this matter most perplexing, verily. We must hasten to meet with Harmonizer and inquire as to the cause of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_25","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_25","text":"Our arrival is nigh. Once we but turn to the left here, there should be a passage leading within.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_26","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_09_26","text":"We follow Nayuta and turn the corner, only to find the path blocked by one of Whaley's colossal parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_27","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_27","text":"Ah, I see! There must be a secret passage!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_28","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_28","text":"As a secret passage expert, my gut says if we touch the walls or floor, the doors will definitely open!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_29","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_29","text":"This path is not the one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_30","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_30","text":"Come, let us return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_31","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_09_31","text":"We walk for a while longer, following Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_09_32","text":"A massive, dangerous looking fan obstructs the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_33","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_33","text":"Ah, got it! We have to launch ourselves through the spinning fans to get inside!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_34","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_34","text":"You fool! Obviously, we should stop the fan, or at least slow it down, before going through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_35","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_35","text":"This path is not the one either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_36","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_36","text":"We shall turn back and seek another, so it shall be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_37","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_09_37","text":"Once again, we trail after Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_38","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_09_38","text":"This time, we arrive at the end of Whaley's body. One wrong step, and we'll fall right off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_39","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_39","text":"Ah, this is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_40","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_09_40","text":"... What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_41","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_41","text":"You fool, it's obviously...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_42","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_09_42","text":"Uh... what is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_43","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_43","text":"Is this not the path we ought to take as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_44","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_44","text":"If not, then come, let us return forthwith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_09_45","text":"Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_46","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_46","text":"Yes, Great Hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_09_47","text":"Are you lost?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_48","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_48","text":"So it seems, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_49","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_49","text":"Why didn't you say so instead of taking us on a wild goose chase?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_50","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_50","text":"Er... When one rushes, even what is meant to succeed shall surely fail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_51","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_51","text":"I'd say you're messing things up pretty badly right now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_52","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_53","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_53","text":"Verily, to have spoken but thrice in jest and receive so fervent a reply doth leave me quite at a loss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_54","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_54","text":"Well then, well then. This time shall I guide thee aright.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_55","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_55","text":"Should I once more lead thee astray with my jests, thou mayst chastise me upon the hindquarters in due recompense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_56","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_56","text":"... This path is not the way, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_57","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_57","text":"All right, bend over and show us those cheeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_58","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_09_58","text":"Hurry up and spank her, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_59","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_09_59","text":"Okay, first off, why are we spanking her? And two, why me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_60","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_09_60","text":"I figured you were into this kind of thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_61","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_09_61","text":"Well, I'm not!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_62","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_62","text":"Could we please meet Raptilion at some point in our lifetime?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_63","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_63","text":"There needeth be no haste. So long as we continue to walk, anon we shall arrive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_64","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_64","text":"Enough. Just tell us where we need to go. Surely there must be some kind of landmark that you recognize?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_65","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_65","text":"Look yonder. We must go forth to the place that seemeth like a fin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_66","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_66","text":"... You're kidding, right? We just have to go almost straight ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_67","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_09_67","text":"It seems verily that the yin-yang and five elements' energies in this vicinity are twisted and askew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_68","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_68","text":"Now you're just making things up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_09_69","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_09_69","text":"That's it. I'm taking point this time. Follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}