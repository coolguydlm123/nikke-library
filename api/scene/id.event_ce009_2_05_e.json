,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_12","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_12","text":"Yes, it's an excellent program, clearly designed with real combat in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_13","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_13","text":"I believe that training there will instill a wide variety of tactics applicable to real combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_14","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_14","text":"So, how'd you like shooting?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_15","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_15","text":"You're actually a pretty good shot, Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_16","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_16","text":"Like I mentioned before, I've been using a model gun for quite some time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_17","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_17","text":"Even so... a real gun is completely different, from the weight and feel to the recoil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_18","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_18","text":"I understand now why you were worried before. I'll make sure I never forget what you taught me whenever I use this gun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_19","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_19","text":"The door opens with a click.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_20","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_20","text":"Miranda and Phantom return to the group, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["miranda_c","phantom_c_p"],"affinity":null},{"id":"event_ce009_2_05_e_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_21","text":"You're...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_ce009_spot_action-ambush","movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_22","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_22","text":"... a phantom thief?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_23","type":"Speech","speaker":"phantom_c_p","key":"Locale_SubScenario:event_ce009_2_05_e_23","text":"I'm no ordinary phantom thief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_24","type":"Speech","speaker":"phantom_c_p","key":"Locale_SubScenario:event_ce009_2_05_e_24","text":"I am the Saint Thief who passes judgment on the wicked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_25","type":"Speech","speaker":"ce009_04","key":"Locale_SubScenario:event_ce009_2_05_e_25","text":"Huh? Phan-chan, there's something behind you. It kinda looks like a Persona, but... I think it's something different!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_26","type":"Speech","speaker":"phantom_c_p","key":"Locale_SubScenario:event_ce009_2_05_e_26","text":"Haha. Of course not, I can't wield a Persona.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_27","type":"Speech","speaker":"phantom_c_p","key":"Locale_SubScenario:event_ce009_2_05_e_27","text":"Still, seeing you summon your Personas into battle left quite an impression on me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_28","type":"Speech","speaker":"phantom_c_p","key":"Locale_SubScenario:event_ce009_2_05_e_28","text":"so I used hologram technology to recreate something similar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_29","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_2_05_e_29","text":"A hologram?! That's amazing! It looks just like Sakuya when I summon her!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_30","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_2_05_e_30","text":"The Ark's sky too... There are really so many amazing technologies here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_31","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_31","text":"Whoa, you scared me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_32","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_32","text":"It's so convincing that for a sec, I thought you'd awakened a Persona like the rest of us!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_33","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_33","text":"We all awakened to our Personas under different circumstances. Just because you're a Nikke doesn't mean you can't awaken one too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_34","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_34","text":"After all, Aigis is a Persona-user as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_35","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_35","text":"That's correct. A human body isn't strictly necessary. One of my companions is actually a dog who can use a Persona.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_36","type":"Speech","speaker":"phantom_c_p","key":"Locale_SubScenario:event_ce009_2_05_e_36","text":"Haha, thank you for your kind words. If I ever awaken a Persona, you'll be the first to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_37","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_37","text":"But enough about my attire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["phantom_c"],"affinity":null},{"id":"event_ce009_2_05_e_38","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_38","text":"A phantom thief is judged by deeds, not words...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_39","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_39","text":"Phantom glances back at Miranda, who's fidgeting behind her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_40","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_40","text":"Besides, it seems Miranda has something prepared for you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_41","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_41","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_42","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_42","text":"I'm afraid I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_43","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_43","text":"...","jump