_ce009_2_05_e_57","text":"Of course! No phantom thief is complete without a calling card. Hehehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_58","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_58","text":"That's a good idea, but how are we supposed to send it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_59","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_ce009_2_05_e_59","text":"That's...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_60","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_ce009_2_05_e_60","text":"Well... Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_61","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_61","text":"If I'd known this was coming, I would've prepared one ahead of time and left it in the Outer Rim the last time we were there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_62","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_62","text":"I have a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_63","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_63","text":"I've concluded that giving advance notice before infiltrating a location increases the target's security level. Why do you do it anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_64","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_64","text":"Because it's part of the thrill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_65","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_65","text":"Hoho, you know your stuff, Mona.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_66","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_66","text":"As Aigis said, it certainly isn't the most logical approach, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_67","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_67","text":"If you send a calling card, put your target on high alert, and still steal their treasure in spectacular fashion...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_68","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_68","text":"That's the beauty of being a phantom thief right there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_69","type":"Speech","speaker":"ce009_04","key":"Locale_SubScenario:event_ce009_2_05_e_69","text":"Things are getting beary heated!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_70","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_70","text":"The beauty of being a phantom thief... Data updated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_71","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_2_05_e_71","text":"Forget the whole \"beauty\" thing. There's no harm in making a calling card, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_72","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_2_05_e_72","text":"We'll just bring it with us,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_73","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_2_05_e_73","text":"toss it right in front of him, then kick his butt!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_74","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_74","text":"Um... Wouldn't that defeat the whole purpose of a calling card?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_75","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_2_05_e_75","text":"So what? It's all part of the fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_76","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_76","text":"That's definitely not what I was expecting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_77","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_77","text":"But I like it! It's so us, marching right in and delivering judgment fair and square.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_78","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_ce009_2_05_e_78","text":"Then I'll make a calling card right away!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_79","type":"Speech","speaker":"ce009_04","key":"Locale_SubScenario:event_ce009_2_05_e_79","text":"Me too! I wanna help!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_80","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_ce009_2_05_e_80","text":"Okay! It'll be even more fun together!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_81","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_2_05_e_81","text":"Then, how about I draft the message?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_82","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_82","text":"May I take a look as well? I'd like to save the calling card's format to my database.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_83","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_83","text":"So you guys actually handwrite your calling cards?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_84","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_84","text":"Sometimes we print them. It makes spell-checking much easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_85","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_85","text":"In that case, do you deliver yours some other way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_86","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_86","text":"We deliver our calling cards in a way that ensures the target receives them personally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_87","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_87","text":"Haha, now that's a romantic way of doing things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_88","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_88","text":"Looks like that's gonna be the Thieves of Judgment's calling card. Then let's make one for the Phantom Thieves of Hearts too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_89","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_89","text":"So, Queen, wanna do our usual thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_90","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_90","text":"That could work. Let's steal that man's twisted heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_91","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_91","text":"Several days after both phantom thief crews finish preparing their calling cards,","jump":null,"exit":false,"enter":null,"bg":"UndergroundTunnel","bgArt":"undergroundtunnel","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_92","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_92","text":"we return to the passage leading to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["phantom_c"],"affinity":null},{"id":"event_ce009_2_05_e_93","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_05_e_93","text":"There are way more spiderwebs than there were last time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_chaser","movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_94","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_94","text":"The spiderwebs here appear to be just as thick as the ones on the partition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_95","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_2_05_e_95","text":"Really? Then did we come all the way out here for nothing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_96","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_96","text":"Hehehe. Of course not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_97","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_97","text":"Mona pulls out a small, familiar-looking device.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_98","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_98","text":"Hm... Isn't that Ade's grappling gun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_99","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_99","text":"That's right! Though it's not exactly the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_100","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_100","text":"Remember those supplies you gave us? They were packed with useful stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_101","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_101","text":"I picked out what I needed and modified it. This is an infiltration tool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_102","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_102","text":"A sharp, sturdy, harpoon-like tip hangs from the end of the wire connected to the device.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_103","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_103","text":"This wire's so strong! It was totally worth upgrading! You just do this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_104","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_104","text":"Mona fires the wire into the spiderwebs covering even the ceiling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_105","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_105","text":"*Whoosh! Crunch!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_106","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_05_e_106","text":"Penetration confirmed. It should be strong enough to support the Nikkes' weight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_107","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_107","text":"No, it'll take too long for everyone to climb up. Just give me a sec!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_108","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_108","text":"Mona climbs the wire and disappears through a tiny gap near the ceiling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_109","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_109","text":"Shortly after...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_110","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_110","text":"*Rumble*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_111","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_2_05_e_111","text":"Wow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_112","type":"Speech","speaker":"phantom_c","key":"Locale_SubScenario:event_ce009_2_05_e_112","text":"Oho, looks like he used his infiltration tool to open the security door from the inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_113","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_05_e_113","text":"With a heavy rumble, the security door from earlier begins to slowly open.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_05_e_114","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_05_e_114","text":"Well? Pretty impressive, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce009_05_1"],"affinity":null},{"id":"event_ce009_2_05_e_115","ty