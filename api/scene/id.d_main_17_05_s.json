{"id":"d_main_17_05_s","cat":"main","group":{"id":"ch17","label":"Chapter 17 · Purpose"},"label":"New Moon: A","stage":"17-13 STAGE · Start","prev":"d_main_17_04","next":"d_main_17_05_e","speakers":{"snowwhite":"Snow White","rapunzel":"Rapunzel","hongryeon":"Scarlet","anis":"Anis","neon":"Neon","rapi":"Rapi"},"icons":{"snowwhite":"si_c220_00_s","rapunzel":"si_c221_00_s","hongryeon":"si_c222_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_17_05_s_1","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_05_s_1","text":"You are late.","jump":null,"exit":false,"enter":null,"bg":"IceLand_02","bgArt":"iceland_02","image":null,"bgm":"bgm_story_thepilgrim","movie":null,"shown":["snowwhite","rapunzel","hongryeon","anis","neon","rapi"],"affinity":null},{"id":"d_main_17_05_s_2","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_05_s_2","text":"I'm not that late, am I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_3","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_05_s_3","text":"The new moon hasn't set yet. There's still time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_4","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_05_s_4","text":"And she has guested with her this time around.\nCut her some slack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_5","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_05_s_5","text":"Ladies, it's been a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_6","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_05_s_6","text":"I heard you got a bullet in the stomach. Are you all right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_05_s_7","text":"I'm okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_05_s_8","text":"Hey, Snow White!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_05_s_9","text":"Look at your messages from time to time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_10","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_05_s_10","text":"That's right. If Snow White had picked up our communications, we wouldn't be in this situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_11","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_05_s_11","text":"Communications?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_12","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_05_s_12","text":"Did you send me a message?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_05_s_13","type":"Self","speaker":null,"key":"Loca