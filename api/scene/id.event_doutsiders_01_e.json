{"id":"event_doutsiders_01_e","cat":"event","group":{"id":"ev40006","label":"D-OUTSIDERS"},"label":"Entering the Outer Rim: B","stage":null,"prev":"event_doutsiders_01_s","next":"event_doutsiders_02_s","speakers":{"Narration":"Narration","jackal":"Jackal","viper":"Viper","crow":"Crow","Monologue":"Monologue","Self":"Commander"},"icons":{"Narration":"si_c999_00_s","jackal":"si_c111_00_s","viper":"si_c112_00_s","crow":"si_c110_00_s"},"lines":[{"id":"event_doutsiders_01_e_1","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_01_e_1","text":"Soon after, in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_2","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_01_e_2","text":"Whoa! Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["jackal","viper"],"affinity":null},{"id":"event_doutsiders_01_e_3","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_01_e_3","text":"I can't believe you're actually at the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_4","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_01_e_4","text":"Honey! What a lovely surprise seeing you here♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_5","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_01_e_5","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_6","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_01_e_6","text":"Where are all the other Nikkes you're usually with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_7","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_01_e_7","text":"They're waiting for me at the Outpost.","jump":"event_doutsiders_01_e_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_8","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_01_e_8","text":"This is a top-secret mission, so I came alone.","jump":"event_doutsiders_01_e_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_9","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_9","text":"Good call.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"event_doutsiders_01_e_10","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_10","text":"If you were seen around here cavorting with Nikkes from the Central Government,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_11","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_11","text":"word will get out pretty quickly, and you won't be able to walk the streets safely, let alone get information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_12","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_12","text":"We should move elsewhere. This place reeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_13","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_13","text":"Let's proceed to the hideout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_14","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_doutsiders_01_e_14","text":"After arriving at the hideout, I give Exotic a mission briefing.","jump":null,"exit":false,"enter":null,"bg":"Bar","bgArt":"bar","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_15","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_01_e_15","text":"Basically, what you're saying is that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["jackal","crow","viper"],"affinity":null},{"id":"event_doutsiders_01_e_16","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_01_e_16","text":"you want us to tell you who was responsible for","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_17","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_01_e_17","text":"the recent terrorist attacks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_18","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_e_18","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_19","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_19","text":"I'm afraid it's not so simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_20","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_20","text":"Technically speaking, we do belong to an arm of the intelligence department,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_21","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_21","text":"but asking us to sell out our friends and neighbors is an awfully tall order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_22","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_e_22","text":"So you're refusing to cooperate?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_23","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_23","text":"I didn't say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_24","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_24","text":"It's an order straight from the Deputy Chief. We couldn't possibly refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_25","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_25","text":"All I'm saying is that I don't want to come out of this mission as a traitor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_26","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_e_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_27","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_e_27","text":"Are you at least willing to be my escort?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_28","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_28","text":"Escort?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_29","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_29","text":"I suppose so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_30","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_30","text":"If you were to start snooping around here without any escort, you'd be announcing to everyone that you were sent by the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_31","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_31","text":"If we didn't look after you, your carcass would hang in the square by tomorrow morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_32","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_32","text":"Very well. We can at least do that much for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_33","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_33","text":"Jackal, Viper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_34","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_34","text":"Show the Commander around. Give the full tour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_35","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_01_e_35","text":"Yes, Captain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_36","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_01_e_36","text":"You got it♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_37","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_e_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_38","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_38","text":"What, don't you trust these two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_39","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_39","text":"Don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_40","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_40","text":"We run things in these parts, {AccountData.NickName}.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_41","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_41","text":"Not the Central Government, not the Sovereigns, and not even the CEOs of the Big Three.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_42","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_42","text":"We're practically saints, and everyone here worships us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_43","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_43","text":"Tell me, would you ever deface a statue of a saint while you're on holy ground?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_44","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_e_44","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_e_45","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_01_e_45","text":"Then you understand. Now go with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}