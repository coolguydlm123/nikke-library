l,"affinity":null},{"id":"event_ce003_1_prologue_26","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_prologue_26","text":"Sorry, I have no memory of this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_27","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_27","text":"Me neither. And it's the first time I've seen buildings designed in such a way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_28","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_28","text":"I'm also unsure as to where we are.\nMaybe somewhere outside the Lugunica?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_29","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_1_prologue_29","text":"The three of them exchange bewildered expressions, as none of them can provide an exact answer as to where this place is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_30","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_1_prologue_30","text":"Emilia places her hand on the crystal at her chest, and speaks to the hidden Great Spirit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_31","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_prologue_31","text":"Do you know what happened, Puck?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_32","type":"Speech","speaker":"ce_003_04","key":"Locale_SubScenario:event_ce003_1_prologue_32","text":"Hmm... I'm not entirely sure either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_33","type":"Speech","speaker":"ce_003_04","key":"Locale_SubScenario:event_ce003_1_prologue_33","text":"And... I don't know why I'm feeling so tired. I'm sorry I can't be of help, Lia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_34","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_prologue_34","text":"That's okay! You can just rest inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_35","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_35","text":"Miss Emilia, do you remember what you were doing last?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_36","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_prologue_36","text":"Yeah, Rem and I were having lunch and listening to Subaru, and then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_37","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_prologue_37","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_38","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_prologue_38","text":"Sorry, I don't really remember what happened after that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_39","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_prologue_39","text":"My memory of that event is vague as well. We were enjoying Subaru's story, and then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_40","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_40","text":"All right then, mystery solved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_41","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_41","text":"You were having lunch and in the process of being bored stiff by Barusu's prattling, you passed out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_42","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_42","text":"You then came to, and found yourselves in an unfamiliar place. Somehow along the way, I got caught up in all this as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_43","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_43","text":"We'll have to give Barusu a piece of our minds when we get back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_44","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_prologue_44","text":"Come on, Ram, you don't even know for certain if this has anything to do with Subaru.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_45","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_prologue_45","text":"Miss Emilia is right, Sister. Besides, I thought Subaru's story was fantastical and engaging.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_46","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_46","text":"... You must be pulling my leg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_47","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_prologue_47","text":"Forget about his story for now. Figuring out exactly what's going on here is our top priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_48","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_prologue_48","text":"Miss Emilia, Sister. I say we take a look around the surrounding area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_49","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_prologue_49","text":"Sounds like a plan. The sooner we find out what this place is, the sooner we can get back to the mansion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_prologue_50","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_1_prologue_50","text":"The three who appeared with the light start to move forward cautiously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}