{"id":"event_marian1_06_s","cat":"event","group":{"id":"ev40124","label":"MARIA-n · Part 1"},"label":"No. 7: A","stage":null,"prev":"event_marian1_05_e","next":"event_marian1_06_e","speakers":{"enikk":"Enikk","No.2":"No. 2","maria-n":"Maria-n","No.3":"No. 3","No.4":"No. 4","No.6":"No. 6","doctormaria":"Doctor Maria"},"icons":{"enikk":"si_c904_00_s","No.2":"si_c999_00_s","maria-n":"si_c013_00_s","No.3":"si_c999_00_s","No.4":"si_c999_00_s","No.6":"si_c999_00_s","doctormaria":"si_c9041_00_s"},"lines":[{"id":"event_marian1_06_s_1","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_1","text":"The Maria-model Nikke has been deployed together with the product of Project A.D.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":"event_bgm_maria-n_102-202","movie":null,"shown":["enikk"],"affinity":null},{"id":"event_marian1_06_s_2","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_2","text":"An attempt was made to induce the mutual destruction gene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_3","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_3","text":"However, no subsequent Maria-model Nikke has become a Queen, and no mutual destruction gene has emerged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_4","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_4","text":"No. 1: Progressed 0.3% before death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_5","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_5","text":"Cause of death: Head destroyed by Rapture gunfire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_6","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_6","text":"No. 2:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_7","type":"Speech","speaker":"No.2","key":"Locale_MainScenario:event_marian1_06_s_7","text":"Hang on. What's that Rapture? I don't think I've seen one like that.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":null,"movie":null,"shown":["maria-n"],"affinity":null},{"id":"event_marian1_06_s_8","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_8","text":"... It seems to be an animal-type. I've never seen a Rapture like that either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_9","type":"Speech","speaker":"No.2","key":"Locale_MainScenario:event_marian1_06_s_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_10","type":"Speech","speaker":"No.2","key":"Locale_MainScenario:event_marian1_06_s_10","text":"All right. Let's engage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_11","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_11","text":"What? Fighting an unidentified Rapture is far too dangerous...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_12","type":"Speech","speaker":"No.2","key":"Locale_MainScenario:event_marian1_06_s_12","text":"Nah, it'll be fine. Discovering something like that on a first deployment is a major achievement all by itself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_13","type":"Speech","speaker":"No.2","key":"Locale_MainScenario:event_marian1_06_s_13","text":"And if we take it down on top of that? We're sure to make an impression on the higher-ups.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_14","type":"Speech","speaker":"No.2","key":"Locale_MainScenario:event_marian1_06_s_14","text":"Come on. Let's do it, Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_15","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_15","text":"... Roger that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_16","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_16","text":"Encountered an unidentified Rapture at the 21% mark.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":null,"movie":null,"shown":["enikk"],"affinity":null},{"id":"event_marian1_06_s_17","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_17","text":"Consumed alive by said Rapture. Deceased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_18","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_18","text":"During that same encounter, the Maria-model Nikke was killed in combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_19","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_19","text":"No. 3:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_20","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_20","text":"Argh...! They're laying it on thick...!","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":null,"movie":null,"shown":["maria-n"],"affinity":null},{"id":"event_marian1_06_s_21","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_21","text":"Don't lean out from cover!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_22","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_22","text":"... You're so calm, even in a situation like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_23","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_23","text":"... And you don't die from Rapture attacks that would kill a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_24","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_24","text":"Only four left!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_25","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_25","text":"... You fire a large-caliber machine gun while making it look like there's no recoil...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_26","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_26","text":"... You never get tired, and as long as your brain is intact, you can come back if your body's destroyed...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_27","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_27","text":"Only two left!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_28","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_28","text":"... They call you... a Goddess of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_29","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_29","text":"So what's a person, then? A Goddess of Victory's servant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_30","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_30","text":"If you're so perfect and can handle everything on your own... what's the point of even having a commander here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_31","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_31","text":"Just one left! Almost done!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_32","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_32","text":"Argh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_33","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_33","text":"Huh...?! What are you doing...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_34","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_34","text":"Give me this! Let go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_35","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_35","text":"Wait! Humans can't handle Nikke weapons...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_36","type":"Speech","speaker":"No.3","key":"Locale_MainScenario:event_marian1_06_s_36","text":"I'm just as capable! We are just as capable!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_37","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_37","text":"Abruptly seized the Maria-model Nikke's weapon at the 27% mark and attempted to fight Raptures.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":null,"movie":null,"shown":["enikk"],"affinity":null},{"id":"event_marian1_06_s_38","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_38","text":"Unable to suppress the weapon's recoil, he shot and killed the Maria model before being killed by the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_39","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_39","text":"No. 4:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_40","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_40","text":"You could've cut ten seconds off that last fight! Why do you keep messing up?!","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":null,"movie":null,"shown":["maria-n"],"affinity":null},{"id":"event_marian1_06_s_41","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_41","text":"I'm afraid I don't understand what possible significance time could have...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_42","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_42","text":"Don't you talk back to me, you robotic piece of...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_43","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_43","text":"... Ow!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_44","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_44","text":"... As I keep telling you, punching me only hurts you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_45","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_45","text":"Shut up...! Just shut up and keep moving to the next point...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_46","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_46","text":"Faster. Walk faster! Faster!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_47","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_47","text":"Stop kicking me. I'll get there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_48","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_48","text":"Talking back again? Come here...! Looks like I need to make the chain of command clearer to you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_49","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_49","text":"*Huff... huff...!* How's that? Starting to get it now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_50","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_51","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_51","text":"Come on, say something!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_52","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_52","text":"You really are the worst.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_53","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_53","text":"... I guess the lesson hasn't sunk in yet...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_54","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_54","text":"... What's going on? Is it broken?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_55","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_55","text":"Why does it keep saying the same thing over and over?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_56","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_56","text":"Stop hitting me. Stop hitting me. Stop hitting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_57","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_57","text":"Hahaha! Looks like it's broken! This is why you can't trust machines!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_58","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_58","text":"Just die! Die! Die!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_59","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_59","text":"Stop hitting me. Stop hitting me. Stop hitting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_60","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_60","text":"Huh? Get away from me! Who do you think you are? Get lost!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_61","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_61","text":"Stop hitting me. Stop hitting me. Stop hitting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_62","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_62","text":"... Stay back. I'm warning you. C-Commander's orders...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_63","type":"Speech","speaker":"maria-n","key":"Locale_MainScenario:event_marian1_06_s_63","text":"Stop hitting me. Stop hitting me. Stop hitting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_64","type":"Speech","speaker":"No.4","key":"Locale_MainScenario:event_marian1_06_s_64","text":"I said stay back!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_65","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_65","text":"Reached the 22% mark in the shortest time on record.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":null,"movie":null,"shown":["enikk"],"affinity":null},{"id":"event_marian1_06_s_66","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_66","text":"However, repeated use of violence against the Maria-model Nikke caused significant delay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_67","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_67","text":"The Maria-model Nikke's corruption manifested, and she shot and killed No. 4.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_68","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_68","text":"No. 5:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_69","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_69","text":"Fled after disembarking from the transport ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_70","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_70","text":"Whereabouts unknown. Status unknown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_06_s_71","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:event_marian1_06_s_71","text":"The Maria-model Nikke sustained severe mental damage and died at the 0.5% mark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":