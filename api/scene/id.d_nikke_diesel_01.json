":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_117","type":"Speech","speaker":"tvvoice","key":"Locale_NikkeEpisode:d_nikke_diesel_01_117","text":"Every year, Ark Express holds a memorial to mark the AFX terrorist attack. This day is an official holiday.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_118","type":"Speech","speaker":"tvvoice","key":"Locale_NikkeEpisode:d_nikke_diesel_01_118","text":"This brutal violence tore families apart and spilled innocent civilian blood. Let's hope nothing like that happens again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_119","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_diesel_01_119","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}