":"d_nikke_diesel_01_104","type":"Speech","speaker":"tvvoice","key":"Locale_NikkeEpisode:d_nikke_diesel_01_104","text":"... Cyclicality, this year's AFX Train Terrorist Attack Victim Memorial is expected to happen soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_105","type":"Speech","speaker":"tvvoice","key":"Locale_NikkeEpisode:d_nikke_diesel_01_105","text":"Nearly 500 citizens were killed in this tragedy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_106","type":"Speech","speaker":"tvvoice","key":"Locale_NikkeEpisode:d_nikke_diesel_01_106","text":"The AFX Train was a civilian passenger train and carried no military supplies on board. In this light, the attack is even more despicable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_107","type":"Speech","speaker":"tvvoice","key":"Locale_NikkeEpisode:d_nikke_diesel_01_107","text":"It demonstrates how deranged and dangerous the Heavenly Ascension is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_108","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_diesel_01_108","text":"Ah, how time flies! It's already time for another year's memorial?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_01_109","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_diesel_01_109","text":"That was indeed a shocking incident...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"