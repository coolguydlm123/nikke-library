{"id":"d_counseling_anis_08","cat":"counsel","group":{"id":"char3005","label":"Anis"},"label":"Advising Anis: 08","stage":null,"prev":"d_counseling_anis_07","next":"d_counseling_anis_09","speakers":{"anis":"Anis"},"icons":{"anis":"si_c012_00_s"},"lines":[{"id":"d_counseling_anis_08_1","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_1","text":"I've been talking in my sleep a lot lately.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis"],"affinity":"_0"},{"id":"d_counseling_anis_08_2","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_2","text":"Last night, Neon woke me up\nand asked me why I keep babbling on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_3","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_3","text":"... Should I ask Mary for medical treatment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_08_4","text":"Did you apologize to Neon?","jump":"d_counseling_anis_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anis_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_08_5","text":"Seems like you've been under a lot of pressure recently.","jump":"d_counseling_anis_08_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_anis_08_6","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_6","text":"I don't even know what I should apologize for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_7","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_7","text":"... Hey, wait a minute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_8","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_8","text":"What if Neon was lying to me?","jump":"d_counseling_anis_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_9","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_9","text":"You make a good point.\nAfter all, times have been tough since we met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_10","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_10","text":"Ah, please don't get me wrong. I don't mean I dislike being with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_11","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_08_11","text":"I'm just under so much pressure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_08_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_anis_08_12","text":"I share some advice about getting better sleep with Anis.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}