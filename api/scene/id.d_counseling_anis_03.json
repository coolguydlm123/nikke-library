{"id":"d_counseling_anis_03","cat":"counsel","group":{"id":"char3005","label":"Anis"},"label":"Advising Anis: 03","stage":null,"prev":"d_counseling_anis_02","next":"d_counseling_anis_04","speakers":{"anis":"Anis"},"icons":{"anis":"si_c012_00_s"},"lines":[{"id":"d_counseling_anis_03_1","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_1","text":"As a Nikke, I've always got my hands full.\nBut sometimes, I have to wonder... what's the point of all this?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis"],"affinity":"_0"},{"id":"d_counseling_anis_03_2","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_2","text":"I can't find much joy in my work,\n but there's nothing else I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_03_3","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_3","text":"Commander, what do you think I should do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_03_4","text":"Not everyone finds joy in their work, and that's okay.","jump":"d_counseling_anis_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_anis_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_03_5","text":"You can try to find joy in your work.","jump":"d_counseling_anis_03_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anis_03_6","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_6","text":"Hmm... You're right.\nA job is just a job, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_03_7","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_7","text":"Only a few geniuses can find meaning in their work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_03_8","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_8","text":"Never mind. I just need to work hard. That's enough.","jump":"d_counseling_anis_03_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_03_9","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_9","text":"Joy... Joy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_03_10","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_03_10","text":"Didn't that kind of thing go away a long time ago?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_03_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_anis_03_11","text":"Anis tells me her tricks for slacking off at work.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}