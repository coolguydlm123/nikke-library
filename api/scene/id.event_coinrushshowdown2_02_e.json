down2_02_e_12","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_02_e_12","text":"The security guard shifts his gaze to Sin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_13","type":"Speech","speaker":"sin_b","key":"Locale_MainScenario:event_coinrushshowdown2_02_e_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_14","type":"Speech","speaker":"drowsyguard","key":"Locale_MainScenario:event_coinrushshowdown2_02_e_14","text":"So, what is it you wanted to ask?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_15","type":"Speech","speaker":"sin_b","key":"Locale_MainScenario:event_coinrushshowdown2_02_e_15","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_16","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_02_e_16","text":"By any chance...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_17","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_02_e_17","text":"Did the organizers order you to single us out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_18","type":"Speech","speaker":"drowsyguard","key":"Locale_MainScenario:event_coinrushshowdown2_02_e_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"