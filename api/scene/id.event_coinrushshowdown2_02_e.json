":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_44","type":"Speech","speaker":"drowsyguard","key":"Locale_MainScenario:event_coinrushshowdown2_02_e_44","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_45","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_02_e_45","text":"... Got it. Thanks for telling us, even though you could get in trouble for it. I promise we won't tell anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_46","type":"Speech","speaker":"drowsyguard","key":"Locale_MainScenario:event_coinrushshowdown2_02_e_46","text":"... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_47","type":"Speech","speaker":"drowsyguard","key":"Locale_MainScenario:event_coinrushshowdown2_02_e_47","text":"Now, please leave. We've been instructed not to have any contact with Plan C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_48","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_02_e_48","text":"Yeah, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_02_e_49","text":"We turn around and start walking away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_02_e_50","type":