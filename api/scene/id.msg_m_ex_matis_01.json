{"id":"msg_m_ex_matis_01","cat":"messenger","group":{"id":"room_matis","label":"Matis · Group"},"label":"1. I've got something to tell everyone.","stage":null,"prev":null,"next":"msg_m_ex_matis_02","speakers":{"maxwell":"Maxwell","drake":"Drake","laplace":"Laplace"},"icons":{"maxwell":"si_c102_00_s","drake":"si_c101_00_s","laplace":"si_c100_00_s"},"lines":[{"id":"m_ex_matis_01_1","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_1","text":"I've got something to tell everyone.","jump":null},{"id":"m_ex_matis_01_2","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_2","text":"Ooooh! What is it?","jump":null},{"id":"m_ex_matis_01_3","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_3","text":"Don't interrupt me when I'm texting.","jump":null},{"id":"m_ex_matis_01_4","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_4","text":"Whoops, sorry!","jump":null},{"id":"m_ex_matis_01_5","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_5","text":"Maybe it has something to do with Cutey?","jump":null},{"id":"m_ex_matis_01_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_01_6","text":"Maybe?","jump":null},{"id":"m_ex_matis_01_7","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_7","text":"Have no fear, the hero is here!!!!!!!","jump":null},{"id":"m_ex_matis_01_8","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_8","text":"Would you quit making such a racket?","jump":null},{"id":"m_ex_matis_01_9","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_9","text":"Didn't I tell you not to use more than one exclamation point in your messages?","jump":null},{"id":"m_ex_matis_01_10","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_10","text":"But they're how I assert dominance!","jump":null},{"id":"m_ex_matis_01_11","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_11","text":"Can I at least use two?","jump":null},{"id":"m_ex_matis_01_12","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_12","text":"Fine, but no more.","jump":null},{"id":"m_ex_matis_01_13","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_13","text":"Thanks!!","jump":null},{"id":"m_ex_matis_01_14","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_14","text":"Well, what did you have to share with us?!","jump":null},{"id":"m_ex_matis_01_15","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_15","text":"If you quit interrupting me, I'll tell you!","jump":null},{"id":"m_ex_matis_01_16","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_16","text":"Okie dokie.","jump":null},{"id":"m_ex_matis_01_17","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_17","text":"Congratulations are in order.","jump":null},{"id":"m_ex_matis_01_18","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_18","text":"I have just completed development on","jump":null},{"id":"m_ex_matis_01_19","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_19","text":"the brand new My Cutey!","jump":null},{"id":"m_ex_matis_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_01_20","text":"Congratulations.","jump":null},{"id":"m_ex_matis_01_21","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_21","text":"Awesome!!","jump":null},{"id":"m_ex_matis_01_22","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_22","text":"Since you told me to, congratulations!","jump":null},{"id":"m_ex_matis_01_23","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_23","text":"Thank you all.","jump":null},{"id":"m_ex_matis_01_24","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_24","text":"This is nice. It's been a long time since this chat was so lively.","jump":null},{"id":"m_ex_matis_01_25","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_25","text":"With this rare lively atmosphere,","jump":null},{"id":"m_ex_matis_01_26","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_26","text":"I take it you'll all participate in the testing?","jump":null},{"id":"m_ex_matis_01_27","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_27","text":"Hehehehe","jump":null},{"id":"m_ex_matis_01_28","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_28","text":"Count me out!","jump":null},{"id":"m_ex_matis_01_29","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_29","text":"You're not weaseling your way out of this.","jump":null},{"id":"m_ex_matis_01_30","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_30","text":"Hey, why not?!","jump":null},{"id":"m_ex_matis_01_31","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_31","text":"All right, fine...","jump":null},{"id":"m_ex_matis_01_32","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_32","text":"I'm a hero on a mission.","jump":null},{"id":"m_ex_matis_01_33","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_33","text":"I don't have time.","jump":null},{"id":"m_ex_matis_01_34","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_34","text":"Don't try and fool me! I know your schedule is wide open.","jump":null},{"id":"m_ex_matis_01_35","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_35","text":"Aw man...","jump":null},{"id":"m_ex_matis_01_36","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_36","text":"I should know better than to piss off Maxwell when she's conducting the test.","jump":null},{"id":"m_ex_matis_01_37","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_37","text":"All right, that makes two.","jump":null},{"id":"m_ex_matis_01_38","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_38","text":"Cutey...","jump":null},{"id":"m_ex_matis_01_39","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_39","text":"you'll be joining us too, won't you?","jump":null},{"id":"m_ex_matis_01_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_01_40","text":"What will happen if I refuse?","jump":null},{"id":"m_ex_matis_01_41","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_41","text":"Refuse?","jump":null},{"id":"m_ex_matis_01_42","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_42","text":"Why, nothing!","jump":null},{"id":"m_ex_matis_01_43","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_43","text":"I can't force you to do anything.","jump":null},{"id":"m_ex_matis_01_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_01_44","text":"Then I refuse.","jump":null},{"id":"m_ex_matis_01_45","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_45","text":"You do?","jump":null},{"id":"m_ex_matis_01_46","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_46","text":"I see.","jump":null},{"id":"m_ex_matis_01_47","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_47","text":"Well, I should get started on the testing.","jump":null},{"id":"m_ex_matis_01_48","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_48","text":"I can hold it inside the Commander's Room!","jump":null},{"id":"m_ex_matis_01_49","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_01_49","text":"What was that?","jump":null},{"id":"m_ex_matis_01_50","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_50","text":"...","jump":null},{"id":"m_ex_matis_01_51","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_51","text":"You said you didn't want to participate, right?","jump":null},{"id":"m_ex_matis_01_52","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_52","text":"But I need you.","jump":null},{"id":"m_ex_matis_01_53","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_53","text":"So we have no choice but to go up there.","jump":null},{"id":"m_ex_matis_01_54","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_54","text":"Maxwell,","jump":null},{"id":"m_ex_matis_01_55","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_55","text":"that's hitting below the belt...","jump":null},{"id":"m_ex_matis_01_56","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_56","text":"There's another way we can get them on our side.","jump":null},{"id":"m_ex_matis_01_57","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_57","text":"How?","jump":null},{"id":"m_ex_matis_01_58","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_58","text":"What are you thinking?","jump":null},{"id":"m_ex_matis_01_59","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_59","text":"Well?","jump":null},{"id":"m_ex_matis_01_60","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_60","text":"Say it.","jump":null},{"id":"m_ex_matis_01_61","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_61","text":"Speak up!","jump":null},{"id":"m_ex_matis_01_62","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_62","text":"Birdie!","jump":null},{"id":"m_ex_matis_01_63","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_63","text":"Wait for me, your savior is on the way!","jump":null},{"id":"m_ex_matis_01_64","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_64","text":"I'm heading to the Commander's Room!","jump":null},{"id":"m_ex_matis_01_65","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_65","text":"Hahaha! Wait for us! We're on the way!","jump":null},{"id":"m_ex_matis_01_66","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_01_66","text":"Hahahaha!","jump":null},{"id":"m_ex_matis_01_67","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_01_67","text":"Hahahahahahaha!","jump":null},{"id":"m_ex_matis_01_68","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_01_68","text":"I'll join the testing.","jump":null},{"id":"m_ex_matis_01_69","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_69","text":"I figured you would.","jump":null},{"id":"m_ex_matis_01_70","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_01_70","text":"We'll wait for you in the testing room.","jump":null}],"chat":true}