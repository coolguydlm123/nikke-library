{"id":"d_main_02_05","cat":"main","group":{"id":"ch2","label":"Chapter 2 · Identification"},"label":"Into the Power Station","stage":"2-8 STAGE · Start","prev":"d_main_02_04","next":"d_main_02_06","speakers":{"shifty":"Shifty","anis":"Anis","Self":"Commander","rapi":"Rapi","neon":"Neon","Narration":"Narration"},"icons":{"shifty":"si_c907_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_02_05_1","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_1","text":"Location of power station confirmed.\nYou may proceed.","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":"bgm_recognition","movie":null,"shown":["rapi","anis","neon","shifty"],"affinity":null},{"id":"d_main_02_05_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_2","text":"Considering that place could be crawling with Raptures, we probably shouldn't just waltz in through the front door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_3","text":"I don't want to crash a Rapture house party and end up as an entrée.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_4","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02_05_4","text":"Is the power station still in operation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_5","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_5","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_6","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_6","text":"Reports indicate that it resumed operation not long ago, although no one knows how or why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_7","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02_05_7","text":"Is anyone in there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_8","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_8","text":"Officially, there are supposed to be zero humans remaining on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_9","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_9","text":"But we better expect the unexpected. We've attempted to investigate this strange phenomenon several times in the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_10","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_10","text":"But nothing came of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_11","text":"Apparently, we sent in a large band of troops before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_12","text":"They were surrounded by hordes of Raptures and got destroyed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_13","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_13","text":"Putting aside the possibility of potential survivors, the power station itself is of great significance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_14","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_14","text":"A power station of this size could supply electricity to all the facilities in the Ark for 2 months.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_15","text":"In other words, this operation is of the utmost importance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_16","text":"Apparently, it's not important enough to send more than just three people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_17","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_17","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_18","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_19","text":"Do you intend on bowing out of this operation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_20","text":"I... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_21","text":"Then I suggest you think before you speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02_05_23","text":"But how do we get in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_24","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_24","text":"By destroying the Raptures guarding the power station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_25","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02_05_25","text":"I like where you're going with this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_26","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_02_05_26","text":"*Ching*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02_05_27","text":"Let's do this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_28","text":"That's not your decision to make.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_29","text":"Well, Commander, do you wish to proceed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_30","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02_05_30","text":"Proceed with the operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_31","text":"Understood. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_32","text":"Well, let's get this over with. If we're all going to die, I'd prefer to do it sooner rather than later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_33","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_33","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_34","text":"Commander, you stay in the rear, where it's nice and safe. You just tell us what to do, and we'll do all the actual fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_35","text":"Think you can handle that? After all, it's better than the raw deal we're getting. We're just cannon fodder...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_36","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_36","text":"Anis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_37","text":"What?! Isn't that the most sensible course of action?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_38","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_38","text":"I could report you for insubordination against a superior officer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_39","text":"Big whoop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_40","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_40","text":"You would be executed on the spot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_41","text":"H-how could you say that to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_42","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_42","text":"I'm just trying to talk some sense into you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_43","text":"I'm the sensible one here! We're being tossed into a meat grinder!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_44","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_44","text":"We haven't even heard the Commander's battle plan yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_05_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_46","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_46","text":"We're stuck between a rock and a hard place. There's no denying that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_47","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_05_47","text":"What's your suggested course of action?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_48","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02_05_48","text":"We'll sneak in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_49","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_49","text":"... Sneak in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_50","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_50","text":"Well... there does seem to be a route.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_51","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02_05_51","text":"Show us the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_05_52","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_05_52","text":"Well... I'm glad to hear that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}