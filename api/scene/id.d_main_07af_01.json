ry looking bunch. You passed out several times on the way back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_01_14","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_07af_01_14","text":"Was she a Pilgrim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_01_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_07af_01_15","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_01_16","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_07af_01_16","text":"Figured as much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_01_17","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_07af_01_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_01_18","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_07af_01_18","text":"The snowstorm stopped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_01_19","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_07af_01_19","text":"Communications are back up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_01_20","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_07af_01_20","text":"I contacted the Ark. The transport ship should be arriving soon.","jump":null,"exit":false,"enter":null,"bg":null,"bg