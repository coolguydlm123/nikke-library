{"id":"d_main_37_05","cat":"main","group":{"id":"ch37","label":"Chapter 37 · Struggle"},"label":"Top Contributor","stage":"37-16 STAGE · Start","prev":"d_main_37_04","next":"d_main_37_06_s","speakers":{"maxwell":"Maxwell","mast":"Mast","anchor":"Anchor","helm":"Helm","laplace":"Laplace","drake":"Drake","rapi_red":"Rapi"},"icons":{"maxwell":"si_c102_00_s","mast":"si_c350_00_s","anchor":"si_c351_00_s","helm":"si_c352_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s","rapi_red":"si_c016_00_s"},"lines":[{"id":"d_main_37_05_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_37_05_1","text":"The Admire. Internal maintenance room.","jump":null,"exit":false,"enter":null,"bg":"MachineRoom","bgArt":"machineroom","image":null,"bgm":"bgm_chapter37_field_swarmnest","movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_2","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_2","text":"So this is the engine room?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_red","mast","anchor","helm","maxwell","drake","laplace"],"affinity":null},{"id":"d_main_37_05_3","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_3","text":"There's all sorts of cool stuff in here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_4","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_4","text":"Don't even get me started. This ship is packed hem to stern with all kinds of important machinery, and cleaning it all is a nightmare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_5","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_05_5","text":"Yeah, but the microwave generator is great for heating up frozen food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_6","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_7","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_05_7","text":"Hm? What's in that corner?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_8","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_05_8","text":"That label... is that alcohol?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_9","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_05_9","text":"You scoundrels! Are you smuggling booze?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_10","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_10","text":"N-no, I have no idea what that's doing there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_11","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_12","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_12","text":"It's rum. Would it be all right if I try some later?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_13","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_13","text":"Huh? Is that really you, Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_14","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_14","text":"I would appreciate it if you taught me more about this rum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_15","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_16","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_16","text":"All right, I'll treat you to some!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_17","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_05_17","text":"I'll prepare some snacks. You're all gonna love my starfish omurice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_18","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_18","text":"While we're at it, let's set a date. What time works for everyone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_19","text":"How about after this operation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_20","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_20","text":"I've heard that drinking on the deck makes everything taste better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_21","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_21","text":"Haha! You know what's up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_22","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_22","text":"It certainly does. Especially when you're sneaking a few nips away from Helm's prying eyes, the taste is heavenl...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_23","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_24","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_24","text":"Er... I mean, hypothetically speaking, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_25","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_25","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_26","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_26","text":"Wow, quite a few of the machines here are made by Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_27","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_27","text":"Then again, I suppose it's not that surprising for you guys to be using another company's technology. The quality speaks for itself, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_28","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_28","text":"There are even some with the Matis emblem on them? How did you manage to get these? It's tough even for us to get our hands on dedicated Matis machinery...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_29","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_30","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_05_30","text":"Maxwell quietly surveys the surroundings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_31","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_05_31","text":"I do the same, loosely following Maxwell's gaze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_05_32","text":"A part of the maintenance room is filled with machines containing the emblems for Missilis and Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_05_33","text":"Could this be for...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_34","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_34","text":"No way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_35","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_35","text":"We brought all the necessary equipment for upgrading Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_36","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_36","text":"Everything is in perfect working condition, so you can use it straight away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_37","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_05_37","text":"OMG! Power upgrade!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_38","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_05_38","text":"Pssh, I'm already at my peak power. There's no need for an upgrade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_39","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_05_39","text":"We worked really hard to haul all this stuff here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_40","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_05_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_41","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_05_41","text":"We'd be pretty bummed if you didn't use it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_42","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_05_42","text":"Well... in that case, I suppose I'll use it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_43","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_43","text":"How did you all manage to pull this off?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_44","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_44","text":"This surface exploration is the most important operation currently being carried out by the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_45","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_45","text":"Elysion, Missilis, and even private companies are all eager to participate in some capacity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_46","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_46","text":"Surface exploration has been a long-cherished goal of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_47","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_47","text":"Any progress made during this exploration, no matter how small, will solidify a company's reputation within the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_48","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_48","text":"Although there were some hiccups, such as the E2 Crystal being secured by Pathfinder and the Dark Matter being obtained by Absolute,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_49","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_49","text":"surface exploration is still regarded as Elysion's forte.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_50","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_50","text":"In that case, Syuen must have had a hell of a time getting us to be the ones chosen for this mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_51","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_51","text":"Actually, Matis are the only ones who could have been sent up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_52","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_52","text":"If it had been any other squad, the request would almost certainly have been denied.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_53","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_54","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_54","text":"Elysion's squad was originally supposed to join this operation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_55","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_55","text":"but Syuen contacted our boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_56","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_56","text":"She asked if the Matis upgrade facility, which had been planned for some time, could be sent aboard the Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_57","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_57","text":"Syuen did that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_58","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_05_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_59","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_05_59","text":"Anyway, is anyone else hungry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_60","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_60","text":"It hurts to admit this, but you're right. The Aegis Squad isn't the best fit for this operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_61","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_61","text":"We're not near the ocean, and this isn't a naval battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_62","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_62","text":"The main reason we were deployed was to bring you these upgrade facilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_63","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_63","text":"I dunno, it's not such a bad deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_64","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_05_64","text":"In exchange for us providing support, Missilis has agreed to cover the maintenance costs of the Admire for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_65","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_05_65","text":"That will keep us afloat for a while yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_66","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_66","text":"So, in order to ensure that Matis was the top contributor in this operation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_67","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_67","text":"Ingrid made a sacrifice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_68","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_68","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_69","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_69","text":"I didn't realize Ingrid and Syuen were that close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_70","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_70","text":"Consider it loyalty amongst fellow CEOs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_71","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_71","text":"Ingrid has always believed that CEOs need to stick together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_72","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_05_72","text":"Maybe she hopes that doing this will help that moronic Syuen grow up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_73","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_05_73","text":"Helm, do you know what Syuen said to Ingrid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_74","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_75","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_75","text":"From what I heard...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_76","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_05_76","text":"She got on her hands and knees, in front of all the secretaries and record keepers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_77","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_05_77","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_78","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_05_78","text":"Syuen? On her knees?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_79","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_05_79","text":"I would pay to see that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_80","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_05_80","text":"I knew the situation was bad, but I didn't realize it was that dire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_05_81","type":"Speech","speaker":"maxwell","key":"Locale_Mai