{"id":"memorial_104501","cat":"memorial","group":{"id":"memorial104500","label":"Data · Silver Liquid"},"label":"001.wav","stage":null,"prev":null,"next":"memorial_104502","speakers":{},"icons":{},"lines":[{"id":"memorial_104501_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_45_01_description","text":"You guys saw the Silver Liquid here, didn't you?"},{"id":"memorial_104501_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_45_01_description","text":"It dissolves anything it touches, so stay far away from it."},{"id":"memorial_104501_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_45_01_description","text":"Don't ever touch it. Never, ever!"},{"id":"memorial_104501_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_45_01_description","text":"Not even the tip of your finger or the teeniest tip of your toe."},{"id":"memorial_104501_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_45_01_description","text":"Don't so much as think about it. Don't even go near it."},{"id":"memorial_104501_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_45_01_description","text":"Don't say I didn't warn you. If you come into contact with that stuff, you're dead meat."},{"id":"memorial_104501_7","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_45_01_description","text":"I'm not speaking in metaphors here. You'll be dead as a doornail!"}]}