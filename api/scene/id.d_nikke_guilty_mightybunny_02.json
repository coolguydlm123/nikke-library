{"id":"d_nikke_guilty_mightybunny_02","cat":"bond","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Guilty Bunny","stage":null,"prev":"d_nikke_guilty_mightybunny_01","next":"d_nikke_guilty_mightybunny_03","speakers":{"anis_i":"Anis","neon_v":"Neon","rapi_red":"Rapi","mana":"Mana","guilty_b":"Guilty"},"icons":{"anis_i":"si_c017_00_s","neon_v":"si_c018_00_s","rapi_red":"si_c016_00_s","mana":"si_c290_00_s","guilty_b":"si_c404_00_s"},"lines":[{"id":"d_nikke_guilty_mightybunny_02_1","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_1","text":"Commander! Oh crap, what do we do?! Commander!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_languor","movie":null,"shown":["guilty_b","mana","neon_v","anis_i","rapi_red"],"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_2","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_2","text":"To think a Nikke's passionate back hug fractured your spine...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_3","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_3","text":"Looks like you've set a whole new record, Master!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_4","type":"Speech","speaker":"rapi_red","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_4","text":"That's not something to brag about, Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_5","type":"Speech","speaker":"rapi_red","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_5","text":"Commander, are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_6","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_6","text":"Yeah, I'm completely fine now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_7","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_7","text":"What do you mean, you're fine?! Didn't you hear the Seraphim Squad? They said you need absolute rest!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_8","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_8","text":"And... no matter how freakishly fast you recover, Commander, we can't just leave things like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_9","type":"Speech","speaker":"rapi_red","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_9","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_10","type":"Speech","speaker":"rapi_red","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_10","text":"Commander, we urgently need to take measures to prevent this from happening again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_11","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_11","text":"As such, we've received numerous requests from Nikkes for appropriate punishment in this matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_12","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_12","text":"That's right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_13","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_13","text":"One proposed punishment is, \"No approaching the Commander within 500 meters for the next 500 years.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_14","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_14","text":"There's also \"No one-on-one visits with the Commander,\" and \"No snacks for 50 years.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_15","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_15","text":"N-no... that's too harsh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_16","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_16","text":"Guilty looks like she's on the verge of tears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_17","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_17","text":"She didn't do it on purpose, so maybe we can let it slide?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_18","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_18","text":"That's right! I didn't mean to...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_19","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_19","text":"... Unfortunately, I took the liberty of looking into the details of the case beforehand","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_20","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_20","text":"and found this on a cell phone in Guilty's possession.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_21","text":"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_22","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_22","text":"Mana plays a voice recording.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_23","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_23","text":"Guilty's voice can be heard through the speakers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_24","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_24","text":"\"Hmm... What can I do in a bunny girl outfit to win Counselor over...?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_25","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_25","text":"\"I've already tried waking him up in one...\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_26","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_26","text":"What?! That's so shameless!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_27","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_27","text":"A bunny girl outfit first thing in the morning?! She totally did that on purpose! Seriously, unbelievable!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_28","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_28","text":"Then, Guilty's voice comes through again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_29","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_29","text":"\"Then all that's left... is to hug him from behind in a bunny girl outfit...\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_30","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_30","text":"This is where the issue lies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_31","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_31","text":"What the heck?! You knew exactly what you were doing, Guilty! You planned this whole thing from the start!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_32","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_32","text":"N-no, it's not like that... I really didn't mean to fracture Counselor's spine...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_33","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_33","text":"Commander, premeditated crimes are generally treated more seriously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_34","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_34","text":"Guilty also has a prior criminal record, which needs to be taken into consideration...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_35","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_35","text":"How would you like to proceed, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_36","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_36","text":"You are both the victim in this matter and Guilty's counselor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_37","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_37","text":"As such, the final decision regarding her punishment rests with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_38","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_38","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_39","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_39","text":"How about you clean my room as punishment, Guilty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_40","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_40","text":"Clean your room...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_41","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_41","text":"It feels a little strange asking a bunny girl to clean instead of a maid...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_42","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_42","text":"But given the circumstances, I decide to keep that to myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_43","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_43","text":"Wait, what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_44","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_44","text":"Master! She fractured your back, and that's all the punishment she gets?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_45","type":"Speech","speaker":"anis_i","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_45","text":"Exactly! That's a punishment I'd give Neon for stealing my snacks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_46","type":"Speech","speaker":"rapi_red","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_46","text":"Commander, if the punishment is too lenient, it won't do much to prevent her from doing it again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_47","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_47","text":"I said I'd really be... more careful from now on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_48","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_48","text":"I... I said I would...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_49","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_49","text":"But... no one believes me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_50","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_50","text":"I'm getting a bad feeling about this... I need to get this under control, fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_51","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_51","text":"Guilty's changed a lot from how she used to be. I think just having her clean should be enough to make her reflect on what she did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_52","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_52","text":"Right, Guilty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_02_53","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_02_53","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_migh