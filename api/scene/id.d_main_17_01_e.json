{"id":"d_main_17_01_e","cat":"main","group":{"id":"ch17","label":"Chapter 17 · Purpose"},"label":"Golden Pilgrim: B","stage":"17-1 STAGE · End","prev":"d_main_17_01_s","next":"d_main_17_02","speakers":{"rapi":"Rapi","anis":"Anis","neon":"Neon","rapunzel":"Rapunzel"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapunzel":"si_c221_00_s"},"lines":[{"id":"d_main_17_01_e_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_1","text":"No. This place is too dangerous any way you look at it.","jump":null,"exit":false,"enter":null,"bg":"IceLand_03","bgArt":"iceland_03","image":null,"bgm":"bgm_story_stormbreakers","movie":null,"shown":["rapi","anis","neon"],"affinity":null},{"id":"d_main_17_01_e_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_2","text":"We'll move out as soon as the Commander comes to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_3","text":"Let's just go to the Ark then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_4","text":"The Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_5","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_6","text":"We've turned up squat on the Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_7","text":"The Commander is hurt.\nIf that bullet had been a few millimeters to the left,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_8","text":"or if Rapunzel hadn't seen our distress signal, the Commander would've been done for!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_9","text":"Yes, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_10","text":"No buts, we need to go back.\nWe can reorganize and give Syuen a piece of our mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_11","text":"We can head back up to the surface once we've regrouped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_12","text":"But Anis, doesn't that make you upset?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_13","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_14","text":"If we do that, then we're playing right into Exotic's hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_15","text":"We didn't learn a thing about the Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_16","text":"We've been betrayed, our Commander is injured, and now we're running off with our tails tucked between our legs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_17","text":"I don't know about you, but I won't accept that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_18","text":"You think I'm doing this because I like it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_19","text":"I... I...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_20","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_20","text":"Stop you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_21","text":"We can make a decision after the Commander wakes up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapunzel"],"affinity":null},{"id":"d_main_17_01_e_22","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_22","text":"Judging by how loud you all are, you must have fully recovered by now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_23","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_23","text":"That's great,\nisn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_24","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_25","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_01_e_25","text":"I'm glad all of you are okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_blackgunsmoke","movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_26","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_27","text":"Master!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_28","text":"Are you feeling better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_01_e_29","text":"I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_30","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_30","text":"... I'm glad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_31","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_31","text":"How's it looking?\nAnything suitable for a bivouac?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_32","text":"No, I think we need to keep moving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_33","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_33","text":"There's more snow here than I thought, so there's a risk of avalanches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_34","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_34","text":"We were also late to set up the decoys, so there are still some Raptures left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_35","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_35","text":"All right,\nlet's keep moving and find somewhere that we can camp...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_36","text":"No. Let's go back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_37","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_37","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_38","text":"Commander.\nLet's go back to the Ark and come back when you're fully recovered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_39","text":"It's the best course of action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_40","text":"Nothing we're here for is that urgent.\nWe can contact Snow White when we come back up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_41","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_41","text":"I don't agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_42","text":"After everything we've been through, we have nothing to show for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_43","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_43","text":"Even if it's a shot in the dark,\nthere's always a chance of hitting your target!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_01_e_44","text":"That's just...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_45","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_45","text":"Whoa. Whoa.\nCalm down everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_46","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_46","text":"It's not good to pressure someone who's exhausted physically and mentally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_01_e_47","text":"... Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_48","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_01_e_48","text":"*Sigh* I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_49","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_49","text":"Besides, these freezing temperatures aren't only harmful to the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_50","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_50","text":"They can dull the senses and make it so you can't think straight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_51","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_01_e_51","text":"Do you know where we should go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_52","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_52","text":"Of course, I'm a Pilgrim. We're in my wheelhouse right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_01_e_53","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_01_e_53","text":"I'll take you somewhere you can all get nice and warm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}