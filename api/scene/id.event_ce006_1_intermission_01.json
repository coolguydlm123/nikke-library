{"id":"event_ce006_1_intermission_01","cat":"event","group":{"id":"ev40079","label":"MEMORIES TELLER · Part 1"},"label":"What Lies Beneath","stage":null,"prev":"event_ce006_1_03_e","next":"event_ce006_1_04_s","speakers":{"anis":"Anis","com":"Com","roam":"Roam","rapi":"Rapi","neon":"Neon","ce006_03":"Lily","ce006_npc_01":"Adam","ce006_01":"EVE","privaty":"Privaty","elegg":"Elegg"},"icons":{"anis":"si_c012_00_s","com":"si_c931_00_s","roam":"si_c931_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","ce006_03":"si_c852_00_s","ce006_npc_01":"si_c853_00_s","ce006_01":"si_c850_00_s","privaty":"si_c170_00_s","elegg":"si_c500_00_s"},"lines":[{"id":"event_ce006_1_intermission_01_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_1","text":"Explain to us what this is.","jump":null,"exit":false,"enter":null,"bg":"artcity_d","bgArt":"artcity_d","image":null,"bgm":"bgm_blurredvision","movie":null,"shown":["roam","neon","rapi","anis","com","ce006_npc_01","ce006_03","ce006_01"],"affinity":null},{"id":"event_ce006_1_intermission_01_2","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_intermission_01_2","text":"I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_3","text":"Then what was all that talk about how we'd be freaking out if we knew what was below this lake?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_4","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_intermission_01_4","text":"I didn't say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_5","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_intermission_01_5","text":"Nice try, but Roam has it on file.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_6","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_intermission_01_6","text":"-----","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_7","text":"Well, turns out you're right. We are freaking out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_8","text":"What the hell is a Nikke's arm doing in that lake?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_9","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_intermission_01_9","text":"-----","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_10","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_1_intermission_01_10","text":"If you look beneath the lake, you will know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_11","text":"Okay. I understand that you don't want to cooperate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_12","text":"Seems like we'll have to see for ourselves what's under there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_intermission_01_13","text":"Right. We need to see if the rest of the body is in there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_14","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_intermission_01_14","text":"The only problem is all the electricity coursing through the water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_intermission_01_15","text":"What if we make a suit out of all the insulated gloves that I brought?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_16","text":"That's a brilliant idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_intermission_01_17","text":"Hehe, I thought so too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_18","text":"But none of us can swim. That'll make searching for something underwater difficult, to say the least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_intermission_01_19","text":"Let's take care of the electricity for now. Once we've handled that, we can think about what to do next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_20","text":"Now that we're on the topic, don't you find it strange?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_21","text":"Where is the power supply for all this electricity coming from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_22","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_22","text":"There's probably an unmanned power plant nearby supplying electricity to the ground floor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_23","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_23","text":"When the first floor was flooded, it turned the entire lake into an electrical hazard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_24","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_intermission_01_24","text":"Do you think we can locate this power plant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_25","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_25","text":"Tracing the flow of electricity back to the source is easy enough. The issue is that the source is inside the lake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_26","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_26","text":"Do any of you have a map, by any chance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_intermission_01_27","text":"Maps aren't a thing up on the surface, and even if they were, they'd be so outdated that we couldn't depend on them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_28","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_intermission_01_28","text":"Then I guess we have no choice but to look around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_intermission_01_29","text":"Fine. Then let's prepare and move...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_30","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_30","text":"That won't be necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["privaty"],"affinity":null},{"id":"event_ce006_1_intermission_01_31","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_31","text":"Now that I'm here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_32","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_intermission_01_32","text":"Privaty? Where did you come from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"collab_bgm_sb_menu_bosschallenge","movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_33","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_33","text":"You guys should have done a better job setting up a security perimeter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_34","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_34","text":"If I'd been a Rapture, you'd all be dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_intermission_01_35","text":"If it'd been a Rapture, we would have heard it coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_36","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_37","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_37","text":"Anyway. The Central Government sent me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_38","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_38","text":"We can't afford to leave this situation unmonitored, no matter how small the impact of the D-Wave is this time around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_intermission_01_39","text":"Don't they trust us? How rude!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_40","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_40","text":"The Central Government trusts you. They're simply monitoring the state of affairs to see if any further intervention is necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_41","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_41","text":"This is a volatile situation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_42","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_42","text":"and we have no idea what unpredictable actions individuals affected by D-Waves might get up to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_43","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_43","text":"Huh? Are you talking about us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_44","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_intermission_01_44","text":"Unfortunately, I believe she is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_45","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_intermission_01_45","text":"When you say unpredictable actions, what do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_46","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_46","text":"It's hard to say. I suppose that's why I said it's unpredictable, genius.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_47","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_47","text":"Who are you, barging in here acting all high and mighty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_48","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_48","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_49","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_49","text":"I am Privaty, from Triangle. We are a defense force employed by the Central Government to respond to forces which pose threats to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_50","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_50","text":"What a long-winded explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_51","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_51","text":"... As far as you're concerned, I'm Privaty from Triangle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_52","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_52","text":"At any rate, my official role here is to conduct surveillance, but I can also offer general support.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_53","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_53","text":"I overheard that you're looking for a power plant nearby?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_54","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_intermission_01_54","text":"Yes, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_55","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_55","text":"I know the location. The Central Government's field units received updated maps of the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_56","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_intermission_01_56","text":"Huh? Why just you? Wouldn't it be better if everyone got a copy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_57","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_57","text":"Beats me. I suppose we're lucky that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_58","text":"Yeah right. They're just keeping us in line by meting out information piecemeal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_59","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_60","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_60","text":"That Central Government does no such thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_61","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_61","text":"That's precisely what a squad member in the Central Government special forces would say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_62","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_62","text":"Do you want the location of the power plant or not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_63","text":"Oh, by all means, be so kind as to grace us with the location, oh mighty officer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_64","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_65","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_intermission_01_65","text":"Did you come here alone, Privaty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_66","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_66","text":"No. I brought support.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_67","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_67","text":"I predict that she'll prove quite helpful... although I'll have to wait and see if I'm correct in that assumption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_68","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_68","text":"This place is full of uncertainties, and she's the only one I can think of who would be able to handle it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_69","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_intermission_01_69","text":"Stop dragging it out and just tell us who it is, for crying out loud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_70","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_71","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_1_intermission_01_71","text":"She hung back to investigate the entrance. She'll be here soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_72","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_1_intermission_01_72","text":"The entrance is all clear, Ms. Privaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["elegg"],"affinity":null},{"id":"event_ce006_1_intermission_01_73","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_1_intermission_01_73","text":"Wow, look at all these new faces!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_74","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_intermission_01_74","text":"Elegg?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_75","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_1_intermission_01_75","text":"Howdy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_intermission_01_76","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_1_intermission_01_76","text":"I'll be taking part in this D-Wave operation. I look forward to working with you all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}