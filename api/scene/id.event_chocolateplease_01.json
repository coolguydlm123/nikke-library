ull,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_chocolateplease_01_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_chocolateplease_01_20","text":"What?! That's not good at all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_chocolateplease_01_21","type":"Speech","speaker":"crust","key":"Locale_SubScenario:event_chocolateplease_01_21","text":"That's what I'm saying!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_chocolateplease_01_22","type":"Speech","speaker":"crust","key":"Locale_SubScenario:event_chocolateplease_01_22","text":"They assured me that eating it wouldn't cause any problems...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_chocolateplease_01_23","type":"Speech","speaker":"crust","key":"Locale_SubScenario:event_chocolateplease_01_23","text":"But still, it wouldn't be right to let people cook with expired ingredients!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_chocolateplease_01_24","type":"Speech","speaker":"crust","key":"Locale_SubScenario:event_chocolateplease_01_24","text":"I tried to contact everyone yesterday and tell them not to use those ingredients, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_chocolateplease_01_25","type":"Self","speaker":null,"key":"Locale_SubScenario:event_chocolateplease_01_25","text":"But what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_chocolateplease_01_26","type":"Speech","speaker"