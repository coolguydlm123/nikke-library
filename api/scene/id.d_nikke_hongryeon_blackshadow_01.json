{"id":"d_nikke_hongryeon_blackshadow_01","cat":"bond","group":{"id":"char5105","label":"Scarlet: Black Shadow"},"label":"Unilateral Recruitment","stage":null,"prev":null,"next":"d_nikke_hongryeon_blackshadow_02","speakers":{"liliweiss":"Liliweiss","hongryeon_o":"Scarlet","rapunzel_o":"Rapunzel","snowwhite_o":"Snow White","dorothy":"Dorothy","redhood":"Red Hood","Narration":"Narration","commander":"Commander"},"icons":{"liliweiss":"si_c943_00_s","hongryeon_o":"si_c225_00_s","rapunzel_o":"si_c966_00_s","snowwhite_o":"si_c224_00_s","dorothy":"si_c233_00_s","redhood":"si_c470_00_s","Narration":"si_c999_00_s","commander":"si_c942_00_s"},"lines":[{"id":"d_nikke_hongryeon_blackshadow_01_1","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_1","text":"Come, say hello to everyone.","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":["liliweiss","hongryeon_o","redhood","dorothy","snowwhite_o","rapunzel_o"],"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_2","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_3","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_3","text":"Hmm? Come now, don't be shy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_4","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_4","text":"Ah, I get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_5","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_5","text":"You don't like all this attention on you, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_6","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_6","text":"Nay, that's not so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_7","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_7","text":"Well, go on then. You're new here, so you should introduce yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_8","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_9","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_9","text":"*Sigh* I guess this isn't really your area of expertise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_10","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_10","text":"It's all right, I'll handle the greetings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_11","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_11","text":"I'll go first. I'm Liliweiss, and I've been entrusted with leading the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_12","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_12","text":"I'm Rapunzel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_13","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_13","text":"M-my name is Snow White. Nice to meet you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_14","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_15","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_15","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_16","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_16","text":"Something the matter, you two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_17","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_17","text":"I just don't get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_18","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_18","text":"The first time we encountered this lady, she was trying to cut us down, and now she's part of the Goddess Squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_19","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_19","text":"If it hadn't been for Red Hood's quick reflexes, this lady would have cleanly severed Red Hood's head from her shoulders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_20","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_20","text":"Call me crazy, but that doesn't exactly sound like the conduct of a good person. Are we really that short of hands?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_21","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_21","text":"The more members we have, the better, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_22","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_22","text":"I disagree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_23","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_23","text":"I assure you, she'll be of great help to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_24","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_24","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_25","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_25","text":"I apologize for brandishing my blade so recklessly during our first meeting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_26","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_26","text":"Please accept my apology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_27","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_27","text":"Yet, the truth be told — I harbor no desire to join the Goddess Squad, and it seems my presence isn't warmly welcomed either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_28","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_28","text":"I shall take my leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_29","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_29","text":"Many thanks for helping me recuperate","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_30","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_30","text":"... and tempering my sword.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_31","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_31","text":"I shall repay this favor unto thee in due time, that I can promise you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_32","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_32","text":"Huh? What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_33","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_33","text":"You said you would join us if I was able to take you down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_34","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_34","text":"Don't tell me you're going back on your word?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_35","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_35","text":"To call that a takedown sounds almost absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_36","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_36","text":"Well, she did clean her clock with just one hit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_37","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_37","text":"Yeah, WHOOM! Lilith went down with her fist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_38","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_38","text":"And BLAMMO! That lady went down like a sack of potatoes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_39","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_39","text":"In one fell swoop!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_40","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_40","text":"Down for the count!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_41","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_41","text":"You two have quite an unusual synergy in times like these...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_42","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_42","text":"... I did utter that I would mull upon it, but no promises hath escaped my lips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_43","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_43","text":"Ugh, this is so humiliating to watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_44","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_44","text":"She's not a good fit for us, that's for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_45","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_45","text":"One more thing...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_46","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_46","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_47","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_47","text":"What I am about to utter may perchance sound like quibbling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_48","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_48","text":"Just admit it already, you're a low-down, dirty quibbler!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_49","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_49","text":"Let me guess: you're gonna whine about how you weren't properly prepared for the last fight. I was wondering when that topic would come up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_50","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_50","text":"Think whatever thou will,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_51","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_51","text":"but I truly was not prepared at the time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_52","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_52","text":"and thus our fight could scarcely be deemed equitable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_53","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_53","text":"Are you really that opposed to joining us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_54","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_54","text":"If truth be told, I appreciate the invitation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_55","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_55","text":"Honored, even.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_56","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_56","text":"Nevertheless, I find it inconceivable","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_57","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_57","text":"that I allowed myself to be felled with a solitary blow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_58","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_58","text":"So what do you propose?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_59","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_59","text":"A rematch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_60","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_60","text":"Should thou best me once more, I shall join thee without a single word of opposition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_61","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_61","text":"You seem to really enjoy sparring, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_62","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_62","text":"Because I need to grow in strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_63","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_63","text":"Nay, I must attain sufficient strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_64","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_64","text":"Fine. It's a bit bothersome having to repeat myself,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_65","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_65","text":"but if it helps bring in a new recruit, I'm willing to make that sacrifice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_66","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_66","text":"So, when are we doing this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_67","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_67","text":"Now. Right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_68","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_68","text":"Are you sure about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_69","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_69","text":"I shan't wish to tarry another moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_70","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_70","text":"Fine, then. Come at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_01_71","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_01_71","text":"With pleasure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikk