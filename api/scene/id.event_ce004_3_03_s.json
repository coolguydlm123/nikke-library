004_3_03_s_89","text":"But... can we really give up like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_3_03_s_90","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_3_03_s_90","text":"... I don't think we can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_3_03_s_91","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_3_03_s_91","text":"I heard the Deputy Chiefs and the director already know that we've been assigned to this mission,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_3_03_s_92","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_3_03_s_92","text":"despite our misgivings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_3_03_s_93","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_3_03_s_93","text":"None of us want to carry out an operation when so many lives depend on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_3_03_s_94","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce004_3_03_s_94","text":"Ein! Rei! Zwei!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["marciana"],"affinity":null},{"id":"event_ce004_3_03_s_95","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_3_03_s_95","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_3_03_s_96","type":"Speech","speaker":"ein","key"