{"id":"d_counseling_nayuta_12","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 12","stage":null,"prev":"d_counseling_nayuta_11","next":"d_counseling_nayuta_13","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_12_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_12_1","text":"When stray thoughts do arise, oft do I retire to meditation.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_12_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_12_2","text":"By what means ridest thou thy mind of such vexations, Great Hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_12_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_12_3","text":"I listen to serene music.","jump":"d_counseling_nayuta_12_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_12_4","text":"I sing out loud.","jump":"d_counseling_nayuta_12_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_12_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_12_5","text":"To wash one's heart with a calm melody...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_12_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_12_6","text":"A method most serene, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_12_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_12_7","text":"This humble one shall also, should the opportunity arise, employ such a means.","jump":"d_counseling_nayuta_12_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_12_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_12_8","text":"Ha! A most audacious method, verily;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_12_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_12_9","text":"yet it accordeth not with this humble one.","jump":"d_counseling_nayuta_12_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_12_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_12_10","text":"With some time to spare, I meditate alongside Nayuta.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}