{"id":"event_goodworld_epilogue","cat":"event","group":{"id":"ev40107","label":"GOOD WORLD"},"label":"Dear Benefactor","stage":null,"prev":"event_goodworld_06_e","next":null,"speakers":{"snowcrane":"Snow Crane"},"icons":{"snowcrane":"si_c620_00_s"},"lines":[{"id":"event_goodworld_epilogue_1","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_1","text":"Dear Benefactor,\nIt has been some time since I last wrote to you.","jump":null,"exit":false,"enter":null,"bg":"Park","bgArt":"park","image":null,"bgm":"event_bgm_terminus_flowercamp","movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_2","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_2","text":"After fulfilling the final contract,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_3","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_3","text":"I now write to deliver my closing report.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_4","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_4","text":"In order to inform the foundation's children that their contracts were ending,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_5","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_5","text":"I came up to the Ark in person for the first time in a very long while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_6","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_6","text":"Since the day I reprimanded V.T.C., to be precise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_7","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_7","text":"I met Sarah, who now owns a cafe.","jump":null,"exit":false,"enter":null,"bg":"Cafe","bgArt":"cafe","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_8","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_8","text":"I also met with Oliver, who's had a wonderful life with the fine family he's built.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_9","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_9","text":"And, though I regrettably could not meet him in person,","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_10","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_10","text":"I also found Leo, who lived a truly devoted life,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_11","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_11","text":"and notified him of his contract's conclusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_12","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_12","text":"All three faithfully fulfilled their contracts over a long span of time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_13","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_13","text":"and as adults,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_14","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_14","text":"each succeeded in building a new family of their own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_15","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_15","text":"It is just as you wished.","jump":null,"exit":false,"enter":null,"bg":"ShoppingMall","bgArt":"shoppingmall","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_16","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_16","text":"I also witnessed how much the Ark has changed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_17","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_17","text":"Though illness, misfortune and death still cause people to suffer,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_18","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_18","text":"things appear to be like in the times before the war, just as you dreamed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_19","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_19","text":"with people free to live normal lives once more, laughing and crying over beautifully trivial things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_20","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_20","text":"Some people view these changes,","jump":null,"exit":false,"enter":null,"bg":"Cafe","bgArt":"cafe","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_21","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_21","text":"and claim peace has made society complacent, and that we are heading in the wrong direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_22","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_22","text":"They do not believe the world has become a better place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_23","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_23","text":"Others see the same world,","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_24","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_24","text":"and point out how people now help each other,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_25","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_25","text":"indicating the world is becoming good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_26","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_26","text":"As you once said,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_27","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_27","text":"the fact that opinions are split down the middle may itself be proof that the Ark has undergone a meaningful change.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_28","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_28","text":"Oh, and Oliver asked me to be sure to tell you something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_29","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_29","text":"He is grateful to have been allowed to live his life as a human being.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_30","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_30","text":"He, Sarah, and Leo all miss you dearly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_31","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_31","text":"I wanted to be certain I conveyed that to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_32","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_32","text":"Also, through all of these moments,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_33","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_33","text":"I was together with the child you had hoped would be born out of V.T.C.'s efforts.","jump":null,"exit":false,"enter":null,"bg":"Park","bgArt":"park","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_34","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_34","text":"I watched him comfort a child who had lost her teddy bear,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_35","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_35","text":"accompany someone who'd lost their way to the place they needed to go,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_36","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_36","text":"help someone find closure who had been hesitant and wavering,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_37","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_37","text":"and, in general, offer his time and heart willingly for the sake of others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_38","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_38","text":"He has grown into such a kind person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_39","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_39","text":"And that is not all.","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_40","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_40","text":"He has also achieved what no one else ever has:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_41","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_41","text":"he achieved the astounding feat of reclaiming a part of the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_42","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_42","text":"While he did say he feels a great deal of pressure,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_43","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_43","text":"I believe he is growing into exactly the kind of person you once hoped for,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_44","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_44","text":"someone who will one day lead humanity toward a better world.","jump":null,"exit":false,"enter":null,"bg":"TechIndoor_n","bgArt":"techindoor_n","image":null,"bgm":null,"movie":null,"shown":["snowcrane"],"affinity":null},{"id":"event_goodworld_epilogue_45","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_45","text":"And so... now that all contracts with the foundation have come to an end,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_46","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_46","text":"I wish to watch what choices he will make from here onward,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_47","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_47","text":"and what direction the world will take because of those choices.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_48","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_48","text":"For the very first time, I am choosing to do this not as part of a contract or a promise,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_49","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_49","text":"but of my own will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_50","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goodworld_epilogue_50","text":"Snow Crane lifts her gaze from the letter she has been reading and looks ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_51","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_51","text":"I hope... you will watch together with me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_52","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_52","text":"as he creates the future that you long hoped for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_53","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goodworld_epilogue_53","text":"Snow Crane bows her head deeply.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_54","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_54","text":"With this, I conclude my report and formally bring the foundation's contracts to a close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_55","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_epilogue_55","text":"Thank you... for everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_56","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goodworld_epilogue_56","text":"The room is filled with a red glow. Snow Crane turns around, putting the giant coffin behind her,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_epilogue_57","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_goodworld_epilogue_57","text":"and walks forward without looking back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}