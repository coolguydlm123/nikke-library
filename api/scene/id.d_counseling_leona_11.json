leona_11_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_11_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_leona_11_13","text":"I have a conversation with Leona about cute animals.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}