{"id":"d_counseling_leona_11","cat":"counsel","group":{"id":"char5092","label":"Leona"},"label":"Advising Leona: 11","stage":null,"prev":"d_counseling_leona_10","next":"d_counseling_leona_12","speakers":{"leona":"Leona"},"icons":{"leona":"si_c382_00_s"},"lines":[{"id":"d_counseling_leona_11_1","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_11_1","text":"There were three bears in one house. Daddy bear, mommy bear, baby bear.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["leona"],"affinity":"_0"},{"id":"d_counseling_leona_11_2","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_11_2","text":"You know what I've always found fascinating?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_11_3","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_11_3","text":"Bears can be such ferocious creatures, but they're oftentimes viewed as cute and cuddly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_11_4","text":"I think we have teddy bears to thank for that.","jump":"d_counseling_leona_11_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_leona_11_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_11_5","text":"That's because bears are cute.","jump":"d_counseling_leona_11_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_leona_11_6","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseli