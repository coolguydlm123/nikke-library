{"id":"d_counseling_crow_10","cat":"counsel","group":{"id":"char5025","label":"Crow"},"label":"Advising Crow: 10","stage":null,"prev":"d_counseling_crow_09","next":"d_counseling_crow_11","speakers":{"crow":"Crow"},"icons":{"crow":"si_c110_00_s"},"lines":[{"id":"d_counseling_crow_10_1","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_1","text":"You know, it might be hard to believe, but actually I love idealists like you.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["crow"],"affinity":"_0"},{"id":"d_counseling_crow_10_2","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_2","text":"Can you guess why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crow_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_crow_10_3","text":"Because you enjoy breaking their ideals.","jump":"d_counseling_crow_10_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_crow_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_crow_10_4","text":"Because, deep down, you're an idealist, too.","jump":"d_counseling_crow_10_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_crow_10_5","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_5","text":"Ha! You must be a mind reader.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crow_10_6","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_6","text":"There is nothing more beautiful than a pompous idealist's frustration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crow_10_7","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_7","text":"Fireworks are most beautiful when they explode. It's kind of like that.","jump":"d_counseling_crow_10_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crow_10_8","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_8","text":"Why would you say something like that about me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crow_10_9","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_9","text":"Don't project your childish wishes on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crow_10_10","type":"Speech","speaker":"crow","key":"Locale_Counseling:d_counseling_crow_10_10","text":"I never think so because I'm a sociopath. I just pretend to be the same kind when they benefit me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crow_10_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_crow_10_11","text":"I get to understand Crow a little better.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}