{"id":"d_counseling_signal_01","cat":"counsel","group":{"id":"char5015","label":"Signal"},"label":"Advising Signal: 01","stage":null,"prev":null,"next":"d_counseling_signal_02","speakers":{"signal":"Signal"},"icons":{"signal":"si_c022_00_s"},"lines":[{"id":"d_counseling_signal_01_1","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_1","text":"Commander, no matter how I look at it, Delta seems so friendly and thoughtful.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["signal"],"affinity":"_0"},{"id":"d_counseling_signal_01_2","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_2","text":"But, everybody else says she's not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_3","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_3","text":"What about you, Commander? What do you think of her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_signal_01_4","text":"Delta is many things, but 'thoughtful' isn't one of them.","jump":"d_counseling_signal_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_signal_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_signal_01_5","text":"I think she's a good person as well, and very friendly.","jump":"d_counseling_signal_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_signal_01_6","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_6","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_7","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_7","text":"I-I'm sorry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_8","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_8","text":"I didn't realize you felt the same way everybody else does.","jump":"d_counseling_signal_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_9","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_9","text":"That's right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_10","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_10","text":"I knew you'd feel the same way that I do!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_11","type":"Speech","speaker":"signal","key":"Locale_Counseling:d_counseling_signal_01_11","text":"I'm glad. I was starting to think I needed to get my eyes checked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_signal_01_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_signal_01_12","text":"Signal tells me about all of Delta's positive qualities.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}