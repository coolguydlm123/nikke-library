_npc_day3_03_6","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_npc_day3_03_6","text":"I'm so happy that I was able to find a solution to this problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day3_03_7","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_npc_day3_03_7","text":"If you have time, could you help me spread out the sand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day3_03_8","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_npc_day3_03_8","text":"Oh, and one more thing:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day3_03_9","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_npc_day3_03_9","text":"I'm planning on re-opening the bamboo forest. I'm sure you'll find it interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day3_03_10","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_npc_day3_03_10","text":"I'll go over the details with you tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_npc_day3_03_11","type":"Narration","speaker":null,"key":"Locale_SubScenario:snowfall_speech_npc_day3_03_11","text":"I have a casual conversation with Ludmilla while helping her spread the sand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}