p.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_14_13","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_14_13","text":"I'll go to your room later, Commander, so you'd better be ready!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_14_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_anis_star_14_14","text":"Anis and I talk about Neon's glasses.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}