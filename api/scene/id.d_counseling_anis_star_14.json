{"id":"d_counseling_anis_star_14","cat":"counsel","group":{"id":"char5169","label":"Anis: Star"},"label":"Advising Anis: Star: 14","stage":null,"prev":"d_counseling_anis_star_13","next":"d_counseling_anis_star_15","speakers":{"anis_i":"Anis"},"icons":{"anis_i":"si_c017_00_s"},"lines":[{"id":"d_counseling_anis_star_14_1","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_14_1","text":"Feels like Neon doesn't shout \"Vision Eye!\" as much these days.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis_i"],"affinity":"_0"},{"id":"d_counseling_anis_star_14_2","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_14_2","text":"Maybe it's because her glasses don't glint anymore?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_14_3","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_14_3","text":"Back then, I'd get so exasperated every time she did it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_14_4","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_14_4","text":"Now that it's stopped, I kinda miss it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_14_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_star_14_5","text":"What if we got her a new pair of glinting glasses?","jump":"d_counseling_anis_star_14_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anis_star_14_6","type":"Choice","speaker":null,