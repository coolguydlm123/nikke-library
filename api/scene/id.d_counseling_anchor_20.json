{"id":"d_counseling_anchor_20","cat":"counsel","group":{"id":"char5063","label":"Anchor"},"label":"Advising Anchor: 20","stage":null,"prev":"d_counseling_anchor_19","next":null,"speakers":{"anchor":"Anchor","Self":"Commander","Narration":"Narration"},"icons":{"anchor":"si_c351_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_counseling_anchor_20_1","type":"Speech","speaker":"anchor","key":"Locale_Counseling:d_counseling_anchor_20_1","text":"I feel so happy whenever Mast and Helm are near me,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anchor"],"affinity":"_0"},{"id":"d_counseling_anchor_20_2","type":"Speech","speaker":"anchor","key":"Locale_Counseling:d_counseling_anchor_20_2","text":"but I don't know how to express that and tell them how I feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anchor_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anchor_20_3","text":"Imagine them as sea creatures.","jump":"d_counseling_anchor_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anchor_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anchor_20_4","text":"I don't think you have to tell them. I'm sure they already know.","jump":"d_counseling_anchor_20_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_anchor_20_5","type":"Speech","speaker":"anchor","key":"Locale_Counseling:d_counseling_anchor_20_5","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anchor_20_6","type":"Speech","speaker":"anchor","key":"Locale_Counseling: