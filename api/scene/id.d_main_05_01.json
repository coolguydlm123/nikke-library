{"id":"d_main_05_01","cat":"main","group":{"id":"ch5","label":"Chapter 5 · Wonderland"},"label":"Snow Land","stage":"5-1 STAGE · Start","prev":null,"next":"d_main_05_02","speakers":{"shifty":"Shifty","neon":"Neon","anis":"Anis","rapi":"Rapi","Self":"Commander","Narration":"Narration"},"icons":{"shifty":"si_c907_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_05_01_1","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_1","text":"Test, test. Do you copy?","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":"bgm_secondhand","movie":null,"shown":["anis","neon","rapi","shifty"],"affinity":null},{"id":"d_main_05_01_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_01_2","text":"Hey Anis, catch!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_01_3","text":"Holy moly! How'd you end up with such a big snowball?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_01_4","text":"The bigger the better!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_01_5","text":"No, no, you've got it all wrong. It's not the size that counts in a snowball fight,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_01_6","text":"it's how many you can make. You've got to crank those suckers out as quickly as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_01_7","text":"So... like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_01_8","text":"Ah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_01_9","text":"Hahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_10","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_01_10","text":"Ohohoho!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_12","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_12","text":"Terribly sorry to spoil all the fun, but does anyone copy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_13","text":"Yes, this is Rapi. Over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_14","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_14","text":"Good, at least Rapi's decided to acknowledge me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_15","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_15","text":"The density of Alva Particles in the north is very low, so I won't commence the purge sequence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_16","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_16","text":"There shouldn't be any obstacles on the way to the research base, and the route is simple enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_17","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_17","text":"The problem is the ice and snow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_18","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_18","text":"I'm unable to give you an estimate on just how much of it there is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_19","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_19","text":"So you have to be careful, particularly of the ice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_20","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_01_20","text":"Why is ice more dangerous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_21","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_21","text":"Well... because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_22","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_22","text":"Because us Nikkes aren't exactly lightweight. There's always the danger of ice breaking underneath our feet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_23","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_05_01_23","text":"A sentence no girl should ever have to utter...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_01_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_25","text":"Then let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_26","text":"Anis, Neon. Enough with the snowball fight. It's time to...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_27","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_05_01_27","text":"*Thunk*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_01_29","text":"Bullseye!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_01_30","text":"Nice shot! You didn't use to play baseball by any chance, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_01_31","text":"Nope, natural-born talent, baby!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_32","text":"... Commander, let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_01_33","text":"... You've got a little something on your face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_34","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_01_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_01_35","text":"Hmph.","jump":null,"