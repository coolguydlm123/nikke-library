_05_58","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_58","text":"That's actually something they should believe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_59","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_59","text":"You should make note of this, Moron.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_60","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_60","text":"After all, the greatest villain must know how to manipulate people just like how I'm doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_61","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_61","text":"In order to do so, I must first earn their trust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_62","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_62","text":"First, I'll make them trust me, then gradually bring them to my side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_63","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_63","text":"Soon, they'll become my followers and willingly obey my every word!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_64","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_65","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_65","text":"You don't seem to believe me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_66","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_66","text":"But there's already someone who became my follower through this method.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_67","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_67","text":"In fact, I'll be meeting them tomorrow to have a little chat!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_68","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_68","text":"You do know that's a charity ambassador meeting?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_69","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_05_69","text":"The ambassador meeting is nothing more than a cover.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_05_70","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_gr