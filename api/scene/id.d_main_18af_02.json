":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_18af_02_55","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_18af_02_55","text":"You're one of my top Nikkes.\nYou're worlds apart from those other junk heaps!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_18af_02_56","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_18af_02_56","text":"I always knew you'd get back on your feet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_18af_02_57","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_18af_02_57","text":"Syuen... thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_18af_02_58","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_18af_02_58","text":"No... thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_18af_02_59","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_18af_02_59","text":"You know I've always wanted to be a hero, and so you turned me into a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_18af_02_60","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_18af_02_60","text":"You gave me the incredible strength needed to defeat the bad guys.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_18af_02_61","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_18af_02_61","text":"C'mon,\nthis is starting to get a bit schmaltzy!","jump"