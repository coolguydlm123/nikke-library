isode:d_nikke_neon_visioneye_05_20","text":"You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neon_visioneye_05_21","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_neon_visioneye_05_21","text":"Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neon_visioneye_05_22","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_neon_visioneye_05_22","text":"How was today?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neon_visioneye_05_23","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_neon_visioneye_05_23","text":"You must've been tired, following me around all day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neon_visioneye_05_24","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_neon_visioneye_05_24","text":"Not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neon_visioneye_05_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_neon_visioneye_05_25","text":"I'm glad that I got to see for myself where you came from and how you lived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neon_visioneye_05_26","type":"Speech","speaker":"neon_v","key":"Locale_NikkeEpisode:d_nikke_neon_visioneye_05_26","text":"Thank you for saying that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_neon_visioneye_05_27",