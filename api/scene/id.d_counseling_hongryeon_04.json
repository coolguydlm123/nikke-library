{"id":"d_counseling_hongryeon_04","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 04","stage":null,"prev":"d_counseling_hongryeon_03","next":"d_counseling_hongryeon_05","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_04_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_04_1","text":"What is my Lord's opinion on farming?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_04_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_04_2","text":"It would be a rewarding job.","jump":"d_counseling_hongryeon_04_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_04_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_04_3","text":"Just hearing that word makes my body ache.","jump":"d_counseling_hongryeon_04_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_04_4","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_04_4","text":"My thoughts exactly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_04_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_04_5","text":"We give the land our labor, and the land provides us with sustenance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_04_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_04_6","text":"Certainly there is no reward more certain, more logical than this.","jump":"d_counseling_hongryeon_04_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_04_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_04_7","text":"Could this be due to my Lord never having been trained on a daily basis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_04_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_04_8","text":"I must say, I expected my Lord to have a better appreciation of the philosophy behind tending the land.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_04_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_04_9","text":"The thought saddens me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_04_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_04_10","text":"I have a conversation with Scarlet about farming.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}