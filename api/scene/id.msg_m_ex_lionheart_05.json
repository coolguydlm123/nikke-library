{"id":"msg_m_ex_lionheart_05","cat":"messenger","group":{"id":"room_lionheart","label":"Lion Cubs · Group"},"label":"5. Ever since Guillotine left,","stage":null,"prev":"msg_m_ex_lionheart_04","next":null,"speakers":{"biscuit":"Biscuit","nero":"Nero","leona":"Leona"},"icons":{"biscuit":"si_c381_00_s","nero":"si_c380_00_s","leona":"si_c382_00_s"},"lines":[{"id":"msg_m_ex_lionheart_05_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 103720112 · After Lion Cubs chat 4. Hello,","key":null},{"id":"m_ex_lionheart_05_1","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_lionheart_05_1","text":"Ever since Guillotine left,","jump":null},{"id":"m_ex_lionheart_05_2","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_lionheart_05_2","text":"it's been just us","jump":null},{"id":"m_ex_lionheart_05_3","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_lionheart_05_3","text":"in this group chat.","jump":null},{"id":"m_ex_lionheart_05_4","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_lionheart_05_4","text":"And?","jump":null},{"id":"m_ex_lionheart_05_5","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_lionheart_05_5","text":"Don't we already have a Happy Zoo group chat?","jump":null},{"id":"m_ex_lionheart_05_6","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_6","text":"You're right.","jump":null},{"id":"m_ex_lionheart_05_7","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_7","text":"If we keep this one going, it might get confusing.","jump":null},{"id":"m_ex_lionheart_05_8","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_8","text":"We should leave this one.","jump":null},{"id":"m_ex_lionheart_05_9","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_lionheart_05_9","text":"All right,","jump":null},{"id":"m_ex_lionheart_05_10","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_lionheart_05_10","text":"let's move everything back to the regular group chat.","jump":null},{"id":"m_ex_lionheart_05_11","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_lionheart_05_11","text":"Biscuit left the group chat.","jump":null},{"id":"m_ex_lionheart_05_12","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_lionheart_05_12","text":"See ya, meow.","jump":null},{"id":"m_ex_lionheart_05_13","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_lionheart_05_13","text":"Nero left the group chat.","jump":null},{"id":"m_ex_lionheart_05_14","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_14","text":"Ah.","jump":null},{"id":"m_ex_lionheart_05_15","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_15","text":"Hmm...","jump":null},{"id":"m_ex_lionheart_05_16","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_16","text":"By the way,","jump":null},{"id":"m_ex_lionheart_05_17","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_17","text":"I talked to Mustang.","jump":null},{"id":"m_ex_lionheart_05_18","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_18","text":"There weren't any major issues.","jump":null},{"id":"m_ex_lionheart_05_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_lionheart_05_19","text":"Are you sure? I heard they stripped you of your animal care qualifications.","jump":null},{"id":"m_ex_lionheart_05_20","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_20","text":"So you already heard.","jump":null},{"id":"m_ex_lionheart_05_21","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_21","text":"It's true, but they can be easily regained by taking a simple test.","jump":null},{"id":"m_ex_lionheart_05_22","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_22","text":"There's no need to get bent out of shape over it.","jump":null},{"id":"m_ex_lionheart_05_23","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_23","text":"Considering how flagrant a violation","jump":null},{"id":"m_ex_lionheart_05_24","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_24","text":"releasing captive animals back to the surface is,","jump":null},{"id":"m_ex_lionheart_05_25","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_25","text":"I was worried that I might be expelled from the squad.","jump":null},{"id":"m_ex_lionheart_05_26","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_26","text":"I should be grateful that it basically ended with a slap on the wrist.","jump":null},{"id":"m_ex_lionheart_05_27","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_27","text":"Thanks again for all your help, Zoo Keeper.","jump":null},{"id":"m_ex_lionheart_05_28","type":"Speech","speaker":"leona","key":"Locale_SuddenMessage:m_ex_lionheart_05_28","text":"I'll talk to you later in the group chat.","jump":null},{"id":"m_ex_lionheart_05_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_lionheart_05_29","text":"Okay.","jump":null},{"id":"m_ex_lionheart_05_30","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_lionheart_05_30","text":"Leona left the group chat.","jump":null},{"id":"m_ex_lionheart_05_31","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_lionheart_05_31","text":"It feels a bit sad to let this group chat fade into nothing.","jump":null},{"id":"m_ex_lionheart_05_32","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_lionheart_05_32","text":"I think I'll keep it around as a keepsake.","jump":null}],"chat":true}