{"id":"d_main_27_01_s","cat":"main","group":{"id":"ch27","label":"Chapter 27 · Exploration"},"label":"Pathfinder, Miner, Electrician: A","stage":"27-3 STAGE · Start","prev":null,"next":"d_main_27_01_e","speakers":{"hammering":"Hammering","liveryn":"Liveryn","elegg":"Elegg","rapi":"Rapi","anis":"Anis","neon":"Neon"},"icons":{"hammering":"si_c490_00_s","liveryn":"si_c480_00_s","elegg":"si_c500_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_27_01_s_1","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_1","text":"Darn, there are too many of them!","jump":null,"exit":false,"enter":null,"bg":"Desert_04","bgArt":"desert_04","image":null,"bgm":"bgm_spot_dwn_a","movie":null,"shown":["elegg","hammering","liveryn"],"affinity":null},{"id":"d_main_27_01_s_2","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_2","text":"All the Raptures in the vicinity must have been alerted by these ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_3","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_3","text":"I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_4","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_4","text":"I tried to be careful, but apparently it didn't work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_5","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_5","text":"Didn't we say we were gonna get off somewhere safe and hoof it for the rest of the journey?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_6","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_6","text":"Oh, that's right! Sorry, it completely slipped my mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_7","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_7","text":"Hehe, you should have heard yourself, Ms. Hammering. You were sawing logs like nobody's business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_8","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_8","text":"Huh? I was?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_9","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_9","text":"I usually don't snore, but I guess I got comfortable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_10","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_10","text":"I think your snoring was louder than the scooter engine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_11","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_11","text":"That's probably why the Raptures came running.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_12","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_12","text":"Wa... was it really that bad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_13","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_13","text":"No, it wasn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_14","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_14","text":"Why didn't you wake me up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_15","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_15","text":"I kept saying we should, but Ms. Liveryn was all like, \"No, we shouldn't do that!\" and stopped me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_16","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_16","text":"And look where we are now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_17","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_17","text":"... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_18","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_18","text":"Don't apologize.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_19","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_19","text":"I take it as a point of pride that you felt so comfortable on Blue Hurricane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_20","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_20","text":"You also must have been really pooped to be able to fall asleep while we're up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_21","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_21","text":"It's all good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_22","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_22","text":"Okay...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_23","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_23","text":"I'm sensing an opening in their ranks at 4 o'clock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_24","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_24","text":"Hammering, can you bust through it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_25","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_25","text":"You bet I can!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_26","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_01_s_26","text":"I'm gonna pound these chumps into dust!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_27_01_s_27","text":"Hammering hurls herself towards the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_28","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_28","text":"Shouldn't we take it easy? We fired off the signal flare, so help should be coming soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_29","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_29","text":"If it means taking out more Raptures, then I'm all for her doing her thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_30","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_31","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_31","text":"Is that how you feel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_32","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_32","text":"?? Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_33","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_33","text":"Sorry, I didn't mean to be argumentative.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_34","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_34","text":"Ha, don't worry about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_35","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_36","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_36","text":"When can we expect the Counters, anyway? I feel like it's been a while since we let off that flare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_37","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_37","text":"Based on our distance from Reclamation Site 01, if they're operating on an ordinary response time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_38","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_38","text":"they should be visible right about now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi","anis","neon"],"affinity":null},{"id":"d_main_27_01_s_39","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_01_s_39","text":"Raptures spotted. Visual confirmation on three Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_01_s_40","text":"How'd they manage to get themselves completely surrounded?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_41","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_01_s_41","text":"Let's hurry and rescue them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_42","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_43","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_01_s_43","text":"Hehe. You're good at this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_01_s_44","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_01_s_44","text":"It's what I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}