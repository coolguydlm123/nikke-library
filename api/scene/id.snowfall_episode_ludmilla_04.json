ity":null},{"id":"snowfall_episode_ludmilla_04_58","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_62","text":"\"but this place does feel a little desolate today.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_59","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_63","text":"\"It's not a holiday, but I think I'll go take a bath with my sister tonight.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_60","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_64","text":"And the next page.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_61","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_65","text":"\"I heard there's gonna be a blood moon tonight.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_62","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_66","text":"\"No wonder there are more customers than usual.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_63","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_67","text":"\"If I had time, I'd make a wish on the walking trail.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_64","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_68","text":"\"For my beloved sister.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_65","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_69","text":"\"May she be happy forever.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_66","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_70","text":"Next page.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_67","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_71","text":"\"We had a clear night sky tonight, which the guests were very pleased with.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_68","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_72","text":"\"Seems they got a real kick out of soaking in the hot spring with a blood moon out.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_69","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_73","text":"\"As I tidied up, I told my sister what happened yesterday.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_70","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_74","text":"\"I had made a wish, and the hot spring turned red.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_71","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_75","text":"\"After she heard the story, my sister was upset that I hadn't taken her with me.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_72","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_76","text":"\"We promised to make a wish together on the walking trail next time.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_73","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_77","text":"The pages detail the daily thoughts and happenings of the author.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_74","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_78","text":"It really gives you a sense of the daily routine of this place, doesn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_75","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_79","text":"The fact I'm able to breathe new life into a place that holds so many precious memories is something I take great pride in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_76","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_80","text":"Ludmilla continues to peruse through the guest list for some time, recounting the stories within the pages to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_77","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_81","text":"Before either of us realize it, my cup of tea is empty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_78","type":"Self","speaker":"Self","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_82","text":"I've finished my tea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_79","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_83","text":"Already?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_80","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_84","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_81","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_85","text":"Hehe, I can't remember the last time I was this content.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_82","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_86","text":"Sorry, I've been talking too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_83","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_87","text":"I need to get back to my duties so you can rest for a little longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_84","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_88","text":"Or, if you're so inclined, you could read some of these books yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_85","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_89","text":"So long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_86","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_90","text":"After Ludmilla leaves, I go to pick up the guest book.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_87","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_91","text":"As I'm pulling it towards me, a photo falls out from between the pages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_88","type":"Self","speaker":"Self","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_92","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_89","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_93","text":"It is a family photo of a husband and wife and their three daughters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_90","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_94","text":"But there's something off-putting about it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_91","type":"Self","speaker":"Self","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_95","text":"Their faces...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_92","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_96","text":"Each of the family members has an X drawn on their face except the oldest and youngest daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_93","type":"Self","speaker":"Self","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_97","text":"There are words written on the back of the photo as well,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_94","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_98","text":"in neat and tidy handwriting:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_ludmilla_04_95","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:snowfall_episode_ludmilla_04_99","text":"\"The Happy Lumi Family\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}