01_53","type":"Speech","speaker":"moran","key":"Locale_NikkeEpisode:treasurestory_moran_01_53","text":"I know, you don't have to say anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_moran_01_54","type":"Speech","speaker":"moran","key":"Locale_NikkeEpisode:treasurestory_moran_01_54","text":"I was thinking about getting some new clothes not too long ago,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_moran_01_55","type":"Speech","speaker":"moran","key":"Locale_NikkeEpisode:treasurestory_moran_01_55","text":"but I kept feeling like maybe it'd be too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_moran_01_56","type":"Speech","speaker":"moran","key":"Locale_NikkeEpisode:treasurestory_moran_01_56","text":"And then when I actually tried to pick something, I had no clue what to choose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_moran_01_57","type":"Speech","speaker":"jin","key":"Locale_NikkeEpisode:treasurestory_moran_01_57","text":"You should've asked me or the others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_moran_01_58","type":"Speech","speaker":"moran","key":"Locale_NikkeEpisode:treasurestory_moran_01_58","text":"How could I ask such a thing? It's embarrassing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_moran_01_59","type":"Speech","speaker":"jin","key":"Locale_NikkeEpisode:treasurestory_moran_01_59","text":"What time's your date?","jum