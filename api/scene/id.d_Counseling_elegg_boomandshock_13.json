{"id":"d_Counseling_elegg_boomandshock_13","cat":"counsel","group":{"id":"char5146","label":"Elegg: Boom and Shock"},"label":"Advising Elegg: Boom and Shock: 13","stage":null,"prev":"d_Counseling_elegg_boomandshock_12","next":"d_Counseling_elegg_boomandshock_14","speakers":{"elegg_s":"Elegg"},"icons":{"elegg_s":"si_c502_00_s"},"lines":[{"id":"d_Counseling_elegg_boomandshock_13_01","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_01","text":"This glove I'm wearing is insulated and shock-resistant.","jump":null,"exit":false,"enter":null,"bg":"Deck_d","bgArt":"deck_d","image":null,"bgm":"bgm_story_summermood","movie":null,"shown":["elegg_s"],"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_02","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_02","text":"It's super useful when I'm working.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_03","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_03","text":"It's a shame I've only got one, but I need my other hand for other tasks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_04","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_04","text":"Wanna check it out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_05","type":"Choice","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_05","text":"Examine Elegg's gloved hand.","jump":"d_Counseling_elegg_boomandshock_13_07","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_Counseling_elegg_boomandshock_13_06","type":"Choice","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_06","text":"Examine Elegg's bare hand.","jump":"d_Counseling_elegg_boomandshock_13_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_Counseling_elegg_boomandshock_13_07","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_07","text":"What do you think? Feels pretty nice, doesn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_08","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_08","text":"It's breathable material, so there's no sweat buildup, and it's so light, that it barely feels like you have it on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_09","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_09","text":"Don't get any ideas though! I've only got this one, so quit staring at it like that!","jump":"d_Counseling_elegg_boomandshock_13_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_10","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_10","text":"Hey!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_11","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_11","text":"Not that hand!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_12","type":"Self","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_12","text":"Do you not like it when people touch your hands?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_13","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_13","text":"It's not that, it's just... you startled me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_14","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_14","text":"Now that I think about it, I don't think you've ever really touched my hand before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_15","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_15","text":"Hmm... So this is what it feels like...","jump":"d_Counseling_elegg_boomandshock_13_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_13_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_13_16","text":"I spend some time examining Elegg's hand.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}