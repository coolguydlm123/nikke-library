{"id":"d_counseling_noah_20","cat":"counsel","group":{"id":"char5043","label":"Noah"},"label":"Advising Noah: 20","stage":null,"prev":"d_counseling_noah_19","next":null,"speakers":{"noah":"Noah"},"icons":{"noah":"si_c232_00_s"},"lines":[{"id":"d_counseling_noah_20_1","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_1","text":"Your body is so fragile compared to a Nikke's.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["noah"],"affinity":"_0"},{"id":"d_counseling_noah_20_2","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_2","text":"Have you ever thought about swapping it for a mechanical body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_noah_20_3","text":"I want to become strong while remaining a human.","jump":"d_counseling_noah_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_noah_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_noah_20_4","text":"I'm not opposed to the idea.","jump":"d_counseling_noah_20_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_noah_20_5","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_5","text":"Huh? So to you, if your body is mechanical, that means you're no longer human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_6","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_6","text":"Then the real Commander is a monst...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_7","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_7","text":"... Oh. That actually makes sense.","jump":"d_counseling_noah_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_8","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_8","text":"Wow. For such a puny little creature, you certainly are determined.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_9","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_9","text":"Very good. Well then, shall we head up to the surface and gather some parts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_10","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_10","text":"Wait for a second...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_11","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_20_11","text":"Now that I think about it... If you get stronger, then I wouldn't be able to keep making fun of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_20_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_noah_20_12","text":"I have a conversation with Noah about strengthening the body.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}