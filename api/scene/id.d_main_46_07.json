{"id":"d_main_46_07","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"Reinforcements","stage":"46-28 STAGE · Start","prev":"d_main_46_06","next":"d_main_46_08","speakers":{"mirror_r":"Mirror","nayuta":"Nayuta","snowwhite_h":"Snow White","janghwa_n":"Rose"},"icons":{"mirror_r":"si_c982_00_s","nayuta":"si_c223_00_s","snowwhite_h":"si_c471_00_s","janghwa_n":"si_c971_01_s"},"lines":[{"id":"d_main_46_07_1","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_1","text":"All right, this is as far as we go.","jump":null,"exit":false,"enter":null,"bg":"SpaceStationRoad","bgArt":"spacestationroad","image":null,"bgm":"bgm_chapter46_field_redlight","movie":null,"shown":["snowwhite_h","nayuta","mirror_r","janghwa_n"],"affinity":null},{"id":"d_main_46_07_2","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_2","text":"I don't recommend going any further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_3","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_3","text":"We might get caught.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_4","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_4","text":"By your efforts, we have come thus far without great peril.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_5","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_5","text":"To know the lay of the land beforehand shall alone prove of great service.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_6","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_6","text":"Take it all in before you return. That's the only way you'll even stand a chance of winning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_7","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_07_7","text":"Sounds like you're saying we'd lose if we fought now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_8","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_8","text":"Of course. You have absolutely no chance of winning right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_9","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_9","text":"You're lucky that the Queen is focused on rebuilding her strength now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_10","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_10","text":"Do you honestly think you could stop her if she went after Eden and the Ark this very moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_11","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_07_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_12","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_12","text":"While she gathers strength, you must do the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_13","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_13","text":"By any means necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_14","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_14","text":"... I'm backing the losing side here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_15","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_15","text":"Siding with the Queen would make things so much easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_16","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_16","text":"And yet I'm going this far because I genuinely want you to win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_17","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_17","text":"So please, don't disappoint me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_18","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_07_18","text":"Talk is cheap. Give us something useful to work with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_19","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_20","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_20","text":"Fine. That's the reason I brought you here anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_21","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_21","text":"Rose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_22","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_07_22","text":"All right, all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_23","text":"Rose heads to a corner,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_24","text":"then proceeds to perform a peculiar sequence of steps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_25","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_25","text":"Oho. Hast thou brought us thus far merely that Swordwarden might unveil some secret dance techniques?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_26","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_07_26","text":"Come to think of it, Red Hood did a tap dance the day we first met Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_27","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_07_27","text":"... I told you we should have changed this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_28","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_28","text":"What's the harm. Besides, this way, no one will find out by accident either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_29","text":"The moment Rose completes her steps, the corner crackles to life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_30","text":"A human-sized container emerges.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_31","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_31","text":"Optical camouflage...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_32","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_32","text":"Would you mind opening it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_33","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_07_33","text":"Bodyguard... I'm nothing but an errand girl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_34","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_34","text":"I have no physical body, I don't have much of a choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_35","text":"Rose presses the button on the container.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_36","text":"With a hiss, the contents are revealed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_37","text":"Steel legs clad in red.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_oldtales_pathofharmony","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_38","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_38","text":"Red Shoes...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_39","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_39","text":"I kept them safe, as you can see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_40","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_40","text":"I tried everything I could to make replicas with them, but they don't seem compatible with Rapture technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_41","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_41","text":"Take them. Perhaps they'll come in handy somehow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_42","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_42","text":"This... shall prove of considerable aid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_43","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_43","text":"That's what I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_44","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_44","text":"And take one more thing with you. Rose, if you could.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_07_45","text":"Rose retrieves a small bag from inside the container and hands it to Snow White.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_46","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_07_46","text":"What's this? It's really heavy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_47","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_47","text":"It's a brain shelter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_48","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_07_48","text":"A brain shelter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_49","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_49","text":"Liberalio's head is inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_50","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_07_50","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_51","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_51","text":"What...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_52","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_52","text":"I don't know what possessed Liberalio, or why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_53","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_53","text":"But she proposed to the Queen a dialogue with humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_54","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_54","text":"I'll admit, I had some hope myself. I figured it might get through to the Queen even just a little, given it was coming from her second daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_55","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_55","text":"But...","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_44_02_4","bgArt":"eventscene_chap_44_02_4","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_56","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_56","text":"The Queen truly is a monster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_57","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_57","text":"Liberalio's words fell on deaf ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_58","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_58","text":"... Although, I honestly doubt dialogue was ever possible with her in the first place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_59","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_59","text":"She tore off Liberalio's head, frozen in ecstasy after meeting her beloved mother.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_44_02_3","bgArt":"eventscene_chap_44_02_3","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_60","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_60","text":"She kept only the body that had the core, and tossed the head away like trash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_61","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_61","text":"That's what I retrieved.","jump":null,"exit":false,"enter":null,"bg":"SpaceStationRoad","bgArt":"spacestationroad","image":null,"bgm":null,"movie":null,"shown":["snowwhite_h","nayuta","mirror_r","janghwa_n"],"affinity":null},{"id":"d_main_46_07_62","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_62","text":"Yet Heretics possess the capacity for regeneration by means of their core...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_63","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_63","text":"There's no core in her head. Unlike Indivilia, Liberalio didn't do something as grotesque as implanting a core fragment in her head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_64","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_64","text":"But her brain is still alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_65","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_65","text":"It should be enough to create a human imposter, at the very least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_66","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_07_66","text":"That is, when Eden has the technology to do so, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_07_67","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_07_67","text":"...","jump":null,"exit":false,"