{"id":"d_counseling_ether_12","cat":"counsel","group":{"id":"char3010","label":"Ether"},"label":"Advising Ether: 12","stage":null,"prev":"d_counseling_ether_11","next":"d_counseling_ether_13","speakers":{"ether":"Ether"},"icons":{"ether":"si_c291_00_s"},"lines":[{"id":"d_counseling_ether_12_1","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_1","text":"You know how people say the more bitter medicine tastes, the better it is for you?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ether"],"affinity":"_0"},{"id":"d_counseling_ether_12_2","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_2","text":"Do you think there's any truth to that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_12_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ether_12_3","text":"I think so.","jump":"d_counseling_ether_12_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ether_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ether_12_4","text":"That's just an old wives' tale.","jump":"d_counseling_ether_12_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ether_12_5","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_5","text":"You really think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_12_6","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_6","text":"Seriously?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_12_7","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_7","text":"I'll make this medicine as bitter as possible for you then.","jump":"d_counseling_ether_12_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_12_8","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_8","text":"Hmm... If you thought there was an element of truth to it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_12_9","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_9","text":"I was going to put it to the test and have you take some of this bitter medicine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_12_10","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_12_10","text":"You talked your way out of this one!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_12_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ether_12_11","text":"Ether and I talk about medication and whether its taste has any effect on the body.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}