{"id":"d_counseling_guilty_mightybunny_16","cat":"counsel","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Advising Guilty: Mighty Bunny: 16","stage":null,"prev":"d_counseling_guilty_mightybunny_15","next":"d_counseling_guilty_mightybunny_17","speakers":{"guilty_b":"Guilty"},"icons":{"guilty_b":"si_c404_00_s"},"lines":[{"id":"d_counseling_guilty_mightybunny_16_1","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_16_1","text":"Mana doesn't seem to like dressing as a bunny girl very much...","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty_b"],"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_16_2","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_16_2","text":"And I think she's planning to get really drunk later...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_16_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_16_3","text":"Why don't we drink with her?","jump":"d_counseling_guilty_mightybunny_16_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_mightybunny_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_16_4","text":"Why don't we drink too, just the two of us?","jump":"d_counseling_guilty_mightybunny_16_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_mightybunny_16_5","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_16_5","text":"Hm... I do like a good drink, but what if we get too drunk and somethin