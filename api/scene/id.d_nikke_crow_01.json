ull,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_48","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_48","text":"\"A terrorist attack by an Irregular.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_49","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_49","text":"I may be guilty, but I never touched a weapon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_50","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_01_50","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_51","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_51","text":"Exactly what I said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_52","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_52","text":"There were plenty of others shooting up the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_53","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_53","text":"So why did the media only focus on me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_54","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_54","text":"Could they be following orders from the Central Government?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_55","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_55","text":"... Well, things are getting interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_56","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_01_56","text":"Can you explain it so I can understand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_57","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_57","text":"... No need to rush. Take it slow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_58","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_58","text":"We've still got three whole days before the hearing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_59","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_59","text":"And if we're going to be stuck here in this boring Rehabilitation Center together,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_60","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_60","text":"we might as well save a few things to talk about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_61","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_61","text":"... Anyway, enough