ker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_20","text":"... Perhaps not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_21","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_21","text":"Do you like riddles?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_22","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crow_01_22","text":"Not really.","jump":"d_nikke_crow_01_24","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_23","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crow_01_23","text":"Yeah, I guess.","jump":"d_nikke_crow_01_25","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_24","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_24","text":"Then let's leave it at that for now.","jump":"d_nikke_crow_01_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_25","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_25","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_26","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_26","text":"Then you might as well use today's session to speculate a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_27","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_27","text":"Just don't get too caught up in it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_28","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_28","text":"Either way, the A.I. will have the final say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_29","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_29","text":"No point wearing yourself out trying to figure it out yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_30","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_30","text":"So why don't we just sit back and shoot the breeze for a while?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_31","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_31","text":"... Actually, could you show me today's news?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_32","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_32","text":"I'm curious what's going on out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_33","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_01_33","text":"I show her the news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_34","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_34","text":"Hmm, let's see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_35","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_35","text":"\"At approximately 8:33 this morning,\"","jump":null,"exit":false,"enter":null,"bg":"Park","bgArt":"park","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_36","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_36","text":"\"The Daily Ark, which has long warned of the dangers posed by Nikkes,\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_37","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_37","text":"\"was targeted in a terrorist attack by an Irregular.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_38","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_38","text":"\"Thousands of angry citizens gathered outside the Central Government building,\"","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_39","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_39","text":"\"where they expressed strong anti-Nikke sentiment\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_40","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_40","text":"\"by smashing Nikke effigies.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_4