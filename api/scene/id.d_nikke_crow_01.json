{"id":"d_nikke_crow_01","cat":"bond","group":{"id":"char5025","label":"Crow"},"label":"D-3","stage":null,"prev":null,"next":"d_nikke_crow_02","speakers":{"Narration":"Narration","crow":"Crow","Self":"Commander","Monologue":"Monologue"},"icons":{"Narration":"si_c999_00_s","crow":"si_c110_00_s"},"lines":[{"id":"d_nikke_crow_01_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_crow_01_1","text":"That afternoon, in the interrogation room at the Rehabilitation Center.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_2","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_2","text":"... Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_01_3","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_3","text":"So getting stuck in the Rehabilitation Center means the Commander gets called in to see me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_4","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_4","text":"Is it for interrogation... or mental health counseling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_5","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_5","text":"Either way, I guess we'll be seeing a lot of each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_6","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_01_6","text":"I heard you might be showing signs of a Mind Switch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_7","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_7","text":"No, there's nothing wrong with my brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_8","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_8","text":"It's just that whenever a Nikke does something humans can't understand,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_9","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_9","text":"the higher-ups are quick to slap a label on her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_10","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_01_10","text":"Something humans can't understand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_11","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_11","text":"Actually, I went to A.C.P.U. yesterday to turn myself in.","jump":null,"exit":false,"enter":null,"bg":"Police","bgArt":"police","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_12","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_01_12","text":"I told them I was the one behind the terrorist attack on the Daily Ark office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_01_13","type":"Speech","speaker":"crow","key":"Loc