{"id":"msg_m_ex_maxwell_03","cat":"messenger","group":{"id":"room_maxwell","label":"Maxwell · Nikke"},"label":"3. Cutey,","stage":null,"prev":"msg_m_ex_maxwell_02","next":"msg_m_ex_maxwell_04","speakers":{"maxwell":"Maxwell"},"icons":{"maxwell":"si_c102_00_s"},"lines":[{"id":"m_ex_maxwell_03_1","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_1","text":"Cutey,","jump":null},{"id":"m_ex_maxwell_03_2","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_2","text":"who do you think is worse?","jump":null},{"id":"m_ex_maxwell_03_3","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_3","text":"Laplace or Drake?","jump":null},{"id":"m_ex_maxwell_03_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_4","text":"Why are you asking that all of a sudden?","jump":null},{"id":"m_ex_maxwell_03_5","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_5","text":"Just answer the question.","jump":null},{"id":"m_ex_maxwell_03_6","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_6","text":"... That's a tough one.","jump":null},{"id":"m_ex_maxwell_03_7","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_7","text":"Always hollering about hero this and hero that.","jump":null},{"id":"m_ex_maxwell_03_8","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_8","text":"Running around like a bull in a china shop.","jump":null},{"id":"m_ex_maxwell_03_9","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_9","text":"Is it Laplace with her hero fixation?","jump":null},{"id":"m_ex_maxwell_03_10","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_10","text":"Or can it be Drake","jump":null},{"id":"m_ex_maxwell_03_11","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_11","text":"who is always prattling on about how she's a villain","jump":null},{"id":"m_ex_maxwell_03_12","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_12","text":"and starting fights but running with her tail between her legs","jump":null},{"id":"m_ex_maxwell_03_13","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_13","text":"the moment someone fights back?","jump":null},{"id":"m_ex_maxwell_03_14","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_14","text":"Who should I pick?","jump":null},{"id":"m_ex_maxwell_03_15","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_15","text":"Hmmm, you can't seem to give me an answer?","jump":null},{"id":"m_ex_maxwell_03_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_16","text":"That's a tough question.","jump":null},{"id":"m_ex_maxwell_03_17","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_17","text":"I know, right?","jump":null},{"id":"m_ex_maxwell_03_18","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_18","text":"It's a real doozy.","jump":null},{"id":"m_ex_maxwell_03_19","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_19","text":"Even I think so too.","jump":null},{"id":"m_ex_maxwell_03_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_20","text":"Is something the matter?","jump":null},{"id":"m_ex_maxwell_03_21","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_21","text":"It's nothing, really.","jump":null},{"id":"m_ex_maxwell_03_22","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_22","text":"They were just making a big stink today","jump":null},{"id":"m_ex_maxwell_03_23","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_23","text":"and being a nuisance, so it got me thinking...","jump":null},{"id":"m_ex_maxwell_03_24","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_24","text":"Who is worse?","jump":null},{"id":"m_ex_maxwell_03_25","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_25","text":"So...","jump":null},{"id":"m_ex_maxwell_03_26","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_26","text":"Hehehehehe","jump":null},{"id":"m_ex_maxwell_03_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_27","text":"So who did you choose?","jump":null},{"id":"m_ex_maxwell_03_28","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_28","text":"Me?","jump":null},{"id":"m_ex_maxwell_03_29","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_29","text":"Hehehehehehehe","jump":null},{"id":"m_ex_maxwell_03_30","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_30","text":"I just told you, didn't I?","jump":null},{"id":"m_ex_maxwell_03_31","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_31","text":"This is a real brainbuster.","jump":null},{"id":"m_ex_maxwell_03_32","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_32","text":"There's no way I can choose.","jump":null},{"id":"m_ex_maxwell_03_33","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_33","text":"Hahahahahahahahahahaha","jump":null},{"id":"m_ex_maxwell_03_34","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_34","text":"Hahahaha","jump":"m_ex_maxwell_03_36"},{"id":"m_ex_maxwell_03_35","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_35","text":"Sigh...","jump":"m_ex_maxwell_03_36"},{"id":"m_ex_maxwell_03_36","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_36","text":"I feel somewhat relieved","jump":null},{"id":"m_ex_maxwell_03_37","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_37","text":"to hear that","jump":null},{"id":"m_ex_maxwell_03_38","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_38","text":"you can't make up your mind as well.","jump":null},{"id":"m_ex_maxwell_03_39","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_39","text":"Personally, I hate it when I can't come to a conclusion.","jump":null},{"id":"m_ex_maxwell_03_40","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_40","text":"It doesn't matter how hard I rack my brain and","jump":null},{"id":"m_ex_maxwell_03_41","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_41","text":"how much I compare the two of them.","jump":null},{"id":"m_ex_maxwell_03_42","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_42","text":"Whenever I think one may possess more strengths,","jump":null},{"id":"m_ex_maxwell_03_43","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_43","text":"I'd think of a fatal flaw that offsets all those strengths.","jump":null},{"id":"m_ex_maxwell_03_44","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_44","text":"I really can't decide!","jump":null},{"id":"m_ex_maxwell_03_45","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_45","text":"Hehehehehe","jump":null},{"id":"m_ex_maxwell_03_46","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_46","text":"Hahahahaha","jump":"m_ex_maxwell_03_48"},{"id":"m_ex_maxwell_03_47","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_03_47","text":"Sigh...","jump":"m_ex_maxwell_03_49"},{"id":"m_ex_maxwell_03_48","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_48","text":"It's funny, isn't it?","jump":"m_ex_maxwell_03_52"},{"id":"m_ex_maxwell_03_49","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_49","text":"Now, now, don't be so bummed out.","jump":null},{"id":"m_ex_maxwell_03_50","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_50","text":"It's not like being around those two is anything new to me.","jump":null},{"id":"m_ex_maxwell_03_51","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_51","text":"I'm used to it by now.","jump":null},{"id":"m_ex_maxwell_03_52","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_52","text":"Hahahaha","jump":null},{"id":"m_ex_maxwell_03_53","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_53","text":"I haven't had a good laugh like this in ages!","jump":null},{"id":"m_ex_maxwell_03_54","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_54","text":"I have you to thank for that.","jump":null},{"id":"m_ex_maxwell_03_55","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_55","text":"Hahahaha","jump":null},{"id":"m_ex_maxwell_03_56","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_03_56","text":"I'll be in touch the next time I think of something amusing.","jump":null}],"chat":true}