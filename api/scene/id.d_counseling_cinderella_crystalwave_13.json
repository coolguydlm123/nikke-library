{"id":"d_counseling_cinderella_crystalwave_13","cat":"counsel","group":{"id":"char5175","label":"Cinderella: Crystal Wave"},"label":"Advising Cinderella: Crystal Wave: 13","stage":null,"prev":"d_counseling_cinderella_crystalwave_12","next":"d_counseling_cinderella_crystalwave_14","speakers":{"cinderella_s":"Cinderella"},"icons":{"cinderella_s":"si_c515_00_s"},"lines":[{"id":"d_counseling_cinderella_crystalwave_13_1","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_1","text":"I saw some children writing names in the sand.","jump":null,"exit":false,"enter":null,"bg":"JungleIsland_Out_d","bgArt":"jungleisland_out_d","image":null,"bgm":"event_bgm_wtu_seabreeze","movie":null,"shown":["cinderella_s"],"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_2","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_2","text":"They said if you write the name of your crush, your love will come true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_3","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_3","text":"Do you believe that's true, Prince?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_4","text":"I do.","jump":"d_counseling_cinderella_crystalwave_13_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_crystalwave_13_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_5","text":"I don't.","jump":"d_counseling_cinderella_crystalwave_13_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_crystalwave_13_6","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_6","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_7","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_7","text":"Truthfully, I don't believe in that sort of thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_8","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_8","text":"But watching those children believe in it as they wrote names in the sand was beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_9","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_9","text":"I hope their love comes true.","jump":"d_counseling_cinderella_crystalwave_13_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_10","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_13_10","text":"You're right. Love doesn't come true just by doing something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_13_11","type":"Speech","speaker":"cinderella_s","key":"Loca