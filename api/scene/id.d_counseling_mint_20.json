{"id":"d_counseling_mint_20","cat":"counsel","group":{"id":"char5172","label":"Mint"},"label":"Advising Mint: 20","stage":null,"prev":"d_counseling_mint_19","next":null,"speakers":{"mint_i":"Mint"},"icons":{"mint_i":"si_c600_00_s"},"lines":[{"id":"d_counseling_mint_20_1","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_20_1","text":"At a fan signing once, a fan told me she dreamed of becoming a pop star too,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mint_i"],"affinity":"_0"},{"id":"d_counseling_mint_20_2","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_20_2","text":"and asked me what I thought was the most important quality a pop star should have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mint_20_3","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_20_3","text":"What about you, Kitten?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mint_20_4","type":"Speech","speaker":"mint_i","key":"Locale_Counseling:d_counseling_mint_20_4","text":"What do you think is the most important quality for a pop star?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mint_20_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mint_20_5","text":"Self-care.","jump":"d_counseling_mint_20_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mint_20_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mint_20_6","text":"Love for your fans.","jump":"d_counseling_mint_20_11","