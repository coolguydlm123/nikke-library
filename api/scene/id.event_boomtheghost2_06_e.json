{"id":"event_boomtheghost2_06_e","cat":"event","group":{"id":"ev40085","label":"BOOM! THE GHOST! · Part 2"},"label":"Blessed be Life: B","stage":null,"prev":"event_boomtheghost2_06_s","next":"event_boomtheghost2_epilogue","speakers":{"elegg_s":"Elegg","rapi_ss":"Rapi","yan_s":"Yan","tove_s":"Tove","pepper_s":"Pepper","frima_s":"Frima","centi_s":"Centi","dorothy_s":"Dorothy","alfred":"Alfred"},"icons":{"elegg_s":"si_c502_00_s","rapi_ss":"si_c016_01_s","yan_s":"si_c201_01_s","tove_s":"si_c192_02_s","pepper_s":"si_c131_01_s","frima_s":"si_c142_01_s","centi_s":"si_c080_02_s","dorothy_s":"si_c234_00_s","alfred":"si_c9000_00_s"},"lines":[{"id":"event_boomtheghost2_06_e_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_1","text":"After taking down the Kraken, Dorothy doesn't come out of the room.","jump":null,"exit":false,"enter":null,"bg":"Deck_d","bgArt":"deck_d","image":null,"bgm":"bgm_frostpillar","movie":null,"shown":["elegg_s","rapi_ss"],"affinity":null},{"id":"event_boomtheghost2_06_e_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_2","text":"The Utopia safely changes direction and veers toward safe waters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_3","text":"After salvaging the Kraken and investigating the body, Elegg quietly calls me and Rapi over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_4","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_4","text":"The Kraken's power source wasn't replacing the Utopia's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_5","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_5","text":"For some reason I can't explain, the Kraken's own power source, i.e. its core,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_6","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_6","text":"had become drastically overpowered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_7","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_7","text":"What do you mean by overpowered?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_8","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_8","text":"Every machine is built with an output which matches its physical size.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_9","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_9","text":"With the Kraken, however, its output far exceeded what would be suitable for its body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_10","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_10","text":"That means it had to expend that energy somehow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_11","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_11","text":"Why is that a bad thing? Isn't more energy a good thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_12","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_12","text":"That's not always the case. Too much energy can put a strain on the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_13","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_13","text":"Take you, for instance. Let's say you had the strength to lift 10 tons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_14","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_14","text":"Sounds great to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_15","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_15","text":"The moment you attempted to lift that much weight, your bones would break and your muscles would tear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_16","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_17","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_17","text":"In other words, machines and living things alike need output levels which roughly correspond to their body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_18","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_18","text":"But this Kraken didn't have that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_19","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_19","text":"Therefore, it had to offload its excess energy somehow, and it seems it chose the Utopia as the outlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_20","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_20","text":"That's how the holograms on the Utopia Ship were able to remain functional, for better or for worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_21","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_21","text":"If this had happened before all the passengers passed away, the outcome would have been different...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_22","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_22","text":"But it's pointless to dwell on hypotheticals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_23","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_23","text":"So this Kraken was unable to contain its own power, and went about indiscriminately expelling the excess energy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_24","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_24","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_25","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_25","text":"As far as I can tell, parts of its body became holograms simply as a way to burn excess energy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_26","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_27","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_06_e_27","text":"Any guesses as to why the output became so large?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_28","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_28","text":"It's hard to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_29","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_29","text":"We encountered something similar to this once before, but we never figured out the cause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_30","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_30","text":"I guess it proves that once again, things like cores can't be trusted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_31","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_31","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_32","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_32","text":"Maybe I'm overthinking, but","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_33","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_33","text":"if time did this to the Kraken...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_34","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_34","text":"What does that mean for the Ark, and how much time it has left?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_35","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_35","text":"I thought dwelling on hypotheticals wasn't good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_36","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_36","text":"Oh, sorry! I got lost in thought for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_37","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_37","text":"Anyway, the Utopia is running fine right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_38","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_38","text":"We'll soon arrive at a point where we can return to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_39","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_39","text":"Good. That's a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_40","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_40","text":"Now the only question is what we're going to do with the ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_41","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_41","text":"Actually,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_42","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_42","text":"Alfred says it has something to say regarding that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_43","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_43","text":"It wants to tell us all at once though, once we've gathered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_44","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_44","text":"All right, let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_45","text":"*Bang bang bang bang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_46","text":"As we walk down the hallway, a loud banging on the door can be heard.","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":null,"movie":null,"shown":["yan_s","tove_s","pepper_s","centi_s","frima_s"],"affinity":null},{"id":"event_boomtheghost2_06_e_47","type":"Speech","speaker":"yan_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_47","text":"Hey! What are you doing in there? I said come out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_spookaboo","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_48","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_48","text":"I would suggest refraining from violence, as it's hardly conducive to survival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_49","type":"Speech","speaker":"yan_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_49","text":"How are you not pissed off about this?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_50","type":"Speech","speaker":"pepper_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_50","text":"No one got hurt. All she did was knock us out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_51","type":"Speech","speaker":"yan_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_51","text":"You say it like she did nothing wrong!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_06_e_52","text":"*Bang bang bang bang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_53","type":"Speech","speaker":"frima_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_53","text":"Ugh. Noisy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_54","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_06_e_54","text":"If you keep hitting the same spot, you're gonna break the door. Try knocking 10 centimeters to the right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_06_e_55","type":"Speech","speaker"