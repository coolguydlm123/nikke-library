milla_02_6","text":"I still have a lot of things left to do, so I decide to leave the walking trail.","jump":null,"exit":true,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_7","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_7","text":"Isn't it a lovely night?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_8","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_8","text":"Very much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_9","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_9","text":"What did you think of the cooking competition today?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_10","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_10","text":"It was wonderful to have everyone gathered in one spot for a big meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_11","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_11","text":"I'll have to thank Emma for organizing everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_12","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_12","text":"Although it would have been better if some of the other Nikkes would have participated as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_13","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_13","text":"Considering the fact that Emma organized everything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_14","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_14","text":"I trail off at the end of my sentence and get lost in my thoughts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_15","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_15","text":"Oddly enough, although Emma's tempura fried rice was a bit bland, the sauce was rather unique and actually quite to my liking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_16","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_17","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_17","text":"Ludmilla...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_18","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_18","text":"You don't look so good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_19","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_19","text":"Is there something wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_20","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_20","text":"I... actually liked the tempura fried rice Emma made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_21","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_21","text":"Huh? You say that like it's a bad thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_22","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_22","text":"... Do you think my taste buds are broken?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_23","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_23","text":"Ha! Don't be so silly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_24","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_24","text":"Anyway, all this talk of food has made me curious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_25","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_25","text":"Of all the dishes we made during the competition, which one would you most want a second helping of?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_26","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_26","text":"Everything was so delicious that it was hard to choose.","jump":"snowfall_speech_ludmilla_02_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_27","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_27","text":"The apple pie, naturally.","jump":"snowfall_speech_ludmilla_02_30","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_28","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_28","text":"You see? The flavors from all the other dishes made an impression on you as well,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_29","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_29","text":"so your taste buds are doing just fine.","jump":"snowfall_speech_ludmilla_02_32","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_30","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_30","text":"Hehe, is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_31","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_02_31","text":"Let's meet for a cup of tea whenever we have time.","jump":"snowfall_speech_ludmilla_02_32","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_02_32","type":"Narration","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_02_32","text":"I spend some more time with Ludmilla thinking about Emma's cooking competition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}