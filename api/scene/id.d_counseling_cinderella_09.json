{"id":"d_counseling_cinderella_09","cat":"counsel","group":{"id":"char5124","label":"Cinderella"},"label":"Advising Cinderella: 09","stage":null,"prev":"d_counseling_cinderella_08","next":"d_counseling_cinderella_10","speakers":{"cinderella":"Cinderella","Narration":"Narration"},"icons":{"cinderella":"si_c511_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_counseling_cinderella_09_1","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_1","text":"People often say that one side of our face is more beautiful than the other.","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["cinderella"],"affinity":"_0"},{"id":"d_counseling_cinderella_09_2","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_2","text":"It's said that the more beautiful side is the one where your smile first graces your face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_3","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_3","text":"So tell me, which side of my face is the more beautiful of the two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_09_4","text":"Both sides are equally beautiful.","jump":"d_counseling_cinderella_09_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_09_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_09_5","text":"The left side is more beautiful.","jump":"d_counseling_cinderella_09_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_09_6","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_7","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_7","text":"A person's face cannot be 100% symmetrical unless they're a mannequin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_8","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_8","text":"Prince.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_9","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_9","text":"Have you really taken a good look at my features?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_10","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_10","text":"That wasn't a very beautiful answer.","jump":"d_counseling_cinderella_09_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_11","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_11","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_12","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_12","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_13","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_13","text":"When I smile, it does seem to feel more natural on my left side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_14","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_14","text":"Perhaps that is the side that is a bit more alluring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_15","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_09_15","text":"Thank you for your lovely answer, Prince.","jump":"d_counseling_cinderella_09_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_09_16","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_cinderella_09_16","text":"For the rest of the session, I spend it observing Cinderella's countenance.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}