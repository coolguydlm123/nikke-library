":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_64","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_64","text":"something not even the technology in the Ark could cure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_65","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_65","text":"Unsurprisingly, chaos ensued regarding who would be his successor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_66","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_66","text":"It felt as if outsiders were invading and crossing our boundaries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_67","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_67","text":"The organization was being targeted both from the inside and out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_68","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_68","text":"That's when my once-pristine world became tainted.","jump":null,"exit":false,"enter":null,"bg":"BeachCave_n","bgArt":"beachcave_n","image":null,"bgm":null,"movie":null,"shown":["sakura_s"],"affinity":null},{"id":"event_beautyfullshot2_02_s_69","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_69","text":"My father had arranged everything, except for a proper successor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_70","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_70","text":"He had sired many children, but they knew little of what was going on, and they paid for it with their own lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_71","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_71","text":"I didn't want to ruin the world my father had built.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_72","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_72","text":"But I was just a weak little girl. I didn't stand a chance of holding back those invaders who had breached our walls, with weapons in hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_73","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_73","text":"So, I had to become a weapon myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_74","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_74","text":"On the day my father's eyes closed for the last time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_02_s_75","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_02_s_75","text":"I decided to become a Nikke, by my own hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}