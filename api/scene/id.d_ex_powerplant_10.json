},{"id":"d_ex_powerplant_10_96","type":"Speech","speaker":"neon_v","key":"Locale_SuddenStory:d_ex_powerplant_10_96","text":"What do we do now, Master?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_97","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_97","text":"Oh, so now you decide to listen to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["poli"],"affinity":null},{"id":"d_ex_powerplant_10_98","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_98","text":"Nobody move!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tomboyprincess","movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_99","type":"Speech","speaker":"neon_v","key":"Locale_SuddenStory:d_ex_powerplant_10_99","text":"Eeek!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_100","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_powerplant_10_100","text":"Ahhh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_101","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_101","text":"Well, this certainly explains why the power wasn't coming back on!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_102","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_102","text":"*Bzzzt, bzzzt* *Bzzzzzt*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_103","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_103","text":"Did you three do this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_104","type":"Speech","speaker":"neon_v","key":"Locale_SuddenStory:d_ex_powerplant_10_104","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_105","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_powerplant_10_105","text":"Yup! It was us!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_106","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_106","text":"No, I had nothing to do with this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_107","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_107","text":"*Bzzzt* *Bzzzzzt* *Bzzzzzzzzzt*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_108","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_108","text":"The generator sputters loudly and starts spewing even thicker smoke than before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_109","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_109","text":"Oh dear...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_110","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_110","text":"By the look of this generator... it doesn't seem like a simple malfunction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_111","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_111","text":"It's probably going to take quite a while to fix.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_112","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_112","text":"I'm putting the three of you under arrest!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_113","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_113","text":"Come on, we're heading to the station!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_114","type":"Speech","speaker":"neon_v","key":"Locale_SuddenStory:d_ex_powerplant_10_114","text":"The police station?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_115","type":"Speech","speaker":"neon_v","key":"Locale_SuddenStory:d_ex_powerplant_10_115","text":"But we were just trying to fix the generator!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_116","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_powerplant_10_116","text":"That's right! Neon and I have really been working hard to resolve this inconvenience for all the Nikkes and...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_117","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_117","text":"Grrr... What are you babbling about?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_118","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_118","text":"Thanks to you guys, the Outpost is losing even more power!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_119","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_119","text":"To the police station, on the double!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_120","type":"Speech","speaker":"neon_v","key":"Locale_SuddenStory:d_ex_powerplant_10_120","text":"Poli, as you can clearly see, I'm powered up right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_121","type":"Speech","speaker":"neon_v","key":"Locale_SuddenStory:d_ex_powerplant_10_121","text":"If I push just a little more, my Neo-Neon power will Neo-Neon this thing back into shape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_122","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_122","text":"Not happening! All of you, come along quietly, or else I'll have to use force.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_123","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_123","text":"I'm telling you, I didn't do anything...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_124","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_powerplant_10_124","text":"Don't try to wash your hands of this, Commander. You stood by this entire time without stopping them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_125","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_125","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_126","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_126","text":"Following that, Poli hauls us off to the police station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_127","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_127","text":"I'm excoriated for failing to stop Neon and Miranda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_10_128","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_powerplant_10_128","text":"As for Miranda and Neon, they are thrown into a holding cell and only released after writing letters of apology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}