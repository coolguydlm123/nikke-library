{"id":"memorial_103901","cat":"memorial","group":{"id":"memorial103900","label":"Call Logs · Deep within the Crystal Region"},"label":"008.smi","stage":null,"prev":null,"next":"memorial_103902","speakers":{},"icons":{},"lines":[{"id":"memorial_103901_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_39_01_description","text":"(Original file damaged. Only subtitles remain.)"},{"id":"memorial_103901_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_39_01_description","text":"I've been lost in the Crystal Region for days, it seems."},{"id":"memorial_103901_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_39_01_description","text":"I don't know how long I've been walking,"},{"id":"memorial_103901_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_39_01_description","text":"but I keep venturing deeper and deeper."},{"id":"memorial_103901_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_39_01_description","text":"Is there no end to this place?"},{"id":"memorial_103901_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_39_01_description","text":"I'll try to record as much as I can."}]}