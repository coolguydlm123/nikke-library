cale_SubScenario:event_maidinvalentine_05_e_25","text":"I am an AI machine. I am not swayed by such trivial things as emotions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_05_e_26","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_maidinvalentine_05_e_26","text":"Hmmm...","jump":"event_maidinvalentine_05_e_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_05_e_27","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_maidinvalentine_05_e_27","text":"Doesn't seem like it to me.","jump":"event_maidinvalentine_05_e_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_05_e_28","type":"Speech","speaker":"sweetjohnny","key":"Locale_SubScenario:event_maidinvalentine_05_e_28","text":"You're worse than those snot-nosed brats who would run all over the factory while making chocolate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_05_e_29","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_maidinvalentine_05_e_29","text":"You remember all of that from before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_05_e_30","type":"Speech","speaker":"sweetjohnny","key":"Locale_SubScenario:event_maidinvalentine_05_e_30","text":"Of course. I'm an AI. A good one at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_05_e_31","type":"Speech","speaker":"sweetjohnny","key":"Locale_SubScenario:event_maidinvalentine_05_e_31","te