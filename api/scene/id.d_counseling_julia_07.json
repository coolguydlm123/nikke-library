{"id":"d_counseling_julia_07","cat":"counsel","group":{"id":"char5014","label":"Julia"},"label":"Advising Julia: 07","stage":null,"prev":"d_counseling_julia_06","next":"d_counseling_julia_08","speakers":{"julia":"Julia"},"icons":{"julia":"si_c150_00_s"},"lines":[{"id":"d_counseling_julia_07_1","type":"Speech","speaker":"julia","key":"Locale_Counseling:d_counseling_julia_07_1","text":"Rapi is so good to me.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["julia"],"affinity":"_0"},{"id":"d_counseling_julia_07_2","type":"Speech","speaker":"julia","key":"Locale_Counseling:d_counseling_julia_07_2","text":"She often takes care of me when I stay in the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_julia_07_3","type":"Speech","speaker":"julia","key":"Locale_Counseling:d_counseling_julia_07_3","text":"I want to repay her somehow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_julia_07_4","type":"Speech","speaker":"julia","key":"Locale_Counseling:d_counseling_julia_07_4","text":"What kind of music can best express my gratitude?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_julia_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_julia_07_5","text":"What about something other than music? Something tangible that she can use.","jump":"d_counseling_julia_07_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_julia_07_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_julia_07_6","text":"Something solemn that matches Rapi's style.","jum