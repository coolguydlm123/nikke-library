{"id":"d_main_27_09_e","cat":"main","group":{"id":"ch27","label":"Chapter 27 · Exploration"},"label":"Parasitic: B","stage":"27-36 BOSS · End","prev":"d_main_27_09_s","next":null,"speakers":{"rapi":"Rapi","elegg":"Elegg","anis":"Anis","hammering":"Hammering","shifty":"Shifty","flora_op_r":"Flora","liveryn":"Liveryn","Narration":"Narration"},"icons":{"rapi":"si_c010_00_s","elegg":"si_c500_00_s","anis":"si_c012_00_s","hammering":"si_c490_00_s","shifty":"si_c907_00_s","flora_op_r":"si_c411_00_s","liveryn":"si_c480_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_27_09_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_27_09_e_1","text":"*Bang*","jump":null,"exit":false,"enter":null,"bg":"ManyCrystalDesert_d","bgArt":"manycrystaldesert_d","image":null,"bgm":"bgm_enemyclose","movie":null,"shown":["elegg","hammering","liveryn","rapi","anis","neon"],"affinity":null},{"id":"d_main_27_09_e_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_27_09_e_2","text":"The Rapture that was covered with crystals collapses to the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_09_e_3","text":"All clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_4","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_4","text":"Are they really dead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_09_e_5","text":"Oh, they're dead as doornails.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_6","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_09_e_6","text":"The light in the crystals has been completely extinguished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_7","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_27_09_e_7","text":"The crystal protruding from the Rapture shatters and disappears,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_8","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_27_09_e_8","text":"leaving the corpse perforated with a myriad of small holes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_9","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_27_09_e_9","text":"What the...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_10","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_10","text":"Let me get a closer look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_11","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_12","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_12","text":"Are you sure it's dead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_13","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_09_e_13","text":"I've never been more sure of anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_14","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_14","text":"O-okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_15","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_15","text":"Hammering, help me. I'm going to open up this one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_16","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_09_e_16","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_27_09_e_17","text":"*Clink clink*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_18","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_18","text":"Its insides are a complete mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_19","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_19","text":"I do see a single trail, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_20","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_09_e_20","text":"What do you mean by \"trail\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_21","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_21","text":"You remember how the crystal attempted to reach my core by entering through my hand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_22","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_22","text":"It's the same as that. The path it's created here is a bit wider though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_23","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_23","text":"It's still intact,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_24","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_24","text":"and it heads straight for the Rapture's core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_25","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_25","text":"There's been extensive damage to the core as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_26","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_27","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_27","text":"I don't understand this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_28","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_09_e_28","text":"Wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_29","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_09_e_29","text":"I'm expecting a call soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_30","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_09_e_30","text":"A call? From who?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_31","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_27_09_e_31","text":"The Botanic Garden squad wants to connect with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_27_09_e_32","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_27_09_e_32","text":"I'll patch you through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_33","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_33","text":"Hello. I'm Flora from Botanic Garden squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_aztec","movie":null,"shown":["flora_op_r"],"affinity":null},{"id":"d_main_27_09_e_34","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_34","text":"Hammering briefed me on the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_35","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_35","text":"I've been receiving continual updates because the crystals in that region are exhibiting plant-like characteristics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_36","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_09_e_36","text":"Should we really be discussing this out in the open?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_37","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_27_09_e_37","text":"It's fine. This is an official mission that is out in the open.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_38","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_27_09_e_38","text":"It's just that the special Commando was the only squad we had available to deploy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_39","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_09_e_39","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_27_09_e_40","text":"Flora, what are your thoughts on this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_41","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_41","text":"Seeing it in person would be optimal. However, since that isn't possible, I've made an informed guess based on the information provided by Hammering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_47","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_47","text":"First, I am proceeding on the assumption that the crystals are indeed plants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_48","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_48","text":"We would need to get our hands on a sample or observe it up close to know the details, but in light of that Rapture you all saw,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_49","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_49","text":"it would appear that the crystals grow from within the Rapture and eventually penetrate through its surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_50","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_09_e_50","text":"Like a parasite?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_51","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_51","text":"Yes. The crystals appear to absorb the energy of their host and use it as a form of nourishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_52","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_52","text":"Servant or Master-class Raptures have relatively small cores, meaning they provide less nourishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_53","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_53","text":"For lower-level Raptures, once their energy is absorbed, they are discarded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_54","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_54","text":"That Rapture you saw was a Lord-class. It has a much larger core, and thus significantly more energy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_55","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_55","text":"Rather than absorb its energy at one go and kill the host, it seems to have realized that it is better to parasitize and absorb its energy bit by bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_56","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_56","text":"Of course, this is all based on the assumption that the crystals are indeed plant-based organisms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_57","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_57","text":"Parasitic behavior is not uncommon in the plant world. In fact, it happens on a fairly regular basis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_58","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_58","text":"A classic example would be cordyceps, even though they technically aren't plants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_59","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_09_e_59","text":"Why do they exhibit parasitic behavior?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_60","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_60","text":"Simple. To propagate the species.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_61","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_61","text":"Plants are more or less immobile due to their roots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_62","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_62","text":"Plants have the ability to extend their roots towards nutrients, but this is a painfully slow process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_63","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_63","text":"Therefore, they either feed their seeds to something which is more mobile, or parasitize it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_64","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_09_e_64","text":"It's all about expanding their domain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_65","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_65","text":"That's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_66","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_09_e_66","text":"Could this have something to do with why the Raptures ran away?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_67","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_67","text":"Unfortunately, I don't know enough at this point to say much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_68","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_68","text":"Plants are not aggressive organisms. If they do parasitize, they tend to do it in a clandestine manner, since it is more beneficial for their survival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_69","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_69","text":"They do not actively threaten their host.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_70","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_09_e_70","text":"That's if we're assuming these things are indeed plant-based lifeforms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_71","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_71","text":"Exactly. That's the key point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_72","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_72","text":"While they exhibit some plant-like characteristics, they don't physically resemble them in any way whatsoever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_73","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_09_e_73","text":"Okay. Thanks for the intel. We'll keep it in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_74","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_74","text":"Feel free to contact me if you have any questions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_75","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_75","text":"I'd like to be there with you, but things in the Ark are quite dire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_09_e_76","type":"Speech","speaker":"flora_op_r","key":"Locale_MainScenario:d_main_27_09_e_76","text":"If the opportunity presents itself, I hope to see you on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinit