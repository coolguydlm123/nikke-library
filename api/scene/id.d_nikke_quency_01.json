uency","key":"Locale_NikkeEpisode:d_nikke_quency_01_88","text":"Aren't I being a good girl and participating right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_89","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_89","text":"If you keep distrusting me, I might get upset.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_90","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_01_90","text":"... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_91","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_91","text":"Jeez, I was kinda half-joking. I can't believe you're apologizing just like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_92","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_92","text":"Well anyway, since you apologized, you're forgiven.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_93","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_01_93","text":"I'm going to help you get better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_94","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_94","text":"You don't say. So you're gonna be at all these consultation meetings?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie