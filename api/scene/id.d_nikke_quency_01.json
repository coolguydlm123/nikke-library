,"speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_quency_01_13","text":"She may be different from the other criminals, but that doesn't make her any less bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_14","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_quency_01_14","text":"You okay, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_15","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_01_15","text":"Is she at the Rehabilitation Center right now?","jump":"d_nikke_quency_01_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_16","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_01_16","text":"I'll make her my responsibility and try to rehabilitate her.","jump":"d_nikke_quency_01_18","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_17","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_quency_01_17","text":"Yes. I just confirmed her location a few moments ago.","jump":"d_nikke_quency_01_18","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_18","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_quency_01_18","text":"I just hope she can finally be given a proper consultation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_19","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_quency_01_19","text":"Good luck to you.","jump":null,"exit":false,"enter":null,