cy_01_34","text":"I didn't notice I was being followed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_35","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_35","text":"Seems you're a little slow on the uptake. Just like all the rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_36","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_36","text":"Anyway, nice to meet you. I'm Quency. What's your name?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_37","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_01_37","text":"{AccountData.NickName}.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_38","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_38","text":"Wow, what a cool name! Much better than any of the other counselors so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_39","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_39","text":"So you've come to have a little chat with me, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_01_40","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_01_40","text":"I haven't the foggiest idea why you people keep wanting to pick my brain apart. I haven't done anything wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":nu