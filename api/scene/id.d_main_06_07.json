{"id":"d_main_06_07","cat":"main","group":{"id":"ch6","label":"Chapter 6 · Pilgrim"},"label":"Meeting","stage":"6-21 STAGE · End","prev":"d_main_06_06","next":"d_main_06_08_s","speakers":{"talkative":"Chatterbox","Self":"Commander","Narration":"Narration"},"icons":{"Narration":"si_c999_00_s"},"lines":[{"id":"d_main_06_07_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_07_1","text":"Your head is pounding.","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":"bgm_enemyclose","movie":null,"shown":["talkative"],"affinity":null},{"id":"d_main_06_07_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_07_2","text":"It's freezing out here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_07_3","text":"You struggle to open your eyes. When you do, you are greeted with a familiar face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_4","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_07_4","text":"It's too bad really.\nHad you found out it was a trap, you would have at least stood a chance of besting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_5","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_07_5","text":"But hindsight is 20/20 I suppose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_6","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_07_6","text":"Do you want something from me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_7","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_07_7","text":"Plenty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_8","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_07_8","text":"Sorry, but I'm not interested in you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_9","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_07_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_10","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_07_10","text":"Ha ha ha ha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_11","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_07_11","text":"Excellent, that works out perfectly!\nI despise humans as well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_12","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_07_12","text":"Spare me the sermon and get to the point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_13","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_07_13","text":"I have a few questions for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_07_14","type":"Speech","speake