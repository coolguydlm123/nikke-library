{"id":"d_ex_flowerpark_03","cat":"outpost","group":{"id":"outpost23501","label":"Flower Park"},"label":"The Flavor of Flower Stories","stage":null,"prev":"d_ex_flowerpark_02","next":"d_ex_flowerpark_04","speakers":{"flora":"Flora","bready":"Bready"},"icons":{"flora":"si_c411_00_s","bready":"si_c520_00_s"},"notes":["Unlock: Bready · Flora","Featuring Bready · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_flowerpark_03_1","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_1","text":"Ah, Blossom!","jump":null,"exit":false,"enter":null,"bg":"FlowerGarden","bgArt":"flowergarden","image":null,"bgm":"event_bgm_secretgarden","movie":null,"shown":["flora","bready"],"affinity":null},{"id":"d_ex_flowerpark_03_2","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_2","text":"You've arrived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_3","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_3","text":"And you as well, Chicory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_4","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_flowerpark_03_4","text":"Chicory? I'm pretty sure I've heard of that before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_5","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_5","text":"It's a leafy plant which is also edible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_6","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_6","text":"It can be cooked in various ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_7","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_7","text":"She started calling me after the flower that blooms from it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_8","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_flowerpark_03_8","text":"Why's that? Does its symbolism fit Bready's personality?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_9","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_9","text":"Chicory stands for thriftiness and frugality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_10","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_flowerpark_03_10","text":"Er... that doesn't really sound like a good match.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_11","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_11","text":"Chicory tastes bitter, but it's very healthy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_12","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_12","text":"It therefore carries the meaning of finding truth within bitterness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_13","type":"Speech","sp