d_ex_flowerpark_03_20","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_20","text":"After all, a lot of food ingredients come from plants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_21","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_21","text":"We often receive help from them in that regard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_22","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_flowerpark_03_22","text":"And what does Botanic Garden get in return?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_23","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_23","text":"We ask them for information about plants that we don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_24","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_24","text":"Just like today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_25","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_flowerpark_03_25","text":"You mean to tell me there are plants that Botanic Garden isn't familiar with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_26","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_26","text":"Of course there are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_27","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_flowerpark_03_27","text":"Flora lifts a small pot, inside of which a tiny sprout is emerging.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_28","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_28","text":"This is a newly discovered flower","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_29","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_29","text":"which we've been unable to identify.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_30","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_30","text":"Before they are nurtured into maturity, plants are full of mystery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_31","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_31","text":"We have no idea where it grew, what kind of life it's led, or whether it's poisonous or not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_32","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_32","text":"If we raised it incorrectly, this plant could potentially be harmful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_33","type":"Speech","speaker":"flora","