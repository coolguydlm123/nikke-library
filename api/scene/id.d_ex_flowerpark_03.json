ng it in the coldest environment possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_41","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_41","text":"Actually, this plant only managed to survive in cold climates due to its resilience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_42","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_42","text":"Fortunately, there was enough sunlight in that area to allow it to sprout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_43","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_43","text":"It would actually be better to move it somewhere warmer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_44","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_44","text":"Oh my goodness!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_45","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_45","text":"Here it was, struggling to make it through the cold, and then we came along and left it somewhere even colder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_46","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_46","text":"I feel so bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_47","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_47","text":"Unfortunately, it's not edible, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_48","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_48","text":"We won't have much use for it at Cooking Oil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_49","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_49","text":"It isn't highly poisonous though,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_50","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_50","text":"so it should be safe to grow alongside other plants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_51","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_51","text":"It's also very happy that you found it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_52","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_52","text":"Yes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_53","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_53","text":"I can sense that emotion as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_54","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_54","text":"I found it in the middle of a raging blizzard, huddled at the base of a cliff, trembling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_55","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_55","text":"The moment I realized it was alive, I felt so relieved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_56","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_56","text":"That's about all I can discern for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_57","type":"Speech","speaker":"bready","key":"Locale_SuddenStory:d_ex_flowerpark_03_57","text":"You'll learn more as you continue to care for it, Flora.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_58","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_58","text":"That's more than enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_59","type":"Speech","speaker":"flora","key":"Locale_SuddenStory:d_ex_flowerpark_03_59","text":"Thank you so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_flowerpark_03_60","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_flowerpark_03_60","text":"Are you sure it's okay to be cultivating a new speci