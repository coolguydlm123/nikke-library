{"id":"event_marian2_03_s","cat":"event","group":{"id":"ev40125","label":"MARIA-n · Part 2"},"label":"A Cold Rain: A","stage":null,"prev":"event_marian2_02_e","next":"event_marian2_03_e","speakers":{"marian":"Marian"},"icons":{"marian":"si_c013_00_s"},"lines":[{"id":"event_marian2_03_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_1","text":"The two slowly walk hand in hand,","jump":null,"exit":false,"enter":null,"bg":"EventScene_Marian_07_1","bgArt":"eventscene_marian_07_1","image":null,"bgm":"event_bgm_maria-n_quietpeace","movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_2","text":"taking in the scenery around them as they go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_3","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_3","text":"It's quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_4","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_4","text":"Yeah. Really quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_5","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_5","text":"And beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_6","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_6","text":"The trees, the grass, even the collapsed buildings. It's all so beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_7","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_7","text":"It's strange, isn't it? I've seen this scenery hundreds of times or more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_8","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_8","text":"But it's only lately that I've noticed how beautiful it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_9","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_9","text":"That's because you're in love.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_10","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_10","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_11","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_11","text":"They say that when you fall in love, the whole world looks beautiful. That must be what it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_12","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_13","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_13","text":"In love... with who?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_14","text":"The Commander looks at Marian. Marian looks at him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_15","text":"He wriggles his eyebrows with exaggerated effect and makes a silly face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_16","text":"Marian shakes his hand off dramatically.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Marian_07_2","bgArt":"eventscene_marian_07_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_17","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_17","text":"I'm not there just yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_18","text":"Marian walks ahead. The Commander follows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_19","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_19","text":"\"Not just yet\" sounds a lot like \"soon\" to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_20","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_20","text":"Well, that depends on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_21","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_21","text":"Hmm... I have no idea how to make someone fall in love with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_22","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_22","text":"Hahaha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_23","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_23","text":"Did you give any thought to what we talked about earlier?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_24","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_24","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_25","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_25","text":"The first thing I'd want to do when this is all over...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_26","text":"Marian's pace slows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_27","text":"She says nothing and only smiles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_28","text":"The Commander smiles along with her, matching her pace as he waits for her to speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_29","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_29","text":"I think I'd like to pack a lunch and go on a picnic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_30","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_30","text":"Sounds simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_31","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_31","text":"Not necessarily. First, I'd have to pack the lunch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_32","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_32","text":"To do that, I'd have to learn how to cook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_33","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_33","text":"Ooh, you're going to do the cooking yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_34","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_34","text":"You'll have to do some of it too, Commander, since we'll be going together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_35","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_35","text":"Now I'm getting worried. I've never cooked in my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_36","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_36","text":"Me either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_37","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_37","text":"But there's nothing to worry about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_38","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_38","text":"We can learn together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_39","text":"... Sounds good. Should we decide on the menu then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_40","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_40","text":"Let's each put in one thing we like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_41","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_41","text":"Something we like...? I think it might have to be more like something we've always wanted to eat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_42","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_42","text":"Hehe, good point. Neither of us has ever eaten a proper meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_43","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_43","text":"In that case, I'll say... a rolled omelet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_44","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_44","text":"Good choice. I've always wanted to try that. I'll go with mac and cheese.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_45","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_45","text":"Stir-fry, with some sort of meat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_46","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_46","text":"Grilled salmon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_47","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_47","text":"We should probably eat more vegetables, so... coleslaw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_48","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_48","text":"Chicken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_49","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_49","text":"You need to eat some vegetables too, Commander. You can't just have meat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_50","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_50","text":"Okay then, french fries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_51","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_51","text":"Hmm... I'm not sure whether that counts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_52","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_52","text":"But sure, let's put it in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_53","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_53","text":"We can't just have meat and vegetables, though. I'll pack rice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_54","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_54","text":"There's this thing called omurice I've always wanted to try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_55","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_55","text":"Oh, me too. Why don't we use the rice for that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_56","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_56","text":"Perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_57","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_57","text":"Maybe we should have some eel, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_58","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_58","text":"Oh? You know, I've heard eel helps with, uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_59","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_59","text":"Don't get any funny ideas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_60","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_60","text":"Now that our lunch is settled, we'll have to decide on a location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_61","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_61","text":"You can never go wrong with a lake, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_62","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_62","text":"A park would be lovely too. I want to spread a blanket on a grassy patch and sit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_63","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_63","text":"A lakeside park, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_64","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_64","text":"Hahaha. That works.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_65","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_65","text":"We'll need to get a blanket, one that's big and will last, since we'll be using it for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_66","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_66","text":"Oh, and a lunch box. I want a really cute one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_67","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_67","text":"Nah, it has to be a military lunch box.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_68","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_68","text":"That's a joke, right, Commander? Who brings a military lunch box on a picnic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_69","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_69","text":"That's just a preconception. Think about it: if it's military-grade, it'll be way more functional than your average lunch box.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_70","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_70","text":"No. I refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_71","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_71","text":"Aw, c'mon. Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_72","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_72","text":"It ruins the whole mood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_03_s_73","type":"Self","speaker":null,"key":"Locale_MainScenario:event_marian2_03_s_73","text":"Then let's settle it with rock-paper-scissors.","jump":null,"exit":false,"enter":null,"bg":"land_d","bgArt":"land_d","image":null,"bgm":null,"movie":null,"shown":["marian"],"affinity":null},{"id":"event_marian2_03_s_74","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_03_s_74","text":"Fine. Just so you know, I'm going with scissors.","jump":n