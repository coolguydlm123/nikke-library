{"id":"d_counseling_chime_07","cat":"counsel","group":{"id":"char5157","label":"Chime"},"label":"Advising Chime: 07","stage":null,"prev":"d_counseling_chime_06","next":"d_counseling_chime_08","speakers":{"chime":"Chime"},"icons":{"chime":"si_c331_00_s"},"lines":[{"id":"d_counseling_chime_07_1","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_1","text":"I have heard that thou dwellest in a place called the Outpost.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["chime"],"affinity":"_0"},{"id":"d_counseling_chime_07_2","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_2","text":"How is it there? Is it livable, or doth it leave much to be desired?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_07_3","text":"How about coming over and checking it out yourself?","jump":"d_counseling_chime_07_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_chime_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_07_4","text":"It's not too bad.","jump":"d_counseling_chime_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_chime_07_5","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_5","text":"In person, thou sayest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_6","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_6","text":"Thou wouldst invite me to thine dwelling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_7","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_8","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_8","text":"Someday, I shall surely drop by with Her Highness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_9","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_9","text":"Methinks I shall indeed set foot in your humble dwelling one day.","jump":"d_counseling_chime_07_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_10","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_10","text":"Rapscallion!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_11","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_07_11","text":"Speak not to me so half-heartedly!","jump":"d_counseling_chime_07_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_07_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_chime_07_12","text":"Chime and I talk about the Outpost.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}