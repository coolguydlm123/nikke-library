{"id":"d_ex_redash_03_1","cat":"event","group":{"id":"ev80800","label":"RED ASH"},"label":"First Meeting I","stage":null,"prev":"d_ex_redash_02_3","next":"d_ex_redash_03_2","speakers":{"Narration":"Narration","dorothy":"Dorothy","liliweiss":"Liliweiss","commander":"Commander"},"icons":{"Narration":"si_c999_00_s","dorothy":"si_c233_00_s","liliweiss":"si_c943_00_s","commander":"si_c942_00_s"},"lines":[{"id":"d_ex_redash_03_1_1","type":"Narration","speaker":"Narration","key":"Locale_SuddenStory:d_ex_redash_03_1_1","text":"Record #003-1 playback.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":"none","movie":null,"shown":["dorothy","liliweiss","commander"],"affinity":null},{"id":"d_ex_redash_03_1_2","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_2","text":"I am Dorothy, Grimms Model No. 2, and I have been assigned to the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_3","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_3","text":"Looking forward to working with you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_4","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_4","text":"Wow, someone else finally passed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_5","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_5","text":"Turns out there actually are people compatible with the program.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_6","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_6","text":"You... are a Nikke, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_7","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_7","text":"I am, correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_8","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_8","text":"From the outside, you're indistinguishable from a real human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_9","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_9","text":"Hey, aren't I a Nikke too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_10","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_10","text":"Sure, but your appearance is slightly different from a human's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_11","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_11","text":"Huh? How?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_12","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_12","text":"Mecha Dessssstructerrr!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_13","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_13","text":"My apologies for the Commander's behavior. He sometimes goes on these nonsensical tangents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_14","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_14","text":"Jeez, it feels like you tore my arm out of the socket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_15","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_15","text":"You're fine, don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_16","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_16","text":"This... isn't quite what I imagined it would be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_17","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_17","text":"What isn't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_18","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_18","text":"I thought everything would have a bit more of a... refined air to it. More noble, perhaps?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_19","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_19","text":"Especially considering we're the last line of defense between mankind and complete annihilation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_20","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_20","text":"Are you somehow implying that we're crass?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_21","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_21","text":"No, I didn't mean that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_22","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_22","text":"I just didn't expect you all to be so laid back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_23","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_23","text":"We get our fair share of tension on the battlefield, so we have to make the most of whatever fun we can have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_24","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_24","text":"Did you say your name was Dorothy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_25","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_25","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_26","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_26","text":"What's your battle experience?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_27","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_27","text":"None.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_28","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_28","text":"Have you ever fired a weapon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_29","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_29","text":"Negative.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_30","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_30","text":"Not even in a simulation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_31","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_31","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_32","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_32","text":"How in the world are we going to find a use for you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_33","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_33","text":"I can be of use, I assure you. I have everything I need to know up here, in my head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_34","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_34","text":"Ah, so you're another one of those types.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_35","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_35","text":"In lieu of practical experience, you've got an all-compassing knowledge of various theories and stratagems, and so you believe you can be deployed straight away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_36","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_36","text":"You know what all these kinds of people have in common?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_37","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_37","text":"They get killed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_38","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_38","text":"Sucks for them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_39","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_39","text":"Are you even listening to what I'm saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_40","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_40","text":"Dorothy, at this point,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_41","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_41","text":"we can't put much faith in your professed skills,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_42","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_42","text":"so, if it's okay with you, I'd like to conduct a test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_43","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_44","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_44","text":"If I'm being honest, I'm a bit offended. I realize we've only just met, but to say that you don't trust me straight to my face?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_45","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_45","text":"We just don't want any of our members getting killed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_46","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_46","text":"So if you think someone won't last long on the field, you won't accept them to begin with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_47","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_47","text":"It might sound harsh, but yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_48","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_48","text":"It's up to you. You can refuse the test, but if you do, you won't be able to join the team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_49","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_50","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_50","text":"Let's get this over with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_51","type":"Narration","speaker":"Narration","key":"Locale_SuddenStory:d_ex_redash_03_1_51","text":"One hour later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_52","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_52","text":"Are we done?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_53","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_53","text":"Any other tests?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_54","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_55","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_56","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_56","text":"Were the results no good?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_57","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_57","text":"I personally thought I did well, but maybe I didn't meet your standards...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_58","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_58","text":"Welcome to the Goddess Squad, Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_59","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_59","text":"You did amazing. I think you even broke a few records. Are you sure you're new to all this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_60","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_61","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_61","text":"All right, it's party time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_62","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_1_62","text":"We were given an allowance to hold some festivities, but were told we couldn't spend it all between just the two of us. If we don't use it by tomorrow, we'll have to return the funds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_63","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_63","text":"Finally, we got to have a party!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_64","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_65","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_65","text":"Sounds fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_66","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_1_66","text":"Ah, there is something I'd like to ask you, just for the record.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_1_67","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_03_1_67","text":"Go ahead.","j