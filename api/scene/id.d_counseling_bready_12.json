{"id":"d_counseling_bready_12","cat":"counsel","group":{"id":"char5135","label":"Bready"},"label":"Advising Bready: 12","stage":null,"prev":"d_counseling_bready_11","next":"d_counseling_bready_13","speakers":{"bready":"Bready"},"icons":{"bready":"si_c520_00_s"},"lines":[{"id":"d_counseling_bready_12_1","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_12_1","text":"When you're at a restaurant, what do you place the most emphasis on?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["bready"],"affinity":"_0"},{"id":"d_counseling_bready_12_2","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_12_2","text":"The taste of the food? The hygiene? The service?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_12_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_12_3","text":"I think hygiene is the most important.","jump":"d_counseling_bready_12_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_bready_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_12_4","text":"Good-tasting food is all that matters.","jump":"d_counseling_bready_12_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_bready_12_5","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_12_5","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_12_6","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_12_6","text":"If an establishment is filthy