{"id":"s002_06","cat":"side","group":{"id":"side2","label":"WORDLESS"},"label":"WORDLESS: 6","stage":null,"prev":"s002_05","next":"s002_07","speakers":{"mihara":"Mihara","pepper":"Pepper","mary":"Mary"},"icons":{"mihara":"si_c161_00_s","pepper":"si_c131_00_s","mary":"si_c130_00_s"},"lines":[{"id":"s002_06_1","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_1","text":"Have you ever dealt with wild animals?","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"bgm_frostpillar","movie":null,"shown":["mihara","pepper","mary"],"affinity":null},{"id":"s002_06_2","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_06_2","text":"Excuse me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_3","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_3","text":"Did you say \"wild animals\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_4","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_4","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_5","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_5","text":"Yuni has been fraternizing with some rough customers in the Rehabilitation Center, so she's become a bit... feral.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_6","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_7","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_06_7","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_8","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_06_8","text":"Are you saying that Yuni's demeanor is savage in nature, even around you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_9","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_06_9","text":"To the point where you can't communicate?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_10","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_10","text":"That's not it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_11","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_11","text":"She can't speak, but she still listens to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_12","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_12","text":"Actually, she's kinda cute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_13","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_06_13","text":"So she listens to you, but you're unable to communicate?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_14","type":"Speech","speaker":"pepper","key":"Locale_SideStory:s002_06_14","text":"That doesn't make any sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":