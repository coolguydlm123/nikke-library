"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_23","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_23","text":"It's okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_24","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_24","text":"That tells me you're concerned about me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_25","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_25","text":"So thanks, Pepper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_26","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_26","text":"Mihara.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_27","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_27","text":"Do you want to speak with the person you're talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_28","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_28","text":"No. I think that's impossible for many reasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_29","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_29","text":"Her not being able to speak is a form of punishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_30","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_30","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_31","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_31","text":"So you just want to be able to be understood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_32","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_32","text":"Yes. Just being able to communicate is enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_33","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_33","text":"With how she is now, I can't imagine us being able to carry out missions together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_34","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_34","text":"Hmm... if communication is your main goal,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_35","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_35","text":"I think you'd be better off consulting with an animal expert.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_36","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_06_36","text":"An animal expert?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_06_37","type":"Speech","speaker":"mary","key":"Locale_SideStory:s002_06_37","text":"Have you heard of the Happy Zoo Squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i