hing which we know nothing about!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_34","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_34","text":"Oh my goodness... I think I'm going to faint!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_35","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_35","text":"We have to hurry before it's too late!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_36","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_36","text":"If we spread BOOM before this place makes contact with the outside world, it'll become the very foundation of their civilization!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_37","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_30_01_s_37","text":"Elegg, calm down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["trony_op_r"],"affinity":null},{"id":"d_main_30_01_s_38","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_38","text":"I-I don't think I can!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_39","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_30_01_s_39","text":"If I'm being honest, I'm kinda freaking out too. I'm gonna make another revision to my will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_m