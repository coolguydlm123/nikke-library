n_30_01_s_13","text":"Nope, Harmony Cubes are meant to be this size.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_14","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_14","text":"After all, they were computational devices designed to help build the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_15","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_15","text":"It's a device that crunches all the data needed to construct a city in a jiffy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_16","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_16","text":"The ones the Nikkes use are a simplified version,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_17","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_17","text":"and thus, the difference in size is significant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_18","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_30_01_s_18","text":"Every location that was once a potential site for the Ark possesses a Harmony Cube.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_19","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_30_01_s_19","text":"After the Rapture invasion, only the simplified ones have remained.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_20","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_30_01_s_20","text":"But this one... seems to be in good condition, although a bit unstable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_01_s_21","text":"Are you saying that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_01_s_22","text":"another Ark is being built here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_23","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_01_s_24","text":"Elegg?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_25","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_25","text":"I'm sure of it!","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_26","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_30_01_s_26","text":"You remember the Elevator we saw?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_01_s_27","type":