l_speech_ludmilla_17_6","text":"I still have a lot of things left to do, so I decide to leave the bamboo forest.","jump":null,"exit":true,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_7","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_17_7","text":"The notes flutter in the breeze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_8","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_17_8","text":"In the week since the bamboo forest was reopened, a plethora of notes have been pinned to the various bamboo shoots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_9","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_9","text":"Isn't this much nicer than how it looked in the beginning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_10","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_17_10","text":"Absolutely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_11","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_11","text":"It's reassuring to see all these wishes piling up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_12","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_12","text":"Hmmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_13","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_13","text":"I'm glad that we found that book speaking of the legends in Snowfield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_14","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_14","text":"It's because of them that we were able to witness this spectacular scenery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_15","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_17_15","text":"If there were no book, then there wouldn't be any wish notes here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_16","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_16","text":"Precisely. The stories of the past reach out and weave new tales in the present.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_17","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_17","text":"I like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_18","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_18","text":"Don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_19","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_17_19","text":"I just don't want legends of the past to tie us down.","jump":"snowfall_speech_ludmilla_17_21","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_20","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_17_20","text":"I think those legends have given us some indelible experiences here at Snowfield.","jump":"snowfall_speech_ludmilla_17_23","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_21","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_21","text":"I'm surprised to hear you say that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_22","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_22","text":"considering you were amongst the most vocal supporters of uncovering the truth behind them.","jump":"snowfall_speech_ludmilla_17_25","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_23","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_23","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_24","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_17_24","text":"Maybe one day our stories will be the foundation upon which others construct a marvelous experience.","jump":"snowfall_speech_ludmilla_17_25","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_17_25","type":"Narration","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_17_25","text":"I spend time with Ludmilla discussing the legends of Snowfield Hot Spring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}