{"id":"event_foolmetalpanic_03_s","cat":"event","group":{"id":"ev130010","label":"Foolmetalpanic"},"label":"SSSS.Shiftyman: A","stage":null,"prev":"event_foolmetalpanic_02","next":"event_foolmetalpanic_03_e","speakers":{"shifty_s":"Shifty","mekamishifty":"Mekami Shifty"},"icons":{"shifty_s":"si_c907_00_s","mekamishifty":"si_c610_00_s"},"lines":[{"id":"event_foolmetalpanic_03_s_1","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_1","text":"Whew, this really helps you vent. I wish every day were April Fools' Day!","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_cottoncandy","movie":null,"shown":["shifty_s"],"affinity":null},{"id":"event_foolmetalpanic_03_s_2","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_2","text":"You keep getting better at this. You almost don't seem human anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_3","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_3","text":"I'd hope so. I train every single day while waiting for April to come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_4","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_4","text":"Now, it should be up ahead...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_5","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_5","text":"Shifty and I move forward, with her in the lead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_6","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_6","text":"After a short while, we come across what we were looking for:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_7","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_7","text":"a circular crater sunk into the ground,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_8","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_8","text":"and something person-shaped at its center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_9","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_9","text":"It looks like a person! Maybe it's some sort of meteor person...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_10","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_10","text":"It's probably just a meteor shaped like a person. Let's go take a closer look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_11","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_11","text":"We cautiously approach the meteor(?), and...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_12","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_12","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_13","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_13","text":"Maybe it's just my imagination, but something about it feels oddly familiar...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_14","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_14","text":"*Gasp!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mekamishifty"],"affinity":null},{"id":"event_foolmetalpanic_03_s_15","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_15","text":"Gah! I-it just stood up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_16","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_16","text":"Shoot it, Shifty!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_17","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_17","text":"Shouldn't we ask questions first?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_18","text":"Not on a day like today! Shoot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_19","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_20","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_20","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_21","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_21","text":"*Bzzz, bzzz, bzzz!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_alittlestar","movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_22","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_22","text":"*Bzzzzzzz!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_23","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_24","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_25","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_26","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_26","text":"*Chirp, chirp?*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_27","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_27","text":"*Click, click, click?*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_28","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_28","text":"... What is she doing? It feels rude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_29","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_29","text":"No kidding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_30","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_30","text":"*Gasp!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_31","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_31","text":"Y-you speak the common tongue!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_32","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_32","text":"Astonishing. To think the civilization of the blue star has made such marked advances. What a pleasant miscalculation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_33","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_33","text":"The common tongue...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_34","text":"Who are you...? And what do you mean \"blue star\"? This is a planet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_35","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_35","text":"Oh, my apologies. Allow me to introduce myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_36","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_36","text":"I am a member of the Space Defense Force of Planet Shifty, located 120 light-years away from this planet, which we first thought was merely a star - hence \"the blue star.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_37","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_37","text":"My name is Mekami Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_38","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_38","text":"You may call me Missy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_39","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_39","text":"I think we'll just stick with your name...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_40","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_40","text":"This planet, while bursting with life, is in crisis. I have come to save all of you wonderful insects that reside on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_41","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_42","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_42","text":"I don't even know where to begin being insulted by that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_43","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_43","text":"No kidding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_44","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_44","text":"Could you explain a bit more? We have no idea what you're talking about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_45","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_45","text":"That's everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_46","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_46","text":"I see you're not the type for world-building.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_47","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_47","text":"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_48","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_48","text":"So, to sum up...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_49","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_49","text":"she's an alien, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_50","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_50","text":"Hey, Shifty. Lend me some money now and I'll pay you back three times over later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_51","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_51","text":"Really?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_52","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_52","text":"No. You shouldn't be so gullible, or else you end up believing someone when they say they're an alien.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_53","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_54","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_54","text":"Nothing I've said has been a lie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_55","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_55","text":"Oh, of course. I'm sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_56","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_57","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolmetalpanic_03_s_57","text":"You seem offended.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_58","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_58","text":"*Sigh* I bet she is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_59","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_59","text":"How can I prove what I told you is true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_60","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_03_s_60","text":"If you're an alien, try taking down a Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_61","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_61","text":"Rapture. You mean your planet's mechanical insects?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_62","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_62","text":"Very well. There happens to be one over there now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_03_s_63","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_03_s_63","text":"I'll show you the true performance of Mekami Shifty!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}