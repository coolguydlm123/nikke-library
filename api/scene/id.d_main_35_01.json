"affinity":null},{"id":"d_main_35_01_98","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_01_98","text":"... Never mind. I think it's the right call.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_99","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_99","text":"But why should fellow heroes with the same spirit not communicate?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_100","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_100","text":"There's no such thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_101","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_101","text":"It's impossible to quit the Villain Union!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_102","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_01_102","text":"I never joined.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_103","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_103","text":"All right, that's it. Let's go home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_104","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_104","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_105","type":"Speech","spea