{"id":"d_main_35_01","cat":"main","group":{"id":"ch35","label":"Chapter 35 · Conversation"},"label":"Black Sea","stage":"35-3 STAGE · Start","prev":"d_main_35bf_07","next":"d_main_35_02","speakers":{"laplace":"Laplace","drake":"Drake","maxwell":"Maxwell","rapi_red":"Rapi","cinderella":"Cinderella","grave_p":"Grave"},"icons":{"laplace":"si_c100_00_s","drake":"si_c101_00_s","maxwell":"si_c102_00_s","rapi_red":"si_c016_00_s","cinderella":"si_c511_00_s","grave_p":"si_c514_00_s"},"lines":[{"id":"d_main_35_01_1","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_1","text":"Is this it?","jump":null,"exit":false,"enter":null,"bg":"Bog","bgArt":"bog","image":null,"bgm":"bgm_chapter35_field_swamp_a","movie":null,"shown":["laplace","drake","maxwell","rapi_red","cinderella","grave_p"],"affinity":null},{"id":"d_main_35_01_2","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_2","text":"Is this the new stage on which Matis will shine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_3","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_3","text":"It's really dark in here. The ground is soggy and sticky as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_4","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_4","text":"Hmm... It seems like this place used to be a jungle or something similar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_5","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_01_5","text":"That's right. I heard it was a nature preserve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_6","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_01_6","text":"Human interference was kept to a minimum, and as a result, the area is largely untouched.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_7","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_01_7","text":"That means we probably won't find many facilities we can use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_8","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_8","text":"Hmm... I'm not picking up much electricity. How am I supposed to shine here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_9","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_9","text":"How can I use my glorious Drake sensors under these conditions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_01_10","text":"Right, I forgot that you can sense electricity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_01_11","text":"I suppose that makes you a sort of semi-operator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_12","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_12","text":"\"Semi-operator\"? What an impudent remark! I could easily replace three operators!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_01_13","text":"Oh, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_14","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_14","text":"... Okay, maybe not that much. I can't beat the specialists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_15","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_15","text":"While we're on the subject, is Shifty not participating in this operation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_16","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_01_16","text":"She's busy resolving some issues that cropped up during the last extermination mission in the Crystal Region.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_01_17","text":"Plus, you all are here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_18","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_18","text":"Do you know what these \"issues\" are, by any chance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_01_19","text":"No, but they seem fairly significant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_20","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_20","text":"Problems, problems everywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_21","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_21","text":"If there's a problem, just call me, and I'll come running! This hero can solve anything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_22","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_22","text":"If there's a problem, just call me, and I'll come running! I'll make it even more calamitous!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_23","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_23","text":"Just be quiet and stay still, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_24","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_25","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_01_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_01_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_27","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_27","text":"Prince.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_28","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_28","text":"Could we perhaps get rid of these individuals?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_29","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_29","text":"They're giving me a headache.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_30","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_01_30","text":"Can I put my helmet back on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_31","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_01_31","text":"All this racket is killing me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_01_32","text":"... Sorry about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_33","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_33","text":"There is no need for you to be sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"