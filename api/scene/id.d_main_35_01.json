text":"They're the most capable squad in all of Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_41","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_41","text":"Nice to meet you, I'm Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_42","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_01_42","text":"I'm Grave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_43","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_44","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_45","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_46","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_46","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_47","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_47","text":"Um... Prince, have greeting customs changed in the past century?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_48","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_48","text":"Is that really Cinderella?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_laplace","movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_49","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_49","text":"I've heard all about you. You're the legendary hero who got turned into a Heretic and back again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_50","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_50","text":"Wow, you're positively radiant! You could pass for Ark Ranger Silver!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_51","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_51","text":"And check out that floating shield! Can it fly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_52","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_52","text":"Oooh, and your eyes are red!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_53","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_53","text":"We were infected with corruption before too, you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_54","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_54","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_55","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_55","text":"But we overcame it through sheer force of will!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_56","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_01_56","text":"What? No we didn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_57","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_57","text":"Did you power your way through the corruption as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_58","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_35_01_58","text":"How did you overcome it? We'll use it as a future reference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_59","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_01_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_60","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_60","text":"What is this foolishness?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_61","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_61","text":"Why are you trying to impersonate a villain with that getup?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_62","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_62","text":"I've never seen such an outfit before, and it's impossible for there to be a villain I've never heard of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_63","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_01_63","text":"... I'm not a villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_64","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_64","text":"Don't lie to me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_65","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_65","text":"The half-covered face. The doom-and-gloom wardrobe. That coffin on your back. The imposing voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_66","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_66","text":"You're practically screaming out loud that you're a villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_67","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_01_67","text":"... I'm not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_01_68","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_01_68","text":"Fine. Even though we've only just met, I acknowledge your overwhelming villainous energy.","jump":null,"exit":false,"enter":