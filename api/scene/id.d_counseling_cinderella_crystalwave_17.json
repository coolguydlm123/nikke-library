{"id":"d_counseling_cinderella_crystalwave_17","cat":"counsel","group":{"id":"char5175","label":"Cinderella: Crystal Wave"},"label":"Advising Cinderella: Crystal Wave: 17","stage":null,"prev":"d_counseling_cinderella_crystalwave_16","next":"d_counseling_cinderella_crystalwave_18","speakers":{"cinderella_s":"Cinderella"},"icons":{"cinderella_s":"si_c515_00_s"},"lines":[{"id":"d_counseling_cinderella_crystalwave_17_1","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_1","text":"Which do you prefer, a sunlit ocean or a moonlit one?","jump":null,"exit":false,"enter":null,"bg":"JungleIsland_Out_d","bgArt":"jungleisland_out_d","image":null,"bgm":"event_bgm_wtu_seabreeze","movie":null,"shown":["cinderella_s"],"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_2","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_2","text":"Both are beautiful when they sparkle, but you can only choose one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_3","text":"I like a sunlit ocean.","jump":"d_counseling_cinderella_crystalwave_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_crystalwave_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_4","text":"I like a moonlit ocean.","jump":"d_counseling_cinderella_crystalwave_17_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_crystalwave_17_5","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_5","text":"Right. The sunlight reflecting on the water can be blinding, but I suppose it does make it that much more beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_6","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_6","text":"However, having to scrunch your face from the glare isn't very beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_7","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_7","text":"That's why I prefer a moonlit ocean.","jump":"d_counseling_cinderella_crystalwave_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_8","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_8","text":"I knew you'd feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_9","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_9","text":"The ocean does sparkle beautifully under the sunlight,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_10","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_10","text":"but the ocean becomes even more beautiful under the moonlight because it doesn't blind you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_11","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_11","text":"The moonlight reflected on the waves is also breathtaking.","jump":"d_counseling_cinderella_crystalwave_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_17_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_17_12","text":"Cinderella and I take a stroll along the beach.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}