r_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_17","text":"If that's the case... then just kill me and take Lilith's body!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_18","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_18","text":"Ugh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_19","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_19","text":"What are you doing? Hurry up and kill me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_intermission_01_20","text":"Nayuta places her palm in front of Nihilister's forehead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_intermission_01_21","text":"Nayuta's wrist glows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_22","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_22","text":"... Canst thou not break free of it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_23","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_23","text":"As long as I'm a Rapture, as long as I'm a Heretic... it's impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_24","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_24","text":"Haha... we were born like this, after all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_25","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_25","text":"Damn it all to hell...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_26","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_26","text":"Arrrgggh!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_27","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_intermission_01_27","text":"Their cores hath been wholly torn asunder. What is the cause thereof?","jump":null,"exit":false,"enter":null,"bg":"TemporaryCamp","bgArt":"temporarycamp","image":null,"bgm":null,"movie":null,"shown":["nayuta"],"affinity":null},{"id":"event_goddessfall1_intermission_01_28","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_intermission_01_28","text":"Without a core, the bodies of human imposters are worthless to the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_intermission_01_29","type":"Speech","speaker":"nihilis