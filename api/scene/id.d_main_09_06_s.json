aker":"anis","key":"Locale_MainScenario:d_main_09_06_s_62","text":"This isn't over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09_06_s_63","type":"Speech","speaker":"syuen_op","key":"Locale_MainScenario:d_main_09_06_s_63","text":"A hunk of scrap metal threatening a human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09_06_s_64","type":"Speech","speaker":"syuen_op","key":"Locale_MainScenario:d_main_09_06_s_64","text":"Please no, I'm shaking in my boots! Save me Raptures, save me! Haha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}