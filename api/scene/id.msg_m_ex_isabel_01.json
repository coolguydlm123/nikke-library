{"id":"msg_m_ex_isabel_01","cat":"messenger","group":{"id":"room_isabel","label":"Isabel · Nikke"},"label":"1. Hello.","stage":null,"prev":null,"next":"msg_m_ex_isabel_02","speakers":{"isabel":"Isabel"},"icons":{"isabel":"si_c231_00_s"},"lines":[{"id":"m_ex_isabel_01_1","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_1","text":"Hello.","jump":null},{"id":"m_ex_isabel_01_2","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_2","text":"Do you remember me,","jump":null},{"id":"m_ex_isabel_01_3","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_3","text":"Darling?","jump":null},{"id":"m_ex_isabel_01_4","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_4","text":"Of course.","jump":"m_ex_isabel_01_6"},{"id":"m_ex_isabel_01_5","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_5","text":"Remind me again?","jump":"m_ex_isabel_01_13"},{"id":"m_ex_isabel_01_6","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_6","text":"Oh my!","jump":null},{"id":"m_ex_isabel_01_7","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_7","text":"That's music to my ears.","jump":null},{"id":"m_ex_isabel_01_8","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_8","text":"Glad to hear I at least made something of an impression.","jump":null},{"id":"m_ex_isabel_01_9","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_9","text":"Yet, I'm currently in somewhat of a lousy mood.","jump":null},{"id":"m_ex_isabel_01_10","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_10","text":"I was going to call you earlier,","jump":null},{"id":"m_ex_isabel_01_11","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_11","text":"but I'm shy around strangers.","jump":null},{"id":"m_ex_isabel_01_12","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_12","text":"So, I need a little pick-me-up.","jump":"m_ex_isabel_01_20"},{"id":"m_ex_isabel_01_13","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_13","text":"You're still as mischievous as before","jump":null},{"id":"m_ex_isabel_01_14","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_14","text":"and always know how to push my buttons.","jump":null},{"id":"m_ex_isabel_01_15","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_15","text":"Even so, I know you're just teasing me.","jump":null},{"id":"m_ex_isabel_01_16","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_16","text":"I'm sure you were waiting for my call, weren't you?","jump":null},{"id":"m_ex_isabel_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_17","text":"??","jump":null},{"id":"m_ex_isabel_01_18","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_18","text":"Come now, don't try to hide it.","jump":null},{"id":"m_ex_isabel_01_19","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_19","text":"I can read you like an open book.","jump":null},{"id":"m_ex_isabel_01_20","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_20","text":"It's nice to role-play every once a while, don't you think?","jump":null},{"id":"m_ex_isabel_01_21","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_21","text":"Pretend to be strangers who are meeting for the first time...","jump":null},{"id":"m_ex_isabel_01_22","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_22","text":"Wouldn't you say that it's exhilarating?","jump":null},{"id":"m_ex_isabel_01_23","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_23","text":"Anyhoo, if you want to know anything about me,","jump":null},{"id":"m_ex_isabel_01_24","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_24","text":"ask away.","jump":null},{"id":"m_ex_isabel_01_25","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_25","text":"Why do you call me Darling?","jump":"m_ex_isabel_01_27"},{"id":"m_ex_isabel_01_26","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_26","text":"You're working for another Commander, so why are you responding to me?","jump":"m_ex_isabel_01_36"},{"id":"m_ex_isabel_01_27","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_27","text":"Cus...","jump":null},{"id":"m_ex_isabel_01_28","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_28","text":"do you really wanna know?","jump":null},{"id":"m_ex_isabel_01_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_29","text":"Yes.","jump":null},{"id":"m_ex_isabel_01_30","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_30","text":"Well, I'm hoping that one day you'll...","jump":null},{"id":"m_ex_isabel_01_31","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_31","text":"There's a long silence.","jump":null},{"id":"m_ex_isabel_01_32","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_32","text":"I can't do it.","jump":null},{"id":"m_ex_isabel_01_33","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_33","text":"I'd rather not discuss it over text.","jump":null},{"id":"m_ex_isabel_01_34","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_34","text":"Sorry.","jump":null},{"id":"m_ex_isabel_01_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_35","text":"It's okay.","jump":"m_ex_isabel_01_42"},{"id":"m_ex_isabel_01_36","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_36","text":"It's because you've given me something,","jump":null},{"id":"m_ex_isabel_01_37","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_37","text":"even my own Commander doesn't give me.","jump":null},{"id":"m_ex_isabel_01_38","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_38","text":"Once I've accomplished a task,","jump":null},{"id":"m_ex_isabel_01_39","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_39","text":"he doesn't want anything to do with me.","jump":null},{"id":"m_ex_isabel_01_40","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_40","text":"Does that explain things?","jump":null},{"id":"m_ex_isabel_01_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_41","text":"Sure.","jump":null},{"id":"m_ex_isabel_01_42","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_42","text":"All right, my turn.","jump":null},{"id":"m_ex_isabel_01_43","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_43","text":"What kind of girls do you like?","jump":null},{"id":"m_ex_isabel_01_44","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_44","text":"No, wait...","jump":null},{"id":"m_ex_isabel_01_45","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_45","text":"What kind of Nikkes do you like?","jump":null},{"id":"m_ex_isabel_01_46","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_46","text":"Strong and amiable.","jump":"m_ex_isabel_01_48"},{"id":"m_ex_isabel_01_47","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_47","text":"Nikkes like you.","jump":"m_ex_isabel_01_53"},{"id":"m_ex_isabel_01_48","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_48","text":"Strong and amiable,","jump":null},{"id":"m_ex_isabel_01_49","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_49","text":"just like you.","jump":null},{"id":"m_ex_isabel_01_50","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_50","text":"No surprise there.","jump":null},{"id":"m_ex_isabel_01_51","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_51","text":"People say that lovers start to bleed into one another over time.","jump":null},{"id":"m_ex_isabel_01_52","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_52","text":"I'm sure I'll be like you in the future.","jump":"m_ex_isabel_01_58"},{"id":"m_ex_isabel_01_53","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_53","text":"Where'd that come from?","jump":null},{"id":"m_ex_isabel_01_54","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_54","text":"To think you've said smth like this out of nowhere","jump":null},{"id":"m_ex_isabel_01_55","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_55","text":"Sorry,","jump":null},{"id":"m_ex_isabel_01_56","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_56","text":"but I just don't know what to say.","jump":null},{"id":"m_ex_isabel_01_57","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_57","text":"I'm glad you feel that way though.","jump":null},{"id":"m_ex_isabel_01_58","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_58","text":"... Isabel seems to be unsure of what to reply.","jump":null},{"id":"m_ex_isabel_01_59","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_59","text":"I'm glad I got to","jump":null},{"id":"m_ex_isabel_01_60","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_60","text":"talk with you today.","jump":null},{"id":"m_ex_isabel_01_61","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_61","text":"Would you mind if we keep in touch?","jump":null},{"id":"m_ex_isabel_01_62","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_62","text":"I can send you a message whenever I'm feeling lonely.","jump":null},{"id":"m_ex_isabel_01_63","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_63","text":"Sure.","jump":null},{"id":"m_ex_isabel_01_64","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_64","text":"Thanks.","jump":null},{"id":"m_ex_isabel_01_65","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_65","text":"I'll see you later.","jump":null},{"id":"m_ex_isabel_01_66","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_66","text":"I've got an assignment","jump":null},{"id":"m_ex_isabel_01_67","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_67","text":"up on the surface.","jump":null},{"id":"m_ex_isabel_01_68","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_68","text":"Wait, so you've been in the Ark this entire time?","jump":null},{"id":"m_ex_isabel_01_69","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_69","text":"Yep!","jump":null},{"id":"m_ex_isabel_01_70","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_70","text":"I just wanted to see your reaction","jump":null},{"id":"m_ex_isabel_01_71","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_71","text":"when you were chatting with me.","jump":null},{"id":"m_ex_isabel_01_72","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_72","text":"??","jump":null},{"id":"m_ex_isabel_01_73","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_73","text":"I'll always be with you","jump":null},{"id":"m_ex_isabel_01_74","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_74","text":"wherever you are,","jump":null},{"id":"m_ex_isabel_01_75","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_75","text":"my Darling.","jump":null},{"id":"m_ex_isabel_01_76","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_76","text":"All right, it's time for me to go.","jump":null},{"id":"m_ex_isabel_01_77","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_isabel_01_77","text":"I need to hurry. Don't wanna to test Noah's patience.","jump":null},{"id":"m_ex_isabel_01_78","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_78","text":"Wait!","jump":null},{"id":"m_ex_isabel_01_79","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_isabel_01_79","text":"Failed to send message.","jump":null}],"chat":true}