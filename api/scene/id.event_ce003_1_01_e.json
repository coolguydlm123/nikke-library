inity":null},{"id":"event_ce003_1_01_e_60","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce003_1_01_e_60","text":"this isn't the first time we've gone through something like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_01_e_61","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce003_1_01_e_61","text":"If anything, it'd be weird if it all went smoothly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_01_e_62","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce003_1_01_e_62","text":"I don't think we'll be getting much more information here, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_01_e_63","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce003_1_01_e_63","text":"I suggest returning to the Ark for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_01_e_64","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_01_e_64","text":"Yes. Let's go back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}