{"id":"event_projectmatis2_04_s","cat":"event","group":{"id":"ev40116","label":"PROJECT MATIS · Part 1"},"label":"To Make a Hero: A","stage":null,"prev":"event_projectmatis2_intermission_01","next":"event_projectmatis2_04_e","speakers":{"syuen":"Syuen","jien":"Jien","laplace_proto":"Laplace","maxwell_h":"Maxwell"},"icons":{"syuen":"si_c901_00_s","jien":"si_c973_00_s","laplace_proto":"si_c103_01_s","maxwell_h":"si_c105_01_s"},"lines":[{"id":"event_projectmatis2_04_s_1","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"event_bgm_pmatis_mdaughters","movie":null,"shown":["syuen","jien"],"affinity":null},{"id":"event_projectmatis2_04_s_2","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_2","text":"I never imagined you'd be the one to reach out first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_3","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_3","text":"What's this about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_4","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_4","text":"I need your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_5","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_5","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_6","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_6","text":"I'm asking you to help me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_7","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_7","text":"... Another surprise. What's gotten into you all of a sudden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_8","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_8","text":"I want to strike back at the board.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_9","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_9","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_10","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_10","text":"I want to make it so they'll never touch what's mine again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_11","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_11","text":"But... I'm not powerful enough to take them all on by myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_12","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_12","text":"Can you help me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_13","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_13","text":"You do realize they're all Father's people, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_14","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_14","text":"He may have left years ago, but they're still acting as his eyes and ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_15","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_15","text":"Do you understand what that means?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_16","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_16","text":"Father's still watching over us, even now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_17","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_17","text":"Isn't that why you've been so afraid of them all this time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_18","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_18","text":"... Yeah, I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_19","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_19","text":"Father might not take too kindly to you going after them. Are you okay with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_20","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_20","text":"... I don't care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_21","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_21","text":"Oh? Is that right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_22","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_22","text":"You're fully aware of the risks, and still want to gouge out Father's eyes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_23","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_23","text":"If I don't, those leeches will keep trying to take what's mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_24","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_24","text":"This whole fiasco taught me something important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_25","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_25","text":"If I want to protect what's mine, I have to crush the opposition through brute force.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_26","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_26","text":"I'll make them so terrified, so helpless, that they'll never dare to lift a finger against me again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_27","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_28","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_28","text":"So help me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_29","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_29","text":"You...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_30","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_30","text":"You hate Father, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_31","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_31","text":"Haha! You're really prepared to go all in, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_32","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_32","text":"Sounds like you learned a lot from your project going up in flames.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_33","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_33","text":"Are you going to help, or not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_34","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_34","text":"If I do this for you, what are you going to do for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_35","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_35","text":"Nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_36","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_36","text":"What? So you're just going to use me and give nothing in return? That's rich.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_37","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_37","text":"You're one to talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_38","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_38","text":"Those roaches bother you just as much, don't they?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_39","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_39","text":"That's why you kept coming to me, egging me into fights with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_40","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_40","text":"You want me to get rid of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_41","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_42","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_42","text":"And what makes you think that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_43","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_43","text":"If you wanted my position, you'd have taken me down long ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_44","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_44","text":"You've had plenty of time and reasons to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_45","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_45","text":"But you didn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_46","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_46","text":"That means you're thinking the same thing I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_47","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_48","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_48","text":"Tell me I'm wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_49","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_49","text":"Hehe, looks like you figured me out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_50","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_50","text":"You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_51","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_51","text":"I loathe those vermin just as much as you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_52","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_52","text":"Acting as Father's eyes... ha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_53","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_53","text":"Just the thought of it makes me want to grind every last one of them to a pulp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_54","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_55","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_55","text":"Sure. I'll help you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_56","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis2_04_s_56","text":"Where do I start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_57","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_57","text":"Syuen! Maxwell! It's an emergency!","jump":null,"exit":false,"enter":null,"bg":"MatisLaboratory","bgArt":"matislaboratory","image":null,"bgm":"bgm_theruinedcity","movie":null,"shown":["laplace_proto","maxwell_h"],"affinity":null},{"id":"event_projectmatis2_04_s_58","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_58","text":"There's no one in the dorms!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_59","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_59","text":"Everyone packed up and left!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_60","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_60","text":"Agh, stop shouting. We already know, so get over here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_61","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_61","text":"You know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_04_s_62","text":"Laplace comes over to Maxwell and Syuen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_63","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_63","text":"Everyone who was left took their compensation and chose to be turned into ordinary Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_64","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_64","text":"I thought at least one or two would stick around, but none did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_65","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_65","text":"It's fine. We wouldn't be able to make anything but scrap metal with that kind of trash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_66","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_66","text":"Scrap metal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_67","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_67","text":"Syuen, how many times do I have to tell you not to talk like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_68","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_68","text":"I'm just calling them what they are! What else should I call them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_69","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_69","text":"Worthless failures like those aren't Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_70","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_70","text":"Not just anyone gets to be called a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_71","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_71","text":"This whole thing has made that clear to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_72","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_72","text":"Real Nikkes are different from scrap metal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_73","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_73","text":"They don't lose their memories just because their body's been swapped out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_74","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_74","text":"Nikkes have the power—the superhuman power—to overcome anything thrown at them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_75","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_75","text":"It's a name fit only for a precious few, like the heroes I'm going to make.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_76","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_76","text":"Ah, so if they're precious, they're Nikkes, and if not, they're scrap metal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_77","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_77","text":"Ugh, enough! See? Now you've got Laplace picking it up too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_78","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_78","text":"Anyway, that's not important. What matters now is that our project is devoted to a single person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_79","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_79","text":"Hm? Just one person?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_80","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_80","text":"That's right. Until the first Matis squad is complete, this project will be focused on further developing just one person: you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_81","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_81","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_82","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_82","text":"There are no other candidates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_83","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_83","text":"You're both the first and the only member of Matis right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_84","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_84","text":"If we manage to get you up to the proper specs, the project will be a success. If not, it'll be a failure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_85","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_85","text":"We'll determine which it is in a month from now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_86","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_86","text":"You will bring down a Tyrant-class Rapture by yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_87","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_87","text":"A Tyrant-class Rapture? All by herself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_88","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_04_s_88","text":"Do you really think that's possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_89","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_89","text":"It has to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_90","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_90","text":"It'll take at least that much to prove to the world that you're a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_91","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_92","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_92","text":"You think you can do it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_93","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_93","text":"... I can do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_94","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_94","text":"I mean, I'm going to do it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_95","type":"Speech","speaker":"laplace_proto","key":"Locale_MainScenario:event_projectmatis2_04_s_95","text":"I have to become a hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_96","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_96","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_04_s_97","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis2_04_s_97","text":"Then let's get started.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}