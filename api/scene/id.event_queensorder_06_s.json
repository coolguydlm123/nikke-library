{"id":"event_queensorder_06_s","cat":"event","group":{"id":"ev40015","label":"QUEEN'S ORDER"},"label":"The Order of Rosanna: A","stage":null,"prev":"event_queensorder_05_e","next":"event_queensorder_06_e","speakers":{"rosanna":"Rosanna","redthicket01":"\"Red Grass\" Member","redthicketboss":"\"Red Grass\" Leader"},"icons":{"rosanna":"si_c280_00_s","redthicket01":"si_c999_00_s","redthicketboss":"si_c999_00_s"},"lines":[{"id":"event_queensorder_06_s_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_1","text":"Once, there was a boy who was born in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_2","text":"Ever since he was little, he lived in the shadows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_3","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_3","text":"In the Outer Rim, there was no light in the sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_4","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_4","text":"Even in the subterranean metropolis of the Ark, the residents live under an artificially lit sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_5","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_5","text":"The same cannot be said for those unfortunate enough to reside in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_6","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_6","text":"This angered the boy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_7","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_7","text":"He became an adult, and before long, became strong enough to work his way into the Ark's criminal underworld.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_8","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_8","text":"Even then, however, he felt that he did not belong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_9","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_9","text":"Despite being in the Ark, he always had to hide in the shadows, away from the light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_10","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_10","text":"He began to think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_11","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_11","text":"This barrier that separated the Outer Rim and the Ark","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_12","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_12","text":"was what kept them confined in this festering garbage heap of a slum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_13","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_13","text":"If that barrier were gone, they could all escape from the dark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_14","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_14","text":"and run headlong into the light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_15","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_15","text":"So he prepared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_16","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_16","text":"He carried out all manner of dirty work for a rich man from the Ark, and used the money gained from it to purchase explosives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_17","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_17","text":"Using some of these bombs, he destroyed one of the individuals who were most likely to derail his plans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_18","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_18","text":"After today, he would destroy this wretched barrier and enter the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_19","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_19","text":"However, the moment he approached the barrier, filled with grand hopes and aspirations...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_20","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_20","text":"Hey there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rosanna"],"affinity":null},{"id":"event_queensorder_06_s_21","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_21","text":"About time you showed up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_22","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_22","text":"The very person he thought he had eliminated, has risen once again, and is blocking his path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_23","type":"Speech","speaker":"redthicket01","key":"Locale_SubScenario:event_queensorder_06_s_23","text":"!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_24","type":"Speech","speaker":"redthicketboss","key":"Locale_SubScenario:event_queensorder_06_s_24","text":"I-it's you?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_25","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_25","text":"The one and only.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_26","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_26","text":"I was so touched by the thoughtful surprise you arranged for me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_27","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_27","text":"so I wanted to return the favor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_28","type":"Speech","speaker":"redthicketboss","key":"Locale_SubScenario:event_queensorder_06_s_28","text":"Eek! Change of plans!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_29","type":"Speech","speaker":"redthicketboss","key":"Locale_SubScenario:event_queensorder_06_s_29","text":"Detonate it now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_30","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_30","text":"The Red Grass members push the button.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_31","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_31","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_32","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_33","type":"Speech","speaker":"redthicket01","key":"Locale_SubScenario:event_queensorder_06_s_33","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_34","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_queensorder_06_s_34","text":"Nothing happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_35","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_35","text":"You moron.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_36","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_36","text":"Do you think I'd just waltz in here without defusing the bombs first?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_37","type":"Speech","speaker":"redthicketboss","key":"Locale_SubScenario:event_queensorder_06_s_37","text":"!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_38","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_38","text":"Let me fill you in on a little secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_queensorder","movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_39","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_39","text":"That store you planted your bomb in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_40","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_40","text":"One of our members ran that place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_41","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_41","text":"I don't know","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_42","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_42","text":"if it has more to do with luck or skill, but he was able to have a kid and raise him in the rough-and-tumble Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_43","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_43","text":"That little bugger is still kicking. Gonna be turning 5 this year.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_44","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_44","text":"That kid's a real handful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_45","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_45","text":"He's always pushing my buttons, utterly clueless that his father works for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_46","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_46","text":"He's got no manners whatsoever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_47","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_47","text":"He honestly thinks all the food that's put on his table was paid for by his father.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_48","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_48","text":"Haha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_49","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_49","text":"Isn't that ridiculous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_50","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_50","text":"I provide a roof over his head, clothes on his back, and put food on his table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_51","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_51","text":"His ignorance is honestly kind of beguiling, and I find it cute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_52","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_52","text":"It's refreshing, and something you don't often find in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_53","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_53","text":"It's nice to see this so-called familial love.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_54","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_54","text":"Finding something like that here is rare, wouldn't you agree?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_55","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_55","text":"But you know what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_56","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_56","text":"His father is dead now,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_57","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_57","text":"thanks to that bomb you set off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_58","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_58","text":"A beautiful thing, completely eradicated in an instant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_59","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_59","text":"Bang!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_60","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_60","text":"All gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_61","type":"Speech","speaker":"redthicketboss","key":"Locale_SubScenario:event_queensorder_06_s_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_62","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_62","text":"Ah, right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_63","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_63","text":"You said you wanted to topple the barrier and live like everyone else does in the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_64","type":"Speech","speaker":"rosanna","key":"Locale_SubScenario:event_queensorder_06_s_64","text":"right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_queensorder_06_s_65","typ