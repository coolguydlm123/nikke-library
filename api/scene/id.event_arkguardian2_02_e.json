{"id":"event_arkguardian2_02_e","cat":"event","group":{"id":"ev40098","label":"ARK GUARDIAN · Part 1"},"label":"The Real Enemy: B","stage":null,"prev":"event_arkguardian2_02_s","next":"event_arkguardian2_03_s","speakers":{"commander":"Commander","VTCPriestess":"V.T.C. Priestess","CGplatoonleader":"Central Government Platoon Leader"},"icons":{"commander":"si_c942_00_s","VTCPriestess":"si_c9016_00_s","CGplatoonleader":"si_c9015_00_s"},"lines":[{"id":"event_arkguardian2_02_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_1","text":"The Commander opens his eyes.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"event_bgm_redash_ashsmoke","movie":null,"shown":["commander","VTCPriestess"],"affinity":null},{"id":"event_arkguardian2_02_e_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_2","text":"The V.T.C. priestess sits across from him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_3","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_3","text":"I see you felt it necessary to hogtie me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_4","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_4","text":"We've also administered a tranquilizer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_5","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_5","text":"I'm just one man, not an elephant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_6","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_6","text":"It doesn't seem to make a difference. You're far more conscious than a human who's been tranquilized.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_7","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_7","text":"Well then,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_8","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_8","text":"mind telling me what's up with this circus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_9","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_9","text":"We intend to study your blood and develop a method to mass-produce Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_10","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_10","text":"And if you take a few too many pints of blood, I'll die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_11","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_11","text":"You need not worry, we will only extract enough to keep you alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_12","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_12","text":"Can't I just give you a little bit at a time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_13","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_13","text":"If the sample size is too small, it will create difficulties in several aspects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_14","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_14","text":"I've no idea what's gotten you in such a tizzy,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_15","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_15","text":"but I'm the Commander of the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_16","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_16","text":"I'm currently part of an operation to guard the Ark's entrance while it's being sealed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_17","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_17","text":"If I don't do my job, thousands—maybe even tens of thousands—could die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_18","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_18","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_19","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_20","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_20","text":"Let me guess, you don't care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_21","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_21","text":"No, I do not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_22","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_22","text":"Besides, humanity has already lost. During the first phase of the sealing, all key personnel have already descended into the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_23","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_23","text":"In truth, that number alone is sufficient to maintain the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_24","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_24","text":"Nevertheless, the reason we have to push through to Phase 3,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_25","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_25","text":"is for the sake of the ignorant masses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_26","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_26","text":"Phase 3?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_27","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_27","text":"What happened to Phases 4 and 5?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_28","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_29","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_29","text":"... So you're cutting the operation short at Phase 3.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_30","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_30","text":"Indeed. The Raptures have already begun mass-producing Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_31","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_31","text":"To delay any further would put the Ark in serious peril.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_32","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_32","text":"We must protect its citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_33","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_33","text":"How merciful of V.T.C. A real bunch of saints.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_34","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_34","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_35","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_35","text":"You could lose the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_36","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_37","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_37","text":"You don't care about that either?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_38","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_38","text":"Technology is ever-advancing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_39","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_39","text":"The latest generation is already on the heels of the Grimms model.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_40","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_40","text":"Only a fool believes higher specs are the answer to everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_41","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_41","text":"The war is already lost, and humanity has retreated below the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_42","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_42","text":"The gifted must prepare for the future—for the counterattack yet to come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_43","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_43","text":"Your blood donation will serve as one of the cornerstones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_44","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_45","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_45","text":"I'm done talking to the help. Call for your leader.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_46","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_46","text":"If we're going to have a real conversation, I need to talk to someone of my rank.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_47","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_47","text":"This matter has been authorized by the higher-ups—straight from the top.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_48","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_48","text":"Oh? The one you call Her Holiness?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_49","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_49","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_50","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_50","text":"Crazy bunch of cultish freaks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_51","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_51","text":"Kindly mind your words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_52","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_52","text":"What a load of crap. If you were about to spend your life as a walking blood bag, you wouldn't be minding your words either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_53","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_53","text":"Fair point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_54","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_54","text":"Now, untie me and let me leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_55","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_55","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_56","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_56","text":"I'll give you my autograph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_57","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_57","text":"No need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_58","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_58","text":"Fine, I'm feeling generous. How about a photo?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_59","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_59","text":"Not interested.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_60","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_60","text":"Okay then, how about a dinner date with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_61","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_61","text":"No, thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_62","text":"*Whoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_63","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_63","text":"Excuse me, Priestess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["CGplatoonleader"],"affinity":null},{"id":"event_arkguardian2_02_e_64","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_64","text":"... What is it? I told you no one is authorized to enter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_65","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_65","text":"I apologize, but we have a... situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_66","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_66","text":"What situation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_67","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_67","text":"A Central Government soldier approaches the V.T.C. priestess and whispers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_68","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_68","text":"Her face twists and contorts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_69","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_69","text":"... What did you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_70","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_70","text":"The officials are waiting outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_71","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_72","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_72","text":"Excuse me for a moment. We shall continue this conversation when I return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_73","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_73","text":"What, did Her Holiness pass away? She did seem like she was hanging on by a thread.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_74","type":"Speech","speaker":"VTCPriestess","key":"Locale_MainScenario:event_arkguardian2_02_e_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_75","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_75","text":"Oh snap, did I get it right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_76","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_76","text":"Told you. You should have lived a bit more righteously. Now you'll pay the price for your sins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_77","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_77","text":"With a grim expression, the priestess leaves the room, accompanied by the soldier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_78","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_78","text":"*Whoosh whoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_79","text":"The door opens and closes behind them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_80","text":"The Commander strains his ears, listening to the sounds beyond the door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_81","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_81","text":"The priestess raises her voice,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_82","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_82","text":"gradually getting louder until she's nearly shouting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_83","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_83","t