ffinity":null},{"id":"event_arkguardian2_02_e_97","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_97","text":"Oh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_98","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_98","text":"Here to break me out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_99","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_99","text":"Yes. Hold on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_100","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_100","text":"The platoon leader's hands move quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_101","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_101","text":"Let me get these off you. Just bear with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_102","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_102","text":"What are you doing here, anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_103","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_103","text":"I was dispatched here from the headquarters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_104","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_104","text":"I heard of your arrival, so I thought I'd drop by and say hello.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_105","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_105","text":"But something felt off. Everyone was acting all secretive, and the tension was palpable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_106","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_106","text":"Then I overheard you and the priestess talking through the door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_107","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_107","text":"If you're here, you must be one of them, right? A real hardcore devotee of the V.T.C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_108","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_108","text":"That's right. I've been baptized as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_109","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_109","text":"So what possessed you to snap a priestess's neck?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_110","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_110","text":"I worship the Goddess Squad above all else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_111","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_111","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_112","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_112","text":"Done. Can you stand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_113","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_113","text":"Ugh... Damn... I feel like death warmed over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_114","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_114","text":"It's remarkable that you're able to stand in your condition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_115","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_115","text":"Here, hang onto me. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_116","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_116","text":"The hangar's up ahead. Inside is the ATV I arrived in. Use it.","jump":null,"exit":false,"enter":null,"bg":"NikkeCorridor","bgArt":"nikkecorridor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_117","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_117","text":"... All right. Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_118","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_118","text":"*Thump thump thump thump thump*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_119","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_119","text":"Footsteps echo in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_120","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_120","text":"We finally got caught. Took 'em long enough, their security is pretty sloppy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_121","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_121","text":"Ten or more inbound. Armed from the sound of their heavy footsteps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_122","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_122","text":"Hey, Platoon Leader. Got any spare steel for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_123","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_123","text":"A sidearm works too. I don't miss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_124","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_124","text":"One second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_125","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_02_e_125","text":"The platoon leader rummages through his jacket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_126","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_126","text":"Here, the key to the ATV.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_127","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian2_02_e_127","text":"Why are you giving this to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_128","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian2_02_e_128","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_02_e_129","