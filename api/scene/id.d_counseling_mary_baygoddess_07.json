{"id":"d_counseling_mary_baygoddess_07","cat":"counsel","group":{"id":"char5064","label":"Mary: Bay Goddess"},"label":"Advising Mary: Bay Goddess: 07","stage":null,"prev":"d_counseling_mary_baygoddess_06","next":"d_counseling_mary_baygoddess_08","speakers":{"mary_s":"Mary"},"icons":{"mary_s":"si_c132_00_s"},"lines":[{"id":"d_counseling_mary_baygoddess_07_1","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_1","text":"More and more people have been getting stung by jellyfish lately.","jump":null,"exit":false,"enter":null,"bg":"Beach_d","bgArt":"beach_d","image":null,"bgm":"bgm_story_summermood","movie":null,"shown":["mary_s"],"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_2","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_2","text":"Typically, it's not a big deal, but you never know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_3","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_3","text":"I've been telling everyone to be careful, but no one listens to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_4","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_4","text":"And it's not like I can capture the jellyfish... This is really quite worrisome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_5","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_5","text":"Do you have any suggestions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_07_6","text":"How about putting up a warning sign that people won't miss?","jump":"d_counseling_mary_baygoddess_07_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_baygoddess_07_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_07_7","text":"Put your trust in me. I'll kill all the jellyfish.","jump":"d_counseling_mary_baygoddess_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_baygoddess_07_8","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_8","text":"A great idea as always, Commander. Good thing I asked you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_9","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_9","text":"That shouldn't be too hard to pull off, and it will likely reduce the number of stings significantly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_10","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_10","text":"I'll discuss with Pepper how to make that sign.","jump":"d_counseling_mary_baygoddess_07_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_11","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_11","text":"That may be a bit extreme...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_12","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_12","text":"We don't want to kill off an entire species just because they pose an inconvenience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_13","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_13","text":"Besides, I don't think that would really reduce the number of people getting stung.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_14","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_07_14","text":"Moreover, we might find you washed up on the shore \ncovered in jellyfish stings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_07_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_07_15","text":"Mary and I learn about jellyfish.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}