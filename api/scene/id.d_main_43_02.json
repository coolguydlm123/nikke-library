ull},{"id":"d_main_43_02_41","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_41","text":"Question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_42","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_42","text":"How many people do you think are here right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_43","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_43","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_44","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_44","text":"You've no idea, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_45","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_45","text":"There are around twenty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_46","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_46","text":"They've been discreetly watching over you around the clock, in case something happens to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_47","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_47","text":"They're so skilled that you haven't even noticed them in all this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_48","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_48","text":"You're just making things up. How can you tell if there are guards or not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_49","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_49","text":"Princess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_50","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_50","text":"You know where we are, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_51","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_52","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_52","text":"We're in Ephialtes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_53","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_53","text":"the most dangerous place in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_54","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_54","text":"A young girl like you doing nothing but strutting around,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_55","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_55","text":"flaunting your nasty temper in a place like this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_56","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_56","text":"You really think it was just luck that nothing happened to you over the past two years?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_57","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_58","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_58","text":"You're spinning lies so you can pocket my money!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_59","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_59","text":"Big Madam runs the biggest shop in Ephialtes, with the most customers. That's why even a nobody orphan like me can work there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_60","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_60","text":"And the reason it's gotten so big is simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_61","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_61","text":"Big Madam values business and credibility more than her own life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":nul