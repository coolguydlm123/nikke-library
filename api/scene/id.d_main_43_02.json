{"id":"d_main_43_02","cat":"main","group":{"id":"ch43","label":"Chapter 43 · Key"},"label":"Princess","stage":"43-4 STAGE · Start","prev":"d_main_43_01","next":"d_main_43_03","speakers":{"stall3rd":"Stall III","princess":"Princess"},"icons":{"stall3rd":"si_c9019_00_s","princess":"si_c9018_00_s"},"lines":[{"id":"d_main_43_02_1","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_1","text":"Are you done cleaning, Princess?","jump":null,"exit":false,"enter":null,"bg":"BadDreamAlley","bgArt":"baddreamalley","image":null,"bgm":"bgm_story_empathize","movie":null,"shown":["stall3rd","princess"],"affinity":null},{"id":"d_main_43_02_2","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_2","text":"Yes, I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_3","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_3","text":"Mind if I do a little inspection?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_4","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_4","text":"Inspection? The nerve of you. You think you're in any position to judge my cleaning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_5","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_5","text":"Don't even bother... This is not something a simpleton like you can judg... Hey! Where are you going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_6","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_6","text":"Just checking on your cleaning.","jump":null,"exit":false,"e