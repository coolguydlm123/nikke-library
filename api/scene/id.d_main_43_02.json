xit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_14","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_14","text":"Another line you've repeated for two years running.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_15","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_15","text":"Silence, you ignorant fool. You have no right to judge the truth of my words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_02_16","text":"Stall III picks up the tissue with her tongs and drops it into the basket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_17","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_17","text":"I just wish you'd put in a little more effort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_18","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_18","text":"This whole thing's a farce anyway. There's no reason to put in any effort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_19","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_19","text":"Hm... I hate to say this, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_20","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_20","text":"That person who's supposed to come get you... maybe they bailed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_21","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_21","text":"On what grounds do you make such preposterous claims? Let's hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_22","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_22","text":"It's been two years since you got here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_23","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_23","text":"And?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_24","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_24","text":"And I'm sure that priestess who left you here said she'd be back for you soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_25","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_25","text":"So?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_26","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_26","text":"So, do you and that priestess have a different sense of time than the rest of us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_27","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_27","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_28","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_28","text":"No matter how you put it, two years hardly qualifies as \"soon.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_29","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_29","text":"Hahaha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_30","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_30","text":"Do not presume to impose your simplistic sense of time on us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_31","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_31","text":"Our perception of time is different from yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_32","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_02_32","text":"Two years is but the blink of an eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_33","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_02_33","text":"You know the money the priestess left us to care for you? It runs out this week.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_02_34",