ongryeon","key":"Locale_MainScenario:event_overzone1_01_s_27","text":"Such stubbornness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_28","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_28","text":"Snow White, why don't you dig some graves while we're here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_29","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_29","text":"That's Rapunzel's job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_30","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_30","text":"So your job begins and ends with blasting a hole through their heads, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_31","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_31","text":"Stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_32","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_32","text":"That's not what she meant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_33","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_33","text":"Is that so? It seems to me that you're quite clear about what each of our professional responsibilities entails.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_34","text":"Rapunzel has always been the one who digs the graves and prays.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_35","text":"It consoles her as much as it does the deceased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_36","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_36","text":"As of right now, that's all she can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_37","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_38","text":"Also,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_39","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_39","text":"I'd like you to put a little more thought into","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_40","text":"how it must feel to be the one responsible for giving corrupted Nikkes a proper send-off day in, day out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_41","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_42","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_42","text":"My apologies. My exhaustion got the better of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_43","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_43","text":"It's okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_44","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_44","text":"I've got the most bullets. It makes the most sense for me to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_45","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_45","text":"No, I will perform this task henceforth. My blade can be swung infinitely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_46","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_46","text":"No. I'll do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_47","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_47","text":"All I have to do is pull a trigger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_48","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_48","text":"You'd have to swing your sword.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_49","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_49","text":"They're... two very different things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_50","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_50","text":"You shouldn't use your sword for something like that anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_51","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_51","text":"Your sister would not have wanted that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_52","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_52","text":"Exactly. So I'll take care of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_53","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_53","text":"... Very well. I apologize.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_54","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_54","text":"Dorothy, when was the last raid?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_55","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_55","text":"Two days ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_56","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_56","text":"Things seem to be slowing down. Hard to believe we were once dealing with three waves a day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_57","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_57","text":"It's the natural progression as time passes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_58","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_58","text":"Raptures have less and less incentive to raid this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_59","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_59","text":"So long as we ride it out for another two months,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_60","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_60","text":"mankind will have a fighting chance. If not on the surface, then in the Ark at the very least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_61","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_61","text":"At long last... the end may be in sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_62","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_62","text":"Took long enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_63","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_63","text":"We've still got a long way to go, so let's stay frosty all the way to the end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_64","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_64","text":"When all of this is over, we'll be rewarded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_65","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_65","text":"People will call us Goddess of Victory, the saviors of mankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_66","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_66","text":"We'll live the rest of our lives in luxury, reveling in our well-deserved praise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_67","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_67","text":"... If you say so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_68","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_68","text":"Two months... Time passed so swiftly up until now, yet two months seem like an eternity to mine ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_69","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_69","text":"So strange, how mine feelings doth change when the end is near.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_70","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_70","text":"It doesn't feel real to me either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_71","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_71","text":"At any rate, I'm heading back to my post and continuing my watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_72","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_72","text":"Already? Don't you want to rest a little?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_73","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_73","text":"There are plenty of Nikkes who can fill in for you. Relax for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_74","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_74","text":"No. The only reason we suppressed this raid was that we knew about it in advance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_75","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_75","text":"Nothing bad can come from remaining alert.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_76","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_overzone1_01_s_76","text":"Snow White walks away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_77","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_78","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_78","text":"'Tis most difficult becoming accustomed to the new Snow White.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_79","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_79","text":"Yeah, a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_80","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_80","text":"However...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_81","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_81","text":"Mine eyes hath not witnessed many Mind Switches, but... how shall I word it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_82","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_82","text":"'Tis the first time the changes have seemed to be for the better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_83","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_83","text":"I'm just glad she remembers all of us. And she's actually become dependable for once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_84","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_84","text":"To be honest, after Lilith's death...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_85","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_85","text":"I didn't know where to turn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_86","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_86","text":"We all were affected by her passing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_87","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_87","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_88","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_88","text":"Is she still there? At that place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_89","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_89","text":"Yes. Every time I go to see her, I can't help but be surprised at how... peaceful she looks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_90","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_90","text":"As if she's sleeping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_91","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_91","text":"... Do not go there too often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_92","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_92","text":"Hehe, I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_93","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_93","text":"Anyway, if we're going to be back in the fray this evening, we probably shouldn't eat anything too heavy, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_94","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_94","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_95","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_95","text":"But is there any nourishment remaining?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_96","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_96","text":"... Not that we've found.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_97","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_97","text":"Very well. I shall lend a hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_98","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_overzone1_01_s_98","text":"2 AM.","jump":null,"exit":false,"enter":null,"bg":"EventScene_OverZone_02","bgArt":"eventscene_overzone_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_99","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_99","text":"Visual confirmation on Raptures, heading into firing range soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_spot_goddessofvictory_a","movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_100","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_01_s_100","text":"I am ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_101","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_01_s_101","text":"Same here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_102","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_01_s_102","text":"Ready when you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_103","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_103","text":"We have to protect this place at all costs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_104","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_104","text":"Humanity's future lies in our hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_105","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_105","text":"Goddess Squad, ready!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_s_106","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_s_106","text":"