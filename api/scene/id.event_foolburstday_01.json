{"id":"event_foolburstday_01","cat":"event","group":{"id":"ev130007","label":"Foolburstday"},"label":"Real Change! Mecha Shifty!","stage":null,"prev":null,"next":"event_foolburstday_02","speakers":{"mechashifty":"Mecha Shifty","shifty_r":"Shifty"},"icons":{"mechashifty":"si_c993_00_s","shifty_r":"si_c907_00_s"},"lines":[{"id":"event_foolburstday_01_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_1","text":"April Fool's Day.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_2","text":"A day which comes only once a year,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_3","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_3","text":"during which deceptive pranks become tolerated, and no one is held responsible for the damage they cause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_4","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_4","text":"For the same reason, it's also a day where you must be on high alert at all times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_5","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_5","text":"The moment you let your guard down, you'll undoubtedly be deceived by those looking to make a fool of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_6","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_6","text":"I've therefore decided that my approach for the day is to remain calm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_7","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_7","text":"No matter what tomfoolery I'm subjected to, I'll laugh it off, like water off a duck's back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_8","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_8","text":"I'll make my mind a steel trap, maintain my composure, and face any situation that arises with nothing but sheer poise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_9","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_9","text":"Hello, Inferior Human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":["mechashifty"],"affinity":null},{"id":"event_foolburstday_01_10","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_11","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_11","text":"Is this Commander {AccountData.NickName}'s room?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_12","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_13","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_13","text":"What in the hell is th—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_14","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_14","text":"No, no. I must remain calm. Perfectly calm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_15","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_15","text":"Ah, I know what's going on here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_16","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_16","text":"Someone must be inside this thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_17","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_17","text":"If I yank off that head, I'm sure I'll see who's inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_18","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_18","text":"Don't you dare touch my head, Human, or else I will open fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_19","text":"... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_20","text":"I have to admit, I'm impressed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_21","text":"I didn't think someone would put this much effort into April Fool's Day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_22","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_22","text":"Meaning unclear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_23","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_23","text":"All right, you got me. Just take off the costume, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_24","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_24","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_25","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_25","text":"Your little prank worked. Now ditch the robot getup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_26","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_26","text":"You want me to undress? The rumors are true, you really are into anyone and everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_27","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_27","text":"Root cause of issue identified. Commencing elimination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_28","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_28","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_29","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_29","text":"A laser sight zeroes in on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_30","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_30","text":"... A very sensitive part of my lower anatomy, to be specific.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_31","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_31","text":"What the...?! W-wait...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_32","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_32","text":"I will turn you into mincemeat sausage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_33","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_33","text":"Correction. Sausages are composed of mincemeat, so this statement is redundant. I will turn you into mincemeat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_34","text":"Th-this has to be a joke, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_35","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_35","text":"I will give you time to bid this organ a final farewell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_36","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_36","text":"I... It'll take more than a bullet to destroy that part of me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_37","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_37","text":"Hubris will lead to your downfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_38","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_38","text":"*Kreeeeee*!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_39","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_39","text":"Shift Stop!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty_r"],"affinity":null},{"id":"event_foolburstday_01_40","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_40","text":"Force-quit command confirmed. Stopping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_41","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_41","text":"... Whew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_42","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_42","text":"You must have gotten a little scared there, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_43","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_43","text":"More than a little! I nearly lost my family jewels!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_44","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_44","text":"I'm sorry, I should have informed you beforehand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_45","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_45","text":"This right here is an all-purpose robot developed by the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_46","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_46","text":"Allow me to introduce you to...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_47","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_47","text":"Mecha Shifty!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_48","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_48","text":"Meeecchhaaa Shifffftttyyyy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_49","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_49","text":"... Is this some kind of joke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_50","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_50","text":"You can call her Messy for short.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_51","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_51","text":"I don't think that'd be a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_52","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_52","text":"This is an autonomous robot equipped with AI. It was subjected to a battery of performance tests, and it passed them all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_53","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_53","text":"There was, however, one minor defect that was discovered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_54","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_54","text":"So they sent it to you, Commander, for help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_55","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_55","text":"You call this asking for help? More like an assassination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_56","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_56","text":"The defect in question isn't technical in nature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_57","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_57","text":"Only you can solve it, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_58","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_58","text":"What exactly is this defect?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_59","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_59","text":"I am a perfect silicon-based lifeform, and do not possess any defects whatsoever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_60","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_60","text":"Moreover, an inferior carbon-based lifeform could not possibly assist me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_61","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_01_61","text":"You should be happy with living off the metal table scraps that I toss you, Human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_62","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_62","text":"This thing has a real winning personality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_63","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_63","text":"So, can you help me, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_64","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_64","text":"No, I can't, because I have no idea what it is you want me to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_65","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_65","text":"Oh, you know, it's like in the movies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_66","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_66","text":"Where an unfeeling robot is shown what it means to be human and eventually grows a heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_67","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_01_67","text":"... With an explanation like that, this has to be part of April Fool's Day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_68","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_68","text":"Anyway, I'm leaving it in your hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_69","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_69","text":"If Mecha Shifty starts causing problems,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_70","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_70","text":"just yell out, \"Shift Stop\", and that will force it to stop whatever it's doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_01_71","type":"Speech","speaker":"shifty_r","key":"Locale_SubScenario:event_foolburstday_01_71","text":"Pretty neato command, huh? It's my name,