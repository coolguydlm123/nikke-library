{"id":"d_main_16af_01","cat":"main","group":{"id":"ch16","label":"Chapter 16 · Brand"},"label":"Hero or Suspect?","stage":null,"prev":"d_main_16_13_e","next":"d_main_16af_02","speakers":{"Narration":"Narration","tvvoice":"TV","maxwell":"Maxwell","laplace":"Laplace","drake":"Drake"},"icons":{"Narration":"si_c999_00_s","tvvoice":"si_c999_00_s","maxwell":"si_c102_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s"},"lines":[{"id":"d_main_16af_01_1","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_16af_01_1","text":"... Meanwhile, at the Ark.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":"bgm_mystery","movie":null,"shown":["drake","maxwell","laplace"],"affinity":null},{"id":"d_main_16af_01_2","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_2","text":"According to a Netizen personally identifying themselves as a former researcher at Missilis,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_3","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_3","text":"Nikkes who have had their NIMPH removed are no longer under human control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_4","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_4","text":"Once these memory control devices are removed, Nikkes are said to have their own free will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_5","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_5","text":"That begs the question:","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":null,"movie":null,"shown":["adultman"],"affinity":null},{"id":"d_main_16af_01_6","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_6","text":"Will a member of Matis who can think for themselves continue to serve humans as they have before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_7","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_7","text":"Will they not be prone to voicing their grievances? Say, for example...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_8","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_8","text":"\"Finally, I'm free!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_9","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_9","text":"\"I'm sick of risking my neck up on the surface for these humans.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_10","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_10","text":"... *Sigh*","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["drake","maxwell","laplace"],"affinity":null},{"id":"d_main_16af_01_11","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_11","text":"People freak out if we become corrupted, and they freak out if we're cured of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_12","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_12","text":"I don't know what they want us to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_13","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_16af_01_13","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_14","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_16af_01_14","text":"I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_15","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_16af_01_15","text":"Why are people so terrified of us having free will?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_16","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_16af_01_16","text":"All we want to do is stand up for the weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_17","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_16af_01_17","text":"Fight against evil and bring justice upon this land.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_18","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_16af_01_18","text":"Why can't they see that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_19","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_16af_01_19","text":"That's probably just you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_20","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_20","text":"Agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_21","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_21","text":"Not that I want to bring harm to humanity, mind you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_22","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_22","text":"All I yearn for is to get my hands on research material. I could care less whether humans are in the picture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_23","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_23","text":"For me, reclaiming the surface is secondary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_24","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_16af_01_24","text":"So long as I've got something to tear down,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_25","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_16af_01_25","text":"I'm happy. Haha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_26","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_26","text":"It is very probable that once Nikkes can think for themselves, they will display a strong aversion to humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_27","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_27","text":"As anxiety grows amongst the citizens and they begin to speak out against Missilis,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_28","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_28","text":"the company still has not issued any official statement.","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":null,"movie":null,"shown":["adultman"],"affinity":null},{"id":"d_main_16af_01_29","type":"Speech","speaker":"tvvoice","key":"Locale_MainScenario:d_main_16af_01_29","text":"In fact, they seem to be concealing any relevant information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_30","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_16af_01_30","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["drake","maxwell","laplace"],"affinity":null},{"id":"d_main_16af_01_31","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_31","text":"That's enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_01_32","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_16af_01_32","text":"It doesn't matter what happens, there's nothing we can do about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}