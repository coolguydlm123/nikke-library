,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_08_7","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_08_7","text":"I love looking up at the sky because the clouds are always different shapes every time I look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_08_8","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_08_8","text":"I already can't wait to see what clouds I find next time that I can show you.","jump":"d_counseling_sky_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_08_9","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_08_9","text":"Not necessarily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_08_10","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_08_10","text":"If you look closely, their shapes and colors are all a little different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_08_11","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_08_11","text":"Some days they look like cotton candy, and other days they look like animals.","jump":"d_counseling_sky_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_08_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_sky_08_12","text":"Sky and I talk about clouds.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":n