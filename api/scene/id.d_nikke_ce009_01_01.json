{"id":"d_nikke_ce009_01_01","cat":"bond","group":{"id":"char5179","label":"Queen (Makoto)"},"label":"Exploring a Strange New World","stage":null,"prev":null,"next":"d_nikke_ce009_01_02","speakers":{"ade":"Ade","ce009_01_f":"Queen (Makoto)","ce009_05_c":"Morgana","yulha":"Yulha","admi":"Admi","privaty":"Privaty"},"icons":{"ade":"si_c310_00_s","ce009_01_f":"si_c870_01_s","ce009_05_c":"si_c9040_00_s","yulha":"si_c171_00_s","admi":"si_c172_00_s","privaty":"si_c170_00_s"},"lines":[{"id":"d_nikke_ce009_01_01_1","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_1","text":"Miss Makoto, shouldn't you be on your way soon?","jump":null,"exit":false,"enter":null,"bg":"MaidCafe","bgArt":"maidcafe","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["ce009_01_f","ade"],"affinity":null},{"id":"d_nikke_ce009_01_01_2","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_2","text":"Oh, look at the time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_3","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_3","text":"It seems you were so busy helping out at the Maid Cafe that you lost track of time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_4","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_4","text":"You were planning to head out and have a look around the Ark today, weren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_5","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_5","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_6","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_6","text":"Makoto grabs her bag from beside the Maid Cafe's entrance and slings it over her shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_7","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_7","text":"This world seems so different from ours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_8","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_8","text":"I figured I might learn a thing or two by exploring the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_9","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_9","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_10","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_10","text":"I'd love to show you around the Ark myself, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_11","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_11","text":"I'm afraid I still have work to do here at the Maid Cafe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_12","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_12","text":"It's all right. I'm already imposing on you enough as it is. I can't ask you to go out of your way to show me around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_13","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_13","text":"Besides...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_14","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_14","text":"Makoto's shoulder bag suddenly wiggles, and out pops a cat's head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_15","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_15","text":"No way I'm letting Makoto head out alone into a world she's never seen before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce009_05_c"],"affinity":null},{"id":"d_nikke_ce009_01_01_16","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_16","text":"I'll be going with her too, so don't worry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_17","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_17","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_18","type":"Speech","speaker":"ade","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_18","text":"In that case, I hope you both have a safe journey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_19","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_19","text":"Will do!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_20","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_20","text":"Wow...","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":"bgm_story_daytoday","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_21","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_21","text":"This place amazes me every time I see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_22","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_22","text":"Whatcha lookin' at?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_23","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_23","text":"See that signboard in front of the store?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_24","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_24","text":"It's actually a hologram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_25","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_25","text":"Whoa! Even I've never seen anything like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_26","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_26","text":"Yeah, there are so many things I've never seen before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_27","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_27","text":"... So this is what the world looks like when science and technology advance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_28","type":"Speech","speaker":"ce009_01_f","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_28","text":"I'm glad I came out to explore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_29","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_29","text":"Still, let's stay on our guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_30","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_30","text":"I came along because I figured it'd be dangerous for you to come out here alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_31","type":"Speech","speaker":"ce009_05_c","key":"Locale_NikkeEpisode:d_nikke_ce009_01_01_31","text":"Since we don't know much about this place, it can't hurt to be careful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_01_32","type":"Speech","speake