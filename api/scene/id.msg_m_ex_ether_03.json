{"id":"msg_m_ex_ether_03","cat":"messenger","group":{"id":"room_ether","label":"Ether · Nikke"},"label":"3. No. 7!","stage":null,"prev":"msg_m_ex_ether_02","next":"msg_m_ex_ether_04","speakers":{"ether":"Ether"},"icons":{"ether":"si_c291_00_s"},"lines":[{"id":"m_ex_ether_03_1","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_1","text":"No. 7!","jump":null},{"id":"m_ex_ether_03_2","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_2","text":"No. 7!! No. 7, No. 7, No. 7!","jump":null},{"id":"m_ex_ether_03_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_3","text":"What is it?","jump":null},{"id":"m_ex_ether_03_4","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_4","text":"Wow, you're actually here.","jump":null},{"id":"m_ex_ether_03_5","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_5","text":"What are you doing right now?","jump":null},{"id":"m_ex_ether_03_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_6","text":"Just texting.","jump":null},{"id":"m_ex_ether_03_7","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_7","text":"Oh yeah?","jump":null},{"id":"m_ex_ether_03_8","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_8","text":"With whom?","jump":null},{"id":"m_ex_ether_03_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_9","text":"You.","jump":"m_ex_ether_03_11"},{"id":"m_ex_ether_03_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_10","text":"Just some dangerous researcher.","jump":"m_ex_ether_03_13"},{"id":"m_ex_ether_03_11","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_11","text":"I see :)","jump":null},{"id":"m_ex_ether_03_12","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_12","text":"If you're texting...","jump":"m_ex_ether_03_16"},{"id":"m_ex_ether_03_13","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_13","text":"You don't say...","jump":null},{"id":"m_ex_ether_03_14","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_14","text":"I'm not sure whom you're referring to,","jump":null},{"id":"m_ex_ether_03_15","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_15","text":"but if you're texting...","jump":null},{"id":"m_ex_ether_03_16","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_16","text":"that means you must have free time on your hands, right?","jump":null},{"id":"m_ex_ether_03_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_17","text":"Actually, not really.","jump":null},{"id":"m_ex_ether_03_18","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_18","text":"Somehow,","jump":null},{"id":"m_ex_ether_03_19","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_19","text":"I don't believe you.","jump":null},{"id":"m_ex_ether_03_20","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_20","text":"You're not becoming a shut-in by any chance, are you?","jump":null},{"id":"m_ex_ether_03_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_21","text":"A shut-in?","jump":null},{"id":"m_ex_ether_03_22","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_22","text":"Yeah, a big ol' lazybones","jump":null},{"id":"m_ex_ether_03_23","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_23","text":"who doesn't want to go out and meet people! :P","jump":null},{"id":"m_ex_ether_03_24","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_24","text":"Yes, I am","jump":"m_ex_ether_03_26"},{"id":"m_ex_ether_03_25","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_25","text":"No, I'm not","jump":"m_ex_ether_03_31"},{"id":"m_ex_ether_03_26","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_26","text":"Oh dear...","jump":null},{"id":"m_ex_ether_03_27","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_27","text":"What should I do?","jump":null},{"id":"m_ex_ether_03_28","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_28","text":"I'm rather lazy myself.","jump":null},{"id":"m_ex_ether_03_29","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_29","text":"Perhaps even more so than you.","jump":null},{"id":"m_ex_ether_03_30","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_30","text":"So let me tell you how annoying that is!","jump":"m_ex_ether_03_35"},{"id":"m_ex_ether_03_31","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_31","text":"Phew...","jump":null},{"id":"m_ex_ether_03_32","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_32","text":"That's a relief!","jump":null},{"id":"m_ex_ether_03_33","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_33","text":"I'm feeling rather lazy myself right now.","jump":null},{"id":"m_ex_ether_03_34","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_34","text":"So this works out nicely.","jump":null},{"id":"m_ex_ether_03_35","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_35","text":"Buy me some stockings.","jump":null},{"id":"m_ex_ether_03_36","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_36","text":"I have to attend a seminar with my superiors soon,","jump":null},{"id":"m_ex_ether_03_37","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_37","text":"and I ripped my stockings again.","jump":null},{"id":"m_ex_ether_03_38","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_38","text":"If I go dressed like this,","jump":null},{"id":"m_ex_ether_03_39","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_39","text":"I'll never hear the end of it.","jump":null},{"id":"m_ex_ether_03_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_40","text":"Isn't there anywhere nearby that sells stockings?","jump":null},{"id":"m_ex_ether_03_41","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_41","text":"Nope.","jump":null},{"id":"m_ex_ether_03_42","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_42","text":"Actually, there's apparently a vending machine next to the lab that sells them","jump":null},{"id":"m_ex_ether_03_43","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_43","text":"but I'm too lazy to go :)","jump":null},{"id":"m_ex_ether_03_44","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_44","text":"Can you do it for me?","jump":null},{"id":"m_ex_ether_03_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_45","text":"No","jump":null},{"id":"m_ex_ether_03_46","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_46","text":"Why nooooot?","jump":null},{"id":"m_ex_ether_03_47","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_47","text":"If you want, I'll pay you.","jump":null},{"id":"m_ex_ether_03_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_48","text":"!!","jump":null},{"id":"m_ex_ether_03_49","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_49","text":"Consider it payment for services rendered.","jump":null},{"id":"m_ex_ether_03_50","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_50","text":"Just buy them and bring them to me.","jump":null},{"id":"m_ex_ether_03_51","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_51","text":"How about it?","jump":null},{"id":"m_ex_ether_03_52","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_52","text":"You'd really rather spend money than get them yourself?","jump":null},{"id":"m_ex_ether_03_53","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_53","text":"You betcha.","jump":null},{"id":"m_ex_ether_03_54","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_54","text":"Also...","jump":null},{"id":"m_ex_ether_03_55","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_55","text":"if I have you do it,","jump":null},{"id":"m_ex_ether_03_56","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_56","text":"I'll get to see your face!","jump":null},{"id":"m_ex_ether_03_57","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_57","text":"Who knows, maybe you'll","jump":null},{"id":"m_ex_ether_03_58","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_58","text":"cozy up next to my lab table.","jump":null},{"id":"m_ex_ether_03_59","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_59","text":"I won't go.","jump":null},{"id":"m_ex_ether_03_60","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_60","text":"Aw, c'mon! Pretty please? :)","jump":null},{"id":"m_ex_ether_03_61","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_61","text":"You can earn some quick cash.","jump":null},{"id":"m_ex_ether_03_62","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ether_03_62","text":"I still won't go.","jump":null},{"id":"m_ex_ether_03_63","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_63","text":"Hmph, you're no fun today.","jump":null},{"id":"m_ex_ether_03_64","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_64","text":"Oh well :)","jump":null},{"id":"m_ex_ether_03_65","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_65","text":"I'm too lazy to spend time","jump":null},{"id":"m_ex_ether_03_66","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_66","text":"trying to convince Commander Sourpuss to get stockings.","jump":null},{"id":"m_ex_ether_03_67","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_67","text":"I'll have to convince Mana to bring them to me.","jump":null},{"id":"m_ex_ether_03_68","type":"Speech","speaker":"ether","key":"Locale_SuddenMessage:m_ex_ether_03_68","text":"Until next time.","jump":null}],"chat":true}