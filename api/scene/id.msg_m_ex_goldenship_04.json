nship_04_10","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_04_10","text":"!!","jump":null},{"id":"m_ex_goldenship_04_11","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_04_11","text":"Savings all gone?","jump":null},{"id":"m_ex_goldenship_04_12","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_04_12","text":"Ouch.","jump":null},{"id":"m_ex_goldenship_04_13","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_13","text":"I already told you before, I didn't lose everything.","jump":null},{"id":"m_ex_goldenship_04_14","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_14","text":"I've still got a little bit left.","jump":null},{"id":"m_ex_goldenship_04_15","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_15","text":"Give me a little credit, you guys.","jump":null},{"id":"m_ex_goldenship_04_16","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_04_16","text":"...","jump":null},{"id":"m_ex_goldenship_04_17","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_04_17","text":"...","jump":null},{"id":"m_ex_goldenship_04_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_18","text":"...","jump":null},{"id":"m_ex_goldenship_04_19","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_19","text":"What's gotten into everybody?","jump":null},{"id":"m_ex_goldenship_04_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_20","text":"Well, it's just that...","jump":null},{"id":"m_ex_goldenship_04_21","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_21","text":"What?!","jump":null},{"id":"m_ex_goldenship_04_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_22","text":"Have you been subsisting on leftovers from the boat parties?","jump":null},{"id":"m_ex_goldenship_04_23","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_23","text":"...","jump":null},{"id":"m_ex_goldenship_04_24","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_24","text":"It almost got to that point,","jump":null},{"id":"m_ex_goldenship_04_25","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_25","text":"but thankfully,","jump":null},{"id":"m_ex_goldenship_04_26","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_26","text":"Helm helped me out a little.","jump":null},{"id":"m_ex_goldenship_04_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_27","text":"How so?","jump":null},{"id":"m_ex_goldenship_04_28","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_28","text":"Hmm...","jump":null},{"id":"m_ex_goldenship_04_29","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_29","text":"In exchange for scrubbing the Admire every morning,","jump":null},{"id":"m_ex_goldenship_04_30","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_30","text":"I'll get a daily wage. Kinda like a part-time job.","jump":null},{"id":"m_ex_goldenship_04_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_31","text":"!!!","jump":null},{"id":"m_ex_goldenship_04_32","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_04_32","text":"How embarrassing.","jump":null},{"id":"m_ex_goldenship_04_33","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_04_33","text":"I see.","jump":null},{"id":"m_ex_goldenship_04_34","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_04_34","text":"So that's why","jump":null},{"id":"m_ex_goldenship_04_35","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_04_35","text":"you've been cleaning every morning.","jump":null},{"id":"m_ex_goldenship_04_36","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_36","text":"Yep.","jump":null},{"id":"m_ex_goldenship_04_37","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_37","text":"Helm got me out of a tough spot.","jump":null},{"id":"m_ex_goldenship_04_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_38","text":"Is Helm paying you out of her own pocket?","jump":null},{"id":"m_ex_goldenship_04_39","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_39","text":"Yeah.","jump":null},{"id":"m_ex_goldenship_04_40","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_40","text":"That's right.","jump":null},{"id":"m_ex_goldenship_04_41","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_04_41","text":"She's nice.","jump":null},{"id":"m_ex_goldenship_04_42","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_04_42","text":"Yeah,","jump":null},{"id":"m_ex_goldenship_04_43","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_04_43","text":"that's super cool of her.","jump":null},{"id":"m_ex_goldenship_04_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_44","text":"You should be nice to Helm in return.","jump":null},{"id":"m_ex_goldenship_04_45","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_45","text":"Trust me, I know.","jump":null},{"id":"m_ex_goldenship_04_46","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_46","text":"So","jump":null},{"id":"m_ex_goldenship_04_47","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_47","text":"I'm making sure the Admire is spick and span.","jump":null},{"id":"m_ex_goldenship_04_48","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_04_48","text":"Speaking of which, I've gotta go clean this baby up.","jump":null},{"id":"m_ex_goldenship_04_49","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_04_49","text":"Good luck.","jump":null},{"id":"m_ex_goldenship_04_50","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_04_50","text":"Good luck.","jump":null},{"id":"m_ex_goldenship_04_51","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_04_51","text":"What they said.","jump":null}],"chat":true}