{"id":"d_nikke_marian_queen_05","cat":"bond","group":{"id":"char5185","label":"Marian: Queen"},"label":"Happiness from Memories","stage":null,"prev":"d_nikke_marian_queen_04","next":null,"speakers":{"marian":"Marian","marian_queen":"Marian"},"icons":{"marian":"si_c013_00_s","marian_queen":"si_c019_00_s"},"lines":[{"id":"d_nikke_marian_queen_05_1","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_1","text":"Are you sure? You just want to rest your head on my lap?","jump":null,"exit":false,"enter":null,"bg":"land_n","bgArt":"land_n","image":null,"bgm":"event_bgm_lastkingdom_imwaitingcmd","movie":null,"shown":["marian"],"affinity":null},{"id":"d_nikke_marian_queen_05_2","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_2","text":"Talk about modest requests...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_3","text":"For me, it's the most extravagant thing I could ask for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_4","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_4","text":"Marian strokes the Commander's hair as he lies in her lap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_5","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_5","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_6","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_6","text":"I'm really grateful for everything you've been doing for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_7","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_7","text":"But now, I want you to be honest with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_8","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_8","text":"Why did you suddenly start doing all of these things?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_9","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_9","text":"I told you this morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_10","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_10","text":"What, that you want to make a lot of memories with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_11","text":"Yeah. This thing we're doing is really hard,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_12","text":"so I want us to make as many good memories together as we can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_13","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_13","text":"... Why the sudden push for it, though?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_14","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_14","text":"I just figure the more memories we make, the more you'll remember me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_15","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_16","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_16","text":"I see. So now I have memories that I can't ever let myself forget.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_17","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_17","text":"Does that make them heavy...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_18","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_18","text":"Yeah, they're heavy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_19","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_19","text":"So heavy that they just might crush me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_20","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_20","text":"... But before I die from that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_21","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_21","text":"I'm pretty sure I'll die of happiness first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_22","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_22","text":"The Commander smiles quietly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_23","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_23","text":"What about you, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_24","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_24","text":"Huh? Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_25","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_25","text":"You have to remember me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_26","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_26","text":"And that means you have to make a lot of good memories for yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_27","text":"I already have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_28","text":"Every time you've ever smiled is a good memory for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_29","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_29","text":"Agh, there you go again, saying nice things to talk your way out of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_30","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_30","text":"It's not fair...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_31","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_31","text":"Do you hate me now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_32","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_32","text":"No...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_33","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_33","text":"It's just, after all you've done for me, what if I'm the only one who remembers this later...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_34","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_34","text":"That's what I'm starting to worry about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_35","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_35","text":"But there's no way I'd forget you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_36","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_37","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_37","text":"Y-yeah... of course not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_38","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_38","text":"And there's no way I'd ever forget you, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_queen_05_39","type":"Speech","speaker":"marian","key":"Locale_NikkeEpisode:d_nikke_marian_queen_05_39","text":"You're the one who showed me hope,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie"