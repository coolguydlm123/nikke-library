{"id":"d_main_47_06","cat":"main","group":{"id":"ch47","label":"Chapter 47 · Outbreak"},"label":"Crossing the Line Once More: A","stage":"47-36 BOSS · Start","prev":"d_main_47_05","next":"d_main_47_07","speakers":{"ingrid_op":"Ingrid","sora":"Sora","cielo":"Cielo","sky":"Sky","dorothy":"Dorothy","andersen":"Andersen"},"icons":{"ingrid_op":"si_c900_00_s","sora":"si_c532_00_s","cielo":"si_c531_00_s","sky":"si_c530_00_s","dorothy":"si_c233_00_s","andersen":"si_c903_00_s"},"lines":[{"id":"d_main_47_06_1","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_1","text":"A high-energy entity has been detected descending vertically toward the Ark.","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":"bgm_story_skiespaintedwithblasts","movie":null,"shown":["dorothy","sky","cielo","sora","ingrid_op"],"affinity":null},{"id":"d_main_47_06_2","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_2","text":"Energy signature confirmed. It's Annihilio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_3","type":"Speech","speaker":"sora","key":"Locale_MainScenario:d_main_47_06_3","text":"Oh dear, again? That was fast. ★","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_4","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_4","text":"Are we going to intercept it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_5","type":"Speech","speaker":"sky","key":"Locale_MainScenario:d_main_47_06_5","text":"Of course we will! That's why we have Zoomie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_6","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_6","text":"That's true, but we don't have the Counters with us right now, so I'm a bit worried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_7","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_7","text":"Don't worry. Matis and the Ark Rangers are below us, standing by.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_8","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_8","text":"As long as they don't let it get past them, interception should be no issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_9","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_9","text":"Also...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_10","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_10","text":"With the guest currently aboard the Wings of Victory, Elysion Edition, there's nothing to worry about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_11","type":"Speech","speaker":"sky","key":"Locale_MainScenario:d_main_47_06_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_12","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_13","type":"Speech","speaker":"sora","key":"Locale_MainScenario:d_main_47_06_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_14","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_14","text":"Once again, thank you for your cooperation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_15","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_15","text":"Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_16","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_17","text":"I haven't actually agreed to cooperate with the Ark yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_18","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_18","text":"Didn't the Comman... I mean, Deputy Chief Andersen, inform you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_19","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_19","text":"Yes, of course he did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_20","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_47_06_20","text":"He said you might resist at first, but you'd come around eventually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_22","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_22","text":"You want to start the Third Surface Reclamation War?","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":"bgm_story_3rdplan","movie":null,"shown":["andersen"],"affinity":null},{"id":"d_main_47_06_23","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_23","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_24","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_24","text":"To be precise, we have no other option.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_25","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_25","text":"The Ark is in shambles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_26","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_26","text":"Like it or not, we have to go up to the surface and make a stand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_27","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_28","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_28","text":"Lead the charge, Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_29","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_29","text":"As a member of the Goddess Squad, you will announce the beginning of the Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_30","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_30","text":"Lead the charge? Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_31","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_31","text":"Didn't you want to be the one in charge? Isn't that why you made that broadcast?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_32","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_32","text":"That wasn't my intention!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_33","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_33","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_35","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_35","text":"I'm going to make all those things you said on air a reality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_36","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_36","text":"We'll blame the Queen for everything that has happened to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_37","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_37","text":"We'll declare an all-out war against the Queen and bring the Ark to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_38","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_38","text":"Stand at the forefront of it all, Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_39","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_40","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_40","text":"You're in a very favorable position to be used as a symbol right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_41","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_41","text":"Frankly, the stage is already set for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_42","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_42","text":"Just step forward, proclaim that you'll be the vanguard, and everyone will eat it up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_43","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_43","text":"All you have to do is giggle and bask in the attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_44","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_44","text":"I do not giggle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_45","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_46","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_46","text":"While you were sitting in a cell, staring blankly at the walls, the Ark was attacked again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_47","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_47","text":"Those Rapture scum even deployed chemical weapons in an attempt to kill us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_48","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_48","text":"They have no intention of showing us mercy anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_49","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_49","text":"We can't afford to stay on the defensive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_50","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_50","text":"By all accounts, this will be our final battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_51","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_51","text":"Either we die, or they do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_52","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_52","text":"I... see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_53","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_53","text":"This is our last chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_54","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_54","text":"If we don't take it, there won't be another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_55","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_55","text":"So, what will you do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_56","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_56","text":"Give me some time to think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_57","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_57","text":"Fine. Take your time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_58","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_58","text":"I've prepared a nice and cushy place for you to do your thinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_59","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_59","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_60","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_60","text":"I'm saying you should go get some fresh air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_61","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_47_06_61","text":"The wind might be a bit strong, though.","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":"none","movie":null,"shown":["dorothy","sky","cielo","sora"],"affinity":null},{"id":"d_main_47_06_62","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_62","text":"H