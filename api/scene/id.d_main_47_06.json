,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_83","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_83","text":"It is an honor to be aboard this legendary aircraft,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_84","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_84","text":"accompanying the one who helped create that very legend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_85","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_85","text":"It's as if the legend from that era has been revived. It's got my heart racing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_86","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_86","text":"If there is anything you'd like, please don't hesitate to let us know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_87","type":"Speech","speaker":"cielo","key":"Locale_MainScenario:d_main_47_06_87","text":"Ah, I heard you enjoy tea. Would you like me to brew some for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_88","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_06_89","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_47_06_89","text":"Do you have plum blossom tea?