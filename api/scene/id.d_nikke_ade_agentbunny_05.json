ke_ade_agentbunny_05_31","text":"Somehow, it feels like a sweet dream.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_05_32","type":"Speech","speaker":"maleguest","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_05_32","text":"Hey, try the food, too. It's really good!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_05_33","type":"Speech","speaker":"femaleguest","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_05_33","text":"This is amazing! It tastes perfect!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_05_34","type":"Speech","speaker":"regularguest_02","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_05_34","text":"Hehe, the others are finally starting to notice Ade's charm, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["regularguest_02"],"affinity":null},{"id":"d_nikke_ade_agentbunny_05_35","type":"Speech","speaker":"regularguest_02","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_05_35","text":"Ade wasn't bad before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_05_36","type":"Speech","speaker":"regularguest_02","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_05_36","text":"but this is definitely Ade at her best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_05_37","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_05_37","text":"... Great work, Ade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null