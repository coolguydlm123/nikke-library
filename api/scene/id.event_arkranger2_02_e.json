{"id":"event_arkranger2_02_e","cat":"event","group":{"id":"ev40113","label":"ARK RANGER · Part 2"},"label":"A Familiar Scent: B","stage":null,"prev":"event_arkranger2_02_s","next":"event_arkranger2_03_s","speakers":{"ingrid_op":"Ingrid","rapi_red":"Rapi","anis_i_w":"Anis","neon_v_w":"Neon"},"icons":{"ingrid_op":"si_c900_00_s","rapi_red":"si_c016_00_s","anis_i_w":"si_c017_00_s","neon_v_w":"si_c018_00_s"},"lines":[{"id":"event_arkranger2_02_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_1","text":"Following the battle with Sixo, Enikk has been dedicating all available resources to repairing the damaged Ark.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":"bgm_hopeless","movie":null,"shown":["enikk"],"affinity":null},{"id":"event_arkranger2_02_e_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_2","text":"Her attention has largely been directed to maximizing efficiency due to the dramatically reduced energy output from the Ark's power source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_3","text":"As a result, surface surveillance has been relatively neglected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_4","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_4","text":"Enikk detects the anomaly immediately after the explosion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_5","text":"The object fell from a high altitude, detonating upon impact and generating a shockwave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_6","text":"Enikk initiates regional scans after detecting the shockwave, then deploys a large number of drones to investigate the disturbance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_7","text":"The explosion occurred approximately eight kilometers from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_8","text":"The drones Enikk sent quickly arrive at the location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_9","text":"However, the footage they transmit reveals nothing of particular note.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_10","text":"There are no anomalies other than a shallow, newly formed crater.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_11","text":"Just as Enikk is about to log it as the result of a misfired missile from a Tyrant-class Rapture,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_12","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_12","text":"she receives a transmission from the Counters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_13","text":"Chemical weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_14","text":"Upon hearing the term, Enikk immediately withdraws all resources allocated to repairing the Ark and begins calculating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_15","text":"All relevant variables are factored into the analysis: wind direction, velocity, the concentration and mass of the chemical agent... all of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_16","text":"She concludes that trace amounts could potentially enter the Ark through a surface elevator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_17","text":"Enikk immediately seals off the elevator and the entire area within a two-kilometer radius.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_18","text":"She uses concrete walls extending to the Ark's ceiling to create an airtight seal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_19","text":"She also establishes a monitoring system to observe all activity within the sealed area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_20","text":"As a precaution, she deploys the Blaze Out Squad to the area's outer perimeter. Then she watches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_21","text":"Twenty minutes later, the 2,048 humans and 138 Nikkes who were sealed inside lose their lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_22","text":"The humans die after coughing up blood, whereas the Nikkes die with no outward symptoms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_23","text":"Enikk utilizes all available means to investigate the affected area.","jump":null,"exit":false,"enter":null,"bg":"EventScene_arkranger_05","bgArt":"eventscene_arkranger_05","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_24","text":"She identifies the composition of the chemical agent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_25","text":"The substance reacts with humans' blood, causing it to boil, and with Nikkes' cores, causing them to shut down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_26","text":"It cannot be detected through conventional visual means.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_27","text":"Its only distinguishing trait is a unique scent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_28","text":"After cordoning off an additional two-kilometer area centered around the site,","jump":null,"exit":false,"enter":null,"bg":"Ark_02","bgArt":"ark_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_29","text":"Enikk sends in the Blaze Out Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_30","text":"They are tasked with sterilizing the biohazardous zone using ultrahigh-temperature flames,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_31","text":"in accordance with their duty as part of the Ark Biological Hazard Control Center. Then, four hours after the Blaze Out Squad is deployed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_32","text":"the region is erased from the Ark's map data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_33","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_33","text":"... That's everything that's happened so far.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":"bgm_chapter41_field_otherworld","movie":null,"shown":["ingrid_op","rapi_red","anis_i_w","neon_v_w"],"affinity":null},{"id":"event_arkranger2_02_e_34","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_34","text":"I see... Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_35","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_35","text":"I rechecked the locations of the craters after hearing your report.","jump":null,"exit":false,"enter":null,"bg":"EventScene_arkranger_04","bgArt":"eventscene_arkranger_04","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_36","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_36","text":"There have been a total of five impact points so far,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_37","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_37","text":"and I've confirmed they are getting closer to the Ark with each strike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_38","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_38","text":"The enemy's margin of error is clearly shrinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_39","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_39","text":"The next one will likely be directly targeted at the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_40","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_40","text":"... And as things stand, the Ark has no way to stop it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_41","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_41","text":"Enikk is working with Missilis to develop a neutralizing agent, but the enemy's not going to wait for us to finish before attacking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_42","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_e_42","text":"Is interception an option?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_43","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_43","text":"... At the moment, it wouldn't be easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_44","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_02_e_44","text":"What about that thing I used before, that giant particle gun thingamajig?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_45","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_45","text":"The Ark's power output is too low right now. We can't use it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_46","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:event_arkranger2_02_e_46","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_47","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_47","text":"The missile's going to be descending from an extremely high altitude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_48","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_48","text":"Given that the Ark has no way to secure air superiority, intercepting it would prove to be tricky.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":null,"movie":null,"shown":["rapi_red","anis_i_w","neon_v_w"],"affinity":null},{"id":"event_arkranger2_02_e_49","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_e_49","text":"I can go up with Seven Dwarves Zero and try to shoot it down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"event_arkranger2_02_e_50","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_50","text":"Don't be ridiculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_51","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_e_51","text":"Sorry, I wasn't being serious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_52","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_52","text":"As I was saying, intercepting it may be tricky, but not impossible with Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_53","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_53","text":"Deploying the Admire is also a possibility, albeit not an efficient one. Still, we're not without options.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_54","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_54","text":"I've got something else in mind, as well. I'd like you all to head to the surface and...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_55","text":"*Rumble, rumble*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_56","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_56","text":"The ground suddenly begins to tremble.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_57","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_02_e_57","text":"Master! Raptures!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_58","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_58","text":"What is that...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_59","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_59","text":"I look in the direction Neon is pointing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_60","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_60","text":"Swarms of Raptures are moving forward, kicking up clouds of dust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_61","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_e_61","text":"They're heading for the Ark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_62","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_62","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_63","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_e_63","text":"Instructor! The enemy must've locked onto the Ark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_64","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_e_64","text":"They'll be launching the next missile any minute!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_65","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_65","text":"Argh...! Are they trying to use Raptures to stop us from intercepting it?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_66","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_66","text":"I'm deploying forces from the Ark! Rendezvous with them as soon as possible!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_67","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_e_67","text":"Roger that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_68","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_68","text":"If something like that detonates above the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_e_69","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:event_arkranger2_02_e_69","text":"the entire Ark is done for!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}