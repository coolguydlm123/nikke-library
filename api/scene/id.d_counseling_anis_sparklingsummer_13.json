ll,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_6","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_6","text":"You scared the bejesus out of me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_7","type":"Self","speaker":"Self","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_7","text":"Well, you gave me quite the fright as well when you grabbed me and threw yourself in my arms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_8","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_8","text":"I only did that because you frightened me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_9","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_10","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_10","text":"Let's just take a breather and relax until I calm down.","jump":"d_counseling_anis_sprklingsummer_13_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_11","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_11","text":"It's late at night, and you're alone in the Commander's Room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_12","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_12","text":"Suddenly, there's a knock on the door. On the other side, a voice claims to have found a note, and they walk in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_13","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_13","text":"In comes a figure who raises their hand and slowly moves towards you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_14","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_14","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_15","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_15","text":"Commander, are you all right? I haven't even gotten to the scary part yet, but you look as white as a sheet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_16","type":"Self","speaker":"Self","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_16","text":"I think I've experienced this story in my dreams.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_17","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_17","text":"Whoa, no kidding! You think it's some kind of premonition, maybe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_18","type":"Speech","speaker":"anis_s","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_18","text":"Anyway, you're more easily scared than I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_sprklingsummer_13_19","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_anis_sprklingsummer_13_19","text":"Anis continues to regale me with bone-chilling stories.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}