{"id":"msg_m_ex_eh_01","cat":"messenger","group":{"id":"room_eh","label":"E.H. · Nikke"},"label":"1. {AccountData.NickName}","stage":null,"prev":null,"next":"msg_m_ex_eh_02","speakers":{"eh_n":"E.H."},"icons":{"eh_n":"si_c113_00_s"},"lines":[{"id":"m_ex_eh_01_01","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_01","text":"{AccountData.NickName}","jump":null},{"id":"m_ex_eh_01_02","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_02","text":"Is this coming through?","jump":null},{"id":"m_ex_eh_01_03","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_03","text":"Yeah.","jump":null},{"id":"m_ex_eh_01_04","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_04","text":"Messaging you like this","jump":null},{"id":"m_ex_eh_01_05","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_05","text":"feels a little awkward.","jump":null},{"id":"m_ex_eh_01_06","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_06","text":"You'll get used to it haha","jump":null},{"id":"m_ex_eh_01_07","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_07","text":"I'll \"get used to it,\" huh?","jump":null},{"id":"m_ex_eh_01_08","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_08","text":"Get used to it...","jump":null},{"id":"m_ex_eh_01_09","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_09","text":"Am I even allowed to get used to normal life?","jump":null},{"id":"m_ex_eh_01_10","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_10","text":"I robbed other people of the normal lives they dreamed of...","jump":null},{"id":"m_ex_eh_01_11","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_11","text":"Me. I'm the one to blame.","jump":null},{"id":"m_ex_eh_01_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_12","text":"That's all the more reason for you to understand.","jump":null},{"id":"m_ex_eh_01_13","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_13","text":"Understand what?","jump":null},{"id":"m_ex_eh_01_14","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_14","text":"What normal life is like?","jump":null},{"id":"m_ex_eh_01_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_15","text":"Yeah.","jump":null},{"id":"m_ex_eh_01_16","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_16","text":"But I don't deserve that.","jump":null},{"id":"m_ex_eh_01_17","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_17","text":"Heck, I don't even deserve your words of comfort.","jump":null},{"id":"m_ex_eh_01_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_18","text":"Well, if you experience for yourself how precious normal life is,","jump":null},{"id":"m_ex_eh_01_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_19","text":"maybe you won't do the same thing again.","jump":null},{"id":"m_ex_eh_01_20","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_20","text":"Hmm. Maybe you're right.","jump":null},{"id":"m_ex_eh_01_21","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_21","text":"I don't want to be the cause of such a tragedy again.","jump":null},{"id":"m_ex_eh_01_22","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_22","text":"Sorry, you shouldn't have to say all of this stuff to me.","jump":null},{"id":"m_ex_eh_01_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_23","text":"At times like this, it's better to say \"thank you\" than \"sorry.\"","jump":null},{"id":"m_ex_eh_01_24","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_24","text":"You're right.","jump":null},{"id":"m_ex_eh_01_25","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_25","text":"Thank you.","jump":null},{"id":"m_ex_eh_01_26","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_26","text":"I get the feeling that if I have you by my side,","jump":null},{"id":"m_ex_eh_01_27","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_27","text":"I won't do any more things I'll regret.","jump":null},{"id":"m_ex_eh_01_28","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_28","text":"Do you mind if I message you every once in a while?","jump":null},{"id":"m_ex_eh_01_29","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_29","text":"Not that I think I'll have anything important to talk about...","jump":null},{"id":"m_ex_eh_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_30","text":"You don't need to have anything important to talk about. Just reach out.","jump":null},{"id":"m_ex_eh_01_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_eh_01_31","text":"That's what normal life is.","jump":null},{"id":"m_ex_eh_01_32","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_32","text":"Sorry for all the bother...","jump":null},{"id":"m_ex_eh_01_33","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_33","text":"Wait","jump":null},{"id":"m_ex_eh_01_34","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_34","text":"You said I should say thank you instead.","jump":null},{"id":"m_ex_eh_01_35","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_35","text":"Thanks for listening.","jump":null},{"id":"m_ex_eh_01_36","type":"Speech","speaker":"eh_n","key":"Locale_SuddenMessage:m_ex_eh_01_36","text":"I'll message you again later.","jump":null}],"chat":true}