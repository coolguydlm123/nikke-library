{"id":"d_main_24af_04","cat":"main","group":{"id":"ch24","label":"Chapter 24 · Banishment"},"label":"Long-Awaited Command","stage":null,"prev":"d_main_24af_03","next":"d_main_24af_05","speakers":{"andersen":"Andersen"},"icons":{"andersen":"si_c903_00_s"},"lines":[{"id":"d_main_24af_04_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_1","text":"The hallway in front of the Deputy Chief's Office.","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_2","text":"*Knock knock*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_4","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_4","text":"*Knock knock*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_5","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_5","text":"Can I come in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_6","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_6","text":"Mmm, come in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_7","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_24_After2_01","bgArt":"eventscene_chap_24_after2_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_8","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_8","text":"Hey there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_9","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_9","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_10","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_10","text":"I knew you'd be caught off guard, but you're more shocked than I thought you'd be. It's almost reassuring, in a way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_11","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_11","text":"Feel free to take a seat. Or if you'd rather stand there stupefied, be my guest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_12","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_12","text":"I sit down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_13","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_13","text":"You'll have to excuse the current state I'm in. I'm undergoing treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_14","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_15","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_15","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_16","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_16","text":"You're probably wondering what all these are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_17","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_17","text":"They're life-support devices.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_18","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_18","text":"Without them, I wouldn't last 30 minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_19","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_19","text":"For a while, I was fine being disconnected for nearly 2 hours at a time, but it's gone a bit downhill since the blood transfusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_21","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_21","text":"Don't feel too sorry for me. This was the best option available at the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_22","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_22","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_23","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_23","text":"These devices are powered by the Ark's internal power grid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_24","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_24","text":"Due to recent happenings, the resulting temporary power outage caused my life support to shut down for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_25","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_25","text":"The timing couldn't have been worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_26","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_26","text":"As you can see, I made it through, but I now have to undergo emergency treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_27","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_27","text":"I apologize that I couldn't be of more help at the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_28","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_28","text":"It's okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_29","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_29","text":"It's a long story as to how I ended up like this. In time, I'll tell you all about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_30","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_30","text":"Back to the issue at hand. You've performed admirably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_31","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_31","text":"Unfortunately, sacrifices had to be made, but at least we've managed to hold on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_32","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_32","text":"Well done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_33","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_34","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_34","text":"Now, to the most pressing matter at hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_35","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_35","text":"I want you to reclaim the surface, for good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_36","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_37","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_37","text":"Even a small plot of land will suffice, so long as you're able to reclaim it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_38","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_38","text":"We have the means to accomplish this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_39","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_39","text":"You've been to Eden, so I don't think I need to provide a lengthy explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_40","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_40","text":"So long as we have the Optical Camouflage provided by the Pilgrims, we have the means to reclaim the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_41","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_41","text":"Is now the right time to be using that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_42","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_42","text":"Now is precisely the right time.","jump":null,"exit":false,"enter":null,"bg":"DestroyedStreet","bgArt":"destroyedstreet","image":null,"bgm":null,"movie":null,"shown":["indivilia","nihilister_a","talkative"],"affinity":null},{"id":"d_main_24af_04_43","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_43","text":"We've managed to hold off both the Raptures and the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_44","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_44","text":"This is a landmark victory for the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_45","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_45","text":"The public is coming back around regarding their stance on Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_46","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_46","text":"However.","jump":null,"exit":false,"enter":null,"bg":"BurningCity","bgArt":"burningcity","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_47","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_47","text":"The Ark also suffered many losses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_48","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_48","text":"Resources, manpower, and other accumulated assets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_49","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_49","text":"For now, we are turning a blind eye to the fallout because we're drunk on our victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_50","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_50","text":"However, these setbacks will come back to haunt us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_51","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_51","text":"When that happens, the situation will become uncontrollable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_52","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_52","text":"This success actually poses a problem. The people will wonder why we didn't go and strike out when we had our chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_53","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_53","text":"The people will question our motives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_54","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_54","text":"It's been over a century since humanity was trapped underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_55","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_55","text":"For most of that time, we didn't have a clear idea of the situation up on the surface, but now it has become quite clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_56","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_56","text":"Everyone will start asking why we're not venturing out when it is clearly doable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_57","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_57","text":"There are even rumblings of this nature within the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_58","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_58","text":"They think that we can do it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_59","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_59","text":"They do.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_24_After2_01","bgArt":"eventscene_chap_24_after2_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_60","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_60","text":"But as you well know, we have no chance of emerging victorious. Not now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_61","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_61","text":"Despite this, everyone is talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_62","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_62","text":"Once hope starts bubbling to the surface, there's no stopping it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_63","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_63","text":"That's why I want you to reclaim a part of the surface. Just a part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_64","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_64","text":"When the time comes, it will serve as a deterrent to our opponents","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_65","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_65","text":"and also become a seed that will produce new hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_66","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_66","text":"But I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_67","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_67","text":"I'm not asking you to do it right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_68","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_68","text":"I know you still have to go find Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_69","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_69","text":"Take your time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_70","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_70","text":"... I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_71","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_71","text":"But this is all rather sudden. I'm not entirely sure how to proceed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_72","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_72","text":"First, determine a target location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_73","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_73","text":"The further away from the Ark, the better. Somewhere with a self-sustaining environment would be ideal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_74","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_24af_04_74","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_75","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_75","text":"Sorry to drop this all in your lap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_76","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_76","text":"Now, if you don't mind, I have a meeting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_04_77","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_24af_04_77","text":"Actually, I just have to focus on my treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}