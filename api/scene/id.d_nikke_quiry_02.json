ry_02_97","type":"Speech","speaker":"quiry","key":"Locale_NikkeEpisode:d_nikke_quiry_02_97","text":"I'll try and get my bearings ASAP so I can help out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quiry_02_98","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:d_nikke_quiry_02_98","text":"I appreciate that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quiry_02_99","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_quiry_02_99","text":"The Commander is a real stand-up guy. You'll have a great time with him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quiry_02_100","type":"Speech","speaker":"quiry","key":"Locale_NikkeEpisode:d_nikke_quiry_02_100","text":"I'm sure I will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quiry_02_101","type":"Speech","speaker":"quiry","key":"Locale_NikkeEpisode:d_nikke_quiry_02_101","text":"A new life in a new place... this is all so exciting!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quiry_02_102","type":"Speech","speaker":"quiry","key":"Locale_NikkeEpisode:d_nikke_quiry_02_102","text":"I'm sure it'll have its challenges,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quiry_02_103","type":"Speech","speaker":"quiry","key":"Locale_NikkeEpisode:d_nikke_quiry_02_103","text":"but I know that I can depend on you for just about anything, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null