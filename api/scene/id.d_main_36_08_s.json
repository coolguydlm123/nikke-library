{"id":"d_main_36_08_s","cat":"main","group":{"id":"ch36","label":"Chapter 36 · Betrayal"},"label":"Inspection Unit: A","stage":"36-34 STAGE · Start","prev":"d_main_36_07_e","next":"d_main_36_08_e","speakers":{"anis":"Anis","neon":"Neon","eyeri":"Eyeri","avistar":"Avistar"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","eyeri":"si_c440_00_s","avistar":"si_c441_00_s"},"lines":[{"id":"d_main_36_08_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_36_08_s_1","text":"Outpost. Command Center. Commander's Room.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":["anis","neon"],"affinity":null},{"id":"d_main_36_08_s_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_2","text":"Phew... I'm pooped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_3","text":"What are you so tired for? You didn't even do anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_4","text":"What do you mean? Do you realize how much I've been walking around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_5","text":"If that's true, how come you're in Master's room, making yourself at home?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_6","text":"The facilities here are better than in the dorm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_7","text":"The Commander isn't here anyway, so who cares if I'm here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_8","text":"And this bed is out of this world. It's as soft as a cloud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_36_08_s_9","text":"*Plop*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_10","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_10","text":"If Master were here, he would freak out at seeing you climb into bed without showering first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_11","text":"It's fiiiine. This way, I'm infusing the bed with the fragrance of a beautiful girl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_13","text":"Mmm, it smells like the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_14","text":"Stop being such a creepo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_15","text":"I-I'm saying that it smells bad!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_16","text":"Nice try. Your face gives it all away. You're loving it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_17","text":"Wh-wha what nonsense!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_18","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_18","text":"I'm sorry, but could you keep it down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["eyeri"],"affinity":null},{"id":"d_main_36_08_s_19","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_19","text":"You're making it difficult for me to concentrate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_empathize","movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_21","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_22","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_22","text":"Much better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_23","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_23","text":"I think we can stop gathering data, Eyeri.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["avistar"],"affinity":null},{"id":"d_main_36_08_s_24","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_24","text":"Mmm, I was planning on calling it, anyway. There's nothing to find.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_25","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_25","text":"Yeah, I don't think any further investigation will turn up anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_26","text":"Thieves!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_27","text":"If you want to take out a thief, nothing beats firepower!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_28","text":"Good, then fire away!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_29","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_29","text":"You got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_30","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_30","text":"Excuse me, I just asked if you could keep it dow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_31","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_31","text":"... Why are you pointing that gun at me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_32","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_32","text":"From what I caught earlier, I believe they've mistaken us for burglars of some kind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_33","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_33","text":"What? Come now, in what world would a bespectacled beauty like me be a thief?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_34","text":"Who are you two? What you are doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_35","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_35","text":"I'm Eyeri, from the Overseer Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_36","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_36","text":"And I'm Avistar, from the same squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_37","text":"Overseer? What's an inspection unit doing here? The Commander hasn't stolen anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_38","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_38","text":"That's right! Master is the most upstanding person you'll ever meet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_39","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_39","text":"We aren't here to conduct an inspection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_40","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_40","text":"Our boss told us to lend you two a hand, so here we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_41","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_41","text":"While we were waiting, we decided to leaf through some of the Commander's documents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_42","text":"Your boss?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_43","text":"Hold up, are you the two \"capable Nikkes\" President Ingrid mentioned?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_44","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_44","text":"She called us capable?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_45","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_45","text":"Hehe... Er, I mean, yes, that's us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_46","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_46","text":"We've been sent to assist you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_47","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_47","text":"I'm looking forward to working with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_48","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_48","text":"As am I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_49","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_49","text":"Uh... yeah, same here. But you never explained why you were rummaging through Master's things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_50","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_50","text":"We're an inspection unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_51","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_51","text":"Yeah, we're an inspection unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_52","text":"... How many times are you going to keep saying that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_53","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_53","text":"As an inspection unit, our duty is to ensure that there has been no misappropriation of funds or personnel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_54","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_54","text":"The Counters is currently one of the most influential squads in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_55","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_55","text":"It would be reasonable to expect that some questionable transactions would be taking place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_56","text":"... She's nothing if not candid. Or, in other words, she's rude as hell!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_57","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_57","text":"My apologies. Force of habit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_58","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_58","text":"At any rate, we didn't turn up anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_59","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_59","text":"Indeed. Everything seems to be above board.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_60","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_60","text":"If we had found anything disreputable, we would have immediately withdrawn our support, but it appears we have no reason to do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_61","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_61","text":"Also, we have this for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_36_08_s_62","text":"Avistar hands Anis a USB stick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_63","text":"What's this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_64","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_64","text":"Some of the merchants you're doing business with have been steadily inflating their prices over a long period of time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_65","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_65","text":"Initially, we suspected some illicit inside trading between you and them was taking place, but there doesn't appear to be any evidence of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_66","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_66","text":"What? So are you saying...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_67","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_67","text":"Yes. You've overpaid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_68","text":"Are you kidding me?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_69","type":"Speech","speaker":"avistar","key":"Locale_MainScenario:d_main_36_08_s_69","text":"It happens to every group once they're in the limelight. Simply threaten that you'll stop dealing with them, and the prices should revert back to normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_70","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_70","text":"Oh... well, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_71","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_71","text":"You're really good at this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_72","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_72","text":"Thank you... er, I mean... like Ingrid said, we're capable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_73","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_73","text":"Now then, we've been told you two are in a bit of a pickle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_74","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_74","text":"You want to contact some specific members of an entertainment agency, but don't know how to go about it. Is that correct?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_75","text":"Well... Yeah, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_76","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_76","text":"Give me their name and contact information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_77","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_77","text":"Give me a little time, and I'll find a way for you to get inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_78","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_78","text":"How are you gonna do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_79","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_79","text":"I told you, we're an inspection unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_80","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_80","text":"How many times are you going to repeat that same thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_81","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_81","text":"Also, call me biased, but I feel the entertainment industry is a veritable breeding ground for corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_82","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_82","text":"Well, aren't you oh-so-impressive...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_83","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_83","text":"We won't have to do much digging before we unearth all sorts of dirt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_84","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_84","text":"We'll then be able to use that as a pretext to gain entry to the agency and conduct an investigation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_85","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_85","text":"When we do that, you two can come along as our assistants, and meet up with the people you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_86","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_86","text":"Nice!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_87","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_87","text":"Now then, let's get started.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_88","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_88","text":"Pfooo...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_89","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_36_08_s_89","text":"... Are you okay? Why are you breathing all weird?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_90","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_90","text":"Because this is my favorite part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_91","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_91","text":"The thrill of uncovering someone's dirty secrets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_92","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_36_08_s_92","text":"That's why I'll never quit this job!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_36_08_s_93","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_36_08_s_93","text":"... I'm happy for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}