ario:event_ce003_1_05_s_6","text":"Yes, we should start before it gets too late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_7","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_7","text":"Everyone, please wash your hands and gather in the kitchen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_8","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_8","text":"We're going to be making curry rice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_9","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_9","text":"We'll quickly go over the recipe, and then break off into pairs to give it a spin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_10","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_10","text":"Once we've made our curry, we can serve it to the members of the Counters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_11","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_11","text":"To thank them for cleaning the kitchen while we were out shopping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_12","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_05_s_12","text":"I'm sorry for leaving the kitchen such a mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_13","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_05_s_13","text":"Thank you everyone. I'll repay you with some delicious cooking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_14","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_14","text":"All right then, as for who will pair up with who...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_15","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_ce003_1_05_s_15","text":"I already know who I want to partner up with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_16","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_ce003_1_05_s_16","text":"Pink goes with pink. Everybody knows that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_17","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_17","text":"All right, Coco and Ram will be a pair, and then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_18","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_18","text":"Let's just have everyone pair up with whoever their shopping partner was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_19","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_05_s_19","text":"Looks like you and I are going to be a team, Soda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_20","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_05_s_20","text":"All right! I'll try not to drag you down too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_21","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_05_s_21","text":"I guess I'm with you, Ade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_22","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_22","text":"That's right. I'll guide you through the basics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_23","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_23","text":"Now that we've partnered up, let me go over the recipe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_24","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_24","text":"The main advantage of curry is that it's highly customizable, and you can add all manner of different ingredients to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_25","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_05_s_25","text":"Ade proceeds to give a brief rundown of how to make curry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_26","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_05_s_26","text":"Seems simple enough! I think I can do this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_27","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_27","text":"Looks like everyone is ready to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_28","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_05_s_28","text":"Let's start cooking!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_29","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_05_s_29","text":"My curiosity gets the better of me, and I head into the kitchen to see how everyone is doing with their curry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_ce003_minimain","movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_05_s_30","text":"What kind of curry are you two making?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_31","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_05_s_31","text":"Watch out, Master, it's dangero...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soda"],"affinity":null},{"id":"event_ce003_1_05_s_32","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_05_s_32","text":"Eeeeeeep!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_33","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_05_s_33","text":"Soda, who is carrying a plate full of prepared ingredients, trips and loses her balance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_34","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_05_s_34","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce_003_01"],"affinity":null},{"id":"event_ce003_1_05_s_35","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce003_1_05_s_35","text":"*Swoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_36","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_05_s_36","text":"Using a frying pan, Rem catches all of the falling ingredients in mid-air,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_37","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_05_s_37","text":"and even grasps Soda's hand so that she doesn't fall down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_38","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_05_s_38","text":"You did a good job preparing the ingredients. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_05_s_39","type":"Speech","speaker":"soda","k