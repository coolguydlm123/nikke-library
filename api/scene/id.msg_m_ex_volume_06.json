{"id":"msg_m_ex_volume_06","cat":"messenger","group":{"id":"room_volume","label":"Volume · Nikke"},"label":"6. Hi, Honey.","stage":null,"prev":"msg_m_ex_volume_05","next":null,"speakers":{"volume":"Volume"},"icons":{"volume":"si_c431_00_s"},"lines":[{"id":"m_ex_volume_06_1","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_1","text":"Hi, Honey.","jump":null},{"id":"m_ex_volume_06_2","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_2","text":"Hello, Volume.","jump":"m_ex_volume_06_4"},{"id":"m_ex_volume_06_3","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_3","text":"Hi babe.","jump":"m_ex_volume_06_11"},{"id":"m_ex_volume_06_4","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_4","text":"??","jump":null},{"id":"m_ex_volume_06_5","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_5","text":"Manager.","jump":null},{"id":"m_ex_volume_06_6","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_6","text":"What's going on here?","jump":null},{"id":"m_ex_volume_06_7","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_7","text":"Do you want to get yourself fired?","jump":null},{"id":"m_ex_volume_06_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_8","text":"... Hi, babe.","jump":null},{"id":"m_ex_volume_06_9","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_9","text":"Yes!","jump":null},{"id":"m_ex_volume_06_10","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_10","text":"That's better.","jump":"m_ex_volume_06_14"},{"id":"m_ex_volume_06_11","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_11","text":"Wow!","jump":null},{"id":"m_ex_volume_06_12","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_12","text":"I love it!","jump":null},{"id":"m_ex_volume_06_13","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_13","text":"Call me that every day.","jump":"m_ex_volume_06_14"},{"id":"m_ex_volume_06_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_14","text":"What's up?","jump":null},{"id":"m_ex_volume_06_15","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_15","text":"I have a favor","jump":null},{"id":"m_ex_volume_06_16","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_16","text":"to ask of you.","jump":null},{"id":"m_ex_volume_06_17","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_17","text":"Are you any good at singing?","jump":null},{"id":"m_ex_volume_06_18","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_18","text":"I was thinking of potentially doing a collab with you on my next song.","jump":null},{"id":"m_ex_volume_06_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_19","text":"??","jump":null},{"id":"m_ex_volume_06_20","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_20","text":"What's the matter?","jump":null},{"id":"m_ex_volume_06_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_21","text":"That's not going to work.","jump":null},{"id":"m_ex_volume_06_22","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_22","text":"Why not?","jump":null},{"id":"m_ex_volume_06_23","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_23","text":"I heard that you go to karaoke all the time.","jump":null},{"id":"m_ex_volume_06_24","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_24","text":"I would think that'd mean you're at least okay at singing.","jump":null},{"id":"m_ex_volume_06_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_25","text":"That's because I'm being dragged there against my will...","jump":null},{"id":"m_ex_volume_06_26","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_26","text":"Oh c'mon, don't be shy.","jump":null},{"id":"m_ex_volume_06_27","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_27","text":"Rather than express your passion for singing","jump":null},{"id":"m_ex_volume_06_28","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_28","text":"in front of a machine,","jump":null},{"id":"m_ex_volume_06_29","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_29","text":"wouldn't it be better","jump":null},{"id":"m_ex_volume_06_30","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_30","text":"to show it in front of an audience?","jump":null},{"id":"m_ex_volume_06_31","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_31","text":"You know?","jump":null},{"id":"m_ex_volume_06_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_32","text":"I don't think I'm good enough to showcase my singing to the public.","jump":null},{"id":"m_ex_volume_06_33","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_33","text":"Hmm...","jump":null},{"id":"m_ex_volume_06_34","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_34","text":"If that's what you're so worried about,","jump":null},{"id":"m_ex_volume_06_35","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_35","text":"let me listen to it.","jump":null},{"id":"m_ex_volume_06_36","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_36","text":"We can go to karaoke together.","jump":null},{"id":"m_ex_volume_06_37","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_37","text":"Are you free later today?","jump":null},{"id":"m_ex_volume_06_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_38","text":"Er...","jump":null},{"id":"m_ex_volume_06_39","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_39","text":"What is it?","jump":null},{"id":"m_ex_volume_06_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_40","text":"Actually, I already promised to go with Diesel.","jump":null},{"id":"m_ex_volume_06_41","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_41","text":"?!","jump":null},{"id":"m_ex_volume_06_42","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_42","text":"Then what about tomorrow?","jump":null},{"id":"m_ex_volume_06_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_43","text":"Tomorrow I'm going with Aria.","jump":null},{"id":"m_ex_volume_06_44","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_44","text":"Good grief!","jump":null},{"id":"m_ex_volume_06_45","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_45","text":"You've been excluding me this whole time,","jump":null},{"id":"m_ex_volume_06_46","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_46","text":"having the time of your life with karaoke?","jump":null},{"id":"m_ex_volume_06_47","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_47","text":"I can't believe it!","jump":null},{"id":"m_ex_volume_06_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_48","text":"I told you, I'm being dragged there involuntarily.","jump":null},{"id":"m_ex_volume_06_49","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_49","text":"I know Aria has some serious pipes,","jump":null},{"id":"m_ex_volume_06_50","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_50","text":"but what about Diesel?","jump":null},{"id":"m_ex_volume_06_51","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_51","text":"Is she a good singer?","jump":null},{"id":"m_ex_volume_06_52","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_52","text":"She's spectacular.","jump":null},{"id":"m_ex_volume_06_53","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_53","text":"Really?","jump":null},{"id":"m_ex_volume_06_54","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_54","text":"I didn't expect that.","jump":null},{"id":"m_ex_volume_06_55","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_55","text":"Surely if she was that good, I would have heard about it.","jump":null},{"id":"m_ex_volume_06_56","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_56","text":"I've never heard her sing.","jump":null},{"id":"m_ex_volume_06_57","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_57","text":"You'd be surprised.","jump":null},{"id":"m_ex_volume_06_58","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_58","text":"Hmm...","jump":null},{"id":"m_ex_volume_06_59","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_59","text":"So she's a hidden talent, is that it?","jump":null},{"id":"m_ex_volume_06_60","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_60","text":"She's no prodigy...","jump":null},{"id":"m_ex_volume_06_61","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_61","text":"Very well!","jump":null},{"id":"m_ex_volume_06_62","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_62","text":"Tell Diesel that","jump":null},{"id":"m_ex_volume_06_63","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_06_63","text":"I'm coming along as well.","jump":null},{"id":"m_ex_volume_06_64","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_06_64","text":"I feel like something terrible is going to happen.","jump":null}],"chat":true}