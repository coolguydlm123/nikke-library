"affinity":null},{"id":"d_nikke_rumani_01_104","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_104","text":"The answer is: absolutely not.\nI'm a busy woman.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_105","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_105","text":"I am responsible for training more than 50 people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_106","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_106","text":"Ah, of course, I mean 50 people who are completely serious about getting fit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_107","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_107","text":"I know you're an important person, Gym Rat...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_108","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_108","text":"But I won't take you seriously if you aren't serious about exercising.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_109","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_rumani_01_109","text":"You're so ruthless...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_110","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_110","text":"I'm not ruthless. It's just a co