d_nikke_rumani_01_77","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rumani_01_77","text":"I have some pain in my waist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_78","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_78","text":"Aha.\nYour waist, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_79","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_79","text":"Since you could come here, it can't have been something as serious as a bone fracture, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_80","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_80","text":"Is it just your muscle?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_81","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rumani_01_81","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_82","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_82","text":"So, let's do some exercises to strengthen your abdomen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_83","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_rumani_01_83","text":"You're just going to start right away?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_84","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_84","text":"Well, I just snuck out in the middle of training. I'll need to go back soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_85","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_85","text":"Come on.\nWatch carefully, Gym Rat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_86","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rumani_01_86","text":"Rumani lies flat, her feet planted on the ground, and lifts her core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_87","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_87","text":"Stay in this position for 5 seconds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_88","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_88","text":"Then, slowly, go back down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_89","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_89","text":"Inhale when you lift up your abdomen and exhale when you go down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_90","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_90","text":"Do 5 sets a day, 30 repetitions per set.\nUnderstand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_91","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_91","text":"Okay. I'm off, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_92","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rumani_01_92","text":"Don't you need to check if his posture is correct or not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_93","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_93","text":"Uhmmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_94","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rumani_01_94","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_95","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_95","text":"It'll only last about 3 days anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_96","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rumani_01_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rumani_01_97","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:d_nikke_rumani_01_97","text":"If people who don't usually work out come to the gym out of the blue...","jump":null,"exit":false,"enter":null,"bg":null,"bgA