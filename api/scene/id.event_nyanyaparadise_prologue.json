_18","text":"If I'd known all this, I'd have never gotten it in the first place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nyanyaparadise_prologue_19","type":"Speech","speaker":"whitewoman","key":"Locale_SubScenario:event_nyanyaparadise_prologue_19","text":"They're kinda cute as kittens, but then they grow up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nyanyaparadise_prologue_20","type":"Speech","speaker":"whitewoman","key":"Locale_SubScenario:event_nyanyaparadise_prologue_20","text":"Now it's more scary than cuddly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nyanyaparadise_prologue_21","type":"Speech","speaker":"skinnyman","key":"Locale_SubScenario:event_nyanyaparadise_prologue_21","text":"Just toss it and let's get out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nyanyaparadise_prologue_22","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_nyanyaparadise_prologue_22","text":"*Meow*\n*Meeow*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nyanyaparadise_prologue_23","type":"Speech","speaker":"whitewoman","key":"Locale_SubScenario:event_nyanyaparadise_prologue_23","text":"But... what'll happen if someone catches us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_nyanyaparadise_prologue_24","type":"Speech","speaker":"skinnyman","key":"Locale_SubScenario:event_nyanyaparadise_prologue_24","text":"It's just a street cat, no one will notice.","jump":null,"exit":false