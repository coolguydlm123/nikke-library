01_e_95","text":"Pfft! You're... confident when it comes to defense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_96","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall1_01_e_96","text":"Of course. I can block anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_97","type":"Speech","speaker":"noah","key":"Locale_MainScenario:event_goddessfall1_01_e_97","text":"What could you possibly block with that rusty old body of yours?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_98","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall1_01_e_98","text":"Haha. Are you aware of this, Sister Noah?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_99","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall1_01_e_99","text":"A shield which is raised to protect something precious...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_100","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall1_01_e_100","text":"It can block anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_101","type":"Speech","speaker":"noah","key":"Locale_MainScenario:event_goddessfall1_01_e_101","text":"What is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"aff