{"id":"event_goddessfall1_01_e","cat":"event","group":{"id":"ev40093","label":"GODDESS FALL · Part 1"},"label":"The Crazy Ones: B","stage":null,"prev":"event_goddessfall1_01_s","next":"event_goddessfall1_02_s","speakers":{"nayuta":"Nayuta","johan":"Johan","isabel":"Isabel","hongryeon":"Scarlet","rapunzel":"Rapunzel","noah":"Noah","snowwhite":"Snow White","harran":"Harran"},"icons":{"nayuta":"si_c223_00_s","johan":"si_c925_00_s","isabel":"si_c231_00_s","hongryeon":"si_c222_00_s","rapunzel":"si_c221_00_s","noah":"si_c232_00_s","snowwhite":"si_c220_00_s","harran":"si_c230_00_s"},"lines":[{"id":"event_goddessfall1_01_e_1","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_1","text":"It seemeth all have taken their places. 'Tis mine turn now.","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLobby","bgArt":"brokenedenlobby","image":null,"bgm":"event_bgm_goddessfall_coldnessandmercy","movie":null,"shown":["nayuta","johan"],"affinity":null},{"id":"event_goddessfall1_01_e_2","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_2","text":"I don't trust your combat skills.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_3","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_3","text":"I thank thee for reminding me of that which I myself am well aware.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_4","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_4","text":"I do intend to accompany Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_5","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_5","text":"Nihilister...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_6","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_6","text":"... I see now. You're planning on retrieving Lilith's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_7","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_7","text":"The Queen shall fall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_8","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_8","text":"She shall surely descend into the realm of our grasp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_9","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_9","text":"We must needs prepare a poisoned chalice for that hour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_10","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_11","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_11","text":"I oppose this plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_12","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_12","text":"The amount of Raptures we're dealing with is no joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_13","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_13","text":"Inherit and Pioneer could probably hold them off...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_14","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_14","text":"But the problem is what's up there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_15","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_15","text":"You are most assuredly correct. We know not what deeds the Queen may yet undertake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_16","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_16","text":"She could even dive down on us at any moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_17","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_17","text":"In the face of the unexpected, it's better to have some strength available.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_18","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_18","text":"Verily, that may be so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_19","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_19","text":"Mine greatest concern is with the state of Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_20","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_20","text":"Nihilister can't harm anyone, not the way she is now. She's little more than a walking corpse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_21","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_21","text":"You, however, are useful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_22","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_22","text":"What sort of entity dost thou suppose the Queen to be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_23","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_23","text":"What's with the sudden question, Monk? Continue with your story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_24","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_24","text":"In the hierarchy of Raptures, the Queen of Raptures standeth as the pinnacle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_25","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_25","text":"She hath descended after a century.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_26","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_26","text":"How can we be sure that Fire Dragon, upon beholding her, shall not falter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_27","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_27","text":"Are you saying there's a chance she might betray us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_28","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_28","text":"... No. She was never our ally to begin with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_29","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_29","text":"All the more cause to doubt her trustworthiness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_30","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_30","text":"That is why, ere any misfortune befall Fire Dragon...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_31","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_31","text":"We must needs secure the body of Lilith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_32","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_33","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_33","text":"Monk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_34","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_34","text":"What do you plan on doing with Nihilister after you retrieve Lilith's body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_35","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_36","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_36","text":"Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_37","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_37","text":"You're no different from the rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_38","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_01_e_38","text":"I am resolved to undertake any measures necessary to claim victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_39","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_39","text":"... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_40","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall1_01_e_40","text":"Go retrieve Lilith's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_41","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_41","text":"What do you think about a passageway at this elevation?","jump":null,"exit":false,"enter":null,"bg":"BrokenEden","bgArt":"brokeneden","image":null,"bgm":"event_bgm_goddessfall_shield","movie":null,"shown":["isabel","hongryeon"],"affinity":null},{"id":"event_goddessfall1_01_e_42","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_42","text":"Hmm. It's not bad. Though it may strain me, I could spring downward or upward if the occasion demands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_43","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_43","text":"Isabel, thou art adept in the arts of aerial combat. Dost thou truly believe that joining forces with me won't impede thy prowess?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_44","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_44","text":"I've got a short-range weapon anyway, so I need to engage in close-quarters combat. But it's not a big deal, so don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_45","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_45","text":"Verily, we find ourselves united in this endeavor. Let us devote our utmost efforts to the cause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_46","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_46","text":"... All right. I'm trusting in you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_47","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_48","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_49","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_49","text":"Thy countenance doth reveal a mind brimming with curiosity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_50","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_50","text":"Our alliance might be fleeting, but should any questions arise, hesitate not to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_51","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_51","text":"What will you do once we defeat the Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_52","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_52","text":"What is this? Dost thou speak of the aftermath of a battle not yet commenced?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_53","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_53","text":"Such speech may surely bring about one's demise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_54","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_54","text":"Just consider it casual chit-chat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_55","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_55","text":"Well... 'tis likely I shall live out my days toiling the land.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_reason","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_56","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_56","text":"I shall forsake my sword and take up the hoe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_57","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_57","text":"Why haven't you done that already?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_58","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_59","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_59","text":"Why do you fight for humanity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_60","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_60","text":"Why don't you stop wielding your sword?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_61","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_61","text":"This doth not constitute mere trifling discourse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_62","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_62","text":"I just feel like I won't have another chance to ask you this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_63","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_64","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_64","text":"I desire to partake in drink with those whom I cherish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_65","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_65","text":"You can drink anytime you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_66","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_66","text":"With naught but peace in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_67","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_67","text":"I long to partake of drink with naught a care in all the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_68","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall1_01_e_68","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_01_e_69","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall1_01_e_69","text":"Not to drown my pain, nor out of loneliness, nor to wallow in nostalgia.","jump":nul