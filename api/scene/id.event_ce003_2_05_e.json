_e_59","text":"It's understandable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_60","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_60","text":"Although she's much better than she was before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_61","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_61","text":"it's been years since she last had a hearty appetite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_62","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_62","text":"At first, I thought that if she ate delicious food made in the cooking competition,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_63","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_63","text":"her appetite might come back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_64","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_64","text":"But not even that was enough to make her appetite return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_65","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_65","text":"I was on the verge of giving up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_66","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_66","text":"I... I never thought I'd ever get to see Clara act this way again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_67","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_67","text":"So thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_68","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_68","text":"Well and truly, thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_69","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_e_69","text":"While shedding tears and thanking us profusely, the Connoisseur takes out a book.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_70","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_e_70","text":"On the cover, there is a golden dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_71","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_e_71","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_72","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_e_72","text":"Sister, isn't this the fairytale book Subaru used for studying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_73","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_e_73","text":"I believe so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_74","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_74","text":"I noticed you had your eyes on this before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_75","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_75","text":"Even though you said it was your first time seeing it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_76","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_76","text":"I could tell from your gaze that it meant something to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_77","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_77","text":"I know it isn't much,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_78","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_78","text":"but consider this my repayment for you making my daughter so happy once again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_79","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_e_79","text":"The fact the curry brought back all those nice memories made it even more delicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_80","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_e_80","text":"... I will hold on to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_81","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_81","text":"I have a daughter.","jump":null,"exit":false,"enter":null,"bg":"LivingRoom","bgArt":"livingroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_82","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_82","text":"She's sick, so she can't be as active as the other children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_83","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_83","text":"You don't have to worry, it's nothing life-threatening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_84","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_84","text":"It's just that she has to spend most of her time at home, and so she gets bored easily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_85","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_85","text":"To abate that, I started telling her stories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_86","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_86","text":"It was about that time when I began collecting discarded objects from up on the surface and assigning them these sweeping backstories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_87","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_87","text":"She really took to the stories that I was telling her,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_88","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_88","text":"and so she spends much of her time here in this lobby, looking at my collection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_89","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_89","text":"Oh, you mean this? Considering it came from the surface, it's in pristine condition, don't you think?","jump":null,"exit":false,"enter":null,"bg":"LivingRoom","bgArt":"livingroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_90","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_90","text":"It's written in characters I've never seen before, so I'm unable to decipher it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_91","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_91","text":"My daughter was terribly curious about what's inside its pages, but I was unable to read it to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_92","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_92","text":"May I ask if you've seen this book before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_93","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_e_93","text":"Can I spend some time with Clara?","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_94","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_94","text":"Certainly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_95","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_e_95","text":"You said she was curious about the content of this book, right? I can translate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_96","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_96","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_97","type":"Speech","speaker":"epicurean","key":"Locale_SubScenario:event_ce003_2_05_e_97","text":"I would be honored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_98","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_98","text":"... And that's the end of the story. What did you think?","jump":null,"exit":false,"enter":null,"bg":"Hotel","bgArt":"hotel","image":null,"bgm":null,"movie":null,"shown":["ce_003_02","ce_003_01","clara"],"affinity":null},{"id":"event_ce003_2_05_e_99","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_99","text":"It's always fun hearing a new story for the first time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_100","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_100","text":"Although there were hard-to-understand parts in the middle...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_101","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_101","text":"Still, thanks for telling it to me! *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_102","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_e_102","text":"You should thank Emilia. I was only planning to give a little overview of the story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_103","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_103","text":"Don't mention it. I also wanted to read this book to Clara.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_104","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_104","text":"A super big thank you to you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_105","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_e_105","text":"All right, I'll head back now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_106","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_106","text":"You're leaving already?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_107","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_e_107","text":"Clara, you're not completely recovered yet. The cooking competition today must have worn you out, you should rest now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_108","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_108","text":"It's really late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_109","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_109","text":"We have to go back home now, Clara.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_110","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_110","text":"We've been away for a long time. Everyone is probably worrying about us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_111","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_111","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_112","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_112","text":"Will we see each other again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_113","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_113","text":"Hmmm... Our home is very far away, so we're not sure when we can come here again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_114","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_114","text":"Still don't worry. We'll always remember you, Clara. After getting home, we'll try and figure out a way to see you again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_115","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_115","text":"There are many more adventure stories you have to tell us, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_116","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_e_116","text":"When that time comes, be sure to have plenty of stories prepared for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_117","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_117","text":"I sure will! I'll go on all sorts of adventures with my dad and tell you all about them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_118","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_e_118","text":"Next time, let's bring Barusu too. He gets along with kids.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_119","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_e_119","text":"Okay, but in order for all of this to happen, you've got to rest and become healthy, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_120","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_e_120","text":"Okay, I promise!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_121","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_e_121","text":"As I see Emilia and Clara making a promise,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_122","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_e_122","text":"and Rem and Ram as they stood with looks of contentment, an unfortunate thought came to my mind:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_e_123","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_e_123","text":"That our time together was quickly drawing to a close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}