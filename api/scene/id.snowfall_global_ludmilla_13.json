a_13_66","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_66","text":"Consider this my answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_67","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_global_ludmilla_13_67","text":"So you accomplished what you wanted to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_68","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_68","text":"Yes. I'm confident now that everyone here at Snowfield had a good time. Everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_69","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_global_ludmilla_13_69","text":"I'm glad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_70","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_global_ludmilla_13_70","text":"Ludmilla takes another sip of her tea, and with a smile tinged with an ever-so-slight hint of hubris, says:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_71","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_71","text":"Besides, don't you think I deserve to have a vacation of my own?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_72","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_72","text":"By planning something like this, I knew I could spend some time alone with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_73","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_73","text":"After all, I'm sure you wanted to spend additional time with me as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_74","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_global_ludmilla_13_74","text":"Ludmilla's words are brimming with confidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_75","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_75","text":"I told you before, and it bears repeating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_76","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_76","text":"If I want something, I won't stop until I get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_77","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_77","text":"I don't hesitate to take action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_78","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_78","text":"So, let's say what we're doing here is something that I wanted, and I went after it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_79","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_global_ludmilla_13_79","text":"Ludmilla leans her head against my shoulder, her arm interlocked with mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_80","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_global_ludmilla_13_80","text":"No one else will disturb us tonight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_global_ludmilla_13_81","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_global_ludmilla_13_81","text":"And with that, Ludmilla and I create another wonderful moment spent together in the bamboo forest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}