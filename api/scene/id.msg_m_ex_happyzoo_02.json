_happyzoo_02_11","text":"You're the best, Trainer.","jump":null},{"id":"m_ex_happyzoo_02_12","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_12","text":"Yeah, totally the best.","jump":null},{"id":"m_ex_happyzoo_02_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_happyzoo_02_13","text":"Why do you two like me so much?","jump":null},{"id":"m_ex_happyzoo_02_14","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_14","text":"Hehe!","jump":null},{"id":"m_ex_happyzoo_02_15","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_15","text":"Lots of reasons!","jump":null},{"id":"m_ex_happyzoo_02_16","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_16","text":"You're gentle.","jump":null},{"id":"m_ex_happyzoo_02_17","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_17","text":"Friendly.","jump":null},{"id":"m_ex_happyzoo_02_18","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_18","text":"Kind.","jump":null},{"id":"m_ex_happyzoo_02_19","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_19","text":"Handsome.","jump":null},{"id":"m_ex_happyzoo_02_20","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_20","text":"And above all...","jump":null},{"id":"m_ex_happyzoo_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_happyzoo_02_21","text":"Yes?","jump":null},{"id":"m_ex_happyzoo_02_22","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_22","text":"You treat us well U>ᴥ<U","jump":null},{"id":"m_ex_happyzoo_02_23","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_23","text":"Hehe!","jump":null},{"id":"m_ex_happyzoo_02_24","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_24","text":"What about you, Nero? How come you like Trainer so much?","jump":null},{"id":"m_ex_happyzoo_02_25","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_25","text":"Basically, my reasons are just like Biscuit's.","jump":null},{"id":"m_ex_happyzoo_02_26","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_26","text":"There is one big difference though.","jump":null},{"id":"m_ex_happyzoo_02_27","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_27","text":"Scoops...","jump":null},{"id":"m_ex_happyzoo_02_28","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_28","text":"Scoops what? Tell meeeeee!","jump":null},{"id":"m_ex_happyzoo_02_29","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_29","text":"Scoops doesn't annoy me as often.","jump":null},{"id":"m_ex_happyzoo_02_30","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_happyzoo_02_30","text":"I suppose that's a compliment?","jump":"m_ex_happyzoo_02_32"},{"id":"m_ex_happyzoo_02_31","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_happyzoo_02_31","text":"That's because you have to respect a cat's private space.","jump":"m_ex_happyzoo_02_34"},{"id":"m_ex_happyzoo_02_32","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_32","text":"Meow.","jump":null},{"id":"m_ex_happyzoo_02_33","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_33","text":"It's absolutely intended to be a compliment.","jump":"m_ex_happyzoo_02_36"},{"id":"m_ex_happyzoo_02_34","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_34","text":"Meow.","jump":null},{"id":"m_ex_happyzoo_02_35","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_35","text":"You really do understand me, Scoops.","jump":"m_ex_happyzoo_02_36"},{"id":"m_ex_happyzoo_02_36","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_36","text":"Well, I don't know about you,","jump":null},{"id":"m_ex_happyzoo_02_37","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_happyzoo_02_37","text":"but I'm always gonna like Trainer, forever and ever!","jump":null},{"id":"m_ex_happyzoo_02_38","type":"Speech","speaker":"nero","key":"Locale_SuddenMessage:m_ex_happyzoo_02_38","text":"Meow too.","jump":null},{"id":"m_ex_happyzoo_02_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_happyzoo_02_39","text":"I appreciate that, both of you.","jump":null},{"id":"m_ex_happyzoo_02_40","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_happyzoo_02_40","text":"It's been a while since I received such heartwarming messages over Bla.","jump":null}],"chat":true}