{"id":"d_counseling_admi_11","cat":"counsel","group":{"id":"char5030","label":"Admi"},"label":"Advising Admi: 11","stage":null,"prev":"d_counseling_admi_10","next":"d_counseling_admi_12","speakers":{"admi":"Admi"},"icons":{"admi":"si_c172_00_s"},"lines":[{"id":"d_counseling_admi_11_1","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_1","text":"Every beginning has an end.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["admi"],"affinity":"_0"},{"id":"d_counseling_admi_11_2","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_2","text":"If everything is bound to end, then why bother trying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_3","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_3","text":"What are your thoughts, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_11_4","text":"You just need to start fresh.","jump":"d_counseling_admi_11_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_admi_11_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_11_5","text":"I can't give up, not until I know how it all ends.","jump":"d_counseling_admi_11_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_admi_11_6","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_6","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_7","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_7","text":"Even if you start something new, it will end eventually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_8","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_8","text":"Don't you find the repetition exhausting?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_9","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_9","text":"It's a little hard to understand.","jump":"d_counseling_admi_11_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_10","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_10","text":"How it all ends...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_11","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_11","text":"I suppose you could define \"end\" in various ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_12","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_12","text":"Surely one of those definitions must include a happy ending.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_11_13","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_11_13","text":"That seems like a good mindset