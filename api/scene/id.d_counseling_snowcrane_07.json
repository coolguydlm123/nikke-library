{"id":"d_counseling_snowcrane_07","cat":"counsel","group":{"id":"char5168","label":"Snow Crane"},"label":"Advising Snow Crane: 07","stage":null,"prev":"d_counseling_snowcrane_06","next":"d_counseling_snowcrane_08","speakers":{"snowcrane":"Snow Crane"},"icons":{"snowcrane":"si_c620_00_s"},"lines":[{"id":"d_counseling_snowcrane_07_1","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_07_1","text":"I saw this on TV the other day. Apparently, this berry-and-lemon Splendamin is really good for you!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["snowcrane"],"affinity":"_0"},{"id":"d_counseling_snowcrane_07_2","type":"Monologue","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_07_2","text":"Snow Crane pulls out a box of gummies that's covered in strawberries and lemons and places it on my desk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_07_3","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_07_3","text":"Why don't we have some before we start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_07_4","text":"Sure, if they're good for you...","jump":"d_counseling_snowcrane_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_snowcrane_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_07_5","text":"I don't like sour things...","jump":"d_counseling_snowcrane_07_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":