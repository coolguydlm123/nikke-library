{"id":"msg_m_ex_flora_03","cat":"messenger","group":{"id":"room_flora","label":"Flora · Nikke"},"label":"3. Blossom,","stage":null,"prev":"msg_m_ex_flora_02","next":"msg_m_nikke_ce005_01_05","speakers":{"flora":"Flora"},"icons":{"flora":"si_c411_00_s"},"lines":[{"id":"m_ex_flora_03_1","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_1","text":"Blossom,","jump":null},{"id":"m_ex_flora_03_2","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_2","text":"if you're not busy,","jump":null},{"id":"m_ex_flora_03_3","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_3","text":"how about a stroll in the garden?✿","jump":null},{"id":"m_ex_flora_03_4","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_4","text":"The flowers would love to see you.","jump":null},{"id":"m_ex_flora_03_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_5","text":"Which flowers want to see me?","jump":null},{"id":"m_ex_flora_03_6","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_6","text":"Flora reads my message, but doesn't reply.","jump":null},{"id":"m_ex_flora_03_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_7","text":"Flora?","jump":null},{"id":"m_ex_flora_03_8","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_8","text":"Sorry.","jump":null},{"id":"m_ex_flora_03_9","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_9","text":"I was asking the flowers, so my reply was delayed.","jump":null},{"id":"m_ex_flora_03_10","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_10","text":"The roses, tulips,","jump":null},{"id":"m_ex_flora_03_11","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_11","text":"violas, hydrangeas,","jump":null},{"id":"m_ex_flora_03_12","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_12","text":"daisies, sunflowers,","jump":null},{"id":"m_ex_flora_03_13","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_13","text":"and even the lysimachia want to see you.","jump":null},{"id":"m_ex_flora_03_14","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_14","text":"And...","jump":null},{"id":"m_ex_flora_03_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_15","text":"Well then, I'll have to come and make an appearance.","jump":null},{"id":"m_ex_flora_03_16","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_16","text":"That would be lovely!","jump":null},{"id":"m_ex_flora_03_17","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_17","text":"Do stop by","jump":null},{"id":"m_ex_flora_03_18","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_18","text":"if you have the time.✿","jump":null},{"id":"m_ex_flora_03_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_19","text":"I want to see the flowers, but it's you I really want to see, Flora.","jump":null},{"id":"m_ex_flora_03_20","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_20","text":"Flora reads my message, but doesn't reply.","jump":null},{"id":"m_ex_flora_03_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_21","text":"Are you there?","jump":null},{"id":"m_ex_flora_03_22","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_22","text":"I'm sorry.","jump":null},{"id":"m_ex_flora_03_23","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_23","text":"I was consulting with the flowers again.✿","jump":null},{"id":"m_ex_flora_03_24","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_24","text":"This is the first time I've received a message like this,","jump":null},{"id":"m_ex_flora_03_25","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_25","text":"so I wasn't sure how to reply.","jump":null},{"id":"m_ex_flora_03_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_26","text":"And what did the flowers suggest that you say?","jump":null},{"id":"m_ex_flora_03_27","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_27","text":"They told me","jump":null},{"id":"m_ex_flora_03_28","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_28","text":"to follow my heart.","jump":null},{"id":"m_ex_flora_03_29","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_29","text":"I also","jump":null},{"id":"m_ex_flora_03_30","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_30","text":"want to see you,","jump":null},{"id":"m_ex_flora_03_31","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_31","text":"Blossom.✿","jump":null},{"id":"m_ex_flora_03_32","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_32","text":"Very much so.","jump":null},{"id":"m_ex_flora_03_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_flora_03_33","text":"I'll come right away.","jump":null},{"id":"m_ex_flora_03_34","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_34","text":"Okay.✿","jump":null},{"id":"m_ex_flora_03_35","type":"Speech","speaker":"flora","key":"Locale_SuddenMessage:m_ex_flora_03_35","text":"I'll be waiting for you in the garden.✿","jump":null}],"chat":true}