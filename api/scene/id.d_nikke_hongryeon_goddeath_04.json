{"id":"d_nikke_hongryeon_goddeath_04","cat":"bond","group":{"id":"char5186","label":"Scarlet: Goddeath"},"label":"Meetings and Partings","stage":null,"prev":"d_nikke_hongryeon_goddeath_03","next":"d_nikke_hongryeon_goddeath_05","speakers":{"hongryeon_g":"Scarlet","cecil":"Cecil","cecil_op_l":"Cecil"},"icons":{"hongryeon_g":"si_c472_00_s","cecil":"si_c929_00_s","cecil_op_l":"si_c929_00_s"},"lines":[{"id":"d_nikke_hongryeon_goddeath_04_1","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_1","text":"Scarlet sits down near the garden bed.","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"bgm_story_scarletpetal","movie":null,"shown":["hongryeon_g","cecil"],"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_2","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_2","text":"Very well, then. Let us begin forthwith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_3","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_3","text":"She then scoots to the front...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_4","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_4","text":"*Scritch, scritch*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_5","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_5","text":"Carefully, she digs into the soil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_6","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_6","text":"From the packet, she takes a rose seed and places it in the hole.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_7","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_7","text":"*Scritch, scritch*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_8","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_8","text":"She scoops the soil back over the seed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_9","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_9","text":"Shall this suffice?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_10","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_10","text":"You can pack the soil around it down a little too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_11","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_11","text":"Just don't press too hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_12","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_12","text":"Scarlet pats down the soil over the seed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_13","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_13","text":"Here should do nicely, methinks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_14","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_14","text":"*Thwup*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_15","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_15","text":"The garden marker sinks into the soil in front of the flower bed where she planted the seed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_16","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_16","text":"Cecil crouches down in front of it and reads the marker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_17","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_17","text":"Though no flower stayeth red for eleven days, spring endeth not when its blossoms fall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_18","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_18","text":"Is that correct?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_19","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_19","text":"Thou speakest true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_20","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_20","text":"Though no flower remaineth red for eleven days, spring endureth long after its blossoms have fallen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_21","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_21","text":"The saying is \"no flower remaineth red for ten days,\" is it not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_22","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_22","text":"One once spake thus:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_23","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_23","text":"\"Were a flower to bloom for but ten days, would that not be passing miserly?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_24","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_24","text":"Surely then, none would begrudge it one day more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_25","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_25","text":"Scarlet fills a cup with water,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_26","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_26","text":"then tilts it over the spot where she planted the rose seed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_27","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_27","text":"A gentle trickle of water falls onto the soil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_28","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_29","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_29","text":"I'd only be in the way if I stayed here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_30","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_30","text":"so I'll go find Johan and Papillon for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_31","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_31","text":"Thy company troubleth me not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_32","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_32","text":"I'm not so tactless","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_33","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_33","text":"that I can't read the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_34","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_34","text":"For now, at least, do whatever you wish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_35","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_35","text":"... Sometimes, you have to keep your memories close to your heart and move on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_36","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_36","text":"I thank thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_37","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_37","text":"Don't mention it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_38","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_38","text":"Cecil leaves the lobby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_39","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_39","text":"Scarlet pours herself a glass of water","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_40","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_40","text":"and takes a drink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_41","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_41","text":"'Twould be only meet to share a cup of spirits at a time like this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_42","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_42","text":"but prithee, indulge me just this once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_43","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_43","text":"Come our next meeting, I shall bring a cup worthy of thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_44","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_44","text":"Scarlet pulls out Rose's hairpiece","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_45","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_45","text":"and ties it to the garden marker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_46","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_46","text":"*Rustle*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_47","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_47","text":"Pray, keep thine eye upon me from afar, Rose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_48","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_48","text":"With my comrades by my side, I shall venture forth toward the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_49","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_49","text":"Scarlet tips her bottle,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_50","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_50","text":"pouring all the water onto the soil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_51","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_51","text":"But grieve not overmuch, for I shall keep thee forever in the dearest chamber of my heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_52","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_52","text":"Are you almost finished, Scarlet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_l"],"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_53","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_53","text":"I have done all that needed doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_54","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_54","text":"And yet, thou seemest in such haste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_55","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_55","text":"Hath aught befallen thee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_56","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_56","text":"Communications are too unstable to get a clear picture of what's happening,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_57","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_57","text":"but it looks like a battle has broken out at the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_58","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_58","text":"We'll have to leave earlier than planned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_59","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_60","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_60","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_61","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_61","text":"I shall set forth forthwith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_62","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_62","text":"No, please wait in the lobby for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_63","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_63","text":"We're on our way,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_04_64","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_04_64","text":"and Rapunzel will be joining you shortly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}