{"id":"d_counseling_liter_13","cat":"counsel","group":{"id":"char5011","label":"Liter"},"label":"Advising Liter: 13","stage":null,"prev":"d_counseling_liter_12","next":"d_counseling_liter_14","speakers":{"liter":"Liter"},"icons":{"liter":"si_c082_00_s"},"lines":[{"id":"d_counseling_liter_13_1","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_13_1","text":"I was thinking of getting Volt a younger brother.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["liter"],"affinity":"_0"},{"id":"d_counseling_liter_13_2","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_13_2","text":"I'm not at home a lot, and Volt looks like he's feeling a little lonely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_13_3","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_13_3","text":"If I get him a little brother to play with, he might not be as lonely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_13_4","text":"Then you'll just end up with two lonely dogs instead of one.","jump":"d_counseling_liter_13_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_liter_13_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_13_5","text":"How about bringing two more dogs?","jump":"d_counseling_liter_13_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_liter_13_6","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_cou