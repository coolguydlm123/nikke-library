{"id":"d_counseling_soline_18","cat":"counsel","group":{"id":"char5019","label":"Soline"},"label":"Advising Soline: 18","stage":null,"prev":"d_counseling_soline_17","next":"d_counseling_soline_19","speakers":{"soline":"Soline"},"icons":{"soline":"si_c071_00_s"},"lines":[{"id":"d_counseling_soline_18_1","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_18_1","text":"I was about to brush my teeth yesterday, when I noticed something...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["soline"],"affinity":"_0"},{"id":"d_counseling_soline_18_2","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_18_2","text":"Diesel swapped the regular toothpaste for strawberry-flavored! Can you believe that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_18_3","type":"Speech","speaker":"soline","key":"Locale_Counseling:d_counseling_soline_18_3","text":"Strawberry candy is one thing, but strawberry toothpaste? No thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_soline_18_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_soline_18_4","text":"It probably tastes nice and sweet.","jump":"d_counseling_soline_18_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_soline_18_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_soline_18_5","text":"Let's change it to another toothpaste.","jump":"d_counseling_soline_18_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_soline_18_6","type":"Speech","speaker":"soli