{"id":"d_counseling_elegg_07","cat":"counsel","group":{"id":"char5107","label":"Elegg"},"label":"Advising Elegg: 07","stage":null,"prev":"d_counseling_elegg_06","next":"d_counseling_elegg_08","speakers":{"elegg":"Elegg"},"icons":{"elegg":"si_c500_00_s"},"lines":[{"id":"d_counseling_elegg_07_1","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_1","text":"What a thrill it is to harness electricity!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["elegg"],"affinity":"_0"},{"id":"d_counseling_elegg_07_2","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_2","text":"Directly controlling an energy source invisible to the naked eye, to make it bend to your command...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_07_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_07_3","text":"I don't see the appeal.","jump":"d_counseling_elegg_07_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_elegg_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_07_4","text":"So cool!","jump":"d_counseling_elegg_07_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_elegg_07_5","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_5","text":"Not many people do. It can be a hard concept to grasp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_07_6","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_6","text":"But I do take pleasure in it, and it's how I make a living.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_07_7","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_7","text":"If you love what do you, you'll never work a day in your life!","jump":"d_counseling_elegg_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_07_8","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_8","text":"Hehe, you're adorable, Mr. Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_07_9","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_9","text":"I realize that harnessing electricity may be a difficult concept to grasp, but once you take a closer look, it can be incredibly fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_07_10","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_07_10","text":"If you ever want to learn more, I'd be more than happy to teach you, hehe.","jump":"d_counseling_elegg_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_07_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_07_11","text":"Elegg and I enjoy our session together.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}