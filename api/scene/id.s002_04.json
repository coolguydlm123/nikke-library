002_04_29","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_04_29","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_04_30","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_04_30","text":"A bomb?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_04_31","type":"Speech","speaker":"mana","key":"Locale_SideStory:s002_04_31","text":"If she ventures too far from the Ark","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_04_32","type":"Speech","speaker":"mana","key":"Locale_SideStory:s002_04_32","text":"or if she doesn't come back and get it swapped out for a new one, it will detonate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_04_33","type":"Speech","speaker":"mana","key":"Locale_SideStory:s002_04_33","text":"So, as I said before, you must not forget to have her report into the Ark regularly, even while she is carrying out a mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_04_34","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_04_34","text":"Yes. I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_04_35","type":"Speech","speaker":"mihara","key":"Locale_SideStory:s002_04_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s002_04_36","type":"Monologue","speaker":null,"key":"Locale_SideStory:s002_04_36","text":"Mihara looks at Yuni again.","jump":null,"exi