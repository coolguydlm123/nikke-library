t":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_20","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_01_s_20","text":"Did I just see what I think I saw? Was that a human survivor on the surface?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_21","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_21","text":"I... I think so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_22","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_01_s_22","text":"I thought there officially weren't supposed to be any survivors up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_23","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_01_s_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_24","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_01_s_24","text":"I'm starting to get sick and tired of all this \"official\" talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_25","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_01_s_25","text":"Sounds to me more like orders rather than stating the actual facts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_26","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_01_s_26","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_27","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_01_s_27","text":"Never mind. I don't mean much by it. Forget I said anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_28","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_2_01_s_28","text":"... Anyway, sounds like it's a pretty big deal that this old guy is up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_29","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_01_s_29","text":"It's more than that! It's a complete upheaval of everything we've been led to believe up until now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_30","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_01_s_30","text":"Mr. Commander, we have to tell the others about this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_31","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_31","text":"You're right. Let's fill them in on what's happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_32","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_2_01_s_32","text":"Are we not going to follow him inside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_33","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_33","text":"I think we should share this information with our other team members first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_34","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_34","text":"... To be honest, I have no idea what the protocol is here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_35","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_35","text":"Soon after. I explain to the others what happened on the ground floor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["neon","rapi","ce006_01","privaty","roam","anis"],"affinity":null},{"id":"event_ce006_2_01_s_36","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_01_s_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"collab_bgm_sb_field_floodedcs_inst","movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_01_s_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_38","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_01_s_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_39","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_01_s_39","text":"I... I don't know what to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_01_s_40","text":"Yeah. It doesn't make any sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_41","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_01_s_41","text":"Shouldn't we check out what's beyond that door?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_01_s_42","text":"I don't know. Shouldn't we report it first?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_43","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_01_s_43","text":"How about we investigate as we report?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_01_s_44","text":"No, we should report as we investigate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_45","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_01_s_45","text":"How about investigating during the investigation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_01_s_46","text":"Or reporting as we report?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_47","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_01_s_47","text":"I think we all need to calm down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_48","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_01_s_48","text":"Commander. Let's report to Deputy Chief Andersen first, and then ask Privaty for assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_49","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_01_s_49","text":"We're going to have to get the Central Government involved on this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_50","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_50","text":"Okay, that sounds right. Let's report to Ingrid, no, I mean Mustang, wait...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_51","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_01_s_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_52","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_52","text":"Good grief. I can't sit here listening to any more of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_53","text":"Privaty gets up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_54","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_54","text":"Privaty, how are you feeling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_55","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_55","text":"I'm fine. The back of my head stings a little, but it's nothing major.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_56","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_56","text":"So, you found a survivor on the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_57","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_57","text":"I'll file a report straight away and take all necessary actions. You should all go back to the ground floor to investigate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_58","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_01_s_58","text":"Okay, thanks for the advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_59","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_59","text":"What was I doing lying down, anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_60","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_60","text":"The last thing I remember is fighting a Rapture on the way to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_61","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_01_s_61","text":"Com tackled you and sent you flying. You hit the back of your head really hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_62","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_62","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_63","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_2_01_s_63","text":"You fainted, and the White Three saved us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_64","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:event_ce006_2_01_s_64","text":"The who?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_65","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_01_s_65","text":"Speaking of which, where did they go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_66","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_66","text":"Oh, they all...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_67","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_67","text":"I'd like to track down that Com character.","jump":null,"exit":false,"enter":null,"bg":"Desert_04","bgArt":"desert_04","image":null,"bgm":"bgm_story_thepilgrimacv","movie":null,"shown":["rapunzel","hongryeon","snowwhite"],"affinity":null},{"id":"event_ce006_2_01_s_68","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_ce006_2_01_s_68","text":"*Munch munch* Why's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_69","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_69","text":"Snow White, may I remind you not to speak with your mouth full?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_70","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_70","text":"... Where did you even get all that food, anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_71","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_ce006_2_01_s_71","text":"There was a big pile of it sitting here. It didn't seem to belong to anyone, so I went for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_72","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_ce006_2_01_s_72","text":"There's plenty to go around, so help yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_73","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_73","text":"... I'll apologize to Believer later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_74","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_74","text":"That would be best. But, pray tell, why dost thou wish to track down this robot?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_75","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_75","text":"The data contained in that robot is over a hundred years old.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_76","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_76","text":"Even if we personally can't find any use for it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_77","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_77","text":"it would be of immense value to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_78","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_ce006_2_01_s_78","text":"Sounds like a reasonable argument to me. Let's track it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_79","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_79","text":"Very well, let the pursuit be underway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_80","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_80","text":"I want to stay and help Believer, but we must hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_81","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_ce006_2_01_s_81","text":"Don't worry, he can take care of himself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_82","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_82","text":"That's right. He has things under control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_83","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_83","text":"Although, there is something that makes my soul grow restless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_84","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_84","text":"I feel that I've laid mine eyes on that woman before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_85","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_85","text":"Are you talking about me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce006_01"],"affinity":null},{"id":"event_ce006_2_01_s_86","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_86","text":"Egads! How long have you been following us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_87","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_87","text":"I have a feeling that I've met you before too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_88","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_88","text":"You do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_89","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_89","text":"Yes, although I can't pinpoint it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_90","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_90","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_91","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_92","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_92","text":"Dost thou utilize a blade?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_93","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_93","text":"Indeed I do. And you seem to as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_94","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_94","text":"No wonder. I desired to unsheathe Fleetly Fading as soon as I saw you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_95","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_95","text":"Well then, shall we have a duel? What does thou say to that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_96","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_96","text":"Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_97","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_97","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_98","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_98","text":"Very well. My excitement got the best of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_99","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_99","text":"We have urgent matters to attend to, so we'll have to resume this at a later date.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_100","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_100","text":"Do you need to leave right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_101","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_101","text":"I believe so, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_102","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_102","text":"Sister, please inform Believer that time is of the essence,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_103","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_2_01_s_103","text":"and so we left in a hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_104","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_2_01_s_104","text":"Okay, I'll relay the message.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_105","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_105","text":"See you around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_01_s_106","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_2_01_s_106","text":"Next time, you and I shall have a proper palaver.","jump":