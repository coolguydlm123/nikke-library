null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_08_27","type":"Speech","speaker":"quency_e","key":"Locale_SuddenStory:d_ex_powerplant_08_27","text":"you want to learn about indoor escape techniques?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_08_28","type":"Speech","speaker":"tove","key":"Locale_SuddenStory:d_ex_powerplant_08_28","text":"Yes, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_08_29","type":"Speech","speaker":"tove","key":"Locale_SuddenStory:d_ex_powerplant_08_29","text":"I'm a survival expert myself, so I have some escape-related experience in the sense of fleeing from danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_08_30","type":"Speech","speaker":"tove","key":"Locale_SuddenStory:d_ex_powerplant_08_30","text":"I haven't done much of it indoors, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_08_31","type":"Speech","speaker":"quency_e","key":"Locale_SuddenStory:d_ex_powerplant_08_31","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_08_32","type":"Speech","speaker":"tove","key":"Locale_SuddenStory:d_ex_powerplant_08_32","text":"May I ask why you had us meet here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_powerplant_08_33","type":"Speech","speaker":"tove","key":"Locale_SuddenStory:d_ex_powerplant_08_33","text":"I don't see what generators ha