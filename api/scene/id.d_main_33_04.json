ch","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_14","text":"Besides, stopping for nonsense like this only puts the Commander in unnecessary danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_15","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_15","text":"Nothing of the sort will occur, because I'm here to protect him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_16","text":"Weren't you asleep for over a century? Why do you talk as if you know everything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_17","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_18","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_18","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_19","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_19","text":"You don't like me, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_20","text":"That's not true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_21","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_21","text":"You've been attempting to pick a fight with me for a while now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_22","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_22","text":"What is it about me that irks you so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_24","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_24","text":"If you don't tell me, then I'll never know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_25","text":"I can't stand you prattling on endlessly about beauty and all that nonsense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_26","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_26","text":"Does my pulchritude displease you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_27","text":"Yes. It's hard enough staying alive out here. Who's got time to care about looks?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_28","text":"You have no idea how bad things are. Beauty and other such notions are long gone, banished to the realm of myth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_29","text":"We're in a world where those concepts are no longer important, nor should they be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_30","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_31","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_31","text":"Have I made you feel poorly about yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_32","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_33","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_33","text":"Beauty must have been something that you valued above all else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_34","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_34","text":"But right now, you couldn't be further from it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_35","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_35","text":"Hearing someone else talk about something you used to value, but were unable to obtain...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_36","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_36","text":"does it make you feel bad about yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_37","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_37","text":"Especially because I, a stranger, embody it so naturally?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_38","text":"You've got some nerve talking to me like that. What do you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_39","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_39","text":"Your nails.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_40","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_40","text":"Your hair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_41","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_41","text":"Your skin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_42","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_42","text":"Yes, you pursued beauty. Enough that you've taken care of yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_43","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_43","text":"Am I wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_44","text":"Yeah. I pursued it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_45","text":"But it didn't turn out the way I wanted it to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_46","text":"So I've got a bit of lingering resentment, and I took it out on you. Satisfied?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_47","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_47","text":"Not beautiful. Not one bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_48","text":"Screw you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_49","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_49","text":"You don't know me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_50","text":"There's no time for ridiculous things like that in this world, not anymore!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_51","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_51","text":"What's the use in obsessing over beauty with things as they are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_52","text":"I don't see the point in it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_53","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_53","text":"I can't understand you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_54","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_33_04_54","text":"If you don't feel beautiful yourself, you will never understand me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_55","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_04_55","text":"I didn't always look like this! Before, I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_04_56"