{"id":"event_foolmetalpanic_09_e","cat":"event","group":{"id":"ev130010","label":"Foolmetalpanic"},"label":"The Fragment of the Jewel of Four Souls: B","stage":null,"prev":"event_foolmetalpanic_09_s","next":"event_foolmetalpanic_10","speakers":{"mekamishifty":"Mekami Shifty"},"icons":{"mekamishifty":"si_c610_00_s"},"lines":[{"id":"event_foolmetalpanic_09_e_1","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_1","text":"We finally found it. The last fragment.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":["mekamishifty"],"affinity":null},{"id":"event_foolmetalpanic_09_e_2","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_2","text":"Now I must go to my secret base to purify the giant amalgamated etc.'s fragments that I've collected so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_3","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_09_e_3","text":"Hm...? What secret base? This is the first I've heard of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_4","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_4","text":"Yes, hence why I called it a secret base. What a primitive statement from a primitive species, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_5","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_5","text":"Once the fragments are purified, true peace will come to the blue star as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_6","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_7","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_7","text":"I don't know if we'll meet again, but I will never forget your ignorance and savagery for the rest of my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_8","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_8","text":"Nor will I forget the seeds of life inside my stomach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_9","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_09_e_9","text":"Please don't say it like that. In fact, feel free to forget all about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_10","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_10","text":"... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_11","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_09_e_11","text":"Goodbye!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_12","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_09_e_12","text":"Mekami Shifty flies high into the sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_09_e_13","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_09_e_13","text":"I decide to head back to the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}