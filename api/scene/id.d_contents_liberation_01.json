{"id":"d_contents_liberation_01","cat":"sub","group":{"id":"d_contents_liberation","label":"Contents Liberation"},"label":"d_contents_liberation_01","stage":null,"prev":null,"next":null,"speakers":{"andersen":"Andersen"},"icons":{"andersen":"si_c903_00_s"},"lines":[{"id":"d_contents_liberation_01_1","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_1","text":"Do you know the Rehabilitation Center?","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":"bgm_mystery","movie":null,"shown":["andersen"],"affinity":null},{"id":"d_contents_liberation_01_2","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_2","text":"It's a particularly unnerving place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_3","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_3","text":"For Nikkes who committed felonies,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_4","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_4","text":"it's both a prison and a paradise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_5","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_5","text":"They are kept there in case their skills are needed one day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_6","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_6","text":"Their memories are not erased in order to keep their abilities intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_7","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_7","text":"Despite their criminal background, they're considered to be of special value and therefore have been granted their freedom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_8","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_8","text":"The only catch is that they may only enjoy this newfound freedom in the Rehabilitation Center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_9","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_9","text":"For everyone's safety, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_10","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_10","text":"However,","jump":null,"exit":false,"enter":null,"bg":"JailCorridor","bgArt":"jailcorridor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_11","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_11","text":"something strange happened in the center recently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["fatprisoner"],"affinity":null},{"id":"d_contents_liberation_01_12","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_12","text":"Three Nikkes have begun to create their own sphere of influence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["thinprisoner"],"affinity":null},{"id":"d_contents_liberation_01_13","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_13","text":"This is the first time we've seen anything like this. As I mentioned, all Nikkes in the center are dangerous individuals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_14","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_14","text":"Every single one of them acts on their own and refuses to take orders from anyone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_15","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_15","text":"This creates a sort of balance. But now that this strange bailiwick has appeared, the center has become a dangerous place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_16","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_16","text":"If the Nikkes were to act in concert, the iron gate would prove to be no impediment whatsoever to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_17","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_17","text":"That's the reason why you're here.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":["andersen"],"affinity":null},{"id":"d_contents_liberation_01_18","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_18","text":"I'm hoping you can rehabilitate the three Nikkes behind this fifth column that has sprung up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_19","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_19","text":"I'll brief you on them one by one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_20","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_20","text":"Guilty.","jump":null,"exit":false,"enter":null,"bg":"JailCorridor","bgArt":"jailcorridor","image":null,"bgm":null,"movie":null,"shown":["guilty"],"affinity":null},{"id":"d_contents_liberation_01_21","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_21","text":"Her power is far beyond that of an ordinary Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_22","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_22","text":"She inflicted injury upon more than 40 of her fellow Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_23","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_23","text":"Barehanded, mind you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_24","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_24","text":"Needless to say, it's best to refrain from having physical contact with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_25","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_25","text":"Sin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["sin"],"affinity":null},{"id":"d_contents_liberation_01_26","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_26","text":"She can beguile anyone with her words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_27","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_27","text":"We're still not quite sure how it works, but we believe that's how she is able to control the minds of others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_28","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_28","text":"That's why we placed a device on her that temporarily restricts her ability to speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_29","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_29","text":"However, that doesn't mean you shouldn't be cautious when speaking to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_30","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_30","text":"Quency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["quency"],"affinity":null},{"id":"d_contents_liberation_01_31","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_31","text":"Hm... Though she may be a little different from the other two, she's also dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_32","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_32","text":"No matter where she is, she'll always find ways to escape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_33","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_33","text":"Some of our intelligence suggests she is transporting supplies from the Ark to the center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_34","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_34","text":"Don't let her out of your sight for a single second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_35","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_35","text":"Rehabilitate the three Nikkes and get them out of the center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_36","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_36","text":"If you succeed, balance will be restored and we won't have to worry about another Nikke uprising.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_37","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_37","text":"The Rehabilitation Center will revert back to the unnerving place we know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_liberation_01_38","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_38","text":"It's no exaggeration to say that I'm entrusting you with the safety of the entire Ark.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":["andersen"],"affinity":null},{"id":"d_contents_liberation_01_39","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:d_contents_liberation_01_39","text":"I believe you can do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}