ryone is still waiting inside the shelters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_7","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_24_12_7","text":"The doors will only open once all the Raptures have been eliminated and it's been declared safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_8","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_24_12_8","text":"That should be in about two days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_12_9","text":"Hmm, in that case...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_10","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_12_10","text":"I've heard of a place called M.M.R. Can I go there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_11","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_24_12_11","text":"Oh jeez, sorry, but that's a top-secret area. I'm afraid you can't go there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_12","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_24_12_12","text":"Not quite. The deepest recesses are off-limits, but the other areas are open to the general public for field trips and the like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_13","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_24_12_13","text":"Oh, is that right? I had no idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_14","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_24_12_14","text":"Miranda, you took someone there only a few days ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_15","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_24_12_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_16","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_24_12_16","text":"Oh, right! I remember now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_17","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_24_12_17","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_18","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_24_12_18","text":"Anyway, do you still wanna go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_12_19","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_12_20","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_12_20","text":"M.M.R.","jump":null,"exit"