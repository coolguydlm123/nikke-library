{"id":"d_main_11_05","cat":"main","group":{"id":"ch11","label":"Chapter 11 · The Strongest"},"label":"Comrade-In-Arms","stage":"11-21 STAGE · Start","prev":"d_main_11_04","next":"d_main_11_06_s","speakers":{"laplace":"Laplace","rapi":"Rapi","shifty":"Shifty","maxwell":"Maxwell","drake":"Drake","Self":"Commander","Narration":"Narration"},"icons":{"laplace":"si_c100_00_s","rapi":"si_c010_00_s","shifty":"si_c907_00_s","maxwell":"si_c102_00_s","drake":"si_c101_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_11_05_1","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_1","text":"Boy oh boy!","jump":null,"exit":false,"enter":null,"bg":"Desert_01","bgArt":"desert_01","image":null,"bgm":"bgm_emergency","movie":null,"shown":["maxwell","laplace","drake","rapi"],"affinity":null},{"id":"d_main_11_05_2","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_2","text":"There are more Raptures here than I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_3","text":"Shifty. Contrast the distribution of the Raptures before and now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_11_05_4","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_05_4","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_5","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_05_5","text":"An increase of 321% from before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_6","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_6","text":"3 times? I knew there were a lot of these things, but this is a bit overkill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_7","text":"It would be safe to assume","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_8","text":"that they're also after the Heretic fragments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_9","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_9","text":"Curse these vile hordes.\nI will never let the fragments fall into their hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_10","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_05_10","text":"That's right, those fragments belong to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_11","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_11","text":"Well, that's not necessarily true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_12","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_05_12","text":"If you say so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_13","text":"Shifty, the closer we get to our destination...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_14","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_05_14","text":"The more dense the Raptures will become.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_15","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_05_15","text":"It will be difficult to avoid all of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_16","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_16","text":"So that means there is something there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_17","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_17","text":"Looks like we'll have to crack some skulls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_18","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_18","text":"Fun fact for you: most Commander deaths are from large-scale engagements like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_19","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_11_05_19","text":"I'll be just fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_20","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_20","text":"My my, where do you get that confidence?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_21","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_11_05_21","text":"My teammates have my back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_22","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_22","text":"That's right, Commander. I'll protect you, no matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_23","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_11_05_23","text":"I trust you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_24","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_24","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_25","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_25","text":"Hey, just what exactly is going on between you two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_26","text":"I'm a Nikke, and they are my Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_27","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_27","text":"That's not what I'm getting at.","jump":null,"exit":false,"enter":nul