m":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_35","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_35","text":"That's something to laugh about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_36","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_05_36","text":"Hahahaha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_37","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_37","text":"Cut it out, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_38","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_38","text":"Nikkes and humans are incapable of becoming comrades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_39","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_39","text":"There's no such thing as 'asking for help' when it comes to a Nikke. Our sole purpose is to protect humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_40","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_40","text":"Yet, you've received help from your Commander on multiple occasions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_41","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_41","text":"That cannot happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_42","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_42","text":"You will never be a true hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_43","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_05_43","text":"You're right, I'm no hero. Never wanted to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_44","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_44","text":"Every Nikke has to become a hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_45","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_05_45","text":"It must be this way! Only then we can reclaim the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_46","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_47","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_47","text":"I apologize for Laplace. She goes off on these tangents sometimes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_05_48","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_05_48","text":"Don't take it personally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":nu