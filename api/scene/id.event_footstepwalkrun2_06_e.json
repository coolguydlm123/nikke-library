":"elysionmechanic","key":"Locale_MainScenario:event_footstepwalkrun2_06_e_44","text":"Yes, ma'am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_06_e_45","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:event_footstepwalkrun2_06_e_45","text":"Also, I'm sorry to have to do this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_06_e_46","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:event_footstepwalkrun2_06_e_46","text":"but after this is over, I will have to erase the memories of everyone involved, including you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_06_e_47","type":"Speech","speaker":"elysionmechanic","key":"Locale_MainScenario:event_footstepwalkrun2_06_e_47","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_06_e_48","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:event_footstepwalkrun2_06_e_48","text":"It's too dangerous to have anyone else know this information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_06_e_49","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:event_footstepwalkrun2_06_e_49","text":"It could turn the Ark upside down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_06_e_50","type":"Speech","speaker":"elysionmechanic","key":"Locale_MainScenario:event_footstepwalkrun2_06_e_50","text":"Why would it do that?","ju