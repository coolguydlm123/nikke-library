{"id":"d_nikke_nayuta_05","cat":"bond","group":{"id":"char5155","label":"Nayuta"},"label":"The Monk's Request","stage":null,"prev":"d_nikke_nayuta_04","next":null,"speakers":{"nayuta_n":"Nayuta"},"icons":{"nayuta_n":"si_c9008_00_s"},"lines":[{"id":"d_nikke_nayuta_05_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_1","text":"We walk for a bit and soon spot our companions waiting in the distance.","jump":null,"exit":false,"enter":null,"bg":"RaptilionFarm","bgArt":"raptilionfarm","image":null,"bgm":"none","movie":null,"shown":["nayuta_n"],"affinity":null},{"id":"d_nikke_nayuta_05_2","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_2","text":"I thank thee for indulging my whims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_impression","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_3","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_3","text":"'Tis little enough to repay thee,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_4","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_4","text":"but hast aught thou wouldst inquire of me, Great Hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_5","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_5","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_6","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_6","text":"... So, how was your little test?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_7","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_7","text":"Do I seem trustworthy to you now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_8","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_8","text":"Hahaha. Verily, thou art a man of great valor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_9","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_9","text":"My paltry stratagem could not beguile thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_10","text":"... You didn't even try to hide it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_11","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_11","text":"Aye, I would fain know the manner of person thou art.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_12","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_12","text":"And verily, thy answers to my queries","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_13","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_13","text":"surpass all that I did imagine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_14","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_14","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_15","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_15","text":"Forsooth, to behold is to believe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_16","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_16","text":"... Whereupon,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_17","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_17","text":"in turn, I shall ask thee once more:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_18","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_18","text":"What dost thou behold of this humble one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_halo","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_19","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_20","text":"To be honest... I still don't really know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_21","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_21","text":"Haha. Then shalt thou, in time, come to know this humble one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_22","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_22","text":"Verily, this matter hath forged a bond betwixt thee and me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_23","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_23","text":"... All right, let's meet Leviathan and Ziz first, and then figure out what to do next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_24","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_24","text":"That is indeed a most excellent notion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_25","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_05_25","text":"Nayuta begins walking ahead toward the group.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_26","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_26","text":"... Great Hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_05_27","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_05_27","text":"In this brief discourse of ours,","jump":null,"exit":false,"enter":null,"bg":null,"b