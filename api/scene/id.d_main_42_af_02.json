ity":null},{"id":"d_main_42_af_02_7","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_7","text":"I'm going anyway. If I can save even just one more person, it'll be worth it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_8","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_42_af_02_8","text":"B-but...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_9","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_42_af_02_9","text":"If I get dragged into this... I mean... I already escaped the Rehabilitation Center!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_10","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_10","text":"Don't run away, Liveryn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_11","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_11","text":"What's done is done. If you run now, it'll only make things worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_12","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_12","text":"Avoiding a problem won't solve anything. You need to face it, and then think about what to do next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_13","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_42_af_02_13","text":"If I do that... th-they'll do more than lock me up this time...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_14","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_14","text":"Then take your punishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_15","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_42_af_02_15","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_16","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_16","text":"If you've committed a crime, you must accept the punishment, reflect, and improve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_17","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_42_af_02_17","text":"I didn't do anything wrong, though. It was Sixo. She threatened me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_18","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_18","text":"Think of how many people have been harmed because of your selfishness,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_19","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_42_af_02_19","text":"how many have suffered because you were only looking out for yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_02_20","type":"Speech","speaker":"l