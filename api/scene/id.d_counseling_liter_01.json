{"id":"d_counseling_liter_01","cat":"counsel","group":{"id":"char5011","label":"Liter"},"label":"Advising Liter: 01","stage":null,"prev":null,"next":"d_counseling_liter_02","speakers":{"liter":"Liter"},"icons":{"liter":"si_c082_00_s"},"lines":[{"id":"d_counseling_liter_01_1","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_1","text":"Young Nikkes these days don't have any manners.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["liter"],"affinity":"_0"},{"id":"d_counseling_liter_01_2","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_2","text":"When I give them advice as their senior, they either just yawn or scratch their heads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_01_3","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_3","text":"Hey, Greenhorn. Do you think my advice is useless, too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_01_4","text":"Don't you remember what it's like to be young?","jump":"d_counseling_liter_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_liter_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_01_5","text":"Advice is the greatest gift that the old can give the young.","jump":"d_counseling_liter_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_liter_01_6","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_01_7","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_7","text":"I used to think old folks didn't know anything, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_01_8","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_8","text":"Mmm... I see. I guess nothing's really changed.","jump":"d_counseling_liter_01_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_01_9","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_9","text":"That's exactly what I'm talking about!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_01_10","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_01_10","text":"... But, seeing how much they hate it, that may indicate that something's wrong with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_01_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_liter_01_11","text":"I have a discussion with Liter about giving advice.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}