{"id":"d_ex_police_02","cat":"outpost","group":{"id":"outpost10201","label":"Police Station"},"label":"Conditions of Villainy","stage":null,"prev":"d_ex_police_01","next":"d_ex_police_03","speakers":{"drake":"Drake","miranda":"Miranda","poli":"Poli"},"icons":{"drake":"si_c101_00_s","miranda":"si_c032_00_s","poli":"si_c030_00_s"},"notes":["Unlock: Poli · Miranda · Drake","Featuring Drake · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_police_02_1","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_1","text":"Throw me in the clink already!","jump":null,"exit":false,"enter":null,"bg":"Police","bgArt":"police","image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["drake","miranda","poli"],"affinity":null},{"id":"d_ex_police_02_2","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_02_2","text":"No! We can't just lock someone up for no reason!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_3","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_02_3","text":"Come back when you've done something wrong!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_4","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_4","text":"Get that through that thick skull of yours and get out. We're busy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_5","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_5","text":"Or would you rather pay a fine for obstructing the law?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_6","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_6","text":"What's the matter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_7","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_7","text":"Oh, hi Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_8","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_8","text":"We're completely swamped right now, and this weirdo keeps saying she wants to go to jail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_9","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_9","text":"*Grrrr*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_10","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_10","text":"What are you doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_11","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_11","text":"Since you're here, why don't you hear what I have to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_12","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_12","text":"Sure.","jump":"d_ex_police_02_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_13","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_13","text":"No thanks.","jump":"d_ex_police_02_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_14","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_14","text":"As you know, my strength is immeasurable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_15","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_15","text":"That means I will soon become the ultimate villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_16","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_16","text":"Before that, I want to experience what it's like to be imprisoned,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_17","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_17","text":"but these idiots keep saying no!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_18","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_18","text":"Help me out, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_19","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_19","text":"Got it! Villainy, here we come!","jump":"d_ex_police_02_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_20","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_20","text":"What? You've got some nerve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_21","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_21","text":"The least you can do is hear me out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_22","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_22","text":"My time of becoming the ultimate villain is nigh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_23","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_23","text":"Therefore, I should get a taste of what it's like being imprisoned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_24","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_24","text":"However, these idiots are in the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_25","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_25","text":"They're petrified at the thought of me becoming a villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_26","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_26","text":"You've gotta help me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_27","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_27","text":"Got it, you can count on me.","jump":"d_ex_police_02_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_28","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_28","text":"Sigh... would you PLEASE get out, both of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_29","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_29","text":"I'm disappointed in you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_30","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_30","text":"Indulging her in these silly fantasies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_31","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_02_31","text":"Shame on you, Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_32","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_32","text":"Can it! I don't need lip from some mongrel off her leash and a rookie cop!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_33","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_33","text":"What?! I'm not a dog! *Grrr*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_34","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_02_34","text":"And I'm no rookie, thank you very much!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_35","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_35","text":"Neither side is going to back down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_36","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_36","text":"I should step up and smooth things over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_37","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_37","text":"You blithering dolts!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_38","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_38","text":"I said get out! *Grrrr*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_39","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_39","text":"If you want to go to jail, you've got to do it right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_40","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_40","text":"What? Are you saying I need to commit an actual crime?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_41","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_41","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_42","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_42","text":"Commander, what are you saying?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_43","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_43","text":"Hmm. All right, let me hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_44","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_44","text":"Let's prank call the police station.","jump":"d_ex_police_02_46","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_45","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_45","text":"Let's hassle a random pedestrian.","jump":"d_ex_police_02_49","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_46","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_46","text":"You do realize we can hear you, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_47","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_47","text":"If I do that, they might miss a really important call!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_48","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_48","text":"I can't do that!","jump":"d_ex_police_02_51","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_49","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_49","text":"You're saying I should bully someone who's defenseless?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_50","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_50","text":"You're dumber than I thought!","jump":"d_ex_police_02_51","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_51","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_51","text":"Why are you two still here?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_52","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_52","text":"Sigh... how should we handle this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_53","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_53","text":"Poli produces a small strip of paper from inside her notebook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_54","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_54","text":"What is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_55","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_55","text":"This is a residential area I've been patrolling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_56","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_56","text":"Find this house with the red roof that's marked here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_57","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_57","text":"In the morning and afternoon, ring the doorbell and hide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_58","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_58","text":"We'll apprehend you then and take you to jail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_59","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_59","text":"A bit of ding dong ditch, eh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_60","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_60","text":"Yes, that will be your crime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_61","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_61","text":"Hahaha, this is fun! That's actually not a bad idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_62","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_62","text":"If the police are ordering me to do something bad, then it's at least worth a shot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_63","type":"Speech","speaker":"drake","key":"Locale_SuddenStory:d_ex_police_02_63","text":"All right! I'll be back soon!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_64","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_64","text":"Drake struts out of police station confidently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_65","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_65","text":"Thank goodness, she's finally out of our hair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_66","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_66","text":"Won't her ringing the bell disturb whoever's inside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_67","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_67","text":"It's fine. An old lady lives there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_68","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_68","text":"and she has to take medication.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_69","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_69","text":"Sometimes she forgets to take it, so I've been thinking about setting up some kind of alarm for her. Now we've got one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_70","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_02_70","text":"Good thinking, Poli!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_71","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_71","text":"From now on, I'm locking the doors to the police station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_72","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_02_72","text":"If Drake ever comes over, do not open the door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_73","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_02_73","text":"You got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_02_74","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_02_74","text":"It seems Drake won't ever be coming back to the police station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}