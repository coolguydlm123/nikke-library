{"id":"d_counseling_anchor_innocentmaid_06","cat":"counsel","group":{"id":"char5131","label":"Anchor: Innocent Maid"},"label":"Advising Anchor: Innocent Maid: 06","stage":null,"prev":"d_counseling_anchor_innocentmaid_05","next":"d_counseling_anchor_innocentmaid_07","speakers":{"anchor_m":"Anchor"},"icons":{"anchor_m":"si_c355_00_s"},"lines":[{"id":"d_counseling_anchor_innocentmaid_06_1","type":"Speech","speaker":"anchor_m","key":"Locale_Counseling:d_counseling_anchor_innocentmaid_06_1","text":"Mast keeps poking my belly fat when she's bored.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anchor_m"],"affinity":"_0"},{"id":"d_counseling_anchor_innocentmaid_06_2","type":"Speech","speaker":"anchor_m","key":"Locale_Counseling:d_counseling_anchor_innocentmaid_06_2","text":"She says that it's soft and squishy, and that she can't help but keep touching it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anchor_innocentmaid_06_3","type":"Speech","speaker":"anchor_m","key":"Locale_Counseling:d_counseling_anchor_innocentmaid_06_3","text":"I want her to stop, but how?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anchor_innocentmaid_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anchor_innocentmaid_06_4","text":"Touch her belly in the same way.","jump":"d_counseling_anchor_innocentmaid_06_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anchor_innocentmaid_06_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anchor_innocentmaid_06_5","text":"Stick a starfish on your belly.","jump":"d_counseling_anchor_innocentmaid_06_10","exit":false,"e