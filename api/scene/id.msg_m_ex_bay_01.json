58","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_58","text":"Apparently if you keep exposing yourself to attention,","jump":null},{"id":"m_ex_bay_01_59","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_59","text":"you're supposed to be able to","jump":null},{"id":"m_ex_bay_01_60","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_60","text":"overcome your fears to an extent.","jump":null},{"id":"m_ex_bay_01_61","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bay_01_61","text":"Okay, then how about using Bla to your advantage?","jump":null},{"id":"m_ex_bay_01_62","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_62","text":"What do you mean?","jump":null},{"id":"m_ex_bay_01_63","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bay_01_63","text":"By purposefully using facial emojis.","jump":null},{"id":"m_ex_bay_01_64","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_64","text":"Hmm...","jump":null},{"id":"m_ex_bay_01_65","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bay_01_65","text":"Maybe someday there'll come a time when it won't bother you.","jump":null},{"id":"m_ex_bay_01_66","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_66","text":"!!","jump":null},{"id":"m_ex_bay_01_67","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_67","text":"I certainly hope that happens.","jump":null},{"id":"m_ex_bay_01_68","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bay_01_68","text":"Let's give it a shot.","jump":null},{"id":"m_ex_bay_01_69","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_69","text":"Yeah...","jump":null},{"id":"m_ex_bay_01_70","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_70","text":"All right,","jump":null},{"id":"m_ex_bay_01_71","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_71","text":"let's do it!","jump":null},{"id":"m_ex_bay_01_72","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bay_01_72","text":"Sounds good. Looking forward to knowing you.","jump":null},{"id":"m_ex_bay_01_73","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_73","text":"Me too.","jump":null},{"id":"m_ex_bay_01_74","type":"Speech","speaker":"bay","key":"Locale_SuddenMessage:m_ex_bay_01_74","text":"Hehe.","jump":null}],"chat":true}