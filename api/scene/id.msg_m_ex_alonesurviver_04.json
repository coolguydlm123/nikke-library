{"id":"msg_m_ex_alonesurviver_04","cat":"messenger","group":{"id":"room_survivor","label":"Survival Expert? · Group"},"label":"1. Um...","stage":null,"prev":null,"next":null,"speakers":{"survivor":"Survival Expert?"},"icons":{},"lines":[{"id":"msg_m_ex_alonesurviver_04_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 103310112 · After Snow Mountain Rescue Team chat 3. Burly Bear!","key":null},{"id":"m_ex_alonesurviver_04_1","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_1","text":"Um...","jump":null},{"id":"m_ex_alonesurviver_04_2","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_2","text":"Survivalist...","jump":null},{"id":"m_ex_alonesurviver_04_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_3","text":"Who is this?","jump":null},{"id":"m_ex_alonesurviver_04_4","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_4","text":"It's Tove!","jump":null},{"id":"m_ex_alonesurviver_04_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_5","text":"Tove?","jump":null},{"id":"m_ex_alonesurviver_04_6","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_6","text":"Yes!","jump":null},{"id":"m_ex_alonesurviver_04_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_7","text":"What's with your username?","jump":null},{"id":"m_ex_alonesurviver_04_8","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_8","text":"Oh, well... it's just that...","jump":null},{"id":"m_ex_alonesurviver_04_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_9","text":"Is this about recreating the atmosphere again?","jump":null},{"id":"m_ex_alonesurviver_04_10","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_10","text":"No!","jump":null},{"id":"m_ex_alonesurviver_04_11","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_11","text":"I was just kinda doubting myself, and whether or not I was truly a survival expert,","jump":null},{"id":"m_ex_alonesurviver_04_12","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_12","text":"so","jump":null},{"id":"m_ex_alonesurviver_04_13","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_13","text":"I thought I'd tell you something","jump":null},{"id":"m_ex_alonesurviver_04_14","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_14","text":"that I couldn't say in my original profile.","jump":null},{"id":"m_ex_alonesurviver_04_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_15","text":"Seems like Ludmilla really got under your skin.","jump":null},{"id":"m_ex_alonesurviver_04_16","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_16","text":"!!","jump":null},{"id":"m_ex_alonesurviver_04_17","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_17","text":"How did you know?","jump":null},{"id":"m_ex_alonesurviver_04_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_18","text":"Because you seemed pretty worried back then.","jump":null},{"id":"m_ex_alonesurviver_04_19","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_19","text":"Wow...","jump":null},{"id":"m_ex_alonesurviver_04_20","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_20","text":"Sometimes,","jump":null},{"id":"m_ex_alonesurviver_04_21","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_21","text":"I think you know me even better than I do.","jump":null},{"id":"m_ex_alonesurviver_04_22","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_22","text":"I...","jump":null},{"id":"m_ex_alonesurviver_04_23","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_23","text":"I haven't responded to Ludmilla's question yet.","jump":null},{"id":"m_ex_alonesurviver_04_24","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_24","text":"Back when everything I knew was theoretical,","jump":null},{"id":"m_ex_alonesurviver_04_25","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_25","text":"I thought I could do anything as long as I studied hard enough.","jump":null},{"id":"m_ex_alonesurviver_04_26","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_26","text":"I believed deep down in my bones.","jump":null},{"id":"m_ex_alonesurviver_04_27","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_27","text":"But it turns out that I was wrong.","jump":null},{"id":"m_ex_alonesurviver_04_28","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_28","text":"Saving someone...","jump":null},{"id":"m_ex_alonesurviver_04_29","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_29","text":"Rescuing people...","jump":null},{"id":"m_ex_alonesurviver_04_30","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_30","text":"They're not easy decisions to make.","jump":null},{"id":"m_ex_alonesurviver_04_31","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_31","text":"I didn't know the first thing","jump":null},{"id":"m_ex_alonesurviver_04_32","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_32","text":"about what Unlimited was meant to do,","jump":null},{"id":"m_ex_alonesurviver_04_33","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_33","text":"or what we were doing here.","jump":null},{"id":"m_ex_alonesurviver_04_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_34","text":"I see.","jump":null},{"id":"m_ex_alonesurviver_04_35","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_35","text":"Once I realized this,","jump":null},{"id":"m_ex_alonesurviver_04_36","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_36","text":"I found it hard to respond to Ludmilla's question.","jump":null},{"id":"m_ex_alonesurviver_04_37","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_37","text":"Could someone like me really hack it out there?","jump":null},{"id":"m_ex_alonesurviver_04_38","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_38","text":"That thought ran through my mind, haunting me.","jump":null},{"id":"m_ex_alonesurviver_04_39","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_39","text":"I've begun to wonder if I could ever rescue anyone for real.","jump":null},{"id":"m_ex_alonesurviver_04_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_40","text":"But isn't this your true calling?","jump":null},{"id":"m_ex_alonesurviver_04_41","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_41","text":"It is.","jump":null},{"id":"m_ex_alonesurviver_04_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_42","text":"You've watched countless videos just to do this job, haven't you?","jump":null},{"id":"m_ex_alonesurviver_04_43","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_43","text":"That's true.","jump":null},{"id":"m_ex_alonesurviver_04_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_44","text":"And now that you've tried it, do you dislike it?","jump":null},{"id":"m_ex_alonesurviver_04_45","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_45","text":"Huh?","jump":null},{"id":"m_ex_alonesurviver_04_46","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_46","text":"N-no!","jump":null},{"id":"m_ex_alonesurviver_04_47","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_47","text":"I like it very much!","jump":null},{"id":"m_ex_alonesurviver_04_48","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_48","text":"It's just...","jump":null},{"id":"m_ex_alonesurviver_04_49","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_49","text":"I'm too clumsy.","jump":null},{"id":"m_ex_alonesurviver_04_50","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_50","text":"I'm afraid that","jump":null},{"id":"m_ex_alonesurviver_04_51","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_51","text":"I'll fail,","jump":null},{"id":"m_ex_alonesurviver_04_52","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_52","text":"and that scares me.","jump":null},{"id":"m_ex_alonesurviver_04_53","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_53","text":"Then you just have to try harder.","jump":null},{"id":"m_ex_alonesurviver_04_54","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_54","text":"Huh?","jump":null},{"id":"m_ex_alonesurviver_04_55","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_55","text":"You have to do all you can not to act clumsily in front of anyone who needs rescuing.","jump":null},{"id":"m_ex_alonesurviver_04_56","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_56","text":"...","jump":null},{"id":"m_ex_alonesurviver_04_57","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_57","text":"You still want to become a survival expert, don't you?","jump":null},{"id":"m_ex_alonesurviver_04_58","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_58","text":"I...","jump":null},{"id":"m_ex_alonesurviver_04_59","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_59","text":"Yes,","jump":null},{"id":"m_ex_alonesurviver_04_60","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_60","text":"I do.","jump":null},{"id":"m_ex_alonesurviver_04_61","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_61","text":"I want to be...","jump":null},{"id":"m_ex_alonesurviver_04_62","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_62","text":"a true professional.","jump":null},{"id":"m_ex_alonesurviver_04_63","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_63","text":"Then what else is holding you back?","jump":null},{"id":"m_ex_alonesurviver_04_64","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_64","text":"...","jump":null},{"id":"m_ex_alonesurviver_04_65","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_65","text":"No,","jump":null},{"id":"m_ex_alonesurviver_04_66","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_66","text":"nothing.","jump":null},{"id":"m_ex_alonesurviver_04_67","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_67","text":"Nothing at all!","jump":null},{"id":"m_ex_alonesurviver_04_68","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_68","text":"Thank you so much, Survivalist!","jump":null},{"id":"m_ex_alonesurviver_04_69","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_69","text":"I'll make you proud and become a true professional, promise!","jump":null},{"id":"m_ex_alonesurviver_04_70","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_70","text":"Good. You can do this.","jump":null},{"id":"m_ex_alonesurviver_04_71","type":"Speech","speaker":"survivor","key":"Locale_SuddenMessage:m_ex_alonesurviver_04_71","text":"Yes, I can!","jump":null},{"id":"m_ex_alonesurviver_04_72","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_04_72","text":"Survival Expert? left the group chat.","jump":null}],"chat":true}