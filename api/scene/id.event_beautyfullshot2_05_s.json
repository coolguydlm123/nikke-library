_5","text":"... Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_6","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_6","text":"Oh, I'm grand! I've been grilling for three solid hours, so I'm happy as can be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_7","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_7","text":"Let's keep it going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_8","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_8","text":"Everyone's eating more than I thought they would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_9","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_9","text":"You can say that again! Everyone's slamming it down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_10","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_10","text":"How come you're not eating, Anis? I haven't seen you take a single bite yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_11","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_11","text":"Oh, um... I'm fine...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_12","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_12","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_13","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_13","text":"Ah, I get it. You've been around the smell of grilling meat for too long, and you lost your appetite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_14","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_14","text":"No problem, I'll grill you some meat using my secret recipe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_15","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_15","text":"N-no, it's okay. Thanks. Really, I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_16","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_16","text":"Rapi, who is this person?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_17","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_17","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_18","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_18","text":"She doesn't eat meat or drink? This isn't the Anis that I know!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_19","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_19","text":"Let's just move on. This is a bit of a sore subject.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_20","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_20","text":"What do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["sakura_s","rosanna_s","mary_s"],"affinity":null},{"id":"event_beautyfullshot2_05_s_21","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_21","text":"It's delicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_22","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_22","text":"Eat up. You're used to having healthy foods prepared for you, so this is a rare opportunity for you to pig out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_23","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_23","text":"What are you so proud of? You're not the one who cooked this stuff, the Counters did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_24","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_24","text":"Hedonia is the one who financially backed this venture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_25","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_25","text":"They even provided us with medical supplies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_26","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_26","text":"Not to mention the plethora of other ways they've helped us out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_27","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_27","text":"What? I thought Mustang was the one who handled all the preparations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_28","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_28","text":"He did, but I figured a little more luxury wouldn't hurt anyone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_29","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_29","text":"so I decided to go the extra mile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_30","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_31","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_31","text":"Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_32","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_32","text":"You keep saying how you didn't want to come, yet you've been awfully busy behind the scenes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_33","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_33","text":"Not to mention the body for swimming and that surfboard you lugged along. Heck, you might have been more excited for the beach than anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_34","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_34","text":"All that bellyaching about how this adventure was undignified, and yet you're obsessed with tracking down these precious pink dolphins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_35","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_05_s_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_05_s_36","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beau