{"id":"d_counseling_snowcrane_08","cat":"counsel","group":{"id":"char5168","label":"Snow Crane"},"label":"Advising Snow Crane: 08","stage":null,"prev":"d_counseling_snowcrane_07","next":"d_counseling_snowcrane_09","speakers":{"snowcrane":"Snow Crane"},"icons":{"snowcrane":"si_c620_00_s"},"lines":[{"id":"d_counseling_snowcrane_08_1","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_1","text":"Something strange happened yesterday.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["snowcrane"],"affinity":"_0"},{"id":"d_counseling_snowcrane_08_2","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_2","text":"I got a call from an unknown number, and they told me I had a son I didn't even know about and that he'd been hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_3","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_3","text":"When they mentioned a son, I actually thought of you, so I kept listening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_4","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_4","text":"Then they asked me to transfer some money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_5","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_5","text":"So I asked them how to do that, and they just hung up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_08_6","text":"Next time, just say you'll meet them in front of a police station with the money.","jump":"d_counseling_snowcrane_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_snowcrane_08_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_08_7","text":"Please don't take calls from unknown numbers.","jump":"d_counseling_snowcrane_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_snowcrane_08_8","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_8","text":"Oh my, that's such a lovely idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_9","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_9","text":"That way, I can find my son right away,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_10","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_10","text":"and I can just ask the officers how to transfer the money.","jump":"d_counseling_snowcrane_08_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_11","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_11","text":"Hmm... but what if it really is an emergency?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_12","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_12","text":"What if you are really hurt, and I miss it? That'd be awful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_13","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_08_13","text":"We can't be sure, so maybe we should just answer it, just in case...?","jump":"d_counseling_snowcrane_08_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_08_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_08_14","text":"I teach Snow Crane how to handle spam calls.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}