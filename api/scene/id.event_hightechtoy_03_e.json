{"id":"event_hightechtoy_03_e","cat":"event","group":{"id":"ev40002","label":"Hightech Toy"},"label":"What We Need is a Hero: B","stage":null,"prev":"event_hightechtoy_03_s","next":"event_hightechtoy_intermission_01","speakers":{"massproduction01":"Mass-produced Nikke","laplace":"Laplace","maxwell_w":"Maxwell"},"icons":{"massproduction01":"si_c253_00_s","laplace":"si_c100_00_s","maxwell_w":"si_c102_01_s"},"lines":[{"id":"event_hightechtoy_03_e_1","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_1","text":"Here...","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":"bgm_mystery","movie":null,"shown":["massproduction01","maxwell_w","laplace"],"affinity":null},{"id":"event_hightechtoy_03_e_2","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_2","text":"Sorry, we took so long! We came as soon as we got your distress signal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_3","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_3","text":"Distress signal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_4","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_4","text":"What? How am I... Was I attacked by a Rapture?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_5","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_5","text":"I fixed you up. I had accounted for this, and brought some spare parts with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_6","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_6","text":"You what? But how can a Nikke repair another Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_7","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_7","text":"Wait, are you Matis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_8","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_8","text":"That's right. The heroes are here to save the day!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_9","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_9","text":"Finally... after all those distress signals, they actually sent you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_10","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_10","text":"You really can do anything...even repair other Nikkes, hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_11","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_11","text":"Aren't you happy that we're here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_12","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_12","text":"I'm just jealous. It would have been good if we could do what you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_13","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_13","text":"I know you're jealous, but aren't you forgetting something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_14","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_14","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_15","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_15","text":"You saved my life. I'm incredibly grateful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_16","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_16","text":"Sure, I'll take the greeting well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_17","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_18","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_18","text":"Now tell me what happened here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_19","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_19","text":"We were on a mission to locate artifacts when all of a sudden, a tyrant-class rapture appeared. Everyone...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_03_e_20","text":"How could a tyrant-class Rapture sneak up on you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_21","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_21","text":"Did you not have a radar? Isn't that standard issue for artifact collection teams?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_22","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_22","text":"It never showed up on the radar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_23","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_23","text":"By the time we heard a loud thump and turned around, it was too late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_24","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_24","text":"The equipment we're given is always faulty or out-of-date.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_25","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_25","text":"If we'd had a proper radar with us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_26","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_26","text":"So the radar is to blame?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_27","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_27","text":"May I see it for a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_28","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_03_e_28","text":"The mass-produced Nikke hands Maxwell the radar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_29","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_29","text":"This may be an entry-level model, but it's nothing to sneeze at. Let's see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_30","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_03_e_30","text":"Maxwell tinkers with the device, glancing at it from all angles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_31","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_31","text":"This radar is perfectly functional. There's nothing wrong with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_32","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_32","text":"Then how did that Rapture...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_33","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_33","text":"It must be a Rapture that's invisible to radar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_34","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_34","text":"What?! That doesn't make any sense!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_35","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_35","text":"You of all people should know that on the surface, things seldom make sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_36","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_36","text":"That must be why Nikkes from other companies have gone missing as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_37","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_37","text":"Mass-produced Nikkes are hardly fit to withstand a tyrant-class Rapture attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_38","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_03_e_38","text":"Are you the only survivor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_39","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_39","text":"I don't know what happened to the other squad members.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_40","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_40","text":"As soon as I secured brains of my squad members, I ran and hid there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_41","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_41","text":"What about the operation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_42","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_42","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_43","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_43","text":"Were you not supposed to gather artifacts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_44","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_44","text":"How could I grab those when I was running for my life?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_45","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_45","text":"So, what you're saying is that you abandoned the mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_46","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_46","text":"It's not that I abandoned...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_47","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_47","text":"Inexcusable! Even a mass-produced Nikke such as yourself should know better than that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_48","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_48","text":"You can't become a hero that way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_49","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_49","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_50","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_50","text":"If you fail to follow through in your mission,\nhumans will lose trust in Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_51","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_51","text":"We can't have that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_52","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_52","text":"Nikkes are supposed to be a beacon of hope for humans. That's the entire reason we exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_53","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_53","text":"All right, then tell me. How do I become a hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_54","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_54","text":"Do you have the faintest idea what kind of equipment we're issued?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_55","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_55","text":"No, you don't. You're Syuen's favorite. You don't care about any of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_56","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_56","text":"You turn a blind eye to how we're treated.","jump":null,"exit":false,"enter":null,"bg":null,"