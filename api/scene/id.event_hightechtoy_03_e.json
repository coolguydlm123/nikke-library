htoy_03_e_63","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_03_e_63","text":"The mass-produced Nikke takes a rush at Laplace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_64","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_64","text":"Whoa, steady on now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_65","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_03_e_65","text":"Why all the animosity? We just saved you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_66","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_03_e_66","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_67","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_03_e_67","text":"The mass-produced Nikke backs off, still breathing heavily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_68","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_03_e_68","text":"You cut it out as well, Laplace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_03_e_69","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_03_e_69","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":nul