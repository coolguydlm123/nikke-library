nity":null},{"id":"d_nikke_guillotine_03_20","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_20","text":"Is that so? That's great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_21","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_22","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_22","text":"The more I observe you, the more I think you are a good person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_23","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_23","text":"It's a shame you're heading back to an organization as insignificant as The Big O.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_24","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_24","text":"Ever thought about betraying The Big O and joining The Association instead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_03_25","text":"The Association?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_26","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_26","text":"It's a secret organization that Ingrid and I are a part of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_27","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_27","text":"We have many other colleagues, but I can't give you their names.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_28","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_28","text":"Our goal is to cast off the shackles of The Big O and bring them down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_29","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_03_29","text":"So you're anarchists?","jump":"d_nikke_guillotine_03_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_30","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_03_30","text":"So Ingrid is a member as well?","jump":"d_nikke_guillotine_03_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_31","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_31","text":"Not necessarily. Our goal is to establish a new government after overthrowing The Big O.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_32","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_32","text":"All The Big O does is to repress the people and involve more serious class polarization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_33","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_33","text":"But The Association is different. It's...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_34","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_34","text":"I'm sorry, but that's all I can say for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_35","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_35","text":"Perhaps I'll tell you more if you ever decide to join The Association.","jump":"d_nikke_guillotine_03_42","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_36","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_36","text":"Yes, Ingrid serves as the president of the interim association.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_37","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_37","text":"How should I put this... you could say she \"inherited\" her position.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_38","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_03_38","text":"So in other words, you wanted her to be there, and then she is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_39","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_39","text":"Yeesh, you don't have to put it like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_40","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_40","text":"I just make sure the right people end up where they should be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_41","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_41","text":"Think of it that way. I'm sure I could find something for you here. How about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_42","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guillotine_03_42","text":"I'm afraid I'll have to decline.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_43","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_43","text":"That's too bad.","jump":"d_nikke_guillotine_03_63","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_44","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_guillotine_03_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guillotine_03_45","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_