enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_14","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_02af_04_14","text":"I don't think that's a good idea.","jump":"d_main_02af_04_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02af_04_15","text":"Think about it. The needs of the many outweigh the needs of the few!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02af_04_16","text":"Don't you think so? Hmm? Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_17","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_02af_04_17","text":"...","jump":"d_main_02af_04_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_18","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_02af_04_18","text":"I don't think so.","jump":"d_main_02af_04_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_04_19","text":"It won't be good for any of us if you're pampered too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_02af_04_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02af_04_20","text":"Ah, there you are.","jump":null,"exit":false,"enter":null,"bg":null,"