":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02af_04_36","text":"Really? I turned off my olfactory sensor, so I didn't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02af_04_37","text":"Wait, that means we're the only ones who are dirty! This is so embarrassing...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_38","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02af_04_38","text":"You can wash up in here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02af_04_39","text":"Neon, you go first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02af_04_40","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_04_41","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_04_41","text":"Commander, please wait outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_05_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_1","text":"How long can we survive in such a desolate place?","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":"ambient_cityforest_1","movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_02af_05_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_05_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_3","text":"Going back to what I wanted to say earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_05_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_4","text":"I'd like to make it clear that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_weare","movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_05_5","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_5","text":"we Nikkes are not humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_05_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_6","text":"We are weapons. Formidable and unkillable weapons meant for dispatching mankind's sworn enemy, the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_05_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_7","text":"It's common practice for a Nikke to come back with a new appearance after being severely damaged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_05_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02af_05_8","text":"So you can wipe that look off your face.","jump":null,"exit":false,"enter":null,"b