{"id":"d_main_16_06","cat":"main","group":{"id":"ch16","label":"Chapter 16 · Brand"},"label":"Outlaws","stage":"16-12 STAGE · End","prev":"d_main_16_05_e","next":"d_main_16_07","speakers":{"rapi":"Rapi","Self":"Commander","anis":"Anis","neon":"Neon"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_16_06_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_1","text":"All clear.","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":"bgm_secondhand","movie":null,"shown":["rapi","anis","neon"],"affinity":null},{"id":"d_main_16_06_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_2","text":"We've eliminated all the units hiding beneath the ice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_3","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_06_3","text":"Good job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_5","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_16_06_5","text":"Rapi stands beside me, silent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_6","text":"... Commander, just forget about what Crow said earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_7","text":"Outlaws are always like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_8","text":"They've been dealt a bad hand from birth,\nso they want to drag everyone else down with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_9","text":"They take advantage of other people's weaknesses every chance they get.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_06_10","text":"Both physically and verbally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_11","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_06_11","text":"But Crow has a point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_12","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_06_12","text":"When we're up on the surface, all I ever do is get rescued by you guys constantly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_13","text":"That's because this place is our battlefield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_14","text":"Your battlefield is down below.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_15","text":"Down in the Ark. That den of thieves where defamation runs rampant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_16","text":"I know how hard you try and protect us down there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_17","text":"Not only that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_16_06_18","text":"Things will go back to the way they were.","jump":null,"exit":false,"enter":null,"bg":"IceLand_03","bgArt":"iceland_03","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_19","text":"Huh? What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_20","text":"You got a time machine or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_16_06_21","text":"No, but I'll do everything I can to make sure you're all treated like human beings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_22","text":"... You even said that.\nI don't think you can care about us any more than that.","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":null,"movie":null,"shown":["rapi","neon"],"affinity":null},{"id":"d_main_16_06_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_23","text":"So don't let what that outlaw says get you down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_24","text":"Stay strong. Be true to yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_25","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_16_06_25","text":"That's right, Master. I'll follow you wherever you go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_26","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_06_26","text":"Thank you, all of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_06_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_06_27","text":"We're only saying what's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]