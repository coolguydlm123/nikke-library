_NikkeEpisode:d_nikke_ce009_01_05_26","text":"Think there's treasure in there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_05_27","type":"Speech","speaker":"phantom","key":"Locale_NikkeEpisode:d_nikke_ce009_01_05_27","text":"As a phantom thief myself, I understand your curiosity about hidden places.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_05_28","type":"Speech","speaker":"phantom","key":"Locale_NikkeEpisode:d_nikke_ce009_01_05_28","text":"But they do say curiosity killed the cat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_05_29","type":"Speech","speaker":"phantom","key":"Locale_NikkeEpisode:d_nikke_ce009_01_05_29","text":"It would be wise not to set foot in there, even in jest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_05_30","type":"Speech","speaker":"ce009_01_p","key":"Locale_NikkeEpisode:d_nikke_ce009_01_05_30","text":"Morgana,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_05_31","type":"Speech","speaker":"ce009_01_p","key":"Locale_NikkeEpisode:d_nikke_ce009_01_05_31","text":"you're putting Phantom on the spot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce009_01_05_32","type":"Speech","speaker":"ce009_01_p","key":"Locale_NikkeEpisode:d_nikke_ce009_01_05_32","text":"Let's just stick to the places she's willing to show us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown