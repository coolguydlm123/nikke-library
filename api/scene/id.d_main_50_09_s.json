,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_09_s_41","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_09_s_41","text":"The important thing is that you think it over and come to a decision yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_09_s_42","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_09_s_42","text":"So think hard on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_09_s_43","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_50_09_s_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_09_s_44","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_50_09_s_44","text":"...! The Annihilios are changing direction!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_09_s_45","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_50_09_s_45","text":"What...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_09_s_46","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_50_09_s_46","text":"Agh! They're coming this way! It looks like they're try to take us down first!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_09_s_47","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_50_09_s_47","text":"Perfect! It'll be much easier to take them head-