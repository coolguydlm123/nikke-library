{"id":"d_nikke_hongryeon_03","cat":"bond","group":{"id":"char5041","label":"Scarlet"},"label":"Earthly Pursuits","stage":null,"prev":"d_nikke_hongryeon_02","next":"d_nikke_hongryeon_04","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_nikke_hongryeon_03_1","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_1","text":"Steady now... Lift it up like how thou would scoop something up.","jump":null,"exit":false,"enter":null,"bg":"HotSpring","bgArt":"hotspring","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_03_2","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_2","text":"Yes, that's it. Do not be shaken by any sudden noises it may let out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_3","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_3","text":"Oh, it seems to hast calmed down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_4","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_4","text":"Now, let it frolic around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_5","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_5","text":"*Croak*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_6","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_6","text":"The tiny frog on your palm starts to croak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_7","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_7","text":"What dost thou think? Is it not adorable?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_8","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_8","text":"... Yes, it is.","jump":"d_nikke_hongryeon_03_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_9","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_9","text":"... It's rather scary.","jump":"d_nikke_hongryeon_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_10","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_10","text":"Naught pleases me more than coming hither.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_11","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_11","text":"To see this little creature jump to and fro fills me with joy.","jump":"d_nikke_hongryeon_03_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_12","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_12","text":"Oh my, what a craven man thou are!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_13","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_13","text":"What harm could such an insignificant creature doth thee? Thou must learn to gird thy loins, my good Lord.","jump":"d_nikke_hongryeon_03_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_14","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_14","text":"*Jump*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_15","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_15","text":"The frog leaps from your palm and lands on your arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_16","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_16","text":"You feel a slight shift in the weight of its soft and moist body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_17","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_17","text":"It seems to hast taken a liking to thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_18","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_18","text":"... After spreading the cow manure on the flat ground,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_19","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_19","text":"Scarlet grabs your hand and takes you to a nearby creek.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_20","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_20","text":"You give yourself a quick rinse,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_21","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_21","text":"then relax by the creek bed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_22","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_22","text":"Do not avert thine eyes. Once thou return underground, thou shall only see such precious life on a screen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_23","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_23","text":"I suppose the same could be said of that up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_24","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_24","text":"*Jump*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_25","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_25","text":"*Splash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_26","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_26","text":"The frog resting on your arm takes another leap, throwing itself into the creek.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_27","text":"Oh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_28","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_28","text":"Seems like it is done playing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_29","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_29","text":"Now that we are well-rested, let us make our way back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_30","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_30","text":"Oh, yes. 'Ere that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_31","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_31","text":"With a flick of her hand, Scarlet tosses something to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_32","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_32","text":"It is an apple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_33","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_33","text":"Eat it. One must eat well after such physical activity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_34","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_34","text":"Be sure to wash thy hands first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_35","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_35","text":"That was a poisonous frog. Should'st thou ingest any of it or allow it to get into thy eyes, thou shall be in a world of hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_36","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_37","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_37","text":"After washing your hands, you take a bite of the apple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_38","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_38","text":"As you savor the taste, you find that it is nothing like you have ever tasted before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_39","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_39","text":"Thou hast worked hard today, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_40","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_40","text":"So how about thou getting some rest first?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_41","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_41","text":"Though it might not seem like much yonder, there should be enough room for thou to lie down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_42","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_42","text":"Have you set up camp?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_43","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_43","text":"Not necessarily an encampment, it is more like a place to lay mine head whenever I'm in the vicinity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_44","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_44","text":"I suppose thou could consider it a kind of... temporary abode? Simple accommodation? Something of that sort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_45","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_45","text":"In any case, get some rest now. I hast things which require mine attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_46","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_46","text":"With a shovel, Scarlet begins to rummage through the cow manure the both of you spread out earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_47","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_47","text":"Upon closer inspection, thou discover a mixture of sawdust and bits of vegetation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_48","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_48","text":"With the shovel, Scarlet incorporates them more evenly before covering the mixture with straw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_49","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_49","text":"What are you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_50","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_50","text":"Should'st the fermentation hie smoothly, they shall become compost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_51","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_51","text":"After all, one can never farm without it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_52","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_52","text":"... Farming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_53","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_53","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_54","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_54","text":"... Your eyes survey the vicinity once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_55","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_55","text":"Well-prepared and flat ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_56","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_56","text":"Mounds of dirt spaced out evenly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_57","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_57","text":"A small seedling emerges through the soil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_58","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_58","text":"... You're actually farming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_59","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_59","text":"Yes, hast thou merely just noticed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_60","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_60","text":"Nevertheless, I suppose actual farming is far from what thou see on a screen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_61","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_61","text":"Be that as it may, this is but a bawbling dalliance of mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_62","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_62","text":"Aren't Pilgrims supposed to be drifters?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_63","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_63","text":"Thou speak the truth, for I never remain in one place for long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_64","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_64","text":"I am very much still a drifter on this surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_65","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_65","text":"Wherever mine feet endues me, I build small vegetable gardens like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_66","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_66","text":"With that, Scarlet grabs the hoe and starts tilling the soil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_67","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_67","text":"Farming requires diligence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_68","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_68","text":"I am sure thou understand how I am unable to linger in a place for too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_69","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_69","text":"Despite my efforts, I know not when shall I return to this place once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_70","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_70","text":"But why...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_71","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_72","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_72","text":"Silently, Scarlet swings her hoe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_73","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_73","text":"*Thwack thwack* *Thump* *Thwack*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_74","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_74","text":"A series of sounds — the soil being tilled and the hoe hitting the stones — reverberates across the area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_75","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_75","text":"*Thwack thump* *Thwack thump*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_76","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_76","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_77","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_77","text":"Mine actions are only so to prove one thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_78","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_78","text":"Which is...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_79","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_79","text":"These croplands I hast built are to commemorate","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_80","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_80","text":"the places on the surface that mine comrades and I hast reclaimed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_81","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_81","text":"Wha— I hast been through too much, and mine remembrance hath begun to fade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_82","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_82","text":"Rapunzel once mentioned several places that we reclaimed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_83","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_83","text":"Places...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_84","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_84","text":"*Thwack*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_85","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_85","text":"where we risked our lives to reclaim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_86","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_86","text":"*Thwack*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_87","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_87","text":"I long for 'em to be brimming with life once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_88","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_88","text":"*Thwack*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_89","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_89","text":"Therewithal...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_90","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_90","text":"*Thwack*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_91","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_91","text":"I must prove that our efforts were not in vain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_92","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_92","text":"*Thump*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_93","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_93","text":"Human or othergates,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_94","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_94","text":"I yearn to see 'em be filled with life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_95","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_95","text":"With that in mind, Scarlet stops and stares off into the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_96","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_97","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_97","text":"Do thou still recall the things we hast seen on the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_shapeofhope","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_98","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_98","text":"Cows, frogs, creeks, croplands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_99","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_99","text":"Come, tell me thy thoughts on 'em.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_100","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_100","text":"They're beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_101","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_101","text":"So it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_102","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_102","text":"... A land bereft of humankind is truly the most beautiful sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_103","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_103","text":"Yet, life goes on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_104","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_104","text":"Even with the absence of humanity, life still goes on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_105","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_105","text":"Even so, the Raptures hast not laid waste to this planet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_106","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_106","text":"They never laid a finger on the cows, the creeks, or the croplands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_107","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_107","text":"All that the Raptures seek to destroy are only humans, yet it is through humanity's hands that all things created.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_108","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_108","text":"In doing so, they hath created a world more beautiful than anything else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_109","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_109","text":"Allow me to ask thou something, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_110","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_110","text":"Dost thou reckon that humans are beneficial to this world?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_111","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_111","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_112","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_112","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_113","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_113","text":"Tsk, what a dreadful Commander thou are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_114","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_114","text":"Thou should hast bellowed to the heavens that humans are the rightful rulers of this world!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_115","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_115","text":"If this was made known to anyone from the Central Government, they would hast shot me on sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_116","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_116","text":"Scarlet, you can't be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_117","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_117","text":"Ah! Fret not, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_118","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_118","text":"Mine will is as steadfast as mine blade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_119","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_119","text":"I shall eradicate the raptures on behalf of humanity and reclaim this land.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_120","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_120","text":"This shall remain forever true, as mine will is unbending.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_121","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_121","text":"It's just that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_122","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_122","text":"these flights of fancy come to me as I tend to mine croplands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_123","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_123","text":"The wind blows softly against mine brow, as I savor the fruits I hast sown in the sun while soaking mine feet in the creek.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_124","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_124","text":"Well, just regard me as a mere skamelar, a blinking fool whom hath nothing but time, or rather all too much of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_125","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_125","text":"... Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_126","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_126","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_127","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_127","text":"I seem to hast gone on for far too long today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_128","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_128","text":"I am as sober as a judge and yet I spew out this drivel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_129","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_129","text":"I immensely enjoy spending time with thou, my Lord, so much so that my liver feels intoxicated without imbibing a drop of spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_130","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_130","text":"Get some rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_03_131","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_03_131","text":"Once we are done hither, we shall dine on roasted corn tonight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}