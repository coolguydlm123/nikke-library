nce and for all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_19","type":"Speech","speaker":"quiryshadow","key":"Locale_NikkeEpisode:treasurestory_miranda_01_19","text":"All right. I'll summon my courage!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_20","type":"Speech","speaker":"novelshadow","key":"Locale_NikkeEpisode:treasurestory_miranda_01_20","text":"Let's tie up some loose ends!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_21","type":"Speech","speaker":"polishadow","key":"Locale_NikkeEpisode:treasurestory_miranda_01_21","text":"All right then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_22","type":"Speech","speaker":"polishadow","key":"Locale_NikkeEpisode:treasurestory_miranda_01_22","text":"We start tomorrow, just as we planned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_23","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_23","text":"On a bright and sunny day, one where it seems highly unlikely for any incidents to occur,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_24","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_24","text":"Poli and Miranda come to the Commander's Room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["poli","miranda"],"affinity":null},{"id":"treasurestory_miranda_01_25","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_25","text":"Hello there, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_girlstalk","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_26","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:treasurestory_miranda_01_26","text":"Good day!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_27","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_27","text":"Hello. What's going on?","jump":"treasurestory_miranda_01_32","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_28","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_28","text":"Something's happened, hasn't it?","jump":"treasurestory_miranda_01_29","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_29","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_29","text":"How did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_30","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_30","text":"Because you both came together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_31","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_31","text":"Okay, fair point. However, this isn't any run-of-the-mill case.","jump":"treasurestory_miranda_01_32","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_32","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_32","text":"Miranda's been assigned a special mission. Would you be able to lend her some support?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_33","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_33","text":"A special mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_34","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:treasurestory_miranda_01_34","text":"Indeed! As a proud member of the A.C.P.U.,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_35","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:treasurestory_miranda_01_35","text":"I've finally been tasked with something other than directing traffic! This time, I'm in charge of a criminal investigation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_36","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_36","text":"Congratulations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_37","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:treasurestory_miranda_01_37","text":"Thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_38","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_38","text":"I have to admit though, leaving this entirely to Miranda makes me a bit nervous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_39","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_39","text":"Could you possibly keep an eye on her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_40","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_40","text":"Sure, I'll help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_41","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_41","text":"I really appreciate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_42","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:treasurestory_miranda_01_42","text":"Yeah, thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_43","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_43","text":"Now that that's settled...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_44","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_44","text":"*Shrrrk*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_45","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_miranda_01_45","text":"Poli abruptly produces a large sheet of paper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_46","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_46","text":"Let me brief you both on the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_a","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_47","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_47","text":"The suspect is a rather notorious figure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_48","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_48","text":"Dozens of different charges have been pinned on her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_49","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:treasurestory_miranda_01_49","text":"D-did you say \"dozens\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_50","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_miranda_01_50","text":"And those are only the ones we know of. There could be a lot more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_miranda_01_51","typ