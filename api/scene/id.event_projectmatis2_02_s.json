{"id":"event_projectmatis2_02_s","cat":"event","group":{"id":"ev40116","label":"PROJECT MATIS · Part 1"},"label":"Unease: A","stage":null,"prev":"event_projectmatis2_01_e","next":"event_projectmatis2_02_e","speakers":{"maxwell_h":"Maxwell","manresearcher":"Male Researcher","laplace_h":"Laplace","nervousgirl":"Nervous Girl","ribbonwoman":"Woman with Ribbon","grumblingwoman":"Grumbling Woman","strugglingwoman":"Struggling Woman","supergreathero":"Ultra Hero"},"icons":{"maxwell_h":"si_c105_01_s","manresearcher":"si_c999_00_s","laplace_h":"si_c9029_00_s","nervousgirl":"si_c999_00_s","ribbonwoman":"si_c999_00_s","grumblingwoman":"si_c999_00_s","strugglingwoman":"si_c999_00_s","supergreathero":"si_c999_00_s"},"lines":[{"id":"event_projectmatis2_02_s_1","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_1","text":"Welcome, everyone, and thank you for joining the hero Nikke project.","jump":null,"exit":false,"enter":null,"bg":"SimulationRoom","bgArt":"simulationroom","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["laplace_h","maxwell_h"],"affinity":null},{"id":"event_projectmatis2_02_s_2","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_2","text":"I'm Maxwell, the lead researcher on Project Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_3","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_3","text":"As I told you before, the goal of this project is not to create ordinary Nikkes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_4","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_4","text":"but to create hero Nikkes with power beyond anything anyone's ever seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_5","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_5","text":"Because of that, we expect the process to involve considerable pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_6","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_6","text":"Worst case, there is a distinct possibility that some of you could lose your lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_7","text":"Silence falls over the lab.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_8","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_8","text":"Of course, the Missilis research team will do all we can to prevent any casualties by utilizing the Ark's most advanced technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_9","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_9","text":"However, before we proceed with the main experiment,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_10","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_10","text":"you'll be tested to see whether you have the physical and mental fortitude to endure intense pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_11","text":"Maxwell fixes her gaze on Laplace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_12","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_12","text":"Anyone who cannot endure will be automatically removed from the project.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_13","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_13","text":"Only those who make it through the entire experiment will become Nikkes and receive a hero prototype body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_14","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_14","text":"They will also receive the compensation that was previously promised.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_15","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_15","text":"Er, of course...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_16","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_16","text":"Having made it this far guarantees you some compensation, so don't worry about that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_17","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_17","text":"We're excited to see how you all perform!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_18","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis2_02_s_18","text":"May you make it to the end and become the Ark's new heroes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_19","text":"*Clap, clap, clap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_20","text":"With applause ringing through the simulation room,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_21","text":"Project Matis begins with one hundred candidates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_22","text":"Once the testing starts, the candidates receive injections at regular intervals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_inark","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_23","type":"Speech","speaker":"manresearcher","key":"Locale_MainScenario:event_projectmatis2_02_s_23","text":"Who in the world would make such a frail child join this experiment...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_24","type":"Speech","speaker":"manresearcher","key":"Locale_MainScenario:event_projectmatis2_02_s_24","text":"What was Syuen thinking...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_25","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_25","text":"No one forced me into this! I volunteered!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_26","type":"Speech","speaker":"manresearcher","key":"Locale_MainScenario:event_projectmatis2_02_s_26","text":"... Yeah, that's what they all say. The things some people do for money...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_27","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_27","text":"Huh...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_28","type":"Speech","speaker":"manresearcher","key":"Locale_MainScenario:event_projectmatis2_02_s_28","text":"Once you get the injection, you'll feel a burning sensation right in your stomach. It's going to hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_29","type":"Speech","speaker":"manresearcher","key":"Locale_MainScenario:event_projectmatis2_02_s_29","text":"That's all normal, though, so don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_30","type":"Speech","speaker":"manresearcher","key":"Locale_MainScenario:event_projectmatis2_02_s_30","text":"If you don't feel like you can handle it, don't hesitate to come tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_31","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_31","text":"Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_32","text":"After each injection comes a brief rest period, followed by a meal that's part of a prescribed diet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_33","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_33","text":"Ngghh... It feels like my insides are on fire...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_34","text":"An unfamiliar pain surges up from deep within her body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_35","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_35","text":"Whew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_36","text":"Still, Laplace forces the food into her mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_37","text":"She finds it bearable so long as she thinks of it as one of the steps toward becoming a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_38","text":"*Clatter*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_39","type":"Speech","speaker":"nervousgirl","key":"Locale_MainScenario:event_projectmatis2_02_s_39","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_40","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_40","text":"Hm? Are you talking to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_41","type":"Speech","speaker":"nervousgirl","key":"Locale_MainScenario:event_projectmatis2_02_s_41","text":"You're... the one the CEO gave special permission to be on the project, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_42","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_42","text":"Well, I don't know who the CEO is!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_43","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_43","text":"But I do think they gave me special permission to join!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_44","type":"Speech","speaker":"nervousgirl","key":"Locale_MainScenario:event_projectmatis2_02_s_44","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_45","type":"Speech","speaker":"nervousgirl","key":"Locale_MainScenario:event_projectmatis2_02_s_45","text":"What... made you come here...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_46","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_46","text":"I came to become a hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_47","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_47","text":"It's amazing that there are this many people who also wanna be heroes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_48","type":"Speech","speaker":"nervousgirl","key":"Locale_MainScenario:event_projectmatis2_02_s_48","text":"What...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_49","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_49","text":"I'm here to become a hero. Aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_50","type":"Speech","speaker":"nervousgirl","key":"Locale_MainScenario:event_projectmatis2_02_s_50","text":"Oh, I see... You really are as strange as the rumors say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_51","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_51","text":"I'm strange?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_52","type":"Speech","speaker":"nervousgirl","key":"Locale_MainScenario:event_projectmatis2_02_s_52","text":"Er, it's nothing. Enjoy... your meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_53","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_53","text":"The nervous girl hurries off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_54","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_54","text":"Huh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_55","text":"Before long, she starts to hear whispers all around her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_pmatis_laboratory","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_56","text":"She's a weirdo. She's only here because of favoritism. She's got a hero complex. She's an attention-seeker. She was gaslit into being here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_57","text":"Everyone clamors on about her, judging her through whatever their favorite lens happens to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_58","text":"It all carries a malice very familiar to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_59","text":"*Crash!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_60","text":"As Laplace goes to set down her tray, someone trips her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_61","type":"Speech","speaker":"ribbonwoman","key":"Locale_MainScenario:event_projectmatis2_02_s_61","text":"Oh, sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_62","type":"Speech","speaker":"ribbonwoman","key":"Locale_MainScenario:event_projectmatis2_02_s_62","text":"I mistook you for a twig instead of a person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_63","type":"Speech","speaker":"ribbonwoman","key":"Locale_MainScenario:event_projectmatis2_02_s_63","text":"I'm surprised you actually hit the ground. I thought maybe you'd grab on to some of the strings you pulled to get in here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_64","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis2_02_s_64","text":"The woman giggles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_65","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_65","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_66","type":"Speech","speaker":"laplace_h","key":"Locale_MainScenario:event_projectmatis2_02_s_66","text":"It seems even a place that makes heroes has villains in it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis2_02_s_67","type":"Speech","speaker":"ribbonwoman","key":"Locale_MainScenario:event_projectmatis2_02_s_67","text":"Wh