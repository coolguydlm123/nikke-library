{"id":"memorial_103401","cat":"memorial","group":{"id":"memorial103400","label":"Call Logs · Take care, my friend."},"label":"yyyy_mm_dd_01.mp3","stage":null,"prev":null,"next":"memorial_103402","speakers":{},"icons":{},"lines":[{"id":"memorial_103401_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_34_01_description","text":"Hello, friend. Wow, this is more embarrassing than I thought it'd be."},{"id":"memorial_103401_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_34_01_description","text":"Anyway, I figured I should leave you a message."},{"id":"memorial_103401_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_34_01_description","text":"So here I am, talking to you through a voice recorder."},{"id":"memorial_103401_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_34_01_description","text":"Is it switched on? I think so."},{"id":"memorial_103401_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_34_01_description","text":"How many years have you been away...? Well, it's been a while at any rate."},{"id":"memorial_103401_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_34_01_description","text":"I miss you."}]}