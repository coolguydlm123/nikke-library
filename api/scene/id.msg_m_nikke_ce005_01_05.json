{"id":"msg_m_nikke_ce005_01_05","cat":"messenger","group":{"id":"room_flora","label":"Flora · Nikke"},"label":"4. Blossom, thank you for the photo.✿","stage":null,"prev":"msg_m_ex_flora_03","next":null,"speakers":{"flora":"Flora"},"icons":{"flora":"si_c411_00_s"},"lines":[{"id":"m_nikke_ce005_01_05_1","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_1","text":"Blossom, thank you for the photo.✿","jump":null},{"id":"m_nikke_ce005_01_05_2","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_2","text":"They have bloomed so beautifully.✿","jump":null},{"id":"m_nikke_ce005_01_05_3","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_3","text":"Seeing Chamomile and the chamomile flower smiling together\nis truly wonderful.✿","jump":null},{"id":"m_nikke_ce005_01_05_4","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_4","text":"Yeah, I think so too.","jump":null},{"id":"m_nikke_ce005_01_05_5","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_5","text":"If it's all right, could you send me a picture with you in it as well?","jump":null},{"id":"m_nikke_ce005_01_05_6","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_6","text":"I'd love to see your smile too.✿","jump":null},{"id":"m_nikke_ce005_01_05_7","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_7","text":"In return, I'll send you a picture as well.✿","jump":null},{"id":"m_nikke_ce005_01_05_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_ce005_01_05_8","text":"All right.","jump":null}],"chat":true}