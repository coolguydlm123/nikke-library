{"id":"d_main_41_03","cat":"main","group":{"id":"ch41","label":"Chapter 41 · Birth"},"label":"No Conversation","stage":"41-14 STAGE · Start","prev":"d_main_41_02","next":"d_main_41_04","speakers":{"raptilion":"Raptilion","pinocchio":"Pinocchio","rapi_red":"Rapi","maxwell_p":"Maxwell","laplace_p":"Laplace","drake_p":"Drake","behemoth":"Behemoth","ziz":"Ziz"},"icons":{"rapi_red":"si_c016_00_s","maxwell_p":"si_c105_00_s","laplace_p":"si_c103_00_s","drake_p":"si_c104_00_s","behemoth":"si_c560_00_s","ziz":"si_c561_00_s"},"lines":[{"id":"d_main_41_03_1","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_1","text":"I'm fine.","jump":null,"exit":false,"enter":null,"bg":"RaptilionHouse","bgArt":"raptilionhouse","image":null,"bgm":"bgm_chapter41_field_otherworld_a","movie":null,"shown":["raptilion","pinocchio"],"affinity":null},{"id":"d_main_41_03_2","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_2","text":"No, you're not! You're badly hurt, Uncle!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_3","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_3","text":"Do not worry. It's just a small gash on my side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_4","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_4","text":"A small gash isn't a minor injury!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_5","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_5","text":"The bleeding has stopped, and I have no problems moving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_6","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_6","text":"You're the one who told me that neglecting a wound is dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_7","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_7","text":"Haha. I'm glad you remember that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_8","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_8","text":"But I'm fine, really. Getting hurt like this is nothing unusual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_9","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_9","text":"Hurry up and take off the Rapture suit. I'll put some medicine on your wound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_10","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_10","text":"Let's wait until we're inside, since my other Rapture friends are still around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_11","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_11","text":"They may not be used to my true form yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_12","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_12","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_13","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_13","text":"... They're obviously having a serious conversation, but it's hard to take them seriously with the way they're talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_red","maxwell_p","laplace_p","drake_p"],"affinity":null},{"id":"d_main_41_03_14","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_14","text":"It's okay. I saw his injury earlier, and it's not that bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_15","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_15","text":"Still, he shouldn't be moving around so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_16","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_16","text":"I gave the first aid kit to Pinocchio, so it should be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_17","text":"... Okay. \nRaptilion, Pinocchio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_18","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_18","text":"Sorry to ask, but can you stay here with Whaley and keep watch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_19","text":"We have to head to the White Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_20","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_20","text":"I understand. You're going to look for your friend, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_21","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_21","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_22","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_22","text":"But there's no guarantee that your friend is there, Uncle. \nSince he fell off Whaley, who knows where he ended up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_23","text":"I'm sure the Commander's there. He has to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_24","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_24","text":"This looks like the Four Beasts' base after all, so if we can't find him, we can just ask them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_25","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_25","text":"Let's move out. We need to hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_26","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_26","text":"Right, let's go. \nIs everyone ready?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_27","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_27","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_28","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_28","text":"I was born ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_29","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_29","text":"My friends, what happened to Nayuta?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_30","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_30","text":"Uh... unh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_31","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_31","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_32","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_33","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_33","text":"Pinocchio and I owe a lot to her. That's terribly unfortunate and sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_34","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_34","text":"All right. We will mourn for our friend later. For now, Whaley's recovery is the top priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_35","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_35","text":"Fortunately, it wasn't a crash, but just a rough landing. She should recover soon enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_36","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_41_03_36","text":"Once you find your friend, or if things get too dangerous, come back right away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_37","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_37","text":"Okay. I'll leave you to it then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_38","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_38","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_39","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_39","text":"Everyone, be careful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_40","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_40","text":"Something about that place doesn't seem right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_41","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_41","text":"It seems... How should I put it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_42","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_41_03_42","text":"I feel all squirmy inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_03_43","text":"*Whooosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_03_44","text":"A signal flare shoots high into the sky above the White Ark.","jump":null,"exit":false,"enter":null,"bg":"WhiteArk_1","bgArt":"whiteark_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_45","text":"Signal flare sent. I hope the Commander sees it and responds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_46","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_46","text":"... Yeah. I really hope so too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_47","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_47","text":"The Four Beasts might see it too, and attack us instead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_48","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_48","text":"Isn't that what you're hoping for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_49","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_49","text":"True. It will make it easier to find out where Birdie is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_50","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_50","text":"All we have to do is subdue them and ask. No need for polite conversation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_51","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_51","text":"We did try to be nice and talk things out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_52","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_52","text":"Those idiots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_53","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_53","text":"Are you upset?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_54","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_54","text":"Of course I am, you fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_55","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_55","text":"There's nothing more frustrating than having your goodwill be rejected by others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_56","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_56","text":"Not even a villain would pull a gun before trying to have a conversation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_57","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_57","text":"The Four Beasts aren't interested in having a conversation, so stop holding onto false hopes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_58","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_58","text":"Hmph. Who's holding onto false hopes? Not me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_59","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_59","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_60","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_60","text":"You're right. We can safely regard the Four Beasts as openly hostile now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_61","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_61","text":"If they attack, we fight back. And if they get in our way, we take them out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_62","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_62","text":"So negotiations are off the table?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_63","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_63","text":"They are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_64","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_64","text":"I'm done putting up with those whiny kids.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_65","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_65","text":"I don't know what they expect us to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_66","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_66","text":"Oh. We're on the same page, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_67","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_67","text":"The only complication is Liberalio...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_68","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_68","text":"It was my first time seeing her in person. \nShe's strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_69","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_69","text":"But that was just because we were ambushed. If we face her in a proper fight, we heroes would never be defeated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_70","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_70","text":"What is she plotting?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_71","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_71","text":"Sowing discord? Not even a villain would stoop so low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_72","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_72","text":"... What exactly is your definition of a villain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_73","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_73","text":"Is she on our side?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_74","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_74","text":"Since the Four Beasts are our common enemy, I guess we can look at it that way for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_75","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_75","text":"If what Liberalio said is true, then the very existence of a Queen is a huge problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_76","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_76","text":"There's a high chance that the Four Beasts have already created one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_77","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_77","text":"If possible, cooperating with Liberalio is definitely to our advantage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_78","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_78","text":"She is a Heretic, after all. An old and powerful one, at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_79","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_79","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_80","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_80","text":"Ah, I miss Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_81","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_41_03_81","text":"Yeah, I miss GraGre too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_82","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_82","text":"C'mon. You can't bring up Cinderella the moment we start talking about the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_83","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_83","text":"If she heard that, she'd be devastated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_84","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_84","text":"I wasn't thinking of her because of any connection to the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_85","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_85","text":"I just miss her, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_86","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_86","text":"Right... I'm sure you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_87","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_88","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_88","text":"This feels like a real tightrope act.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_89","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_89","text":"Right now, our best bet is to listen to what Liberalio said and try to tilt things in our favor, even if just a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_90","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_90","text":"Be that as it may, deep down, I keep asking myself if we can truly trust a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_91","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_91","text":"I feel the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_92","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_92","text":"Don't worry too much, everyone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_93","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_93","text":"Even in the worst-case scenario, it's just the Four Beast and Liberalio!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_94","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_41_03_94","text":"We just need to take down five Heretics!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_95","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_95","text":"That's worse than a worst-case scenario.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_96","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_96","text":"If they come for us all at once, it'd be a bona fide nightmare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_97","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_41_03_97","text":"Well, thank goodness it won't turn into a nightmare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["behemoth","ziz"],"affinity":null},{"id":"d_main_41_03_98","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_98","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_99","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_41_03_99","text":"Since only Ziz and I are here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_100","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_100","text":"Where... is the Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_101","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_41_03_101","text":"The Young Man? Not sure. Why are you asking us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_102","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_41_03_102","text":"Did you lose him off Mother Whale or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_103","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_41_03_103","text":"What about the Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_104","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_41_03_104","text":"Th-the Queen? Er... not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_empathize","movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_105","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_41_03_105","text":"Wherever she is, I'm sure she's doing well? Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_106","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_106","text":"You're getting on my nerves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_107","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_03_107","text":"*Kreeeeee*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_108","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_03_108","text":"The drill on Rapi's Seven Dwarves Zero activates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_03_109","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_41_03_109","text":"If you have nothing useful to say, then get out of the way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}