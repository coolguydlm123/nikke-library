peech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_26","text":"but I don't understand...","jump":null},{"id":"m_ex_vesti_02_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_02_27","text":"What I mean is that you haven't necessarily done anything wrong.","jump":null},{"id":"m_ex_vesti_02_28","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_28","text":"Really?","jump":null},{"id":"m_ex_vesti_02_29","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_02_29","text":"Sometimes, people will dislike you for no reason at all.","jump":"m_ex_vesti_02_31"},{"id":"m_ex_vesti_02_30","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_vesti_02_30","text":"Maybe they're just jealous of you.","jump":"m_ex_vesti_02_35"},{"id":"m_ex_vesti_02_31","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_31","text":"That does","jump":null},{"id":"m_ex_vesti_02_32","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_32","text":"make sense...","jump":null},{"id":"m_ex_vesti_02_33","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_33","text":"But I've been so nice to them this whole time.","jump":null},{"id":"m_ex_vesti_02_34","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_34","text":"Why would they feel that way about me?","jump":"m_ex_vesti_02_40"},{"id":"m_ex_vesti_02_35","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_35","text":"Hmm...","jump":null},{"id":"m_ex_vesti_02_36","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_36","text":"I'm not sure,","jump":null},{"id":"m_ex_vesti_02_37","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_37","text":"but why would they","jump":null},{"id":"m_ex_vesti_02_38","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_vesti_02_38","text":"be jealous?","jump":null}