{"id":"d_counseling_viper_13","cat":"counsel","group":{"id":"char1022","label":"Viper"},"label":"Advising Viper: 13","stage":null,"prev":"d_counseling_viper_12","next":"d_counseling_viper_14","speakers":{"viper":"Viper"},"icons":{"viper":"si_c112_00_s"},"lines":[{"id":"d_counseling_viper_13_1","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_1","text":"Honey, who do you think is in a worse position?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["viper"],"affinity":"_0"},{"id":"d_counseling_viper_13_2","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_2","text":"Someone who steals, or someone who gets stolen from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_13_3","text":"Someone who steals.","jump":"d_counseling_viper_13_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_viper_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_13_4","text":"Being stolen from.","jump":"d_counseling_viper_13_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_viper_13_5","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_5","text":"Hmm, I think the opposite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_6","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_6","text":"If something is precious to you, then you should be able to keep it safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_7","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_7","text":"If you can't do that, then you're better off letting someone else have it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_8","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_8","text":"How am I the bad guy,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_9","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_9","text":"when nobody can look after their valuables properly?","jump":"d_counseling_viper_13_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_10","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_10","text":"I feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_11","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_11","text":"Everyone else seems to think the person who steals is in the wrong, so I'm always painted as the bad guy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_12","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_12","text":"But I always say that if someone really values something, they'd do a better job of protecting it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_13","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_13_13","text":"If you can't keep something safe, then you're better off letting someone else have it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_13_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_viper_13_14","text":"I discuss with Viper how best to protect things precious to us.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}