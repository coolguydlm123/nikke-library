{"id":"d_main_22_03","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"Guardian of the Ark","stage":"22-9 STAGE · Start","prev":"d_main_22_02_e","next":"d_main_22_04_s","speakers":{"anis":"Anis","neon":"Neon","rapi":"Rapi","miranda":"Miranda","enikk_op_l":"Enikk","poli":"Poli"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","miranda":"si_c032_00_s","enikk_op_l":"si_c904_00_s","poli":"si_c030_00_s"},"lines":[{"id":"d_main_22_03_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_03_1","text":"I'll admit, I'm impressed.","jump":null,"exit":false,"enter":null,"bg":"Destroyedcity","bgArt":"destroyedcity","image":null,"bgm":"bgm_collapse_a","movie":null,"shown":["rapi","anis","neon","poli","miranda"],"affinity":null},{"id":"d_main_22_03_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_03_2","text":"We've been making great progress since we're darting from one road to another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_03_3","text":"It's slow going, but at our current speed, we should reach Enikk within 2 hours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_4","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_03_4","text":"Nearly there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_03_5","text":"We haven't seen any humans this entire time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_03_6","text":"No, not yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_03_7","text":"They must have been evacuated... or obliterated. One or the other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_03_8","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_03_9","text":"I'm just saying! I expected more carnage, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_10","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_10","text":"Communications check. Positive signal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_l"],"affinity":null},{"id":"d_main_22_03_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_03_11","text":"Enikk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_03_12","text":"Did you get the communications to work again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_13","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_13","text":"Not throughout entire Ark. I've only created a hotspot in the immediate vicinity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_03_14","text":"What happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_15","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_03_15","text":"Why are there Raptures in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_16","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_16","text":"Collating information. Please wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_17","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_22_03_17","text":"I lower my voice so that no one else is able to hear me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_03_18","text":"... Is it because the deal with Chatterbox fell through?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_l"],"affinity":null},{"id":"d_main_22_03_19","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_19","text":"No. Not that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_20","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_20","text":"To be more precise, it is rather unlikely that was the reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_21","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_03_21","text":"Commander? Did you say something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_03_22","text":"... No. Nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_23","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_03_23","text":"Enikk, can you give us a casualty report?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_24","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_24","text":"Currently, there are no casualties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_25","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_03_25","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_26","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_03_26","text":"I mean, I'm relieved, but how is that possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_27","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_27","text":"10 minutes before this event occurred, an evacuation order was issued for all humans to make their way to the emergency shelters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_28","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_28","text":"Thanks to the event celebrating Matis Squad's victory, most of the humans were concentrated in a single location, thereby streamlining the evacuation process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_29","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_03_29","text":"We never heard of any such order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_30","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_30","text":"It was not sent to Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_03_31","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_32","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_32","text":"The Nikkes were required to stay and fight off the invading Raptures. This is the purpose for which they were created.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_33","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_03_33","text":"Sure, but that doesn't mean you couldn't give us a heads-up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_34","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_34","text":"I'm afraid this was beyond the confines of my capabilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_35","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_35","text":"My duties are to track the movements of the people and monitor their psychological state as well as the condition of the shelters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_36","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_36","text":"There was no time to notify any Nikkes, as by the time my calculations were complete, there were only 10 minutes remaining until the occurrence of the event.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_37","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_03_37","text":"How are the other Nikkes doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_38","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_38","text":"I am in the process of finding that out. I will advise once I have additional information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_03_39","text":"I didn't hear you say anything about why the Raptures invaded the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_40","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_40","text":"Collating information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_41","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_41","text":"Collation complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_03_42","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_43","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_43","text":"Everything that is happening in the Ark is recorded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_44","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_44","text":"Analyzing the information as to why the Rapture entered the Ark took some time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_45","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_45","text":"I have now completed the analysis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_46","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_46","text":"I will share this information with you via video playback.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_47","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_47","text":"After this, however, you must come meet with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_03_48","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_22_03_48","text":"There is something you must do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}