{"id":"event_boomtheghost2_02_s","cat":"event","group":{"id":"ev40085","label":"BOOM! THE GHOST! · Part 2"},"label":"Operation Enlightenment: A","stage":null,"prev":"event_boomtheghost2_01_e","next":"event_boomtheghost2_02_e","speakers":{"pepper_s":"Pepper","elegg_s":"Elegg","alfred":"Alfred","rapi_ss":"Rapi","chefghost":"Sizzly","yan_s":"Yan","centi_s":"Centi","tove_s":"Tove"},"icons":{"pepper_s":"si_c131_01_s","elegg_s":"si_c502_00_s","alfred":"si_c9000_00_s","rapi_ss":"si_c016_01_s","chefghost":"si_c9000_02_s","yan_s":"si_c201_01_s","centi_s":"si_c080_02_s","tove_s":"si_c192_02_s"},"lines":[{"id":"event_boomtheghost2_02_s_1","type":"Speech","speaker":"pepper_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_1","text":"She was electrocuted pretty badly.","jump":null,"exit":false,"enter":null,"bg":"Deck_d","bgArt":"deck_d","image":null,"bgm":"bgm_story_whatsthat","movie":null,"shown":["alfred","elegg_s","pepper_s","rapi_ss"],"affinity":null},{"id":"event_boomtheghost2_02_s_2","type":"Speech","speaker":"pepper_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_2","text":"None of her functions were affected too badly, but any longer and it would have been a different story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_3","type":"Speech","speaker":"pepper_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_3","text":"Forget about malfunctions, her brain would have been fried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_4","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_4","text":"Holy crap! You mean I could have died back there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_5","type":"Speech","speaker":"pepper_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_5","text":"Yes. So it would be best to keep our distance from the high-tier holograms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_6","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_6","text":"Ugh... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_7","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_7","text":"Mr. Alfred, something seems to be seriously wrong here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_8","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_8","text":"That there is, dear passengers. All of the high-tier holograms command patterns are limited to a single input.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_9","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_9","text":"For Sizzly, the input is cooking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_10","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_10","text":"Cooking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_11","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_11","text":"Well, it is a chef, so it makes sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_12","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_12","text":"But to only have one command pattern... no wonder this is such a mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_13","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_13","text":"Yes, dear passengers. All other commands have been blocked, save for that single input.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_14","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_14","text":"What is strange is that I don't know how that happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_15","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_15","text":"It's almost like a ghost did it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_16","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_16","text":"A hologram talking about ghosts... never thought I'd see the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_17","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_17","text":"What if Sizzly actually cooks? Would that help it return to normal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_18","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_19","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_19","text":"Cook...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_20","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_21","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_21","text":"Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_22","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_22","text":"Oh, sorry, dear passengers. I seem to have experienced a momentary system error.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_23","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_23","text":"As the gentleman said, encouraging Sizzly to cook may help,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_24","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_24","text":"but if such a plan fails, there's no telling what could happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_25","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_25","text":"I say we go for it anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_26","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_26","text":"Should we try bringing it some usable ingredients?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_27","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_27","text":"It would hardly be able to cook if we didn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_28","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_28","text":"The entire reason it's been unable to cook all this time is because there aren't any ingredients left for it to use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_29","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_29","text":"Yeah, maybe that's why it's gone haywire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_30","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_30","text":"All right, let's try and gather some ingredients for it to use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_31","text":"Soon after.","jump":null,"exit":false,"enter":null,"bg":"Kitchen","bgArt":"kitchen","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_32","text":"Rapi is holding the ingredients we gathered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_littlehauntedwaltz","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_33","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_33","text":"... Am I the one going in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_34","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_34","text":"Yep. After all, that's not a ghost. And even if it was, you're not afraid of ghosts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_35","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_35","text":"That's right. I'm not scared of ghosts, and that isn't a ghost anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_36","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_37","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_37","text":"Still, just in case, I would like one more person to come along with me as a backup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_38","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_39","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_39","text":"Hehe. I'll go with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_40","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_40","text":"You already got electrocuted once, and you're going back for more?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_41","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_41","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_42","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_42","text":"Do you enjoy getting shocked?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_43","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_43","text":"No! I like playing with electricity, but I don't like being electrocuted!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_44","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_44","text":"Oh, got it. My bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_45","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_02_s_45","text":"All right, let's go. Elegg, you take the lead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_46","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_46","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_47","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_47","text":"Rapi and Elegg cautiously approach Sizzly with the ingredients in hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["tove_s","centi_s","yan_s"],"affinity":null},{"id":"event_boomtheghost2_02_s_48","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_48","text":"For some reason, the other holograms do not pursue them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_02_s_49","text":"Sizzly, however, slowly moves towards Rapi and Elegg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_