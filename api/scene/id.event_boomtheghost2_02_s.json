inity":null},{"id":"event_boomtheghost2_02_s_128","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_128","text":"There is one more problem, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_129","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_129","text":"Huh? What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_130","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_130","text":"If we do not alter the Utopia's current course, it will be caught in a strong current in a few days' time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_131","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_131","text":"That current leads to a whirlpool known as the Ship Graveyard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_132","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_132","text":"... Yikes. How do we change the ship's course?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_133","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_133","text":"I can make the alterations once I have full authorization restored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_134","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_02_s_134","text":"Okay. We'll do what we can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_135","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_135","text":"I also have a question for you all, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_02_s_136","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_02_s_136","text":"Why did you come here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}