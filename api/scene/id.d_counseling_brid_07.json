{"id":"d_counseling_brid_07","cat":"counsel","group":{"id":"char5018","label":"Brid"},"label":"Advising Brid: 07","stage":null,"prev":"d_counseling_brid_06","next":"d_counseling_brid_08","speakers":{"brid":"Brid"},"icons":{"brid":"si_c070_00_s"},"lines":[{"id":"d_counseling_brid_07_1","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_07_1","text":"Commander, when you have a lot of things to do,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["brid"],"affinity":"_0"},{"id":"d_counseling_brid_07_2","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_07_2","text":"do you do it all at once and then relax?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_07_3","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_07_3","text":"Or do you alternate between work and breaks to keep things in balance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_brid_07_4","text":"I do it all at once.","jump":"d_counseling_brid_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_brid_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_brid_07_5","text":"I try to balance it out.","jump":"d_counseling_brid_07_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_brid_07_6","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_07_6","text":"I see. So, you are just like me.","jump":null,"exit":false,"enter":null,"bg":null,