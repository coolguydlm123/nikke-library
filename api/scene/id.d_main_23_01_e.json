speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_13","text":"*Crashh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_14","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_14","text":"Dorothy tosses Nihilister forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_15","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_15","text":"Her limp body tumbles across the ground. She is completely motionless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_01_e_16","text":"Is she dead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["dorothy"],"affinity":null},{"id":"d_main_23_01_e_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_17","text":"For the time being, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_18","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_18","text":"Her throat was slashed clean through. Such a grievous injury would be enough to kill anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_19","text":"However, since she is a Heretic, she'll be able to repair herself in no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_01_e_20","text":"So, what do you intend on doing with her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_21","text":"It wasn't my original intention, but I'll consider her a gift to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_22","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_22","text":"What you choose to do with her is your business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_23","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_23","text":"This may be a bit overwhelming for my first visit, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_24","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_24","text":"it's nothing a gift can't smooth over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_01_e_25","text":"You haven't planted a bomb in her or anything, have you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_26","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_26","text":"Haha, what reason would I have to do such a thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_27","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_27","text":"I possess weapons far more destructive than a puny bomb.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_01_e_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_01_e_29","text":"What happened to Papillon? Do people from Eden know about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_30","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_30","text":"I realize you've all been caught off-guard by my sudden appearance, but must you keep grilling me with questions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_31","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_31","text":"It makes it seem as if you're frightened of me. Heh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_01_e_32","text":"Considering you downed a Heretic with one shot, I'd say it makes sense for us to be scared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_33","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_33","text":"Don't be like that. I'm not here to talk about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_34","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_01_e_34","text":"Answer the question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_35","text":"Papillon is playing her role perfectly well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_36","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_36","text":"She got me in touch with the Ark, \nand she is resting peacefully at Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_37","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_37","text":"She has agreed to keep me and the Ark connected for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_38","text":"Of course, given Eden's disdain for the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_39","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_39","text":"this is all being done without their knowledge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_40","text":"So, I'm afraid I'll have to cut our little reunion short.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_41","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_41","text":"Where is Deputy Chief Burningum?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_01_e_42","text":"What business could you possibly have with him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_43","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_43","text":"Quite a bit, considering he's the one who invited me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_45","text":"Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_46","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_46","text":"Just a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_l"],"affinity":null},{"id":"d_main_23_01_e_47","type":"Speech","speaker":"burningum_op_r","key":"Locale_MainScenario