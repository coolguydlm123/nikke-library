r":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_55","type":"Speech","speaker":"burningum_op_r","key":"Locale_MainScenario:d_main_23_01_e_55","text":"I'll send some troops over. Wait right there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_56","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_56","text":"No, I'll come to you. I can explore the Ark on the way over, and besides, I have a gift for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_57","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_57","text":"If you could put up a map of some kind, that would be more than enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_58","type":"Speech","speaker":"burningum_op_r","key":"Locale_MainScenario:d_main_23_01_e_58","text":"O-okay... Enikk, could you please take her to briefing room 13?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_59","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_59","text":"Yes, sir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_60","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_60","text":"Enikk. Send the coordinates to Miranda and me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["poli","miranda"],"affinity":null},{"id":"d_main_23_01_e_61","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_61","text":"Done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_62","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23_01_e_62","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_63","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_63","text":"Miranda and I will be your guide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_64","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23_01_e_64","text":"Us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_65","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_65","text":"And you two are...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_66","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_66","text":"We're the A.C.P.U. The Ark's police force.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_67","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_67","text":"Is that right? Well, any chance you can show me where I need to go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_68","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_68","text":"Sure thing, we've got you covered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_69","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23_01_e_69","text":"Um... I have a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_70","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23_01_e_70","text":"What should we do about the Heretic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_71","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_71","text":"Hmm... carrying her would be awfully cumbersome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_72","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_72","text":"I'll carry her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_73","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23_01_e_73","text":"Wow, really? Thanks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_74","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_74","text":"Thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_75","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_75","text":"Well, we better get going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_76","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_76","text":"Poli, Miranda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_77","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_77","text":"Don't worry, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_78","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23_01_e_78","text":"We'll take care of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_79","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_79","text":"Okay, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_80","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23_01_e_80","text":"See you later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_81","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_81","text":"Poli, Miranda, Dorothy, and Nihilister disappear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_82","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_82","text":"Are they going to be okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_83","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_01_e_83","text":"They'll be fine. If she was up to something, she would have made a move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_23_01_e_84","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_01_e_84","text":"Besides, the A.C.P.U. is a government-sanctioned organization.\nIf Dorothy so much as lays a finger on them, the entire Ark will descend upon her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_85","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_01_e_85","text":"That's most likely why Poli decided to be her guide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_86","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_01_e_86","text":"I can't say I'm entirely confident in Miranda, but Poli is sharp as a tack, so I expect things will go smoothly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_87","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_01_e_87","text":"Yes. The two of them can handle themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_88","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_88","text":"Right. We'll just have to trust them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_89","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_89","text":"Enikk, what's the latest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_90","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_90","text":"Temporary repairs to the Ark's roof are almost complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_91","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_91","text":"A deployment of Nikke units, led by Absolute and Matis, is still fighting up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_92","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_92","text":"We have sent additional troops up to the surface, so there should not be any additional Rapture attacks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_93","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_93","text":"However, there are still a large number of Raptures remaining inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_94","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_23_01_e_94","text":"Looks like a whole lot came down when they had the chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_95","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_95","text":"There are still no reports of any Nikke or human causalities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_96","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_96","text":"Everything seems to be going well, and will be sorted out soon enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_97","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_97","text":"So, are you saying we don't need to join in the fighting against the Raptures in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_98","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_98","text":"That's right. \nEven if you were deployed, it would be unlikely to make much of an impact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_99","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_01_e_99","text":"Commander, you want to fight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_100","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_100","text":"Yes. We need to take down Exotic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_101","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_101","text":"Enikk. \nCan I know the whereabouts of Crow, Viper, and Jackal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_102","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_102","text":"During the Rapture invasion, while my mind was focused elsewhere, the Exotic squad took advantage of that and disappeared from my radar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_103","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_103","text":"I am currently unable to determine their location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_104","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_104","text":"How about Syuen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_105","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_105","text":"She is currently at the Missilis headquarters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_106","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_106","text":"The Missilis headquarters is one of the safest places in the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_107","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_107","text":"so the CEOs of Elysion and Tetra are also with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_108","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_108","text":"Okay. Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_109","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_109","text":"Everyone, let's head to the Missilis headquarters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_110","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_110","text":"Syuen should know something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_111","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_01_e_111","text":"Roger. Let's move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_112","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_112","text":"I will send each CEO some relevant videos.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_113","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_113","text":"After I have done that, I will go back to concentrating on the Raptures inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_114","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_114","text":"I will therefore be unable to provide you with much assistance. I hope you understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_115","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_115","text":"It's okay. Just focus on taking care of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_116","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_23_01_e_116","text":"I will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_117","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_117","text":"For some reason, I can't shake this nervous feeling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_01_e_118","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_01_e_118","text":"Something tells me this breaching of the Ark won't end here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}