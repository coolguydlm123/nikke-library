{"id":"d_main_04af_07","cat":"main","group":{"id":"ch4","label":"Chapter 4 · Bouquet"},"label":"Up North","stage":null,"prev":"d_main_04af_06","next":"d_main_04af_08","speakers":{"andersen":"Andersen","Self":"Commander"},"icons":{"andersen":"si_c903_00_s"},"lines":[{"id":"d_main_04af_07_1","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_1","text":"I need you to go up to the surface and head north.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_a","movie":null,"shown":["andersen"],"affinity":null},{"id":"d_main_04af_07_2","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_07_2","text":"The north?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_3","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_3","text":"You said a Nikke nearly managed to take down the Chatterbox you came across.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_4","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_4","text":"She was spotted in the north.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_5","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_5","text":"Go and see if she knows anything about its whereabouts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_6","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_07_6","text":"Who is that Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_7","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_7","text":"Collectively, they are referred to as Pilgrims.\nThey are Nikkes who live up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_8","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_07_8","text":"You mean there's more than one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_9","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_9","text":"We don't know the details.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_10","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_10","text":"But what is certain is that they live above ground, and we have never had any official contact with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_11","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_11","text":"They're incredibly elusive and nearly impossible to track.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_12","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_12","text":"I'm sure you have many questions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_13","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_13","text":"How am I supposed to locate these Pilgrims? Everyone knows how vast the frozen North is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_14","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_14","text":"There's a research base in that area. I've already sent the coordinates to Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_15","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_15","text":"Once you arrive, our staff at the research base will provide additional assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_16","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_16","text":"Understood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_17","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_07_17","text":"Yes, for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_18","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_18","text":"All right, then. We're done here. I've got a meeting coming up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_19","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_19","text":"Ah, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_20","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_20","text":"How's your leg?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_21","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_07_21","text":"Still working.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_22","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_22","text":"Ingrid prepared that exoskeleton just for you. Think of it as a cast with some kick to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_07_23","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_07_23","text":"Bring me back some good news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}