{"id":"event_lastkingdom2_03_s","cat":"event","group":{"id":"ev40046","label":"LAST KINGDOM · Part 2"},"label":"Clashing Swords: A","stage":null,"prev":"event_lastkingdom2_02_e","next":"event_lastkingdom2_03_e","speakers":{"hongryeon":"Scarlet","indivilia":"Indivilia","crown":"Crown","snowwhite":"Snow White","kilo":"Kilo","rapunzel":"Rapunzel"},"icons":{"hongryeon":"si_c222_00_s","indivilia":"si_c263_00_s","crown":"si_c330_00_s","snowwhite":"si_c220_00_s","kilo":"si_c977_00_s","rapunzel":"si_c221_00_s"},"lines":[{"id":"event_lastkingdom2_03_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_1","text":"*Clang* *Clang* *Clang*","jump":null,"exit":false,"enter":null,"bg":"EventScene_lastkingdom_07","bgArt":"eventscene_lastkingdom_07","image":null,"bgm":"event_bgm_lastkingdom_whisperoffear","movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_2","text":"The sound of clashing steel echoes through the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_3","text":"Scarlet and Indivilia trade rapid blows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_4","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_4","text":"Thy weapon is akin to a whip rather than a sword. Attaching blades to one's tail... 'tis a perversion if nothing else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_5","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_5","text":"And what of you? Swinging a sword around like a primitive ape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_6","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_6","text":"If it is as primitive as you say, then pray tell, why art thou unable to so much as scratch me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_7","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_7","text":"Hehe, shall I kick it up a notch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_8","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_8","text":"Once I get into the swing of things, I can surpass the speed of sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_9","text":"Indivilia's tail disappears in a blur,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_10","text":"the swinging of her whip-like tail too fast to be seen by the naked eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_11","text":"Despite the blinding speed, however, Scarlet continues to parry each and every strike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_12","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_13","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_13","text":"Is that all you have? I grow weary of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_14","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_14","text":"What did you say?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_15","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_15","text":"Thou relies solely on brute strength, with no consideration given to tactics, analysis or thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_16","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_16","text":"To call such a thing swordsmanship would be a dishonor to true wielders of the sword.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_17","text":"*Swish*","jump":null,"exit":false,"enter":null,"bg":"EventScene_lastkingdom_08","bgArt":"eventscene_lastkingdom_08","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_18","text":"Scarlet's sword slices through Invidivilia's tail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_19","text":"*Thud*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_20","text":"The blade at the end of Indivilia's tail drops lifelessly to the ground.","jump":null,"exit":false,"enter":null,"bg":"CrownCastleFrontYard_d","bgArt":"crowncastlefrontyard_d","image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"event_lastkingdom2_03_s_21","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_21","text":"You can wield your blade with all the speed in the universe,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_22","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_22","text":"but if it is wielded without intelligence, it is all for naught.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_23","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_23","text":"Hmph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_24","text":"*Whirrrrr*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["indivilia"],"affinity":null},{"id":"event_lastkingdom2_03_s_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_25","text":"Indivilia's tail regenerates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_26","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_26","text":"No matter. I can make another one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_27","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_27","text":"Tell me, where is the joy in living this way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_28","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_28","text":"Carrying the burden of immortality, satisfied with the power you possess and wielding it indiscriminately without any forethought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_29","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_29","text":"Where is the enjoyment to be found in that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_30","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_30","text":"I derive plenty of joy in slicing the throats of people like you who do nothing but preach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_31","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_31","text":"Is that all there is? Are there no more sides to you than this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_32","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_32","text":"This is it, and you're finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_33","text":"*Swooosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_34","text":"*Clang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_35","text":"Crown's spear soars towards Indivilia, who manages to knock it out the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crown"],"affinity":null},{"id":"event_lastkingdom2_03_s_36","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_36","text":"It would seem all you excel at is attacking your enemy behind their back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_37","text":"Crown picks up the spear from the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_38","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom2_03_s_38","text":"You also talk too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_39","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_39","text":"Oh, how I've been longing to run into you again. I've never encountered such a worthy foe. Fine, enough talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_40","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_40","text":"Shall I bring this little game to a close?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_41","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom2_03_s_41","text":"Are you thinking of transforming again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_42","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_42","text":"Oh no, I find little joy in transforming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_43","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_43","text":"Personally, I think it makes me unbecoming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_44","text":"*Shoooooo*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_45","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_45","text":"Wha... what are you vomiting up?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_46","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom2_03_s_46","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_47","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom2_03_s_47","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_lastkingdom2_03_s_48","text":"Crown staggers backwards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_49","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_49","text":"I can emit high concentrations of Alva Particles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_50","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_50","text":"Do you know what effects these particles have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_51","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_51","text":"They disrupt communication.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_52","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_52","text":"Usually, this is restricted to cutting off electrical signals,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_53","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_53","text":"but in high enough concentrations, they can cause the human imposters to go haywire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_54","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_s_54","text":"Nice try. Doth thou truly believe we'll fall for that trick?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_55","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_03_s_55","text":"You say that, but your face tells me you're terrified.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_s_56","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom2_03_s_56","text":"Ur