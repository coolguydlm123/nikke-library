{"id":"s005_04","cat":"side","group":{"id":"side5","label":"PRETTY STAR"},"label":"PRETTY STAR: 4","stage":null,"prev":"s005_03","next":"s005_05","speakers":{"pretty_casual":"Freesia","hanson":"Hanson","osward_casual":"Oswald","mrsmiss":"Mrs. Miss","anis_human":"Anis"},"icons":{"pretty_casual":"si_c9020_01_s","hanson":"si_c9023_00_s","osward_casual":"si_c961_01_s","mrsmiss":"si_c9003_00_s","anis_human":"si_c9021_00_s"},"lines":[{"id":"s005_04_1","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_1","text":"Me? A celebrity? Really?","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_inark","movie":null,"shown":["pretty_casual","hanson","osward_casual","mrsmiss"],"affinity":null},{"id":"s005_04_2","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_2","text":"Yes, that's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_3","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_3","text":"Tetra Line would like to formally invite you to debut with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_4","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_5","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_5","text":"Freesia pokes Oswald in the side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_6","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_6","text":"See? I told you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_7","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_7","text":"May I ask why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_8","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_8","text":"I can't make sense of debuting a Nikke as a celebrity at this point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_9","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_9","text":"And there must be a reason you chose Freesia, given that she's never shown any interest in the entertainment industry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_10","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_10","text":"She's got talent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_11","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_11","text":"Once she debuts, she'll shoot straight to stardom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_12","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_12","text":"I'll stake my reputation on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_13","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_13","text":"I wouldn't be so sure about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_14","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_14","text":"You think I'd lie?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_15","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_15","text":"Yes, there's nothing backing that claim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_16","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_16","text":"... I hate to brag, but I'm a very successful producer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_17","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_17","text":"When it comes to spotting raw talent, no one even comes close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_18","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_18","text":"Where did you get information on Freesia? You shouldn't have had any contact with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_19","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_19","text":"Every Nikke application goes through me. After all, we are a Nikke manufacturing company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_20","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_21","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_21","text":"Tetra Line hasn't been doing well lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_22","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_22","text":"So you intend to make Freesia a symbol for advancing Nikke rights to gain support?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_23","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_23","text":"By my calculation, the Nikkephobes make up half the Ark's population,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_24","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_24","text":"and you intend to win over the other half by turning her into a celebrity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_25","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_25","text":"... You work in this industry, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_26","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_26","text":"I suppose you could say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_27","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_27","text":"You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_28","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_29","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_29","text":"Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_30","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_30","text":"As you said, Tetra Line's situation is indeed far from ideal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_31","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_31","text":"Following the failure of the surface reclamation war, hostility toward the Nikkes has spread throughout the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_32","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_32","text":"As a result, Tetra Line, which had been preparing a major entertainment project centered on the Nikkes, is now taking a direct hit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_33","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_33","text":"That's precisely why we need your daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_34","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_34","text":"So, you're hoping to turn things around by putting a Nikke with a story in the spotlight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_35","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_35","text":"I won't deny that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_36","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_36","text":"but that's not the whole story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_37","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_37","text":"The current situation is wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_38","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_38","text":"Nikkes should be celebrated as the Goddesses of Victory,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_39","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_39","text":"not treated with scorn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_40","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_41","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_41","text":"... I was only a child when the Rapture invasion occurred. I was powerless then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_42","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_42","text":"But I remember watching them fight for us on television.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_43","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_43","text":"When I didn't know any better, I thought they were simply impressive. Once I learned the truth, I realized how noble their choices truly were.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_44","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_44","text":"And now, those very Nikkes are being made scapegoats, persecuted for circumstances beyond their control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_45","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_45","text":"The Central Government's neglect has left even their supporters unable to speak openly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_46","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_46","text":"This is wrong. It should never have been allowed to happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_47","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_47","text":"... Your daughter's story is a compelling one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_48","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_48","text":"Someone who died fighting for Nikke rights was reborn as a Nikke and now chooses to fight again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_49","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_49","text":"With Tetra Line's unparalleled character branding and promotional power, we can spread that story throughout the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_50","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_50","text":"I want those who fight for Nikke rights to be able to speak freely and with confidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_51","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_51","text":"... I may be overstepping, but you seem well-versed in this field. I believe you understand exactly what I mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_52","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_53","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_53","text":"Please forgive me for speaking of such a tragic death in this way,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_54","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_54","text":"but this is a rare opportunity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_55","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_55","text":"Does she really need to be a celebrity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_56","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_56","text":"I trust you know there's nothing that can shape public opinion quite like celebrities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_57","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_58","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_58","text":"I'm asking you to give the Nikkes hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_59","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_59","text":"The Ark needs it now more than ever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_60","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_60","text":"Oswald looks at Freesia,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_61","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_61","text":"whose eyes are sparkling like fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_62","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_62","text":"Deep down, he knows that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_63","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_63","text":"there is no stopping this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_64","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_64","text":"So, let me get this straight,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_65","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_65","text":"I'm going to be a celebrity and fight for Nikke rights, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_66","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_66","text":"To sum it up, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_67","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_67","text":"But we won't do it out in the open. Everything we do is under the radar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_68","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_68","text":"That's the kind of thing we excel at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_69","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_69","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_70","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_70","text":"Mister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_71","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_72","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_72","text":"Oswald stares intently at Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_73","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_73","text":"I have one condition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_74","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_74","text":"Sure, I'll do everything I can to accommodate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_75","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_75","text":"Hanson, stay by Freesia's side as her manager","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_76","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_76","text":"and keep a close eye on everything she does.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_77","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_77","text":"You do realize he's a board member at Tetra, right? He's not going to waste his time playing some celebrity's manager...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_78","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_78","text":"Yes, I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_79","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_79","text":"Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_80","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_80","text":"It's all right. That was my plan from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_81","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_81","text":"And one more thing...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_82","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_82","text":"Under no circumstances are you to send her to the other side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_83","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_83","text":"The other side? I'm afraid I don't follow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_84","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_84","text":"Do you want me to go into the details of what really goes on behind closed doors at Tetra?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_85","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_86","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_86","text":"Who the hell is this guy...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_87","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_87","text":"Make no mistake: this is a warning, not a request.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_88","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_88","text":"... Understood. I'll keep that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_89","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_04_89","text":"I'm counting on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_90","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_90","text":"It's a pleasure. I look forward to working with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_91","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_91","text":"Freesia gets up","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_92","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_92","text":"and extends her hand toward Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_93","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_93","text":"Let's do our best together!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_94","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_94","text":"Ah... Yes, I look forward to working with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_95","type":"Speech","speaker":"pretty_casual","key":"Locale_SideStory:s005_04_95","text":"I'm Freesia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_96","type":"Speech","speaker":"hanson","key":"Locale_SideStory:s005_04_96","text":"Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_97","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_97","text":"Their hands meet in a firm shake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_98","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_98","text":"Oswald's eyes linger on Freesia, noting the way she looks at Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_99","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_99","text":"Once again, he is certain that this cannot be stopped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_100","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_100","text":"We start tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_101","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_101","text":"The goal is a debut in six months.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_102","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_04_102","text":"It's going to be tough, so you'd better be ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_103","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_103","text":"Time drifts by.","jump":null,"exit":false,"enter":null,"bg":"GoodOffice_n","bgArt":"goodoffice_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_104","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_104","text":"Oswald finishes work and makes his way home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_105","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_105","text":"He prepares dinner and watches the news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_106","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_106","text":"The front door swings open, and Freesia stumbles in, utterly exhausted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pretty_casual"],"affinity":null},{"id":"s005_04_107","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_107","text":"They share a meal and talk about her training, the house humming with the gentle rhythm of everyday life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_108","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_108","text":"Freesia drifts off to sleep, and Oswald turns his attention to the work waiting for him tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_109","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_109","text":"He's completely settled into this rhythm, this quiet repetition of days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_110","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_110","text":"If life could flow like this forever, he thinks that there would be nothing left to wish for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_111","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_111","text":"But a week later, Freesia steps into a new world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_112","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_112","text":"That night, Oswald lies awake, wondering what he can do for her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s005_04_113","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_113","text":"For nearly half a year, Anis has not uttered a single word.","jump":null,"exit":false,"enter":null,"bg":"Classroom","bgArt":"classroom","image":null,"bgm":"bgm_risk","movie":null,"shown":["anis_human"],"affinity":null},{"id":"s005_04_114","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_114","text":"The scribbles on her desk have mostly worn away. The chrysanthemum that sat in the vase is gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_115","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_115","text":"Everyone ignores her completely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_116","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_116","text":"She tries to get angry. She tries to plead. Nothing changes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_117","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_117","text":"Even the teachers stop responding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_118","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_118","text":"There's no one to reach out to. Anis has no one.","jump":null,"exit":false,"enter":null,"bg":"Room2_n","bgArt":"room2_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_119","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_119","text":"On weekends, she lies alone in her dorm room all day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_120","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_120","text":"Still, she goes to school, clinging to the tiniest hope that maybe, just maybe, someone will speak to her tomorrow.","jump":null,"exit":false,"enter":null,"bg":"Classroom","bgArt":"classroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_121","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_121","text":"Every time, that hope crumbles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_122","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_122","text":"Eventually, she gives up. She says nothing. She expects nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_123","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_123","text":"One day, after everyone leaves and the classroom grows dim and silent,","jump":null,"exit":false,"enter":null,"bg":"Classroom_n","bgArt":"classroom_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_124","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_124","text":"Anis stares blankly into space,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_125","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_04_125","text":"and for the first time in months, she speaks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_04_126","type":"Speech","speaker":"anis_human","key":"Locale_SideStory:s005_04_126","text":"Why am I even still alive?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}