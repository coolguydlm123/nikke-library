{"id":"d_counseling_nayuta_04","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 04","stage":null,"prev":"d_counseling_nayuta_03","next":"d_counseling_nayuta_05","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_04_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_1","text":"Art thou aware that Young Lady Scarlet doth ever bear strong spirits on her person?","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_04_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_2","text":"I am truly curious whence all that spirits cometh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_04_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_04_3","text":"Maybe she has a secret stash somewhere?","jump":"d_counseling_nayuta_04_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_04_4","text":"Maybe she just finds them on the surface?","jump":"d_counseling_nayuta_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_04_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_5","text":"Ah, verily, there is much truth therein.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_04_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_6","text":"Should opportunity present itself, I shall seek it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_04_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_7","text":"It seemeth to me that Young Lady Scarlet would do well to temper her indulgence in spirits.","jump":"d_counseling_nayuta_04_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_04_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_8","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_04_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_9","text":"Doth Young Lady Scarlet perchance possess a faculty for discerning alcohol?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_04_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_04_10","text":"Else, 'twould prove arduous to replenish such prodigious quantities from the surface, as need requireth.","jump":"d_counseling_nayuta_04_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_04_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_04_11","text":"Nayuta and I talk about Scarlet.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}