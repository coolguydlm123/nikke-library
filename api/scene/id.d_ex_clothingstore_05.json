uess I am a little nervous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_clothingstore_05_87","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_clothingstore_05_87","text":"Helping others get dressed isn't exactly a common thing for me, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_clothingstore_05_88","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_clothingstore_05_88","text":"Don't worry, we're almost done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_clothingstore_05_89","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_clothingstore_05_89","text":"Nod my head.","jump":"d_ex_clothingstore_05_90","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_clothingstore_05_90","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_clothingstore_05_90","text":"The tension in the air is so thick, you could cut it with a knife. Sakura quickens her pace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_clothingstore_05_91","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_clothingstore_05_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_clothingstore_05_92","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_clothingstore_05_92","text":"... Done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_clothingstore_05_93","type":"Speech","