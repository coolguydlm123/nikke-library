id":"event_arcanearchive_05_e_33","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_e_33","text":"Not to mention that you've had the good fortune of speaking to a Goddess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_e_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_e_34","text":"Sorry, but I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_e_35","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_e_35","text":"... I suppose it's not such a big deal anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_e_36","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_e_36","text":"Arcana carefully brushes some dust off the bookshelf.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_e_37","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_05_e_37","text":"Something tells me she doesn't believe my assertion that I don't know anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_e_38","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_05_e_38","text":"Not as long as we're keeping a watchful eye over them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_05_e_39","type":"Self","speaker":null,"key":"Locale_SubScenario:event_