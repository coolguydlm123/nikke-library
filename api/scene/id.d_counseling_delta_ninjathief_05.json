{"id":"d_counseling_delta_ninjathief_05","cat":"counsel","group":{"id":"char5154","label":"Delta: Ninja Thief"},"label":"Advising Delta: Ninja Thief: 05","stage":null,"prev":"d_counseling_delta_ninjathief_04","next":"d_counseling_delta_ninjathief_06","speakers":{"delta_n":"Delta"},"icons":{"delta_n":"si_c023_00_s"},"lines":[{"id":"d_counseling_delta_ninjathief_05_1","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_1","text":"While on trainee ninja thief missions, there are times when weapons are necessary.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["delta_n"],"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_2","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_2","text":"I am constantly considering the best weapon to use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_3","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_3","text":"Which one do you recommend?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_05_4","text":"Go with the classics: a shuriken!","jump":"d_counseling_delta_ninjathief_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_delta_ninjathief_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_05_5","text":"How about a fan?","jump":"d_counseling_delta_ninjathief_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_delta_ninjathief_05_6","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_6","text":"As you say,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_7","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_7","text":"stealth is essential for a ninja,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_8","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_8","text":"so shurikens that can be concealed on the body are ideal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_9","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_9","text":"In fact, I already have several hidden in various places.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_10","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_10","text":"Care to try and find them?","jump":"d_counseling_delta_ninjathief_05_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_11","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_11","text":"A fan, you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_12","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_12","text":"I have heard that some ninjas use fans as weapons,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_13","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_13","text":"but unless one's skill is quite high, throwing a fan at the target accurately is difficult, indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_14","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_14","text":"To wield a fan as a weapon, one must surely be a master of ninjutsu.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_15","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_05_15","text":"Regrettably, I still lack sufficient training to use it myself.","jump":"d_counseling_delta_ninjathief_05_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_05_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_05_16","text":"Delta and I have a discussion about ninja weapons.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}