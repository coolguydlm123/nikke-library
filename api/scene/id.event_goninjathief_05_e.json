{"id":"event_goninjathief_05_e","cat":"event","group":{"id":"ev40092","label":"GO! NINJA THIEF!"},"label":"The Lonely Phantom Thief: B","stage":null,"prev":"event_goninjathief_05_s","next":"event_goninjathief_06_s","speakers":{"phantom":"Phantom","delta_n":"Delta","quency_e":"Quency","miranda":"Miranda"},"icons":{"phantom":"si_c580_00_s","delta_n":"si_c023_00_s","quency_e":"si_c403_00_s","miranda":"si_c032_00_s"},"lines":[{"id":"event_goninjathief_05_e_1","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_05_e_1","text":"Oh, Delta came out alone.","jump":null,"exit":false,"enter":null,"bg":"Drain","bgArt":"drain","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["phantom"],"affinity":null},{"id":"event_goninjathief_05_e_2","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_2","text":"The one in that room must be Miranda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_3","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_3","text":"... I hope nothing untoward occurred.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_4","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_05_e_4","text":"Wait, isn't that the room Poli went into?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_5","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_5","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_6","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_6","text":"If Delta were to enter completely unaware and encounter Poli, getting caught is inevitable...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_7","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_7","text":"Not only would her mission fail, but our newest member of the Thieves of Justice would be confined to prison for all eternity!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_8","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_8","text":"Ah, our ninja thief...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_9","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_05_e_9","text":"Keep it down, or we'll get caught!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_10","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_10","text":"This won't do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_11","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_goninjathief_05_e_11","text":"Monsieur, I shall keep watch over Poli. Might I trouble you to hold Delta back for a while?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goninjathief_05_e_12","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goninjathief_05_e_12","text":"Me?","jump":null,"exit":false,"ente