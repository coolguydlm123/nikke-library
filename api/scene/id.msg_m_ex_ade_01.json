{"id":"msg_m_ex_ade_01","cat":"messenger","group":{"id":"room_ade","label":"Ade · Nikke"},"label":"1. Hello, Master :)","stage":null,"prev":null,"next":"msg_m_ex_ade_02","speakers":{"ade":"Ade"},"icons":{"ade":"si_c310_00_s"},"lines":[{"id":"m_ex_ade_01_1","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_1","text":"Hello, Master :)","jump":null},{"id":"m_ex_ade_01_2","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_2","text":"I'm Ade.","jump":null},{"id":"m_ex_ade_01_3","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_3","text":"I'm from Maid For You.","jump":null},{"id":"m_ex_ade_01_4","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_4","text":"I am employed at the Maid Cafe alongside Cocoa and Soda.","jump":null},{"id":"m_ex_ade_01_5","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_5","text":"Should you find yourself in need of cleaning, laundry, or cooking services,","jump":null},{"id":"m_ex_ade_01_6","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_6","text":"be sure to summon me at your most convenient hour.","jump":null},{"id":"m_ex_ade_01_7","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_7","text":"I will attend to your every requirement promptly.","jump":null},{"id":"m_ex_ade_01_8","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_8","text":"To be honest,","jump":null},{"id":"m_ex_ade_01_9","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_9","text":"it truly is an exquisite honor to be able to speak with you! :)","jump":null},{"id":"m_ex_ade_01_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_10","text":"That's very flattering to hear.","jump":"m_ex_ade_01_12"},{"id":"m_ex_ade_01_11","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_11","text":"I'm sure you'll make your friends and family proud.","jump":"m_ex_ade_01_15"},{"id":"m_ex_ade_01_12","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_12","text":"I mean it.","jump":null},{"id":"m_ex_ade_01_13","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_13","text":"I've been wanting to contact you like this","jump":null},{"id":"m_ex_ade_01_14","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_14","text":"for quite some time.","jump":"m_ex_ade_01_18"},{"id":"m_ex_ade_01_15","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_15","text":"Yes, indeed.","jump":null},{"id":"m_ex_ade_01_16","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_16","text":"I will never forget this moment,","jump":null},{"id":"m_ex_ade_01_17","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_17","text":"and I shall make sure to back up these messages...","jump":"m_ex_ade_01_18"},{"id":"m_ex_ade_01_18","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_18","text":"In actual fact,","jump":null},{"id":"m_ex_ade_01_19","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_19","text":"it appears that our paths shall cross soon.","jump":null},{"id":"m_ex_ade_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_20","text":"We will?","jump":null},{"id":"m_ex_ade_01_21","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_21","text":"We have an appointment for advising in half an hour.","jump":null},{"id":"m_ex_ade_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_22","text":"Oh, I forgot. I'm sorry.","jump":null},{"id":"m_ex_ade_01_23","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_23","text":"No worries.","jump":null},{"id":"m_ex_ade_01_24","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_24","text":"As you are a busy individual, it is understandable that it may slip your mind.","jump":null},{"id":"m_ex_ade_01_25","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_25","text":"I've prepared","jump":null},{"id":"m_ex_ade_01_26","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_26","text":"some light refreshments for you.","jump":null},{"id":"m_ex_ade_01_27","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_27","text":"Earl Grey tea and citrus scones.","jump":null},{"id":"m_ex_ade_01_28","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_28","text":"Bacon quiche and salmon canapés.","jump":null},{"id":"m_ex_ade_01_29","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_29","text":"Egg sandwiches and sachertorte.","jump":null},{"id":"m_ex_ade_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_30","text":"You consider those light refreshments?","jump":null},{"id":"m_ex_ade_01_31","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_31","text":"That's correct.","jump":null},{"id":"m_ex_ade_01_32","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_32","text":"I can make more","jump":null},{"id":"m_ex_ade_01_33","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_33","text":"if you'd like.","jump":null},{"id":"m_ex_ade_01_34","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_34","text":"Is there anything else you'd like to try?","jump":null},{"id":"m_ex_ade_01_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_35","text":"No, that's okay.","jump":null},{"id":"m_ex_ade_01_36","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_36","text":"Very well, then. I shall bring them right over.","jump":null},{"id":"m_ex_ade_01_37","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_37","text":"Don't worry about cleaning up your room in advance.","jump":null},{"id":"m_ex_ade_01_38","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_38","text":"You can leave that to me.","jump":null},{"id":"m_ex_ade_01_39","type":"Speech","speaker":"ade","key":"Locale_SuddenMessage:m_ex_ade_01_39","text":"Until we meet again, Master.","jump":null},{"id":"m_ex_ade_01_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_40","text":"See you.","jump":null},{"id":"m_ex_ade_01_41","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_01_41","text":"... I really should tidy up a little before she gets here.","jump":null}],"chat":true}