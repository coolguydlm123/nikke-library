{"id":"msg_m_ex_absolut_04","cat":"messenger","group":{"id":"room_absolut","label":"Absolute · Group"},"label":"7. Return Report","stage":null,"prev":"msg_m_ex_absolut_03","next":"msg_m_ex_absolut_05","speakers":{"eunhwa":"Eunhwa","emma":"Emma","vesti":"Vesti"},"icons":{"eunhwa":"si_c092_00_s","emma":"si_c090_00_s","vesti":"si_c091_00_s"},"lines":[{"id":"m_ex_absolut_04_1","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_1","text":"Return Report","jump":null},{"id":"m_ex_absolut_04_2","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_2","text":"All three members of Absolute Squad present and accounted for.","jump":null},{"id":"m_ex_absolut_04_3","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_3","text":"Surface operation completed.","jump":null},{"id":"m_ex_absolut_04_4","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_4","text":"Deviation from predicted completion time.","jump":null},{"id":"m_ex_absolut_04_5","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_5","text":"21 minutes and 2 seconds.","jump":null},{"id":"m_ex_absolut_04_6","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_6","text":"Early completion.","jump":null},{"id":"m_ex_absolut_04_7","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_7","text":"Returning now.","jump":null},{"id":"m_ex_absolut_04_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_8","text":"Well done. Any injuries sustained?","jump":null},{"id":"m_ex_absolut_04_9","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_9","text":"Who do you think you're talking to?","jump":null},{"id":"m_ex_absolut_04_10","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_10","text":"Don't make a fuss over a little tussle like this,","jump":null},{"id":"m_ex_absolut_04_11","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_11","text":"Weakling.","jump":null},{"id":"m_ex_absolut_04_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_12","text":"I heard it was far more than that, and was a serious skirmish.","jump":null},{"id":"m_ex_absolut_04_13","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_13","text":"Eunhwa,","jump":null},{"id":"m_ex_absolut_04_14","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_14","text":"the Commander is just worried about you, that's all.","jump":null},{"id":"m_ex_absolut_04_15","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_15","text":"You don't have to be so mean.","jump":null},{"id":"m_ex_absolut_04_16","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_16","text":"Thank you, Commander.","jump":null},{"id":"m_ex_absolut_04_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_17","text":"Don't worry, I'm used to her being cranky.","jump":null},{"id":"m_ex_absolut_04_18","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_18","text":"...","jump":null},{"id":"m_ex_absolut_04_19","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_19","text":"Hehe.","jump":null},{"id":"m_ex_absolut_04_20","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_20","text":":D","jump":null},{"id":"m_ex_absolut_04_21","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_21","text":"There were an awful lot of Raptures this time around,","jump":null},{"id":"m_ex_absolut_04_22","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_22","text":"don't you think?","jump":null},{"id":"m_ex_absolut_04_23","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_23","text":"Yeah, totally.","jump":null},{"id":"m_ex_absolut_04_24","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_24","text":"There were more than last time,","jump":null},{"id":"m_ex_absolut_04_25","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_25","text":"but nothing out of the ordinary.","jump":null},{"id":"m_ex_absolut_04_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_26","text":"Vesti, impressive as always.","jump":null},{"id":"m_ex_absolut_04_27","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_27","text":"Wha... I didn't mean to brag...","jump":null},{"id":"m_ex_absolut_04_28","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_28","text":"It's okay.","jump":null},{"id":"m_ex_absolut_04_29","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_29","text":"Your actions speak for themselves.","jump":null},{"id":"m_ex_absolut_04_30","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_30","text":"You landed headshot after headshot today,","jump":null},{"id":"m_ex_absolut_04_31","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_31","text":"even on several Lord-class Raptures.","jump":null},{"id":"m_ex_absolut_04_32","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_32","text":"The moment they popped their heads out, you took them out.","jump":null},{"id":"m_ex_absolut_04_33","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_33","text":"I was surprised myself.","jump":null},{"id":"m_ex_absolut_04_34","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_34","text":"I don't know how we'd fight without you.","jump":null},{"id":"m_ex_absolut_04_35","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_35","text":"Oh,","jump":null},{"id":"m_ex_absolut_04_36","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_36","text":"well...","jump":null},{"id":"m_ex_absolut_04_37","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_37","text":"that's only because I've got you as backup.","jump":null},{"id":"m_ex_absolut_04_38","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_38","text":"Hehe.","jump":null},{"id":"m_ex_absolut_04_39","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_39","text":"Don't thank me, thank Eunhwa for her meticulous plan.","jump":null},{"id":"m_ex_absolut_04_40","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_40","text":"It worked perfectly.","jump":null},{"id":"m_ex_absolut_04_41","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_41","text":"Yes!","jump":null},{"id":"m_ex_absolut_04_42","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_42","text":"You're both amazing.","jump":null},{"id":"m_ex_absolut_04_43","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_43","text":"Bah.","jump":null},{"id":"m_ex_absolut_04_44","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_44","text":"Save your flattery for Weakling.","jump":null},{"id":"m_ex_absolut_04_45","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_45","text":":/","jump":null},{"id":"m_ex_absolut_04_46","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_46","text":"But I mean it...","jump":null},{"id":"m_ex_absolut_04_47","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_47","text":"You saved me and Emma multiple times","jump":null},{"id":"m_ex_absolut_04_48","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_48","text":"with your long-range sniping.","jump":null},{"id":"m_ex_absolut_04_49","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_49","text":"All right, Weakling,","jump":null},{"id":"m_ex_absolut_04_50","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_50","text":"what's our next course of action?","jump":null},{"id":"m_ex_absolut_04_51","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_51","text":"Aw, you really are shy, Eunhwa.","jump":null},{"id":"m_ex_absolut_04_52","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_52","text":"Look at you changing the subject because you're embarrassed.","jump":null},{"id":"m_ex_absolut_04_53","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_53","text":"I think I know why you're all considered the best.","jump":null},{"id":"m_ex_absolut_04_54","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_54","text":"Oh my, really?","jump":null},{"id":"m_ex_absolut_04_55","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_55","text":"Why do you think that is?","jump":null},{"id":"m_ex_absolut_04_56","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_56","text":"Because you all care for each other.","jump":"m_ex_absolut_04_58"},{"id":"m_ex_absolut_04_57","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_57","text":"Because you're all so strong as individuals.","jump":"m_ex_absolut_04_67"},{"id":"m_ex_absolut_04_58","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_58","text":":0","jump":null},{"id":"m_ex_absolut_04_59","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_59","text":"I think so too!","jump":null},{"id":"m_ex_absolut_04_60","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_60","text":"Hehe, you're right.","jump":null},{"id":"m_ex_absolut_04_61","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_61","text":"We're well aware of each other's strengths and weaknesses.","jump":null},{"id":"m_ex_absolut_04_62","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_62","text":"Bah.","jump":null},{"id":"m_ex_absolut_04_63","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_63","text":"You're being naïve.","jump":null},{"id":"m_ex_absolut_04_64","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_64","text":"If our individual abilities were strong,","jump":null},{"id":"m_ex_absolut_04_65","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_65","text":"we wouldn't need any support in the first place.","jump":null},{"id":"m_ex_absolut_04_66","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_66","text":"That means that we have plenty of room for improvement.","jump":"m_ex_absolut_04_76"},{"id":"m_ex_absolut_04_67","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_67","text":"Is that so?","jump":null},{"id":"m_ex_absolut_04_68","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_68","text":"Hmm... maybe.","jump":null},{"id":"m_ex_absolut_04_69","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_69","text":"If I had gone in there alone,","jump":null},{"id":"m_ex_absolut_04_70","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_70","text":"I don't think","jump":null},{"id":"m_ex_absolut_04_71","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_71","text":"I would have come back.","jump":null},{"id":"m_ex_absolut_04_72","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_72","text":"Weakling,","jump":null},{"id":"m_ex_absolut_04_73","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_73","text":"do you even have eyes on your head?","jump":null},{"id":"m_ex_absolut_04_74","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_74","text":"We still have a long way to go as a team, let alone our individual abilities.","jump":null},{"id":"m_ex_absolut_04_75","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_75","text":"It may be hard to hear, but that's how it is.","jump":"m_ex_absolut_04_76"},{"id":"m_ex_absolut_04_76","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_76","text":"I disagree. I think Absolute is already amazing as is.","jump":null},{"id":"m_ex_absolut_04_77","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_77","text":":0","jump":null},{"id":"m_ex_absolut_04_78","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_78","text":"Wow, really?","jump":null},{"id":"m_ex_absolut_04_79","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_79","text":"Looking forward to you all impressing me even more in the future.","jump":null},{"id":"m_ex_absolut_04_80","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_80","text":"Of course.","jump":null},{"id":"m_ex_absolut_04_81","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_81","text":"We don't need your approval. We'll do our job commendably regardless.","jump":null},{"id":"m_ex_absolut_04_82","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_82","text":"Naturally.","jump":null},{"id":"m_ex_absolut_04_83","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_04_83","text":"That concludes our return report.","jump":null},{"id":"m_ex_absolut_04_84","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_04_84","text":"Get some rest.","jump":null},{"id":"m_ex_absolut_04_85","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_04_85","text":"We will.","jump":null},{"id":"m_ex_absolut_04_86","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_04_86","text":"Same to you, Commander.","jump":null}],"chat":true}