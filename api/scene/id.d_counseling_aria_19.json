{"id":"d_counseling_aria_19","cat":"counsel","group":{"id":"char5070","label":"Aria"},"label":"Advising Aria: 19","stage":null,"prev":"d_counseling_aria_18","next":"d_counseling_aria_20","speakers":{"aria":"Aria"},"icons":{"aria":"si_c432_00_s"},"lines":[{"id":"d_counseling_aria_19_1","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_19_1","text":"Maestro, have you ever hit a snag before?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["aria"],"affinity":"_0"},{"id":"d_counseling_aria_19_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_19_2","text":"Of course, it's common.","jump":"d_counseling_aria_19_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_aria_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_19_3","text":"I don't think I have.","jump":"d_counseling_aria_19_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_aria_19_4","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_19_4","text":"Hitting a bottleneck prevents you from progressing any further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_19_5","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_19_5","text":"However, once you manage to get past them, you're better off for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_19_6","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_19_6","text":"When you think about it, they're actually a great learning opportunity.","jump":"d_counseling_aria_19_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_19_7","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_19_7","text":"... Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_19_8","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_19_8","text":"Maybe it's because you always try to avoid them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_19_9","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_19_9","text":"By going around them though, you may be missing a chance to become better at what you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_19_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_aria_19_10","text":"Aria and I discussed different methods of self-improvement.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}