{"id":"d_main_49_05","cat":"main","group":{"id":"ch49","label":"Chapter 49 · Final Battle"},"label":"Black Moon","stage":"49-24 STAGE · End","prev":"d_main_49_04","next":"d_main_49_06","speakers":{"marian_queen":"Marian","mirror_r":"Mirror"},"icons":{"marian_queen":"si_c019_00_s","mirror_r":"si_c982_00_s"},"lines":[{"id":"d_main_49_05_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_05_1","text":"In the black void, Marian floats as she stares at the statue.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"bgm_story_chapter49_voidofharmony","movie":null,"shown":["marian_queen"],"affinity":null},{"id":"d_main_49_05_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_05_2","text":"It doesn't move at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_05_3","text":"With a sigh of relief, Marian continues watching the statue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_4","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_4","text":"I wonder how long I can keep this up...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_5","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_5","text":"Not long, I'd say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mirror_r"],"affinity":null},{"id":"d_main_49_05_6","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_6","text":"You...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_7","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_7","text":"Nice to meet you, Marian. The fake Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_8","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_8","text":"I'm Mirror. I'm the one who made you into what you are today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_9","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_9","text":"Oh, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_10","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_11","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_11","text":"Is that all you have to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_12","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_12","text":"Yes. I have nothing else to say to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_13","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_13","text":"Although I would like to thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_14","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_14","text":"It's thanks to you that I can go up against that thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_15","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_15","text":"Hehe. You're the same person who was so scared, you just stood there while your gene was stolen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_16","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_16","text":"How did you become capable of doing all this in that form?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_17","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_17","text":"I don't see any reason to tell you that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_18","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_18","text":"You're not even human, Nikke, Rapture, or anything else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_19","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_20","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_20","text":"This is my world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_21","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_21","text":"In this space, the only rules that apply are the ones I make.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_22","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_22","text":"That means a person can't control their body here as they normally would unless I allow it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_23","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_23","text":"They can't blink, speak, or even breathe as they please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_24","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_24","text":"But seeing how you're able to speak to me so freely...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_25","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_25","text":"That must mean you're not actually anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_26","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_26","text":"... Call me a digital lifeform.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_27","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_27","text":"A \"digital lifeform\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_28","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_28","text":"Aren't you just a hologram?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_29","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_30","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_30","text":"So what do you want with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_31","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_31","text":"If you just want to talk, I'll hear you out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_32","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_32","text":"Not that you can do anything else here anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_33","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_33","text":"Close this space and surrender the gene to the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_34","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_34","text":"And what do I get out of it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_35","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_35","text":"I'll allow you to watch by the Queen's side as she creates a new world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_36","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_36","text":"And who are you to promise that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_37","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_37","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_38","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_38","text":"Are you one of its elites or strategists?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_39","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_39","text":"Has that thing ever given you any orders directly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_40","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_40","text":"Has it ever acted on one of your suggestions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_41","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_41","text":"I doubt it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_42","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_42","text":"Because that thing must be feeling the exact same disgust I feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_43","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_43","text":"After all, we're both Queens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_44","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_45","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_45","text":"You're not anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_46","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_46","text":"Not in the world I create, nor in the world that thing creates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_47","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_47","text":"We have no need for a being like you, if you can even be called that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_48","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_48","text":"You're just some unknown thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_49","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_49","text":"Acting like you've come to offer me a deal from the other side, as if you're doing me a favor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_50","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_50","text":"Don't you find it absurd?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_51","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_51","text":"Hehe. That's rather harsh, considering we've only just met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_52","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_52","text":"Except this isn't our first time meeting, is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_53","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_53","text":"It's hazy, but I remember your face, and your voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_54","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_54","text":"It's very... unpleasant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_55","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_55","text":"I'm glad you remember. It must mean I gave you an unforgettable memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_56","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_56","text":"What you said earlier left quite an impression on me. You claim the Queen finds me unpleasant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_57","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_57","text":"I've served as the Queen's strategist for a long—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_58","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_58","text":"Do you know what kind of world it's trying to create?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_59","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_60","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_60","text":"Of course you don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_61","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_61","text":"Yet you call yourself its strategist? Hilarious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_62","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_62","text":"If you have nothing else to say to me, then how about you go help restore its abilities or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_63","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_63","text":"That's your job as its strategist, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_64","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_64","text":"You... You're going to fail spectacularly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_65","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_65","text":"Bold words from someone who can't fail because they don't really exist. I'll keep them in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_66","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_66","text":"Though I suppose a curse coming from such a nothing also means nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_67","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_67","text":"Oh, before you go, there's one thing I'd like to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_68","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_68","text":"What were you even trying to accomplish?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_69","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_69","text":"It's not like you can have any influence on anyone if they just cover their ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_70","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_71","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_49_05_71","text":"Hehe. Very well. Say whatever you please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_72","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_05_72","text":"Mirror disappears into the darkness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_73","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_05_73","text":"Marian feels an inexplicable sense of relief and turns to look at the Goddess of Victory statue shrouded in darkness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_74","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_05_75","type":"Speech","speaker":"marian_queen","key":"Locale_MainScenario:d_main_49_05_75","text":"What kind of world are you trying to create?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null