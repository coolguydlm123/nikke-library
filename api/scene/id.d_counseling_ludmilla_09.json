{"id":"d_counseling_ludmilla_09","cat":"counsel","group":{"id":"char5033","label":"Ludmilla"},"label":"Advising Ludmilla: 09","stage":null,"prev":"d_counseling_ludmilla_08","next":"d_counseling_ludmilla_10","speakers":{"ludmilla":"Ludmilla"},"icons":{"ludmilla":"si_c190_00_s"},"lines":[{"id":"d_counseling_ludmilla_09_1","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_09_1","text":"Andersen has something of a soft spot for you.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ludmilla"],"affinity":"_0"},{"id":"d_counseling_ludmilla_09_2","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_09_2","text":"Did you already know this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_09_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_09_3","text":"I'd rather have the affection of someone else.","jump":"d_counseling_ludmilla_09_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ludmilla_09_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_09_4","text":"No, and I don't want to know.","jump":"d_counseling_ludmilla_09_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ludmilla_09_5","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_09_5","text":"A-ha! Well, I know he is not your type.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_09_6","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_09_6","text":"However, his affection does offer you more material benefits, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_09_7","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_09_7","text":"So long as you don't despise him for feeling that way.","jump":"d_counseling_ludmilla_09_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_09_8","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_09_8","text":"Oh, my. You hate it to the point that you don't want to even know about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_09_9","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_09_9","text":"I had no idea you despised Andersen with such fervor!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_09_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_09_10","text":"I spend time with Ludmilla talking about Andersen.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}