ll,"movie":null,"shown":["bahamut"],"affinity":null},{"id":"d_main_41_02_79","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_79","text":"The brainy Bahamut remembers saying so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_80","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_41_02_80","text":"What is this thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_81","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_81","text":"It's a device which I control. My brain isn't the only thing that is exceptional.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_82","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_82","text":"If you move any further, I will cause this thing to roll and crush you flat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_83","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_83","text":"Unless you can fly, there is no escaping it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_84","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_84","text":"She's right. If this massive round pillar rolled toward me, there's no way I could avoid it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_85","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_85","text":"Especially something of such imposing height and length.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_86","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_86","text":"I look back.","jump":null,"exit":false,"enter":null,"bg":"WhiteArk_2","bgArt":"whiteark_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_87","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_87","text":"I look at the white city once more. If the buildings could serve as obstacles...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_88","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_88","text":"You keep looking around. Trying to ascertain an escape route?","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_89","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_89","text":"It's good to think. \nContemplate as much as you want, and seek the truth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_90","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_41_02_90","text":"... This is an impressive pillar. Can I touch it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_91","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_91","text":"Permission denied. Levi warned me never to let you touch anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_92","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_92","text":"Especially since you're in possession of the Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_93","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_93","text":"I clench my fist, digging my fingernails deep into my palm, until I feel blood trickling out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_94","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_94","text":"I swing my arm and fling my blood at the black pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_02_95","text":"*Woosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_96","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_96","text":"Tendrils of blue flame erupt across the pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_97","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_97","text":"Not a single drop of blood came into contact with the pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_98","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_98","text":"With that act, you've revealed your true intent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_99","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_99","text":"Die, Young Man.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_100","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_100","text":"The blue flaming pillar slowly begins to move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_101","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_101","text":"It rolls directly towards me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_102","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_102","text":"I turn and sprint as fast as I can.","jump":null,"exit":false,"enter":null,"bg":"WhiteArk_2","bgArt":"whiteark_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_103","type":"Speech","speaker":"bahamut","key":"Locale_MainScenario:d_main_41_02_103","text":"There's no point in running.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_104","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_104","text":"I glance back as I run.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_105","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_105","text":"The buildings are useless as obstacles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_106","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_106","text":"The blue-flamed pillar mercilessly crushes everything in its path as it barrels forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_107","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_107","text":"The vibrations, heat, and the roaring sound feel as if they're right behind me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_108","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_108","text":"Suddenly, I feel myself gently floating off the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_109","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_41_02_109","text":"Blindly choosing to flee like that is almost impressive in its own way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liberalio"],"affinity":null},{"id":"d_main_41_02_110","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_41_02_110","text":"Liberalio!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_111","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_111","text":"Liberalio is flying as she holds my hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_112","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_41_02_112","text":"We're escaping like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_113","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_41_02_113","text":"Good! Let's get—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_114","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_114","text":"The heat suddenly intensifies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_115","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_115","text":"The massive rolling pillar that had been flattening everything in its path now stands upright before us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_116","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_116","text":"It then tilts towards us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_117","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_41_02_117","text":"So, it wasn't just a road roller after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_118","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_41_02_118","text":"Hold tight, Human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_119","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_119","text":"The air ripples, as water begins to gather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_120","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_120","text":"Then, a torrent of water launches straight at the pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_121","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_02_121","text":"*Boom*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_122","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_122","text":"A massive stream of water batters the fiery pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_123","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_123","text":"Steam bursts forth, and the pillar tilts toward the Furnace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_124","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_124","text":"In an instant, it shrinks and returns to Bahamut's side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["bahamut"],"affinity":null},{"id":"d_main_41_02_125","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_41_02_125","text":"Bahamut stares at us intently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_126","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_41_02_126","text":"Looks like she's unable to pursue us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_02_127","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_41_02_127","text":"I'll land us somewhere safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}