Counseling:d_counseling_eh_02_7","text":"Because you're afraid of death.","jump":"d_counseling_eh_02_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eh_02_8","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_02_8","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_02_9","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_02_9","text":"My previous body was weak and would eventually decay. I wouldn't have been able to fully wash away the sins I committed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_02_10","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_02_10","text":"Of course, I'm not confident I can really atone for everything just because I changed bodies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_02_11","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_02_11","text":"All I can do is to work at it tirelessly.","jump":"d_counseling_eh_02_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_02_12","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_02_12","text":"... I am afraid of death, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_02_13","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_02_13","text":"But after all the wrong I did, dying comfortably...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_02_14","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_02_14","text":"... felt too irresponsible to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_02_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_eh_02_15","text":"I talk with E.H. about why she became a Nikke.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}