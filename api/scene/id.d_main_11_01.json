MainScenario:d_main_11_01_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_11_01_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_8","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_11_01_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_11_01_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_10","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_01_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_11_01_11","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_11_01_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_11_01_12","text":"There's more of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_13","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_13","text":"We nearly bought the farm back there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_14","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_14","text":"Our batteries couldn't have picked a worse time to die on us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_15","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_15","text":"Thanks for sharing those emergency batteries with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_16","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_16","text":"You idiots. You didn't bother to check your batteries before coming up to the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_17","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_17","text":"Other than our core, we can also use electricity as auxiliary power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_18","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_18","text":"There are more things we need to be concerned about compared to regular Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_19","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_19","text":"The real reason is because we came straight here after finishing another mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_11_01_20","text":"Isn't that a little reckless?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_21","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_21","text":"When did Syuen ever care about our safety? We're just following orders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_22","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_22","text":"Ha! Following orders, no questions asked. We might as well be sheep!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_23","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_23","text":"You say something to Syuen then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_24","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_24","text":"No way, she freaks me out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_25","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_25","text":"... Ugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_26","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_26","text":"Enough. Self-control is one of the tenets to becoming a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_27","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_27","text":"No matter how tiring or difficult things get, the enemy will never wait for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_11_01_28","text":"In that case, you wouldn't make the cut as a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_29","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_29","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_30","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_30","text":"Being criticized by a regular Nikke! We still have a long way to go!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_31","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_31","text":"All right, everyone! Special training once we head back down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_32","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_32","text":"It's extra batteries we need, not special training.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_33","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_33","text":"We mustn't rely solely on our equipment! Justice comes from within!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_11_01_34","text":"Justice this, justice that... You sound like you came out of a comic book.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon","emma"],"affinity":null},{"id":"d_main_11_01_35","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_11_01_35","text":"My goodness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_36","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_36","text":"What a large weapon you have there...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_37","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_37","text":"Give it to me! Right now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_38","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_11_01_38","text":"Sorry, it's not mine to give.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_39","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_39","text":"The thought saddens me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_40","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_40","text":"Everyone, shut up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_41","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_41","text":"Tell me, why are Missilis lackeys like you tailing us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_42","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_42","text":"Syuen ordered us to follow you and provide necessary assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_43","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_43","text":"That's the funniest thing you've said yet. You expect me to believe that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_44","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_44","text":"Oh well, I've always been a terrible liar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_45","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_45","text":"Why are you here, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_46","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_46","text":"To collect the Heretic fragments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_11_01_47","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_01_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_11_01_48","text":"I guess the information got leaked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["emma"],"affinity":null},{"id":"d_main_11_01_49","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_49","text":"More like we uncovered it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["emma"],"affinity":null},{"id":"d_main_11_01_50","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_50","text":"Missilis has an intelligence department dedicated to Absolute. We get reports on what you are doing and your whereabouts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_51","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_51","text":"We came to investigate why you were heading in this direction, and","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_52","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_52","text":"we came to the conclusion that this must be the place where you had the clash with the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_53","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_53","text":"Even the flames have died down. It's rather obvious when you think about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["emma"],"affinity":null},{"id":"d_main_11_01_54","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_54","text":"Syuen sent us after she realized you were after the Heretic fragments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_55","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_11_01_55","text":"Wow. Look how much attention we are getting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_56","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_56","text":"Don't you have anything better to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_57","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_57","text":"Hey now, don't sneeze at intel.\nIt's the building block of any solid plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_58","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_58","text":"There's no need to belabor the point. Let's just get some sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_59","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_59","text":"We've got a long, hard search ahead of us tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_60","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_60","text":"Hey. Don't act like you've joined us or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_61","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_01_61","text":"Ouch...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_62","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_11_01_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_63","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_63","text":"Someone give me a pillow! I can't sleep without one!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_64","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_11_01_64","text":"We don't even have pillows for ourselves!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_65","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_65","text":"Then there's nothing I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_66","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_66","text":"Guess I don't have a choice then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_67","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_01_67","text":"Ouch...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_68","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_68","text":"I'll be on night watch. It's a hero's duty to protect the weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_69","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_69","text":"You are all safe with me, so sleep well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_70","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_01_70","text":"Ouch...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_01_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_11_01_71","text":"Unbelievable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}