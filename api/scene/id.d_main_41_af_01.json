{"id":"d_main_41_af_01","cat":"main","group":{"id":"ch41","label":"Chapter 41 · Birth"},"label":"Baby Star","stage":null,"prev":"d_main_41_09","next":"d_main_41_af_02","speakers":{"mrsmiss":"Mrs. Miss","anis":"Anis","prika":"Prika","mint":"Mint"},"icons":{"mrsmiss":"si_c9003_00_s","anis":"si_c012_00_s","prika":"si_c601_01_s","mint":"si_c600_01_s"},"lines":[{"id":"d_main_41_af_01_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_41_af_01_1","text":"In the Ark, at T.T. STAR's practice room.","jump":null,"exit":false,"enter":null,"bg":"dancepracticeroom","bgArt":"dancepracticeroom","image":null,"bgm":"bgm_story_sogood","movie":null,"shown":["mrsmiss","anis","mint","prika"],"affinity":null},{"id":"d_main_41_af_01_2","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_2","text":"All right. That's all for today's session.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_3","text":"Wh-what do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_4","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_4","text":"Was it a little better than yesterday?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_5","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_5","text":"You've improved performance wise, but I'm not sure about everything else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_6","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_6","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_7","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_7","text":"I've been keeping a close eye on everything you've done these past few days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_8","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_8","text":"And you girls...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_10","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_11","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_12","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_12","text":"You're ordinary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_marrybad","movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_13","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_13","text":"Too ordinary, in fact. There are no fatal flaws in your performance, but there's also nothing that stands out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_14","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_14","text":"For a small-time group, you're outstanding, but as far as the big leagues are concerned...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_15","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_15","text":"Perhaps with enough money and some luck, you might land a chance to have a debut performance, but that's about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_16","text":"Oh... I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_17","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_17","text":"Are we really that bad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_18","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_18","text":"You're not bad. \nIt's just that you're not exceptional.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_19","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_19","text":"As you all know, being ordinary in this industry—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_20","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_20","text":"Just doesn't cut it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_21","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_21","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_22","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_22","text":"Still, you're decent enough for a one-off performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_23","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_23","text":"I think we can make it work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_24","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_24","text":"This was a one-and-done for you guys anyway, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_25","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_25","text":"Then I don't see any problem with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_26","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_26","text":"... I want to keep going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_27","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_27","text":"You do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_28","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_28","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_29","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_29","text":"This isn't a matter of hard work alone. You have to have innate talent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_30","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_30","text":"Then do I... no, do we, have no future in this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_31","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_31","text":"No, you don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_32","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_32","text":"... Is what I would typically say, but talent is a fickle thing. Sometimes, it can blossom without warning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_33","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_33","text":"Of course, it'll never take shape if you lie around doing nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_34","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_34","text":"However, if you keep working hard and polishing yourselves, you might shine eventually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_35","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_35","text":"I understand what you're getting at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_36","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_36","text":"We'll work hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_37","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_37","text":"Heh. Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_38","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_38","text":"The song and choreography will be done soon. \nAnd the stage planning will be complete as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_39","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_39","text":"Oh, and reservations have already opened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_40","text":"Reservations? What reservations?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_41","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_41","text":"What else? For the concert.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_42","text":"Huh? A-already?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_43","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_43","text":"Didn't you say time is of the essence? Then there's no reason to hesitate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_44","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_44","text":"Besides, you only have a few songs, plenty of time for you to practice still. There's no need to worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_45","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_46","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_46","text":"Did you receive money from those reservations?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_47","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_47","text":"Of course I did. There's no such thing as a free concert.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_48","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_48","text":"But we've been on hiatus for so long... will anyone even be willing to pay to come see us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_49","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_49","text":"Ah, so you're saying we shouldn't charge anything just to get more people to come?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_50","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_50","text":"I know that pulling these things off costs a lot of money, but perhaps if you lowered the price somewhat...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_51","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_51","text":"Money isn't the problem. I mean, it is a problem, but it isn't a deciding factor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_52","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_52","text":"You don't seem to realize the danger of handing out free tickets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_53","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_53","text":"Any Tom, Dick, and Harry could show up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_54","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_54","text":"Your haters could snatch up every seat in the worst case scenario.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_55","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_55","text":"An empty stadium, or one full of haters. Which would you prefer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_56","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_57","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_57","text":"We need to charge money. It's for your own mental well-being. Got it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_58","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_58","text":"... Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_59","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_59","text":"All right. Let's have some tea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_60","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_60","text":"Huh? But what about practice?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_61","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_61","text":"Forget it for now. The song and choreography aren't even ready yet, so there's no point wasting your energy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_62","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_62","text":"Besides, I have something to tell you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_63","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_63","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_64","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_64","text":"Mustang had a video of you all on his phone, and it piqued my interest. That's why I decided to help.","jump":null,"exit":false,"enter":null,"bg":"Cafe","bgArt":"cafe","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_65","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_65","text":"I wanted to see the shining stars of the Ark with my own eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_66","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_66","text":"The first day I watched you sing and dance, I was certain about something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_67","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_67","text":"Instead of shining stars, you're fallen stars.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_68","text":"... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_69","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_69","text":"Well, considering you produced for Pretty, it's obvious that we'll never measure up to your standards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_70","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_70","text":"Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_71","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_71","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_72","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_72","text":"See? This is how most people would put it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_73","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_73","text":"So you think Pretty's singing and dancing were brilliant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_74","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_74","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_75","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_75","text":"Even back then, Pretty wasn't at a level you'd call great, let alone now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_76","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_76","text":"And yet everyone went wild for her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_77","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_77","text":"That's because she was the star of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_78","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_78","text":"Are you saying her character is what made her popular?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_79","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_79","text":"It's not that simple. Pretty was a symbol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_80","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_80","text":"A symbol that represented all Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_81","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_81","text":"Ridiculous claims suggested that Nikkes were the reason our efforts to reclaim the surface failed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_82","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_82","text":"Nikkes were eventually ostracized from the Ark when Nikkephobia reached its peak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_83","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_83","text":"But Pretty was the symbol that brought Nikkes back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_84","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_84","text":"She became a hero who closed the distance between humans and Nikkes again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_85","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_85","text":"She was an idol in more ways than one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_86","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_86","text":"A star who mesmerized all who saw her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_87","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_87","text":"Even I was captivated by this start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_88","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_89","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_89","text":"Anyway, let's save this gloomy talk of the past for later, over a drink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_90","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_90","text":"I've been wondering what Mustang saw in you, for him to go this far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_91","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_91","text":"So I did a little digging.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_92","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_92","text":"... There's probably nothing left to find.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_93","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_93","text":"I used an agency. Experts in background checks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_94","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_94","text":"Nothing ever fully disappears. Traces are always left behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_95","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_95","text":"... So, what did you find?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_96","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_97","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_97","text":"The Ark's \"Smile Time\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_98","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_98","text":"I had no idea that was you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_99","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_99","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_100","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_101","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_101","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_102","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_102","text":"You guys weren't just bullied by haters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_103","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_103","text":"You were being mistreated by countless people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_104","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_104","text":"Then again, knowing Mustang, that's what he would have done at the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_105","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_105","text":"That's why there aren't any traces left behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_106","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_106","text":"To test my theory, I made a post containing the words \"Smile Time\", and it was deleted within two seconds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_107","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_107","text":"Not only that, but I was promptly contacted by Tetra's legal team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_108","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_108","text":"Your nickname itself is a forbidden word. A total taboo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_109","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_109","text":"People even died. Two of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_110","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_110","text":"... I-I have to use the restroom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_111","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_111","text":"Please... please excuse me for a moment too...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_112","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_112","text":"Sit down and listen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_113","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_113","text":"... What is it that you want to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_114","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_114","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_115","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_115","text":"You guys were the Ark's playthings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_116","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_116","text":"You had to smile no matter what anyone did to you. Literally, \"Smile Time\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_117","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_117","text":"A cruel concept, no doubt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_118","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_118","text":"How long are you going to keep talking about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_119","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_119","text":"The people who did that to you are alive and well, peacefully living their lives inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_120","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_120","text":"There were so many of them that it was impossible to identify any of them individually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_121","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_121","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_122","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_122","text":"Will you be able to sing and dance for those people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_123","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_123","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_124","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_124","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_125","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_125","text":"I can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_126","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_41_af_01_126","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_127","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_127","text":"Because there are far more people who love us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_128","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_128","text":"Way more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_129","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_129","text":"We're singing and dancing for those people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_130","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_41_af_01_130","text":"I don't care about the others. They're garbage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_131","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_131","text":"Anis...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_132","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_132","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_133","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_133","text":"I can do it too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_134","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_134","text":"Like Anis said, there are far more people out there who love us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_135","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_41_af_01_135","text":"And besides, I've got these two by my side, and that's enough for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_41_af_01_136","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_41_af_01_136","text":"The same goes for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_mai