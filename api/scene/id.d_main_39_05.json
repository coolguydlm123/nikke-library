bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_62","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_62","text":"For a long while, I just stand there, staring in a trance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_63","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_63","text":"The monk slowly opens their eyes and meets my gaze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_64","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_64","text":"They're looking over here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_65","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_65","text":"The monk unfolds their legs and stands upright.","jump":null,"exit":false,"enter":null,"bg":"RaptilionFarm","bgArt":"raptilionfarm","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_66","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_66","text":"They begin to walk toward me slowly, holding my gaze the entire time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nayuta_unknown"],"affinity":null},{"id":"d_main_39_05_67","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_67","text":"How strange. They're clearly walking slowly, yet the distance between us closes almost instantly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_68","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_68","text":"We all watch the monk approach us, as if spellbound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_69","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_69","text":"The monk stops in front of us","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["maxwell_p","rapi_red","laplace_p","drake_p"],"affinity":null},{"id":"d_main_39_05_70","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_70","text":"and stares intently at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_71","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_72","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_72","text":"Haha. Well now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_73","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_73","text":"Never did I dream I would encounter a noble hero in so remote a place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_74","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_74","text":"'Tis an honor to make thy acquaintance, Great Hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_75","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_75","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_76","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_76","text":"I have heard countless tales from the Forerunners themselves, as though mine ears were worn to the bone, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_77","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_77","text":"Ah, and by \"Forerunners\" I do mean White Snow, Persinette, and Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_78","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_78","text":"What are those? Names of bandit guilds or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_79","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_79","text":"I at least understood Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_80","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_81","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_81","text":"Are you talking about the Pioneer Squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_82","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_82","text":"Indeed, it is so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_83","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_83","text":"You know the Pioneers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_84","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_84","text":"Nay, to say I merely know them would be a disservice, for I am the fourth member of the Forerunners.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_85","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_85","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_86","type":"Speech","speaker":"nayuta_unknown","key":"Locale_MainScenario:d_main_39_05_86","text":"This humble one is called Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_87","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_05_87","text":"Once more, it is a great honor to behold thee, Great Hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}