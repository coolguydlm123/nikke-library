{"id":"d_main_39_05","cat":"main","group":{"id":"ch39","label":"Chapter 39 · Gene"},"label":"Monk in the Sky","stage":"39-17 STAGE · Start","prev":"d_main_39_04","next":"d_main_39_06","speakers":{"maxwell_p":"Maxwell","rapi_red":"Rapi","laplace_p":"Laplace","drake_p":"Drake","nayuta_unknown":"???","nayuta_n":"Nayuta"},"icons":{"maxwell_p":"si_c105_00_s","rapi_red":"si_c016_00_s","laplace_p":"si_c103_00_s","drake_p":"si_c104_00_s","nayuta_unknown":"si_c9008_00_s","nayuta_n":"si_c9008_00_s"},"lines":[{"id":"d_main_39_05_1","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_1","text":"Huh. It is a vegetable garden after all.","jump":null,"exit":false,"enter":null,"bg":"RaptilionFarm","bgArt":"raptilionfarm","image":null,"bgm":"bgm_chapter39_field_gliding","movie":null,"shown":["maxwell_p","rapi_red","laplace_p","drake_p"],"affinity":null},{"id":"d_main_39_05_2","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_2","text":"It's small, but it's got everything you need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_3","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_3","text":"Doesn't exactly explain what it's doing here on Whaley's back, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_4","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_5","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_6","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_6","text":"What's wrong with you guys? You haven't said a word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_7","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_7","text":"Cat got your tongue?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_8","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_9","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_10","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_10","text":"Is there maybe something wrong with those upgraded components of yours?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_11","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_11","text":"My throat... is so hoarse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_12","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_12","text":"I... I'm losing my voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_13","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_14","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_14","text":"I think we may have screamed a little too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_15","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_15","text":"Pssh. With vocal cords that weak, what kind of hero are you supposed to be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_16","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_16","text":"I've fallen short. I vow to train harder so I can raise my voice more powerfully going forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_17","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_17","text":"Personally, I'm happy with how my voice sounds. Doesn't it make me sound more villainous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_18","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_18","text":"Mwahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_19","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_19","text":"*Cough cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_20","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_20","text":"I don't even have the energy to respond.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_21","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_21","text":"Still, it's a relief. Things should quiet down a bit now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_22","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_22","text":"Commander, any luck reaching Raptilion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_23","text":"No, he's not even checking his messages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_24","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_24","text":"Maybe he's not here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_25","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_25","text":"I don't think that's the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_26","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_26","text":"For all we know, Leviathan and Ziz might've already taken him down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_27","text":"Negative.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_28","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_28","text":"At least, it's hard to imagine Raptilion dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_29","text":"That's true. He seems like someone who would live forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_30","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_30","text":"I'd guess Raptilion's either inside Whaley or outside on its back. The same goes for Leviathan and Ziz.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_31","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_31","text":"All right then, let's make an opening, head inside, and investigate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_32","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_32","text":"Absolutely not! A hero could never condone such reckless methods. *Cough cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_33","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_33","text":"Not even a villain would do such a thing. *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_34","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_34","text":"Would you speak up? I can't hear either of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_35","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_36","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_05_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_37","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_37","text":"Man, it feels nice to say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_38","text":"Drilling a hole would hurt Whaley. Raptilion wouldn't be happy about that either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_39","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_39","text":"Well then, all we can do is keep walking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_40","text":"I'm guessing Raptilion made this garden to survive up here on Whaley.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_41","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_41","text":"He must have done something with the soil, but I wonder how he watered it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_42","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_05_42","text":"With sh-sheer determination...! *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_05_43","text":"No need to strain yourself just to say something weird.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_44","text":"It's too well maintained to have relied solely on rainfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_05_45","text":"*Pitter-patter*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_46","text":"Raindrops begin pouring from the sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_47","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_47","text":"Huh? It's raining? But the sky's so clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_48","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_48","text":"... Don't tell me this isn't rain. Could it be... something toxic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_49","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_50","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_05_50","text":"Visual at 10 o'clock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_51","text":"I look in the direction that Rapi is pointing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_52","text":"A pillar rises from Whaley's back, spraying water high into the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_05_53","text":"The water fans out above and rains down across Whaley's back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_54","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_05_54","text":"A sprinkler?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_05_55","type":"Speech","speaker":"rapi_red","key"