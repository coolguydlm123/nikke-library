{"id":"event_arkguardian1_01_s","cat":"event","group":{"id":"ev40098","label":"ARK GUARDIAN · Part 1"},"label":"Young One: A","stage":null,"prev":"event_arkguardian1_prologue","next":"event_arkguardian1_01_e","speakers":{"hongryeon_o":"Scarlet","dorothy":"Dorothy","rapunzel_o":"Rapunzel"},"icons":{"hongryeon_o":"si_c225_00_s","dorothy":"si_c233_00_s","rapunzel_o":"si_c966_00_s"},"lines":[{"id":"event_arkguardian1_01_s_1","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_1","text":"Hath there yet been any word from Lilith or the Commander?","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":"event_bgm_wm_outskirts","movie":null,"shown":["dorothy","hongryeon_o","rapunzel_o"],"affinity":null},{"id":"event_arkguardian1_01_s_2","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_2","text":"Not yet, no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_3","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_3","text":"I am worried. It is the first time we've experienced such prolonged silence from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_4","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_4","text":"I doubt there'll be any trouble. Not with those two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_5","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_5","text":"That may be true, but considering the circumstances...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_6","text":"We've been staying in contact with the United Forces of Humanity... or rather, the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_7","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_7","text":"They're saying something unexpected came up, so it's hard to get in touch with them right now. For the time being, we'll just have to take their word for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_8","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_8","text":"And should they still fail to make their appearance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_9","text":"Then we'll just have to storm in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_10","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_10","text":"Pray, what—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_11","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_11","text":"That's rather bold of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_12","text":"You said it yourself; in light of the current situation, those two are indispensable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_13","text":"It's obvious the authorities are hamstringing them with political nonsense again. If they're just stalling, we should get both of them out ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_14","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_14","text":"Methinks thou hast rous'd the slumb'ring beast within thy breast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_15","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_16","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_16","text":"Very well. If the interim chieftain saith so, I have no quarrel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_17","text":"Don't call me that. It makes us sound like a motley crew of mountain bandits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_18","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_18","text":"Alas, this is a most vexing matter indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_19","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_19","text":"Though they did not partake in the battle against Anachiro, that they have not so much as revealed their visages till now is an offence most unpardonable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_20","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_20","text":"Should they present themselves, I shall chastise them soundly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_21","text":"And how exactly are you planning to scold them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_22","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_22","text":"You've already been slammed into the floor and ceiling. There's nowhere left for you to get lodged in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_23","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_24","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_24","text":"Speaking of Anachiro,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_25","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_25","text":"I have a feeling there's more than one Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_26","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_26","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_27","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_27","text":"What giveth thee such a notion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_28","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_28","text":"Those fusion experiments I saw in labs where they create the second generation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_29","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_29","text":"I believe Anachiro was the result of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_30","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_30","text":"They've already cracked the code to fusing Nikkes with Raptures. Anachiro must've been their first successful creation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_31","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_31","text":"And considering how much she's accomplished, there's no way they would stop at only one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_32","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_32","text":"Frankly, if three additional Heretics like Anachiro—no, even just two—were to show up, humanity wouldn't stand a chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_33","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_33","text":"That's precisely why we need Lilith and the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_34","text":"They're steadily growing stronger, while we're over here wearing ourselves down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_35","text":"Unless something big happens that can turn the tide,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_36","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_36","text":"humanity is doomed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_37","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_37","text":"What manner of talk is this? Did we not achieve victory even without the two of them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_38","text":"... Yes, but we had Red Hood with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_39","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_40","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_40","text":"Doth thy heart yet yearn for her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_41","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_41","text":"Yes. If I could, I'd find her and bring her back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_42","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_42","text":"Pray, be not thus. She shone brilliantly and departed of her own free will, with no regrets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_43","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_43","text":"'Tis unbecoming to linger in such moping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_44","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_44","text":"Moping?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_45","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_45","text":"Snow White herself hath maintained a most admirable composu—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_46","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_47","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_48","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_48","text":"Doth she remain as she was?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_49","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_49","text":"Yes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_50","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_50","text":"She spends all her time in the workshop and barely comes out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_51","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_51","text":"I suppose she still hasn't gotten over it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_52","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_52","text":"I can understand how she feels. It's never easy to forget those we've lost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_53","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_s_53","text":"Especially considering it's someone she trusted and admired so deeply... it's only natural she feels this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_54","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_54","text":"All we can do is give her time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_55","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_55","text":"Since we can't truly know what it feels like to lose someone so precious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_56","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_56","text":"I know well how it feels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_57","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_58","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_58","text":"I needs must have a word with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_59","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_59","text":"Leave her be. She needs some time alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_60","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_60","text":"Art thou so soon forgetful of thy own utterance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_61","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_61","text":"We require every able-bodied soul we can gather forthwith, even if just one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_62","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_62","text":"Though it may strike harsh, now is assuredly not the hour for succumbing to despondency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_63","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_63","text":"So must I press them onward, even by force if need be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_64","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_64","text":"I shall take upon myself the part of villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_65","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_66","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_66","text":"Very well. I'll leave that to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_67","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_67","text":"I'm not confident when it comes to such things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_68","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_68","text":"Hah. Methought as much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_69","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_s_69","text":"... What do you mean by that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_s_70","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_s_70","text":"I take my leave, and shall return anon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}