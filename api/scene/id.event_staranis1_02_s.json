finity":null},{"id":"event_staranis1_02_s_6","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_02_s_6","text":"A meat place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_7","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_s_7","text":"Yeah, it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_8","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_s_8","text":"You know how all those Nutrium spots have been opening lately? This one just launched, and they don't have the budget for proper promotion, so the timing lined up perfectly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_9","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_s_9","text":"Two shows a day starting tomorrow, and we'll be doing it for a week.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_10","type":"Speech","speaker":"prika","key":"Locale_MainScenario:event_staranis1_02_s_10","text":"Uh... why a meat place, though...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_11","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_s_11","text":"You'll see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_12","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_02_s_12","text":"Before anything else, what's the pay like?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_13","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_s_13","text":"Pay? As in money?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_14","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_02_s_14","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_15","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_s_15","text":"Don't be too surprised.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_16","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_s_16","text":"They'll be providing their signature Nutrium set meals twice a day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_17","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_02_s_17","text":"... Oh, I'm surprised, all right. Just not for the reason you think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_18","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_02_s_18","text":"Who said anything about wanting free food?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_s_19","type":"Speech","speaker":"prika","key":"Local