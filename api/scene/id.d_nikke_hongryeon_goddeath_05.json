"type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_6","text":"Hehe, I couldn't be better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_7","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_7","text":"Excellent. Then let's get going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_8","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_8","text":"Scarlet gets to her feet and walks over to Cecil and Rapunzel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["hongryeon_g"],"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_9","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_9","text":"Very well. Let us make haste and lend my Lord our aid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_10","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_10","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_thepilgrim","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_11","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_11","text":"Well met, Rapunzel. Thou hast arrived at last.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_12","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_12","text":"Scarlet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_13","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_13","text":"Thou lookest hale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_14","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_14","text":"Mayhap I worried for naught.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_15","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_16","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_16","text":"Scarlet knows all too well","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_17","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_17","text":"what emotion fills Rapunzel's eyes as she gazes at her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_18","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_18","text":"After all, she likely has that same look in her own eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_19","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_19","text":"Yet surely, 'tis too soon for us to trade tales,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_20","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_20","text":"whilst there remains a task yet to be done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_21","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_21","text":"Hm? Why dost thou gaze upon me so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_22","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_22","text":"If thou seekest a tearful reunion, I must disappoint thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_23","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_23","text":"For we did meet again soon after that day, in truth. Hardly a reunion to make such a great fuss over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_24","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_24","text":"And would that not be rather embarrassing? At this point—Mmph!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_25","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_25","text":"Rapunzel pulls Scarlet into a hug.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_26","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_26","text":"... I'm so glad you came back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_27","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_28","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_28","text":"I'm sorry, I've never been reunited with someone like this before, so I'm not quite sure what to make of these feelings...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_29","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_29","text":"... The same holds true for me, I daresay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_30","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_30","text":"Scarlet and Rapunzel head for the Lift.","jump":null,"exit":false,"enter":null,"bg":"SpaceElevator","bgArt":"spaceelevator","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_31","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_31","text":"You're moving faster than I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_lights","movie":null,"shown":["cecil_op_l"],"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_32","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_32","text":"My body doth feel remarkably light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_33","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_33","text":"Hehe, we're also wearing gear that improves our mobility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_34","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_34","text":"Either way, I'm glad you'll be able to join the fight sooner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_35","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_35","text":"We're reaching our destination ahead of schedule.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_36","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_36","text":"I should warn you, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_37","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_37","text":"The closer you get to the Lift, the more unstable the signal will become.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_38","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_38","text":"We'll likely lose contact with you soon after that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_39","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_39","text":"so you'll have to find your own way from there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_40","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_40","text":"Fear not, for we have the coordinates in hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_41","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_41","text":"And once you two arrive, aside from the Counters and Snow White,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_42","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_42","text":"there'll... be four... others who'll... assist...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_43","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_43","text":"Cecil?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_44","type":"Speech","speaker":"cecil_op_l","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_44","text":"They're... not... enemies. Don't... be... alarmed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_45","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_45","text":"So our communications are severed, it would seem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_46","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_46","text":"From what Cecil said, we must be getting pretty close to the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_47","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_47","text":"But I wonder what she was trying to tell us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_48","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_48","text":"Methinks she meant to tell us what awaiteth us upon our arrival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_49","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_49","text":"Yet, 'twould be a shame to spoil the pleasure of discovery ere we arrive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_50","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_50","text":"Scarlet turns her gaze toward the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_51","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_51","text":"*Kaboom!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_52","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_52","text":"Loud explosions begin to echo in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_53","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_53","text":"Mayhap we ought to make haste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_54","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_54","text":"Yes, we should do what we can to ease the burden on the Believer and our sisters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_55","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_55","text":"And for the sake of a happier future too, I say unto thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_56","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_56","text":"For I am under a curse, that I must needs live happily all my days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_57","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_57","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_58","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_58","text":"I heard that they used Rose's body to build yours...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_59","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_59","text":"Are you experiencing any lingering effects from the corruption?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_60","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_60","text":"Nay, 'tis no corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_61","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_61","text":"'Tis a curse most heartrending, yet one held most dear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_62","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_62","text":"What do you mean—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_63","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_63","text":"*Booooom!!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_64","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_64","text":"The explosions grow louder, and the distant figures gradually come into focus:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_65","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_65","text":"replicas of the swordswoman and the saintess,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_66","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_66","text":"along with their comrades, all fighting against the enemy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_67","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_67","text":"Let us hence, Rapunzel!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_68","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_68","text":"All right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_69","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_69","text":"Scarlet runs with renewed determination toward the comrades she'll share her future with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_70","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_70","text":"A gentle breeze brushes her hair,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_05_71","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_05_71","text":"as if gently stroking her head to encourage her onward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}