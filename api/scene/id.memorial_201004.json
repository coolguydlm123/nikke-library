{"id":"memorial_201004","cat":"memorial","group":{"id":"memorial201000","label":"OLD TALES · Corruption Report - Unofficial (2/2)"},"label":"It's Done, It's Done","stage":null,"prev":"memorial_201003","next":null,"speakers":{},"icons":{},"lines":[{"id":"memorial_201004_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_oldtales_03_04_description","text":"It's done, it's done, it's done!"},{"id":"memorial_201004_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_oldtales_03_04_description","text":"I've done it! I've actually done it!"},{"id":"memorial_201004_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_oldtales_03_04_description","text":"Cinderella is now more beautiful, more perfect than ever."},{"id":"memorial_201004_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_oldtales_03_04_description","text":"Beautiful Anachiro. Oh Beautiful Anachiro."},{"id":"memorial_201004_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_oldtales_03_04_description","text":"Lead me down the path of unification."}]}