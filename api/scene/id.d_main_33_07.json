{"id":"d_main_33_07","cat":"main","group":{"id":"ch33","label":"Chapter 33 · Clash"},"label":"Scouting Battle","stage":"33-23 STAGE · End","prev":"d_main_33_06","next":"d_main_33_08","speakers":{"leviathan":"Leviathan","behemoth":"Behemoth"},"icons":{"leviathan":"si_c562_00_s","behemoth":"si_c560_00_s"},"lines":[{"id":"d_main_33_07_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_1","text":"So, you can transport others from puddle to puddle","jump":null,"exit":false,"enter":null,"bg":"WhiteHouse","bgArt":"whitehouse","image":null,"bgm":"bgm_story_confront","movie":null,"shown":["leviathan","behemoth"],"affinity":null},{"id":"d_main_33_07_2","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_2","text":"in addition to yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_3","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_3","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_4","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_4","text":"I opened up a waterway underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_5","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_5","text":"If I had left you there for much longer, you would have perished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_6","text":"Most likely. I presume I would have drowned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_7","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_7","text":"That may be true,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_8","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_8","text":"but usually humans expire instantly from the pressure alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_9","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_9","text":"They die from being crushed, not from drowning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_10","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_10","text":"Yet here you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_11","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_11","text":"I told you. He's a fascinating specimen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_12","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_13","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_07_13","text":"Leviathan moves the large stakes on either side of her and pokes at the liquid I just spat out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_14","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_07_14","text":"She moves her face close to the stake and stares at it intently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_15","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_15","text":"Ew, gross. What are you doing? Why are you staring at someone's vomit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_16","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_17","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_17","text":"Disgusting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_18","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_18","text":"Ewwww, it's dripping everywhere! If any of that dribbles on you, you better stay away from me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_19","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_19","text":"Or at least take a shower. Or two. Or three, before you even think about talking to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_20","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_20","text":"Be quiet! I'm looking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_21","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_21","text":"Looking at what? What's so fascinating about someone's upchuck?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_22","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_22","text":"You wanna look at mine, too? Bleeeech!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_23","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_23","text":"Would you cease that infernal racket?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_24","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_24","text":"What the...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_25","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_25","text":"Did you really just do what I think you did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_26","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_26","text":"I was only going to imitate the sound, but then I got carried away...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_27","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_27","text":"How revolting!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_28","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_28","text":"Hey, come on! How come you're treating his like gold, but mine like garbage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_29","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_29","text":"Don't come near me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_30","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_30","text":"Don't worry, I won't. You think I don't find this abhorrent as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_31","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_31","text":"Also, how long are you going to stare at that stuff?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_32","text":"... Sorry to interrupt your comedy routine, but can you tell me why you dragged me here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_33","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_34","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_34","text":"Your body contains Vapaus,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_35","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_35","text":"does it not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_36","text":"Vapis? What's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_37","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_37","text":"Hehe. You're a terrible actor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_38","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_38","text":"Behemoth, make him bleed a little. Don't let the blood touch you though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_39","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_39","text":"Want me to cut his leg off?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_40","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_40","text":"No! I said just make him bleed a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_41","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_41","text":"All right, all right. I was only kidding. Jeez.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_42","text":"Wait...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_33_07_43","text":"*Swish*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_44","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_07_44","text":"Behemoth's pincer darts forward and scratches the back of my hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_45","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_07_45","text":"The precision which she strikes with is incredible. I barely even felt the cut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_07_46","text":"Slowly, blood pools on the back of my hand, and several drops fall to the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_47","text":"If I end up getting tetanus because of this, you and I are going to have words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_48","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_48","text":"What are you talking about? I always keep my pincers spotless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_49","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_49","text":"They're so clean, you could eat off of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_07_50","text":"Leviathan flicks her wrist, and a black droplet lands onto my blood on the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_07_51","text":"The droplet quickly turns navy blue and spreads widely across the floor, seemingly losing its initial viscosity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_52","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_52","text":"... I was right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_53","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_53","text":"That just eliminated the nanomachines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_54","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_54","text":"It's Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_55","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_55","text":"An incredibly strong concentration of it at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_56","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_56","text":"That would explain why you were able to neutralize Dark Matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_57","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_57","text":"And why you were able to survive the Black Sea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_58","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_07_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_59","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_60","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_60","text":"Conversation is the cornerstone of evolution, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_61","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_07_61","text":"Hmph. This is the first time your words have had any persuasive power. Congratulations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_07_62","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_07_62","text":"You see? Who knows what else could have been hiding in all those people w