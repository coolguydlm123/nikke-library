e talent.","jump":"d_nikke_mihara_04_105","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mihara_04_105","type":"Speech","speaker":"mihara","key":"Locale_NikkeEpisode:d_nikke_mihara_04_105","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mihara_04_106","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_mihara_04_106","text":"Mihara stares at me intently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mihara_04_107","type":"Speech","speaker":"mihara","key":"Locale_NikkeEpisode:d_nikke_mihara_04_107","text":"You don't seem to hate it, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mihara_04_108","type":"Speech","speaker":"mihara","key":"Locale_NikkeEpisode:d_nikke_mihara_04_108","text":"Normally, people would behave like those from just now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mihara_04_109","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mihara_04_109","text":"Because everyone's a coward.","jump":"d_nikke_mihara_04_111","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mihara_04_110","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mihara_04_110","text":"It's just that they're not used to it.","jump":"d_nikke_mihara_04_111","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mihara_04_111","type":"Speech","speaker":"mihara","key":"Locale_NikkeEpisode:d_nikk