"shown":null,"affinity":null},{"id":"d_main_44_07_141","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_141","text":"Good. I'll be looking forward to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_142","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_142","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_143","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_143","text":"{AccountData.NickName}... I have a favor to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_144","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_07_144","text":"You want the video of Red Hood, don't you? I'll send it to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_145","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_145","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_146","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_07_146","text":"Snow White stares at us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_147","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_147","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_148","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_148","text":"\"Let someone else take over, and walk away...\" she said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_149","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_07_149","text":"Snow White stares at us with greater intensity,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_150","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_07_150","text":"then shakes her head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_151","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_151","text":"No, you all still have much to learn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_152","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_152","text":"My retirement will have to wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_153","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_07_153","text":"She was being so nice, but she suddenly wants to pick a fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_154","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_154","text":"Rest. I will take the night watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_155","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_07_155","text":"Screw the night watch!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_156","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_07_156","text":"Tell me more about your days with the Goddess Squad. I'm dying to know what went down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_157","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_07_157","text":"Then I'll tell you about my days as a pop star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_158","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_158","text":"Pop stars do not interest me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_159","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_07_159","text":"Are you for real?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_160","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_160","text":"Give me something to eat first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_161","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_07_161","text":"This story will take several days to tell, and I will need the calories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_07_162","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_07_162","text":"Right, of course!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}