{"id":"event_doutsiders_05_s","cat":"event","group":{"id":"ev40006","label":"D-OUTSIDERS"},"label":"Some Justice: A","stage":null,"prev":"event_doutsiders_04_e","next":"event_doutsiders_05_e","speakers":{"viper":"Viper","jackal":"Jackal","joseph":"Joseph","crow":"Crow","Monologue":"Monologue","Self":"Commander"},"icons":{"viper":"si_c112_00_s","jackal":"si_c111_00_s","joseph":"si_c935_00_s","crow":"si_c110_00_s"},"lines":[{"id":"event_doutsiders_05_s_1","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_05_s_1","text":"Captain, we're here.","jump":null,"exit":false,"enter":null,"bg":"Bar","bgArt":"bar","image":null,"bgm":"none","movie":null,"shown":["crow","viper","jackal"],"affinity":null},{"id":"event_doutsiders_05_s_2","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_05_s_2","text":"Look what we brought back! Did I do good?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_3","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_risk","movie":null,"shown":["joseph"],"affinity":null},{"id":"event_doutsiders_05_s_4","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_4","text":"I knew there was something fishy about this guy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_5","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_5","text":"You can never allow your emotions to get the best of you, no matter how just you believe your cause to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_6","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_6","text":"In doing so, you've allowed yourself to be bested by your own peers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_7","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_8","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_8","text":"Before I get taken in,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_9","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_9","text":"I have one last question for you, Crow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_10","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_10","text":"Do you really believe what's happening here is fair?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_11","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_11","text":"Huh? Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_12","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_12","text":"Why wouldn't I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_13","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_13","text":"You've got your fingers in more than a few pies here at the Outer Rim. You of all people should know...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_14","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_doutsiders_05_s_14","text":"... Joseph points in my direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_15","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_15","text":"Where that person works.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_16","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_16","text":"The Central Government doesn't even treat us like human beings!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_17","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_05_s_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_18","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_18","text":"First, they erect a wall to separate the Outer Rim from the Ark and deprive us of food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_19","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_19","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_20","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_20","text":"If you risk your life and go up to the surface, you can earn a few credits by scavenging for Rapture parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_21","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_21","text":"Then they encourage and foster conflict among our own ranks, and pilfer the bodies of those who died for unknown experiments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_22","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_22","text":"Fine. I'll let that pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_23","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_23","text":"There are always places where you can hide from the worst of the fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_24","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_24","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_25","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_25","text":"they don't even grant us basic human decencies. Like light, for example.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_26","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_26","text":"Just look at the Dome of Eternity! How much could that be worth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_27","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_27","text":"How can they not shine a single ray of light into an area where so many people live?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_28","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_28","text":"During my time at the Ark, this was the one thing that I learned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_29","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_29","text":"Human life can never be quantified by dollars and cents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_30","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_30","text":"But to shine some light, even for just one hour a day...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_31","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_31","text":"is that really too much to ask?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_32","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_05_s_32","text":"They could make the sun set an hour earlier in the Ark, or redirect excess light over here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_33","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_33","text":"You're right. It would be easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_34","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_34","text":"But they'll never do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_35","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_35","text":"They have no reason to give up something of theirs to someone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_36","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_36","text":"Of course, there are some exceptions who are like our Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_37","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_37","text":"Hearing a story like yours would infuriate them. But some would feel disgusted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_38","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_38","text":"Some would consider you a charity case and try and help, if only to make themselves feel better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_39","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_39","text":"And that is the reason","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_40","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_40","text":"there is no light in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_41","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_41","text":"They gather all the things they don't want to see,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_42","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_42","text":"shove them away in a dark corner, and pretend that they don't exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_05_s_43","type":"Speech","speaker":"crow","key":"Locale_SubScenario:event_doutsiders_05_s_43","text":"For them, it's the easiest solution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}