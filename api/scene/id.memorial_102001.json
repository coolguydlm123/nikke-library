{"id":"memorial_102001","cat":"memorial","group":{"id":"memorial102000","label":"Memoirs · Doomsday Book"},"label":"Mankind's Last Moments","stage":null,"prev":null,"next":"memorial_102002","speakers":{},"icons":{},"lines":[{"id":"memorial_102001_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"Human life falls into oblivion, throwing the world into turmoil."},{"id":"memorial_102001_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"New life has been created, a cruel distortion of all things sacred."},{"id":"memorial_102001_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"Cold, metallic judges descend from the skies."},{"id":"memorial_102001_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"O ye foolish ones."},{"id":"memorial_102001_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"Do not resist with thy feeble human strength."},{"id":"memorial_102001_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"The end is nigh."},{"id":"memorial_102001_7","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"God."},{"id":"memorial_102001_8","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_01_description","text":"Guide these foolish mortals to their reckoning."}]}