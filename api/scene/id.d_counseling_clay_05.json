xt":"Turn off all your devices and enjoy some me time.","jump":"d_counseling_clay_05_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_clay_05_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_clay_05_7","text":"We've got to accept all the feedback we're given, both good and bad.","jump":"d_counseling_clay_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_clay_05_8","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_clay_05_8","text":"You know better than anyone else what areas need improvement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_clay_05_9","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_clay_05_9","text":"You... You're right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_clay_05_10","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_clay_05_10","text":"From now on, I've gotta make time to reflect upon myself!","jump":"d_counseling_clay_05_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_clay_05_11","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_clay_05_11","text":"Yeah... But there are so many negative comments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_clay_05_12","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_clay_05_12","text":"No pain, no gain I guess...","jump":"d_counseling_clay_05_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":n