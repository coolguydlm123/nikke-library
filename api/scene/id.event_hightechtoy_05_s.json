sk for a rescue evac.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_13","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_05_s_13","text":"Syuen will bend over backwards responding to a distress signal if it's sent by Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_14","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_14","text":"Evac?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_15","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_15","text":"What is that, a character from a cartoon or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_16","type":"Speech","speaker":"drake","key":"Locale_SubScenario:event_hightechtoy_05_s_16","text":"Don't be dense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_17","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_17","text":"I'm saying that we don't use things like that, you dunce.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_18","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_05_s_18","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_19","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_19","text":"To be more precise, it's not an option.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_20","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_05_s_20","text":"What do you mean?\nAny Nikke can send a request for help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_21","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_21","text":"Very true. Everyone except us, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_22","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_22","text":"Like you said, we're Matis. The one and only Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_23","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_23","text":"How can we send out a distress signal after only being on the surface for a few days?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_24","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_s_24","text":"As a matter of fact, no matter how long we were up here, we wouldn't dream of asking Syuen for help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_s_25","type":"Speech","speaker":"maxwell_w","key":"Local