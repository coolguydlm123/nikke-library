{"id":"d_counseling_nayuta_13","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 13","stage":null,"prev":"d_counseling_nayuta_12","next":"d_counseling_nayuta_14","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_13_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_1","text":"Thy body is indeed most well-honed, Great Hero.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_13_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_2","text":"Might I inquire as to thy secret?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_13_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_13_3","text":"There's no secret... Maybe it's just genetic?","jump":"d_counseling_nayuta_13_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_13_4","text":"I just train consistently.","jump":"d_counseling_nayuta_13_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_13_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_5","text":"A most vexing answer, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_13_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_6","text":"Those who do toil to strengthen their bodies shall find themselves grievously aggrieved.","jump":"d_counseling_nayuta_13_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_13_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_7","text":"Ah, so 'tis as I did surmise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_13_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_8","text":"Such a frame is not wrought in a single night.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_13_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_9","text":"Verily, thou hast endured labours most grievous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_13_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_13_10","text":"Thy steadfastness doth command my highest admiration.","jump":"d_counseling_nayuta_13_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_13_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_13_11","text":"Nayuta gives me a once-over.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}