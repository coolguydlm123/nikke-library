{"id":"event_goddessfall2_04_s","cat":"event","group":{"id":"ev40094","label":"GODDESS FALL · Part 2"},"label":"The Value of Life: A","stage":null,"prev":"event_goddessfall2_intermission_01","next":"event_goddessfall2_04_e","speakers":{"papillon":"Papillon","cecil":"Cecil","dorothy_op_r":"Dorothy","nayuta":"Nayuta","crown":"Crown","johan":"Johan","cecil_op_l":"Cecil"},"icons":{"papillon":"si_c890_00_s","cecil":"si_c929_00_s","dorothy_op_r":"si_c233_00_s","nayuta":"si_c223_00_s","crown":"si_c330_00_s","johan":"si_c925_00_s","cecil_op_l":"si_c929_00_s"},"lines":[{"id":"event_goddessfall2_04_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_1","text":"Papillon runs","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLobby","bgArt":"brokenedenlobby","image":null,"bgm":"event_bgm_goddessfall_onloocker","movie":null,"shown":["papillon","cecil"],"affinity":null},{"id":"event_goddessfall2_04_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_2","text":"as she recalls the events before she escaped from Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_3","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_3","text":"I'll be running away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_4","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_4","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_5","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_5","text":"Has Isabel provided you with the safe route?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_6","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_6","text":"... You knew?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_7","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_7","text":"Of course. I'm the one who plotted the route.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_8","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_8","text":"... Oh, right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_9","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_9","text":"Farewell. There's much I'd prefer you not disclose when you return, but I doubt it matters anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_10","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_10","text":"Whether you speak of it or not is entirely up to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_11","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_12","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_12","text":"Aren't you going to stop me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_13","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_13","text":"Do you want me to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_14","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_14","text":"I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_15","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_15","text":"For a hostage, you were surprisingly helpful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_16","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_16","text":"I appreciate that, but no further involvement will be permitted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_17","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_17","text":"Aw, c'mon, you could have said something like, \"Now that we're comrades, how about risking your life for us just this once?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_18","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_18","text":"I don't speak in such a saccharine fashion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_19","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_19","text":"Saccharine...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_20","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_20","text":"Moreover, one cannot compel another to risk their life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_21","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_21","text":"Only you can determine the value of your own life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_22","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_23","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_23","text":"So, you're fine with putting your life on the line here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_24","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_24","text":"That's how much you think your life is worth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_25","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_25","text":"Yes, that is my decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_26","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_26","text":"... Cecil, I'll be frank. Wouldn't it be smarter to fall back, regroup, and then fight again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_27","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_27","text":"This isn't your only chance, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_28","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_28","text":"No, this is our only chance. While they fear us, there is much we can accomplish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_29","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_29","text":"To retreat would be to reveal our hand, and then next time, they would act far more boldly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_30","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_30","text":"And the Queen has already taken considerable damage. There's no guarantee we'll ever be able to inflict this much harm on her again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_31","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_31","text":"... Why are you all going to such lengths?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_32","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_32","text":"Th-this is strange. What can possibly be more important than your own lives...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_33","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_34","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_34","text":"Who knows?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_35","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_35","text":"Perhaps it's just as you said,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_36","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_04_s_36","text":"we've all gone mad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_37","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_37","text":"*Huff...! Huff...!*","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_38","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_38","text":"Insane... every last one of them...! Haha...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_39","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_39","text":"*Huff...! Huff...!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_40","text":"Papillon steadies her ragged breathing and looks up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_41","text":"A radio tower looms overhead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_42","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_42","text":"*Huff...*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_43","text":"She activates the tower's terminal and connects it to her phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_44","text":"After tapping the phone a few times, Papillon brings it to her ear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_45","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_45","text":"Haah... Haha...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_46","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_46","text":"What am I even doing right now... Seriously...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_47","text":"The signal goes through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_48","text":"Soon after, a voice can be heard from the other end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_49","type":"Speech","speaker":"dorothy_op_r","key":"Locale_MainScenario:event_goddessfall2_04_s_49","text":"How bold of you to call me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["dorothy_op_r"],"affinity":null},{"id":"event_goddessfall2_04_s_50","type":"Speech","speaker":"dorothy_op_r","key":"Locale_MainScenario:event_goddessfall2_04_s_50","text":"This better be something important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_51","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_51","text":"Come to Eden. Hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_52","type":"Speech","speaker":"dorothy_op_r","key":"Locale_MainScenario:event_goddessfall2_04_s_52","text":"I have no time for that right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_53","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_53","text":"Listen to me, there's no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_54","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_54","text":"The Queen has descended. Eden has been decimated. The Pioneers and White Knights have joined the fray. Inherit has been wiped out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_55","type":"Speech","speaker":"dorothy_op_r","key":"Locale_MainScenario:event_goddessfall2_04_s_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_56","type":"Speech","speaker":"dorothy_op_r","key":"Locale_MainScenario:event_goddessfall2_04_s_56","text":"... What did you just say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_57","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_57","text":"I'm not joking! Hurry over here and help, or else everyone will die!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_58","type":"Speech","speaker":"dorothy_op_r","key":"Locale_MainScenario:event_goddessfall2_04_s_58","text":"Wait, who did you say was wiped out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_59","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_59","text":"Shut up and just get over here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_60","text":"Papillon yanks the CombiLink from her phone","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_61","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_61","text":"and looks toward the wasteland she ran through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_62","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_62","text":"... Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_63","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_63","text":"Really, this is absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_64","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_64","text":"Papillon runs,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_65","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_65","text":"retracing her steps toward Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_66","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_04_s_66","text":"And without even realizing it, she's laughing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_67","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_67","text":"Ha...! I've lost it...! I must've lost my mind...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_68","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_04_s_68","text":"I've really gone insane...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_69","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_04_s_69","text":"How dost thou fare?","jump":null,"exit":false,"enter":null,"bg":"DistantEden","bgArt":"distanteden","image":null,"bgm":null,"movie":null,"shown":["nayuta"],"affinity":null},{"id":"event_goddessfall2_04_s_70","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall2_04_s_70","text":"I... do not feel as if I am dying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_04_s_71","type":"Speech","spe