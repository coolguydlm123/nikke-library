{"id":"memorial_100103","cat":"memorial","group":{"id":"memorial100100","label":"Memoirs · A Man's Memoir"},"label":"December 5, XX.","stage":null,"prev":"memorial_100102","next":null,"speakers":{},"icons":{},"lines":[{"id":"memorial_100103_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"Used up the last of the rations."},{"id":"memorial_100103_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"Plenty of power remaining, but electricity doesn't put food in my stomach."},{"id":"memorial_100103_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"It's time for me to go outside."},{"id":"memorial_100103_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"I wonder, have I been afraid of nothing this entire time?"},{"id":"memorial_100103_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"All right, I'll go outside."},{"id":"memorial_100103_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"Perhaps people will interview me when they see me."},{"id":"memorial_100103_7","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"They'll tell me the war has been over for some time now, and I'll look like a right fool for staying in this bunker for as long as I have."},{"id":"memorial_100103_8","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"I'm setting out tomorrow at sunrise."},{"id":"memorial_100103_9","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_03_description","text":"I haven't seen another human being for ages. My stomach is already in knots."}]}