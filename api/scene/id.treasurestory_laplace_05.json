e":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_65","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_65","text":"But then at some point after humanity settled in the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_66","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_66","text":"their focus shifted more towards stability rather than combat performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_67","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_67","text":"Little by little, the emphasis shifted to building Nikkes that were more predictable and long-lasting, at the expense of being a bit weaker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_68","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_68","text":"During that time, the first CEO of Missilis—the same person who created the first prototype Nikke—stepped down.","jump":null,"exit":false,"enter":null,"bg":"MissilisOffice","bgArt":"missilisoffice","image":null,"bgm":null,"movie":null,"shown":["syuen"],"affinity":null},{"id":"treasurestory_laplace_05_69","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_69","text":"Then the second CEO, who had built the communication network for the entire Ark, also stepped down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_70","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_70","text":"Syuen's position at the company started to get questioned as she was constantly compared to her predecessors,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_71","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_71","text":"until she achieved her first great accomplishment as the third CEO:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_72","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_72","text":"\"Our goal is to enhance Nikkes' deteriorated combat abilities by recreating those of the very first Nikke prototype.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_73","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_73","text":"That was the mission statement for her first big win, Project Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["laplace","maxwell","drake"],"affinity":null},{"id":"treasurestory_laplace_05_74","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_74","text":"In other words, that was us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_75","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_75","text":"The prototype and first success from that project was...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_76","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_76","text":"Laplace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_77","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_77","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_78","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_78","text":"Of all the participants who signed up for the experiment,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_79","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_79","text":"she was the only one who applied of her own free will, without any stipulations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_80","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_80","text":"She was also frail and didn't meet any of the height, strength, or stamina requirements. She was by far the worst candidate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_81","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_81","text":"No one thought that she would be a success,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_82","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_82","text":"including me.","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_83","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_83","text":"You mean you were there too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_84","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_84","text":"I was a part of the project when I was human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_85","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_85","text":"I was the lead researcher.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_86","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_86","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_87","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_87","text":"But let's set my story aside for now and focus on Laplace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_88","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_88","text":"Considering her physical state, she would have never been accepted under normal circumstances.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_89","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_89","text":"Syuen is the one that allowed her to participate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_90","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_90","text":"Not something you'd expect, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_91","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_91","text":"Considering how uptight Syuen is, I never thought she would allow it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_92","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_92","text":"Maybe she fell for those puppy dog eyes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_93","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_93","text":"or Laplace's undying passion for all Nikkes to become heroes again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_94","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_94","text":"All the others had rejected Laplace for the experiment, feeling that allowing her to join would only result in her death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_95","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_95","text":"But Syuen leveraged her authority as the leader of the project in order to ensure Laplace got in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_96","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_96","text":"Syuen did all that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_97","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_97","text":"Surprising, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_98","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_98","text":"Rumors began to spread that Laplace and Syuen had known each other beforehand,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_99","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_99","text":"or that they were secretly related.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_100","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_100","text":"Surprising as it may seem, they really aren't. That was the first time they had met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_101","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_101","text":"Laplace went on to prove that Syuen's trust in her was not misplaced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_102","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_102","text":"While all the other participants in the experiment either died, gave up, or ran away,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_103","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_103","text":"she was the only one who endured the torment until the very end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_104","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_104","text":"She became the first member of Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_105","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_105","text":"And that's why Syuen both likes and trusts Laplace the most.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_106","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_106","text":"She was the one who made it possible for her to establish herself as the CEO of Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_107","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_107","text":"She is her greatest work, and the one who helped prevent her from being ousted as the CEO.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_108","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_108","text":"She is a true hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_109","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_109","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_110","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_110","text":"That DVD that Laplace is obsessed with,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_111","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_111","text":"is something that she watched religiously all through the Matis experiment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_112","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_112","text":"She would always say no matter how hard things got, as long as she was able to watch those movies, she'd be able to endure it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_113","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_113","text":"That's why she always calls it her \"hero manual.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_114","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_114","text":"That must also be why she can't bear to throw it away and buy a new copy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_115","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_115","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_116","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_116","text":"Think of it like a cherished childhood doll.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_117","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_117","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_118","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_118","text":"Hehe, looks like all my talking has got the wheels in your head spinning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_119","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_119","text":"Don't think about it too deeply.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_120","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_120","text":"Just don't forget that she's more than an eccentric goofball","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_121","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_121","text":"who likes to crash through windows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_122","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_122","text":"Thank you for telling me all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_123","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_123","text":"No problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_124","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_124","text":"Anyway, you better get going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_125","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_125","text":"Laplace is probably waiting for you with a bucket of popcorn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_126","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_laplace_05_126","text":"Right. I'll see you around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_laplace_05_127","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:treasurestory_laplace_05_127","text":"See you soon, Cutey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}