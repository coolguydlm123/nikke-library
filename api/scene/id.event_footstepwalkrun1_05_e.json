05_e_13","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_13","text":"Not yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_14","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_14","text":"Come with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_15","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_15","text":"Join our squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_16","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_16","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_17","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_17","text":"For crying out loud, just come. Why do you always have to ask questions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_18","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_18","text":"That's just how she is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_19","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_19","text":"... You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_20","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_20","text":"We want you to come with us because we feel sorry for you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_21","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_21","text":"and there's still a lot to teach you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_22","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_22","text":"So stop talking back and just come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_23","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_23","text":"Our squad has its own unique name instead of a serial number.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_24","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_24","text":"I've already brought you up to the Squad Leader, so hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_25","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_25","text":"The squad has a name?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_26","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_26","text":"Yeah. Most squads go by serial numbers, but those that are a cut above the rest have actual names.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_27","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_27","text":"Ours is Skull Head. Ever heard of it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_28","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_28","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_29","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_29","text":"Look it up. We're quite famous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_30","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_31","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_31","text":"All I see are articles about you being involved in violent incidents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_32","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_32","text":"... There are only recent articles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_33","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_33","text":"Look up some older ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_34","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_34","text":"Who cares about what articles have to say, anyway. Are you coming or not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_35","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_35","text":"For your information, our squad specializes in combat. We operate differently from transporting or mining squads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_36","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_36","text":"You can fight, can't you? That's why you got that medal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_37","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_37","text":"A combat squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_38","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_38","text":"Mass-produced Nikke squads are divided into three main types.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_39","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_39","text":"First are those which secure resources on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_40","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_40","text":"They go up to the surface, locate resources, and transport them back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_41","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_41","text":"The conditions they have to work in are... far from ideal. The mortality rate is high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_42","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_42","text":"That's what your previous squad was, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_43","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_43","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_44","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_44","text":"The second is Ark defense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_45","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_45","text":"They stay in the Ark and maintain law and order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_46","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_46","text":"At least, that's what they tell us. In reality, the Nikkes are little more than cannon fodder and emotional punching bags.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_47","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_47","text":"And the third is combat units. That's what Skull Head is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_48","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_48","text":"They either overhaul key facilities on the surface or proceed to specific areas to exterminate Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_49","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_49","text":"They're the crème de la crème of the three types.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_50","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_50","text":"The mortality rate is the highest, but so is the glory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_51","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_51","text":"Even though Nikkes were heavily criticized for their disappointing performance in the Surface Reclamation War,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_52","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_52","text":"the Goddess Fall incident and the With Nikke campaign promoted by Mustang, the CEO of Tetra Line,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_53","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_53","text":"have allowed us to regain some of our former glory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_54","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_54","text":"The treatment we received has improved by leaps and bounds, so it's a coveted role for any mass-produced Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_55","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_55","text":"Not for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_56","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_56","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_57","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_57","text":"We know. You don't desire anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_58","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_58","text":"But in extreme environments where life and death hang in the balance,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_59","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_59","text":"anything can happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_60","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_60","text":"I'm saying that there's a high chance you'll find something you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_61","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_61","text":"Besides, it's not like you have anything else going on, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_62","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_62","text":"I don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_63","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_63","text":"Then join us, why don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_64","type":"Speech","speaker":"wendi","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_64","text":"Wouldn't it be better to stay with us rather than rub strangers the wrong way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_65","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_65","text":"I don't rub people the wrong way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_66","type":"Speech","speaker":"rio","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_66","text":"You're doing it right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_67","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_67","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_68","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_68","text":"I'll come with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_05_e_69","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_05_e_69","text":"What do I have to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}