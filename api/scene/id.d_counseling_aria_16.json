{"id":"d_counseling_aria_16","cat":"counsel","group":{"id":"char5070","label":"Aria"},"label":"Advising Aria: 16","stage":null,"prev":"d_counseling_aria_15","next":"d_counseling_aria_17","speakers":{"aria":"Aria"},"icons":{"aria":"si_c432_00_s"},"lines":[{"id":"d_counseling_aria_16_1","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_1","text":"Protagonists in opera series tend to end up at their final destinations.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["aria"],"affinity":"_0"},{"id":"d_counseling_aria_16_2","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_2","text":"Their death is what completes the show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_3","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_3","text":"Have you ever considered what the perfect death would be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_16_4","text":"Sacrificing yourself for a noble cause.","jump":"d_counseling_aria_16_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_aria_16_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_16_5","text":"There's no such thing as a \"perfect death\".","jump":"d_counseling_aria_16_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_aria_16_6","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_6","text":"... I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_7","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_7","text":"If a protagonist is willing to give their lives to protect something,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_8","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_8","text":"they must have found a greater purpose in life, something more valuable than their own life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_9","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_9","text":"Dying a heroic death is more admirable than living in shame.","jump":"d_counseling_aria_16_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_10","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_11","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_11","text":"Are you saying that death is meaningless, no matter what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_12","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_16_12","text":"You're not exactly a romantic, I'll say that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_16_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_aria_16_13","text":"I discussed philosophy with Aria for a while.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}