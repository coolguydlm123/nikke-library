{"id":"event_oldtales2_02_e","cat":"event","group":{"id":"ev40062","label":"OLD TALES · Part 2"},"label":"Tears of a Monster: B","stage":null,"prev":"event_oldtales2_02_s","next":"event_oldtales2_03_s","speakers":{"abe":"Abe","cinderella":"Cinderella"},"icons":{"abe":"si_c979_00_s","cinderella":"si_c511_00_s"},"lines":[{"id":"event_oldtales2_02_e_1","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_1","text":"You fought with the Goddesses, and lost.","jump":null,"exit":false,"enter":null,"bg":"ArkCleanIndoor","bgArt":"arkcleanindoor","image":null,"bgm":"event_bgm_oldtales_beyond","movie":null,"shown":["cinderella","abe"],"affinity":null},{"id":"event_oldtales2_02_e_2","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_2","text":"You were torn to shreds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_3","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_3","text":"It was a decent idea. Using the Goddesses as a form of suicide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_4","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_4","text":"Anachiro had become a symbol, but one on which humans could pin all their hatred.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_5","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_5","text":"If things had been left as they were, humanity would have crumbled from within.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_6","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_6","text":"Therefore, the Heretic Anachiro was transferred to a place called the Heretic Lab.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_7","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_7","text":"But you didn't die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_8","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_8","text":"Every time you were injured, you regenerated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_9","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_9","text":"When they took you to that place...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_10","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_10","text":"you were subjected to all sorts of...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_11","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_11","text":"inspections.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_12","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_12","text":"You don't need to sugarcoat it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_13","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_13","text":"All right. You were experimented on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_14","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_14","text":"They wanted to find out what weapons worked against Heretics, and how to neutralize your ability to regenerate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_15","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_15","text":"To get a better idea of your interior composition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_16","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_16","text":"For a while, they couldn't find anything of much use,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_17","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_17","text":"then an unknown substance called Vapaus was introduced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_18","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_18","text":"Apparently, it's a substance that kills Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_19","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_19","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_20","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_20","text":"It specifically targets Heretics?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_21","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_21","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_22","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_22","text":"Hard to wrap your mind around, isn't it? A substance specifically designed to eliminate a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_23","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_23","text":"That must mean there are more of them. Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_24","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_24","text":"That's a reasonable deduction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_25","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_25","text":"Anyway, they injected you with Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_26","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_26","text":"There was a noticeable decline in your regenerative abilities,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_27","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_27","text":"and then you began to regain consciousness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_28","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_28","text":"That's when you returned to your original self, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_29","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_29","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_30","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_30","text":"I knew it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_31","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_31","text":"That tells me Vapaus isn't a substance meant to kill Heretics, but the cure for Corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_32","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_32","text":"I doubt I need to tell you what happened after that. You experienced it yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_33","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_33","text":"What happened to everyone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_34","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_34","text":"After getting a thrashing from you, we were just waiting to die, when Oswald came and revived us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_35","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_35","text":"He repaired us, did all sorts of other things, and two months flew by.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_36","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_36","text":"We cleared our names and proved we weren't traitors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_37","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_37","text":"Did you get a brain scan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_38","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_38","text":"No. At this point, the only information they'd be able to get with that would be our favorite foods, so they didn't bother using it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_39","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_39","text":"We worked hard to explain and presented evidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_40","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_40","text":"So we're in the clear now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_41","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_41","text":"Well... We're still under strict surveillance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_42","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_42","text":"I heard something about a Central Government?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_43","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_43","text":"The United Forces of Humanity and V.T.C. merged to become the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_44","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_44","text":"All the other smaller corporations were also incorporated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_45","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_45","text":"It sounds like a corporate merger, doesn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_46","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_46","text":"Humanity acknowledged defeat and hid underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_47","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_47","text":"They're moving to a giant subterranean city called the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_48","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_48","text":"The... they admitted defeat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_49","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_49","text":"The straw that broke the camel's back must have been...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_50","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_50","text":"Yes. It was you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_51","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_51","text":"Your actions are what caused the Lift mission to fail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_52","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_52","text":"The area near the Lift saw a rapid increase in Raptures and became impenetrable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_53","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_53","text":"We can no longer target the highest-ranking figure among the hellish horde, and they constantly keep pouring out more Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_54","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_55","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_55","text":"It's unfortunate, but what can we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_56","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_57","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_02_e_57","text":"Why did you come to free me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_02_e_58","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_02_e_58","text":"Because you would have died if I left you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"mov