null},{"id":"s003_03_91","type":"Speech","speaker":"blackwatergirl","key":"Locale_SideStory:s003_03_91","text":"I didn't necessarily expect gratitude, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s003_03_92","type":"Speech","speaker":"blackwatergirl","key":"Locale_SideStory:s003_03_92","text":"I at least thought I'd be able to talk to someone again. It's been ages since I had a proper conversation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s003_03_93","type":"Speech","speaker":"blackwatergirl","key":"Locale_SideStory:s003_03_93","text":"Story of my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s003_03_94","type":"Speech","speaker":"blackwatergirl","key":"Locale_SideStory:s003_03_94","text":"Nothing but rotten luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s003_03_95","type":"Monologue","speaker":null,"key":"Locale_SideStory:s003_03_95","text":"The girl hugs her knees and curls back up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s003_03_96","type":"Speech","speaker":"blackwatergirl","key":"Locale_SideStory:s003_03_96","text":"Never again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s003_03_97","type":"Speech","speaker":"blackwatergirl","key":"Locale_SideStory:s003_03_97","text":"Never again will I save a human or anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s003_03_98","type":"Speech","speaker":"blackwatergirl","