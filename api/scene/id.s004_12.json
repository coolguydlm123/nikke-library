Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_87","text":"... What's going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_88","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_88","text":"Why are you guys opening this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_89","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_89","text":"I thought for sure it'd be Jellyfish busting me out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_90","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_90","text":"I heard quite the commotion. Was there a fight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_91","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_12_91","text":"Liberalio is dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_92","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_92","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_93","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_12_93","text":"She's dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_94","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_94","text":"... What the heck are you saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_95","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_95","text":"You guys killed her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_96","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_12_96","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_97","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_97","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_98","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_98","text":"How?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_99","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_99","text":"That's a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_100","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_101","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_101","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_102","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_102","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_103","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_103","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_104","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_104","text":"So she's dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_105","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_105","text":"Dost thou grieve for a comrade? I had not thought such an emotion dwelt within thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_106","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_106","text":"I should have been the one to kill her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_107","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_107","text":"Damn it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_108","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_108","text":"Hmm... Verily, I was close to misjudging thee, Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_109","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_12_109","text":"Prepare yourself, Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_110","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_12_110","text":"We're going to retrieve Lilith's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_111","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_111","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_112","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_112","text":"I'm raring to go, but we're leaving just like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_113","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_113","text":"Dost thou require a change of garments ere we depart?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_114","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_114","text":"You're seriously letting me out without any restraint?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_115","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_115","text":"Ah, worry not over that. At present, thou art but slightly weaker than an ordinary Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_116","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_116","text":"We have adjusted thy core so thou mayst walk, and naught more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_117","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_117","text":"I therefore counsel thee against attempting to prey upon passing Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_118","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_118","text":"Thy strength is considerable, yet tactics and strategy are ne'er thy forte.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_119","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_119","text":"Shouldst thou battle a Rapture in thy present state, thou wouldst become naught but a meal abundant in nanomachines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_120","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_12_120","text":"If such be thy desire, I shall not stay thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_121","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_121","text":"... You got me good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_122","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_122","text":"All right, then. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_12_123","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_12_123","text":"Nihilister steps forward and exits the Atlas Cage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s004_12_124","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_12_124","text":"...","j