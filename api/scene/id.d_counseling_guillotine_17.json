{"id":"d_counseling_guillotine_17","cat":"counsel","group":{"id":"char5031","label":"Guillotine"},"label":"Advising Guillotine: 17","stage":null,"prev":"d_counseling_guillotine_16","next":"d_counseling_guillotine_18","speakers":{"guillotine":"Guillotine"},"icons":{"guillotine":"si_c180_00_s"},"lines":[{"id":"d_counseling_guillotine_17_1","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_1","text":"If the world suddenly came to an end today,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guillotine"],"affinity":"_0"},{"id":"d_counseling_guillotine_17_2","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_2","text":"how would you spend your last day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guillotine_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guillotine_17_3","text":"I'd spend it with you.","jump":"d_counseling_guillotine_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guillotine_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guillotine_17_4","text":"I'd spend it by myself.","jump":"d_counseling_guillotine_17_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guillotine_17_5","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_5","text":"Thanks to you, this body will never be lonely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guillotine_17_6","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_6","text":"When that day comes, we will finally be liberated from our solitary existence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guillotine_17_7","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_7","text":"A toast, to the end of the world.","jump":"d_counseling_guillotine_17_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guillotine_17_8","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_8","text":"So you would rather spend your last days in complete solitude?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guillotine_17_9","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_9","text":"If I leave you behind, I'll never find liberation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guillotine_17_10","type":"Speech","speaker":"guillotine","key":"Locale_Counseling:d_counseling_guillotine_17_10","text":"I too will follow you along this lonely path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guillotine_17_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guillotine_17_11","text":"Guillotine and I talk about our lonely fates.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}