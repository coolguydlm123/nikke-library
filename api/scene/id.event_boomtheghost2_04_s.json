{"id":"event_boomtheghost2_04_s","cat":"event","group":{"id":"ev40085","label":"BOOM! THE GHOST! · Part 2"},"label":"Irregularity: A","stage":null,"prev":"event_boomtheghost2_intermission_01","next":"event_boomtheghost2_04_e","speakers":{"alfred":"Alfred","rapi_ss":"Rapi","elegg_s":"Elegg","dorothy_s":"Dorothy"},"icons":{"alfred":"si_c9000_00_s","rapi_ss":"si_c016_01_s","elegg_s":"si_c502_00_s","dorothy_s":"si_c234_00_s"},"lines":[{"id":"event_boomtheghost2_04_s_1","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_1","text":"There was a Nikke aboard the Utopia as well.","jump":null,"exit":false,"enter":null,"bg":"Deck_n","bgArt":"deck_n","image":null,"bgm":"bgm_story_weare","movie":null,"shown":["product23"],"affinity":null},{"id":"event_boomtheghost2_04_s_2","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_2","text":"She was a mass-produced model, but her warmth and kindness surpassed everyone else's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_3","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_3","text":"She boarded this ship to help the departing passengers in any way she could.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_4","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_4","text":"She assisted me and devoted herself entirely to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_5","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_5","text":"After all the passengers left,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_6","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_6","text":"she couldn't cope with the grief, and eventually...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_7","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_8","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_9","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_9","text":"I didn't want to forget her.","jump":null,"exit":false,"enter":null,"bg":"Pilothouse_n","bgArt":"pilothouse_n","image":null,"bgm":null,"movie":null,"shown":["alfred","elegg_s","rapi_ss"],"affinity":null},{"id":"event_boomtheghost2_04_s_10","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_10","text":"That thought spread throughout the Utopia,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_11","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_11","text":"and gave birth to a hologram in her image.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_12","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_12","text":"What? How is that even possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_13","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_13","text":"I do not know, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_14","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_14","text":"One day, her hologram began wandering around the ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_15","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_15","text":"It is unable to communicate, nor does it seem to think for itself, yet it continues to exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_16","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_17","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_17","text":"NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_18","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_18","text":"What was that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_19","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_19","text":"Nothing. I was just talking to myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_20","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_20","text":"Are some of your authorization privileges still with that hologram?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_21","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_21","text":"Correct. That is why I have not fully recovered yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_22","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_22","text":"Her hologram must be returned to normal as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_23","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_23","text":"Does that mean it will disappear?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_24","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_24","text":"That's right. It was created by accident, so I do not know how to recreate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_25","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_25","text":"Are you sure you're okay with this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_26","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_26","text":"No, I am not, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_27","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_27","text":"She stayed with me until the very end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_28","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_28","text":"After all the passengers left, only she and I remained on the Utopia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_29","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_29","text":"We spent a lot of time talking about many things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_30","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_31","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_31","text":"She was my friend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_32","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_33","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_04_s_33","text":"Alfred slowly looks at each one of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_34","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_34","text":"This ship has already served its purpose, but it will not be your final destination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_35","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_35","text":"You are all alive, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_36","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_36","text":"Help me bury those whom I still carry in my heart,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_37","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_37","text":"and bless the lives of those still living.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_38","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_38","text":"Do that, and I will bless you all as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_39","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_39","text":"Please, help me give her an honorable sendoff,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_40","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_40","text":"the one which she deserves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_41","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_41","text":"... Alfred.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_42","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_43","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_43","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_44","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_44","text":"We'll be sure to","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_45","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_45","text":"give her a proper sendoff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_04_s_46","text":"We begin moving towards the location Alfred indicated, where the hologram might be.","jump":null,"exit":false,"enter":null,"bg":"Deck_n","bgArt":"deck_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_47","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_04_s_47","text":"How does a hologram manifest entirely on its own?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_48","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_48","text":"It doesn't. It's impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_49","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_49","text":"Then, does that mean...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_50","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_50","text":"No. There's no way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_51","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_51","text":"Hehe, no, it's not a ghost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_52","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_52","text":"... I think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_53","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_53","text":"You could at least pretend to be certain, for my sake if nothing else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_54","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_54","text":"My best hypothesis is:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_55","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_55","text":"Some of the data remaining in her NIMPH may have made contact with one of the Utopia's numerous hologram generators and then assumed form. Or something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_56","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_56","text":"Is that possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_57","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_57","text":"I'm not sure. There's still so much we don't know about NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_58","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_58","text":"I'm simply saying that's the most plausible theory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_59","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_04_s_59","text":"You seem adamantly opposed to the supernatural, Elegg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_60","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_60","text":"Darn right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_61","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_61","text":"To assert something like that exists without giving a good reason is just unfair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_62","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_62","text":"Unfair? What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_63","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_63","text":"Ghosts are supposed to levitate, pass through walls, and teleport at will. They're the ultimate when it comes to transportation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_64","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_64","text":"And yet, despite being intangible entities, they can also lift objects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_65","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_65","text":"They get all these cool abilities and fly in the face of science! I can't stand that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_66","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_66","text":"Humans have worked so hard to achieve powers similar to what these ghosts wield without naturally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_67","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_67","text":"Why do ghosts get all those powers for free? It's totally unfair!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_68","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_68","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_69","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_69","text":"I suppose, if you worked incredibly hard for something,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_70","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_70","text":"and someone else treated it in a cavalier fashion, it would seem unfair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_71","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_71","text":"You see!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_72","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_72","text":"That's why I don't believe in ghosts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_73","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_73","text":"Or rather, why I choose not to believe in them, for my own sake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_74","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_74","text":"That's a unique way to deny their existence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["alfred"],"affinity":null},{"id":"event_boomtheghost2_04_s_75","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_75","text":"Usually, people aver that they don't believe in ghosts due to finding the entire concept unscientific.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_76","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_76","text":"When it comes to science,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_77","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_77","text":"there's still so much that we don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_78","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_78","text":"We like to think we're at the epicenter of technology. That we have a full grasp of it and how to apply it in every facet of life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_79","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_79","text":"But the truth is, most technology and scientific information remains unknown to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_80","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_80","text":"Call me crazy, but I don't see the rationale in using one unknown to supposedly disprove the existence of another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_81","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_04_s_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_82","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_82","text":"Anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_83","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_83","text":"What's the name of the hologram we're looking for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_84","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_84","text":"It feels kinda weird and impersonal just referring to it as a hologram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_85","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_85","text":"Her name...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_86","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_04_s_86","text":"Her name was Maya.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_87","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_87","text":"Look, Pinne. The ocean is sparkling.","jump":null,"exit":false,"enter":null,"bg":"CruiseShipPool_n","bgArt":"cruiseshippool_n","image":null,"bgm":"bgm_story_promise","movie":null,"shown":["dorothy_s","irregularghost"],"affinity":null},{"id":"event_boomtheghost2_04_s_88","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_88","text":"I've heard about this stuff called bioluminescent plankton which shines at night. Maybe that's what we're seeing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_89","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_89","text":"Hehe. The ocean isn't so bad up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_90","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_90","text":"In fact, I'd say it's pretty good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_91","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_91","text":"I'm so glad you and I are able to glimpse such a rare phenomenon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_92","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_92","text":"For me, this is better than paradise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_93","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_93","text":"Hehe. Looks like my wish came true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_94","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_94","text":"I always wanted you and I to be able to go to paradise together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_04_s_95","text":"Dorothy looks at the face of the mass-produced model Nikke,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_96","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_04_s_96","text":"who gives a faint smile in return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_97","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_97","text":"... Pinne.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_98","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_98","text":"Let's never part again, ever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_99","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_99","text":"Let's always stay together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_100","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_100","text":"Right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_04_s_101","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost2_04_s_101","text":"In paradise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}