,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_07_7","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_07_7","text":"The Queen of Hearts's minions are all big meanies,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_07_8","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_07_8","text":"but I still feel sorry for them.","jump":"d_counseling_alice_07_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_07_9","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_07_9","text":"You're right! If they can't go to sleep by themselves...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_07_10","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_07_10","text":"We can give them a little help!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_07_11","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_07_11","text":"You're a real genius!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_07_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_alice_07_12","text":"I have a good talk with Alice about the minions of the Queen of Heart, Raptures.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}