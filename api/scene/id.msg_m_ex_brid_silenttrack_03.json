{"id":"msg_m_ex_brid_silenttrack_03","cat":"messenger","group":{"id":"room_brid","label":"Brid · Nikke"},"label":"9. Commander,","stage":null,"prev":"msg_m_ex_brid_silenttrack_02","next":null,"speakers":{"brid_w":"Brid"},"icons":{"brid_w":"si_c073_00_s"},"lines":[{"id":"m_ex_brid_silenttrack_03_1","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_1","text":"Commander,","jump":null},{"id":"m_ex_brid_silenttrack_03_2","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_2","text":"are you busy at the moment?","jump":null},{"id":"m_ex_brid_silenttrack_03_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_3","text":"No, I'm not.","jump":null},{"id":"m_ex_brid_silenttrack_03_4","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_4","text":"You've probably noticed that I've been wearing the new uniform lately.","jump":null},{"id":"m_ex_brid_silenttrack_03_5","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_5","text":"Do you think it looks all right?","jump":null},{"id":"m_ex_brid_silenttrack_03_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_6","text":"Yeah, of course! I actually think it looks pretty.","jump":null},{"id":"m_ex_brid_silenttrack_03_7","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_7","text":"Oh,","jump":null},{"id":"m_ex_brid_silenttrack_03_8","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_8","text":"thank you for the compliment.","jump":null},{"id":"m_ex_brid_silenttrack_03_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_9","text":"But why are you asking that all of a sudden?","jump":null},{"id":"m_ex_brid_silenttrack_03_10","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_10","text":"Hmm...","jump":null},{"id":"m_ex_brid_silenttrack_03_11","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_11","text":"Ever since I started wearing this outfit,","jump":null},{"id":"m_ex_brid_silenttrack_03_12","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_12","text":"I've been getting comments like","jump":null},{"id":"m_ex_brid_silenttrack_03_13","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_13","text":"\"I didn't know it was you\"","jump":null},{"id":"m_ex_brid_silenttrack_03_14","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_14","text":"or \"I didn't recognize you.\"","jump":null},{"id":"m_ex_brid_silenttrack_03_15","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_15","text":"Some even say,","jump":null},{"id":"m_ex_brid_silenttrack_03_16","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_16","text":"\"Clothes really do make the man.\"","jump":null},{"id":"m_ex_brid_silenttrack_03_17","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_17","text":"I know your compliments are always sincere,","jump":null},{"id":"m_ex_brid_silenttrack_03_18","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_18","text":"so they make me genuinely happy.","jump":null},{"id":"m_ex_brid_silenttrack_03_19","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_19","text":"But with others,","jump":null},{"id":"m_ex_brid_silenttrack_03_20","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_20","text":"it's hard to tell","jump":null},{"id":"m_ex_brid_silenttrack_03_21","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_21","text":"if they mean it.","jump":null},{"id":"m_ex_brid_silenttrack_03_22","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_22","text":"And when so many people say the same thing,","jump":null},{"id":"m_ex_brid_silenttrack_03_23","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_23","text":"it naturally catches my attention.","jump":null},{"id":"m_ex_brid_silenttrack_03_24","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_24","text":"That's why I wanted to ask.","jump":null},{"id":"m_ex_brid_silenttrack_03_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_25","text":"They all sound like compliments to me.","jump":null},{"id":"m_ex_brid_silenttrack_03_26","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_26","text":"Is that so?","jump":null},{"id":"m_ex_brid_silenttrack_03_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_27","text":"Yeah, the base is solid, so the outfit really stands out.","jump":null},{"id":"m_ex_brid_silenttrack_03_28","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_28","text":"When you say \"base,\"","jump":null},{"id":"m_ex_brid_silenttrack_03_29","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_29","text":"do you mean my original appearance?","jump":null},{"id":"m_ex_brid_silenttrack_03_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_30","text":"That's right.","jump":null},{"id":"m_ex_brid_silenttrack_03_31","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_31","text":"I see.","jump":null},{"id":"m_ex_brid_silenttrack_03_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_32","text":"Basically, you're reaaaally pretty!","jump":null},{"id":"m_ex_brid_silenttrack_03_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_33","text":"That's why the outfit looks amaaaazing on you!","jump":null},{"id":"m_ex_brid_silenttrack_03_34","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_34","text":"I spoke from the heart, but Brid isn't replying.","jump":null},{"id":"m_ex_brid_silenttrack_03_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_35","text":"Brid?","jump":null},{"id":"m_ex_brid_silenttrack_03_36","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_36","text":"Ah,","jump":null},{"id":"m_ex_brid_silenttrack_03_37","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_37","text":"my apologies for the late reply.","jump":null},{"id":"m_ex_brid_silenttrack_03_38","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_38","text":"Your praise felt a bit excessive,","jump":null},{"id":"m_ex_brid_silenttrack_03_39","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_39","text":"so I couldn't help but wonder if you were saying it","jump":null},{"id":"m_ex_brid_silenttrack_03_40","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_40","text":"just to comfort me.","jump":null},{"id":"m_ex_brid_silenttrack_03_41","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_41","text":"It also seemed somewhat","jump":null},{"id":"m_ex_brid_silenttrack_03_42","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_42","text":"more exaggerated than your usual responses.","jump":null},{"id":"m_ex_brid_silenttrack_03_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_43","text":"I'm serious! You're really pretty!","jump":null},{"id":"m_ex_brid_silenttrack_03_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_44","text":"So pretty!","jump":null},{"id":"m_ex_brid_silenttrack_03_45","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_45","text":"Hmm...","jump":null},{"id":"m_ex_brid_silenttrack_03_46","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_46","text":"I'll get back to work now.","jump":null},{"id":"m_ex_brid_silenttrack_03_47","type":"Speech","speaker":"brid_w","key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_47","text":"See you next time.","jump":null},{"id":"m_ex_brid_silenttrack_03_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_48","text":"Brid? Brid!","jump":null},{"id":"m_ex_brid_silenttrack_03_49","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_49","text":"But Brid did not reply.","jump":null},{"id":"m_ex_brid_silenttrack_03_50","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_silenttrack_03_50","text":"... I should be careful not to go overboard when complimenting her next time.","jump":null}],"chat":true}