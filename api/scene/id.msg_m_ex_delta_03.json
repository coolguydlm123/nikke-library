{"id":"msg_m_ex_delta_03","cat":"messenger","group":{"id":"room_delta","label":"Delta · Nikke"},"label":"3. Commander,","stage":null,"prev":"msg_m_ex_delta_02","next":"msg_m_ex_delta_04","speakers":{"delta":"Delta"},"icons":{"delta":"si_c020_00_s"},"lines":[{"id":"m_ex_delta_03_1","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_1","text":"Commander,","jump":null},{"id":"m_ex_delta_03_2","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_2","text":"I found an old box while I was cleaning out the warehouse in the Watchtower.","jump":null},{"id":"m_ex_delta_03_3","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_3","text":"I opened it and there seem to be all sorts of items inside.","jump":null},{"id":"m_ex_delta_03_4","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_4","text":"Do you know anything about this?","jump":null},{"id":"m_ex_delta_03_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_5","text":"Can't say I do.","jump":null},{"id":"m_ex_delta_03_6","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_6","text":"I see.","jump":null},{"id":"m_ex_delta_03_7","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_7","text":"Then I will discard this box.","jump":null},{"id":"m_ex_delta_03_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_8","text":"What exactly is inside?","jump":null},{"id":"m_ex_delta_03_9","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_9","text":"Please wait a moment.","jump":null},{"id":"m_ex_delta_03_10","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_10","text":"Delta becomes unresponsive for a while.","jump":null},{"id":"m_ex_delta_03_11","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_11","text":"Sorry to keep you waiting.","jump":null},{"id":"m_ex_delta_03_12","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_12","text":"I will report my findings:","jump":null},{"id":"m_ex_delta_03_13","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_13","text":"Combat Rations ×10\nCombat Knife ×1\nMen's Thermal Underwear Set ×4\nSocks ×4\nType A Tent ×1\n\nDetails are as above","jump":null},{"id":"m_ex_delta_03_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_14","text":"Seems like it belonged to a soldier.","jump":"m_ex_delta_03_16"},{"id":"m_ex_delta_03_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_15","text":"Seems like it belonged to a Commander.","jump":"m_ex_delta_03_16"},{"id":"m_ex_delta_03_16","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_16","text":"Yes, there is a high probability of that.","jump":null},{"id":"m_ex_delta_03_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_17","text":"Is there any form of identification?","jump":null},{"id":"m_ex_delta_03_18","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_18","text":"No, there isn't.","jump":null},{"id":"m_ex_delta_03_19","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_19","text":"Wait,","jump":null},{"id":"m_ex_delta_03_20","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_20","text":"though there is something at the bottom of the box.","jump":null},{"id":"m_ex_delta_03_21","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_21","text":"One moment.","jump":null},{"id":"m_ex_delta_03_22","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_22","text":"Delta becomes unresponsive for a while.","jump":null},{"id":"m_ex_delta_03_23","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_23","text":"Sorry to keep you waiting again.","jump":null},{"id":"m_ex_delta_03_24","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_24","text":"I've never seen anything like this before.","jump":null},{"id":"m_ex_delta_03_25","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_25","text":"It has a flat square shape.","jump":null},{"id":"m_ex_delta_03_26","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_26","text":"It protrudes into a roundish shape in the middle","jump":null},{"id":"m_ex_delta_03_27","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_27","text":"and has triangles dotting along the edge.","jump":null},{"id":"m_ex_delta_03_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_28","text":"Wait a minute...","jump":null},{"id":"m_ex_delta_03_29","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_29","text":"I'll open it.","jump":null},{"id":"m_ex_delta_03_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_30","text":"Those are vitamins.","jump":null},{"id":"m_ex_delta_03_31","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_31","text":"What was that?","jump":null},{"id":"m_ex_delta_03_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_32","text":"I said those are vitamins.","jump":null},{"id":"m_ex_delta_03_33","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_33","text":"Oh,","jump":null},{"id":"m_ex_delta_03_34","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_34","text":"I see.","jump":null},{"id":"m_ex_delta_03_35","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_35","text":"Now that I think about it,","jump":null},{"id":"m_ex_delta_03_36","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_36","text":"I seem to recall hearing about how humans used to take vitamins in the past.","jump":null},{"id":"m_ex_delta_03_37","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_37","text":"Would you like me to give it to you?","jump":null},{"id":"m_ex_delta_03_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_38","text":"Yes please","jump":null},{"id":"m_ex_delta_03_39","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_39","text":"Very well.","jump":null},{"id":"m_ex_delta_03_40","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_40","text":"I'll bring it over at once.","jump":null},{"id":"m_ex_delta_03_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_41","text":"Right now?","jump":null},{"id":"m_ex_delta_03_42","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_42","text":"Yes, I am nearby.","jump":null},{"id":"m_ex_delta_03_43","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_43","text":"I'll be there momentarily.","jump":null},{"id":"m_ex_delta_03_44","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_44","text":"Delta becomes unresponsive for a while.","jump":null},{"id":"m_ex_delta_03_45","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_45","text":"Sorry for taking so long.","jump":null},{"id":"m_ex_delta_03_46","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_46","text":"I've already delivered it.","jump":null},{"id":"m_ex_delta_03_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_47","text":"??","jump":null},{"id":"m_ex_delta_03_48","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_48","text":"I met Rapi on my way here, so I handed it to her.","jump":null},{"id":"m_ex_delta_03_49","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_49","text":"I told her you would be using it,","jump":null},{"id":"m_ex_delta_03_50","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_50","text":"so she should bring it to you soon enough.","jump":null},{"id":"m_ex_delta_03_51","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_51","text":"Um...","jump":null},{"id":"m_ex_delta_03_52","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_52","text":"??","jump":null},{"id":"m_ex_delta_03_53","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_53","text":"Is something wrong?","jump":null},{"id":"m_ex_delta_03_54","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_54","text":"Did Rapi say anything?","jump":null},{"id":"m_ex_delta_03_55","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_55","text":"Not really.","jump":null},{"id":"m_ex_delta_03_56","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_56","text":"However,","jump":null},{"id":"m_ex_delta_03_57","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_57","text":"she did have this thousand-yard stare.","jump":null},{"id":"m_ex_delta_03_58","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_58","text":"I've never seen her like that before,","jump":null},{"id":"m_ex_delta_03_59","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_59","text":"not even on the battlefield.","jump":null},{"id":"m_ex_delta_03_60","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_60","text":"I see","jump":null},{"id":"m_ex_delta_03_61","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_61","text":"Well then, I'll resume my rounds.","jump":null},{"id":"m_ex_delta_03_62","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_delta_03_62","text":"Have a good day!","jump":null},{"id":"m_ex_delta_03_63","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_delta_03_63","text":"You too.","jump":null}],"chat":true}