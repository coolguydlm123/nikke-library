ull,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35bf_02_21","text":"Our image on the largest digital billboard in the city.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_02_22","text":"What the...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_02_23","text":"Is that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_24","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_02_24","text":"Wow! I'm on the TV!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_02_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_26","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_26","text":"Take a closer look at what it's saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_02_27","text":"\"... The Commando Unit Counters successfully reclaimed part of the surface and uncovered significant findings in their exploration above ground.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_02_28","text":"\"This is the first instance of successful reclamation in recorded history, and the entire squad, along with their commander, deserve the highest praise.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_29","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_02_29","text":"We made the news?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_30","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_30","text":"Andersen and Mustang arranged it. Apparently, they persuaded the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_31","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_31","text":"Since idolization is highly frowned upon in the Ark, it's only being shown five times a day, when there's the least amount of foot traffic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_32","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_32","text":"But even so, this is the first time since New Hope that a commander has been officially recognized in any sizable way for their contributions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_02_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_34","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_34","text":"Whether you wanted it or not, your influence within the Ark is growing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_35","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_35","text":"In fact, you could say it's quite substantial.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_36","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_36","text":"Especially since you have the support of most of the core Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_37","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_37","text":"People will think twice before underestimating you now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_38","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_38","text":"No one can go after what's yours without consequences.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_39","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_39","text":"Of course, they may still succeed if they resort to extreme measures,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_40","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_40","text":"but they can no longer run roughshod over you like they could before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_41","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_41","text":"So you can rest easy regarding Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_42","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_35bf_02_42","text":"Her situation is top secret anyhow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_43","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_02_43","text":"... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_02_44","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_02_45","text":"I'll let the top down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_46","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_02_46","text":"If you could, please take a look around in the open air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_02_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_02_47","text":"Uh... sure. Okay.","jump":null,"