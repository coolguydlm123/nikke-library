{"id":"d_main_46_af_03","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"A Past Best Left Untouched","stage":null,"prev":"d_main_46_af_02","next":"d_main_46_af_04","speakers":{"dorothy":"Dorothy","doban":"Doban","rapi_red":"Rapi","pinneimitating":"Nikke Imitating Pinne","anis_i_w_op_r":"Anis","neon_v_w_op_l":"Neon"},"icons":{"dorothy":"si_c233_00_s","doban":"si_c939_00_s","rapi_red":"si_c016_00_s","pinneimitating":"si_c941_00_s","anis_i_w_op_r":"si_c017_00_s","neon_v_w_op_l":"si_c018_00_s"},"lines":[{"id":"d_main_46_af_03_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_1","text":"Dorothy brushes a fragment of something from her face and realizes with certainty.","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":"bgm_story_forark","movie":null,"shown":["doban","dorothy","product08","product12","soldierow"],"affinity":null},{"id":"d_main_46_af_03_2","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_2","text":"... What a dirty trick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_3","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_3","text":"Wh-what the hell! This Pilgrim killed those Nikkes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_4","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_4","text":"All units! Switch from suppression rounds to live ammunition!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_5","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_5","text":"This Pilgrim has no intention of cooperating!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_6","text":"All the mass-produced Nikkes simultaneously replace their magazines, and fire at Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_7","text":"But the bullets are the same as they were before. Everything was just for show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_8","text":"While dodging the bullets, Dorothy glares at Doban.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_9","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_9","text":"You conniving Pilgrim! You're bent on throwing the Ark into chaos, aren't you? But as long as I, Deputy Chief Doban, still stand, you won't succeed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_10","text":"His stentorian shouts are clearly meant to be heard by everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_11","text":"Dorothy feels a rage boiling from within.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_12","text":"Do you have a death wish?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_13","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_13","text":"You'd even lay hands on a human?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_14","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_14","text":"No matter how intensely you despise the Ark, isn't this going too far?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_15","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_16","text":"Looking at the loathsome man before her, spouting drivel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_17","text":"She considers perhaps breaking one of his legs wouldn't be so bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_18","text":"She could stage it as an accident. Make it look like he fell on his own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_19","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_20","text":"*Screeeech*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_21","text":"A mechanical sound echoes from above.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_22","text":"Dorothy looks up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_23","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_23","text":"Rapi and I land together, aboard Seven Dwarves Zero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_red"],"affinity":null},{"id":"d_main_46_af_03_24","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_24","text":"We assess the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_25","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_25","text":"Fragments of fallen Nikkes lie scattered across the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_26","text":"Dorothy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_27","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_27","text":"... It wasn't me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_28","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_28","text":"I know. I'm asking what happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_29","text":"Dorothy looks at Doban.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_30","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_30","text":"Were you the one who talked?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_31","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_31","text":"Huh...? About what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_32","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_32","text":"About me. To that human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_33","text":"Of course not. Why would I go around talking about that so carelessly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_35","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_35","text":"Ah, the Counters! The Ark's beacon of hope. You've arrived just in time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_36","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_36","text":"Pilgrim! It's over! Give up now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_37","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_37","text":"Have you come to stop me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_46_af_03_38","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_39","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_39","text":"... I see. In the end, you're all the same...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_46_af_03_40","text":"It seems like your patience is wearing thin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_41","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_46_af_03_41","text":"Considering how much Doban is provoking you, perhaps you were considering breaking his leg and staging it as an accident?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_42","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_43","text":"I don't know how things got to this point, but I think we should talk things over first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_44","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_44","text":"That is what I intended, but the other side does not seem so amenable to the idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_45","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_45","text":"... What? Hey, you! Aren't you here to back us up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_46","text":"No. We came to take Dorothy with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_47","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_47","text":"You fool! Take a good look at this carnage! That Pilgrim has already killed two of my precious Nikkes! Invaluable assets to the Ark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_48","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_48","text":"That's impossible. Dorothy doesn't use explosives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_49","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_49","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_50","text":"It looks to me that those Nikkes exploded from the inside out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_51","text":"As if someone planted bombs in them beforehand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_52","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_53","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_53","text":"You idiot! A little success and suddenly you can't see what's right in front of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_54","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_54","text":"This Pilgrim is set on overturning the Ark, and you're defending her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_55","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_56","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_56","text":"Yes. I am siding with Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_57","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_57","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_58","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_58","text":"You traitor! You have no idea what she's really capable of!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_59","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_59","text":"I would say I know her better than you do, Deputy Chief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_60","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_60","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_61","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_61","text":"Filthy traitors, the lot of you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_62","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_62","text":"I'll see you all court-martialed and hanged!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_63","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_63","text":"You say I don't know her true colors? It's you who doesn't!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_64","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_64","text":"I'll show you what kind of creature that Pilgrim really is!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_65","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_46_af_03_65","text":"Come out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_66","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_66","text":"At Doban's gesture, the formation parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_67","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_67","text":"Numerous mass-produced Nikkes step forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_68","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_68","text":"They are all Product 23 model Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pinnesame_01","pinnesame_02","pinnesame_03"],"affinity":null},{"id":"d_main_46_af_03_69","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_69","text":"All of them remove their visors to reveal familiar necklaces around their necks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_70","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_46_af_03_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_71","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_46_af_03_71","text":"No way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_72","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_72","text":"Memories from aboard the Utopia come rushing back to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_73","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_73","text":"The image that held Dorothy captivated. A name surfaces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_74","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_74","text":"... Pinne.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_75","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_75","text":"No. Something is different. The mass-produced Nikkes who have stepped forward each wear anxious expressions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_76","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_76","text":"They glance around nervously, their gazes wavering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_77","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_77","text":"They're all individuals Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_78","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_78","text":"They cautiously turn their eyes toward Dorothy.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_46_05_1","bgArt":"eventscene_chap_46_05_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_79","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_03_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_80","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_80","text":"Up until now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_81","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_81","text":"I've never seen Dorothy wear that expression.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_82","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_82","text":"Seeing Dorothy's face, Doban celebrates inwardly.","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":null,"movie":null,"shown":["doban","dorothy","rapi_red"],"affinity":null},{"id":"d_main_46_af_03_83","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_83","text":"The name he heard spoken through the wiretap while Dorothy was aboard the Utopia. Pinne.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_84","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_84","text":"The same one confirmed in the book from the Forbidden Library. Pinne.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_85","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_85","text":"Whoever this Pinne is, she's clearly someone important to Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_86","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_86","text":"So he dug through old records to learn everything he could about Pinne.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_87","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_87","text":"Fortunately, the book from the Forbidden Library even detailed her final demise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_88","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_88","text":"From there, he mobilized as many Product 23 models as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pinnesame_01","pinnesame_02","pinnesame_03"],"affinity":null},{"id":"d_main_46_af_03_89","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_89","text":"He prepared and equipped them with the same necklace seen in the photo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_90","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_90","text":"Now he'll send them hurtling toward Dorothy, then kill them all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_91","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_91","text":"If Dorothy becomes angry, good. If she loses reason, even better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_92","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_92","text":"If she comes charging at him to kill him, it'll be perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_93","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_93","text":"In that moment, she'll become the Ark's public enemy number one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_94","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_94","text":"The Nikkes at his side are equipped with energy shields rated against optical weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_95","text":"Dorothy uses optical weapons, favoring precision low-output shots over high-output ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_96","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_96","text":"The shields should hold against her shots well enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_97","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_97","text":"And in the process, Dorothy's weakness will become fully exposed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_98","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_98","text":"After that, everything will fall into place. He'll take down Dorothy, the Pilgrim with unclear motives who poses a clear threat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_99","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_99","text":"It will be easy to frame her for attempting to overthrow the Ark, especially because she's a well-known Pilgrim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_100","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_100","text":"Then Doban will be recognized for his efforts. For saving the Ark from danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_101","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_101","text":"He recalls Dorothy's reaction earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_102","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_102","text":"Drunk on the feeling of victory, Doban smiles for the first time in a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_103","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_103","text":"I don't fully understand the relationship between Pinne and Dorothy.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_46_05_1","bgArt":"eventscene_chap_46_05_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_104","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_104","text":"Even so, one thing is certain. Pinne is more precious to Dorothy than anyone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_105","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_03_105","text":"And the image of that very person... is standing before her now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_03_106","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_