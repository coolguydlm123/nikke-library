{"id":"d_counseling_rosanna_14","cat":"counsel","group":{"id":"char5045","label":"Rosanna"},"label":"Advising Rosanna: 14","stage":null,"prev":"d_counseling_rosanna_13","next":"d_counseling_rosanna_15","speakers":{"rosanna":"Rosanna"},"icons":{"rosanna":"si_c280_00_s"},"lines":[{"id":"d_counseling_rosanna_14_1","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_1","text":"I'm curious about something.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rosanna"],"affinity":"_0"},{"id":"d_counseling_rosanna_14_2","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_2","text":"What scares you more: a knife or a gun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rosanna_14_3","text":"Knife.","jump":"d_counseling_rosanna_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rosanna_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rosanna_14_4","text":"Gun.","jump":"d_counseling_rosanna_14_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rosanna_14_5","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_5","text":"I figured as much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_6","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_6","text":"People seem to fear knives more because they're so accessible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_7","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_7","text":"It's easier to imagine what it'd be like to get cut with one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_8","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_8","text":"In that case, I'll subject my next target to the tip of a knife.","jump":"d_counseling_rosanna_14_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_9","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_9","text":"Hmm. You've been around your fair share of guns, so I suppose it makes sense that you'd feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_10","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_10","text":"Most people have a greater fear of knives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_11","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_11","text":"The vast majority of people haven't been shot before, so it's probably harder for them to imagine the pain of a gunshot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_12","type":"Speech","speaker":"rosanna","key":"Locale_Counseling:d_counseling_rosanna_14_12","text":"So, I actually think I should torture my next target with a knife instead.","jump":"d_counseling_rosanna_14_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rosanna_14_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_rosanna_14_13","text":"I have a somewhat unnerving conversation with Rosanna.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}