":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_67","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_67","text":"A proper breakfast, no matter how modest, then straight to work!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_68","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_68","text":"If there's money to be made, we'll do whatever it takes! Every member of this organization united in purpose!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_69","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_69","text":"Lights out at midnight, then up to do it all over again!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_70","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_70","text":"All for a single goal: a paradise on the surface!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_71","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_71","text":"As the man launches into a passionate speech, the surrounding thugs nod along in agreement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_72","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_72","text":"And there, I shall become the god of the new world!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_73","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_73","text":"Mwahahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_74","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_75","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_75","text":"Watching the man bellow with laughter, I briefly wonder if we should just leave him alone and let the whole thing sort itself out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_76","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_76","text":"Then Sugar comes to and opens her eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_lastbullet","movie":null,"shown":["sugar"],"affinity":null},{"id":"treasurestory_sugar_03_77","type":"Speech","speaker":"sugar","key":"Locale_NikkeEpisode:treasurestory_sugar_03_77","text":"Mmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_78","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_78","text":"Well, look who's awake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_79","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_79","text":"I'd stay right where you are if I were you. One wrong move and someone's head is going to come off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_80","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_80","text":"Not yours, mind you, but your precious partner's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_81","type":"Speech","speaker":"sugar","key":"Locale_NikkeEpisode:treasurestory_sugar_03_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_82","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_82","text":"Sugar starts to sit up, then gives up and slumps back down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_83","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_83","text":"That's right, nice and easy. We can't have your precious partner getting hurt, can we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_84","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_84","text":"Hahaha! All that time I spent studying you two finally paid off!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_85","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_85","text":"The man tosses a USB drive my way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_86","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_86","text":"Well, now that you understand, you've got three days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_87","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_87","text":"Bring every item on that list to those coordinates!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_88","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_88","text":"Of course, you're free not to. But if you don't... your partner's going to end up in a very unfortunate situation!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_89","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_89","text":"Hahahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_90","type":"Speech","speaker":"villainboss","key":"Locale_NikkeEpisode:treasurestory_sugar_03_90","text":"That's right! That bike means a lot to her, right? Take it and her gun too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_91","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_91","text":"Once the thugs are gone and their booming laughter finally fades away, I turn my attention to the list.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_92","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_92","text":"It's meticulously organized, with all the required supplies neatly cataloged and even arranged by priority...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_93","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_93","text":"For a bunch of thugs, they're surprisingly diligent... Hm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_94","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_94","text":"I spot something where Sugar had collapsed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_95","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_95","text":"What's this...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_96","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_96","text":"*Clink*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_97","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_97","text":"I pick up the key to Black Typhoon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_98","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_sugar_03_99","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_sugar_03_99","text":"... The same one hanging from the keychain I gave her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}