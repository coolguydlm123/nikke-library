_98","type":"Speech","speaker":"volt","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_98","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_99","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_99","text":"Volt once again darts after Arcana, who has already taken off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["arcana_s"],"affinity":null},{"id":"d_ex_goddessofvictory_10_100","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_100","text":"Liter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_101","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_101","text":"How much do you actually know about Arcana?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_102","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_102","text":"This again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_103","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_103","text":"Why do you keep trying to bring up something she clearly doesn't want to tell me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_104","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_104","text":"I know, but I want to hear what you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":nu