omeone, but I didn't know it was you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_46","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_46","text":"Did you come to the park for a walk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_47","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_47","text":"Hm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_48","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_48","text":"You two know each other?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_49","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_49","text":"We know each other quite well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_50","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_50","text":"We sure do!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_51","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_51","text":"Well that's good to hear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_52","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_52",