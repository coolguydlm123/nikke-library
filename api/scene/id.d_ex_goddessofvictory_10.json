ech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_124","text":"So, it's settled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_125","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_125","text":"We'll meet here at this park once a week.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_126","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_126","text":"Perhaps spending time playing with Volt will help her heart slowly heal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_127","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_127","text":"And of course, Greenhorn, you'll be coming too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_128","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_128","text":"No, I'm telling you, she really is a librarian...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_129","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_129","text":"And so, we arranged to have a small weekly gathering at the park.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_130","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_130","text":"Only after Arcana appeared in her usu