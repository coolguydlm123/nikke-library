l},{"id":"d_ex_goddessofvictory_10_111","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_111","text":"Well, you see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_112","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_112","text":"Wounds on the body can be treated with medicine,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_113","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_113","text":"whereas wounds of the heart have no cure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_114","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_114","text":"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_115","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_115","text":"A librarian in a school uniform...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_116","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_116","text":"Perhaps she doesn't know exactly who she is,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_117","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_117","text":"and wants to inhabit a role of sorts to help with that.","jump":null,"exit":false,"enter":nul