:d_ex_goddessofvictory_10_12","text":"Of course! I love dogs!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_13","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_13","text":"C'mon, Volt. Let's run aaall the way over there and back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_14","type":"Speech","speaker":"volt","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_14","text":"*Woof woof woof*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_15","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_15","text":"Start running on three, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_16","type":"Speech","speaker":"volt","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_16","text":"*Woof woof*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_17","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_17","text":"One... Go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_18","type":"Speech","speaker":"volt","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_18","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_19","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_19","text":"Arcana dashes off immediately after shouting, \"one,\" with Volt right on her heels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["arcana_s","volt"],"affinity":null},{"id":"d_ex_goddessofvictory_10_20","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_20","text":"Hey, Liter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_21","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_21","text":"Gah! You startled me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_22","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_22","text":"Next time, don't sneak up on me, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_23","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_23","text":"... I didn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_24","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_24","text":"Anyway, what are you doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_25","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_25","text":"I was taking Volt for a walk and ran into this young lady.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_26","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_26","text":"Volt took quite a liking to her and kept following her around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_27","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_27","text":"Well, they say dogs can sense a person's true nature,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_28","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_28","text":"and after talking with her a bit, I understand why Volt is so fond of her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_29","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_29","text":"She's a fine, upstanding young lady, the type you don't see too often in this day and age.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_30","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_30","text":"Though... there's something a little sad about her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_31","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_31","text":"How do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_32","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_32","text":"Well, what's the point of poking your nose into someone else's pain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_33","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_33","text":"Does Liter know Arcana's secret?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_34","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_34","text":"But that must be classified information, surely?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_35","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_35","text":"Anyway, what are you up to, Greenhorn?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_36","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_10_36","text":"Just out for a stroll.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_37","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_37","text":"Ah, excellent. It's good to get some exercise!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_10_38","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_goddessofvictory_10_38","text":"Young folks these days hardly ever engage in any physical activity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt"