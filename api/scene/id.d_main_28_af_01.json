{"id":"d_main_28_af_01","cat":"main","group":{"id":"ch28","label":"Chapter 28 · The Unknown"},"label":"Those Left Behind","stage":null,"prev":"d_main_28_11_e","next":"d_main_28_af_02","speakers":{"shifty":"Shifty","neon":"Neon","rapi":"Rapi","anis":"Anis"},"icons":{"shifty":"si_c907_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s"},"lines":[{"id":"d_main_28_af_01_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_28_af_01_1","text":"Reclamation Site 01","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":"bgm_distress_a","movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_2","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_2","text":"Allow me to relay the Central Government's report regarding the current situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty","rapi","neon","anis"],"affinity":null},{"id":"d_main_28_af_01_3","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_3","text":"First, the massive elevator discovered in what we have referred to as the Crystal Region has been confirmed as not being created by natural forces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_4","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_4","text":"This confirms that an intelligent entity is either stationed in that area, or is exerting an influence over it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_5","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_5","text":"Our speculation is that this intelligent entity is either a Pilgrim or a Heretic,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_6","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_6","text":"with opinion skewing towards the latter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_28_af_01_7","text":"Why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_8","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_8","text":"Doing so would justify deploying government forces to that area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_af_01_9","text":"Since Pilgrims are considered fairly benign?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_10","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_10","text":"Correct. Cases of conflict with Pilgrims on the surface are few and far between, and even then, the damage incurred was minimal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_11","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_11","text":"The Central Government is inclined to believe the entity in question is a Heretic,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_12","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_12","text":"and so the consensus is that a proactive strike should take precedence over any search effort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_13","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_13","text":"A strike force will soon be dispatched from the Ark to Reclamation Site 01.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_28_af_01_14","text":"And who will that strike force  be composed of?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_15","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_15","text":"Absolute and Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_af_01_16","text":"Good. If they're on the case, then we can rest easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_17","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_28_af_01_17","text":"Are they coming right away?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_18","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_18","text":"No. There is a small complication.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_19","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_19","text":"They are currently in the middle of an important mission,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_20","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_20","text":"so they will only be able to report after completing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_af_01_21","text":"So when can we count on a rescue operation being launched?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_af_01_22","text":"Are you saying we've got to sit around and wait until Absolute and Matis show up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_af_01_23","text":"Hammering's arm is riddled with crystals. We have no idea what it could do to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_24","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_28_af_01_24","text":"We are also in the dark as to what lies beyond the elevator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_28_af_01_25","text":"In this situation, we would prefer immediate action to be taken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_26","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_26","text":"I have been told that their mission is of utmost importance, and they cannot be taken away from it now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_af_01_27","text":"So what should we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_28","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_28_af_01_28","text":"We move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_af_01_29","text":"Just us? I don't like those odds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_30","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_28_af_01_30","text":"We can't just sit here and twiddle our thumbs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_31","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_31","text":"I figured you would respond in this manner,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_32","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_32","text":"so I took it upon myself to contact the remaining members of the following squads:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_33","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_33","text":"Hammer & Drill, Pathfinder, and Electric Shock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_af_01_34","text":"Oh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_35","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_35","text":"It didn't take much convincing to get them to agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_36","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_36","text":"For better or for worse, they do not have much work at the moment, and so they gladly accepted my proposal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_37","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_37","text":"The CEOs of the Big Three have also approved of this plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_af_01_38","text":"Wow, you're amazing, Shifty!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_af_01_39","text":"We couldn't have asked for a better operator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_40","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_40","text":"They'll be arriving soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_41","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_41","text":"Once they do, you all can formulate a strategy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_28_af_01_42","text":"Thank you, Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_af_01_43","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_28_af_01_43","text":"Don't mention it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}