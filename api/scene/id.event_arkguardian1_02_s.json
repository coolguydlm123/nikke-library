ian1_02_s_20","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_20","text":"Hope is important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_21","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_21","text":"... Half a year, maybe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_22","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_22","text":"Less, if you push yourself too hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_23","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_23","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_24","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_24","text":"So there's really no other way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_25","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_25","text":"There's no cure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_26","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_26","text":"Those idiots. They built it without even knowing how to fix it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_27","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_27","text":"This body was intended for short-term battles after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_28","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_28","text":"The problem is that the war has dragged on for too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_29","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_29","text":"Do you think we'll be victorious in six months' time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_30","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_30","text":"Not a chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_31","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_31","text":"Losing, though... that's possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_32","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_32","text":"As expected... The Goddess squad alone can't win such a drawn-out war.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_33","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_33","text":"Sure, we're undefeated, but there are fewer than ten of us in this squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_34","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_34","text":"All we can do now is serve as a symbol of hope for humanity on the battlefield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_35","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_35","text":"Well, we certainly pulled that off admirably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_36","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_36","text":"Yeah... maybe too admirably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_37","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_37","text":"We've already become the hope of humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_38","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_s_38","text":"So you've gotta stay alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_s_39","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_s_39","text":"Hehe, I wish it were that simple.","jump":null,"exit":false,"e