1_06_s_5","text":"Miss Syuen, please tell us about the rules!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_6","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_6","text":"This round is called High-Tech Wrestling!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["syuen_op_c"],"affinity":null},{"id":"event_coinrushshowdown1_06_s_7","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_7","text":"The rules are simple. Everyone steps into the ring and tries to push their opponent off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_8","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_8","text":"Anything goes. Well... except violence, I guess. Eh, whatever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_9","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_9","text":"The round lasts three minutes, and any scrap metal that falls off the stage is eliminated. Simple, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_10","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_10","text":"Oh my! This seems a little too violent for an entertainment show!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_11","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_11","text":"Wh-what did you just say?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_12","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_12","text":"All you have to do is use brute force to push your opponents off the stage. I'm not sure which part of this is supposed to be entertaining! Haha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_13","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_13","text":"Besides, this appears to give Guilty of Plan C an overwhelming advantage. What do you have to say about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_14","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_14","text":"If you think it's unfair, then get some better wearable tech yourselves!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_15","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_15","text":"Unbelievable! Miss Syuen is openly showing favoritism toward a team under Missilis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_16","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_16","text":"That won't do! Coin Rush Showdown must be fair and entertaining!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_17","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_17","text":"In light of that, the organizers will be introducing an additional rule!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_18","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_18","text":"What? I didn't hear anything about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_19","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_19","text":"Of course not! I just made this rule up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_20","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_20","text":"This is a measure to ensure a fair and entertaining match. We kindly ask for your cooperation!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_21","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_21","text":"Now then, the brand-new rule is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_22","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_22","text":"Let's go with this! You must push your opponent out using only a specific body part!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_23","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_23","text":"What the heck is that supposed to mean?! You can't just change things out of nowhere!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_24","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_24","text":"Now, please direct your attention to the screen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_25","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_25","text":"As you can see, the roulette contains a list of body parts. Arms, legs, head, chest, even your toes! There's plenty to choose from!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_26","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_26","text":"Miss Syuen, please press the button to spin the roulette!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["syuen_op_c"],"affinity":null},{"id":"event_coinrushshowdown1_06_s_27","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_06_s_27","text":"You'll have to compete using only the body part chosen by the roulette!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_06_s_28","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_coinru