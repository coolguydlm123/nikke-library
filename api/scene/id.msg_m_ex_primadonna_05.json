{"id":"msg_m_ex_primadonna_05","cat":"messenger","group":{"id":"room_primadonna","label":"Prima Donna · Group"},"label":"5. Hey,","stage":null,"prev":"msg_m_ex_primadonna_04","next":"msg_m_ex_liarsend_01","speakers":{"volume":"Volume","aria":"Aria","noise":"Noise"},"icons":{"volume":"si_c431_00_s","aria":"si_c432_00_s","noise":"si_c430_00_s"},"lines":[{"id":"m_ex_primadonna_05_1","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_1","text":"Hey,","jump":null},{"id":"m_ex_primadonna_05_2","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_2","text":"does anyone have a moment?","jump":null},{"id":"m_ex_primadonna_05_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_3","text":"What's up?","jump":null},{"id":"m_ex_primadonna_05_4","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_4","text":"I'm a little bit worried about","jump":null},{"id":"m_ex_primadonna_05_5","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_5","text":"Aria and Noise.","jump":null},{"id":"m_ex_primadonna_05_6","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_6","text":"You thinking about other people?","jump":null},{"id":"m_ex_primadonna_05_7","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_7","text":"That's a first.","jump":null},{"id":"m_ex_primadonna_05_8","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_8","text":"You're not going to bring up","jump":null},{"id":"m_ex_primadonna_05_9","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_9","text":"that group interview thing again,","jump":null},{"id":"m_ex_primadonna_05_10","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_10","text":"are you?","jump":null},{"id":"m_ex_primadonna_05_11","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_11","text":"We already decided before that we weren't going to do it.","jump":null},{"id":"m_ex_primadonna_05_12","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_12","text":"Is this the beginning of round two?","jump":"m_ex_primadonna_05_14"},{"id":"m_ex_primadonna_05_13","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_13","text":"I say we let that matter drop.","jump":"m_ex_primadonna_05_14"},{"id":"m_ex_primadonna_05_14","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_14","text":"Don't worry.","jump":null},{"id":"m_ex_primadonna_05_15","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_15","text":"It's okay, Manager.","jump":null},{"id":"m_ex_primadonna_05_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_16","text":"I can feel some gray hairs coming on already.","jump":null},{"id":"m_ex_primadonna_05_17","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_17","text":"Come on,","jump":null},{"id":"m_ex_primadonna_05_18","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_18","text":"don't be like that.","jump":null},{"id":"m_ex_primadonna_05_19","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_19","text":"All right, listen up.","jump":null},{"id":"m_ex_primadonna_05_20","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_20","text":"All of us in the Prima Donna squad","jump":null},{"id":"m_ex_primadonna_05_21","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_21","text":"are famous celebrities","jump":null},{"id":"m_ex_primadonna_05_22","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_22","text":"who sell out every performance, right?","jump":null},{"id":"m_ex_primadonna_05_23","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_23","text":"You know what I'm saying!","jump":null},{"id":"m_ex_primadonna_05_24","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_24","text":"Right.","jump":null},{"id":"m_ex_primadonna_05_25","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_25","text":"Yeah.","jump":null},{"id":"m_ex_primadonna_05_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_26","text":"Yup.","jump":null},{"id":"m_ex_primadonna_05_27","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_27","text":"The more famous we become, the more interview requests we'll get.","jump":null},{"id":"m_ex_primadonna_05_28","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_28","text":"Sure, we might be able to turn down a few of them,","jump":null},{"id":"m_ex_primadonna_05_29","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_29","text":"but we won't be able to avoid all of them.","jump":null},{"id":"m_ex_primadonna_05_30","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_30","text":"Right?","jump":null},{"id":"m_ex_primadonna_05_31","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_31","text":"Hmm...","jump":null},{"id":"m_ex_primadonna_05_32","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_32","text":"Probably.","jump":null},{"id":"m_ex_primadonna_05_33","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_33","text":"Our fans are the only reason","jump":null},{"id":"m_ex_primadonna_05_34","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_34","text":"that we can do what we do.","jump":null},{"id":"m_ex_primadonna_05_35","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_35","text":"I think answering some of the questions they want to know","jump":null},{"id":"m_ex_primadonna_05_36","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_36","text":"is a way of reciprocating the love our fans give us.","jump":null},{"id":"m_ex_primadonna_05_37","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_37","text":"That's the first sensible thing you've said in ages.","jump":null},{"id":"m_ex_primadonna_05_38","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_38","text":"Come on,","jump":null},{"id":"m_ex_primadonna_05_39","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_39","text":"don't ruin the moment.","jump":null},{"id":"m_ex_primadonna_05_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_40","text":"So what is it that you wanted to say, exactly?","jump":null},{"id":"m_ex_primadonna_05_41","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_41","text":"I'm just saying that","jump":null},{"id":"m_ex_primadonna_05_42","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_42","text":"we should try sharing some information about us in the future.","jump":null},{"id":"m_ex_primadonna_05_43","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_43","text":"Information?","jump":null},{"id":"m_ex_primadonna_05_44","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_44","text":"What kind?","jump":null},{"id":"m_ex_primadonna_05_45","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_45","text":"Like doing interviews!","jump":null},{"id":"m_ex_primadonna_05_46","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_46","text":"I think it's important, too.","jump":null},{"id":"m_ex_primadonna_05_47","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_47","text":"Hold on,","jump":null},{"id":"m_ex_primadonna_05_48","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_48","text":"didn't you have that one interview that was a nightmare?","jump":null},{"id":"m_ex_primadonna_05_49","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_49","text":"Oh sure.","jump":null},{"id":"m_ex_primadonna_05_50","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_50","text":"It was a total smear job that focused solely on my scandals.","jump":null},{"id":"m_ex_primadonna_05_51","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_51","text":"You're nothing but scandals.","jump":null},{"id":"m_ex_primadonna_05_52","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_52","text":"Hey, watch it.","jump":null},{"id":"m_ex_primadonna_05_53","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_53","text":"Anyway, that person kept poking and prodding","jump":null},{"id":"m_ex_primadonna_05_54","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_54","text":"about my relationship with Manager.","jump":null},{"id":"m_ex_primadonna_05_55","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_55","text":"What did you say?","jump":"m_ex_primadonna_05_57"},{"id":"m_ex_primadonna_05_56","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_56","text":"You can tell them the truth.","jump":"m_ex_primadonna_05_60"},{"id":"m_ex_primadonna_05_57","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_57","text":"I left it to their imagination.","jump":null},{"id":"m_ex_primadonna_05_58","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_58","text":"That'll only create more room for misunderstanding.","jump":null},{"id":"m_ex_primadonna_05_59","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_59","text":"What's there to misunderstand?","jump":"m_ex_primadonna_05_65"},{"id":"m_ex_primadonna_05_60","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_60","text":"Of course I was honest.","jump":null},{"id":"m_ex_primadonna_05_61","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_61","text":"I told him our relationship was... complicated.","jump":null},{"id":"m_ex_primadonna_05_62","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_62","text":"That's hardly what I'd call honest.","jump":null},{"id":"m_ex_primadonna_05_63","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_63","text":"Isn't it though? Would you call our relationship simple?","jump":null},{"id":"m_ex_primadonna_05_64","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_64","text":"...","jump":"m_ex_primadonna_05_65"},{"id":"m_ex_primadonna_05_65","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_65","text":"Ah,","jump":null},{"id":"m_ex_primadonna_05_66","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_66","text":"I think I know who you're talking about.","jump":null},{"id":"m_ex_primadonna_05_67","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_67","text":"He was very persistent with me too.","jump":null},{"id":"m_ex_primadonna_05_68","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_68","text":"What an oaf.","jump":null},{"id":"m_ex_primadonna_05_69","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_69","text":"Watch out for him, Aria.","jump":null},{"id":"m_ex_primadonna_05_70","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_70","text":"Okay.","jump":null},{"id":"m_ex_primadonna_05_71","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_71","text":"It's good that we're sharing this information amongst each other.","jump":null},{"id":"m_ex_primadonna_05_72","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_72","text":"How about we do this regularly from now on?","jump":null},{"id":"m_ex_primadonna_05_73","type":"Speech","speaker":"aria","key":"Locale_SuddenMessage:m_ex_primadonna_05_73","text":"I don't know about that.","jump":null},{"id":"m_ex_primadonna_05_74","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_74","text":"Yeah, that might be a bit difficult for me too.","jump":null},{"id":"m_ex_primadonna_05_75","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_primadonna_05_75","text":"I don't want anything to cut into my practice time.","jump":null},{"id":"m_ex_primadonna_05_76","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_76","text":"Sorry, but I'm busy too.","jump":null},{"id":"m_ex_primadonna_05_77","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_primadonna_05_77","text":"As far as sharing information goes, we'll have to make it a one-time thing.","jump":null},{"id":"m_ex_primadonna_05_78","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_primadonna_05_78","text":"I think a group interview is only bound to end in disaster.","jump":null}],"chat":true}