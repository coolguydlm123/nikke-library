terisland_prologue_54","type":"Speech","speaker":"burningum","key":"Locale_SubScenario:event_bluewaterisland_prologue_54","text":"It's a written document that's been pa-passed down in my family.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland_prologue_55","type":"Speech","speaker":"burningum","key":"Locale_SubScenario:event_bluewaterisland_prologue_55","text":"It's a record left by someone that worked as a secretary of the Central Government,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland_prologue_56","type":"Speech","speaker":"burningum","key":"Locale_SubScenario:event_bluewaterisland_prologue_56","text":"so the information contained within at least comes from a place of authority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland_prologue_57","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_bluewaterisland_prologue_57","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland_prologue_58","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_bluewaterisland_prologue_58","text":"If it's coming from you, then I trust it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland_prologue_59","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_bluewaterisland_prologue_59","text":"Unless anybody has any other ideas, I say we proceed with the preliminary research Buringum mentioned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":n