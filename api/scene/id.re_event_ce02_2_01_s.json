ty":null},{"id":"re_event_ce02_2_01_s_75","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_75","text":"You're saying that these Raptures and mass-produced Nikkes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_76","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_76","text":"were both being manufactured here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_77","type":"Speech","speaker":"ce_02_npc_01","key":"Locale_SubScenario:event_ce02_2_01_s_77","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_78","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_78","text":"That would mean that all those Nikkes in there are replicants created by the Gatekeeper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_79","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce02_2_01_s_79","text":"That may well be the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_80","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce02_2_01_s_80","text":"Before we escaped from the Central Production Room,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_81","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce02_2_01_s_81","text":"we all saw that one fallen Nikke disintegrate into a mass of light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_82","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_82","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_83","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_83","text":"Then there's no doubt about it. They're 100% replicants!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_84","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce02_2_01_s_84","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_85","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_85","text":"But then why were they fighting with the Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_86","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_86","text":"If both sides were conjured up by the Gatekeeper, they shouldn't have any reason to fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_87","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce02_2_01_s_87","text":"It's impossible to know for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_event_ce02_2_01_s_88","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce02_2_01_s_88","text":"Ugh... this just keeps getting more