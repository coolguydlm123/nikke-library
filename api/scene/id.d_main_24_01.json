{"id":"d_main_24_01","cat":"main","group":{"id":"ch24","label":"Chapter 24 · Banishment"},"label":"Well Prepared","stage":"24-1 STAGE · Start","prev":null,"next":"d_main_24_02","speakers":{"Narration":"Narration","announcer":"Announcer","crow":"Crow"},"icons":{"Narration":"si_c999_00_s","announcer":"si_c912_00_s","crow":"si_c110_00_s"},"lines":[{"id":"d_main_24_01_1","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_1","text":"Inside one of the AZX carriages.","jump":null,"exit":false,"enter":null,"bg":"AZXIn","bgArt":"azxin","image":null,"bgm":"bgm_manifest","movie":null,"shown":["crow"],"affinity":null},{"id":"d_main_24_01_2","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_2","text":"Outside the window, the scenery flies by in a blur.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_3","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_3","text":"The intercom blares the latest broadcast from the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_4","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_4","text":"An unprecedented incident has occurred: Raptures have entered the Ark.","jump":null,"exit":false,"enter":null,"bg":"Stage","bgArt":"stage","image":null,"bgm":null,"movie":null,"shown":["announcer"],"affinity":null},{"id":"d_main_24_01_5","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_5","text":"However, thanks to the Central Government's rapid response time, citizens were all evacuated to the safety shelters in time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_6","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_6","text":"Thanks to the remarkable efforts of the Nikkes who have been deployed to fight the Raptures,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_7","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_7","text":"there are astonishing reports of zero causalities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_8","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_8","text":"The Ark is safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_9","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_9","text":"According to statements from the Central Government, the entire incident is expected to be resolved within two days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_10","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_10","text":"Citizens are strongly advised to remain inside the shelters.","jump":null,"exit":false,"enter":null,"bg":"EmptyShelter","bgArt":"emptyshelter","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_11","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_11","text":"In order to prevent any loss of life, the doors to the shelters will only be unlocked once the situation is resolved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_12","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_12","text":"Escape attempts are strongly discouraged, and be warned that anyone who attempts to approach the shelter doors may be shot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_13","type":"Speech","speaker":"announcer","key":"Locale_MainScenario:d_main_24_01_13","text":"There are plenty of supplies inside the shelters, so we encourage citizens to remain calm, and stay where they are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_14","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_14","text":"Crow stares at the bruised and battered people in front of her.","jump":null,"exit":false,"enter":null,"bg":"AZXIn","bgArt":"azxin","image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_main_24_01_15","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_15","text":"The emergency medical team rushes to and fro, tending to the wounded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_16","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_16","text":"The carriage is in complete disarray.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_17","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_17","text":"A person moans in pain, another is on the brink of passing out. Someone is crying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_18","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_18","text":"And the medical team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_19","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_19","text":"Crow locks eyes with one of the medical staff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_20","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_20","text":"After staring at Crow briefly, they head back to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_21","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_21","text":"Crow listens in on the various conversations that are taking place around her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_22","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_22","text":"We're all finished. I've never seen a Rapture in real life. It was colossal! I was afraid for my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_23","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_23","text":"The Ark is done for. We're all gonna die down here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_24","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_24","text":"The Nikkes will protect us. I would have died earlier if it hadn't been for them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_25","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_25","text":"I used to hate Nikkes, but now I'm not so sure...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_26","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_26","text":"I've heard that it was the Nikkes who lured the Raptures to the Ark in the first place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_27","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_27","text":"A lot of commanders died. \nI feel bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_28","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_28","text":"A Nikke lies in the corner, sobbing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_29","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_29","text":"It's insanity to think we stand a chance against the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_30","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_01_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_31","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_31","text":"Crow gets up slowly without attracting anyone's attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_32","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_32","text":"She maneuvers her way through the different carriages,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_33","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_33","text":"heads to a doorway, and waits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_34","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_34","text":"*Swoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_35","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_35","text":"There's a sound of flushing water, and the door to the restroom opens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_36","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_36","text":"Crow heads inside the restroom.","jump":null,"exit":false,"enter":null,"bg":"ShowerRoom","bgArt":"showerroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_37","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_37","text":"*Click*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_38","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_38","text":"She locks the door, rummages through her pockets,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_39","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_39","text":"and places a bomb in a corner, out of sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_40","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_40","text":"*Swoosh*","jump":null,"exit":false,"enter":null,"bg":"AZXIn","bgArt":"azxin","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_41","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_41","text":"She flushes the toilet and leaves the restroom,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_42","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_42","text":"slowly saunters her way through several carriages,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_43","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_43","text":"leans against the wall,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_44","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_44","text":"and pulls out a crudely made remote control from her pocket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_45","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_01_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_46","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_01_46","text":"This train's a one-way ticket to hell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_01_47","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_01_47","text":"*Click*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}