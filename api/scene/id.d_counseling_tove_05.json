{"id":"d_counseling_tove_05","cat":"counsel","group":{"id":"char5081","label":"Tove"},"label":"Advising Tove: 05","stage":null,"prev":"d_counseling_tove_04","next":"d_counseling_tove_06","speakers":{"tove":"Tove"},"icons":{"tove":"si_c192_00_s"},"lines":[{"id":"d_counseling_tove_05_1","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_1","text":"One time, there was a sudden gust of wind during one of my missions,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["tove"],"affinity":"_0"},{"id":"d_counseling_tove_05_2","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_2","text":"so I went to a nearby ice cave to take shelter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_3","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_3","text":"But, someone was already inside!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_tove_05_4","text":"Don't tell me it was... Neve?","jump":"d_counseling_tove_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_tove_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_tove_05_5","text":"Don't tell me it was... a bear?","jump":"d_counseling_tove_05_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_tove_05_6","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_6","text":"... Uh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_7","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_7","text":"Oh, if it was then I wouldn't be here right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_8","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_8","text":"Neve is usually friendly but if you bother her when she's sleeping...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_9","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_9","text":"She'd probably tear you to shreds.","jump":"d_counseling_tove_05_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_10","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_10","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_11","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_11","text":"So I gently walked backwards while avoiding eye contact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_12","type":"Speech","speaker":"tove","key":"Locale_Counseling:d_counseling_tove_05_12","text":"*Sigh* I still get goosebumps thinking about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_tove_05_13","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_tove_05_13","text":"Tove and I share our