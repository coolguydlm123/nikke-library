ch","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2_20","text":"Be proud. You deserve it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_07_2_21","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_07_2_22","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2_22","text":"I'm so happy","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_07_2_23","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2_23","text":"I was able to meet all of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_07_2_24","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2_24","text":"I don't want to leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_07_2_25","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2_25","text":"I hope you never get to see this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_07_2_26","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2_26","text":"... Still, if by any chance you are watching this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_07_2_27","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_07_2