ity":null},{"id":"d_nikke_liter_03_77","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_03_77","text":"Pretty sure they're just fighting at this point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_78","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_liter_03_78","text":"Seems like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_79","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_03_79","text":"I'll go stop them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_80","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_liter_03_80","text":"... Please do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_81","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_03_81","text":"Liter, Anis, enou...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_82","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_82","text":"Hey!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_83","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_83","text":"Don't even think about messing with me again, got it!?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_84","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_03_84","text":"If you don't mess up this place, then I shall gladly do so!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_85","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_85","text":"Who the hell do you think you are to boss me around?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_86","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_86","text":"Whether I mess this place up or die a pointless death on the surface—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_87","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_87","text":"it's none of your damn business!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_88","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_03_88","text":"I'm going to make a decent human out of you, mark my words!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_89","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_89","text":"So, if I don't clean up, I'm not even human?\nAnd if I mess up the place, that makes me less than human too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_90","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_03_90","text":"I'm telling you to live properly! What're you thinking, living all sloppy like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_91","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_91","text":"You know, I might die on the surface tomorrow!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_92","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_92","text":"I'm just a fly living on borrowed time; I don't even know when my heart's gonna stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_93","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_93","text":"So what's the point of trying so hard? Should I live hoping for tomorrow? Dream about some bright future?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_94","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_94","text":"And what if I just die suddenly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_95","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_95","text":"When you're dead, none of it means a damn thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_96","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_96","text":"Whether you bust your ass or just coast, it's all over once you're gone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_97","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_03_97","text":"Even so, you can't just give up like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_98","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_03_98","text":"You must never give up, you hear me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_99","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_99","text":"Cut the crap!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_100","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_100","text":"When you die, that's the end of everything. You really think playing house will change my mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_101","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_101","text":"You Mighty Tools guys don't get what it's like for us going up to the surface!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_102","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_102","text":"In a split second, a squadmate drops dead right beside you, and it's totally normal to die from taking one wrong step.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_103","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_103","text":"While you're safe back here hammering away, you don't know a damn thing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_104","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_104","text":"Hell, I don't even know what's gonna happen to me in the next ten minutes! So why the heck should I be sitting around cleaning and tidying up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_105","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_105","text":"If that's how you find peace, then go ahead and do it yourselves. I'm not signing up for that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_106","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_03_106","text":"Anis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_107","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_03_107","text":"Anis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_108","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_03_108","text":"What? Did I say anything wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_03_109","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_03_109","text":"... You...!\nYou hopeless little fool...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity"