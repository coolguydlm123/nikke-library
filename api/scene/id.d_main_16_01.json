{"id":"d_main_16_01","cat":"main","group":{"id":"ch16","label":"Chapter 16 · Brand"},"label":"Exotic","stage":"16-1 STAGE · Start","prev":null,"next":"d_main_16_02","speakers":{"rapi":"Rapi","anis":"Anis","neon":"Neon","jackal":"Jackal","crow":"Crow","viper":"Viper","Self":"Commander"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","jackal":"si_c111_00_s","crow":"si_c110_00_s","viper":"si_c112_00_s"},"lines":[{"id":"d_main_16_01_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_01_1","text":"We've just received updated map information from Unlimited.","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":"bgm_secondhand_a","movie":null,"shown":["rapi","anis","neon","viper","jackal","crow"],"affinity":null},{"id":"d_main_16_01_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_01_2","text":"This version shows the coordinates for the latest Pilgrim sightings over the past few months.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_01_3","text":"According to this, we can expect to encounter the Pilgrims here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_01_4","text":"Commonly known as the mage's zone. Despite it being located in the north, where Alva particles are low, the concentration in this area averages 100%.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_01_5","text":"Wow. No wonder communication wasn't possible with Snow White.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_16_01_6","text":"Even short-range communications are probably jammed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_7","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_01_7","text":"An area completely sealed off from all radio waves...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_8","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_01_8","text":"It's perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_9","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_01_9","text":"If communications are jammed, then we won't be able to report in. We can go on a rampage and get off scot free!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_10","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_01_10","text":"Isn't that right, Captain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_11","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_01_11","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_12","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_01_12","text":"That's in the Ark. This is the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_13","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_13","text":"That's right. Use your head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_14","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_01_14","text":"Hmph... Still.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_15","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_01_15","text":"Why don't you ask your new owner?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_16","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_01_16","text":"Never.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_01_17","text":"What the hell was Syuen thinking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_01_18","text":"The Exotic Squad. Comprised entirely of Outer Rim residents who were turned into Nikkes after committing first-degree crimes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_01_19","text":"There are even rumors that their leader Crow was the former head of Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_01_20","text":"What's Syuen doing, sending in this sorry lot of support troops?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_01_21","text":"I'm more worried about them sticking a knife in my back than any Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_22","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_22","text":"C'mon, don't be like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_23","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_23","text":"Sure, we're no angels, but just give us a chance to redeem ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_24","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_24","text":"You see this choker on my neck?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_25","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_25","text":"It's a remote bomb.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_26","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_26","text":"All three of us are wearing one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_27","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_27","text":"And Syuen has her finger on the button.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_28","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_28","text":"However, if we bring her this V.. Vast... whatever it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_29","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_16_01_29","text":"She'll take off these chokers! You know, in exchange for us helping out the Ark and what not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_30","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_01_30","text":"Yes, absolutely!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_31","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_01_31","text":"So we mean business. We'll help ya get rid of all these Raptures or whatever you call 'em.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_01_32","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_01_32","text":"We'll trust you for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}