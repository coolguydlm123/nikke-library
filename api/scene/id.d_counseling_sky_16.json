{"id":"d_counseling_sky_16","cat":"counsel","group":{"id":"char5188","label":"Sky"},"label":"Advising Sky: 16","stage":null,"prev":"d_counseling_sky_15","next":"d_counseling_sky_17","speakers":{"sky":"Sky"},"icons":{"sky":"si_c530_00_s"},"lines":[{"id":"d_counseling_sky_16_1","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_1","text":"I tend to arrive at appointments a bit early.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sky"],"affinity":"_0"},{"id":"d_counseling_sky_16_2","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_2","text":"I feel better that way, just in case something comes up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_3","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_3","text":"... But sometimes I arrive so early, I don't know what to do with myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_16_4","text":"You can call me.","jump":"d_counseling_sky_16_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sky_16_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_16_5","text":"Try talking to a tree while you wait.","jump":"d_counseling_sky_16_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sky_16_6","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_6","text":"... Really? Is that okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_7","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_7","text":"Talking to you would definitely make time fly while I'm waiting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_8","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_8","text":"Okay, next time I'm early for an appointment, I'll give you a call.","jump":"d_counseling_sky_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_9","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_9","text":"... A tree?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_10","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_10","text":"B-but that's basically just me talking to myself, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_11","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_16_11","text":"And if someone saw me, they'd think I'm so weird...!","jump":"d_counseling_sky_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_16_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_sky_16_12","text":"Sky and I talk about how to pass time while waiting.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}