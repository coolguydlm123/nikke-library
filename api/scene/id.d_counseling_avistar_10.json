{"id":"d_counseling_avistar_10","cat":"counsel","group":{"id":"char5171","label":"Avistar"},"label":"Advising Avistar: 10","stage":null,"prev":"d_counseling_avistar_09","next":"d_counseling_avistar_11","speakers":{"avistar":"Avistar"},"icons":{"avistar":"si_c441_00_s"},"lines":[{"id":"d_counseling_avistar_10_1","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_1","text":"I've been watching this show lately where celebrities and their managers appear together.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["avistar"],"affinity":"_0"},{"id":"d_counseling_avistar_10_2","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_2","text":"All the managers on that show are so on top of things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_avistar_10_3","text":"I think you would make a great manager, Avistar.","jump":"d_counseling_avistar_10_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_avistar_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_avistar_10_4","text":"Isn't all of that probably just scripted?","jump":"d_counseling_avistar_10_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_avistar_10_5","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_5","text":"... Thank you for thinking so highly of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_6","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_6","text":"I wouldn't know for certain until I tried,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_7","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_7","text":"but I'm confident I would do well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_8","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_8","text":"Be it as a supporting manager, or a manager who works as an equal partner.","jump":"d_counseling_avistar_10_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_9","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_9","text":"I hadn't thought of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_10","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_10","text":"So this is what it feels like to have your illusions shattered...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_11","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_10_11","text":"... It was really nice to watch though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_10_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_avistar_10_12","text":"Avistar and I discuss the qualities that make a good manager.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}