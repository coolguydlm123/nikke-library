{"id":"memorial_100202","cat":"memorial","group":{"id":"memorial100200","label":"Memoirs · Survival Guide 01"},"label":"2. How to Secure Food","stage":null,"prev":"memorial_100201","next":"memorial_100203","speakers":{},"icons":{},"lines":[{"id":"memorial_100202_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_02_02_description","text":"Throw away everything but canned food."},{"id":"memorial_100202_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_02_02_description","text":"Avoid areas nearby ponds."},{"id":"memorial_100202_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_02_02_description","text":"If you want to go anywhere, don't move an inch until it's been 10 minutes since you last heard Rapture gunshots."}]}