sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_11","text":"We're going out tomorrow, remember?","jump":null},{"id":"m_ex_sin_swiftbunny_01_12","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_12","text":"How could you forget?","jump":null},{"id":"m_ex_sin_swiftbunny_01_13","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_13","text":"We only made plans yesterday.","jump":null},{"id":"m_ex_sin_swiftbunny_01_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_14","text":"Oh yeah, I remember now.","jump":null},{"id":"m_ex_sin_swiftbunny_01_15","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_15","text":"-▣-","jump":"m_ex_sin_swiftbunny_01_18"},{"id":"m_ex_sin_swiftbunny_01_16","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_16","text":"Hehe, you remembered we're going out tomorrow!","jump":null},{"id":"m_ex_sin_swiftbunny_01_17","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_17","text":"10 points for my thoughtful Instructor!","jump":"m_ex_sin_swiftbunny_01_18"},{"id":"m_ex_sin_swiftbunny_01_18","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_18","text":"So, what are you wearing tomorrow?","jump":null},{"id":"m_ex_sin_swiftbunny_01_19","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_19","text":"Let's match!","jump":null},{"id":"m_ex_sin_swiftbunny_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_20","text":"How?","jump":null},{"id":"m_ex_sin_swiftbunny_01_21","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_21","text":"Look at my profile pic.","jump":null},{"id":"m_ex_sin_swiftbunny_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_22","text":"A bunny girl?","jump":null},{"id":"m_ex_sin_swiftbunny_01_23","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_23","text":"Hehe, yep!","jump":null},{"id":"m_ex_sin_swiftbunny_01_24","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_24","text":"Why?","jump":null},{"id":"m_ex_sin_swiftbunny_01_25","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_25","text":"You don't like it? ㅠ▣ㅠ","jump":null},{"id":"m_ex_sin_swiftbunny_01_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_26","text":"Do we really have to match?","jump":null},{"id":"m_ex_sin_swiftbunny_01_27","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_27","text":"Of course!","jump":null},{"id":"m_ex_sin_swiftbunny_01_28","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_28","text":"Then anyone who sees us will know we're together,","jump":null},{"id":"m_ex_sin_swiftbunny_01_29","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_29","text":"and some might even mistake us for a couple...","jump":null},{"id":"m_ex_sin_swiftbunny_01_30","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_30","text":"Even if they don't, they'll still be able to spot us from a distance!","jump":null},{"id":"m_ex_sin_swiftbunny_01_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_31","text":"So you're saying I HAVE to dress as a bunny girl...?","jump":null},{"id":"m_ex_sin_swiftbunny_01_32","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_32","text":"Yep, yep! Why do you ask?","jump":null},{"id":"m_ex_sin_swiftbunny_01_33","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_33","text":"You don't want people to think we're a couple...? ㅇ▣ㅇ","jump":null},{"id":"m_ex_sin_swiftbunny_01_34","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_34","text":"Oh well...","jump":null},{"id":"m_ex_sin_swiftbunny_01_35","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_35","text":"I guess that's fair...","jump":null},{"id":"m_ex_sin_swiftbunny_01_36","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_36","text":"You don't want people to think we were together, right? ㅠ▣ㅠ","jump":null},{"id":"m_ex_sin_swiftbunny_01_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_37","text":"No, that's not it.","jump":null},{"id":"m_ex_sin_swiftbunny_01_38","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_38","text":"No... it's okay.","jump":null},{"id":"m_ex_sin_swiftbunny_01_39","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_39","text":"Sin doesn't respond for a while.","jump":null},{"id":"m_ex_sin_swiftbunny_01_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_40","text":"Sin?","jump":null},{"id":"m_ex_sin_swiftbunny_01_41","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_41","text":"Sin still doesn't respond.","jump":null},{"id":"m_ex_sin_swiftbunny_01_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_42","text":"Okay, I'll do it.","jump":null},{"id":"m_ex_sin_swiftbunny_01_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_43","text":"But can I just wear a bunny headband instead?","jump":null},{"id":"m_ex_sin_swiftbunny_01_44","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_44","text":"Really? >▣<","jump":null},{"id":"m_ex_sin_swiftbunny_01_45","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_45","text":"That'll do!","jump":null},{"id":"m_ex_sin_swiftbunny_01_46","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_46","text":"Hehe.","jump":null},{"id":"m_ex_sin_swiftbunny_01_47","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_47","text":"500 points to my courageous Instructor! ^▣^","jump":null},{"id":"m_ex_sin_swiftbunny_01_48","type":"Speech","speaker":"sin_b","key":"Locale_SuddenMessage:m_ex_sin_swiftbunny_01_48","text":"See you tomorrow, Bunny Instructor >▣<","jump":null}],"chat":true}