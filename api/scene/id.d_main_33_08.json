","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_08_7","text":"What if he goes off and tells other people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_08_8","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_08_8","text":"Who cares if he does?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_08_9","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_08_9","text":"You've completely lost it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_08_10","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_08_10","text":"How long are you going to wait?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_08_11","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_08_11","text":"It's high time we act.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_08_12","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_33_08_12","text":"What are you talking about? We have no idea what could happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_08_13","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_08_13","text":"Yes you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_08_14","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_33_08_14","t