{"id":"event_enterheaven_intermission_01","cat":"event","group":{"id":"ev40104","label":"ENTER HEAVEN"},"label":"The Strength of Humanity","stage":null,"prev":"event_enterheaven_03_e","next":"event_enterheaven_04_s","speakers":{"elysionfranka":"Elysion Franca","elysionharper":"Elysion Harper","eh_n":"E.H.","ingrid":"Ingrid"},"icons":{"elysionfranka":"si_c999_00_s","elysionharper":"si_c940_00_s","eh_n":"si_c113_00_s","ingrid":"si_c900_00_s"},"lines":[{"id":"event_enterheaven_intermission_01_1","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_1","text":"\"Proposal for Improving the Living Conditions of Outer Rim Residents...\"","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_groundfall","movie":null,"shown":["elysionharper"],"affinity":null},{"id":"event_enterheaven_intermission_01_2","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_3","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_enterheaven_intermission_01_3","text":"Elysion Franca tosses her tablet down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_4","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_4","text":"I sent you on such an important assignment so you could learn about what being my successor entails.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_5","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_5","text":"But now it looks like you came back more foolish than when you left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_6","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_6","text":"Who are the \"residents\" of the Outer Rim? There aren't any humans there, last I checked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_7","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_7","text":"Mother...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_8","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_8","text":"That entire place is filled with garbage, and nothing else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_9","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_9","text":"After being granted the privilege of escaping the surface and seeking refuge underground,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_10","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_10","text":"they chose to hole themselves up in that dump. That makes them garbage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_11","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_11","text":"If you really view those things as people, then that tells me all I need to know about how poor your judgment is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_12","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_12","text":"There are children who were born there who aren't like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_13","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_13","text":"It may be true that the adults who went there were weak,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_14","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_14","text":"and made foolish decisions, as you say,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_15","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_15","text":"but those children never had a choice...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_16","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_16","text":"That doesn't matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_17","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_17","text":"Being born in a dump still makes them garbage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_18","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_18","text":"What kind of logic is that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_19","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_19","text":"If their lives are meant to be anything more than that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_20","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_20","text":"then they'll find a way to survive, to get stronger, and to make it out of there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_21","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_21","text":"If they can't, it simply means they were born weak, and they will die weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_22","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_22","text":"That is the law of nature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_23","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_23","text":"I've said it many times before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_24","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_24","text":"Humanity as a whole must become strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_25","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_25","text":"Only by casting aside the weak and strengthening ourselves...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_26","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_26","text":"... can we survive in this world where inhuman monsters run rampant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_27","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_27","text":"Have you really not learned that yet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_28","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_28","text":"Still, they're just children...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_29","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_29","text":"If you really can't understand,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_30","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_30","text":"you aren't qualified to be the heir of Elysion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_31","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_32","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_32","text":"Don't become weak, Harper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_33","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_33","text":"The heir of the great Elysion must not be swayed by pity for the weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_34","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_34","text":"Be clear in what you keep and what you cast away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_35","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_35","text":"For the sake of a stronger human race, the weak must be discarded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_36","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_36","text":"Otherwise, humanity will never grow stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_37","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_37","text":"It is only through strength that humans can avoid falling behind in this inverted ecosystem,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_38","type":"Speech","speaker":"elysionfranka","key":"Locale_SubScenario:event_enterheaven_intermission_01_38","text":"and accomplish the great feat of reclaiming the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_39","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_39","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_40","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_40","text":"It was then that a thought came to my mind.","jump":null,"exit":false,"enter":null,"bg":"RuinTechIndoor","bgArt":"ruintechindoor","image":null,"bgm":null,"movie":null,"shown":["eh_n"],"affinity":null},{"id":"event_enterheaven_intermission_01_41","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_41","text":"If we only pursue strength in an attempt to avoid extinction,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_42","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_42","text":"and in the process we discard our humanity,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_43","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_43","text":"can we really still be regarded as human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_44","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_44","text":"When that thought hit me, I couldn't take it any longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_45","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_45","text":"For days on end, I kept asking myself, \"What is true strength?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_46","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_46","text":"And then finally, I came to a conclusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_47","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_47","text":"If being Elysion's heir meant I wasn't allowed to think like that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_48","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_intermission_01_48","text":"then I would give up my position.","jump":null,"exit":false,"enter":null,"bg":"BuildingLobby","bgArt":"buildinglobby","image":null,"bgm":null,"movie":null,"shown":["elysionharper","ingrid"],"affinity":null},{"id":"event_enterheaven_intermission_01_49","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_49","text":"Harper!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_chapter38_field_goldentree","movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_50","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_50","text":"... Ingrid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_51","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_51","text":"Are you really leaving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_52","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_52","text":"Things just turned out this way. Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_53","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_53","text":"Looks like we won't be getting tested together anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_54","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_54","text":"And Mother's okay with it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_55","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_55","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_56","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_56","text":"She was angry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_57","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_57","text":"She called me pathetic, and wouldn't let me take anything with me, saying maybe I'd get the sense knocked into me and come back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_58","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_58","text":"I've got nothing, aside from these weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_59","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_59","text":"... Do you really want to save that place that badly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_60","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_60","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_61","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_61","text":"I'm going to turn the Outer Rim into a place where people can live like human beings,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_62","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_62","text":"and then I'm going to show the entire world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_63","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_63","text":"I'll prove that there are real people living there, in the place everyone else calls a dump,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_64","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_64","text":"and that they can no longer ignore them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_65","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_65","text":"And to Mother,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_66","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_66","text":"I'll prove that the strength that humanity actually needs to pursue...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_67","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_67","text":"... doesn't come from some extreme version of survival of the fittest,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_68","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_68","text":"but that the strong need to help the weak, and give them the chance to get stronger so that everyone can grow together,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_69","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_69","text":"and that it's only by retaining our humanity that we can truly become strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_70","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_70","text":"That's the strength of humanity that I'm after,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_71","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_71","text":"and what I want to prove to everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_72","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_72","text":"... Things may not go the way you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_73","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_73","text":"I'm not trying to say that everything Mother said was right,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_74","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_74","text":"but there are definitely those who've given up and only take from others rather than making an effort themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_75","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_75","text":"If you start preaching your ideals to such people, they might take advantage of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_76","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_76","text":"There will be those who learn you came from the Ark and that you were Elysion's heir,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_77","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_77","text":"and, out of jealousy, they'll threaten you and try to use violence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_78","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_78","text":"You won't be able to rest for even a second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_79","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_79","text":"And yet, in spite of all that, you still want to hold onto your ideals...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_80","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_80","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_81","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_81","text":"When it comes to violence, unless they're Nikkes armed like soldiers in the Surface Reclamation Wars,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_82","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_82","text":"they'll surely be weaker than you, so I think I'll be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_83","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_83","text":"You idiot. You can't let your guard down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_84","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_84","text":"No matter how strong you are, you're bound to fall if you get careless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_85","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_85","text":"I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_86","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_86","text":"That's a valuable lesson Mother hammered into us as children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_87","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_87","text":"Look, I know what you're trying to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_88","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_88","text":"The Outer Rim will be dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_89","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_89","text":"I realize not everyone there will be good like the children I saw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_90","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_90","text":"But even so, I refuse to give up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_91","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_91","text":"Harper...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_92","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_92","text":"Unfortunately, that means I won't be able to help you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_93","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_93","text":"I know you wanted us to work together on your plan to make humans and Nikkes stronger through technology and tactics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_94","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_94","text":"Still, I'll be looking forward to watching you from afar as you create Elysion's finest forces...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_95","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_95","text":"The Absolute Squad, who will bring unmatched tactics to any fight,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_96","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_96","text":"and the Extrinsic Squad, who will protect others from berserk Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_97","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_enterheaven_intermission_01_97","text":"Elysion Harper extends her hand to Ingrid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_98","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_99","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_99","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_100","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_100","text":"I'm really hoping you prove to Mother that you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_101","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_101","text":"Let's both succeed at what we're trying to do, wherever we may be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_102","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_enterheaven_intermission_01_102","text":"Ingrid firmly grasps Harper's hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_103","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_intermission_01_103","text":"Take care of yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_intermission_01_104","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_intermission_01_104","text":"You too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}