{"id":"d_counseling_mary_10","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 10","stage":null,"prev":"d_counseling_mary_09","next":"d_counseling_mary_11","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_10_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_1","text":"Hm, a thought just came to me.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_10_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_2","text":"If I wasn't a doctor, what would I be doing instead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_10_3","text":"Jabbing people with needles for free?","jump":"d_counseling_mary_10_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_10_4","text":"A nurse?","jump":"d_counseling_mary_10_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_10_5","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_5","text":"Ha ha! Is that what you think of me, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_6","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_6","text":"I'm afraid that's incorrect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_7","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_7","text":"I wouldn't want to be doing a job that only inflicts pain on others.","jump":"d_counseling_mary_10_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_8","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_8","text":"If not a doctor, then a nurse!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_9","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_9","text":"So you think no matter what happens, I'll always be there with a syringe in my hand, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_10","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_10","text":"I... I suppose that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_11","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_11","text":"No matter what, I'd almost certainly end up in the medical field.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_12","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_12","text":"A job where I inflict pain, yes, but also where I help others at the same time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_13","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_10_13","text":"There's only one field that fits this description.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_10_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_10_14","text":"I have a fun time thinking about other jobs Mary would do.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}