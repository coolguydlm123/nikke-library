{"id":"d_main_22_04_s","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"Beast in the Warren: A","stage":"22-12 STAGE · Start","prev":"d_main_22_03","next":"d_main_22_04_e","speakers":{"blanc":"Blanc","noir":"Noir","rosanna":"Rosanna","blanc_noir":"Blanc&Noir"},"icons":{"blanc":"si_c270_00_s","noir":"si_c271_00_s","rosanna":"si_c280_00_s","blanc_noir":"si_c999_00_s"},"lines":[{"id":"d_main_22_04_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_04_s_1","text":"3 days ago.","jump":null,"exit":false,"enter":null,"bg":"CoinRushIndoor","bgArt":"coinrushindoor","image":null,"bgm":"bgm_story_conflict","movie":null,"shown":["blanc","noir","rosanna"],"affinity":null},{"id":"d_main_22_04_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_04_s_2","text":"Coin Rush, a sprawling casino located in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_3","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_3","text":"I refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_4","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_4","text":"Blanc, you don't have to be so strict...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_5","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_5","text":"Noir, just keep your mouth shut. I'll take care of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_6","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_6","text":"But it's not wrong. Can we at least discuss it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_7","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_7","text":"I feel I can communicate better with your sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_8","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_8","text":"Think about it. What do you have to lose?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_9","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_9","text":"... Is Hedonia proposing they stay in Coin Rush to offer protection?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_10","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_10","text":"The moment a gang like Hedonia sets foot into Coin Rush, the entire place will go down the drain. Hedonia's reputation is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_11","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_11","text":"Listen to me, toots. You clearly have no idea how this world operates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_12","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_12","text":"You think we'll be standing around decked out in big black suits while we mean-mug the customers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_13","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_13","text":"You dolt. We'll make it so that we look like customers ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_14","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_14","text":"That way, we'll be able to spring into action the moment we sense something's amiss. Doesn't that sound nice?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_15","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_15","text":"I said it once, and I'll say it again. We do not need protection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_16","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_16","text":"This place is the safest adult playground in the entire Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_17","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_17","text":"Are you sure about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_18","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_18","text":"I've been hearing a lot of stories recently about all sorts of lowlives hanging around here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_19","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_19","text":"Begging for free money. Griping about machines not giving a payout when they hit the jackpot. Demanding their money back after that piss water you call your house cocktails leaves them running for the toilet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_20","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_20","text":"From the sounds of it, I thought this place was overrun by all manner of miscreants, but perhaps I misheard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_21","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_22","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_22","text":"Blanc, let's at least hear her out. We have been going through a rough patch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_23","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_23","text":"Rouge and Jaune still aren't back from training, and it's a lot of balls for just the two of us to juggle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_24","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_24","text":"If this keeps up, Coin Rush will become a den of inequity instead of a fun palace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_25","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_25","text":"I certainly don't want that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_26","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_26","text":"... Neither do I. We both want the best for our customers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_27","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_27","text":"You two willing to listen to my pitch now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_28","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_28","text":"I want to know what you expect to get out of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_29","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_29","text":"I already told you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_30","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_30","text":"Everyone from Hedonia will disguise themselves as regular customers and position themselves throughout the casino.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_31","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_31","text":"All I ask in return is that you throw a few bucks to my constituents so that they can have a go at the machines. Y'know, so they don't get too bored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_32","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_32","text":"If anyone gives you any trouble, we'll resolve it \"in-house\". The end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_33","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_33","text":"And what exactly would that involve? Spraying the place with machine guns?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_34","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_34","text":"Haha! A fine suggestion, but one I doubt the other customers would appreciate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_35","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_35","text":"We'll sidle up next to them, all nice and quiet-like, show them what we're packin', and that'll be that. No rough stuff required.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_36","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_36","text":"What will you be showing them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_37","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_37","text":"Do you really wanna know? It may be a little hardcore for a little cute, cuddly bunny like you to handle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_38","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_38","text":"... Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_39","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_40","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_40","text":"So there won't be a commotion, and no one will get hurt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_41","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_41","text":"Of course not. No one will know anything even happened. Not a single soul.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_42","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_42","text":"Except for our intended target, who'll get the scare of their lifetime, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_43","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_43","text":"How much are you asking for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_44","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_44","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_45","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_45","text":"There's no way Hedonia would provide protection for free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_46","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_46","text":"Isn't there something you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_47","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_47","text":"Hmmm, that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_48","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_48","text":"And you are right. Nothing is free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_49","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_49","text":"Let me think. What would be good...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_50","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_50","text":"I suppose money is the most convenient option, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_51","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_51","text":"How much do you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_52","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_52","text":"Let's say... 60% of your profit margin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_53","type":"Speech","speaker":"blanc_noir","key":"Locale_MainScenario:d_main_22_04_s_53","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_55","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_55","text":"Not a bad deal, right? Let's shake on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_56","type":"Speech","speaker":"blanc_noir","key":"Locale_MainScenario:d_main_22_04_s_56","text":"Absolutely not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_58","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_58","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_59","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_59","text":"Why not? This is a killer deal for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_60","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_60","text":"60% is absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_61","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_61","text":"We'd fare better simply letting the difficult customers have the run of the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_62","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_04_s_62","text":"If we let you have that much, it'd negatively impact how we ran the casino.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_63","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_04_s_63","text":"Forget maintaining the machines, we'd barely be able to pay our employees.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_64","type":"Speech","speaker":"blanc_noir","key":"Locale_MainScenario:d_main_22_04_s_64","text":"So that will never work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_66","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_66","text":"What is this? Why are you repeating each other's words now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_67","type":"Speech","speaker":"blanc_noir","key":"Locale_MainScenario:d_main_22_04_s_67","text":"Because we're sisters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_69","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_69","text":"Haha, you two crack me up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_70","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_70","text":"I understand if you need some time to think it over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_71","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_71","text":"But you should definitely consider it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_72","type":"Speech","speaker":"blanc_noir","key":"Locale_MainScenario:d_main_22_04_s_72","text":"We refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_74","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_74","text":"Careful. You might end up regretting this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_04_s_75","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_04_s_75","text":"We can talk about this another time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}