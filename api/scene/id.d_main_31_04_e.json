{"id":"d_main_31_04_e","cat":"main","group":{"id":"ch31","label":"Chapter 31 · Mabeast"},"label":"Change of Position: B","stage":"31-12 STAGE · End","prev":"d_main_31_04_s","next":"d_main_31_05","speakers":{"neon":"Neon","emma":"Emma","anis":"Anis","vesti":"Vesti","mana_op":"Mana","eunhwa":"Eunhwa"},"icons":{"neon":"si_c011_00_s","emma":"si_c090_00_s","anis":"si_c012_00_s","vesti":"si_c091_00_s","mana_op":"si_c290_00_s","eunhwa":"si_c092_00_s"},"lines":[{"id":"d_main_31_04_e_1","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_1","text":"I have a question for all of you.","jump":null,"exit":false,"enter":null,"bg":"CrystalField_1","bgArt":"crystalfield_1","image":null,"bgm":"bgm_chapter31_field_beast","movie":null,"shown":["vesti","emma","neon","anis","eunhwa"],"affinity":null},{"id":"d_main_31_04_e_2","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_31_04_e_2","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_3","text":"What's Absolute doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_4","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_31_04_e_4","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_5","text":"What kind of question is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_6","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_31_04_e_6","text":"Is our being here making you uncomfortable?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_7","text":"No, that's not it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_8","text":"It's just that... don't you think you all being sent here is a bit overkill?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_9","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_31_04_e_9","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_31_04_e_10","text":"Actually, I was a bit curious about that myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_11","text":"The goal is to use this C Pillar to push back the areas overridden with crystals, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_12","type":"Speech","speaker":"mana_op","key":"Locale_MainScenario:d_main_31_04_e_12","text":"A Pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mana_op"],"affinity":null},{"id":"d_main_31_04_e_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_13","text":"Right, A Pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_14","text":"Call me crazy, but I don't think you guys are the only ones who could get this job done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_15","text":"In fact, there are probably plenty of people better suited to handle this type of job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_16","text":"What do you think? I'm a real supersleuth, aren't I? Novel would be green with envy, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_17","text":"... You could have at least chosen a more impressive person to measure yourself against.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_18","text":"However, you do have a point. This kind of job seems a bit out of Absolute's wheelhouse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_19","text":"I figured you all would bring some kinda special vacuum that'd suck up the crystals or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_20","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_20","text":"And what makes you think that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_21","text":"I don't know. That's why I'm asking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_22","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_22","text":"You can't think about any mission from merely one perspective.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_23","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_23","text":"You've got to consider it from all angles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_24","text":"... I don't get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_25","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_25","text":"And that's why you're all inferior.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_26","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_26","text":"Darn, I think we just got demoted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_27","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_31_04_e_27","text":"We're here because the chance of encountering Pilgrims and Heretics is high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_28","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_31_04_e_28","text":"That Pilgrim called Grave doesn't seem to be the friendly type,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_29","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_31_04_e_29","text":"plus there have been traces of other intelligent life forms here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_30","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_31_04_e_30","text":"We also know for certain that a Heretic is roaming around these parts as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_31","text":"So you all were sent in as a military force to combat the Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_32","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_31_04_e_32","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_33","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_33","text":"Then why not send Matis? They're adept at fighting too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_34","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_34","text":"Why do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_35","text":"Because they don't get along with Absolute?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_36","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_36","text":"Their weapons and power sources rely a lot on electricity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_37","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_37","text":"They'd be a moveable feast for these crystals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_38","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_31_04_e_38","text":"That's why they can't come here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_39","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_31_04_e_39","text":"The only thing we know for sure is that there's a Heretic here, but we don't know anything about her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_40","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_31_04_e_40","text":"Therefore, squads with experience in dealing with Heretics were chosen, which means us and you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_41","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_31_04_e_41","text":"We ought to be thanking this Heretic for giving us a chance to meet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_42","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_31_04_e_42","text":"Yeah, especially since you guys have been so busy lately. You're becoming real big shots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_43","text":"Things definitely have changed since when I first joined the team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_44","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_31_04_e_44","text":"Don't you feel like we've been on a roll since I joined?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_31_04_e_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_31_04_e_45","text":"We've got the Commander to thank for our turn in fortune, not you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}