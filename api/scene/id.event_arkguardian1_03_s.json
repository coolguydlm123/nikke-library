{"id":"event_arkguardian1_03_s","cat":"event","group":{"id":"ev40098","label":"ARK GUARDIAN · Part 1"},"label":"An Encounter with the Unknown: A","stage":null,"prev":"event_arkguardian1_02_e","next":"event_arkguardian1_03_e","speakers":{"oswald_o":"Oswald","freesia":"Freesia"},"icons":{"oswald_o":"si_c961_00_s","freesia":"si_c960_00_s"},"lines":[{"id":"event_arkguardian1_03_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_1","text":"Oswald watches the stream of people and supplies pouring into the entrance of the Ark.","jump":null,"exit":false,"enter":null,"bg":"ArkGate_Far_d","bgArt":"arkgate_far_d","image":null,"bgm":"event_bgm_redash_thankstogoddess","movie":null,"shown":["oswald_o"],"affinity":null},{"id":"event_arkguardian1_03_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_2","text":"The line of people stretches on endlessly as the supply trucks continue rolling in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_3","text":"Oswald is suddenly filled with a sense of unease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_4","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_4","text":"Has there always been this many people and this much supplies in the world?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_5","text":"It feels as though everything and everyone on the entire planet has gathered here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_6","text":"Glancing back at the procession, Oswald finds the same discomfort washes over him once again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_7","text":"This feels never-ending.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_8","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_arkguardian1_03_s_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_9","text":"Oswald feels a sudden wave of dizziness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_10","text":"Having admitted defeat, humanity decides to take refuge in the underground city known as the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_11","text":"The Ark will be sealed through a five-phase process, after which it will never open again—neither from the inside nor from the outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_12","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_12","text":"Despite humanity's defeat, it has managed to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_13","text":"The fate of the entire species hinges upon the success of this operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_14","text":"As Oswald thinks of his role as the one responsible for sealing the Ark, the dizziness returns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_15","text":"On the day of his appointment,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_16","text":"he could sense the jealousy hidden behind the smiles of his peers and superiors who congratulated him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_17","text":"But such things no longer matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_18","text":"Once the Ark is sealed, it cannot be reopened, not even from within.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_19","text":"Nor can anyone enter it from the outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_20","text":"After the five-step sealing process, those who come seeking refuge in this utopia will find only silent gates greeting them before they perish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_21","text":"When the time comes, Oswald must shut the doors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_22","text":"He will have to turn a blind eye to those who come hoping for rescue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_23","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_arkguardian1_03_s_23","text":"I'll be an executioner. No... a mass murderer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_24","text":"He has always followed orders from above, without question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_25","text":"Even when those orders require him to dirty his hands, he never refuses or disobeys.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_26","text":"After all, all the guilt he felt can simply be passed onto those above him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_27","text":"As a result of his work, he has somehow earned the nickname \"Hellhound.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_28","text":"It is a name far from glorious, yet he feels content. After all, it means he is being recognized.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_29","text":"Oswald, the Hellhound, believes no one is more suited than him to be in charge of sealing the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_30","text":"All he has to do is follow orders from his superiors, as he always has.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_31","text":"It is simple. He only needs to issue one command: Seal it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_32","text":"It's supposed to be an easy task.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_33","text":"But then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_34","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_arkguardian1_03_s_34","text":"... There are too many.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_35","text":"Oswald looks once more at the endless line of people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_36","text":"How many people are supposed to be allowed into the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_37","text":"What percentage of the total population is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_38","text":"Surely no more than ten percent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_39","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_39","text":"No, not even that. Perhaps a single digit, or merely a fraction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_40","text":"Then what about the rest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_41","text":"What will happen to them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_42","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_arkguardian1_03_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_43","text":"Oswald nearly collapses where he stands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_44","text":"He's sure he won't be able to endure much longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_45","text":"Everything has been planned by his superiors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_46","text":"Everything must proceed as outlined. Even contingency measures are already in place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_47","text":"But he is the one who must make the decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_48","text":"To abandon the majority of all humankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_49","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_49","text":"In that moment, he desperately tries to recall who will assist him in sealing the Ark.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":["liliweiss","snowwhite_o","dorothy","hongryeon_o","rapunzel_o"],"affinity":null},{"id":"event_arkguardian1_03_s_50","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_50","text":"The Goddesses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_51","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_51","text":"The hope of mankind. The Goddesses of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_52","text":"They will be assisting him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_53","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_53","text":"During the sealing of the Ark, the Goddesses will stand guard as part of Operation: Ark Guardian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_54","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_arkguardian1_03_s_54","text":"... Yes, that'll do for now.","jump":null,"exit":false,"enter":null,"bg":"ArkGate_Far_d","bgArt":"arkgate_far_d","image":null,"bgm":null,"movie":null,"shown":["oswald_o"],"affinity":null},{"id":"event_arkguardian1_03_s_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_55","text":"That single fact alone keeps Oswald from falling apart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_56","text":"Since becoming the one in charge of the sealing operation, Oswald has been saved by the Goddesses more times than he can count.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_57","text":"Dozens, hundreds, perhaps even thousands of times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_58","text":"Regaining focus, Oswald takes out his tablet and looks at the status screen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_59","text":"Off in the distance, a shadow appears,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_60","text":"but lost in thought, he fails to notice its approach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_61","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_03_s_61","text":"Feigning composure, he stays still for a moment, then quickly draws his gun and points it straight ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_62","type":"Speech","speaker":"freesia","key":"Locale_MainScenario:event_arkguardian1_03_s_62","text":"Wow, where did this gun come from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["freesia"],"affinity":null},{"id":"event_arkguardian1_03_s_63","type":"Speech","speaker":"freesia","key":"Locale_MainScenario:event_arkguardian1_03_s_63","text":"That's so strange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_64","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_arkguardian1_03_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_65","type":"Speech","speaker":"freesia","key":"Locale_MainScenario:event_arkguardian1_03_s_65","text":"Hi, Mister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_03_s_66","type":"Speech","speaker":"freesia","key":"Locale_MainScenario:event_arkguardian1_03_s_66","text":"Are you busy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}