ty":null},{"id":"d_main_16af_02_28","type":"Speech","speaker":"rian","key":"Locale_MainScenario:d_main_16af_02_28","text":"Yeah,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_02_29","type":"Speech","speaker":"rian","key":"Locale_MainScenario:d_main_16af_02_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_02_30","type":"Speech","speaker":"rian","key":"Locale_MainScenario:d_main_16af_02_30","text":"They are not within range of radio waves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_02_31","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_16af_02_31","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_02_32","type":"Speech","speaker":"rian","key":"Locale_MainScenario:d_main_16af_02_32","text":"Communications are far from ideal in the Outer Rim.\nIt's fairly common.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_02_33","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_16af_02_33","text":"I don't need excuses. Track their recognition chips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_02_34","type":"Speech","speaker":"rian","key":"Locale_MainScenario:d_main_16af_02_34","text":"Yeah,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16af_02_35","type":"Narration","speaker":"Narration","key":"Locale_MainScenari