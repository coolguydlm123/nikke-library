:false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_50","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_50","text":"Fine. Think whatever you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_51","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_51","text":"Ignorance is bliss, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_52","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_52","text":"As for now, I should be moving along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_53","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_53","text":"I don't appreciate having my alone time taken away from me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_54","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_54","text":"Don't follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_55","text":"Dorothy leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}