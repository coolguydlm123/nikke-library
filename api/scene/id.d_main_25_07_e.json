{"id":"d_main_25_07_e","cat":"main","group":{"id":"ch25","label":"Chapter 25 · Tracking"},"label":"Gratitude: B","stage":"25-27 STAGE · End","prev":"d_main_25_07_s","next":"d_main_25_08_s","speakers":{"dorothy":"Dorothy"},"icons":{"dorothy":"si_c233_00_s"},"lines":[{"id":"d_main_25_07_e_1","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"CityForest_02_n","bgArt":"cityforest_02_n","image":null,"bgm":"ambient_scn_wind","movie":null,"shown":["dorothy"],"affinity":null},{"id":"d_main_25_07_e_2","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_2","text":"Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_3","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_3","text":"There may be decoys set up,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_4","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_4","text":"but it's still mighty brave of a human to be wandering around alone up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_5","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_5","text":"I'm no stranger to the surface. Most of my fear has subsided by now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_6","text":"... So, why did you follow me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_7","text":"I just wanted to get some fresh air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_8","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_9","text":"In that case, I'll go somewhere else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_10","text":"Dorothy walks away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_11","text":"Why did you come to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_13","text":"Everyone seems awfully curious about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_14","text":"That's putting it mildly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_15","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_15","text":"All right, since it's just the two of us, I'll be upfront with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_16","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_16","text":"I'm going to bring down the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_17","text":"It is a false paradise and should not exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_18","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_19","text":"A rather subdued reaction, I'd say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_20","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_20","text":"You don't believe what I'm saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_21","text":"I know you despise the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_22","text":"but not enough to want to destroy it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_23","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_23","text":"Haha. You're quite an interesting fellow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_24","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_24","text":"Do you have any idea what I've been doing on the Ark, and what I'm preparing for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_25","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_25","text":"You can only know what someone else is thinking if they're a shallow thinker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_26","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_26","text":"Unfortunately for you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_27","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_27","text":"I'm no shallow thinker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_28","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_28","text":"I must say, this conversation has taken an unusual, if not entirely unamusing, turn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_29","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_29","text":"It's as if I'm pleading my case to get you to believe me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_30","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_30","text":"Convincing you that I'm up to no good, haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_31","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_31","text":"It's up to you whether you choose to believe me or not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_32","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_32","text":"Either way, it won't stop me from doing what I need to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_33","text":"If you really wanted to destroy the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_34","text":"you wouldn't have fought with Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_35","text":"That was merely me putting on a show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_36","text":"I might believe that if it'd been only once. But you went up against her twice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_37","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_e_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_38","text":"If the annihilation of the Ark was your goal, you could have simply turned and left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_39","text":"Yet you chose to fight Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_40","text":"Thanks to you, we were able to arrive in time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_41","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_07_e_41","text":"and the Ark was spared from complete decimation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_e_42","type":"Speech","speaker":"dorothy","key":"Locale_MainScena