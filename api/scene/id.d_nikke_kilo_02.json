{"id":"d_nikke_kilo_02","cat":"bond","group":{"id":"char5053","label":"Kilo"},"label":"Heavy Gram","stage":null,"prev":"d_nikke_kilo_01","next":"d_nikke_kilo_03","speakers":{"Narration":"Narration","kilo":"Kilo","anis":"Anis","neon":"Neon","rapi":"Rapi","Self":"Commander"},"icons":{"Narration":"si_c999_00_s","kilo":"si_c977_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_nikke_kilo_02_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_02_1","text":"Commander's Room.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["rapi","anis","neon","kilo","talos"],"affinity":null},{"id":"d_nikke_kilo_02_2","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_2","text":"My name is Kilo, and I'm part of Heavy Gram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_3","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_3","text":"The primary duty of our squad is to test Nikke-manned weapons developed by Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_4","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_4","text":"This particular weapon is called T.A.V:H, which stands for Tactical Autonomous Vehicle: Human Type.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_5","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_5","text":"Agh, information overload...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_6","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_6","text":"Oh, er... sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_7","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_7","text":"Anyway, since this T.A.V:H is still in the prototype stage, it's being deployed in various types of missions in order to gather relevant data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_8","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_8","text":"To be honest, though, it's not going particularly well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_9","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_9","text":"The robot spoke earlier. What was that all about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_10","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_10","text":"Ah, yes. That's the auxiliary AI for the T.A.V:H.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_11","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_11","text":"It's an all-purpose AI which can help automate various operations without the need for pilot intervention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_12","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_12","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_13","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_13","text":"I personally call it T.A.L.O.S.,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_14","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_14","text":"which is short for Tactical Assistance and Logistics Optimization System.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_15","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_15","text":"Gah, my brain can't handle all this information!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_16","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_16","text":"Sorry...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_17","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_17","text":"Basically, what you're saying is that we can call this thing T.A.L.O.S., is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_18","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_18","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_19","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_19","text":"Is the AI fully autonomous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_20","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_20","text":"No. The pilot must input commands in order for the machine to move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_21","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_21","text":"Although it provides a lot of assistance, it is incapable of operating entirely on its own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_22","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_22","text":"Therefore, a skilled pilot is imperative to ensuring peak performance from T.A.V:H.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_23","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_23","text":"Is there any particular reason behind it having an anthropomorphic design?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_24","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_24","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_25","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_25","text":"I understand the reasoning behind having a Nikke commandeer a mech. When compared to directly outfitting a Nikke with additional parts, the risk of a Mind Switch is significantly lower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_26","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_26","text":"However, I fail to see the point behind giving it an anthropomorphic look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_27","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_27","text":"A more typical tank design would almost certainly be more efficient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_28","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_28","text":"You just don't get it, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_29","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_29","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_30","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_30","text":"It's not all about efficiency, you know? It's about the feel!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_31","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_kilo_02_31","text":"Yeah! That's gotta count for something.","jump":"d_nikke_kilo_02_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_32","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_kilo_02_32","text":"When it comes to this stuff, efficiency is probably more important...","jump":"d_nikke_kilo_02_35","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_33","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_33","text":"I knew you'd understand, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_34","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_34","text":"I'm sure Kilo agrees. It's about the feeling it gives you, isn't that right?","jump":"d_nikke_kilo_02_38","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_35","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_35","text":"Master! I can't believe what I'm hearing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_36","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_36","text":"You're abandoning all of the heartfelt romance and poetry for cold, unfeeling efficiency?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_37","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_37","text":"Explain it to them, Kilo. Tell them that the feeling it gives you is just as important!","jump":"d_nikke_kilo_02_38","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_38","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_39","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_39","text":"The reason T.A.L.O.S. has adopted this particular design","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_40","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_40","text":"is because it uses a Nikke core as its primary power source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_41","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_41","text":"Excuse me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_42","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_42","text":"Yes, you heard correctly. The T.A.V:H is powered by a Nikke core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_43","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_43","text":"The initial prototypes were dubbed T.A.V:A. Tactical Autonomous Vehicle: Animal Type.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_44","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_44","text":"However, due to its animal-like form and poor scalability, the project was quickly abandoned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_45","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_45","text":"In the end, the power source proved too unstable, and it was impossible to use for prolonged periods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_46","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_46","text":"We also tried tanks and other weapon systems, but we consistently faced similar issues with the power source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_47","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_47","text":"Therefore, we chose to use a Nikke core as the power source, which resulted in a more human-like appearance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_48","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_48","text":"This form turned out to be the most efficient way to properly utilize the Nikke core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_49","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_49","text":"That's why T.A.L.O.S. looks the way it does.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_50","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_51","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_51","text":"So... I'm half right... kind of? Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_52","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_52","text":"... Sure. Whatever makes you happy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_53","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_53","text":"Anyway,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_54","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_54","text":"the amount of money which has been invested in our squad is astronomical,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_55","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_55","text":"so if we don't start producing results soon,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_56","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_57","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_57","text":"the project is liable to be scrapped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_58","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_02_58","text":"What would happen then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_59","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_59","text":"T.A.L.O.S. would be disposed of, and I would be tossed between different squads like a hot potato.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_60","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_02_60","text":"What do you mean? Why would that happen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_61","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_61","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_62","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_62","text":"Before I piloted T.A.L.O.S., I bounced back and forth between all sorts of different squads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_63","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_63","text":"... Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_64","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_02_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_65","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_65","text":"You said you're currently part of a squad, no? What's the current situation with your other squad members?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_66","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_66","text":"Since acting solely with the Heavy Gram squad has its limitations, we're used to having our members dispersed amongst different squads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_67","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_67","text":"Most of their focus is combat-based, and they're achieving decent results.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_68","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_68","text":"However, when compared to the sheer amount of capital invested in us, the results do come up short...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_69","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_69","text":"Wait, so you're not combat-focused?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_70","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_70","text":"Erm... no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_71","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_71","text":"Then what is it that you specialize in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_72","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_72","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_73","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_73","text":"If you want to be more effective, having a specific area of focus is key. You'll have more job offers than you can shake a stick at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_74","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_74","text":"Well... actually...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_75","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_75","text":"I like to say that my goal is to be well-rounded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_76","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_76","text":"Something of an all-purpose individual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_77","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_77","text":"Or, to put it more bluntly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_78","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_78","text":"Yes. Jack of all trades, master of none, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_79","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_80","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_80","text":"There's not really any one thing in which I excel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_81","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_81","text":"The T.A.V:H can adopt various different functions depending on the pilot's preference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_82","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_82","text":"I input a wide variety of functions in hopes that I would eventually stumble upon one area in which I was good at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_83","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_83","text":"What kind of functions are there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_84","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_84","text":"Combat, search & rescue, repair, production, communication, garrison, medical...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_85","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_85","text":"Quite a laundry list. Don't you think it's a bit much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_86","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_86","text":"Oh, er...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_87","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_87","text":"Maybe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_88","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_88","text":"I just want to be helpful in any situation that crops up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_89","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_90","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_90","text":"I understand where you're coming from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_91","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_91","text":"You just want to be able to contribute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_92","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_92","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_93","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_93","text":"If I can be of help in any situation, even just a little bit,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_94","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_94","text":"I won't feel so worthless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_95","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_95","text":"By inputting all these functions, I might end up finding something I'm really adept at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_96","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_96","text":"But so far, I haven't had any luck...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_97","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_97","text":"Sometimes I wonder if there's nothing I'm good at...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_98","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_99","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_99","text":"Everyone has something they're good at,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_100",