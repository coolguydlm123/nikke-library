o_02_107","text":"It seems pretty clear to me that you want our help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_108","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_108","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_109","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_109","text":"You're right. Everyone speaks so highly of you guys, so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_110","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_110","text":"If you could help me, I'd be eternally grateful!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_111","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_111","text":"All right, you're on. Let's do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_112","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_112","text":"I'm surprised, Anis. I didn't think you'd be into holding someone's hand like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_113","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_02_113","text":"What can I say? She reminds me of myself when I was younger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_114","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_02_114","text":"???","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_115","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_02_115","text":"Which company oversees Heavy Gram? Is it M.M.R.?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_116","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_116","text":"That's correct. For now, at least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_117","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_117","text":"All the R&D related to T.A.V:H is being done over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_118","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_02_118","text":"All right, I'll get in touch with Mana and let her know we've encountered some issues,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_119","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_02_119","text":"and that there might be a slight delay in sending you back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_02_120","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_02_120","text":"Thank you... truly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"i