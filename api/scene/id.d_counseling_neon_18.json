{"id":"d_counseling_neon_18","cat":"counsel","group":{"id":"char3002","label":"Neon"},"label":"Advising Neon: 18","stage":null,"prev":"d_counseling_neon_17","next":"d_counseling_neon_19","speakers":{"neon":"Neon"},"icons":{"neon":"si_c011_00_s"},"lines":[{"id":"d_counseling_neon_18_1","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_18_1","text":"In your mind, what is the pinnacle of firepower?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["neon"],"affinity":"_0"},{"id":"d_counseling_neon_18_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_18_2","text":"A power that can bring order to chaos.","jump":"d_counseling_neon_18_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_neon_18_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_18_3","text":"Such a thing does not exist.","jump":"d_counseling_neon_18_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_neon_18_4","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_18_4","text":"Chaos??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_18_5","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_18_5","text":"I think you're hanging around with Guillotine too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_18_6","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_18_6","text":"You're starting to sound like a bad young adult novel.","jump":"d_counseling_neon_18_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_18_7","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_18_7","text":"... Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_18_8","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_18_8","text":"Firepower is a mountain. The moment you believe there is a summit, you instantly hamstring yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_18_9","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_18_9","text":"You're right. For firepower, there is no top of the mountain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_18_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_neon_18_10","text":"Neon and I continue to discuss the limits of firepower, and if such a thing truly exists.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}