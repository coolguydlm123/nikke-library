{"id":"d_main_02af_01","cat":"main","group":{"id":"ch2","label":"Chapter 2 · Identification"},"label":"Responsibility","stage":null,"prev":"d_main_02_08_e","next":"d_main_02af_02","speakers":{"andersen":"Andersen","Self":"Commander","ingrid":"Ingrid"},"icons":{"andersen":"si_c903_00_s","ingrid":"si_c900_00_s"},"lines":[{"id":"d_main_02af_01_1","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_1","text":"You are hereby banished.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_b","movie":null,"shown":["andersen"],"affinity":null},{"id":"d_main_02af_01_2","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02af_01_2","text":"Why's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_3","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_3","text":"My orders were for you to investigate the power station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_4","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_4","text":"Not destroy it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_5","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_5","text":"Thanks to your little display up there, the power station was damaged beyond repair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_6","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_6","text":"All those materials, those facilities, gone. Wiped off the map.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_7","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_7","text":"Two months. Those resources could have supported the entire Ark for two months.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_8","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_8","text":"Now it's all been flushed down the drain, thanks to you and those Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_9","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_9","text":"Do you have anything to say for yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_10","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02af_01_10","text":"Yes, I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_11","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_11","text":"No. Nothing you say could possibly excuse what you've done here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_12","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_12","text":"As of today, you and your squad are to be driven out of the Ark and banished to the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_13","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_13","text":"A barren wasteland. No man's land.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_14","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_14","text":"But don't worry yourself too much. There are at least some resources available there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_15","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_15","text":"And I'll arrange an escort for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_16","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_16","text":"Consider yourselves lucky I haven't thrown you all into a Rehabilitation Center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_17","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02af_01_17","text":"What about Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_18","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_18","text":"She's undergoing maintenance and will be joining you once that is all finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_19","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_19","text":"Now go pack your things and get out of my sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_20","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_20","text":"Any update on the combat report?","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"none","movie":null,"shown":["andersen","ingrid"],"affinity":null},{"id":"d_main_02af_01_21","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_21","text":"I've just finished analyzing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_22","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_22","text":"Well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_23","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_23","text":"In a nutshell, I wouldn't consider them to be particularly proficient in actual combat scenarios either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_24","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_24","text":"The Raptures at the power station are different beasts entirely compared to their brethren.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_25","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_25","text":"Their squad managed to avoid all those creatures and escape with their lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_26","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_26","text":"Something's not right, but I just can't put my finger on it yet. It's worth investigating further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_27","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_27","text":"That's why they are sent to the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_28","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_28","text":"There is no better place to avoid the eyes of the all-seeing Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_29","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_29","text":"One more thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_30","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_30","text":"I assume you're referring to how those Raptures were able to operate human machinery?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_31","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_31","text":"Could it mean that they're evolving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_32","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_02af_01_32","text":"What's their end game?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_33","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_33","text":"It's one of two possibilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_34","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_34","text":"They either want to wipe out the entire human race.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02af_01_35","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_02af_01_35","text":"Or they want to replace them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}