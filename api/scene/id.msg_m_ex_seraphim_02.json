{"id":"msg_m_ex_seraphim_02","cat":"messenger","group":{"id":"room_seraphim","label":"Seraphim · Group"},"label":"2. Commander, do you have a minute?","stage":null,"prev":"msg_m_ex_seraphim_01","next":"msg_m_event_fullfoolday_03","speakers":{"mary":"Mary","pepper":"Pepper"},"icons":{"mary":"si_c130_00_s","pepper":"si_c131_00_s"},"lines":[{"id":"m_ex_seraphim_02_1","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_02_1","text":"Commander, do you have a minute?","jump":null},{"id":"m_ex_seraphim_02_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_02_2","text":"Sure.","jump":null},{"id":"m_ex_seraphim_02_3","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_02_3","text":"Great, thanks!","jump":null},{"id":"m_ex_seraphim_02_4","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_02_4","text":"Yippee!","jump":null},{"id":"m_ex_seraphim_02_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_02_5","text":"What can I do for you?","jump":null},{"id":"m_ex_seraphim_02_6","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_02_6","text":"We want to prepare some gifts","jump":null},{"id":"m_ex_seraphim_02_7","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_02_7","text":"for the children who will be staying at the hospital.","jump":null},{"id":"m_ex_seraphim_02_8","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_02_8","text":"Any ideas as to what we should buy?","jump":null},{"id":"m_ex_seraphim_02_9","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_02_9","text":"Something that kids would get a big kick out of.","jump":null},{"id":"m_ex_seraphim_02_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_02_10","text":"Homemade cookies.","jump":"m_ex_seraphim_02_12"},{"id":"m_ex_seraphim_02_11","type":"Choice","speaker":null,"key":"Locale_Su