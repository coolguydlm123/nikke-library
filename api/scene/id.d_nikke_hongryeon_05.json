{"id":"d_nikke_hongryeon_05","cat":"bond","group":{"id":"char5041","label":"Scarlet"},"label":"Utopia","stage":null,"prev":"d_nikke_hongryeon_04","next":null,"speakers":{"hongryeon":"Scarlet","rapi":"Rapi","anis":"Anis","neon":"Neon"},"icons":{"hongryeon":"si_c222_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_nikke_hongryeon_05_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_1","text":"Clear liquid sloshes around in a glass.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_2","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_2","text":"Come, satisfy mine curiosity. What are thy opinions of the honey wine we brewed on the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_05_3","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_3","text":"This was made some time back, so it should'st be ready now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_4","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_5","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_5","text":"... Do you not fancy it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_6","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_6","text":"I think it tastes like honey...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_7","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_7","text":"Haha. I, too, hast had the same thought at the beginning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_8","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_8","text":"After all, I hast ingested far worse brews in mine days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_9","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_9","text":"It was only to learn how to brew it myself didst I journey to thy establishment to drink so often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_10","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_10","text":"... Unbeknownst to us, we have arrived in this predicament, for that I apologize once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_11","text":"No worries. It's only thanks to you that I could experience something fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_12","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_12","text":"That is wonderful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_13","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_13","text":"Go on then, empty thy glass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_14","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_14","text":"We hast much time until sunrise, and much more wine still to imbibe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_15","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_15","text":"After all, there is no mission we are beholden to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_16","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_16","text":"What better time to just enjoy this juncture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_17","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_17","text":"Three hours later.","jump":null,"exit":false,"enter":null,"bg":"CityForest_01_n","bgArt":"cityforest_01_n","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_18","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_18","text":"*Hiccup*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_19","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_19","text":"Are thou in good health?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_20","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_20","text":"What a question! Fear not, I'm in good health.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_21","text":"There's something I'd like to ask you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_22","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_22","text":"What wouldst thou like to ask of me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_23","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_23","text":"Do you ever intend on returning to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_24","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_24","text":"Nay,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_25","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_25","text":"I adore this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_26","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_26","text":"Look around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_shapeofhope","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_27","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_27","text":"The blowing wind, the flowing creeks, and the rising of the sun and moon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_28","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_28","text":"The insects and animals are in subsistence, while the fruits and crops are in growth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_29","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_29","text":"Close thy eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_30","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_30","text":"Listen to the rustling of the leaves in the wind and the billowing creeks.","jump":null,"exit":false,"enter":null,"bg":"FlowerGarden","bgArt":"flowergarden","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_31","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_31","text":"The chirping of the grasshoppers and the birdsong in the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_32","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_32","text":"Take in the wafts of scents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_33","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_33","text":"The odors of soil, grass and rotting leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_34","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_34","text":"What could possibly cause meself to crave for this embarrassment of riches?","jump":null,"exit":false,"enter":null,"bg":"CityForest_01_n","bgArt":"cityforest_01_n","image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_05_35","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_35","text":"Aye, there are those churlish knaves we call Raptures, but","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_36","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_36","text":"for me, they are a mere trifle and naught of great concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_37","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_37","text":"Thus, the surface","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_38","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_38","text":"is mine Elysium, mine kingdom come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_39","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_39","text":"So there is no point in attempting to sway me with honeyed words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_40","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_40","text":"I'm happy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_41","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_41","text":"How so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_42","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_42","text":"I'm always happy whenever you come over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_43","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_44","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_44","text":"I feel very much the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_45","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_45","text":"Even so, each of us hath a place that suits us best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_46","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_46","text":"We each may hast enjoyed our time in the other's world,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_47","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_47","text":"but in time, that fondness will sour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_48","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_49","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_49","text":"All right, then. Enough of these dour words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_50","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_50","text":"Drink to thy heart's content.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_51","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_51","text":"2 hours later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_52","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_52","text":"Hmm... It seems that thou art not the loggerhead I had pegged thou for at the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_53","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_53","text":"Could it be that thou were sent to the surface as soon as thou were commissioned?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_54","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_54","text":"It's tough.","jump":"d_nikke_hongryeon_05_56","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_55","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_55","text":"It's quite all right.","jump":"d_nikke_hongryeon_05_59","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_56","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_56","text":"Thou ought to hast suffered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_57","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_57","text":"As the saying goes, adversity maketh man.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_58","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_58","text":"These hardships thou hast suffered, they shall be to thy benefit in the end.","jump":"d_nikke_hongryeon_05_62","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_59","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_59","text":"My, my...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_60","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_60","text":"Thou sure are a fascinating creature, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_61","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_61","text":"Regardless of how weak thou may appear, thou possess an inner strength that is most admirable.","jump":"d_nikke_hongryeon_05_62","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_62","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_62","text":"2 hours later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_63","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_63","text":"Say to me, my Lord. *hiccup* How dost thou regard of thy days spent up on the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_64","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_64","text":"I reckon thou hast taken to it quite well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_05_65","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_05_65","text":"So long as thou look after 