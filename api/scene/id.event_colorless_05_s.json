nter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_81","type":"Self","speaker":null,"key":"Locale_SubScenario:event_colorless_05_s_81","text":"I assume you can't come with us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_82","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_colorless_05_s_82","text":"Correct. The moment I leave the school, they'll be able to track my coordinates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_83","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_colorless_05_s_83","text":"They said they would harm the students if I tried to leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_84","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_colorless_05_s_84","text":"I may not be able to go up to the surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_85","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_colorless_05_s_85","text":"but you can, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_86","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_colorless_05_s_86","text":"You can go up to the surface on a mission, and \"happen\" to run into the students, after which you'd naturally be duty-bound to protect them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_87","type":"Self","speaker":null,"key":"Locale_SubScenario:event_colorless_05_s_87","text":"You said it yourself, Marciana.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_88","type":"Self","speaker":null,"key":"Locale_SubScenario:event_colorless_05_s_88","text":"You'd never give up on your students.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_89","type":"Self","speaker":null,"key":"Locale_SubScenario:event_colorless_05_s_89","text":"You may not be able to protect them yourself,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_90","type":"Self","speaker":null,"key":"Locale_SubScenario:event_colorless_05_s_90","text":"but I know you'll do whatever you can to protect them, by any means.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_91","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_colorless_05_s_91","text":"That's right. That's the role I've carved out for myself as their teacher.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_92","type":"Self","speaker":null,"key":"Locale_SubScenario:event_colorless_05_s_92","text":"And that's why I'm going to bring them back to you, where you can take them under your wing again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_colorless_05_s_93","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_colorless_05_s_93",