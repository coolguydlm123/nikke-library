nseling:d_counseling_mast_03_13","text":"Do you know what the signal says?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_03_14","type":"Speech","speaker":"mast","key":"Locale_Counseling:d_counseling_mast_03_14","text":"\"Aliens have appeared. We advise all citizens to take shelter.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_03_15","type":"Speech","speaker":"mast","key":"Locale_Counseling:d_counseling_mast_03_15","text":"When was the last time someone mentioned Raptures aliens anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_03_16","type":"Speech","speaker":"mast","key":"Locale_Counseling:d_counseling_mast_03_16","text":"It's been ages!","jump":"d_counseling_mast_03_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mast_03_17","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mast_03_17","text":"With the lights off in the Commander's Room, I listen to Mast's story of the ghost ship.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}