{"id":"d_counseling_harran_01","cat":"counsel","group":{"id":"char5042","label":"Harran"},"label":"Advising Harran: 01","stage":null,"prev":null,"next":"d_counseling_harran_02","speakers":{"harran":"Harran"},"icons":{"harran":"si_c230_00_s"},"lines":[{"id":"d_counseling_harran_01_1","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_1","text":"Have you heard the proverb, \"A pear drops when a crow flies from the tree\"?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["harran"],"affinity":"_0"},{"id":"d_counseling_harran_01_2","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_2","text":"It's fine if you don't understand what it means, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_3","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_3","text":"Tell me. What would you do if I blasted that crow out of the sky?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_01_4","text":"I'd go pick up the pear.","jump":"d_counseling_harran_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_harran_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_01_5","text":"I'd say, \"Bye bye, Crow.\"","jump":"d_counseling_harran_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_harran_01_6","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_6","text":"Very good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_7","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_7","text":"You're smarter than you look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_8","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_8","text":"I must say, you do amuse me from time to time.","jump":"d_counseling_harran_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_9","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_10","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_10","text":"Your courtesy can't hide your amusing lack of sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_11","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_01_11","text":"Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_01_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_harran_01_12","text":"I hang out with Haran to continue amusing her.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}