{"id":"msg_m_ex_rapi_02","cat":"messenger","group":{"id":"room_rapi","label":"Rapi · Nikke"},"label":"2. Commander,","stage":null,"prev":"msg_m_ex_rapi_01","next":"msg_m_ex_rapi_03","speakers":{"rapi":"Rapi"},"icons":{"rapi":"si_c010_00_s"},"lines":[{"id":"m_ex_rapi_02_1","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_1","text":"Commander,","jump":null},{"id":"m_ex_rapi_02_2","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_2","text":"I have a question.","jump":null},{"id":"m_ex_rapi_02_3","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_3","text":"If you could install something new in your office,","jump":null},{"id":"m_ex_rapi_02_4","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_4","text":"what would it be?","jump":null},{"id":"m_ex_rapi_02_5","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_5","text":"A bigger fridge.","jump":"m_ex_rapi_02_7"},{"id":"m_ex_rapi_02_6","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_6","text":"A better computer.","jump":"m_ex_rapi_02_13"},{"id":"m_ex_rapi_02_7","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_7","text":"A bigger fridge?","jump":null},{"id":"m_ex_rapi_02_8","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_8","text":"Why's that?","jump":null},{"id":"m_ex_rapi_02_9","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_9","text":"The one you have now is already pretty hefty.","jump":null},{"id":"m_ex_rapi_02_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_10","text":"It's occupied by Anis's sodas.","jump":null},{"id":"m_ex_rapi_02_11","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_11","text":"Ah, got it.","jump":null},{"id":"m_ex_rapi_02_12","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_12","text":"I'll be sure to speak with Anis.","jump":"m_ex_rapi_02_21"},{"id":"m_ex_rapi_02_13","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_13","text":"A better computer?","jump":null},{"id":"m_ex_rapi_02_14","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_14","text":"As far as I know, I've not encountered any issues","jump":null},{"id":"m_ex_rapi_02_15","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_15","text":"when I file your paperwork.","jump":null},{"id":"m_ex_rapi_02_16","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_16","text":"Have you experienced any issues with your computer?","jump":null},{"id":"m_ex_rapi_02_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_17","text":"Exia wants an upgrade so that she can play some higher-end games.","jump":null},{"id":"m_ex_rapi_02_18","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_18","text":"Ah.","jump":null},{"id":"m_ex_rapi_02_19","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_19","text":"So that's it.","jump":null},{"id":"m_ex_rapi_02_20","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_20","text":"I'll be sure to speak with Exia.","jump":"m_ex_rapi_02_21"},{"id":"m_ex_rapi_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_21","text":"No, don't worry about it.","jump":null},{"id":"m_ex_rapi_02_22","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_22","text":"Putting the Nikkes aside,","jump":null},{"id":"m_ex_rapi_02_23","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_23","text":"isn't there something you'd like for yourself?","jump":null},{"id":"m_ex_rapi_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_24","text":"No, not really.","jump":null},{"id":"m_ex_rapi_02_25","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_25","text":"Very well.","jump":null},{"id":"m_ex_rapi_02_26","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_26","text":"If you insist.","jump":null},{"id":"m_ex_rapi_02_27","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_27","text":"I guess that's that.","jump":null},{"id":"m_ex_rapi_02_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_28","text":"What makes you ask?","jump":null},{"id":"m_ex_rapi_02_29","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_29","text":"You're always doing things for us,","jump":null},{"id":"m_ex_rapi_02_30","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_30","text":"so I thought this time we could allot a portion of the budget","jump":null},{"id":"m_ex_rapi_02_31","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_31","text":"to purchase something that you yourself wanted.","jump":null},{"id":"m_ex_rapi_02_32","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_32","text":"However, since you don't seem to require anything, I suppose there's no need to do so.","jump":null},{"id":"m_ex_rapi_02_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_33","text":"No, wait. Actually, there may be something.","jump":null},{"id":"m_ex_rapi_02_34","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_34","text":"I'm sorry, Commander.","jump":null},{"id":"m_ex_rapi_02_35","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_35","text":"It's too late now.","jump":null},{"id":"m_ex_rapi_02_36","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_36","text":"I just uploaded the budget sheets.","jump":null},{"id":"m_ex_rapi_02_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_37","text":"Oh...","jump":null},{"id":"m_ex_rapi_02_38","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_38","text":"I'll ask again when I make the budget for the next quarter.","jump":null},{"id":"m_ex_rapi_02_39","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_02_39","text":"Be sure to speak up then.","jump":null},{"id":"m_ex_rapi_02_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_02_40","text":"Okay.","jump":null}],"chat":true}