{"id":"d_main_22_08","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"Moran's Task","stage":"22-24 STAGE · Start","prev":"d_main_22_07","next":"d_main_22_09","speakers":{"moran":"Moran","jin":"Jin"},"icons":{"moran":"si_c281_00_s","jin":"si_c922_00_s"},"lines":[{"id":"d_main_22_08_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_08_1","text":"2 hours prior to the incident. Seimeikai drawing room. Back alley in the Ark","jump":null,"exit":false,"enter":null,"bg":"Backstreet","bgArt":"backstreet","image":null,"bgm":"bgm_mystery","movie":null,"shown":["moran","jin"],"affinity":null},{"id":"d_main_22_08_2","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_2","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_3","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_3","text":"Is that true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_4","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_4","text":"Yes. I'm certain of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_5","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_5","text":"One of my childhood friends is part of Heavenly Ascension. They told me personally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_6","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_6","text":"E.H. must be beside herself right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_7","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_7","text":"So, where are they taking it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_8","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_8","text":"To the Outer Rim, most likely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_9","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_9","text":"But how? There's a massive barrier separating the Outer Rim and the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_10","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_10","text":"They'd never let anyone with that many weapons pass through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_11","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_11","text":"I heard about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_12","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_12","text":"They'll be using the elevator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_13","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_13","text":"The elevator?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_14","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_14","text":"Yes. As you know, there are many elevators in the Ark that lead up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_15","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_15","text":"While there may not be as many of them, there are also elevators that can go from the Outer Rim to the surface and vice versa.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_16","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_16","text":"Most of them are no longer operational, but some are still active.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_17","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_17","text":"First, they plan on taking an elevator from the Outer Rim up to the surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_18","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_18","text":"and then taking another elevator from there down to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_19","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_19","text":"Would that work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_20","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_20","text":"There are thousands of elevators leading to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_21","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_21","text":"There's no way all of them are well-protected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_22","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_22","text":"I don't mean that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_23","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_23","text":"The surface is crawling with Raptures. Is it even possible for a human to traverse that place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_24","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_24","text":"You know what it's like in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_25","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_25","text":"They never got anything from the Ark, so they had to turn to the surface in order to get by.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_26","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_26","text":"They may not be able to take down a Rapture, but they probably know all sorts of ways to avoid them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_27","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_27","text":"For Heavenly Ascension, this isn't even an issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_28","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_28","text":"So, since E.H. got what she wanted, that must mean she's coming back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_29","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_29","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_30","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_30","text":"We have to stop her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_31","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_31","text":"But... why? I think what E.H. is saying makes sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_32","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_32","text":"I understand that, but we can't let her do this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_33","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_33","text":"Do you always have to argue like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_34","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_34","text":"Where is the elevator that E.H. mentioned?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_35","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_35","text":"I'll send you a text. Since you're so good at finding your way around,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_36","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_36","text":"you can put your navigational skills to the test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_37","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_37","text":"... You're not coming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_38","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_38","text":"Give me a break! It's clear there's going to be some kind of altercation. What good would it do if I were there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_39","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_39","text":"Everyone knows I'm no fighter. Gathering intel is my specialty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_40","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_41","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_41","text":"Whatever you say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_42","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_08_42","text":"Send word to Rosanna and Sakura as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_08_43","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_22_08_43","text":"You got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}