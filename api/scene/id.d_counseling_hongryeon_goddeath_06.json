{"id":"d_counseling_hongryeon_goddeath_06","cat":"counsel","group":{"id":"char5186","label":"Scarlet: Goddeath"},"label":"Advising Scarlet: Goddeath: 06","stage":null,"prev":"d_counseling_hongryeon_goddeath_05","next":"d_counseling_hongryeon_goddeath_07","speakers":{"hongryeon_g":"Scarlet"},"icons":{"hongryeon_g":"si_c472_00_s"},"lines":[{"id":"d_counseling_hongryeon_goddeath_06_1","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_1","text":"Thou hast a remarkable way of setting those about thee at their ease.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon_g"],"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_2","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_2","text":"With thee, my innermost thoughts oft slip forth ere I realize it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_3","text":"I feel comfortable around you too.","jump":"d_counseling_hongryeon_goddeath_06_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_goddeath_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_4","text":"I guess people just feel comfortable around me.","jump":"d_counseling_hongryeon_goddeath_06_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_goddeath_06_5","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_5","text":"Ho, is that truly so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_6","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_6","text":"Ha ha, it gladdens me greatly to know thou dost feel at ease in my company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_7","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_7","text":"Good! Why not share a draught, seeing as we are quite comfortable with one another?","jump":"d_counseling_hongryeon_goddeath_06_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_8","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_8","text":"\"Just\" is a notion that hath no place here, my Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_9","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_9","text":"All hath come to pass through thy own doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_10","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_06_10","text":"Speak not so slightingly of thyself.","jump":"d_counseling_hongryeon_goddeath_06_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_06_11","type":"Narration","speaker":null,"key":"Locale