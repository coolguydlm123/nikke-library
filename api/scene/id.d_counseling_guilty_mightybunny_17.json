{"id":"d_counseling_guilty_mightybunny_17","cat":"counsel","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Advising Guilty: Mighty Bunny: 17","stage":null,"prev":"d_counseling_guilty_mightybunny_16","next":"d_counseling_guilty_mightybunny_18","speakers":{"guilty_b":"Guilty"},"icons":{"guilty_b":"si_c404_00_s"},"lines":[{"id":"d_counseling_guilty_mightybunny_17_1","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_17_1","text":"After meeting Sin, and after listening to a lot of the things you've said... I started thinking about the power of conversation...","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty_b"],"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_17_2","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_17_2","text":"If talking really does have so much power to it... do you think that means it can help us grow even closer, Counselor...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_17_3","text":"Yeah. Talking with you just like this makes me happy.","jump":"d_counseling_guilty_mightybunny_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_mightybunny_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_17_4","text":"Conversation isn't everything.","jump":"d_counseling_guilty_mightybunny_17_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_mightybunny_17_5","type":"Speech","speaker":"guilty_