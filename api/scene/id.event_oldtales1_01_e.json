{"id":"event_oldtales1_01_e","cat":"event","group":{"id":"ev40061","label":"OLD TALES · Part 1"},"label":"A Long Wait: B","stage":null,"prev":"event_oldtales1_01_s","next":"event_oldtales1_02_s","speakers":{"cinderella":"Cinderella","abe":"Abe","hansel":"Hansel","redshoes":"Red Shoes","littlemermaid":"Little Mermaid"},"icons":{"cinderella":"si_c511_00_s","abe":"si_c979_00_s","hansel":"si_c980_00_s","redshoes":"si_c982_00_s","littlemermaid":"si_c513_00_s"},"lines":[{"id":"event_oldtales1_01_e_1","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_1","text":"Haha.","jump":null,"exit":false,"enter":null,"bg":"Hotel","bgArt":"hotel","image":null,"bgm":"event_bgm_oldtales_beautifulthing","movie":null,"shown":["cinderella"],"affinity":null},{"id":"event_oldtales1_01_e_2","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_2","text":"Beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_3","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_3","text":"I didn't know such beauty was possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_4","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_4","text":"Are you staring at the mirror again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["abe"],"affinity":null},{"id":"event_oldtales1_01_e_5","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_5","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_6","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_6","text":"Look at this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_oldtales1_01_e_7","text":"Cinderella points to the screen, which shows the Goddess Squad fighting with Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_8","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_8","text":"Aren't they magnificent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_9","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_9","text":"You're seriously obsessed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_10","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_10","text":"Stop watching that and get out here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_11","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_11","text":"Wait. This is the best part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_12","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_12","text":"It's Scarlet, the newcomer, and Dorothy's coordinated attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_13","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_13","text":"Even though they don't seem that close, their coordination during battle is exceptional.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_14","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_14","text":"This seeming discrepancy between everyday life and the thick of battle... it's beautiful beyond words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_15","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_15","text":"If I were a member of the Goddess Squad, I'd think you were a creepy fanatic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_16","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_16","text":"Do you really want to be a Goddess that much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_17","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_17","text":"Of course. Nothing can surpass their pulchritude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_18","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_18","text":"Good grief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_19","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_19","text":"You could be with them as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_20","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_20","text":"What? The Goddess Squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_21","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_21","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_22","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_22","text":"What are you talking about? I'm just a mass-produced Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_23","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_23","text":"Didn't you volunteer to be a Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_24","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_24","text":"Yeah, why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_25","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_25","text":"You were a chief researcher at V.T.C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_26","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_26","text":"You're probably the only case where someone chose to be a Nikke because you found the human habit of sleep to be an obstacle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_27","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_27","text":"They granted your wish, and you became a Nikke who didn't require sleep. That's how you were able to make us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_28","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_28","text":"So you are beautiful too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_29","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_29","text":"You even got to keep your memories, correct? That almost never happens for mass-produced Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_30","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_30","text":"It means you have an unbreakable spirit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_31","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_31","text":"So you are beautiful, and therefore you can become a Goddess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_32","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_32","text":"Retaining my memories was a stroke of dumb luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_33","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_33","text":"Being a Goddess is a different level entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_34","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_34","text":"I don't think it was luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_35","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_35","text":"You desired it, and you achieved it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_36","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_36","text":"I wouldn't want to be a Goddess anyway, because then you'd be obsessed with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_37","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_37","text":"You got to see your favorite part, so hurry and get out here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_38","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_38","text":"I have something to tell you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_39","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_39","text":"Is everyone here?","jump":null,"exit":false,"enter":null,"bg":"BriefingRoom","bgArt":"briefingroom","image":null,"bgm":null,"movie":null,"shown":["hansel","gretel","littlemermaid","redshoes"],"affinity":null},{"id":"event_oldtales1_01_e_40","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_e_40","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_41","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_e_41","text":"Yep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_42","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_oldtales1_01_e_42","text":"Aaah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_43","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_43","text":"Everybody listen up, and don't freak out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_44","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_44","text":"We've been approved for deployment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_oldtales_dutycall","movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_45","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_e_45","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_46","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_e_46","text":"Come again?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_47","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_oldtales1_01_e_47","text":"N-no way...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_48","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_48","text":"Siren! Don't talk!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_49","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_oldtales1_01_e_49","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_50","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_oldtales1_01_e_50","text":"Ah, aoooh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_51","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_51","text":"I told you all to stay calm!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_52","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_e_52","text":"... Tell us more details.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_53","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_53","text":"The United Forces of Humanity and V.T.C. have apparently somehow found common ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_54","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_54","text":"They were extremely satisfied with the test results, and wanted to put them to the test as soon as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_55","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_55","text":"This might seem anticlimactic, but only one person will be deployed initially.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_56","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_e_56","text":"... Who?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_57","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_57","text":"The one with the best test results.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_e_58","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_e_58","text":"Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}