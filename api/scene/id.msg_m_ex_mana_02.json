{"id":"msg_m_ex_mana_02","cat":"messenger","group":{"id":"room_mana","label":"Mana · Nikke"},"label":"2. Hello Commander.","stage":null,"prev":"msg_m_ex_mana_01","next":"msg_m_ex_mana_03","speakers":{"mana":"Mana"},"icons":{"mana":"si_c290_00_s"},"lines":[{"id":"m_ex_mana_02_1","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_1","text":"Hello Commander.","jump":null},{"id":"m_ex_mana_02_2","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_2","text":"It's Mana.","jump":null},{"id":"m_ex_mana_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_3","text":"How are you doing?","jump":null},{"id":"m_ex_mana_02_4","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_4","text":"Honestly, as much as I'd like to say otherwise,","jump":null},{"id":"m_ex_mana_02_5","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_5","text":"I'm not doing so hot.","jump":null},{"id":"m_ex_mana_02_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_6","text":"Huh?","jump":null},{"id":"m_ex_mana_02_7","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_7","text":"After all, greetings are important for getting an idea","jump":null},{"id":"m_ex_mana_02_8","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_8","text":"how someone is doing.","jump":null},{"id":"m_ex_mana_02_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_9","text":"Something seems off...","jump":null},{"id":"m_ex_mana_02_10","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_10","text":"Me?","jump":null},{"id":"m_ex_mana_02_11","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_11","text":"I'm fine.","jump":null},{"id":"m_ex_mana_02_12","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_12","text":"I'm having a little drink, sure, but I'm fine.","jump":null},{"id":"m_ex_mana_02_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_13","text":"You're drinking?","jump":null},{"id":"m_ex_mana_02_14","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_14","text":"Yez","jump":null},{"id":"m_ex_mana_02_15","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_15","text":"Yes.","jump":null},{"id":"m_ex_mana_02_16","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_16","text":"Heh.","jump":null},{"id":"m_ex_mana_02_17","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_17","text":"Hehehehe.","jump":null},{"id":"m_ex_mana_02_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_18","text":"Are you drunk?","jump":null},{"id":"m_ex_mana_02_19","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_19","text":"No.","jump":null},{"id":"m_ex_mana_02_20","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_20","text":"I'm totally fine.","jump":null},{"id":"m_ex_mana_02_21","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_21","text":"But you know,","jump":null},{"id":"m_ex_mana_02_22","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_22","text":"when I found out that Nikkes can get drunk as well,","jump":null},{"id":"m_ex_mana_02_23","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_23","text":"I wa sso oovveryjoyed.","jump":null},{"id":"m_ex_mana_02_24","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_24","text":"Whoops, typo, hehe.","jump":null},{"id":"m_ex_mana_02_25","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_25","text":"That's all right, I can make a typoe from time to time.","jump":null},{"id":"m_ex_mana_02_26","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_26","text":"Oh, there I go again.","jump":null},{"id":"m_ex_mana_02_27","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_27","text":"Hahahaha!","jump":null},{"id":"m_ex_mana_02_28","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_28","text":"I feel great.","jump":null},{"id":"m_ex_mana_02_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_29","text":"Seems to me like you're quite drunk.","jump":null},{"id":"m_ex_mana_02_30","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_30","text":"Me?","jump":null},{"id":"m_ex_mana_02_31","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_31","text":"Not at all.","jump":null},{"id":"m_ex_mana_02_32","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_32","text":"I'm simply in a good mood.","jump":null},{"id":"m_ex_mana_02_33","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_33","text":"I'm not drunk in the slightest.","jump":null},{"id":"m_ex_mana_02_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_34","text":"Have you gone out to a bar?","jump":null},{"id":"m_ex_mana_02_35","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_35","text":"No.","jump":null},{"id":"m_ex_mana_02_36","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_36","text":"I'm alone.","jump":null},{"id":"m_ex_mana_02_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_37","text":"You are?","jump":null},{"id":"m_ex_mana_02_38","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_38","text":"I'm in the dorm.","jump":null},{"id":"m_ex_mana_02_39","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_39","text":"Where would a researcher like myself go all alone anyway?","jump":null},{"id":"m_ex_mana_02_40","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_40","text":"I'm always up to my neck with work, so the lab and the dorm are the only places I go.","jump":null},{"id":"m_ex_mana_02_41","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_41","text":"Lab. Dorm. Lab. Dorm. Lab. Dorm. Back and forhtg.","jump":null},{"id":"m_ex_mana_02_42","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_42","text":"Whhoops, another typo.","jump":null},{"id":"m_ex_mana_02_43","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_43","text":"Hahaha.","jump":null},{"id":"m_ex_mana_02_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_44","text":"You seem quite inebriated to me.","jump":null},{"id":"m_ex_mana_02_45","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_45","text":"I've still got all my faculties.","jump":null},{"id":"m_ex_mana_02_46","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_46","text":"I'm just","jump":null},{"id":"m_ex_mana_02_47","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_47","text":"in a good mood is all.","jump":null},{"id":"m_ex_mana_02_48","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_48","text":"In a usper good moood.","jump":null},{"id":"m_ex_mana_02_49","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_49","text":"Whoops, another type.","jump":null},{"id":"m_ex_mana_02_50","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_50","text":"Meh, I don't think I need to erase it, do I?","jump":null},{"id":"m_ex_mana_02_51","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_51","text":"You don't get bothered about that kinda stuff, do you, Commander?","jump":null},{"id":"m_ex_mana_02_52","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_52","text":"You're not like Syuen, the president, or the CEO.","jump":null},{"id":"m_ex_mana_02_53","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_53","text":"You wouldn't reprimand me for this kind of thing.","jump":null},{"id":"m_ex_mana_02_54","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_54","text":"I think it would be best if you stopped drinking.","jump":null},{"id":"m_ex_mana_02_55","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_55","text":"Huh? Me?","jump":null},{"id":"m_ex_mana_02_56","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_56","text":"Stoopp?","jump":null},{"id":"m_ex_mana_02_57","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_57","text":"How many times do I have to tell you?","jump":null},{"id":"m_ex_mana_02_58","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_58","text":"I'm not drunk.","jump":null},{"id":"m_ex_mana_02_59","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_59","text":"Mana.","jump":null},{"id":"m_ex_mana_02_60","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_60","text":"Yes?","jump":null},{"id":"m_ex_mana_02_61","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_61","text":"Hurry and go to bed.","jump":null},{"id":"m_ex_mana_02_62","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_62","text":"I told you, I'm not drunk.","jump":null},{"id":"m_ex_mana_02_63","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_63","text":"Honeltya.","jump":null},{"id":"m_ex_mana_02_64","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_64","text":"Honestly.","jump":null},{"id":"m_ex_mana_02_65","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_65","text":"I'm setious.","jump":null},{"id":"m_ex_mana_02_66","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_66","text":"Yes you are.","jump":null},{"id":"m_ex_mana_02_67","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_67","text":"... Okay.","jump":null},{"id":"m_ex_mana_02_68","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_68","text":"Maybe...","jump":null},{"id":"m_ex_mana_02_69","type":"Speech","speaker":"mana","key":"Locale_SuddenMessage:m_ex_mana_02_69","text":"I do feel a bi tireda.","jump":null},{"id":"m_ex_mana_02_70","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_70","text":"Mana? Are you there?","jump":null},{"id":"m_ex_mana_02_71","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_71","text":"... No more messages from Mana come through.","jump":null},{"id":"m_ex_mana_02_72","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_mana_02_72","text":"Since it seems that she's fallen asleep, I'll leave her alone.","jump":null}],"chat":true}