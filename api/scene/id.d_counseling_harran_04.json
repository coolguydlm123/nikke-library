{"id":"d_counseling_harran_04","cat":"counsel","group":{"id":"char5042","label":"Harran"},"label":"Advising Harran: 04","stage":null,"prev":"d_counseling_harran_03","next":"d_counseling_harran_05","speakers":{"harran":"Harran"},"icons":{"harran":"si_c230_00_s"},"lines":[{"id":"d_counseling_harran_04_1","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_1","text":"Isabel has always been a good follower of yours, yes?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["harran"],"affinity":"_0"},{"id":"d_counseling_harran_04_2","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_2","text":"She was always taken with you before, but it's gotten worse lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_3","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_3","text":"Tell me, what is it about you that has made her like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_04_4","text":"My devilish good looks?","jump":"d_counseling_harran_04_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_harran_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_04_5","text":"My charming personality?","jump":"d_counseling_harran_04_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_harran_04_6","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_7","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_7","text":"You are very confident in yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_8","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_8","text":"I suppose that could be the reason.\nHowever, I'm no longer interested in this conversation. Let's not discuss it any further.","jump":"d_counseling_harran_04_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_9","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_9","text":"I must admit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_10","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_10","text":"your way of thinking is rather novel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_11","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_04_11","text":"That is why I'm fond of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_04_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_harran_04_12","text":"I talk with Harran a bit more, thinking about Isabel.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}