you all later.","jump":null},{"id":"m_ex_goldenship_05_61","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_05_61","text":"I'll try and snag some scrumptious snacks.","jump":null},{"id":"m_ex_goldenship_05_62","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_05_62","text":"Awesome!","jump":null},{"id":"m_ex_goldenship_05_63","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_63","text":"See you guys tonight.","jump":null}],"chat":true}