ull},{"id":"m_ex_goldenship_05_11","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_11","text":"Hmm...","jump":null},{"id":"m_ex_goldenship_05_12","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_12","text":"It'd probably be easiest to meet at the Outpost,","jump":null},{"id":"m_ex_goldenship_05_13","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_13","text":"since that's where the Captain is.","jump":null},{"id":"m_ex_goldenship_05_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_05_14","text":"No, there're too many people here.","jump":null},{"id":"m_ex_goldenship_05_15","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_15","text":"Hmm...","jump":null},{"id":"m_ex_goldenship_05_16","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_05_16","text":"You're right.","jump":null},{"id":"m_ex_goldenship_05_17","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_05_17","text":"There are a lot of Nikkes at the Outpost.","jump":null},{"id":"m_ex_goldenship_05_18","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_18","text":"If word got out that we had such a delectable brew on our hands, it'd be gone in an instant.","jump":null},{"id":"m_ex_goldenship_05_19","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_19","text":"Let me think...","jump":null},{"id":"m_ex_goldenship_05_20","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_20","text":"Where else would be a good spot?","jump":null},{"id":"m_ex_goldenship_05_21","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_05_21","text":"How about Cafe Sweety?","jump":"m_ex_goldenship_05_23"},{"id":"m_ex_goldenship_05_22","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_05_22","text":"How about the Admire?","jump":"m_ex_goldenship_05_28"},{"id":"m_ex_goldenship_05_23","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_23","text":"No.","jump":null},{"id":"m_ex_goldenship_05_24","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_24","text":"No way.","jump":null},{"id":"m_ex_goldenship_05_25","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_25","text":"Sugar and Milk here.","jump":null},{"id":"m_ex_goldenship_05_26","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_26","text":"Noooo.","jump":null},{"id":"m_ex_goldenship_05_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_05_27","text":"Okay then, how about the Admire?","jump":"m_ex_goldenship_05_28"},{"id":"m_ex_goldenship_05_28","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_28","text":"Yes!","jump":null},{"id":"m_ex_goldenship_05_29","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_29","text":"That's a great idea!","jump":null},{"id":"m_ex_goldenship_05_30","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_30","text":"Why didn't I think of that?","jump":null},{"id":"m_ex_goldenship_05_31","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_31","text":"Today's event is gonna wrap up early,","jump":null},{"id":"m_ex_goldenship_05_32","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_32","text":"so Helm and I will be the only ones on the entire ship.","jump":null},{"id":"m_ex_goldenship_05_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_05_33","text":"All right, then we'll drink on the Admire.","jump":null},{"id":"m_ex_goldenship_05_34","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_34","text":"OK.","jump":null},{"id":"m_ex_goldenship_05_35","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_05_35","text":"This is great, I don't have to go anywhere.","jump":null},{"id":"m_ex_goldenship_05_36","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_36","text":"Also","jump":null},{"id":"m_ex_goldenship_05_37","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_37","text":"Hmm","jump":null},{"id":"m_ex_goldenship_05_38","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_38","text":"if everyone's okay with it,","jump":null},{"id":"m_ex_goldenship_05_39","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_39","text":"I'd like to","jump":null},{"id":"m_ex_goldenship_05_40","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_40","text":"share some of the elixir","jump":null},{"id":"m_ex_goldenship_05_41","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_41","text":"with Helm.","jump":null},{"id":"m_ex_goldenship_05_42","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_42","text":"She's done a lot for me.","jump":null},{"id":"m_ex_goldenship_05_43","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_05_43","text":"I'm fine with that.","jump":null},{"id":"m_ex_goldenship_05_44","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_44","text":"I knew you'd be okay with it, Anchor.","jump":null},{"id":"m_ex_goldenship_05_45","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_45","text":"Okay.","jump":null},{"id":"m_ex_goldenship_05_46","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_05_46","text":"Are you sure?","jump":null},{"id":"m_ex_goldenship_05_47","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_05_47","text":"Yeah.","jump":null},{"id"