{"id":"d_counseling_mihara_08","cat":"counsel","group":{"id":"char3006","label":"Mihara"},"label":"Advising Mihara: 08","stage":null,"prev":"d_counseling_mihara_07","next":"d_counseling_mihara_09","speakers":{"mihara":"Mihara"},"icons":{"mihara":"si_c161_00_s"},"lines":[{"id":"d_counseling_mihara_08_1","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_1","text":"Taking care of your body is important.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mihara"],"affinity":"_0"},{"id":"d_counseling_mihara_08_2","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_2","text":"If I want to keep enjoying my particular hobbies for a long time, I'll need to keep my body in tip-top shape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_3","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_3","text":"Speaking of which, do you have any health tips you can share?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_08_4","text":"Consistent exercise and a good diet.","jump":"d_counseling_mihara_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mihara_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_08_5","text":"Stay away from stressful situations.","jump":"d_counseling_mihara_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mihara_08_6","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_6","text":"Commander, those things don't really apply to a Nikke...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_7","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_7","text":"Wouldn't it be better to focus more on the mental side of things?","jump":"d_counseling_mihara_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_8","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_8","text":"Yes! That's the most important thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_9","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_9","text":"Ha ha. I always thought that, as a Commander, you would always be stressed out by your work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_10","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_10","text":"Perhaps I was wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_11","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_08_11","text":"Just like I thought. You are exceptional.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_08_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_08_12","text":"I watch a video about mental health with Mihara.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}