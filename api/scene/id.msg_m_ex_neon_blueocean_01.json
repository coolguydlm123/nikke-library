h me.","jump":null},{"id":"m_ex_neon_blueocean_01_11","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_11","text":"Being cute","jump":null},{"id":"m_ex_neon_blueocean_01_12","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_12","text":"is like being small.","jump":null},{"id":"m_ex_neon_blueocean_01_13","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_13","text":"Right?","jump":null},{"id":"m_ex_neon_blueocean_01_14","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_14","text":"But I'm not small,","jump":null},{"id":"m_ex_neon_blueocean_01_15","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_15","text":"I'm big!","jump":null},{"id":"m_ex_neon_blueocean_01_16","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_16","text":"Waterpower isn't small and adorable, it's big and bold!","jump":null},{"id":"m_ex_neon_blueocean_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_17","text":"I see.","jump":null},{"id":"m_ex_neon_blueocean_01_18","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_18","text":"After mastering the way of waterpower,","jump":null},{"id":"m_ex_neon_blueocean_01_19","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_19","text":"I should be bigger than ever!","jump":null},{"id":"m_ex_neon_blueocean_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_20","text":"I see.","jump":null},{"id":"m_ex_neon_blueocean_01_21","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_21","text":"??","jump":null},{"id":"m_ex_neon_blueocean_01_22","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_neon_blueocean_01_22","text":"Master,","jump":null},{"id":"m_ex_neon_blueoc