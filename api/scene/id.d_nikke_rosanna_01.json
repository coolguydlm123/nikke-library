{"id":"d_nikke_rosanna_01","cat":"bond","group":{"id":"char5045","label":"Rosanna"},"label":"Warmest Regards","stage":null,"prev":null,"next":"d_nikke_rosanna_02","speakers":{"wealthyman":"Philanthropist","rosanna":"Rosanna","consigliere":"Consigliere"},"icons":{"rosanna":"si_c280_00_s","consigliere":"si_c920_00_s"},"lines":[{"id":"d_nikke_rosanna_01_1","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_1","text":"Greetings, Boss. I've come to give you my regards.","jump":null,"exit":false,"enter":null,"bg":"GoodOffice","bgArt":"goodoffice","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["rosanna","wealthyman"],"affinity":null},{"id":"d_nikke_rosanna_01_2","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_2","text":"That's a snappy suit. Things must be going well for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_3","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_3","text":"Indeed they are, thanks to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_4","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_4","text":"I'm no longer being harassed by outlaws.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_5","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_5","text":"Now that things are going my way, there's no need for you to go out of your way to assist me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_6","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_6","text":"If it wasn't for your help all those years ago, I wouldn't be standing here now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_7","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_7","text":"Ah, yes. How many years has it been now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_8","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_8","text":"Nearly four, if you can believe it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_9","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_9","text":"With that in mind,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_10","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_10","text":"might I extend a small courtesy to the organization?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_11","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_11","text":"Of course, it is little more than a pittance given the grand scale of Hedonia, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_12","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_rosanna_01_12","text":"The man produces a briefcase and places it on the table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_13","type":"Speech","speaker":"wealthyman","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_13","text":"It is the least I can do to repay you for all of the kindness you have shown me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_14","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_14","text":"Please, you flatter me. You make it sound as if I'm some kind of self-help guru.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_15","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_15","text":"Nevertheless, since you were kind enough to bring it in, we might as well put this money to good use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_16","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_16","text":"I'll be seeing you around. Consigliere, you may enter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_17","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_rosanna_01_17","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["consigliere"],"affinity":null},{"id":"d_nikke_rosanna_01_18","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_18","text":"You called, Miss?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_19","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_19","text":"Do you recall that organization which popped up in our district recently? The one frequenting in human trafficking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_20","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_20","text":"Use this to purchase all of their \"goods\" from them. Men and women, it doesn't matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_21","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_21","text":"Do you intend to keep them on as employees?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_22","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_22","text":"There used to be a time when I would have, but now that I've taken my oath, I cannot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_23","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_23","text":"Before we exterminate the perpetrators, we must ensure the innocent victims are at a safe distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_24","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_24","text":"Understood. I'll make the necessary preparations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_25","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_rosanna_01_25","text":"*Knock knock*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_26","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_26","text":"Who is it this time? Today's been a revolving door of callers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_27","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_rosanna_01_27","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_28","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_28","text":"It was not a visitor, but rather a mail delivery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_29","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_29","text":"Give it here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_30","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_31","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_31","text":"The sender is... Anthony?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_32","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_32","text":"Where have I heard this name before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_33","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_33","text":"One of the previous Bosses had a son by that name.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_34","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_34","text":"Yes, that's it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_35","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_35","text":"He took a tumble off the terrace, did he not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_36","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_36","text":"How exactly does a dead man go about mailing letters?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_37","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_37","text":"Most puzzling indeed, Miss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_38","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_38","text":"Shall I open it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_39","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_39","text":"Yes, read it out loud for me, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_40","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_40","text":"You killed my boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_41","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_41","text":"Now I'll kill yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_42","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_42","text":"Blood for blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_43","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_43","text":"Great. Not only is our ghostly friend sending letters, but he's speaking in riddles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_44","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_44","text":"Let's see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_45","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_45","text":"The 'boss's he's referring to is most likely his father, whom I did have whacked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_46","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_46","text":"But who does he mean when he says he'll kill my boss?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_47","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_47","text":"I've been the boss of this organization for a while now, and I'm still having to deal with this nonsense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_48","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_48","text":"Wait...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_49","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_49","text":"Could he be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_50","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_50","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_51","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_51","text":"This jamoke is going down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_52","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_52","text":"Even in our line of work, we still have basic moral standards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_53","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_54","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_54","text":"... Consigliere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_55","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_55","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_56","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_56","text":"How many days do you need to kill them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_57","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_57","text":"One week.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_58","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_01_59","type":"Speech","speaker":"consigliere","key":"Locale_NikkeEpisode:d_nikke_rosanna_01_59","text":"... Erm, I meant three days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_