":null,"affinity":null},{"id":"event_arkranger2_05_s_72","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_05_s_72","text":"I never thought I'd get the gig because I had no experience with superhero shows, but here we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_73","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_05_s_73","text":"Yeah... Mustang's a sucker when it comes to a person's passion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_74","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_05_s_74","text":"Now, why do you think I like the Ark Rangers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_75","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_05_s_75","text":"*Tap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_76","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_05_s_76","text":"The director lightly taps his chest with his fist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_77","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_05_s_77","text":"Because it gives you courage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_78","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_05_s_78","text":