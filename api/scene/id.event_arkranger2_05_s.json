"bgm":null,"movie":null,"shown":["drake_p","laplace_p","maxwell_p"],"affinity":null},{"id":"event_arkranger2_05_s_105","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_105","text":"What in the world is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_106","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_05_s_106","text":"A robot! It's a robot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_107","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_05_s_107","text":"A robot has come to help us dole out justice!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_108","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_05_s_108","text":"Technically, we're robots too in a certain sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_109","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_109","text":"Did Missilis build that...? No, there's no way Missilis would do something so insane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_110","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_110","text":"Then Elysion? No... They wouldn't build a bipedal combat unit. A tank, maybe, but not something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_111","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_111","text":"Tetra... probably doesn't have the tech.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_112","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_112","text":"What is that thing...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_113","type":"Speech","speaker":"black_op_l","key":"Locale_MainScenario:event_arkranger2_05_s_113","text":"Matis, can you hear me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["black_op_l"],"affinity":null},{"id":"event_arkranger2_05_s_114","type":"Speech","speaker":"black_op_l","key":"Locale_MainScenario:event_arkranger2_05_s_114","text":"This is Ark Ranger Black.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_115","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_05_s_115","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_116","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_116","text":"Ark Ranger Black...? As in *the* Ark Ranger Black?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_117","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_05_s_117","text":"Those jerks who harass villains every chance they get? I don't like them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_118","type":"Speech","speaker":"black_op_l","key":"Locale_MainScenario:event_arkranger2_05_s_118","text":"I will be joining Operation Crimson Sky with Ark Leon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_119","type":"Speech","speaker":"black_op_l","key":"Locale_MainScenario:event_arkranger2_05_s_119","text":"It's an honor to fight alongside the heroes I've always admired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_120","type":"Speech","speaker":"black_op_l","key":"Locale_MainScenario:event_arkranger2_05_s_120","text":"I'll do my best not to get in your way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_121","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_121","text":"Huh... I don't know how Tetra managed to build something like that, but thanks for coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_122","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_05_s_122","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_123","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_123","text":"If you're thinking of shouting or doing anything else that would startle me, please don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_124","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_05_s_124","text":"We're counting on you, Ark Ranger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_125","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_05_s_125","text":"From one hero to another, let's give it everything we've got.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_126","type":"Speech","speaker":"black_op_l","key":"Locale_MainScenario:event_arkranger2_05_s_126","text":"You bet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_127","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_127","text":"... What happened to you? Did you get hit in the head or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_128","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_05_s_128","text":"I'd kindly ask that you refrain from any remarks unbecoming of a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_129","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_129","text":"Oh, I see. So now you're trying to act cool in front of another hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_130","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_05_s_130","text":"Get lost! We don't need any more heroes here! What we need is more villains!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_131","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_05_s_131","text":"You definitely sustained a head injury at some point. We just don't know when...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_132","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_05_s_132","text":"Ark Leon and Matis begin their battle against the incoming wave of Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}