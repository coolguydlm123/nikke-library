y","key":"Locale_MainScenario:event_arkranger2_05_s_38","text":"Agh! I should've updated my will...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_39","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_05_s_39","text":"Haha, fulfilling one's dream is très important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_40","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_05_s_40","text":"Er... there is something I've been wondering, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_41","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_05_s_41","text":"Allez, do tell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_42","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_05_s_42","text":"H-how did you get Enikk to approve the construction of an Ark Machine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_43","type":"Speech","speaker":"trony","key":"Locale_MainScenario:event_arkranger2_05_s_43","text":"N-not that I want to build one myself, of course. I'm just curious...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_05_s_44","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_arkranger2_05_s_44","text":"No autorisation was granted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null