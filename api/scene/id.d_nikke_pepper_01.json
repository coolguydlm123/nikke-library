,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_28","type":"Speech","speaker":"unknown","key":"Locale_NikkeEpisode:d_nikke_pepper_01_28","text":"... Don't mind them! Go follow your heart!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_29","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_29","text":"Non... nonsense!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_30","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_01_30","text":"That's Pepper's voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_31","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_01_31","text":"I'm still sleepy, but it's impossible to fall asleep right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_32","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_01_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_33","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_01_33","text":"I get up and head to the hallway.","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":null,"movie":null,"shown":["pepper"],"affinity":null},{"id":"d_nikke_pepper_01_34","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_01_34","text":"Pepper is talking to a redheaded girl in a hospital gown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_35","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_35","text":"Just take another physical exam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_languor","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_36","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_36","text":"You will be much better after the operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_37","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_37","text":"Oh, come on! Like I said, if you follow your heart, I will take the exam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_38","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_38","text":"Why do you keep telling me to fall in love...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_39","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_39","text":"Be honest. You have never fallen in love with anyone, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_40","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_40","text":"No! That's not...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_41","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_41","text":"Not what? You always stay in the hospital, day in and day out. You basically live here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_42","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_42","text":"I just want to see you fall in love with someone before I die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_43","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_43","text":"Don't say that. I won't allow it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_44","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_44","text":"All right. I won't say it again. But, you really do have to find a boyfriend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_45","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_45","text":"When you do, I'll take the exam without making a peep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_46","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_46","text":"Huh... now you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_47","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_01_47","text":"Pepper and I lock eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_48","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_48","text":"Ah... right. I heard that you were hospitalized!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_49","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_49","text":"Pepper?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_50","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_50","text":"I see. Go back to your ward and wait for me there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_51","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_51","text":"I will go find one right now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_52","type":"Speech","speaker":"orangegirl","key":"Locale_NikkeEpisode:d_nikke_pepper_01_52","text":"Huh? Right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_53","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_01_53","text":"Pepper walks to me, muttering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_01_54","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_01_54","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":