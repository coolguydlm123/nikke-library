ue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_7","text":"Day or night, she just keeps playing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_8","text":"... I really want to sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_9","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_9","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_10","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_10","text":"*Creak, creeeak*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_12","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_12","text":"*Knock, knock*","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_13","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_13","text":"Julia?","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["julia"],"affinity":null},{"id":"d_nikke_julia_02_14","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_14","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_15","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_15","text":"Conductor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_16","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_16","text":"Ah... it seems my wish has finally found its way to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_17","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_17","text":"Your wish?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_18","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_18","text":"Did you come because you heard my heartfelt wish for someone to come?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_19","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_19","text":"I picked up on the sound waves you sent and came over.","jump":"d_nikke_julia_02_21","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_20","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_20","text":"I received a report, so I came over.","jump":"d_nikke_julia_02_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_21","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_21","text":"Sound waves?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_22","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_22","text":"But... my violin was silent...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_23","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_23","text":"Oh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_24","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_24","text":"Do you mean the note F?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_25","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_25","text":"Was I playing it again and again, like an echo that refused to fade?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_26","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_26","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_27","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_27","text":"Then...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_28","text":"... You were playing so loudly that it was really bothering us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_29","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_29","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_30","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_30","text":"So to you, my music was nothing more than noise.","jump":"d_nikke_julia_02_40","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_31","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_31","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_32","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_32","text":"Yet another... complaint...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_33","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_34","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_34","text":"I understand now. My music...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_35","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_35","text":"seems to be a melody that invites complaints.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_36","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_36","text":"Perhaps I should tell my mentor that from now on, we could use it to uncover those who stray down the path of evil...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_37","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_37","text":"No, that's not it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_38","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_38","text":"... We only reported it because the noise was bothering us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_39","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_39","text":"Noise...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_40","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_41","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_41","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_42","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_42","text":"To others, my music was merely noise...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_43","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_43","text":"And I never even knew... I held onto the futile wish that someone, anyone, might hear me play...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_44","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_44","text":"It is as lamentable as the falling leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_45","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_45","text":"I don't think the music is the problem. It's more when you're playing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_46","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_46","text":"My mentor once told me this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_47","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_47","text":"My playing may sound good, but that doesn't make it good music.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_48","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_48","text":"It may be pleasant to listen to, but it doesn't move the heart...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_49","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_49","text":"And music like that... is nothing more than noise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_50","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_51","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_51","text":"Conductor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_52","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_52","text":"I don't know where my soul and bones have gone...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_53","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_53","text":"Why haven't they returned to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_54","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_54","text":"Is it that they don't like the instrument I hold?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_55","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_55","text":"Or perhaps the score I'm playing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_56","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_56","text":"Or...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_57","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_57","text":"perhaps my soul and bones were never there to begin with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_58","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_59","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_59","text":"I was not created to play music,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_60","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_60","text":"but to record it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_61","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_61","text":"Perhaps that is why I lack the heart and bones of a performer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_62","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_62","text":"You were made to record music?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_63","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_63","text":"Yes, I was originally created to record the music of the surface and how it was performed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_64","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_64","text":"so that when the war was over, it could be passed down to future generations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_65","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_65","text":"But... their expectations were not to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_66","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_66","text":"Like weeds in the wilderness, music survived on its own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_67","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_67","text":"Even amid that brutal war, people continued to enjoy and love music.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_68","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_68","text":"It survived well enough that there was no longer any need to preserve the music of the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_69","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_69","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_70","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_70","text":"So I was deployed to the surface reclamation operation.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_71","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_71","text":"From then on, I lived not for music, but simply to survive, until one day...","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_72","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_72","text":"My mentor, Mustang, came to find me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mustang"],"affinity":null},{"id":"d_nikke_julia_02_73","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_73","text":"He said he couldn't leave a Nikke who knew music to waste, and took me with him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_74","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_74","text":"That was when I was first given the name of a musician.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_75","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_75","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_76","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_76","text":"But... I don't know if I can still call myself a musician.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_77","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_77","text":"My mentor must be terribly disappointed in me, like a vegetable Splendamin left to wilt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_78","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_78","text":"He may even be regretting it and wondering, \"Was I mistaken about her...?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_79","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_79","text":"I'm sure that's not the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_80","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_80","text":"How so...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_81","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_81","text":"Didn't Mustang say your music has no soul?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_82","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_82","text":"Yes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_83","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_83","text":"In that case, you must have had it at some point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":