,"jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_92","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_92","text":"How could you say something so cruel...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_93","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_93","text":"When you get too worked up, you stop seeing what's right in front of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_94","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_94","text":"Even what should be seen slips from sight...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_95","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02_95","text":"That must be why you can't find it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_96","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_97","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:d_nikke_julia_02_97","text":"If my violin and I part ways like lovers after a quarrel, will we find our way back to each other?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_julia_02_98","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_julia_02