{"id":"d_counseling_avistar_01","cat":"counsel","group":{"id":"char5171","label":"Avistar"},"label":"Advising Avistar: 01","stage":null,"prev":null,"next":"d_counseling_avistar_02","speakers":{"avistar":"Avistar"},"icons":{"avistar":"si_c441_00_s"},"lines":[{"id":"d_counseling_avistar_01_1","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_1","text":"Person of Interest...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["avistar"],"affinity":"_0"},{"id":"d_counseling_avistar_01_2","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_2","text":"Which do you think takes precedence: reason or emotion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_01_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_avistar_01_3","text":"Reason.","jump":"d_counseling_avistar_01_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_avistar_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_avistar_01_4","text":"Emotion.","jump":"d_counseling_avistar_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_avistar_01_5","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_5","text":"Of course, it's a nearly impossible choice to make.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_01_6","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_6","text":"But if pressed to choose one, I'd also say reason is more important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_01_7","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_7","text":"If you place too much importance on emotion, you might get swept up in your feelings, which could lead to mistakes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_01_8","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_8","text":"... It's happened to me before.","jump":"d_counseling_avistar_01_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_01_9","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_9","text":"Of course emotion is not to be overlooked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_01_10","type":"Speech","speaker":"avistar","key":"Locale_Counseling:d_counseling_avistar_01_10","text":"But wouldn't emotion without reason be little more than instinct?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_avistar_01_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_avistar_01_11","text":"Avistar and I have a conversation about the balance between reason and emotion.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}