nt_ce009_2_02_s_12","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_ce009_2_02_s_12","text":"Long ago, machines known as Raptures invaded our world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_13","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_ce009_2_02_s_13","text":"Humanity fought back desperately, but it wasn't enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_14","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_ce009_2_02_s_14","text":"In the end, we had no choice but to build the Ark and take refuge within it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_15","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_02_s_15","text":"Raptures...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_16","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_02_s_16","text":"I have a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_17","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_02_s_17","text":"If the area inhabited by humans in this world is comparable to that of our own,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_18","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_02_s_18","text":"then the original human population doesn't match the number of people