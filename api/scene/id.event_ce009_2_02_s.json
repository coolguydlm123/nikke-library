l,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_46","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_02_s_46","text":"Quency stops walking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_47","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_2_02_s_47","text":"We're here. This is it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_48","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_02_s_48","text":"The narrow passage leading to the Outer Rim is blocked by spiderwebs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_49","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_02_s_49","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_50","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_02_s_50","text":"Oho, the webs here are way flimsier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_ce009_spot_action-ambush","movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_51","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_02_s_51","text":"I bet we can break through 'em.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_52","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_2_02_s_52","text":"It's not just here. Most of this side has fewer webs than the partition area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_53","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_02_s_53","text":"I wonder why that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_54","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_ce009_2_02_s_54","text":"... The man said he controls his webs as though they were extensions of himself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_55","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_ce009_2_02_s_55","text":"It's possible his influence only extends as far as his consciousness can reach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_56","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_2_02_s_56","text":"If he really is gathering his strength, he may not be able to keep tabs on everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_57","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_2_02_s_57","text":"What's that door over there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_02_s_58","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_02_s_58","text":"Mona points to a heavy-looking door that's firmly shut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"