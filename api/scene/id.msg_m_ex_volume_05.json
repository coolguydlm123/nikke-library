{"id":"msg_m_ex_volume_05","cat":"messenger","group":{"id":"room_volume","label":"Volume · Nikke"},"label":"5. Hey!","stage":null,"prev":"msg_m_ex_volume_04","next":"msg_m_ex_volume_06","speakers":{"volume":"Volume"},"icons":{"volume":"si_c431_00_s"},"lines":[{"id":"m_ex_volume_05_1","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_1","text":"Hey!","jump":null},{"id":"m_ex_volume_05_2","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_2","text":"Manager.","jump":null},{"id":"m_ex_volume_05_3","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_3","text":"I need your opinion on something,","jump":null},{"id":"m_ex_volume_05_4","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_4","text":"and I want you to be honest.","jump":null},{"id":"m_ex_volume_05_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_5","text":"What's up?","jump":null},{"id":"m_ex_volume_05_6","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_6","text":"When it comes to writing songs,","jump":null},{"id":"m_ex_volume_05_7","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_7","text":"lyrics and beats","jump":null},{"id":"m_ex_volume_05_8","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_8","text":"that are impactful and touch your heart are imperative,","jump":null},{"id":"m_ex_volume_05_9","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_9","text":"but as a rapper,","jump":null},{"id":"m_ex_volume_05_10","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_10","text":"it's all about DICTION!","jump":null},{"id":"m_ex_volume_05_11","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_11","text":"Personally, I think vocalization and intonation","jump":null},{"id":"m_ex_volume_05_12","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_12","text":"are the most important parts.","jump":null},{"id":"m_ex_volume_05_13","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_13","text":"In a way, your body is like a musical instrument.","jump":null},{"id":"m_ex_volume_05_14","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_14","text":"Are you following me so far?","jump":null},{"id":"m_ex_volume_05_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_15","text":"Yep.","jump":"m_ex_volume_05_17"},{"id":"m_ex_volume_05_16","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_16","text":"Gotcha!","jump":"m_ex_volume_05_20"},{"id":"m_ex_volume_05_17","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_17","text":"C'mon!","jump":null},{"id":"m_ex_volume_05_18","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_18","text":"If you're gonna be my manager,","jump":null},{"id":"m_ex_volume_05_19","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_19","text":"you've gotta respond in style.","jump":"m_ex_volume_05_22"},{"id":"m_ex_volume_05_20","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_20","text":"Very nice!","jump":null},{"id":"m_ex_volume_05_21","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_21","text":"Your responses are much cooler than before.","jump":"m_ex_volume_05_22"},{"id":"m_ex_volume_05_22","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_22","text":"I'm sure Noise and Aria do the same thing,","jump":null},{"id":"m_ex_volume_05_23","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_23","text":"and view their bodies as musical instruments.","jump":null},{"id":"m_ex_volume_05_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_24","text":"Most likely, because they're both singers.","jump":null},{"id":"m_ex_volume_05_25","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_25","text":"However!","jump":null},{"id":"m_ex_volume_05_26","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_26","text":"Even a lone instrument without any accompanying music","jump":null},{"id":"m_ex_volume_05_27","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_27","text":"can express a full range of emotions.","jump":null},{"id":"m_ex_volume_05_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_28","text":"Like a solo musician?","jump":null},{"id":"m_ex_volume_05_29","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_29","text":"Precisely!","jump":null},{"id":"m_ex_volume_05_30","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_30","text":"Even for a soloist,","jump":null},{"id":"m_ex_volume_05_31","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_31","text":"whether they're performing with a piano or violin,","jump":null},{"id":"m_ex_volume_05_32","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_32","text":"the finest performers","jump":null},{"id":"m_ex_volume_05_33","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_33","text":"can make you feel overwhelmed with emotion","jump":null},{"id":"m_ex_volume_05_34","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_34","text":"all at the same time.","jump":null},{"id":"m_ex_volume_05_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_35","text":"Right, right.","jump":null},{"id":"m_ex_volume_05_36","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_36","text":"If a rapper like me, especially one at the top of their career,","jump":null},{"id":"m_ex_volume_05_37","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_37","text":"could also play an instrument,","jump":null},{"id":"m_ex_volume_05_38","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_38","text":"it'd be perfect!","jump":null},{"id":"m_ex_volume_05_39","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_39","text":"It couldn't be any more perfect!","jump":null},{"id":"m_ex_volume_05_40","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_40","text":"With that being said,","jump":null},{"id":"m_ex_volume_05_41","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_41","text":"which instrument do you think I should learn?","jump":null},{"id":"m_ex_volume_05_42","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_42","text":"The trumpet.","jump":"m_ex_volume_05_44"},{"id":"m_ex_volume_05_43","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_43","text":"The flute.","jump":"m_ex_volume_05_44"},{"id":"m_ex_volume_05_44","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_44","text":"Nooooooo!!","jump":null},{"id":"m_ex_volume_05_45","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_45","text":"Manager.","jump":null},{"id":"m_ex_volume_05_46","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_46","text":"You want me, a rapper, to use an instrument that would block my mouth?","jump":null},{"id":"m_ex_volume_05_47","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_47","text":"Have you gone insane in the membrane?","jump":null},{"id":"m_ex_volume_05_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_48","text":"Then what about beatboxing?","jump":null},{"id":"m_ex_volume_05_49","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_49","text":"What?","jump":null},{"id":"m_ex_volume_05_50","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_50","text":"Beatboxing?","jump":null},{"id":"m_ex_volume_05_51","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_51","text":"I can already do that to some degree.","jump":null},{"id":"m_ex_volume_05_52","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_52","text":"It'd never hurt to get better at it.","jump":null},{"id":"m_ex_volume_05_53","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_53","text":"Hmm...","jump":null},{"id":"m_ex_volume_05_54","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_54","text":"Let me see...","jump":null},{"id":"m_ex_volume_05_55","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_55","text":"Rather than learning one instrument,","jump":null},{"id":"m_ex_volume_05_56","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_56","text":"it would be more appropriate for me to utilize a skill","jump":null},{"id":"m_ex_volume_05_57","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_57","text":"where I can mimic the sounds of all sorts of instruments.","jump":null},{"id":"m_ex_volume_05_58","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_58","text":"You can take this chance to master it.","jump":null},{"id":"m_ex_volume_05_59","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_59","text":"All right!","jump":null},{"id":"m_ex_volume_05_60","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_60","text":"Who knows, if we're lucky,","jump":null},{"id":"m_ex_volume_05_61","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_61","text":"we could end up making something that we could put on the next album.","jump":null},{"id":"m_ex_volume_05_62","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_volume_05_62","text":"I'm sure your fans would love that.","jump":null},{"id":"m_ex_volume_05_63","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_63","text":"This is brilliant!","jump":null},{"id":"m_ex_volume_05_64","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_64","text":"Also,","jump":null},{"id":"m_ex_volume_05_65","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_65","text":"I've been thinking that Honey sounds better than Manager,","jump":null},{"id":"m_ex_volume_05_66","type":"Speech","speaker":"volume","key":"Locale_SuddenMessage:m_ex_volume_05_66","text":"so thanks, Honey!","jump":null}],"chat":true}