{"id":"msg_m_ex_bunnyx777_05","cat":"messenger","group":{"id":"room_bunnyx777","label":"Temporary Bunny Group · Group"},"label":"4. Highroller,","stage":null,"prev":"msg_m_ex_bunnyx777_04","next":"msg_m_ex_bunnyx777_06","speakers":{"rouge":"Rouge","mustang":"Mustang","sullenman":"Sullen Man","blanc":"Blanc","noir":"Noir"},"icons":{"rouge":"si_c272_00_s","mustang":"si_c902_00_s","blanc":"si_c270_00_s","noir":"si_c271_00_s"},"lines":[{"id":"msg_m_ex_bunnyx777_05_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 101610112 · After Temporary Bunny Group chat 3. Pit Boss!!","key":null},{"id":"m_ex_bunnyx777_05_1","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_1","text":"Highroller,","jump":null},{"id":"m_ex_bunnyx777_05_2","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_2","text":"Mustang wants to tell us something.","jump":null},{"id":"m_ex_bunnyx777_05_3","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_3","text":"I'll invite him to the group.","jump":null},{"id":"m_ex_bunnyx777_05_4","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_4","text":"Rouge has invited Mustang to join the group.","jump":null},{"id":"m_ex_bunnyx777_05_5","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_5","text":"EEEntertainment!","jump":null},{"id":"m_ex_bunnyx777_05_6","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_6","text":"Désolé! Sorry for the sudden irruption.","jump":null},{"id":"m_ex_bunnyx777_05_7","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_7","text":"I heard about this blah group and I have something to say to vous,","jump":null},{"id":"m_ex_bunnyx777_05_8","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_8","text":"so I asked Rouge to add me.","jump":null},{"id":"m_ex_bunnyx777_05_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_9","text":"Go on.","jump":null},{"id":"m_ex_bunnyx777_05_10","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_10","text":"It's about l' homme I took away.","jump":null},{"id":"m_ex_bunnyx777_05_11","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_11","text":"After some discussion, we décidé to have him work at Coin Rush on a volunteer basis.","jump":null},{"id":"m_ex_bunnyx777_05_12","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_12","text":"However,","jump":null},{"id":"m_ex_bunnyx777_05_13","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_13","text":"erm...","jump":null},{"id":"m_ex_bunnyx777_05_14","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_14","text":"Actually, it would be better for him to tell you.","jump":null},{"id":"m_ex_bunnyx777_05_15","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_15","text":"Mustang has invited Sullen Man to join the group.","jump":null},{"id":"m_ex_bunnyx777_05_16","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_16","text":"H-hey,","jump":null},{"id":"m_ex_bunnyx777_05_17","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_17","text":"everyone.","jump":null},{"id":"m_ex_bunnyx777_05_18","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_18","text":"How's everybody doing?","jump":null},{"id":"m_ex_bunnyx777_05_19","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_19","text":"Hey!","jump":null},{"id":"m_ex_bunnyx777_05_20","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_20","text":"Long time no see!","jump":null},{"id":"m_ex_bunnyx777_05_21","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_21","text":"We're great, thanks.","jump":null},{"id":"m_ex_bunnyx777_05_22","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_22","text":"Glad to hear that.","jump":null},{"id":"m_ex_bunnyx777_05_23","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_23","text":"So...","jump":null},{"id":"m_ex_bunnyx777_05_24","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_24","text":"First of all, I want to apologize.","jump":null},{"id":"m_ex_bunnyx777_05_25","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_25","text":"Especially to {AccountData.NickName}.","jump":null},{"id":"m_ex_bunnyx777_05_26","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_26","text":"I'm sorry for losing my temper and acting so suspiciously.","jump":null},{"id":"m_ex_bunnyx777_05_27","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_27","text":"I never got the chance to talk to you on the day of the event.","jump":null},{"id":"m_ex_bunnyx777_05_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_28","text":"It's okay.","jump":null},{"id":"m_ex_bunnyx777_05_29","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_29","text":"I'd like to thank everyone else who's in here as well.","jump":null},{"id":"m_ex_bunnyx777_05_30","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_30","text":"I'm a much happier person now,","jump":null},{"id":"m_ex_bunnyx777_05_31","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_31","text":"and it's thanks to you all.","jump":null},{"id":"m_ex_bunnyx777_05_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_32","text":"You helped yourself. We just gave you a little push.","jump":null},{"id":"m_ex_bunnyx777_05_33","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_33","text":"Right!","jump":null},{"id":"m_ex_bunnyx777_05_34","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_34","text":"It doesn't matter how much luck we imparted to you,","jump":null},{"id":"m_ex_bunnyx777_05_35","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_35","text":"none of it would do anything if you didn't want to change.","jump":null},{"id":"m_ex_bunnyx777_05_36","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_36","text":"You don't understand.","jump":null},{"id":"m_ex_bunnyx777_05_37","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_37","text":"That was the first time anyone has given me any form of encouragement.","jump":null},{"id":"m_ex_bunnyx777_05_38","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_38","text":"I never knew how to take the first step towards self-improvement, so I always stayed put.","jump":null},{"id":"m_ex_bunnyx777_05_39","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_39","text":"So once again,","jump":null},{"id":"m_ex_bunnyx777_05_40","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_40","text":"thank you, everyone.","jump":null},{"id":"m_ex_bunnyx777_05_41","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_41","text":"He's recently started his internship here at the casino. C'est magnifique!","jump":null},{"id":"m_ex_bunnyx777_05_42","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_42","text":"He's a happy fellow, and I've come out the other end with a talented new employee. C'est fantastique!","jump":null},{"id":"m_ex_bunnyx777_05_43","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_43","text":"That's all I have to say.","jump":null},{"id":"m_ex_bunnyx777_05_44","type":"Speech","speaker":"mustang","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_44","text":"See you, guys!","jump":null},{"id":"m_ex_bunnyx777_05_45","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_45","text":"Mustang left the group.","jump":null},{"id":"m_ex_bunnyx777_05_46","type":"Speech","speaker":"sullenman","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_46","text":"Have a wonderful day, everyone.","jump":null},{"id":"m_ex_bunnyx777_05_47","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_47","text":"Sullen Man left the group.","jump":null},{"id":"m_ex_bunnyx777_05_48","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_48","text":"Aww, isn't that wonderful?","jump":null},{"id":"m_ex_bunnyx777_05_49","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_49","text":"I haven't been this happy in a long time.","jump":null},{"id":"m_ex_bunnyx777_05_50","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_50","text":"Aww...","jump":null},{"id":"m_ex_bunnyx777_05_51","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_51","text":"I'm getting emotional...","jump":null},{"id":"m_ex_bunnyx777_05_52","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_52","text":"If you ask me, he's the real winner here.","jump":null},{"id":"m_ex_bunnyx777_05_53","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_53","text":"He's sure to succeed.","jump":null},{"id":"m_ex_bunnyx777_05_54","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_54","text":"Noir!","jump":null},{"id":"m_ex_bunnyx777_05_55","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_55","text":"We've gotta put on one heck of a show tonight!","jump":null},{"id":"m_ex_bunnyx777_05_56","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_56","text":"You got it!","jump":null},{"id":"m_ex_bunnyx777_05_57","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_57","text":"I'm all riled up now! In a good way!","jump":null},{"id":"m_ex_bunnyx777_05_58","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_bunnyx777_05_58","text":"Just don't overdo it and sprain something.","jump":null},{"id":"m_ex_bunnyx777_05_59","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_59","text":"Sure thing.","jump":null},{"id":"m_ex_bunnyx777_05_60","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_bunnyx777_05_60","text":"Right!","jump":null}],"chat":true}