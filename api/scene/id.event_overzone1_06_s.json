ch","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_06_s_20","text":"I know how to skin a deer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_06_s_21","text":"You do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_22","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_06_s_22","text":"Yeah, I've roasted deer a couple times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_23","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_06_s_23","text":"It's not fine dining, but you can do a lot worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_24","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_06_s_24","text":"Oooh! How exciting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_25","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_06_s_25","text":"What happened out there, Snow White?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_26","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_06_s_26","text":"Sorry, I guess deer isn't really your style.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_27","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_06_s_27","text":"No, not that. I mean, how'd you keep lookout and capture this at the same time? Not that I'm complaining...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_28","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone1_06_s_28","text":"Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_29","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_06_s_29","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_30","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_06_s_30","text":"From now on, our goal is survival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_31","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_06_s_31","text":"Since the Ark has been unresponsive, we should proceed on the assumption that we will be operating without assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_32","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_06_s_32","text":"We should ensure that the guard post is kept secure at the very least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_06_s_33","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_06_s_33","text":