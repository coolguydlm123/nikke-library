{"id":"event_wisdomspring_02_s","cat":"event","group":{"id":"ev40068","label":"WISDOM SPRING"},"label":"Down Below: A","stage":null,"prev":"event_wisdomspring_01_e","next":"event_wisdomspring_02_e","speakers":{"ether":"Ether"},"icons":{"ether":"si_c291_00_s"},"lines":[{"id":"event_wisdomspring_02_s_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_1","text":"I follow Ether down the halls of the M.M.R. research lab.","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["ether"],"affinity":null},{"id":"event_wisdomspring_02_s_2","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_2","text":"*Sigh*... The elevator is so far away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_3","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_3","text":"Can't they do something about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_4","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_4","text":"It's so annoying having to walk this far every time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_5","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_5","text":"What was it called again, this place we're going to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_6","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_6","text":"The Deep Sector.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_7","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_7","text":"It's also referred to as the Level E Zone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_8","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_8","text":"but to keep things simple, we typically call it the Deep Sector.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_9","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_9","text":"Somewhat frustratingly, it's divided into two separate sections. That's how big it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_10","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_10","text":"And it's underground as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_11","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_11","text":"Yes. Deep underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_12","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_12","text":"All the labs at M.M.R. are subterranean,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_13","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_13","text":"but the Deep Sector is particularly far down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_14","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_14","text":"You can only get there using a special elevator,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_15","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_15","text":"which means we have to schlep all the way over here every single time. It's such a pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_16","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_16","text":"You said all the labs at M.M.R. are underground?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_17","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_17","text":"Don't you remember?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_18","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_18","text":"You came to my lab last time because you caught something while on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_19","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_19","text":"Refresh my memory.","jump":"event_wisdomspring_02_s_21","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_20","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_20","text":"I remember.","jump":"event_wisdomspring_02_s_26","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_21","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_21","text":"You don't remember?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_22","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_22","text":"Well, I guess that's not entirely unreasonable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_23","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_23","text":"When people catch a disease from the surface, they need to come to the M.M.R. labs for treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_24","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_24","text":"Last time, you caught something like a cold on the surface, and I treated you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_25","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_25","text":"That was all done in one of our underground labs.","jump":"event_wisdomspring_02_s_29","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_26","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_26","text":"You have a good memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_27","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_27","text":"Thank goodness. I was feeling too lazy to explain everything in detail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_28","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_28","text":"Anyway, you caught something like a cold, and I treated you at my lab, which is in fact underground.","jump":"event_wisdomspring_02_s_29","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_29","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_29","text":"I realize how strange this all sounds. The Ark is already underground, and now we're talking about more things under that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_30","text":"Why didn't Missilis build the labs above ground?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_31","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_31","text":"Because this way,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_32","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_32","text":"the test subjects won't be able to escape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_33","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_33","text":"!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_34","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_34","text":"Relax. That was a joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_35","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_35","text":"The answer should be obvious. It's because what we do is highly secretive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_36","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_36","text":"There's a reason people always talk about secrets being buried underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_37","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_37","text":"The M.M.R. research lab is a prime example of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_38","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_38","text":"All of the Ark's secrets are sealed away, buried deep under the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_39","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_39","text":"Is that why you're forbidden from communicating with the outside while you're in there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_40","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_40","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_41","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_41","text":"That place is full of top-secret stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_42","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_42","text":"You never know when or how a secret might leak,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_43","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_43","text":"so any and all communications are restricted while inside the Deep Sector.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_44","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_44","text":"That's why Mana is currently incommunicado.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_45","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_45","text":"This place sounds awfully important. Is it all right for me to be going there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_46","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_46","text":"Sure, why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_47","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_47","text":"Your reputation precedes you. You've encountered everything from Pilgrims to Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_48","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_48","text":"Besides, it's not like you're going to be running around opening all the lab doors. It'll be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_49","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_49","text":"I still feel a bit uneasy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_50","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_50","text":"So you don't want to meet Mana?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_51","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_51","text":"We don't have to if you don't want to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_52","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_53","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_53","text":"Don't worry, and just stay close to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_54","type":"Speech","speaker":"ether","key":"Locale_SubScenario:event_wisdomspring_02_s_54","text":"You'll get lost if you space out while we're in there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wisdomspring_02_s_55","type":"Self","speaker":null,"key":"Locale_SubScenario:event_wisdomspring_02_s_55","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}