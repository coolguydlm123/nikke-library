{"id":"d_counseling_neon_13","cat":"counsel","group":{"id":"char3002","label":"Neon"},"label":"Advising Neon: 13","stage":null,"prev":"d_counseling_neon_12","next":"d_counseling_neon_14","speakers":{"neon":"Neon"},"icons":{"neon":"si_c011_00_s"},"lines":[{"id":"d_counseling_neon_13_1","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_13_1","text":"Have you heard about the ghost story involving the fridge in our dorm?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["neon"],"affinity":"_0"},{"id":"d_counseling_neon_13_2","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_13_2","text":"Once a week, on the third shelf from the bottom of the fridge...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_13_3","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_13_3","text":"Some truly ghastly food mysteriously appears. People say it's made by dead Nikkes seeking revenge on the living.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_13_4","text":"Are you sure they're not just butchered recipes?","jump":"d_counseling_neon_13_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_neon_13_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_13_5","text":"Have you tried any of them?","jump":"d_counseling_neon_13_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_neon_13_6","type":"Speech","speaker":"neon","key":"Locale_Couns