{"id":"msg_m_ex_k_02","cat":"messenger","group":{"id":"room_k","label":"K · Nikke"},"label":"2. Seriously?","stage":null,"prev":"msg_m_ex_k_01","next":"msg_m_ex_k_03","speakers":{"k":"K"},"icons":{"k":"si_c041_00_s"},"lines":[{"id":"m_ex_k_02_1","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_1","text":"Seriously?","jump":null},{"id":"m_ex_k_02_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_2","text":"Whoa!","jump":null},{"id":"m_ex_k_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_3","text":"Ms. K!","jump":null},{"id":"m_ex_k_02_4","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_4","text":"?","jump":null},{"id":"m_ex_k_02_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_5","text":"So, you are alive.","jump":null},{"id":"m_ex_k_02_6","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_6","text":"What are you on about?","jump":null},{"id":"m_ex_k_02_7","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_7","text":"Did you hit your head or what?","jump":null},{"id":"m_ex_k_02_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_8","text":"That's because you've been radio silent for a while.","jump":null},{"id":"m_ex_k_02_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_9","text":"Just checking in to see if you're still alive.","jump":null},{"id":"m_ex_k_02_10","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_10","text":"I'm very much alive.","jump":null},{"id":"m_ex_k_02_11","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_11","text":"Just doing my job.","jump":null},{"id":"m_ex_k_02_12","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_12","text":"After that reply, K sends no more messages.","jump":null},{"id":"m_ex_k_02_13","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_13","text":"...","jump":null},{"id":"m_ex_k_02_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_14","text":"That's it?","jump":null},{"id":"m_ex_k_02_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_15","text":"You're done chatting?","jump":null},{"id":"m_ex_k_02_16","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_16","text":"You confirmed that I wasn't dead, didn't you?","jump":null},{"id":"m_ex_k_02_17","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_17","text":"That's why I got in touch in the first place.","jump":null},{"id":"m_ex_k_02_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_18","text":"Sure,","jump":null},{"id":"m_ex_k_02_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_19","text":"but come on!","jump":null},{"id":"m_ex_k_02_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_20","text":"At least tell me what kind of work you're doing.","jump":null},{"id":"m_ex_k_02_21","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_21","text":"Apprehending bad guys and killing them.","jump":null},{"id":"m_ex_k_02_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_22","text":"How's it going?","jump":null},{"id":"m_ex_k_02_23","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_23","text":"Very well.","jump":null},{"id":"m_ex_k_02_24","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_24","text":"You're well aware","jump":null},{"id":"m_ex_k_02_25","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_25","text":"they just keep showing up endlessly, these damn criminals.","jump":null},{"id":"m_ex_k_02_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_26","text":"That they do.","jump":null},{"id":"m_ex_k_02_27","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_27","text":"You're not curious?","jump":null},{"id":"m_ex_k_02_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_28","text":"About what?","jump":null},{"id":"m_ex_k_02_29","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_29","text":"Like...","jump":null},{"id":"m_ex_k_02_30","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_30","text":"the kind of people I've apprehended.","jump":null},{"id":"m_ex_k_02_31","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_31","text":"Whether they're dead or alive.","jump":null},{"id":"m_ex_k_02_32","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_32","text":"After all, I'm under your command now.","jump":null},{"id":"m_ex_k_02_33","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_33","text":"Aren't you even a little curious about that?","jump":null},{"id":"m_ex_k_02_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_34","text":"Well, you're the expert on all that.","jump":null},{"id":"m_ex_k_02_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_35","text":"I trust you to handle it.","jump":null},{"id":"m_ex_k_02_36","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_36","text":"Really?","jump":null},{"id":"m_ex_k_02_37","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_37","text":"...","jump":null},{"id":"m_ex_k_02_38","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_38","text":"But what if I make the wrong call?","jump":null},{"id":"m_ex_k_02_39","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_39","text":"What if I end up killing someone who's innocent?","jump":null},{"id":"m_ex_k_02_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_40","text":"That won't happen.","jump":null},{"id":"m_ex_k_02_41","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_41","text":"Why not?","jump":null},{"id":"m_ex_k_02_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_42","text":"Because the K I know wouldn't let that happen.","jump":null},{"id":"m_ex_k_02_43","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_43","text":"Is that so?","jump":null},{"id":"m_ex_k_02_44","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_44","text":"Just when I was wondering if I should message again, K replies.","jump":null},{"id":"m_ex_k_02_45","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_45","text":"I'll send regular reports.","jump":null},{"id":"m_ex_k_02_46","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_46","text":"About once every two days.","jump":null},{"id":"m_ex_k_02_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_02_47","text":"Sounds good.","jump":null},{"id":"m_ex_k_02_48","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_02_48","text":"I'm off then.","jump":null}],"chat":true}