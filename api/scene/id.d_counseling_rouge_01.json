{"id":"d_counseling_rouge_01","cat":"counsel","group":{"id":"char5049","label":"Rouge"},"label":"Advising Rouge: 01","stage":null,"prev":null,"next":"d_counseling_rouge_02","speakers":{"rouge":"Rouge"},"icons":{"rouge":"si_c272_00_s"},"lines":[{"id":"d_counseling_rouge_01_1","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_01_1","text":"A few days ago, I played a game with someone who was completely new to it,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rouge"],"affinity":"_0"},{"id":"d_counseling_rouge_01_2","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_01_2","text":"but I ended up losing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_01_3","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_01_3","text":"I don't understand what the problem could have been.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_01_4","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_01_4","text":"I'm sure I made all the right decisions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rouge_01_5","text":"Maybe you were just unlucky.","jump":"d_counseling_rouge_01_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rouge_01_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rouge_01_6","text":"Maybe your opponent had beginner's luck.","jump":"d_counseling_rouge_01_9","exit":