{"id":"event_miraclesnow1_prologue","cat":"event","group":{"id":"ev40003","label":"Miracle Snow"},"label":"Emergency Meeting","stage":null,"prev":null,"next":"event_miraclesnow1_01_s","speakers":{"andersen":"Andersen","enikk":"Enikk","ingrid":"Ingrid","mustang":"Mustang"},"icons":{"andersen":"si_c903_00_s","enikk":"si_c904_00_s","ingrid":"si_c900_00_s","mustang":"si_c902_00_s"},"lines":[{"id":"event_miraclesnow1_prologue_1","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_1","text":"Enikk, how many resources are currently available?","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":"bgm_inark","movie":null,"shown":["andersen","enikk","ingrid","mustang"],"affinity":null},{"id":"event_miraclesnow1_prologue_2","type":"Speech","speaker":"enikk","key":"Locale_SubScenario:event_miraclesnow1_prologue_2","text":"If limited to a radius of 2km, there are enough resources to last for 2 weeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_3","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_3","text":"Is that it? I thought there'd be some leeway, since it's winter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_4","type":"Speech","speaker":"enikk","key":"Locale_SubScenario:event_miraclesnow1_prologue_4","text":"Drinking water consumption has been reduced, but we have been using a lot of water for washing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_5","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_5","text":"It's because of Missilis. They have been so gung-ho about selling these new boiler systems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_6","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_6","text":"With that small a radius and a short time span, we're bound to get complaints.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_7","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_7","text":"So are we just going to cancel it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_8","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_8","text":"There's not much else we can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_9","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_10","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_10","text":"People are going to be upset.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_11","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_miraclesnow1_prologue_11","text":"Don't be so glum, Ingrid!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_12","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_miraclesnow1_prologue_12","text":"I have spied, with my little eyes, a grand location!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_13","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_13","text":"What location?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_14","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_miraclesnow1_prologue_14","text":"Voilà!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_15","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_miraclesnow1_prologue_15","text":"Mustang points at a place on the map.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_16","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_16","text":"That... just might work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_17","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_17","text":"It's fair to everyone as well, so we shouldn't hear any complaints about unequal treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_18","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_18","text":"Isn't that outside the Ark's jurisdiction, though? Will it not be difficult to control?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_19","type":"Speech","speaker":"enikk","key":"Locale_SubScenario:event_miraclesnow1_prologue_19","text":"I don't see any potential issues. This area utilizes the same weather system as the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_20","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_miraclesnow1_prologue_20","text":"Magnifique!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_21","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_21","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_22","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_22","text":"Enikk. Proceed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_23","type":"Speech","speaker":"enikk","key":"Locale_SubScenario:event_miraclesnow1_prologue_23","text":"Yes, sir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_24","type":"Speech","speaker":"enikk","key":"Locale_SubScenario:event_miraclesnow1_prologue_24","text":"For the next two weeks, artificial snow will be implemented within the confines of the Amusement Park at the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_25","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_25","text":"Very good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_26","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_26","text":"... Has it really been 15 years?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_27","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_27","text":"Mustang, start spreading the word. For the next 2 weeks, the amusement park is open to the public.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_28","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_28","text":"I'd appreciate it if you could also oversee the Amusement Park in the interim and ensure it runs smoothly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_29","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_miraclesnow1_prologue_29","text":"Oui oui!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_30","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_30","text":"Ingrid, you're responsible for crowd management and safety concerning the elevator leading to the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_31","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_31","text":"Also, assign more troops for us to safely wipe out all Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_32","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_miraclesnow1_prologue_32","text":"Leave it to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_33","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_33","text":"Shall we make a move then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_34","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_miraclesnow1_prologue_34","text":"Andersen, Ingrid, and Mustang take their leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_35","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_35","text":"Oh, Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_36","type":"Speech","speaker":"enikk","key":"Locale_SubScenario:event_miraclesnow1_prologue_36","text":"Yes, sir?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_prologue_37","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_miraclesnow1_prologue_37