ull},{"id":"d_ex_court_04_83","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_83","text":"Let me have a look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_84","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_84","text":"Hmm... Hey, I know this vendor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_85","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_85","text":"Viper points at a food vendor on the financial statement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_86","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_86","text":"It seems like they've been doing a good job, but I'm willing to bet they've been skimming a bit off the top.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_87","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_87","text":"Our squad can attest to the quality of their work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_88","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_88","text":"Oh my goodness, look at this clothing supply company!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_89","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_89","text":"They're infamous for using low-quality fabric to save on costs. Let's investigate them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_90","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_90","text":"Do you think there might be more companies like them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_91","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_91","text":"Maybe not at first, but once we start digging, I'm sure more will pop up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_92","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_92","text":"To greedy little blood suckers like these companies, government funding is too sweet to resist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_93","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_93","text":"They're like bloated rats eating everything in sight, and accidentally ingesting rat poison while they're at it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_94","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_94","text":"This might take some time, perhaps we should move somewhere else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_95","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_95","text":"I'll prepare some light snacks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_96","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_96","text":"Really? Could I have a Monc Blanc from YONG Bakery?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_97","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_97","text":"I'll take the Sweet & Cream Shortcake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_98","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_98","text":"Sorry... but I think those are a bit outside of my wheelhouse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_99","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_99","text":"No problem, I'll prepare us some snacks then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_100","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_100","text":"We can head towards our temporary offices in Rushae. There are plenty of great eateries in that area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_101","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_101","text":"I'm fine with anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_102","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_102","text":"Thank you, I'll make it up to you later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_103","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_103","text":"Don't worry about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_104","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_104","text":"Once we're done with our consultation, we can go try on some new clothes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_105","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_105","text":"I'm sure we'll find plenty of outfits that will look good on you, Helm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_106","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_106","text":"Oooh, count me in♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_107","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_107","text":"I'm starting to feel like I should find an excuse to bow out of this situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_108","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_108","text":"Well, in that case, I'll be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_109","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_109","text":"Hmm? Sweetie, where are you going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_110","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_110","text":"You're not trying to slink away, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_111","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_111","text":"C'mon, stay! The more the merrier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_112","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_112","text":"Besides, we haven't finished taking their advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_113","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_113","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_114","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_114","text":"After a few hours, we found ourselves in the temporary office in the Outpost.","jump":null,"exit":false,"enter":null,"bg":"GoodOffice","bgArt":"goodoffice","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_115","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_115","text":"Really?! I know that commander too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_116","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_116","text":"They didn't go missing. They were just in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_117","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_117","text":"Hey Helm, do you want to try some of this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_118","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_118","text":"Sure, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_119","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_119","text":"I just don't understand. Why give up everything that comes with being a commander and go to the Outer Rim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_120","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_120","text":"Wow, these cookies are delicious...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_121","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_121","text":"Yeah, they're my favorite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_122","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_122","text":"Who knows, maybe it's something in their blood. For some people, a life of crime is the only way to live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_123","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_123","text":"And besides, the Outer Rim isn't such a bad place to live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_124","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_124","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_125","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_125","text":"Unsurprisingly, our financial advisory session quickly went by the wayside, and soon devolved into an ordinary social gathering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_126","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_126","text":"Oh, right! Didn't we say we were going to try on some new clothes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_127","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_127","text":"I believe you did mention that. I must admit, I'm very much looking forward to it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_128","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_128","text":"I usually don't have many opportunities to wear extravagant clothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_129","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_129","text":"About time we got to the fun part of the evening!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_130","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_130","text":"It's been approximately 4 hours since we started chatting. Sounds like the ladies are about to switch gears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_131","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_131","text":"Well, I'll be off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_132","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_132","text":"Ah, you're right. I suppose the advisory session has already ended.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_133","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_133","text":"Thank you for toda...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_134","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_134","text":"But Sweetie, you have to see how I look!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_135","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_135","text":"Yes. We need someone to tell us how we look!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_136","type":"Speech","speaker":"viper","key":"Locale_SuddenStory:d_ex_court_04_136","text":"I'm sure Helm would like for you to stay and give her some feedback as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_137","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_137","text":"I-I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_138","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_138","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_139","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_court_04_139","text":"The impromptu fashion ends up going on all night, during which I sat and watched.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}