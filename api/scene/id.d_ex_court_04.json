urt_04_48","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_48","text":"Rupee, you'll be compensated for your services,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_49","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_49","text":"but my only concern is that it won't be to your satisfaction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_50","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_50","text":"Don't worry about any payment, I don't want any.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_51","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_51","text":"I've always wanted to do something like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_52","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_52","text":"I see you're trying to gain the upper hand in the negotiations. You're a CEO all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_53","type":"Speech","speaker":"rupee","key":"Locale_SuddenStory:d_ex_court_04_53","text":"Um... Thanks?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_court_04_54","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_court_04_54","text":"It's fine. Since we're from the lower strata, we'll give you whatever you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm"