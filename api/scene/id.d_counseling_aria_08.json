{"id":"d_counseling_aria_08","cat":"counsel","group":{"id":"char5070","label":"Aria"},"label":"Advising Aria: 08","stage":null,"prev":"d_counseling_aria_07","next":"d_counseling_aria_09","speakers":{"aria":"Aria"},"icons":{"aria":"si_c432_00_s"},"lines":[{"id":"d_counseling_aria_08_1","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_08_1","text":"Among us musicians, Noise has the closest ties with the masses.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["aria"],"affinity":"_0"},{"id":"d_counseling_aria_08_2","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_08_2","text":"Actually, she cares what the public thinks so much, that it can sometimes cause her to get into a funk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_08_3","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_08_3","text":"If she was feeling down when you saw her, what would you do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_08_4","text":"I'd try to cheer her up.","jump":"d_counseling_aria_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_aria_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_08_5","text":"I wouldn't do anything. It's the path she chose.","jump":"d_counseling_aria_08_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_aria_08_6","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_ari