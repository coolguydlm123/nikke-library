{"id":"d_main_49_03","cat":"main","group":{"id":"ch49","label":"Chapter 49 · Final Battle"},"label":"Chaos Wrought by the Unknown","stage":"49-16 STAGE · End","prev":"d_main_49_02","next":"d_main_49_04","speakers":{"poli":"Poli","miranda_op":"Miranda","quiry_op":"Quiry","rosanna_op_l":"Rosanna","sakura_op_r":"Sakura","moran_op_c":"Moran"},"icons":{"poli":"si_c030_00_s","miranda_op":"si_c032_00_s","quiry_op":"si_c033_00_s","rosanna_op_l":"si_c280_00_s","sakura_op_r":"si_c282_00_s","moran_op_c":"si_c281_00_s"},"lines":[{"id":"d_main_49_03_1","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_1","text":"You there! Eating is only permitted in your assigned room in the shelter!","jump":null,"exit":false,"enter":null,"bg":"EmptyShelter","bgArt":"emptyshelter","image":null,"bgm":"bgm_story_chapter49_higherground","movie":null,"shown":["poli"],"affinity":null},{"id":"d_main_49_03_2","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_2","text":"You have a food waste processor in your room as well, so dispose of any food waste properly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_3","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_3","text":"Hey! Please make sure you're fully dressed when you leave your room!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_4","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_4","text":"You there! No fighting! One more fight and you're going into isolation!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_5","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_5","text":"*Sigh* It never ends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_6","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_6","text":"Poli! Poliiii!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["miranda_op"],"affinity":null},{"id":"d_main_49_03_7","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_7","text":"What? Is something wrong at your shelter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_8","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_8","text":"The civilians here are grilling nutrium!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_9","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_9","text":"Get rid of it and give them a stern warning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_10","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_10","text":"Got it! But it smells so amazing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_11","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_11","text":"Grr...! Don't even think about mooching off them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_12","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_12","text":"Your job over there is to maintain order, not make friends!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_13","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_13","text":"Understood! But can't I have just one bite?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_14","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_14","text":"... Your shelter is only three minutes from here, right? I'm heading over now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_15","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_15","text":"N-no! It's all right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_16","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_16","text":"Do your job. Given the situation we're in, there could be serious consequences if we don't stay on top of things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_17","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_17","text":"Understood!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_18","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_18","text":"Oh, by the way are you watching the concert celebrating the start of the war? The 777 Squad just finished their performance!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_19","type":"Speech","speaker":"miranda_op","key":"Locale_MainScenario:d_main_49_03_19","text":"Next up is a joint performance by Prima Donna and T.T. STAR! Rewind is making a guest appearance, so it's gonna be amaz—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_20","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_20","text":"I'm hanging up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_21","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_22","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_22","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_23","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_23","text":"Poli! Poliiii!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["quiry_op"],"affinity":null},{"id":"d_main_49_03_24","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_24","text":"Urgh...! What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_25","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_25","text":"Talentum is engaging in unauthorized trade inside the shelter!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_26","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_26","text":"What...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_27","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_27","text":"Th-they're giving out free bags of suspicious white powder. Is it what I think it is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_28","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_28","text":"I-I should arrest them, right? But I don't think I could beat them in a fight...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_29","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_29","text":"The people from Talentum would never do that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_30","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_30","text":"Go take a closer look!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_31","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_31","text":"Ah! Yan just gave one to me, too! H-how dare she disrespect the police so openly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_32","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_32","text":"I'm gonna arrest her right now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_33","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_33","text":"Stop! I told you to take a closer look! Look at it up close!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_34","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_34","text":"Oh... They're tissues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_35","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_35","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_36","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_37","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_37","text":"Talentum is going around handing out relief supplies to the different shelters. So don't go making accusations like that again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_38","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_38","text":"Okay. I'm sorry...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_39","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_39","text":"Any other problems to report?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_40","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_40","text":"Nope. Fortunately the people here are following directions well, so there haven't been any major issues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_41","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_41","text":"Okay. Contact me if anything comes up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_42","type":"Speech","speaker":"quiry_op","key":"Locale_MainScenario:d_main_49_03_42","text":"Got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_43","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_44","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_44","text":"*Siiigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_45","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_45","text":"Everything okay, little White Puppy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rosanna_op_l","moran_op_c","sakura_op_r"],"affinity":null},{"id":"d_main_49_03_46","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_46","text":"Grr...! I'm not a puppy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_47","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_47","text":"That's no way to treat a public servant. When are you going to fix that vulgar disposition of yours?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_48","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_48","text":"You'd do well to stick to your natural talents and suck up to those in public office, Sakura.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_49","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_49","text":"Sorry, I hope I'm not late. I had some cleaning to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_50","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_50","text":"Why did you all suddenly reach out...? Oh. It's time for your status reports.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_51","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_51","text":"That's right. You set this time, White Puppy. Or did you forget?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_52","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_52","text":"*Sigh* I didn't even realize how much time had passed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_53","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_53","text":"Is everyone here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_54","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_54","text":"All the shelters are full. Exotic is doing a great job of rounding people up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_55","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_55","text":"Does that mean everyone from the Outer Rim has been moved to a shelter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_56","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_56","text":"I doubt it. Anyone who's gone to great lengths to hide can't be found.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_57","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_57","text":"Hmm... Is there really nothing we can do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_58","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_58","text":"There's no use trying. The Outer Rim is dark, and the streets there are a maze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_59","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_59","text":"There's no way to find those who've gone into hiding, intent on dying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_60","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_60","text":"... I see. Any other issues to report?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_61","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_61","text":"No problems at my shelter. Everyone's silent as the grave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_62","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_62","text":"But they're not actually in a grave, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_63","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_63","text":"Of course not. You worry too much, little White Puppy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_64","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_64","text":"How's it going for everyone else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_65","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_65","text":"My shelter is full too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_66","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_66","text":"A few people were causing a disturbance, but we put them in isolation. Other than that, there's nothing out of the ordinary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_67","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_67","text":"In isolation? Where...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_68","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_68","text":"In the Seimeikai mansion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_69","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_69","text":"They'd probably be better off in the rehabilitation center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_70","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_70","text":"There's still plenty of room at the mansion, so if anyone causes a disturbance in the other shelters, feel free to send them our way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_71","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_71","text":"We'll give them a warm welcome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_72","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_72","text":"Hmm... Okay. Go easy on them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_73","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_73","text":"How are things on your end, Moran?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_74","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_74","text":"Here? It's packed here as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_75","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_75","text":"But it's a mess. This place reeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_76","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_76","text":"The people here got peckish, so they ate some mushrooms they got from who-knows-where, and now they're all throwing up and running to the bathroom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_77","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_77","text":"Thank goodness Mary and Pepper are here looking after them. Otherwise, it'd be a complete disaster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_78","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_78","text":"My poor little Darkflower, the Shadow Empress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_79","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_79","text":"That's not the sort of thing a wicked mob boss would normally do. You're incredible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_80","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_81","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_81","text":"That's rich coming from you two. You didn't even hesitate to do a swimsuit photo shoot for your organizations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_82","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_83","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_83","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_84","type":"Speech","speaker":"moran_op_c","key":"Locale_MainScenario:d_main_49_03_84","text":"Ugh... They're throwing up again. I'm going to go clean it up. See you later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_85","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_85","text":"All right... Keep up the good work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_86","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_86","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_87","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_87","text":"Ugh. I can practically smell it just from hearing her talk about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_88","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_88","text":"It looks like things are peaceful on your end, Rosanna.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_89","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_89","text":"Does it seem that way? You have no idea how many people are causing trouble in the Ark, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_90","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_90","text":"There are so many empty homes right now, the thieves are having a field day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_91","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_91","text":"Not only that, but they're all getting into fights with each other. It's a total mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_92","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_92","text":"I've been running around like crazy knocking them all out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_93","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_94","type":"Speech","speaker