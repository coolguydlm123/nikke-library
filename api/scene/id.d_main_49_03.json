ull,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_101","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_101","text":"We won't do anything that'll get us caught. Don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_102","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_102","text":"Ugh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_103","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_103","text":"While we're on the subject, I have something to report from our end as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_104","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_104","text":"There are people currently spreading malicious rumors about the Third Surface Reclamation War online.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_105","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_105","text":"I'm working with the Protocol Squad to apprehend the culprits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_106","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_106","text":"Apprehend them how?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_107","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_107","text":"We're moving them to the Seimeikai mansion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_108","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_108","text":"Ugh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_109","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_109","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_110","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_110","text":"I can't really complain, given the current situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_111","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_111","text":"I'm grateful that you're taking charge of the shelters for the Outer Rim folks and taking care of security across the entire Ark, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_112","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_112","text":"To be honest, I was concerned when you offered to help, but I guess I was worrying for nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_113","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_113","text":"I won't forget this, and I'll be sure to report this to my superiors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_114","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_114","text":"Aww, just having our little White Puppy remember what we're done is more than enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_115","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_115","text":"I'm merely doing what must be done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_116","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_116","text":"Thank you for your cooperation! Talk to you in another three hours!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_117","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_117","text":"Don't mention it. Getting to work with the police? Now that's a real privilege.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_118","type":"Speech","speaker":"rosanna_op_l","key":"Locale_MainScenario:d_main_49_03_118","text":"Well then, take care!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_119","type":"Speech","speaker":"sakura_op_r","key":"Locale_MainScenario:d_main_49_03_119","text":"Keep up the good work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_120","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_120","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_121","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_121","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_122","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_122","text":"Poli looks around the shelter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_123","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_123","text":"She's surrounded by countless people amid chaos that shows no sign of calming down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_124","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_124","text":"Still, this chaos will pale in comparison to what's coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_125","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_125","text":"The moment they ascend to the surface, an even greater wave of chaos will undoubtedly descend upon the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_126","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_49_03_126","text":"Ugh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_03_127","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_03_127","text":"Still, she has to do her job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i