ull,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_e_84","type":"Speech","speaker":"marian","key":"Locale_MainScenario:event_marian2_01_e_84","text":"Hehe. You tell me. How's it taste?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_e_85","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_e_85","text":"A water fight commences as they each splash each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_e_86","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_e_86","text":"They both stand in the cool water, beneath the bright sunlight while a gentle breeze blows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_e_87","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_e_87","text":"The water drops that are sent flying by their hands catch the light and sparkle like jewels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_e_88","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_e_88","text":"And through those drops of water...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_e_89","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian2_01_e_89","text":"... something is seen that sparkles more than any jewel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian2_01_e_90","type":"Speech","speaker":"marian","key":"Local