{"id":"d_counseling_delta_ninjathief_07","cat":"counsel","group":{"id":"char5154","label":"Delta: Ninja Thief"},"label":"Advising Delta: Ninja Thief: 07","stage":null,"prev":"d_counseling_delta_ninjathief_06","next":"d_counseling_delta_ninjathief_08","speakers":{"delta_n":"Delta"},"icons":{"delta_n":"si_c023_00_s"},"lines":[{"id":"d_counseling_delta_ninjathief_07_1","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_1","text":"In the past, performing ninjutsu required considerable preparation and training.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["delta_n"],"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_2","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_2","text":"However, with recent technological developments, executing these techniques has become simpler than before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_3","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_3","text":"What is your opinion on this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_07_4","text":"It feels like the charm is gone...","jump":"d_counseling_delta_ninjathief_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_delta_ninjathief_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_07_5","text":"I like that it makes the mission easier to pull off.","jump":"d_counseling_delta_ninjathief_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_delta_ninjathief_07_6","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_6","text":"Charm, you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_7","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_7","text":"I'm afraid I don't quite understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_8","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_8","text":"I fail to see how the notion of charm relates to ninjutsu.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_9","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_9","text":"Was it truly an important element of the old ways?","jump":"d_counseling_delta_ninjathief_07_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_10","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_10","text":"I share the same thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_11","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_11","text":"Even my clone technique is extremely convenient thanks to holograms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_12","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_12","text":"However, I am curious how ninjas managed it without such technology.","jump":"d_counseling_delta_ninjathief_07_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_13","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_07_13","text":"I shall look into it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_07_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_07_14","text":"Delta and I explore the ways ninjutsu was used in the past.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}