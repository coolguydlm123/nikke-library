{"id":"d_counseling_admi_08","cat":"counsel","group":{"id":"char5030","label":"Admi"},"label":"Advising Admi: 08","stage":null,"prev":"d_counseling_admi_07","next":"d_counseling_admi_09","speakers":{"admi":"Admi"},"icons":{"admi":"si_c172_00_s"},"lines":[{"id":"d_counseling_admi_08_1","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_1","text":"People always say that no love lasts forever...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["admi"],"affinity":"_0"},{"id":"d_counseling_admi_08_2","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_2","text":"Do you agree with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_08_3","text":"Eternal love does exist.","jump":"d_counseling_admi_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_admi_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_08_4","text":"Eternal love is a lie.","jump":"d_counseling_admi_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_admi_08_5","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_5","text":"I knew you would say that, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_08_6","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_6","text":"To be honest, I'm also hoping that such a love really exists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_08_7","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_7","text":"... Thank you, Commander.","jump":"d_counseling_admi_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_08_8","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_8","text":"So, Commander, you feel the same as everyone else...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_08_9","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_9","text":"Even so, I always like to think it might be real.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_08_10","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_08_10","text":"But... I don't know. Maybe it's not...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_08_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_admi_08_11","text":"I have a conversation about love with Admi.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}