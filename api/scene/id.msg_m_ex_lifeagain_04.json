ome!","jump":null},{"id":"m_ex_lifeagain_04_59","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_lifeagain_04_59","text":"I want to go too!","jump":null},{"id":"m_ex_lifeagain_04_60","type":"Speech","speaker":"rumani","key":"Locale_SuddenMessage:m_ex_lifeagain_04_60","text":"If you come here, Gym Rat, I'll make you do 1,000 burpees.","jump":null},{"id":"m_ex_lifeagain_04_61","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_lifeagain_04_61","text":"... Despite my curiosity, I decide it's best not to go.","jump":null}],"chat":true}