er":"volume","key":"Locale_NikkeEpisode:d_nikke_volume_03_6","text":"How come? They already know who I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_03_7","type":"Speech","speaker":"mc","key":"Locale_NikkeEpisode:d_nikke_volume_03_7","text":"Haha, you're right about that. If you don't know who Volume is, what rock have you been living under?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_03_8","type":"Speech","speaker":"mc","key":"Locale_NikkeEpisode:d_nikke_volume_03_8","text":"Your new album has shot straight to the top of the charts. How do you feel about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_03_9","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:d_nikke_volume_03_9","text":"Did you honestly expect anything different?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_03_10","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:d_nikke_volume_03_10","text":"No other rapper in the Ark can hold a candle to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_03_11","type":"Speech","speaker":"mc","key":"Locale_NikkeEpisode:d_nikke_volume_03_11","text":"Impressive! Do you really think that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_03_12","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:d_nikke_volume_03_12","text":"Of course, why wouldn't I? What, you think I'm lying?","jump":null,"exit":false,"enter":