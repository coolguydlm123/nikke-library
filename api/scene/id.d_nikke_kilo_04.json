es. Someone who can prove highly effective in any given situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_47","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_47","text":"An individual who might not stand out in any one aspect, but is able to contribute more than enough to be noticed and appreciated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_48","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_48","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_49","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_50","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_50","text":"Kind of sounds like someone who's just responsible for clean up...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_51","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_51","text":"That's a bit of a negative spin on it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_52","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_53","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_53","text":"I knew it... I'm not talented in anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_54","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_55","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_55","text":"There is merit to what the Commander said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_56","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_56","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_57","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_57","text":"You said T.A.L.O.S. acts on your command, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_58","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_58","text":"That tells me you understand where and how to use all those different functions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_59","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_59","text":"If you're able to hone all those skills,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_60","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_60","text":"you could indeed become a jack of all trades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_61","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_61","text":"Someone who excels at everything they do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_62","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_62","text":"Wow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_63","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_63","text":"Of course, it will require a lot of time, and a substantial amount of effort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_64","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_64","text":"... I understand. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_65","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_65","text":"Okay... I think all these tests have worn me out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_66","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_66","text":"Is it okay if I get some rest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_67","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_67","text":"Sure, go ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_68","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_68","text":"Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_69","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_04_69","text":"Kilo walks off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_70","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_70","text":"... Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_71","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_71","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_72","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_72","text":"Don't you think you're giving her false hope?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_73","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_73","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_74","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_74","text":"If she wants to define who she is,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_75","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_75","text":"she has to consider all of the possibilities, and think about it long and hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_76","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_76","text":"But that's a luxury Kilo might not be able to afford.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_77","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_77","text":"Picking one area of expertise might be more...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_78","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_78","text":"Is that your definition of talent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_79","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_79","text":"Absolutely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_80","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_80","text":"Talent is something you can cultivate within yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_81","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_81","text":"If you don't, you'll never be needed by anyone, or even acknowledged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_82","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_82","text":"Talent isn't something that you use to obtain recognition. It's meant to help you gain a deeper understanding of yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_83","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_83","text":"I don't agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_84","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_84","text":"Well, everyone has their own opinions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_85","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_85","text":"Yes, and you've imposed yours on Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_86","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_86","text":"Hardly. I'm merely pointing her in a certain direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_87","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_87","text":"Are you seriously telling me that saying what you said to someone who's lost their way isn't imposing your own will on them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_88","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_88","text":"That's enough bickering, you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_89","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_89","text":"I just came up with the perfect solution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_90","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_90","text":"I should know better by now... but fine, I'll bite. What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_91","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_91","text":"We find a squad that needs Kilo as she is right now, and have her join them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_92","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_92","text":"There must be a squad out there that has a need for someone with a comprehensive skillset like Kilo's, even if she is a bit clumsy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_93","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_94","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_94","text":"Neon, did you not listen to what I was just telling Kilo? Squads are formulated now according to very defined skillsets...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_95","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_95","text":"I know, but there might be a squad out there that needs her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_96","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_96","text":"... Maybe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_97","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_97","text":"Maybe my ass!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_98","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_99","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_99","text":"At any rate, the final decision will rest with Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_100","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_100","text":"She'll have to decide for herself if she wants to focus on one thing in order to stand out,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_101","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_101","text":"or put a whole bunch of effort into honing every skill she currently possesses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_102","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_102","text":"or find a place where she belongs right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_103","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_103","text":"You're right. That's her decision to make.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_104","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_104","text":"... Let's take Kilo with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_105","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_105","text":"Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_106","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_106","text":"We've still got one mission coming up where we'll be protecting the elevator. Let's have her tag along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_girlstalk","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_107","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_107","text":"... I don't think there would inherently be any issues with that, but may I ask why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_108","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_108","text":"When it comes down to it, Kilo has to be able to work with others in whatever capacity that may be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_109","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_109","text":"Therefore, I don't think it's right to write her off based on hypothetical tests alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_110","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_110","text":"If we're all out in the field together, we might find out things we wouldn't have otherwise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_111","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_111","text":"You want to see if we have any chemistry on the battlefield, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_112","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_112","text":"Going into combat with a robot?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_113","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_113","text":"I'm in!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_114","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_114","text":"Just thinking about it makes my heart race.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_115","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_115","text":"Understood. I'll make the necessary preparations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_116","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_116","text":"Thanks, Rapi. I'll contact Mana.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_117","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_04_117","text":"We shouldn't have to inform Syuen... right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_118","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_118","text":"No, there's no need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_119","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_119","text":"Just ignore her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_120","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_120","text":"... Are you all sure about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}