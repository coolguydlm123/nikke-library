{"id":"d_nikke_kilo_04","cat":"bond","group":{"id":"char5053","label":"Kilo"},"label":"Perfectly Ordinary","stage":null,"prev":"d_nikke_kilo_03","next":"d_nikke_kilo_05","speakers":{"Narration":"Narration","rapi":"Rapi","kilo":"Kilo","neon":"Neon","anis":"Anis","Self":"Commander"},"icons":{"Narration":"si_c999_00_s","rapi":"si_c010_00_s","kilo":"si_c977_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s"},"lines":[{"id":"d_nikke_kilo_04_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_04_1","text":"The Outpost.","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":["rapi","anis","neon","kilo","talos"],"affinity":null},{"id":"d_nikke_kilo_04_2","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_2","text":"I have to be honest with you, Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_3","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_3","text":"As it stands,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_4","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_4","text":"you and T.A.L.O.S. are utterly average in every aspect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_5","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_5","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_6","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_6","text":"Wow! Really?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_7","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_7","text":"I'm not saying that as a compliment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_8","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_8","text":"In fact, I'd venture to say that you're barely getting by.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_9","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_10","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_10","text":"Of course, this is all based on Elysion's standards, and while the practice facility simulates an environment close to actual combat, it's still far from the real thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_11","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_11","text":"Even with all that factored in, however, your overall abilities appear to be lacking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_12","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_12","text":"I... I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_13","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_13","text":"If there is one unifying weak point,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_14","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_14","text":"it is that you have too many functions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_15","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_15","text":"I'm not saying you don't have a good reason for each of them, but the amount is simply excessive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_16","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_16","text":"Due to this surfeit of functions, your proficiency in each individual one is somewhat low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_17","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_17","text":"You have a wide range of skills, but you have not mastered any of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_18","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_19","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_04_19","text":"You never were one for mincing words, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_20","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_20","text":"You've got that right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_21","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_21","text":"As of late, squads have been assembled on the general basis of a shared specialization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_22","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_22","text":"All the members of a squad possess finely tuned abilities within the same category.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_23","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_23","text":"For example, let's look at The Scouts, who excel at reconnaissance.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":["delta","signal"],"affinity":null},{"id":"d_nikke_kilo_04_24","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_24","text":"Signal possesses superb powers of deduction and communication skills.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_25","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_25","text":"She's responsible for reporting any mid-mission incidents to their superiors so that other units can respond accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_26","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_26","text":"Another one of her duties is creating environments with strong signals so that communications never go down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_27","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_27","text":"Delta, meanwhile, is adept at tracking and infiltration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_28","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_28","text":"She can approach targets without being detected and observe their movements, and can also use her tracking skills to keep the squad on track.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_29","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_29","text":"If necessary, she is authorized to carry out covert operations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_30","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_30","text":"Between these two, all their bases are covered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_31","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_31","text":"No other skills are required, since they're meant to serve a very specific purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_32","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_32","text":"Then what should I...","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":null,"movie":null,"shown":["rapi","anis","neon","kilo","talos"],"affinity":null},{"id":"d_nikke_kilo_04_33","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_33","text":"You need to figure out what your purpose is and focus on that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_34","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_04_34","text":"Otherwise, you're bound to fail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_35","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_35","text":"So I have to pick something and focus on it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_36","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_36","text":"But what should I choose?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_37","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_04_37","text":"I don't know...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_38","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_04_38","text":"That's why we're doing all this. To find out precisely that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_04_39","type":"Speech","speaker":"neon","key":