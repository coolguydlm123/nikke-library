ain_30_05_21","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_21","text":"but if we wanted to, we could rob those places blind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_22","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_22","text":"Large groups are down in those mines at the same time. Snagging a few gems would be exceedingly easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_05_23","text":"But none of you did that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_24","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_24","text":"I'd be lying if I said I'd never considered it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_25","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_25","text":"but every time I got serious about it, Hammering stepped in and stopped me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_26","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_26","text":"She'd go on about how we need to have pride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_27","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_27","text":"Even if we were on the edge of starvation, we must never lose our pride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_28","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_28","text":"Having said that, since we're Nikkes, we'd never actually starve, so that works out nicely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_05_29","text":"She seems a bit on her high horse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_30","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_30","text":"She can be frustrating at times, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_31","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_31","text":"This is a prime example. Right now, because of her principles,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_32","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_32","text":"she's willing to put herself on the line for people she barely knows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_33","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_33","text":"Like I said, frustrating and foolish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_05_34","text":"And kind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_35","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_35","text":"Yes, she certainly is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_36","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_36","text":"Almost to a fault.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_37","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_37","text":"So,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_38","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_38","text":"that's why I need to save that silly fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_39","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_39","text":"She's been like this her entire life,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_40","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_40","text":"wearing her heart on her sleeve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_05_41","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_30_05_41","text":"If someone as good as her were to die in a forsaken place like this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null