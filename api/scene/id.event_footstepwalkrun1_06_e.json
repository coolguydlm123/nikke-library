":"Speech","speaker":"kalia","key":"Locale_MainScenario:event_footstepwalkrun1_06_e_54","text":"8%.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_06_e_55","type":"Speech","speaker":"kalia","key":"Locale_MainScenario:event_footstepwalkrun1_06_e_55","text":"Everyone else is gonna be slaughtered!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_06_e_56","type":"Speech","speaker":"kalia","key":"Locale_MainScenario:event_footstepwalkrun1_06_e_56","text":"This is my fourth time on the surface, and I've been lucky to come out alive each time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_06_e_57","type":"Speech","speaker":"kalia","key":"Locale_MainScenario:event_footstepwalkrun1_06_e_57","text":"But things have really gone south this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_06_e_58","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_06_e_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_06_e_59","type":"Speech","speaker":"kalia","key":"Locale_MainScenario:event_footstepwalkrun1_06_e_59","text":"You ought to know this stuff too. It doesn't seem like this is your first time up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_06_e_60","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_06_e_60","text":"I'm aware, yes.","ju