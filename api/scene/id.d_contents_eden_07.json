ty":null},{"id":"d_contents_eden_07_68","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_07_68","text":"Isn't that the rule?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_69","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_07_69","text":"So, regardless of what you choose, I don't want to force my opinions upon you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_70","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_07_70","text":"Don't you think it's even worse that you know the rule, yet you're still asking me such questions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_71","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_07_71","text":"You're right. I definitely crossed the line this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_72","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_07_72","text":"I apologize if I offended you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_73","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_07_73","text":"Whatever. You can go now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_74","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_07_74","text":"I want to be alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_75","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_07_75","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_76","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_07_76","text":"Still, I hope you'll come to the party.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_77","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_07_77","text":"Everyone seems to be waiting for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_78","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_07_78","text":"... We'll see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_79","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_eden_07_79","text":"Cecil leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_80","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_07_80","text":"Haha. You want me to step inside the circle?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_07_81","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_07_81","text":"... There's no way I can do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm