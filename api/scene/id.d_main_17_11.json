{"id":"d_main_17_11","cat":"main","group":{"id":"ch17","label":"Chapter 17 · Purpose"},"label":"Goddess","stage":"17-30 STAGE · End","prev":"d_main_17_10","next":"d_main_17_12","speakers":{"rapunzel":"Rapunzel","rapi":"Rapi","anis":"Anis","neon":"Neon"},"icons":{"rapunzel":"si_c221_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_17_11_1","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_1","text":"Rapi, you remind me of my friend.","jump":null,"exit":false,"enter":null,"bg":"IceLand_04","bgArt":"iceland_04","image":null,"bgm":"bgm_story_6f6e6573656c66","movie":null,"shown":["rapunzel","anis","neon","rapi"],"affinity":null},{"id":"d_main_17_11_2","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_2","text":"Your attitude and personality are different,\nbut the way you fight is practically identical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_3","text":"... Perhaps. I assume you're referring to","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_4","text":"Red Hood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_5","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_5","text":"Huh? How did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_6","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_6","text":"Do you know her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_7","text":"So I heard you right after all...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_8","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_8","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_9","text":"Red Hood. A Nikke from the First invasion.\nAnd the legendary Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_10","text":"In the past, was your Squad named Pioneer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_11","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_11","text":"No. We only got that name once we met again on the surface.\nWe were originally called...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_12","text":"Goddess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_13","text":"Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_14","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_15","text":"!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_16","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_16","text":"Yes... correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_17","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_17","text":"Have you met Red Hood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_18","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_19","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_19","text":"No wonder you two are so similar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_20","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_20","text":"Thank you for telling me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_21","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_21","text":"Wait... Goddess? Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_11_22","text":"Goddess? What's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_23","text":"You don't know Goddess?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_24","text":"Have you been living under a rock?\nWhat are they teaching you at the Military Academy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_25","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_25","text":"They were the first Nikkes created by mankind and the first ever Nikke squad!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_26","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_26","text":"During the first invasion, they were the first to come back victorious from battling the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_27","text":"Before the Ark's defensive walls were built,\nthey were the only thing standing between the Ark and the Rapture invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_28","text":"They were the ultimate warriors.\nTrue heroes who will go down in history.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_29","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_29","text":"I even heard that when the Ark was being constructed,\nthere was some kind of accident while all of you were defending the perimeter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_11_30","text":"But you soldiered on! Just incredible!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_31","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_31","text":"Wow, I didn't realize we were so popular.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_32","text":"There are more important things at stake here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_33","text":"The Commander of Goddess is a very famous person.\nShouldn't we be looking for him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_34","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_34","text":"Hehe, I'm not surprised he's still a popular guy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_35","text":"That's not the point!\nWe need to locate him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_36","text":"Or... how he died. Where his grave is located. You at least deserve to know that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_37","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_37","text":"No. Please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_38","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_38","text":"I prefer not knowing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_39","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_40","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_40","text":"If I heard any news about him, it'd only make me miss him more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_41","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_41","text":"It'd be unbearable. I'd want to return to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_42","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_42","text":"I don't want it to come to that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_43","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_43","text":"I still haven't accomplished my mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_44","text":"What mission? Don't tell me it's reclaiming the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_45","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_45","text":"It is one of the factors,\nbut not the sole reason, no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_46","text":"What are you talking about?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_47","text":"It wasn't your fault we lost the surface to the Raptures!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_48","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_48","text":"Hehe. No, that's not it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_49","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_49","text":"It is not as if I lament for all of mankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_50","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_50","text":"I do not entertain such grandiose thoughts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_51","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_51","text":"It has nothing to do with others. It's about us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_52","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_52","text":"All those who laughed, cried, and fought together in that war. Who made a promise to one another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_53","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_53","text":"We were unable to keep that promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_54","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_54","text":"And so we must atone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_55","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_55","text":"I cannot yet return to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_56","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_11_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_57","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_11_57","text":"You sure live a complicated life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_58","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_58","text":"Hehe, you could call it a quirk of ours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_59","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_59","text":"But I'm glad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_60","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_60","text":"Goddess and the Commander have not been lost in the annals of history.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_61","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_61","text":"Just knowing that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_62","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_11_62","text":"is enough for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_11_63","type":"Speech","speaker":"neon","key":"Lo