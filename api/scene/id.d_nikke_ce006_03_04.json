ech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_39","text":"Aren't you curious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_40","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_40","text":"If it were me, I would be dissecting myself to figure out how I was made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_41","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_41","text":"Even if I did know everything, would that change anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_42","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_42","text":"I suppose not... but I'd still be curious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_43","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_43","text":"Hmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_44","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_44","text":"*Poke*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_45","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_45","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_46","type":"Narration