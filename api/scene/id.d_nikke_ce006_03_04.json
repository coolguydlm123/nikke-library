","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_26","text":"Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_27","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_27","text":"I suppose I can see where you're coming from,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_28","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_28","text":"but I still can't quite make sense of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_29","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_29","text":"It seems to me that making a Nikke like yourself would take far more time and resources to accomplish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_30","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_30","text":"Oh no, Nikkes like me can be mass-produced, so it doesn't take too much time or money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_31","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_31","text":"Huh? Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_32","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_32","text":"You're able to produce next-level technology like that on a massive scale?","jump":null,"exit":false,"enter":nu