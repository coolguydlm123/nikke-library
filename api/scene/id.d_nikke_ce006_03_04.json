se,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_7","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_7","text":"Are transport ships not a thing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_8","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_8","text":"They are, but there are a bajillion mitigating factors","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_9","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_9","text":"that result in us not being able to use them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_10","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_10","text":"Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_11","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_11","text":"I assume it's because of those things you call Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_12","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_12","text":"Bingo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_13","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_13","text":"There's the very real threat of running into airborne Raptures, or ones with anti-aircraft weaponry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_14","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_14","text":"The Raptures dominate the skies, not least of all because of one called Storm Bringer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_15","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_15","text":"When we're in the air, we're pretty much helpless, so we rarely rely on air transport.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_16","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_16","text":"The only real exceptions are if it's a confirmed safe zone, or an area that can't be reached by any other means of transport.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_17","type":"Speech","speaker":"elegg","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_17","text":"Oh, and if there's a ton of cargo that needs to be carried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_18","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_18","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce006_03_04_19","type":"Speech","speaker":"ce006_03","key":"Locale_NikkeEpisode:d_nikke_ce006_03_04_19","text":"I figured since you're all machines,","jump":null,