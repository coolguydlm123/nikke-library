{"id":"msg_m_ex_scouting_01","cat":"messenger","group":{"id":"room_scouting","label":"The Scouts · Group"},"label":"1. Hello, Commander.","stage":null,"prev":null,"next":"msg_m_ex_scouting_02","speakers":{"signal":"Signal","delta":"Delta"},"icons":{"signal":"si_c022_00_s","delta":"si_c020_00_s"},"lines":[{"id":"m_ex_scouting_01_1","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_1","text":"Hello, Commander.","jump":null},{"id":"m_ex_scouting_01_2","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_2","text":"Have you eaten dinner?","jump":null},{"id":"m_ex_scouting_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_3","text":"Who is this?","jump":null},{"id":"m_ex_scouting_01_4","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_4","text":"Signal, present and accounted for!","jump":null},{"id":"m_ex_scouting_01_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_5","text":"What's with that manner of speech?","jump":null},{"id":"m_ex_scouting_01_6","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_6","text":"Commander,","jump":null},{"id":"m_ex_scouting_01_7","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_7","text":"I am not the same Signal you knew before.","jump":null},{"id":"m_ex_scouting_01_8","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_8","text":"I made up my mind.","jump":null},{"id":"m_ex_scouting_01_9","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_9","text":"I am also a member of the Scouts!","jump":null},{"id":"m_ex_scouting_01_10","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_10","text":"From now on, I will be more proactive and more decisivr.","jump":null},{"id":"m_ex_scouting_01_11","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_11","text":"Ah, typo.","jump":null},{"id":"m_ex_scouting_01_12","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_12","text":"Hey, why can't I recall it?","jump":null},{"id":"m_ex_scouting_01_13","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_13","text":"Wait, gotta sound like I'm in the military...","jump":null},{"id":"m_ex_scouting_01_14","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_14","text":"For what reason can these words not be recalled?","jump":null},{"id":"m_ex_scouting_01_15","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_15","text":"I don't mean nuthin...","jump":null},{"id":"m_ex_scouting_01_16","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_16","text":"Er...I would like to retract my previous statement.","jump":null},{"id":"m_ex_scouting_01_17","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_17","text":"Signal.","jump":null},{"id":"m_ex_scouting_01_18","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_18","text":"What are you doing?","jump":null},{"id":"m_ex_scouting_01_19","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_19","text":"A major incident has occurred, Delta.","jump":null},{"id":"m_ex_scouting_01_20","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_20","text":"I dare not reveal any more than that.","jump":null},{"id":"m_ex_scouting_01_21","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_21","text":"I await your orders.","jump":null},{"id":"m_ex_scouting_01_22","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_22","text":"You don't have to force yourself","jump":null},{"id":"m_ex_scouting_01_23","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_23","text":"to sound different than you do normally.","jump":null},{"id":"m_ex_scouting_01_24","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_24","text":"No!","jump":null},{"id":"m_ex_scouting_01_25","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_25","text":"I want to be just like Delta!","jump":null},{"id":"m_ex_scouting_01_26","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_26","text":"Strong and decisive!","jump":null},{"id":"m_ex_scouting_01_27","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_27","text":"Aggressive and a mind as sharp as a tack!","jump":null},{"id":"m_ex_scouting_01_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_28","text":"Is the show you're watching about the Central Government by any chance?","jump":null},{"id":"m_ex_scouting_01_29","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_29","text":"Yes!","jump":null},{"id":"m_ex_scouting_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_30","text":"Are the main characters soldiers?","jump":null},{"id":"m_ex_scouting_01_31","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_31","text":"Yes...","jump":null},{"id":"m_ex_scouting_01_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_32","text":"Is the heroine very strong and decisive?","jump":null},{"id":"m_ex_scouting_01_33","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_33","text":"How did you know?!","jump":null},{"id":"m_ex_scouting_01_34","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_34","text":"Have you been watching it too?","jump":null},{"id":"m_ex_scouting_01_35","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_35","text":"Just as I expected.","jump":null},{"id":"m_ex_scouting_01_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_36","text":"The finale was yesterday, wasn't it? Did you watch it?","jump":null},{"id":"m_ex_scouting_01_37","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_37","text":"No, I was too busy working on a mission.","jump":null},{"id":"m_ex_scouting_01_38","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_38","text":"I was gonna watch it today! They're gonna be re-airing it.","jump":null},{"id":"m_ex_scouting_01_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_39","text":"The hero dies.","jump":null},{"id":"m_ex_scouting_01_40","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_40","text":"What?!","jump":null},{"id":"m_ex_scouting_01_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_41","text":"The heroine becomes a Nikke, but remembers her past when the hero dies.","jump":null},{"id":"m_ex_scouting_01_42","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_42","text":"Aggghhh, stop!","jump":null},{"id":"m_ex_scouting_01_43","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_43","text":"Stooop!","jump":null},{"id":"m_ex_scouting_01_44","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_44","text":"No spoilers!","jump":null},{"id":"m_ex_scouting_01_45","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_45","text":"WAAAAAHHHHH!","jump":null},{"id":"m_ex_scouting_01_46","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_46","text":"How could you do this, Commander?!","jump":null},{"id":"m_ex_scouting_01_47","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_47","text":"Signal.","jump":null},{"id":"m_ex_scouting_01_48","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_48","text":"Calm down.","jump":null},{"id":"m_ex_scouting_01_49","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_49","text":"Uh, uh...huh?","jump":null},{"id":"m_ex_scouting_01_50","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_50","text":"Now you're sounding","jump":null},{"id":"m_ex_scouting_01_51","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_01_51","text":"like the Signal we all know.","jump":null},{"id":"m_ex_scouting_01_52","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_52","text":"That's not important right now!","jump":null},{"id":"m_ex_scouting_01_53","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_53","text":"I had the show spoiled!","jump":null},{"id":"m_ex_scouting_01_54","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_54","text":"This is just awful!","jump":null},{"id":"m_ex_scouting_01_55","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_55","text":"That wasn't a spoiler.","jump":null},{"id":"m_ex_scouting_01_56","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_56","text":"You're a big meanie, Commander!","jump":null},{"id":"m_ex_scouting_01_57","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_57","text":"I haven't even seen that show.","jump":null},{"id":"m_ex_scouting_01_58","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_58","text":"???????","jump":null},{"id":"m_ex_scouting_01_59","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_59","text":"I made it all up.","jump":null},{"id":"m_ex_scouting_01_60","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_60","text":"That's...","jump":null},{"id":"m_ex_scouting_01_61","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_61","text":"That's fantastic!","jump":null},{"id":"m_ex_scouting_01_62","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_01_62","text":"What happened to sounding strong and decisive?","jump":null},{"id":"m_ex_scouting_01_63","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_63","text":"That doesn't matter anymore.","jump":null},{"id":"m_ex_scouting_01_64","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_64","text":"I...","jump":null},{"id":"m_ex_scouting_01_65","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_65","text":"I need to watch the finale right away!","jump":null},{"id":"m_ex_scouting_01_66","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_01_66","text":"That way I won't have it spoiled for real.","jump":null}],"chat":true}