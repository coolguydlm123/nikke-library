null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_06_s_19","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_06_s_19","text":"You're an impostor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_06_s_20","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_06_s_20","text":"Or something else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_06_s_21","type":"Speech","speaker":"marian_q","key":"Locale_MainScenario:event_lastkingdom2_06_s_21","text":"I'm a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_06_s_22","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_06_s_22","text":"For now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_06_s_23","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_06_s_23","text":"Chatterbox used a strange expression when referring to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_06_s_24","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_06_s_24","text":"I thought it was just spewing nonsense like usual, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_06_s_25","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:event_lastkingdom2_06_s_25","text":"Hehe. Just what in the world are you?","jump":null,"exit":fal