ull,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_21","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_21","text":"We despise the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_22","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_22","text":"We would appreciate it if you don't mention that place again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_23","text":"All of you? Even Johan and Cecil?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_24","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_24","text":"Yes. All of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_25","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_26","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_26","text":"I thought I told you to drop the subject.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_27","text":"Come on, just tell me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_28","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_28","text":"I refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_29","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_29","text":"It's like watching an unstoppable force meet an immovable object...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_30","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_30","text":"Anyway, it's not good to dwell on the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_31","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_31","text":"I will tell you one thing, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_32","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_32","text":"We were all betrayed...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_33","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_33","text":"By the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_34","text":"... Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_35","text":"So what? Who hasn't been betrayed before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_36","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_36","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_37","text":"You'd probably have a harder time finding someone who hasn't been screwed over by the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_38","text":"Not wanting to talk about the Ark just because of that seems a bit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_39","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_39","text":"What may not seem like much to you could mean a lot to others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_40","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_40","text":"Maybe you can shrug it off, but for us, it left a scar that's slow to heal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_41","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_41","text":"It doesn't do either of us any good trying to compare who got betrayed worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_42","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_21_06_42","text":"What matters is how the person felt when it happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_43","text":"Okay, fair enough. Point taken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_06_44","text":"I'm sorry, it was careless of me to say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_45","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_45","text":"I'm sorry too. I apologize for being a bit too sensitive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_46","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_06_46","text":"Then can I ask something else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_47","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_21_06_47","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_48","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_06_48","text":"How do you get along with the other Pilgrims?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_06_49","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d