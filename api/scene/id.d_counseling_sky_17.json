{"id":"d_counseling_sky_17","cat":"counsel","group":{"id":"char5188","label":"Sky"},"label":"Advising Sky: 17","stage":null,"prev":"d_counseling_sky_16","next":"d_counseling_sky_18","speakers":{"sky":"Sky"},"icons":{"sky":"si_c530_00_s"},"lines":[{"id":"d_counseling_sky_17_1","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_17_1","text":"I've had something on my mind recently.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sky"],"affinity":"_0"},{"id":"d_counseling_sky_17_2","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_17_2","text":"When someone compliments me, I don't know how to react.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_17_3","text":"All you have to do is say thank you.","jump":"d_counseling_sky_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sky_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_17_4","text":"Run away.","jump":"d_counseling_sky_17_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sky_17_5","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_17_5","text":"... Oh, that's simpler than I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_17_6","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_17_6","text":"I guess I was overthinking it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"sh