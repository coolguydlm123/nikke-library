ikke_flora_05_70","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_70","text":"would you like to come to the garden and watch over this Coreopsis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_71","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_71","text":"And even after that, possibly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_72","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_05_72","text":"I'll come as long as you allow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_73","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_73","text":"Haha, of course I'll allow it. I'm the one asking you to come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_74","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_74","text":"My garden will always be open to you, Blossom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_75","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_75","text":"Feel free to come visit any time you wish to see the little ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_76","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_05_76","text":"Can I really do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_77","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_77","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_78","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_78","text":"After all, you're one of the flowers I'm most curious about,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_79","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_79","text":"and this is a place meant for flowers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_80","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_05_80","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_81","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_05_81","text":"I'll try and come as often as I can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_82","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_05_82","text":"Haha, I look forward to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_83","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_05_83","text":"Perhaps the flowers in the garden were happy as well, because the fragrance was sweeter than ever that day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_84","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_05_84","text":"From then on, I visit the garden often to speak with the flowers,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_05_85","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_05_85","text":"while hoping for the day my own flower would finally bloom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}