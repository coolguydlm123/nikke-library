{"id":"msg_m_ex_noir_05","cat":"messenger","group":{"id":"room_noir","label":"Noir · Nikke"},"label":"5. Pit Boss,","stage":null,"prev":"msg_m_ex_noir_04","next":"msg_m_ex_noir_06","speakers":{"noir":"Noir"},"icons":{"noir":"si_c271_00_s"},"lines":[{"id":"m_ex_noir_05_1","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_1","text":"Pit Boss,","jump":null},{"id":"m_ex_noir_05_2","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_2","text":"I've got something on my mind.","jump":null},{"id":"m_ex_noir_05_3","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_3","text":"Could you lend me your ear?","jump":null},{"id":"m_ex_noir_05_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_4","text":"Sure, what is it?","jump":null},{"id":"m_ex_noir_05_5","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_5","text":"We're planning","jump":null},{"id":"m_ex_noir_05_6","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_6","text":"a new performance at Coin Rush,","jump":null},{"id":"m_ex_noir_05_7","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_7","text":"but it's been rather difficult.","jump":null},{"id":"m_ex_noir_05_8","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_8","text":"No matter how much I practice,","jump":null},{"id":"m_ex_noir_05_9","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_9","text":"I can't seem to get my form right.","jump":null},{"id":"m_ex_noir_05_10","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_10","text":"I don't know what else I can possibly do.","jump":null},{"id":"m_ex_noir_05_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_11","text":"So this was what Blanc was worried about.","jump":null},{"id":"m_ex_noir_05_12","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_12","text":"Huh?","jump":null},{"id":"m_ex_noir_05_13","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_13","text":"What are you talking about?","jump":null},{"id":"m_ex_noir_05_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_14","text":"Blanc was telling me how she was worried you were too fixated on practicing.","jump":null},{"id":"m_ex_noir_05_15","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_15","text":"She did?","jump":null},{"id":"m_ex_noir_05_16","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_16","text":"So she was concerned about me?","jump":null},{"id":"m_ex_noir_05_17","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_17","text":"That's so sweet of her.","jump":null},{"id":"m_ex_noir_05_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_18","text":"So you should heed her advice and rest for a while.","jump":null},{"id":"m_ex_noir_05_19","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_19","text":"Oh no,","jump":null},{"id":"m_ex_noir_05_20","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_20","text":"I can't do that.","jump":null},{"id":"m_ex_noir_05_21","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_21","text":"I have an integral part in this upcoming performance.","jump":null},{"id":"m_ex_noir_05_22","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_22","text":"If I don't practice, the entire show could go up in flames.","jump":null},{"id":"m_ex_noir_05_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_23","text":"It was your form that was giving you trouble, wasn't it?","jump":null},{"id":"m_ex_noir_05_24","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_24","text":"Yes.","jump":null},{"id":"m_ex_noir_05_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_25","text":"It might be because you're actually practicing too much.","jump":null},{"id":"m_ex_noir_05_26","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_26","text":"What?","jump":null},{"id":"m_ex_noir_05_27","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_27","text":"Hmm...","jump":null},{"id":"m_ex_noir_05_28","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_28","text":"Are you trying to say that resting can be just as important as practicing?","jump":null},{"id":"m_ex_noir_05_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_29","text":"That's right.","jump":null},{"id":"m_ex_noir_05_30","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_30","text":"Oooooh...","jump":null},{"id":"m_ex_noir_05_31","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_31","text":"Okay.","jump":null},{"id":"m_ex_noir_05_32","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_32","text":"Well, since you and Blanc both seem to feel the same about this,","jump":null},{"id":"m_ex_noir_05_33","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_33","text":"I guess I'll take a break.","jump":null},{"id":"m_ex_noir_05_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noir_05_34","text":"Don't push yourself too hard.","jump":null},{"id":"m_ex_noir_05_35","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_35","text":"Okay!","jump":null},{"id":"m_ex_noir_05_36","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_noir_05_36","text":"Thanks, Pit Boss, hehe.","jump":null}],"chat":true}