5_25","text":"And would that not be rather embarrassing? At this point—Mmph!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_26","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_26","text":"... I'm so glad you came back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_27","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_28","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_28","text":"I'm sorry, I've never been reunited with someone like this before, so I'm not quite sure what to make of these feelings...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_29","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_29","text":"... The same holds true for me, I daresay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_30","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_30","text":"More to the point... wouldst thou let go of me whilst we converse?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_31","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_31","text":"Oh yes, I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_32","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_32","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_33","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_33","text":"Thy appearance may have changed, but thou art still the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_34","type":"Speech","speaker":"rapunzel_s","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_34","text":"Hehe. Isn't that just as true of you, Scarlet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_35","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_35","text":"Aye, thou art not wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_36","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_36","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil","johan"],"affinity":null},{"id":"d_nikke_rapunzel_sanctuary_05_37","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_rapunzel_sanctuary_05_37","text":"Are you quite finished?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affini