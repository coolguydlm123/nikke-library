r":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_96","type":"Speech","speaker":"mrsmiss","key":"Locale_SideStory:s005_10_96","text":"Wait!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_97","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_97","text":"From the entrance, waves of mass-produced Nikkes from the Central Government surge in,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_98","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_98","text":"crashing with the Nikkephobes in a violent firefight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_99","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_99","text":"Gunfire and explosions tear through the air, screams ripping from every corner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_100","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_100","text":"Freesia huddles beneath the podium, clutching her head, her own cries piercing the chaos.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_101","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_101","text":"And then, just like that, everything goes silent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s005_10_102","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_10_102","text":"Phew... almost bit the dust there.","jump":null,"exit":false,"ent