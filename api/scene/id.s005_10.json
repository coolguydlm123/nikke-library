null},{"id":"s005_10_117","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_117","text":"For a brief moment, that empty stare rests on Freesia, then returns to the grim task of sweeping up the remains.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_118","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_118","text":"Freesia collapses to the floor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_119","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_119","text":"A scream rises inside her, silent and raw.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_120","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_10_120","text":"No...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_121","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_10_121","text":"They've fallen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_122","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_10_122","text":"Not again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_123","type":"Speech","speaker":"pretty","key":"Locale_SideStory:s005_10_123","text":"No, not like this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_124","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_124","text":"The next day, Freesia cancels all her activities.