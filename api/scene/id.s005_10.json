ext":"Yeah, I'll take care of the performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_146","type":"Speech","speaker":"teacher","key":"Locale_SideStory:s005_10_146","text":"... All right, whenever you've got a song in mind, just send me a message.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_147","type":"Speech","speaker":"anis_human","key":"Locale_SideStory:s005_10_147","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_148","type":"Speech","speaker":"teacher","key":"Locale_SideStory:s005_10_148","text":"All right, that's it for today. Get home safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_149","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_149","text":"With that, class ends for the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_150","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_150","text":"Anis narrows her eyes, her gaze fixed on the back of the class president's head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_151","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_10_151","text":"Without so much as a glance, she hurriedly packs her bag and slips out of the classroom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_152","type":"Speech","speaker":"anis_human","key":"Locale_SideStory:s005_10_152","text":"... That piece of shit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_153","type":"Speech","speaker":"schoolgirl","key":"Locale_SideStory:s005_10_153","text":"A-Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_154","type":"Speech","speaker":"anis_human","key":"Locale_SideStory:s005_10_154","text":"Uh, yeah?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_155","type":"Speech","speaker":"schoolgirl","key":"Locale_SideStory:s005_10_155","text":"Wh-what song are you going to do? Pretty Star, right? It's her debut song, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_156","type":"Speech","speaker":"schoolgirl","key":"Locale_SideStory:s005_10_156","text":"I-I have footage of her live performance... so I'll send it to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_157","type":"Speech","speaker":"anis_human","key":"Locale_SideStory:s005_10_157","text":"Oh... Yeah, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_158","type":"Speech","speaker":"schoolgirl","key":"Locale_SideStory:s005_10_158","text":"Y-you move so well, Anis. You'll totally nail it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_10_159","type":"Speech","speaker":"schoolgirl","key":"Locale_SideStory:s005_10_159","text":"Are you going to sing too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,