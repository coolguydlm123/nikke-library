{"id":"event_cherryblossom_04_e","cat":"event","group":{"id":"ev40011","label":"CHERRY BLOSSOM"},"label":"Crackdown: B","stage":null,"prev":"event_cherryblossom_04_s","next":"event_cherryblossom_05_s","speakers":{"sakura":"Sakura","fatman":"Bulky Man","memberofseimeikai":"Seimeikai Member"},"icons":{"sakura":"si_c282_00_s","fatman":"si_c919_00_s","memberofseimeikai":"si_c921_00_s"},"lines":[{"id":"event_cherryblossom_04_e_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_cherryblossom_04_e_1","text":"A hail of gunfire is exchanged, and after a flurry of bullets...","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_cherryblossom_04_e_2","text":"The members of Seimeikai make short work of the opposition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_3","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_3","text":"Hmm... doesn't seem that they have any connection to Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":"Backstreet","bgArt":"backstreet","image":null,"bgm":null,"movie":null,"shown":["sakura","fatman"],"affinity":null},{"id":"event_cherryblossom_04_e_4","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_4","text":"This situation won't get any bigger than it already has, which is a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_5","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_5","text":"Argh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_6","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_6","text":"I knew I should have taken Heavenly Ascension's offer to lend us support.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_7","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_7","text":"If we had, hypocrites like you would think twice about stepping all over us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_8","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_9","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_9","text":"You're calling us hypocrites?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_10","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_10","text":"You go around blabbering about how you're the Underworld Queen and how you've got our best interests in mind,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_11","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_11","text":"but you're just the same as the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_12","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_12","text":"You use force to keep us down,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_13","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_13","text":"all because you want to keep us out of sight, out of mind!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_14","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_14","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_15","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_15","text":"We're fighting fire with fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_16","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_16","text":"That way, law-abiding citizens realize that we mean them no harm,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_17","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_17","text":"and they won't start any witch hunts against us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_18","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_18","text":"What a load of crap!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_19","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_19","text":"Witch hunts? Rules?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_20","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_20","text":"What does any of that matter to us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_21","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_21","text":"Does following the rules put food on our table?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_22","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_22","text":"We're not so different, you and us. Why does the outside have a ball with all these damn festivals, while we toil away in the dark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_23","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_23","text":"Why won't you let us speak up?! We want to be seen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_24","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_24","text":"Who cares if it's a lie?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_25","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_25","text":"In the grand scheme of things, you're an insignificant speck of dust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_26","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_26","text":"You're not capable of causing any real harm to anyone or anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_27","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_27","text":"What do you hope to do by injuring the pride of the Central Government?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_28","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_28","text":"What will change by ruining a festival that ordinary people get enjoyment out of?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_29","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_29","text":"If you make a fuss and end up facing off against the A.C.P.U., what will be waiting for you then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_30","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_30","text":"Shut up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_31","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_31","text":"Death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_32","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_32","text":"Complete and total destruction, devoid of any meaning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_33","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_33","text":"Is that what you want the ultimate fate of your organization to be? Everyone throwing their lives away without purpose?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_34","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_cherryblossom_04_e_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_35","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_35","text":"No matter how wretched and unjust the situation may be,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_36","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_36","text":"the moment you raise your weapons against innocent people,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_cherryblossom_04_e_37","type":"Speech","speaker":"sakura","key":"Locale_SubScenario:event_cherryblossom_04_e_37","text":"you defile your own message, and only leave violence