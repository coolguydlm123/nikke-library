null,"affinity":null},{"id":"event_icedragonsaga1_01_s_70","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_01_s_70","text":"Surely we must have crossed paths in the courts at least once...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_01_s_71","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_01_s_71","text":"Ah,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_01_s_72","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_01_s_72","text":"I understand now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_01_s_73","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_01_s_73","text":"I must have been transported to some kind of parallel dimension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_01_s_74","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_01_s_74","text":"At the very least, that would explain why you're walking around in such immodest dress when you're typically so buttoned up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_01_s_75","type":"Speech","speaker":"privaty_m","key":"Locale_MainScenario:event_icedragonsaga1_01_s_75","text":"Hey! Who are you calling immodest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragon