hown":null,"affinity":null},{"id":"d_contents_eden_09_67","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_67","text":"I think this is the first time, except for when you first got this body transplant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_68","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_68","text":"Back then, I thought you wouldn't make it, so it was hard to tell you if you were asleep or dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_69","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_69","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_70","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_70","text":"They really wanted to kill me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_71","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_71","text":"They inflicted injuries on me that were severe enough to be life-threatening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_72","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_72","text":"If it weren't for you, I would've died right there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_73","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_73","text":"Well, I owed you one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_74","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_74","text":"After all, you helped me escape from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_75","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_75","text":"I did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_76","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_76","text":"You certainly did. Your escape from the Rehabilitation Center distracted all the military.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_77","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_77","text":"That allowed me to slip out of the laboratory and head to the Outer Rim, where I took the Elevator up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_78","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_78","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_79","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_79","text":"Still, you're the last person I expected to run into on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_80","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_80","text":"At first, I wasn't sure if you'd ever move again,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_81","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_81","text":"but fortunately, you adapted well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_82","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_82","text":"Frankly, when we were treating you, our facilities were sorely lacking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_83","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_83","text":"We had to quickly create a mechanical body to treat you, with barely any time to consider its stability.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_84","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_84","text":"I was honestly a little worried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_85","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_85","text":"I wondered if you might just collapse and not get back up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_86","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_86","text":"That won't happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_87","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_87","text":"I still have things I have to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_88","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_88","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_89","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_89","text":"Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_90","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_eden_09_90","text":"Do you still dream of reclaiming the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_91","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_92","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_92","text":"Yes, I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_93","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_09_93","text":"I will make it a reality, no matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_09_94","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_eden_09_94","text":"'End of playback'","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}