ity":null},{"id":"d_nikke_rosanna_03_82","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_03_82","text":"Those two have found a way to maintain a sliver of their humanity in spite of our profession.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_03_83","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_03_83","text":"I can't say the same for myself. I crush whatever, or whoever displeases me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_03_84","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_03_84","text":"...","jump":null,"exit":false,"enter":null,"bg":"Restaurant","bgArt":"restaurant","image":null,"bgm":null,"movie":null,"shown":["rosanna"],"affinity":null},{"id":"d_nikke_rosanna_03_85","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_03_85","text":"That's why I wanted to make a clean break with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_03_86","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_03_86","text":"Even when we were no more than a Nikke and her commander, they sent hitmen after you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_03_87","type":"Speech","speaker":"rosanna","key":"Locale_NikkeEpisode:d_nikke_rosanna_03_87","text":"How much worse would it get if we became closer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rosanna_03_88","type":"Choice","speaker":null,"key":"Locale_NikkeEpisod