{"id":"d_main_21_01_s","cat":"main","group":{"id":"ch21","label":"Chapter 21 · Giant Whale"},"label":"Whale in the Sky: A","stage":"21-1 STAGE · Start","prev":null,"next":"d_main_21_01_e","speakers":{"anis":"Anis","neon":"Neon","rapi":"Rapi","cecil":"Cecil","Self":"Commander","harran":"Harran"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","cecil":"si_c929_00_s","harran":"si_c230_00_s"},"lines":[{"id":"d_main_21_01_s_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_1","text":"... Is that it?","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":["skymother"],"affinity":null},{"id":"d_main_21_01_s_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_2","text":"I think so. It certainly looks whale-like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_3","text":"Wow. You've got good eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_4","text":"Naturally. I don't wear these glasses to look pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_5","text":"Commander, is that our target?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_6","text":"I believe so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_7","text":"How should we proceed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_8","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_8","text":"First we bring it down, then we blow it out of the sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_9","text":"Okay... but how?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_10","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_10","text":"I know I always say my firepower could pierce a hole in the sky, but that's just a figure of speech...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_11","text":"We're not equipped to shoot down such a large transport aircraft, at least not one at that altitude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_12","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_12","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_13","text":"What is that thing anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_14","text":"Codename: Mother Whale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_15","text":"It's a massive transport aircraft that's been in use since the First Rapture Invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_16","text":"That long? It must be really old then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_17","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_17","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_18","text":"Shouldn't we be calling it Grandmother Whale then? Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_19","text":"Er... yeah, that's uh... real funny. Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_20","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_21","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_21","text":"Rapi, the least you could do is pretend like it was funny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_22","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_22","text":"... How highly humorous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_23","text":"... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_24","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_24","text":"It's clear that Mother Whale is still in service.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_25","text":"It can transport large quantities of materials by flying at high altitudes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_26","text":"It's still capable of its primary functions, that's why it's still active.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_27","text":"Not many of them were shot down during the initial invasion, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_28","text":"All right then, allow me to repeat my question from before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_29","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_29","text":"Master, what's our next course of action?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_30","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_30","text":"First we bring it down, then we blow it out of the sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_31","text":"Aren't you being a tad unrealistic? How can we possibly take down something that's waaaaaaaay up there?","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":null,"movie":null,"shown":["rapi","neon","anis"],"affinity":null},{"id":"d_main_21_01_s_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_32","text":"How come we're chasing after this thing anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_33","text":"Aren't we supposed to be looking for Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_34","text":"Yeah, we already used the only bullet we had on that big red meanie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_35","text":"And that didn't even work out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_36","text":"Sure, it looked like it hurt like the dickens, but it certainly didn't kill her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_37","text":"Yeah. I thought it'd cause a lot more damage, and she'd be screaming stuff like, \"Noooo, I can't die! This can't be the final resting place for a mighty Heretic!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_38","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_38","text":"... Anis, Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_39","text":"Oh, sorry. Was my acting a bit off?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_40","text":"No, it was spot on. Anyway, I hate to break up the fun,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_41","text":"and while it is nice sitting here watching a flying whale up in the sky,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_42","text":"we have more important things to take care of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_43","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_44","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_44","text":"As a matter of fact, I'm rather curious myself, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_45","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_01_s_45","text":"Is there any reason in particular that we're attempting to take down the Mother Whale?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_47","text":"2 days ago.","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_48","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_48","text":"... What did you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_cecil","movie":null,"shown":["cecil"],"affinity":null},{"id":"d_main_21_01_s_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_49","text":"Is there a way to make Vapaus bullets using my blood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_50","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_51","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_51","text":"It's possible, at least in theory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_52","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_52","text":"But I already told you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_53","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_53","text":"once you obtain that power,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_54","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_54","text":"there will be a whole lot of other people wanting to get their hands on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_55","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_01_s_55","text":"Not if it's kept a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_56","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_56","text":"You're someone of particular interest to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_57","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_57","text":"I would be fine with all of this if you weren't intending on using the bullets, but you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_58","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_58","text":"You'll be detected the moment you use that Vapaus. The entire Ark will know about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_59","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_60","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_61","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_61","text":"It looks like there's no use trying to change your mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_62","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_62","text":"Very well. If you insist on throwing yourself into the fire, I won't stop you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_63","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_63","text":"To be perfectly frank, this piques my interest as well. It's not every day you get a chance to make a Vapaus Bullet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_64","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_64","text":"I will need something, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_65","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_65","text":"You mean something else other than my blood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_66","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_66","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_67","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_01_s_67","text":"I need you to catch something for me—Codename: Mother Whale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_68","text":"Hey, Commander. Are you listening to me?","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"none","movie":null,"shown":["neon","anis"],"affinity":null},{"id":"d_main_21_01_s_69","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_69","text":"Sorry. Just follow my lead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_21_01_s_70","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_21_01_s_70","text":"I'll explain everything later. I promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_72","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_72","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_73","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_73","text":"Wowee, the Commander's keeping secrets!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_74","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_01_s_74","text":"I knew it. This happens whenever someone starts dating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_01_s_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_01_s_75","text":"Well, I suppose everyone living in the Ark has at least one or two dirty secrets.","jump":nu