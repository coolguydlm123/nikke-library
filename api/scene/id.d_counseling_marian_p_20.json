 up all the carbonated water we have in the fridge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_20_7","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_20_7","text":"When Anis opens them, it'll be like a fountain in her own home! She'll love it!","jump":"d_counseling_marian_p_20_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_20_8","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_20_8","text":"Oh, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_20_9","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_20_9","text":"Well... I just shook up all the carbonated water we have in the fridge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_20_10","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_20_10","text":"Why don't you go and try opening one up now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_20_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_marian_p_20_11","text":"As we ended our discussion, I started planning how to clean up the impending flood of carbonated water.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}