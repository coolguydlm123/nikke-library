{"id":"d_main_24_04","cat":"main","group":{"id":"ch24","label":"Chapter 24 · Banishment"},"label":"Queens","stage":"24-13 STAGE · Start","prev":"d_main_24_03","next":"d_main_24_05_s","speakers":{"Narration":"Narration","moran":"Moran","doban":"Doban","jin":"Jin","rosanna":"Rosanna","sakura":"Sakura","consigliere":"Consigliere","jackal":"Jackal","ingrid":"Ingrid","mustang":"Mustang","syuen":"Syuen"},"icons":{"Narration":"si_c999_00_s","moran":"si_c281_00_s","doban":"si_c939_00_s","jin":"si_c922_00_s","rosanna":"si_c280_00_s","sakura":"si_c282_00_s","consigliere":"si_c920_00_s","jackal":"si_c111_00_s","ingrid":"si_c900_00_s","mustang":"si_c902_00_s","syuen":"si_c901_00_s"},"lines":[{"id":"d_main_24_04_1","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_04_1","text":"Near the partition.","jump":null,"exit":false,"enter":null,"bg":"OuterrimWall","bgArt":"outerrimwall","image":null,"bgm":"bgm_story_facetoface","movie":null,"shown":["massproduction01","soldierfa","product08"],"affinity":null},{"id":"d_main_24_04_2","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_04_2","text":"*Slump*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_3","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_04_3","text":"The mass-produced Nikke topples to the ground, her energy spent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_4","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_4","text":"Next!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["moran"],"affinity":null},{"id":"d_main_24_04_5","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["doban"],"affinity":null},{"id":"d_main_24_04_6","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_6","text":"Wow, how many is that? It's gotta be at least 20 by now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["jin_op"],"affinity":null},{"id":"d_main_24_04_7","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_7","text":"Don't know. I haven't been keeping count.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_8","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_8","text":"I've gotta give it up to Doban. He's got some real guts taking you on himself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_9","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_9","text":"He probably could have sent in additional troops and wiped you out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_10","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_10","text":"I took a gamble, and it paid off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_11","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_11","text":"With Doban, it's all about pride. I knew there was no way he'd turn down a chance to face me head-on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_12","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_12","text":"Really? I always had the opposite impression.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_13","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_13","text":"He has no compunctions about using whatever low-down, dirty trick available to him. Wonder why that's changed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_14","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_14","text":"Beats me. Maybe he's just a moron.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_15","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_15","text":"Hahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_16","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_16","text":"If they all attack at once, I don't think I can hold out. Their Inhibitors have been deactivated, but mine hasn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_17","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_17","text":"Can't you ask Mustang to deactivate it for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_18","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_18","text":"His hands are full as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_19","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_19","text":"You of all people should know to have faith in your fellow comrades. We all have our roles to play.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_20","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_20","text":"It's all about having faith and counting on the best outcome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_21","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_21","text":"If I come crawling to Mustang, begging for him to deactivate my Inhibitor, I'd look like a major dork!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_22","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_22","text":"May I remind you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_23","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_23","text":"that the first to die are usually those preoccupied with looking 'cool'.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_24","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_24","text":"Stop mouthing off!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_25","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_25","text":"This is just a prediction, but I think Doban will lose his cool and retaliate soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_26","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_26","text":"Maybe it'd be best to get outta there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_27","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_27","text":"No, it should be okay. If I keep holding my ground, it should strike a major blow to Doban's ego.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_28","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_28","text":"You stupid idiots! What are you doing?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_29","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_29","text":"In what world does an army of Central Government-issued Nikkes fail to best a street urchin like her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_30","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_30","text":"This 'street urchin' doesn't take too kindly to being called names, so you better stop mouthing off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_31","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_31","text":"Argh! When are those infernal reinforcements coming?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_32","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_32","text":"What? We've lost contact? How is that even possible?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_33","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_33","text":"Very well then, it appears I have no choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_34","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_34","text":"All units, attack! Permission to use your weapons has been granted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_35","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_35","text":"Uh-oh. Sounds like things are about to get hectic over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["jin_op"],"affinity":null},{"id":"d_main_24_04_36","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_36","text":"The least you could do is show up and lend a hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_37","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_37","text":"I would, but it's just that I had a hip disc replaced yesterday, so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_38","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_38","text":"Oh, can it, will ya! Come here and help me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_39","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_39","text":"I told you, I'm all about gathering intel. I'm no fighter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_40","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_40","text":"So, I sent some reinforcements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_41","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_41","text":"Reinforcements?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_42","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_42","text":"Consider this my way of helping out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_43","type":"Speech","speaker":"jin","key":"Locale_MainScenario:d_main_24_04_43","text":"You've got this! Don't worry about me, I'm safe and sound over here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_44","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_44","text":"... I'm gonna kill you when this is all over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_45","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_04_45","text":"*Tadadadada*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_46","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_04_46","text":"Doban's troops fall to the ground in a hail of gunfire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_47","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_47","text":"What the...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_48","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_04_48","text":"Behind Doban's army, Rosanna is marching with her subordinates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rosanna","consigliere"],"affinity":null},{"id":"d_main_24_04_49","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_49","text":"It's been a minute since I jumped into the fray. It's exhausting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_50","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_50","text":"Rosanna!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_51","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_51","text":"Rosanna!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_52","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_52","text":"I know my own name, you two don't have to repeat it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_53","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_53","text":"Don't tell me you're the reinforcements...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_54","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_54","text":"Reinforcements? I don't know what you're talking about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_55","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_55","text":"Don't play dumb! There's no way my reinforcements could be this late. You have to be it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_56","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_56","text":"Oh, I get it. You must be referring to that bunch we encountered a while back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_57","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_57","text":"Like shooting fish in a barrel, that was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_58","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_58","text":"You should have put a sign on them or something. At least I'd have known they were meant to back you up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_59","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_59","text":"Maybe I wouldn't have given them such a spanking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_60","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_24_04_60","text":"All right, all right. You don't have to kick the poor man when he's down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["sakura","memberofseimeikai"],"affinity":null},{"id":"d_main_24_04_61","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_61","text":"Sakura?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_62","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_62","text":"That's rich coming from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_63","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_24_04_63","text":"Aren't you the one who loves getting a rise out of him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_64","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_64","text":"Arrrggghh!!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_65","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_24_04_65","text":"I don't deny that, but still...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_66","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_66","text":"Have the people in the Outer Rim laid down their arms?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_67","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_24_04_67","text":"Yes, every last one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_68","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_24_04_68","text":"They wouldn't listen at first, but after a little convincing, they came to agree with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_69","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_24_04_69","text":"I'm sure they did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_70","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_70","text":"The Underworld Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_71","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_71","text":"I thought they locked you all up and threw away the key. What are you doing here, and why are you standing in my way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_72","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_72","text":"Mustang is going to hear from me about this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_04_73","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_04_73","text":"He may not be working for the Central Government anymore, but if he think