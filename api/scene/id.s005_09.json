,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_51","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_51","text":"That should be all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_52","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_52","text":"I'll take my leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_53","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_09_53","text":"Hellhound Oswald, still playing soldier at your age?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_54","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_09_54","text":"I could bury you in an instant, but here you are, acting far too recklessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_55","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_55","text":"Go ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_56","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_56","text":"I've got nothing to lose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_57","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_09_57","text":"What about your daughter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_58","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_58","text":"You won't touch Freesia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_59","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_59","text":"I trust you're smarter than that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_60","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_09_60","text":"Uhm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_61","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_09_61","text":"Fine, I'll ask you one thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_62","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_09_62","text":"How'd it feel abandoning the Goddess Squad on the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s005_09_63","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_64","type":"Speech","speaker":"mustang_past","key":"Locale_SideStory:s005_09_64","text":"You did that, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_09_65","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_09_65","text":"... The Goddess Squad deserted after the Ark sealing operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,