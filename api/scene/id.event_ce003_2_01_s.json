_ce003_2_01_s_5","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_01_s_5","text":"Where?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_01_s_6","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_01_s_6","text":"That's the place we live in back in our world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_01_s_7","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_01_s_7","text":"Ram and Rem work inside the mansion, whereas I was there studying for the royal selection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_01_s_8","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_01_s_8","text":"I see. What kind of person is Roswaal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_01_s_9","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_01_s_9","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_01_s_10","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_01_s_10","text":"It's a bit hard to explain... Sometimes he seems weird, but other times he feels reliable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_01_s_11","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_01_s_11","text":"So great is his majesty, that it is impossible to put into words.","jump":null,"exit":false,"enter":null,"bg"