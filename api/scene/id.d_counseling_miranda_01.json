{"id":"d_counseling_miranda_01","cat":"counsel","group":{"id":"char5017","label":"Miranda"},"label":"Advising Miranda: 01","stage":null,"prev":null,"next":"d_counseling_miranda_02","speakers":{"miranda":"Miranda"},"icons":{"miranda":"si_c032_00_s"},"lines":[{"id":"d_counseling_miranda_01_1","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_1","text":"Commander! You really don't want to mess with Poli today!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["miranda"],"affinity":"_0"},{"id":"d_counseling_miranda_01_2","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_2","text":"You see, I was working hard, as usual...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_3","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_3","text":"But Poli got mad at me! She was in such a bad mood, I just had to get out of there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_4","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_4","text":"Now that I'm out of the office, I have no idea what to do! Any ideas?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_miranda_01_5","text":"Ask Poli to play with you.","jump":"d_counseling_miranda_01_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_miranda_01_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_miranda_01_6","text":"Tell Poli you're sorry.","jump":"d_counseling_miranda_01_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_miranda_01_7","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_7","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_8","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_8","text":"Great idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_9","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_9","text":"If Poli joins me, it may help her take a load off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_10","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_10","text":"You're so smart, Commander!","jump":"d_counseling_miranda_01_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_11","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_11","text":"I already tried that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_12","type":"Speech","speaker":"miranda","key":"Locale_Counseling:d_counseling_miranda_01_12","text":"She's still fuming, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_miranda_01_13","type":"Speech","speaker":"mira