mp":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_61","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom2_03_e_61","text":"You're the one who designed me. It's thanks to you that I possess these capabilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_62","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_62","text":"But you were the one who actually accomplished the feat. Not me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_63","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_64","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_64","text":"T.A.L.O.S.? Do you want to stay here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_65","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_65","text":"Chime can pilot you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_66","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_66","text":"I-I think that might be better. If you stay with me, you won't be able to reach your full potential.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_67","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_67","text":"With me, you'll be doomed to an undistinguished life of drudgery before inevitably being sent to the scrapheap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_68","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_68","text":"Staying here might be in your best interest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_69","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom2_03_e_69","text":"You are my only pilot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_70","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_70","text":"It's possible to change that. It might be somewhat complicated, but far from impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_71","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom2_03_e_71","text":"It is possible, but I do not wish to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_72","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_72","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_73","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom2_03_e_73","text":"Because I do not wish for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_74","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_74","text":"And if I order you to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_75","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom2_03_e_75","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_76","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom2_03_e_76","text":"Processing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_77","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_77","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_78","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_lastkingdom2_03_e_78","text":"Processing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_79","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_80","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_80","text":"I doubt I need to point this out, but we'll never win this fight through attrition.","jump":null,"exit":false,"enter":null,"bg":"CrownCastleFrontYard_d","bgArt":"crowncastlefrontyard_d","image":null,"bgm":"event_bgm_lastkingdom_tothelast","movie":null,"shown":["chime","crown","snowwhite","hongryeon","rapunzel"],"affinity":null},{"id":"event_lastkingdom2_03_e_81","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_81","text":"We need a way to defeat the enemy commander or wipe out the Raptures en masse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_82","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_82","text":"However, with our current forces, that might pose a challenge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_83","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_83","text":"Therefore, we will remain in this location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_84","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_lastkingdom2_03_e_84","text":"We will?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_85","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_85","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_86","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_86","text":"As some of you may know, this place used to be a tourist attraction in the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_87","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_87","text":"It was constructed on an artificial island.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_88","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_88","text":"Over the past hundred years, however, all the detritus has piled up and formed a sort of ersatz landmass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_89","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_89","text":"This newly formed ground, which connects us to the mainland is, however, quite unstable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_90","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_90","text":"When I infiltrated the enemy ranks to observe their movements, I could feel it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_91","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_91","text":"The ground sunk beneath my feet and had a lot of give to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_92","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_92","text":"If that many Raptures were to congregate in one space, the ground would be unable to sustain their weight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_93","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_93","text":"So, our plan is as follows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_94","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_94","text":"We will cause all the ground in front of the walls to collapse, save for that directly in front of the main gate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_95","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_95","text":"This way, the only pathway inside the kingdom will be through the main gate,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_96","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_96","text":"allowing us to concentrate all our efforts on one singular location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_97","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_97","text":"We will then face the enemy head on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_98","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_98","text":"You mean we're going to engage with those things directly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_99","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_99","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_100","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_100","text":"But they have airborne units, and not to mention how the Heretic and the special individual can leap over walls entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_101","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_101","text":"Even if we do reduce the entrance to just the main gate, our defenses are hardly airtight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_102","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_102","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_103","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_103","text":"They underestimate us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_104","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_104","text":"At the moment, their main desire is to toy with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_105","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_105","text":"If we bring the fight to them and take them head on, they'll be forced to take us seriously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_106","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_106","text":"Their overwhelming desire would then be to crush us, to obliterate us for not playing our part as the weakling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_107","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_107","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_108","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_108","text":"All right. Any questions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_109","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_109","text":"What if...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_110","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_110","text":"We can't withstand a direct confrontation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_111","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom2_03_e_111","text":"That's not possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_112","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_lastkingdom2_03_e_112","text":"We will never lose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_113","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_lastkingdom2_03_e_113","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_114","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_lastkingdom2_03_e_114","text":"'Tis but a foregone conclusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_115","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_lastkingdom2_03_e_115","text":"In fact, the situation is rather in our favor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_116","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_116","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_117","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_117","text":"Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_118","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_118","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_119","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_119","text":"You and T.A.L.O.S. work together to produce some explosives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_120","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_120","text":"We'll be installing them along the entire run of the castle wall, so we'll need quite a few.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_121","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_121","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_122","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_lastkingdom2_03_e_122","text":"I'll provide the gunpowder. There's still plenty left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_123","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_123","text":"Okay. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_124","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_124","text":"Let's move quickly. We don't have much time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_125","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_lastkingdom2_03_e_125","text":"Your Highness isn't feeling well, and I'm also worried about Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_126","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_126","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_127","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_127","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_128","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_128","text":"Um, before we spring into action,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lastkingdom2_03_e_129","type":"Speech","speaker":"kilo","key":"Locale_MainScenario:event_lastkingdom2_03_e_129","text":"could I talk to Crown for a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}