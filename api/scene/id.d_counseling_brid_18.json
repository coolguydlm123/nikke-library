{"id":"d_counseling_brid_18","cat":"counsel","group":{"id":"char5018","label":"Brid"},"label":"Advising Brid: 18","stage":null,"prev":"d_counseling_brid_17","next":"d_counseling_brid_19","speakers":{"brid":"Brid"},"icons":{"brid":"si_c070_00_s"},"lines":[{"id":"d_counseling_brid_18_1","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_1","text":"A few days ago, I heard that Talentum Mall has new investment products.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["brid"],"affinity":"_0"},{"id":"d_counseling_brid_18_2","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_2","text":"They claimed it could drastically increase any Nikke's salary, and asked whether I was interested.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_3","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_3","text":"Commander, do you tend to jump at new challenges that present themselves?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_4","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_4","text":"Or do you prefer to play it safe and not risk it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_brid_18_5","text":"I often take on challenges.","jump":"d_counseling_brid_18_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_brid_18_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_brid_18_6","text":"I prefer to play it safe.","jump":"d_counseling_brid_18_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_brid_18_7","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_7","text":"I thought so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_8","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_8","text":"That's why you're always heading up to the surface even when reclaiming it is by no means a certainty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_9","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_9","text":"But taking on too many challenges could cause you to lose everything,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_10","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_10","text":"so I hope you don't overexert yourself and end up worse off for it.","jump":"d_counseling_brid_18_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_11","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_11","text":"That's surprising. I thought it would be the other way around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_12","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_12","text":"To be honest, I tend to play things safe as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_13","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_13","text":"For me, the risk of losing everything I have","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_14","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_18_14","text":"is not worth any potential profits I could gain from going out on a limb.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_18_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_brid_18_15","text":"Brid and I talk a little more about taking on new challenges.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}