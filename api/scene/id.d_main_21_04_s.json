{"id":"d_main_21_04_s","cat":"main","group":{"id":"ch21","label":"Chapter 21 · Giant Whale"},"label":"Secret and Truth: A","stage":"21-12 STAGE · Start","prev":"d_main_21_03_e","next":"d_main_21_04_e","speakers":{"Self":"Commander","johan":"Johan","cecil_op_l":"Cecil"},"icons":{"johan":"si_c925_00_s","cecil_op_l":"si_c929_00_s"},"lines":[{"id":"d_main_21_04_s_1","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_1","text":"Johan.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_intotheswarm_a","movie":null,"shown":["johan"],"affinity":null},{"id":"d_main_21_04_s_2","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_2","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_3","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_3","text":"Aren't we supposed to be tracking down Nihilister?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_4","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_4","text":"... We couldn't kill her even when we used Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_5","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_5","text":"All we did was damage her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_6","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_6","text":"Fortunately, we did enough damage to render her immobile for a while. She'll need some time to recover from that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_7","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_7","text":"You saw how fast that thing soars through the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_8","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_8","text":"If she decides to steer clear of us, there's not much we can do about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_9","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_9","text":"So you're just helping me in your spare time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_10","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_10","text":"Time is the one thing I don't have enough of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_11","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_11","text":"I'm doing this because Mother Whale could prove useful to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_12","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_12","text":"It wasn't built to search and destroy. It's only equipped with a rudimentary armament. This thing is meant to transport cargo, and that's it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_13","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_13","text":"It's not exactly a major threat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_14","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_14","text":"That means so long as we're able to drag it down to the ground, it should be easy pickings for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_15","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_15","text":"It should provide us with plenty of resources.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_16","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_17","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_17","text":"... Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_18","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_18","text":"That's right. The main building blocks of Eden are Rapture parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_19","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_19","text":"With the supplies on that ship, we could last for eons, not to mention the parts that we could scavenge from it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_20","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_20","text":"Who made Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_21","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_21","text":"Cecil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_22","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_22","text":"She designed and built it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_23","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_23","text":"... Amazing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_24","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_24","text":"You won't find me arguing with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_25","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_25","text":"I appreciate you saying that, Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_l"],"affinity":null},{"id":"d_main_21_04_s_26","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_27","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_27","text":"I may be late to the party, but better late than never.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_28","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_28","text":"Now, you two were going on about how amazing I was?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_29","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_30","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_30","text":"I see. You must be left speechless in the presence of such perfection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_31","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_31","text":"Did you prepare what I wanted?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_32","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_32","text":"It'll take a while longer. I should have it ready by the time you're finished with all the cannons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_33","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_33","text":"Sounds good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_34","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_34","text":"What are you preparing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_35","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_35","text":"A bullet that will take down Mother Whale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_36","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_36","text":"You sure are well-prepared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_37","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_38","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_38","text":"... Aren't you going to ask me why I'm going after Mother Whale?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_39","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_39","text":"Isn't it obvious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_40","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_40","text":"I may not know all the details, but it's clearly something related to Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_41","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_41","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_42","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_42","text":"Let me give you a word of advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_43","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_43","text":"Work on your poker face. Don't wear your heart on your sleeve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_44","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_44","text":"Especially if you plan on continuing living in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_45","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_45","text":"If I were to get my hands on Vapaus, what are you planning on doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_46","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_46","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_47","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_47","text":"You need to work on how you speak as well. Don't make your intentions so glaringly obvious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_48","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_48","text":"We've already confirmed that a single shot of Vapaus can't neutralize a Heretic on its own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_49","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_49","text":"It can slow them down, but it won't put them down for the count.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_50","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_50","text":"We need to look into this further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_51","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_51","text":"While we're on the topic, let me ask you something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_52","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_52","text":"I heard that the Vapaus you shot brought back the Heretic to normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_53","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_53","text":"What's the story behind that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_54","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_54","text":"... We missed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_55","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_55","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_56","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_56","text":"You missed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_57","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_57","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_58","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_58","text":"How convenient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_59","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_59","text":"... Perhaps you wanted to miss from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_60","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_60","text":"No, that can't be it. How would that explain the past reports that the Heretic was incapacitated by Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_61","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_62","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_62","text":"It might be that Vapaus has varying effects in different forms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_63","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_63","text":"Is there any difference between the previous Heretic and the current one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_64","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_64","text":"None whatsoever. They're both built of the same materials.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_65","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_65","text":"You're referring to nanomachines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_66","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_66","text":"Yes. As long as Vapaus can terminate the nanomachines, it will be fatal to Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_67","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_67","text":"Right. That must be it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_68","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_68","text":"So those bullets we got from the research center...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_69","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_69","text":"Are of subpar quality. That's my theory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_70","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_70","text":"Do we have any additional information on those bullets?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_71","type":"Speech","speaker":"cecil_op_l","key":"Locale_MainScenario:d_main_21_04_s_71","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_72","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_72","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_73","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_73","text":"Then I will answer the question you asked me a while ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_74","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_74","text":"If that Vapaus you've got in your hands performs better than the others,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_75","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_75","text":"I'll take it for myself. If it doesn't stack up, then I won't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_76","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_04_s_76","text":"You'll have to pry it from my cold, dead hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_04_s_77","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_04_s_77","text":"Let's hope it doesn't come to that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}