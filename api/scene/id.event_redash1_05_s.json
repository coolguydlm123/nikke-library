edash1_05_s_51","text":"... I feel personally attacked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_05_s_52","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_05_s_52","text":"That concludes our battle preparation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_05_s_53","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_05_s_53","text":"Our ammo is more than sufficient, and everyone appears to be in optimal condition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_05_s_54","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_05_s_54","text":"All that's left is to head into the fray.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_05_s_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_redash1_05_s_55","text":"Everyone nods in acknowledgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_05_s_56","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_05_s_56","text":"In that case, let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_05_s_57","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_05_s_57","text":"We've still got a few moments to spare. Dorothy, Scarlet, any chance I could talk to you two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown