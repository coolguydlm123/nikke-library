{"id":"msg_m_ex_naga_01","cat":"messenger","group":{"id":"room_naga","label":"Naga · Nikke"},"label":"1. Hello there, Teacher.","stage":null,"prev":null,"next":"msg_m_ex_naga_02","speakers":{"naga":"Naga"},"icons":{"naga":"si_c450_00_s"},"lines":[{"id":"m_ex_naga_01_1","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_1","text":"Hello there, Teacher.","jump":null},{"id":"m_ex_naga_01_2","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_2","text":"Oh, sorry.","jump":null},{"id":"m_ex_naga_01_3","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_3","text":"I should introduce myself first.","jump":null},{"id":"m_ex_naga_01_4","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_4","text":"I'm a student from the M.M.R. Vocational School,","jump":null},{"id":"m_ex_naga_01_5","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_5","text":"and you might know my classmate Tia.","jump":null},{"id":"m_ex_naga_01_6","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_6","text":"Also, I'm a member of Dazzling Pearl.","jump":null},{"id":"m_ex_naga_01_7","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_7","text":"I'm sure Tia has been quite a handful for you,","jump":null},{"id":"m_ex_naga_01_8","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_8","text":"but thanks for taking such good care of her.","jump":null},{"id":"m_ex_naga_01_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_naga_01_9","text":"Are you Tia's mother?","jump":"m_ex_naga_01_11"},{"id":"m_ex_naga_01_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_naga_01_10","text":"Don't mention it.","jump":"m_ex_naga_01_17"},{"id":"m_ex_naga_01_11","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_11","text":"???","jump":null},{"id":"m_ex_naga_01_12","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_12","text":"LOL","jump":null},{"id":"m_ex_naga_01_13","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_13","text":"I hear that all the time.","jump":null},{"id":"m_ex_naga_01_14","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_14","text":"I mean, I do enjoy looking after Tia,","jump":null},{"id":"m_ex_naga_01_15","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_15","text":"but we're just friends.","jump":null},{"id":"m_ex_naga_01_16","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_16","text":"To call me her mother would be a bit much.","jump":"m_ex_naga_01_23"},{"id":"m_ex_naga_01_17","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_17","text":"My word!","jump":null},{"id":"m_ex_naga_01_18","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_18","text":"You certainly live up to your reputation, Teacher.","jump":null},{"id":"m_ex_naga_01_19","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_19","text":"You're always so caring.","jump":null},{"id":"m_ex_naga_01_20","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_20","text":"It's no wonder everyone is such a big fan of yours!","jump":null},{"id":"m_ex_naga_01_21","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_21","text":"Myself included, of course.","jump":null},{"id":"m_ex_naga_01_22","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_22","text":"Hehe.","jump":null},{"id":"m_ex_naga_01_23","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_23","text":"Gah!","jump":null},{"id":"m_ex_naga_01_24","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_24","text":"KLJ!#rj11r3f","jump":null},{"id":"m_ex_naga_01_25","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_25","text":"asl;dkfj130","jump":null},{"id":"m_ex_naga_01_26","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_26","text":"ASDL;FKJ10","jump":null},{"id":"m_ex_naga_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_naga_01_27","text":"???","jump":null},{"id":"m_ex_naga_01_28","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_28","text":"Oh, sorry.","jump":null},{"id":"m_ex_naga_01_29","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_29","text":"Tia wanted to look at my phone and pounced on me.","jump":null},{"id":"m_ex_naga_01_30","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_30","text":"So I made some typos while trying to get her off me.","jump":null},{"id":"m_ex_naga_01_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_naga_01_31","text":"Like you said, she's a real handful.","jump":null},{"id":"m_ex_naga_01_32","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_32","text":"She is, but it's okay.","jump":null},{"id":"m_ex_naga_01_33","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_33","text":"I don't find it exhausting since","jump":null},{"id":"m_ex_naga_01_34","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_34","text":"I'm happy being around her.","jump":null},{"id":"m_ex_naga_01_35","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_35","text":"Tia is like family to me.","jump":null},{"id":"m_ex_naga_01_36","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_36","text":"If I didn't have her in my life, I'd feel empty inside.","jump":null},{"id":"m_ex_naga_01_37","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_37","text":"The same goes for you too,","jump":null},{"id":"m_ex_naga_01_38","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_38","text":"Teacher.","jump":null},{"id":"m_ex_naga_01_39","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_39","text":"I hope we can meet more often in the future.","jump":null},{"id":"m_ex_naga_01_40","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_40","text":"Hahahahaha!","jump":null},{"id":"m_ex_naga_01_41","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_41","text":"Oh my!","jump":null},{"id":"m_ex_naga_01_42","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_42","text":"There goes the school bell.","jump":null},{"id":"m_ex_naga_01_43","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_43","text":"I guess it's time for class.","jump":null},{"id":"m_ex_naga_01_44","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_44","text":"Like they say, time flies when you're having fun!","jump":null},{"id":"m_ex_naga_01_45","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_45","text":"Catch you later,","jump":null},{"id":"m_ex_naga_01_46","type":"Speech","speaker":"naga","key":"Locale_SuddenMessage:m_ex_naga_01_46","text":"Teacher.","jump":null}],"chat":true}