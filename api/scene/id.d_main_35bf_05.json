ario:d_main_35bf_05_28","text":"I'm not resigning! Why would I do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_29","text":"... I like it here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_30","text":"Wow, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_31","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_31","text":"You said you had something you wanted to take care of, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_32","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_33","text":"If I don't see it through to the end, I'll be perpetually spinning my wheels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_34","text":"There's also something that Cinderella said to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_35","text":"Was it, \"Anis is butt ugly?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_36","text":"No. Now shut it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_37","text":"Okay, fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_38","text":"Anyway, I'm not sure how long it will take to resolve, so I think I should simply step back for a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_39","text":"Is that okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_41","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_42","text":"To be honest, this entire situation doesn't make much sense to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_monochrome","movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_43","text":"Huh? What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_44","text":"Why aren't you considering the option of us helping?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_45","text":"Is there anything we can do to lend a hand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_46","text":"Of course there is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_47","text":"If you could help, that'd be amazing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_48","text":"But Rapi has powered up, and your reputation is growing by the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_49","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_49","text":"The next step you all take will be a vital one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_50","text":"It'd be unfair of me to hold you all back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_51","text":"Hold us back? Why would you say such a thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_52","text":"Think about it, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_53","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_53","text":"Are Neon and I really contributing anything right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_54","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_54","text":"Huh? Why'd I get lumped in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_55","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_55","text":"Of course you're helpful. What are you saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_56","text":"No, we're not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_57","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_57","text":"I'm not stupid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_58","text":"I'll come back once I've settled everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_59","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_59","text":"Let me do this? Please?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_60","text":"I still don't understand why you won't let us help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_61","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_61","text":"It would be faster if we all...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_62","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_62","text":"How much longer","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_63","text":"do I have to drag you all down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_64","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_65","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_65","text":"To not only be useless up on the surface, but require help when we're back in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_66","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_66","text":"Do you realize how humiliating that would be for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_67","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_67","text":"I want to have a shred of dignity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_68","text":"I want to solve this on my own, and then make a grand entrance when you actually need me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_69","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_69","text":"Aren't we comrades?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_70","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_70","text":"Yes, we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_71","text":"It's precisely because we're comrades that I want to be your equal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_72","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_72","text":"I don't want to hold you back, or be around only to ask for your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_73","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_73","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_74","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_74","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_75","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_75","text":"Rapi, what are y...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_76","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_76","text":"Only on one condition, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_77","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_77","text":"When you come back, you better be so incredible that it leaves us speechless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_78","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_78","text":"... It's a deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_79","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_80","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_80","text":"Oooh! I wanna go too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_81","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_81","text":"Huh? Go where?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_82","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_82","text":"With you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_83","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_83","text":"What the... Have you listened to a single word I've said?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_84","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_84","text":"I dunno. At any rate, I want to go with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_85","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_85","text":"To be honest, I'm worried about you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_86","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_86","text":"It's like letting a rabid dog loose without a leash, you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_87","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_87","text":"Who are you calling a rabid dog?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_88","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_88","text":"Will that be all right, Master? Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_89","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_89","text":"You too, Neon? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_90","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_90","text":"I'm worried about Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_91","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_91","text":"Whereas I know that you two can handle yourselves no problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_92","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_92","text":"Is it okay with you if I tag along and help out Anis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_93","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_94","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_94","text":"Fine. Go ahead and lend assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_95","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_95","text":"It will make me feel better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_96","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_35bf_05_96","text":"Woohoo!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_97","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_97","text":"I can't allow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_98","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_98","text":"Hurry up and eat, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_99","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_99","text":"The food is getting cold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_100","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_100","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_101","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_101","text":"I'm sorry, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_102","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_35bf_05_102","text":"Thank you, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_103","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_103","text":"I angrily shove a meatball into my mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_104","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_104","text":"... It tastes horrible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_105","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_105","text":"... Sorry about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_106","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_106","text":"Where are Anis and Neon?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom_n","bgArt":"commanderroom_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_107","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_107","text":"They're sleeping. At least that's what it looks like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_108","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_108","text":"I didn't expect you to side with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_109","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_109","text":"I know all too well what it feels like to be left behind and powerless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_110","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_110","text":"And if I'm being brutally honest,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_111","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_111","text":"Anis and Neon don't particularly factor into our offensive strategy at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_112","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_112","text":"If they stayed with us solely out of a sense of duty as squadmates,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_113","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_113","text":"their self-esteem would inevitably hit rock bottom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_114","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_114","text":"I think they want to prove themselves to us,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_115","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_115","text":"and it seems like they have something in mind to make that happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_116","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_116","text":"It's unfortunate that we can't be witness to that, or help them through it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_117","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_117","text":"but everyone has their own way of doing things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_118","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_118","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_119","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_119","text":"We have to believe in them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_120","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_120","text":"... You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_121","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_121","text":"Come. Let's get some sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_122","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_122","text":"We're back in our familiar beds, so we should sleep better than we have in a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_123","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_123","text":"Yeah. Good night, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_124","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_124","text":"You too, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_125","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_125","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_126","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_126","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_127","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_127","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_128","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35bf_05_128","text":"Are you going to stay here all night?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_129","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_129","text":"Oh, sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_130","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_130","text":"I thought we were having a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35bf_05_131","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35bf_05_131","text":"I'll leave now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}