{"id":"d_counseling_mary_20","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 20","stage":null,"prev":"d_counseling_mary_19","next":null,"speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_20_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_1","text":"Medical staff always have to put on a happy face when they're in front of patients.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_20_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_2","text":"But I'm not sure I agree with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_3","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_3","text":"Who's to say how someone should act in front of others?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_4","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_4","text":"On that note, what traits do you look for in a person, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_20_5","text":"Selflessness","jump":"d_counseling_mary_20_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_20_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_20_6","text":"Being down-to-earth.","jump":"d_counseling_mary_20_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_20_7","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_7","text":"So... someone who thinks about others more than themselves?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_8","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_8","text":"I suppose a lot of people find that admirable.","jump":"d_counseling_mary_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_9","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_9","text":"Wow, your standards are a bit different compared to other people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_10","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_10","text":"Nevertheless, I appreciate your honesty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_11","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_20_11","text":"I'll try and be more true to myself when treating you as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_20_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_20_12","text":"Mary and I talk about what makes an ideal medical professional.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}