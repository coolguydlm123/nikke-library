x her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_14","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_14","text":"And we won.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_15","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_15","text":"We played our part in the Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_16","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_16","text":"Now we don't have to worry about getting fired, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_17","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_50_af_04_17","text":"And we won't have to do fundraising events either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_18","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_18","text":"We don't even have to clean the deck!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_19","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_19","text":"Yes. We proved ourselves. We no longer need to fundraise. We do need to clean the deck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_20","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_20","text":"Aww...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_21","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_21","text":"This is all thanks to you, Subordinate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_22","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_22","text":"Thank you so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_04_23","text":"We all did it together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_04_24","text":"Is Aegis finally going to explore the seas?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_25","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_25","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_26","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_26","text":"We've already received our next mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_27","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_27","text":"What was it again? I heard we're doing something or other with a port.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_28","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_50_af_04_28","text":"Exactly. We're doing something or other with a port.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_29","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_29","text":"... We're going to work with Mighty Tools to repair the nearest sea port to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_30","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_30","text":"That will become the base for Aegis and the Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_31","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_31","text":"But what exactly are we going to do there? Do we just dock our ship and plunder passing vessels?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_32","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_32","text":"We're not pirates. There won't even be any passing vessels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_33","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_33","text":"We need a port in order so we can cross the ocean and expand our territory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_34","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_34","text":"We're going to be the vanguard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_35","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_50_af_04_35","text":"Why do we need to expand our territory?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_36","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_36","text":"Collecting resources is the biggest reason at the moment. There's a lot that the Ark needs right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_37","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_37","text":"There might even be a city across the ocean that we can use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_38","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_38","text":"In other words, an age of exploration is upon us!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_39","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_50_af_04_39","text":"Yoho, hoist the sails.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_40","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_40","text":"Well... it's more like scouting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_41","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_41","text":"Now, we've rested for long enough. Let's go back and help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_42","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_42","text":"Can't we have a glass of rum with Captain first? Let's toast to victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_43","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_50_af_04_43","text":"I'll make snacks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_44","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_44","text":"No. Save it for later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_45","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_50_af_04_45","text":"Aww... Can't we relax a little now? We did win...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_46","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_50_af_04_46","text":"Yeah, we were a big part of it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_47","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_50_af_04_47","text":"See you later, Subordinate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_48","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_04_48","text":"See you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_04_49","text":"Aegis Squad walks over to the Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_04_50","text":"I turn to look at the AZX.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_04_51","text":"Its surface is badly dented, and it's lying in two halves on the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_52","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_04_52","text":"Are you guys okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_04_53","type":"Speech","speaker":"soline","key":"Locale_MainScenario:d_main_50_af_04_53","text":"Yeah. We're fine. We're all a bit hurt, but compared to the AZX...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["brid","diesel","soline"],"affinity":null},{"id":"d_main_50_af_04_54","type":"Speech","speaker":"brid","key":"Locale_MainScenario:d_main_50_af_04_54","text":"I'm sorry we couldn't bring you to your destination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bg