{"id":"d_counseling_rapi_10","cat":"counsel","group":{"id":"char3001","label":"Rapi"},"label":"Advising Rapi: 10","stage":null,"prev":"d_counseling_rapi_09","next":"d_counseling_rapi_11","speakers":{"rapi":"Rapi"},"icons":{"rapi":"si_c010_00_s"},"lines":[{"id":"d_counseling_rapi_10_1","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_10_1","text":"I'm not a picky eater, but having the same thing several days in a row can get tiring.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rapi"],"affinity":"_0"},{"id":"d_counseling_rapi_10_2","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_10_2","text":"However, given our current food situation, I shouldn't complain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_10_3","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_10_3","text":"What do you think I should do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_10_4","text":"Complain while you eat.","jump":"d_counseling_rapi_10_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rapi_10_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_10_5","text":"Just grin and bear it.","jump":"d_counseling_rapi_10_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rapi_10_6","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_10_6","text":"I see. If things aren't going to change anyway, there's no harm in letting off some steam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_10_7","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_10_7","text":"It will be a nice way to vent. Thank you, Commander.","jump":"d_counseling_rapi_10_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_10_8","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_10_8","text":"You mean to say that, if we're powerless to change something, then we should just accept it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_10_9","type":"Speech","speaker":"rapi","key":"Locale_Counseling:d_counseling_rapi_10_9","text":"Very well. That's what I've been doing up until now, anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapi_10_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_rapi_10_10","text":"I talk about food preferences with Rapi.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}