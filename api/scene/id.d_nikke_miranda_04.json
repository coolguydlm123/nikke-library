kkeEpisode:d_nikke_miranda_04_75","text":"What? You'd risk your life...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_04_76","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_04_76","text":"What are you talking about?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_04_77","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_04_77","text":"I look at the bomb again,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_04_78","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_04_78","text":"and see a red line and a blue line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_04_79","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_04_79","text":"Somehow, I feel like the timer will stop if I cut one of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_04_80","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_miranda_04_80","text":"Let's cut one of the lines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_04_81","type":"Speech","speaker":"miranda","key":"Locale_NikkeEpisode:d_nikke_miranda_04_81","text":"Y-you mean you want to mess with the bomb?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_miranda_04_82","type":"Speech","speaker":"miranda","