{"id":"d_main_14_08","cat":"main","group":{"id":"ch14","label":"Chapter 14 · Journey"},"label":"Face-To-Face","stage":"14-18 STAGE · End","prev":"d_main_14_07","next":"d_main_14_09","speakers":{"privaty":"Privaty","anis":"Anis","rapi":"Rapi","yulha":"Yulha","admi":"Admi","shifty":"Shifty","andersen_op":"Andersen","andersen_op_r":"Andersen","burningum_op":"Burningum"},"icons":{"privaty":"si_c170_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","yulha":"si_c171_00_s","admi":"si_c172_00_s","shifty":"si_c907_00_s","andersen_op":"si_c903_00_s","andersen_op_r":"si_c903_00_s","burningum_op":"si_c914_00_s"},"lines":[{"id":"d_main_14_08_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_14_08_1","text":"Numerous mass-produced Nikkes block our path.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"none","movie":null,"shown":["triangle_event"],"affinity":null},{"id":"d_main_14_08_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_14_08_2","text":"This is the Triangle Squad's doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_3","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_3","text":"Stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_destinedtofight","movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_08_4","text":"You followed us all the way up here.\nYou're nothing if not tenacious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_08_5","text":"I see you brought along some friends.\nYour squad is looking more Nikke than it does human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_6","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_7","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_7","text":"Additional charges have been leveled against the Nikke Marian: conspiring with Raptures and assaulting a fellow Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_8","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_8","text":"The Central Government considers these felonies and has called for her immediate arrest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_9","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_9","text":"In the process of securing Marian,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_10","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_10","text":"we have been ordered to eliminate everyone except the target.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_11","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_11","text":"Come with us. This is your last warning. Resistance is futile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_08_12","text":"Why are you doing all of this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_13","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_13","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_08_14","text":"You know perfectly well that none of this makes any sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_08_15","text":"Or do you just follow any orders from the Central Government, no questions asked?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_16","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_17","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_17","text":"Yes. Any proud squad should behave this way, Triangle included.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_08_18","text":"They say jump, and you say how high. You call that pride?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_19","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_19","text":"You little...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_20","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_20","text":"Privaty.","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":null,"movie":null,"shown":["privaty","rapi","yulha","admi"],"affinity":null},{"id":"d_main_14_08_21","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_21","text":"No need to get worked up.\nLet's just do what we came here to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_22","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_22","text":"Arguments aren't your forte. You always let people get your goat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_23","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_23","text":"... Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_24","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_24","text":"I don't want to kill you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_25","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_25","text":"Surrender.\nIf you just hand over Marian, nothing will happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_08_26","text":"That's not for me to decide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_27","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_27","text":"Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_28","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_28","text":"Please talk to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_14_08_29","text":"What happens to Marian if we hand her over?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_30","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_30","text":"She'll be under the protection of the Central Government, where...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_31","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_31","text":"They will dissect her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_32","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_32","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_33","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_33","text":"Admi, don't tell them any more than is necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_34","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_34","text":"Marian is a rare case, unlike anything we've seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_35","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_35","text":"She was fused with a Rapture and then became a Nikke once again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_36","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_36","text":"Simple examinations have already shown that her physical capabilities exceed those of standard Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_37","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_37","text":"There are four black boxes inside her. With current Ark technology, we're unable to penetrate even their primary firewall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_38","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_38","text":"Dissection is the natural course of action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_39","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_40","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_40","text":"That won't be all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_41","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_41","text":"They will tear her down to every individual component.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_42","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_42","text":"Many have predicted that Marian will advance Ark technology by a century.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_43","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_43","text":"Her importance cannot be overstated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_44","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_44","text":"That's enough!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_45","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_45","text":"... I think you may have said too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_46","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_46","text":"I'm sorry,\nbut I didn't want to lie to the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_47","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_47","text":"That... goes for me as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_48","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_48","text":"So, what are you going to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_14_08_49","text":"We will never hand over Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_50","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_50","text":"I figured as much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_51","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_51","text":"Privaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_52","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_53","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_53","text":"Troops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_54","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_54","text":"Prepare for battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_55","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_55","text":"The use of live ammunition is permitted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_56","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_56","text":"Your top priority is securing the target, Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_57","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_57","text":"Everyone else is expendable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_58","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_08_58","text":"... Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_14_08_59","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_08_59","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_60","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_60","text":"Encounter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_08_61","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_14_08_61","text":"Attention all troops!\nStand down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_14_08_62","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_08_62","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":