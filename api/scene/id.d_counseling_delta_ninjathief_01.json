{"id":"d_counseling_delta_ninjathief_01","cat":"counsel","group":{"id":"char5154","label":"Delta: Ninja Thief"},"label":"Advising Delta: Ninja Thief: 01","stage":null,"prev":null,"next":"d_counseling_delta_ninjathief_02","speakers":{"delta_n":"Delta"},"icons":{"delta_n":"si_c023_00_s"},"lines":[{"id":"d_counseling_delta_ninjathief_01_1","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_01_1","text":"The way of the phantom thief is indeed profound.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["delta_n"],"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_01_2","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_01_2","text":"As a trainee ninja thief, I am concerned about whether I'm performing adequately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_01_3","type":"Speech","speaker":"delta_n","key":"Locale_Counseling:d_counseling_delta_ninjathief_01_3","text":"I continue to ponder how best to fulfill a phantom thief's duties properly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_delta_ninjathief_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_01_4","text":"Just act in the name of justice.","jump":"d_counseling_delta_ninjathief_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_delta_ninjathief_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_delta_ninjathief_01_5","text":"Just try to steal things without getting caught.","jump":"d_counseling_delta_ninjathief_01_10","exit":false,"enter":null,"bg":null,"bgA