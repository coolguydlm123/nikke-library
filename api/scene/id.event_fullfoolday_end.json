null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_20","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_fullfoolday_end_20","text":"I appreciate the advice, but how long are you planning on staying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_21","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_fullfoolday_end_21","text":"Days like the one you're having don't go on forever. It's just one out of many others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_22","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_fullfoolday_end_22","text":"So keep what's good and throw away the bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_23","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_fullfoolday_end_23","text":"I know you will do well. I have faith in you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_24","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_fullfoolday_end_24","text":"Anyway, I better get going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_25","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_fullfoolday_end_25","text":"I have a meeting in the Ark in 5 minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_26","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_fullfoolday_end_26","text":"If you have a meeting in 5 minutes, why the hell did you come all the way out here?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_27","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_fullfoolday_end_27","text":"I can see now that perhaps it wasn't the smartest idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_28","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_fullfoolday_end_28","text":"Well, I hope what's left of it goes well for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_29","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_fullfoolday_end_29","text":"Wait, you're leaving? Why did you even come h...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_30","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_fullfoolday_end_30","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_31","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_fullfoolday_end_31","text":"... Andersen opens the door and leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_fullfoolday_end_32","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_fullfoolday_end_32","text":"...","jump":null,"exit":false,"enter":null,"