{"id":"d_counseling_guilty_08","cat":"counsel","group":{"id":"char5055","label":"Guilty"},"label":"Advising Guilty: 08","stage":null,"prev":"d_counseling_guilty_07","next":"d_counseling_guilty_09","speakers":{"guilty":"Guilty"},"icons":{"guilty":"si_c400_00_s"},"lines":[{"id":"d_counseling_guilty_08_1","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_1","text":"Whenever I'm with you Counselor, my mood just lifts.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty"],"affinity":"_0"},{"id":"d_counseling_guilty_08_2","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_2","text":"When are you the happiest, Counselor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_08_3","text":"When I'm alone.","jump":"d_counseling_guilty_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_08_4","text":"When I'm with you.","jump":"d_counseling_guilty_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_08_5","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_5","text":"Alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_6","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_6","text":"Does that mean whenever you're with me, you feel bad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_7","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_08_7","text":"Not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_8","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_8","text":"Okay... I thought for a moment my feelings weren't reciprocated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_9","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_9","text":"All this is making me confused.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_10","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_10","text":"You better stop pulling my leg, or I'm going to squeeze you as hard as I can.","jump":"d_counseling_guilty_08_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_11","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_11","text":"Counselor, you too...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_12","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_12","text":"I'm glad... I would have felt bad if I was the only one who felt the way I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_13","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_13","text":"If you had said you don't feel the same way, I don't know what I would have done to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_14","type":"Speech","speaker":"guilty","key":"Locale_Counseling:d_counseling_guilty_08_14","text":"Either way, I'm glad that's not the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_08_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_08_15","text":"I spend a somewhat hair-raising session with Guilty.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}