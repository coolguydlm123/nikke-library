{"id":"msg_m_ex_rapi_redhood_01","cat":"messenger","group":{"id":"room_rapi","label":"Rapi · Nikke"},"label":"6. Commander.","stage":null,"prev":"msg_m_event_liarsend_01_01","next":"msg_m_ex_rapi_redhood_02","speakers":{"rapi_r":"Rapi"},"icons":{"rapi_r":"si_c016_00_s"},"lines":[{"id":"m_ex_rapi_redhood_01_1","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_1","text":"Commander.","jump":null},{"id":"m_ex_rapi_redhood_01_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_2","text":"Yes, Rapi?","jump":null},{"id":"m_ex_rapi_redhood_01_3","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_3","text":"...","jump":null},{"id":"m_ex_rapi_redhood_01_4","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_4","text":"Um...","jump":null},{"id":"m_ex_rapi_redhood_01_5","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_5","text":"Did you notice?","jump":null},{"id":"m_ex_rapi_redhood_01_6","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_6","text":"Ah, you changed your profile picture.","jump":"m_ex_rapi_redhood_01_8"},{"id":"m_ex_rapi_redhood_01_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_7","text":"Notice what?","jump":"m_ex_rapi_redhood_01_11"},{"id":"m_ex_rapi_redhood_01_8","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_8","text":"!!","jump":null},{"id":"m_ex_rapi_redhood_01_9","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_9","text":"You saw it straight away.","jump":null},{"id":"m_ex_rapi_redhood_01_10","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_10","text":"Your attention to detail is very attractive.","jump":"m_ex_rapi_redhood_01_15"},{"id":"m_ex_rapi_redhood_01_11","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_11","text":"Oh...","jump":null},{"id":"m_ex_rapi_redhood_01_12","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_12","text":"It's just that...","jump":null},{"id":"m_ex_rapi_redhood_01_13","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_13","text":"I changed my profile picture.","jump":null},{"id":"m_ex_rapi_redhood_01_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_14","text":"Oh, you're right!","jump":"m_ex_rapi_redhood_01_15"},{"id":"m_ex_rapi_redhood_01_15","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_15","text":"Anis and Neon suggested that I change it,","jump":null},{"id":"m_ex_rapi_redhood_01_16","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_16","text":"so I did.","jump":null},{"id":"m_ex_rapi_redhood_01_17","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_17","text":"If you're not a fan of it,","jump":null},{"id":"m_ex_rapi_redhood_01_18","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_18","text":"I can change it back to the way it was.","jump":null},{"id":"m_ex_rapi_redhood_01_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_19","text":"No, it's nice.","jump":null},{"id":"m_ex_rapi_redhood_01_20","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_20","text":"You think so?","jump":null},{"id":"m_ex_rapi_redhood_01_21","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_21","text":"I'm glad you like it.","jump":null},{"id":"m_ex_rapi_redhood_01_22","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_22","text":"Thank you, Commander.","jump":null},{"id":"m_ex_rapi_redhood_01_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_23","text":"How are you feeling?","jump":null},{"id":"m_ex_rapi_redhood_01_24","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_24","text":"Sorry?","jump":null},{"id":"m_ex_rapi_redhood_01_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_25","text":"Are you adjusting to your new look?","jump":null},{"id":"m_ex_rapi_redhood_01_26","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_26","text":"Oh.","jump":null},{"id":"m_ex_rapi_redhood_01_27","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_27","text":"Whenever I get back to the Outpost and see my reflection in the mirror at the dorm,","jump":null},{"id":"m_ex_rapi_redhood_01_28","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_28","text":"that's when it feels real.","jump":null},{"id":"m_ex_rapi_redhood_01_29","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_29","text":"Not out during operations, but in daily life.","jump":null},{"id":"m_ex_rapi_redhood_01_30","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_30","text":"I think this is how I'll live from now on.","jump":null},{"id":"m_ex_rapi_redhood_01_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_31","text":"Do you like it?","jump":null},{"id":"m_ex_rapi_redhood_01_32","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_32","text":"Yes.","jump":null},{"id":"m_ex_rapi_redhood_01_33","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_33","text":"I do.","jump":null},{"id":"m_ex_rapi_redhood_01_34","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_34","text":"So I'm no longer going to worry about it.","jump":null},{"id":"m_ex_rapi_redhood_01_35","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_35","text":"This is who I am.","jump":null},{"id":"m_ex_rapi_redhood_01_36","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_36","text":"I have sworn to live like this.","jump":null},{"id":"m_ex_rapi_redhood_01_37","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_37","text":"Thank you again,","jump":null},{"id":"m_ex_rapi_redhood_01_38","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_38","text":"for showing me the way when I was lost.","jump":null},{"id":"m_ex_rapi_redhood_01_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_39","text":"I'll continue counting on you like I always have.","jump":null},{"id":"m_ex_rapi_redhood_01_40","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_40","text":"And I will do the same.","jump":null},{"id":"m_ex_rapi_redhood_01_41","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_41","text":"Anyway,","jump":null},{"id":"m_ex_rapi_redhood_01_42","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_42","text":"I'll remain on standby.","jump":null},{"id":"m_ex_rapi_redhood_01_43","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_43","text":"That way... I can come running to you at anytime if I need to.","jump":null},{"id":"m_ex_rapi_redhood_01_44","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_44","text":"If you need anything, anything at all, call me.","jump":null},{"id":"m_ex_rapi_redhood_01_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_45","text":"Okay, I'll do that.","jump":null},{"id":"m_ex_rapi_redhood_01_46","type":"Speech","speaker":"rapi_r","key":"Locale_SuddenMessage:m_ex_rapi_redhood_01_46","text":"Thank you, Commander.","jump":null}],"chat":true}