02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_02_24","text":"I'm sensing some anger here.","jump":null},{"id":"m_ex_maxwell_02_25","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_25","text":"It has to be in the research lab somewhere.","jump":null},{"id":"m_ex_maxwell_02_26","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_26","text":"Let's stay calm about this.","jump":null},{"id":"m_ex_maxwell_02_27","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_27","text":"Hahahahahahahaha","jump":null},{"id":"m_ex_maxwell_02_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maxwell_02_28","text":"I hope you'll find it.","jump":null},{"id":"m_ex_maxwell_02_29","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_29","text":"Thanks, Cutey.","jump":null},{"id":"m_ex_maxwell_02_30","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_30","text":"You seem very sincere.","jump":null},{"id":"m_ex_maxwell_02_31","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_31","text":"Well, I'm off to search for it.","jump":null},{"id":"m_ex_maxwell_02_32","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_32","text":"After all, I can't run more tests on you until I find those notes!","jump":null},{"id":"m_ex_maxwell_02_33","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_33","text":"I'm sure it wouldn't take me long to find it.","jump":null},{"id":"m_ex_maxwell_02_34","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_maxwell_02_34","text":"I'll be in touch if I find the notes ;)","jump":null}],"chat":true}