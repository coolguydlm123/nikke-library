"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_7","text":"The Absolute Squad was sent on a combat mission, and I've been tasked with watching over this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_8","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_8","text":"Eunhwa said, and I quote, \"If any weirdoes show up, tell 'em to go pound sand.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_9","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_9","text":"Those were her exact words?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_10","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_10","text":"Yep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_11","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_11","text":"She specifically mentioned that if any Nikkes","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_12","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_12","text":"reeking of firepower or who had an air of an amateur detective to them showed up,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_13","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_13","text":"that I should tell them to get lost, by force if necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_14","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_14","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_15","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_15","text":"Anyway,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_16","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_16","text":"what you are two doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_17","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_17","text":"We're hoping to get our hands on some bulletproof silk fabric.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_18","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_18","text":"That's quite an unusual combination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_19","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_19","text":"The outfit I'm wearing is made of silk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_20","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_20","text":"It's beginning to fray slightly around the waist, so I wanted to get it patched up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_21","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_21","text":"I could always make a brand-new one, but I feel that'd be a bit overkill, considering it's only slightly torn in a few places.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_22","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_22","text":"Got it. Let me look it up for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_23","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_23","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_24","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_24","text":"Sorry, but I didn't find any silk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_25","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_25","text":"I did find some bulletproof cloth though. Do you want it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_26","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_26","text":"Thank you, but that's all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_27","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_27","text":"Sorry to trouble you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_28","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_28","text":"I'll be on my way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_29","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_29","text":"Wait a second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_30","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_30","text":"Actually, I know how to mend clothes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_31","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_31","text":"... Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_32","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_32","text":"You do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_33","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_33","text":"Sure. My combat uniform wears out sometimes when I've been doing a lot of training.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_34","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_34","text":"I always just mend it myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_35","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_35","text":"But this dress was made by the finest tailors. It could be a bit of a challenge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_36","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_36","text":"Don't worry, patching up a little hole like that is a piece of cake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_37","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_37","text":"Besides, that's what you wear out on the battlefield, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_38","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_38","text":"You can't be running around with any weak spots in your combat uniform.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_39","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_39","text":"... You have a point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_40","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_40","text":"Well... thank you, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_41","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_41","text":"Leave it to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_42","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_42","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_43","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_43","text":"Delta crouches in front of Sakura, trying to repair her clothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_44","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_44","text":"... I didn't expect you were going to mend it with her still wearing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_45","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_45","text":"It's not like I can ask her to drop trow in front of you, can I, {AccountData.NickName}-kun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_46","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_46","text":"I wouldn't mind...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_47","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_48","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_48","text":"Not for now, at least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_49","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_49","text":"How's everything going, Delta?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_50","type":"Speech","speaker":"delta","key":"Locale_SuddenStory:d_ex_armory_05_50","text":"It's a toughie, but I've got it under control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_51","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_51","text":"Never thought I'd have my very own tailor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_52","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_52","text":"Say, Sakura.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_53","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_53","text":"Yeah?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_54","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_54","text":"I've noticed that you always fold your collar inward during battles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_55","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_armory_05_55","text":"Is there any special meaning to that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_armory_05_56","type":"Speech","speaker":"sakura","key":"Locale_SuddenStory:d_ex_armory_05_56"