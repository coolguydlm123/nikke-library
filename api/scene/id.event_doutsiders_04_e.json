{"id":"event_doutsiders_04_e","cat":"event","group":{"id":"ev40006","label":"D-OUTSIDERS"},"label":"Manager Exotic: B","stage":null,"prev":"event_doutsiders_04_s","next":"event_doutsiders_05_s","speakers":{"Narration":"Narration","jackal":"Jackal","viper":"Viper","Self":"Commander","joseph":"Joseph"},"icons":{"Narration":"si_c999_00_s","jackal":"si_c111_00_s","viper":"si_c112_00_s","joseph":"si_c935_00_s"},"lines":[{"id":"event_doutsiders_04_e_1","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_04_e_1","text":"*Tang* Arghh!!","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_2","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_2","text":"We've got a moving target!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["joseph","jackal"],"affinity":null},{"id":"event_doutsiders_04_e_3","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_3","text":"Waddya say Viper, how about a friendly competition? 10 points to whoever gets a headshot first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_4","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_4","text":"Sorry, but no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["viper"],"affinity":null},{"id":"event_doutsiders_04_e_5","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_5","text":"Aw man, you're no fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_6","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_04_e_6","text":"... Is it over?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_7","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_7","text":"Yeah, I think the dust has settled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_8","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_8","text":"But there's still someone we need to take care of...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_9","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_9","text":"Ha, haha...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_mystery","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_10","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_10","text":"I thought I was quite well-prepared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_11","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_11","text":"You're truly deserving of your reputation. Those mass-produced Nikkes didn't stand a chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_12","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_12","text":"There certainly were enough of 'em. They made for a decent warmup though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_13","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_13","text":"Even a mouse will bite a cat when it's cornered. Guess we were the mice today, eh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_14","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_14","text":"... Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_15","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_15","text":"I suppose so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_16","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_16","text":"It's hard to say how many chances a man like me will ever have","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_17","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_17","text":"of going up against someone from the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_18","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_18","text":"It was a risk I had to take. It seems, however, things have not ended up in my favor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_19","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_04_e_19","text":"What are you saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_20","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_20","text":"Don't you get it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_21","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_21","text":"He's the one you're after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_22","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_22","text":"He's the terrorist responsible for the blackouts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_23","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_23","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_24","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_24","text":"We had our suspicions, but as soon as he took the bait Viper threw at him, that's when we knew for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_25","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_25","text":"He even took a few potshots at you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_26","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_26","text":"Now the only thing to decide is whether we take him in dead or alive, hehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_27","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_04_e_27","text":"You knew all along?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_28","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_28","text":"Yep!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_29","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_29","text":"We arranged it so that you would meet with him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_30","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_30","text":"If we did that, the Captain said Joseph would reveal himself to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_31","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_04_e_31","text":"What was Crow thinking, putting me in danger like that?!","jump":"event_doutsiders_04_e_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_32","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_04_e_32","text":"Why didn't you tell me the plan?","jump":"event_doutsiders_04_e_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_33","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_33","text":"How would I know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_34","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_04_e_34","text":"The Captain has always been a tough nut to crack. It's hard to say what she's thinking at any given point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_35","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_35","text":"Anyway, I have a hunch.","jump":"event_doutsiders_04_e_40","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_36","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_36","text":"Stay in the Outer Rim long enough, and you learn not to trust anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_37","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_37","text":"If we're not careful, our lives could be in danger too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_38","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_04_e_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_39","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_39","text":"Anyway, this was a win-win for everybody♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_40","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_40","text":"Heavenly Ascension never agreed to these attacks,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_41","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_41","text":"so there's a whole lotta bickering going on inside and outside the organization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_42","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_42","text":"So the Captain wanted to wrap up this whole thing without overstepping our boundaries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_43","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_43","text":"If our Captain were to capture him personally, our friends in Heavenly Ascension might see it as a betrayal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_44","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_04_e_44","text":"So we decided that's where you'd come in handy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_45","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_04_e_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_46","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_46","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_47","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_47","text":"How does it feel to apprehend a terrorist?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_48","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_48","text":"Do you feel justice has been served?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_49","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_49","text":"Or do you feel excited because you might be up for a promotion after this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_50","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_04_e_50","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_51","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_51","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_04_e_52","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_04_e_52","text":"I suppose even people like y