{"id":"d_ex_police_08","cat":"outpost","group":{"id":"outpost10201","label":"Police Station"},"label":"A Parking Spot for T.A.L.O.S.","stage":null,"prev":"d_ex_police_07","next":"d_ex_police_09","speakers":{"talos":"T.A.L.O.S.","kilo":"Kilo","miranda":"Miranda","poli":"Poli"},"icons":{"talos":"si_c361_00_s","kilo":"si_c977_00_s","miranda":"si_c032_00_s","poli":"si_c030_00_s"},"notes":["Unlock: Kilo · Miranda · Poli","Featuring Kilo · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_police_08_1","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_1","text":"After receiving a sudden phone call from Poli, I find myself heading towards the police station.","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_2","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_2","text":"T.A.L.O.S.?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["talos"],"affinity":null},{"id":"d_ex_police_08_3","type":"Speech","speaker":"talos","key":"Locale_SuddenStory:d_ex_police_08_3","text":"Hello, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_4","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_4","text":"What are you doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_5","type":"Speech","speaker":"talos","key":"Locale_SuddenStory:d_ex_police_08_5","text":"I am waiting for Kilo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_6","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_6","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_7","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_7","text":"Something doesn't feel quite right about this, but I decide to ignore it and head to the police station.","jump":null,"exit":false,"enter":null,"bg":"Police","bgArt":"police","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_8","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_8","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_10","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_10","text":"Le-let me out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["kilo","poli","miranda"],"affinity":null},{"id":"d_ex_police_08_11","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_11","text":"I'm afraid I can't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_12","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_12","text":"Parking illegally is a major felony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_13","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_13","text":"No, they're not. Traffic violations are misdemeanors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_14","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_14","text":"Oh, is that right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_15","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_15","text":"You hear that? Parking illegally is a misdemeanor!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_16","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_16","text":"If it's just a misdemeanor, why are you locking me up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_17","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_17","text":"Because it's a traffic violation!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_18","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_18","text":"I feel like I'm talking to a brick wall!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_19","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_19","text":"Also, I never illegally parked in the first place!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_20","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_20","text":"How can you say that?\nIt's parked right in front of the police station as we speak!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_21","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_21","text":"I didn't park there. I just stopped there for a second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_22","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_22","text":"If that's not illegal parking, then what would you call it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_23","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_23","text":"Argh! Commander, you've gotta help me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_24","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_24","text":"What's going on here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_25","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_25","text":"Hi, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_26","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_26","text":"Hm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_27","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_27","text":"I should mention that holding Kilo in detention was Miranda's decision.\nWe'll be releasing her shortly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_28","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_28","text":"However, did you see that thing outside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_29","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_29","text":"Do you mean T.A.L.O.S.? Yeah, I did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_30","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_30","text":"T.A.L.O.S.? Is that what it's called?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_31","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_31","text":"We've had a steady stream of complaints about it lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_32","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_32","text":"\"It keeps blocking the way when I'm riding with my Partner.\nLet's see who is faster next time!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_33","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_33","text":"\"I thought it was a building and tried to go in, but I kept bumping into it and now my forehead hurts.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_34","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_34","text":"Like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_35","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_35","text":"...It seems like the last one was written by someone working at the police station...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_36","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_36","text":"I called Kilo over to hear her side of the story,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_37","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_37","text":"but she refuses to talk and instead keeps asking for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_38","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_38","text":"I suppose I can see why she's upset. We may have been a bit hasty in holding her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_39","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_39","text":"Miranda, can you let Kilo out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_40","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_40","text":"I'll do no such thing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_41","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_41","text":"Before I even consider that, we need to resolve this illegal parking issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_42","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_42","text":"Miranda, if you want her to move that robot, don't you think you'll have to let her out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_43","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_43","text":"Oh...yeah, I guess you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_44","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_44","text":"All right, I'll let her out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_45","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_45","text":"*Click*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_46","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_46","text":"Thank goodness! Oh, Commander, I was so scared!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_47","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_47","text":"This must have been quite a traumatic experience for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_48","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_48","text":"It sure was. Thank you again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_49","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_49","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_50","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_50","text":"Now, about all these complaints.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_51","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_51","text":"Is there perhaps a separate area somewhere in the Outpost where I can leave T.A.L.O.S.?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_52","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_52","text":"The last thing I want is to be an imposition to anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_53","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_53","text":"So you're using T.A.L.O.S. to get around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_54","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_54","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_55","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_55","text":"This is the first time I've seen someone use such a large means of transportation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_56","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_56","text":"Rather than run around creating designated parking spaces,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_57","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_57","text":"I'm willing to bet there's more than enough space\nnear most of the buildings here for T.A.L.O.S.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_58","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_58","text":"What do you think, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_59","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_08_59","text":"I think that's a brilliant idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_60","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_60","text":"Oh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_61","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_61","text":"I think that's a great idea as well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_62","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_62","text":"Finally, a police officer I can reason with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_63","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_63","text":"What a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_64","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_64","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_65","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_65","text":"Hehe, I hardly think that suggestion was worthy of such effusive praise,\nbut thank you nonetheless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_66","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_66","text":"So where should we place T.A.L.O.S. here at the station?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_67","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_67","text":"You left him near this corner outside, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_68","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_68","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_69","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_69","text":"It's not really obstructing traffic, and it's not sticking out dangerously,\nso I think it should be fine where it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_70","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_70","text":"Let's just leave it there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_71","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_71","text":"Okay, thanks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_72","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_72","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_73","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_73","text":"So are we not considering this illegal parking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_74","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_74","text":"Nope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_75","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_75","text":"...Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_76","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_76","text":"Drive safely!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_77","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_78","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_78","text":"You changed your tune awfully quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_79","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_79","text":"Naturally!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_80","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_08_80","text":"It's a police officer's duty to be kind to the populace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_81","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_81","text":"...Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_82","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_82","text":"You must not have considered me part of the populace before...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_83","type":"Speech","speaker":"kilo","key":"Locale_SuddenStory:d_ex_police_08_83","text":"Anyway, thanks. I'll be more careful from now on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_08_84","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_08_84","text":"Thanks, we appreciate it.","jump":null,"exit":false,"e