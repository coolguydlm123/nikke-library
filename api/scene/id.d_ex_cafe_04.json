_SuddenStory:d_ex_cafe_04_70","text":"The Sugar Coffee is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_71","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_71","text":"*Glug, glug, glug*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_72","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_72","text":"Very sweet! It's quite good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_73","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_73","text":"I'm gonna hurl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_74","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_74","text":"This is the worst one yet. How is it even possible to make a drink this bad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_75","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_04_75","text":"You might not be so ignorant when it comes to coffee after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_76","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_04_76","text":"The Sugar Coffee is just reprehensible, am I right? I knew it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_77","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_77","text":"Patooey! Commander, you said you were going to treat me to something delicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_78","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_cafe_04_78","text":"I take it this wasn't quite to your preference?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_79","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_79","text":"Hehe. I found it to be delicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_80","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_80","text":"Thank you for bringing me here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_81","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_cafe_04_81","text":"Maybe we should try another one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_82","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_cafe_04_82","text":"The revving of the motorcycle engine becomes louder,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_83","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_cafe_04_83","text":"but it doesn't sound as if it's slowing down...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_84","type":"Narration","speaker":"Narration","key":"Locale_SuddenStory:d_ex_cafe_04_84","text":"*Crash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_85","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_85","text":"Gah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_86","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_04_86","text":"What's gotten into her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_b","movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_87","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_cafe_04_87","text":"Sugar's motorcycle, Black Typhoon, crashes through the cafe's front window.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_88","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_88","text":"Teacher?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_89","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_89","text":"Is this some kind of joke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_90","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_cafe_04_90","text":"If it is, I'm not laughing. I'll treat you to another coffee some other time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_91","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_91","text":"Hehe! Let's go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":nu