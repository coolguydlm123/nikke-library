e_04_20","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_04_20","text":"but for you, I'll make an exception.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_21","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_04_21","text":"Wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_22","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_cafe_04_22","text":"A moment later, Milk lays the coffee cup in front of Anne and Jackal, her eyes filled with anticipation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_23","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_04_23","text":"This here is what we call Cafe Sweety's Yuletide Brew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_24","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_cafe_04_24","text":"The paper cups are decorated in various wintertime patterns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_25","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_cafe_04_25","text":"What's different about it?","jump":"d_ex_cafe_04_27","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_26","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_cafe_04_26","text":"Please don't tell me the only difference is the cup.","jump":"d_ex_cafe_04_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":