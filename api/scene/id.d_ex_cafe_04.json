_SuddenStory:d_ex_cafe_04_34","text":"Of course, Milk Coffee is the best of the bunch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_35","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_35","text":"It smells wonderful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_36","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_36","text":"Let's see who can neck all these first!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_37","type":"Speech","speaker":"milk","key":"Locale_SuddenStory:d_ex_cafe_04_37","text":"Wait. If you're going to try them all, start with Cream Coffee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_38","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_38","text":"Okay, here goes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_39","type":"Speech","speaker":"anne","key":"Locale_SuddenStory:d_ex_cafe_04_39","text":"*Sip*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_40","type":"Speech","speaker":"jackal","key":"Locale_SuddenStory:d_ex_cafe_04_40","text":"*Glug, glug, glug*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_cafe_04_41","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_cafe_04_41","text":"Upon sipping the Cream Coffee, Anne and Jackal's eyes both are widened.","j