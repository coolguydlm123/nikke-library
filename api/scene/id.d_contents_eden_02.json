,"type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_02_54","text":"I didn't expect to enjoy this kind of luxury.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_02_55","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_02_55","text":"Don't think of it as a luxury.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_02_56","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_02_56","text":"Remember what I told you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_02_57","type":"Speech","speaker":"dorothy","key":"Locale_SubScenario:d_contents_eden_02_57","text":"Nothing in this place comes without a price.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_02_58","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_02_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_02_59","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_02_59","text":"Dorothy is right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_02_60","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_02_60","text":"We'll mend you and give you the equipment you need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_02_61","type":"Speech","sp