{"id":"d_counseling_ludmilla_19","cat":"counsel","group":{"id":"char5033","label":"Ludmilla"},"label":"Advising Ludmilla: 19","stage":null,"prev":"d_counseling_ludmilla_18","next":"d_counseling_ludmilla_20","speakers":{"ludmilla":"Ludmilla"},"icons":{"ludmilla":"si_c190_00_s"},"lines":[{"id":"d_counseling_ludmilla_19_1","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_1","text":"I know that you've been to many different places up on the surface.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ludmilla"],"affinity":"_0"},{"id":"d_counseling_ludmilla_19_2","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_2","text":"Looking back, are there any locations that stand out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_19_3","text":"For one, I remember the snowfields up north, where I met you.","jump":"d_counseling_ludmilla_19_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ludmilla_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_19_4","text":"Nothing much comes to mind.","jump":"d_counseling_ludmilla_19_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ludmilla_19_5","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_5","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_19_6","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_6","text":"I'm delighted to hear you feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_19_7","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_7","text":"I too have a special attachment to the place where we first met.","jump":"d_counseling_ludmilla_19_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_19_8","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_8","text":"... Understandable. The surface is such a danger zone, I'm sure everything starts to blend together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_19_9","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_9","text":"I hope one day you'll have been to some areas you feel are worth remembering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_19_10","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_19_10","text":"When that happens, the surface will no longer seem so threatening to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_19_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_19_11","text":"I go through all the previous places I'd been to on the surface with Ludmilla.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}