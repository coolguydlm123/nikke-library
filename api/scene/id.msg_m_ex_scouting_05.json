":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_12","text":"sorry!","jump":null},{"id":"m_ex_scouting_05_13","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_13","text":"Signal, reporting in.","jump":null},{"id":"m_ex_scouting_05_14","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_14","text":"Nothing out of the ordinary.","jump":null},{"id":"m_ex_scouting_05_15","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_15","text":"Anis and Neon were in an altercation regarding who would get the last piece of pizza,","jump":null},{"id":"m_ex_scouting_05_16","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_16","text":"but I left them alone.","jump":null},{"id":"m_ex_scouting_05_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_05_17","text":"All right.","jump":null},{"id":"m_ex_scouting_05_18","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_18","text":"That concludes my report.","jump":null},{"id":"m_ex_scouting_05_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_05_19","text":"Well done, both of you.","jump":null},{"id":"m_ex_scouting_05_20","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_05_20","text":"Again, there is no reply.","jump":null},{"id":"m_ex_scouting_05_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_05_21","text":"Hello? Anyone?","jump":null},{"id":"m_ex_scouting_05_22","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_05_22","text":"My apologies.","jump":null},{"id":"m_ex_scouting_05_23","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_05_23","text":"I'm preparing to head out for a solo training mission.","jump":null},{"id":"m_ex_scouting_05_24","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_