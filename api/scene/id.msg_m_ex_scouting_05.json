couting_05_36","text":"...","jump":null},{"id":"m_ex_scouting_05_37","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_37","text":"Well...","jump":null},{"id":"m_ex_scouting_05_38","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_38","text":"to be honest,","jump":null},{"id":"m_ex_scouting_05_39","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_39","text":"we're watching Epinel in the skateboarding championship finals.","jump":null},{"id":"m_ex_scouting_05_40","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_40","text":"Naturally, the observatory was not meant to be used for this purpose,","jump":null},{"id":"m_ex_scouting_05_41","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_05_41","text":"but we have to cheer on our colleague!","jump":null},{"id":"m_ex_scouting_05_42","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_05_42","text":"I don't intend on making excuses.","jump":null},{"id":"m_ex_scouting_05_43","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_05_43","text":"We're misappropriating military facilities for our own personal interests.","jump":null},{"id":"m_ex_scouting_05_44","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_05_44","text":"I will willingly accept any punishment you lay down.","jump":null},{"id":"m_ex_scouting_05_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_05_45","text":"Then there's only one way to rectify this situation...","jump":null},{"id":"m_ex_scouting_05_46","type":"Speech","speaker":"delta","key":"Locale_SuddenMessage:m_ex_scouting_05_46","text":"...","jump":null},{"id":"m_ex_scouting_05_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_05_47","text":"Let's all go cheer on Epinel together.","jump":null},{"id":"m_ex_scouting_05_48","type":"Speech","s