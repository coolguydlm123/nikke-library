_quency_escapequeen_01_5","text":"We couldn't eat whatever we wanted either. Life would be hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_escapequeen_01_6","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_quency_escapequeen_01_6","text":"I'm just saying...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_escapequeen_01_7","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_quency_escapequeen_01_7","text":"Well, you should be careful what you wish for!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_escapequeen_01_8","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_quency_escapequeen_01_8","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_escapequeen_01_9","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_quency_escapequeen_01_9","text":"This time off is well-deserved, so I hope you take advantage of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_escapequeen_01_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_escapequeen_01_10","text":"Same to you, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_escapequeen_01_11","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_escapequeen_01_11","text":"*Ratttle*!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":