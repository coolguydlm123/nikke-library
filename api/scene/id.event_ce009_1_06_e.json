ll,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_12","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_06_e_12","text":"Ack!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_13","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_13","text":"The webs are slightly damaged by the barrage, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_14","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_ce009_1_06_e_14","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_15","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_15","text":"Before the Nikkes can even finish reloading, they regenerate and return to their original state.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_16","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_06_e_16","text":"Th-that startled me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_17","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_17","text":"Oh sorry, I should've warned you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_18","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_06_e_18","text":"I'm sorry, I'm still not used to the sound of gunfire... But since we're fighting together, I'll do my best to get used to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_19","text":"Okay, I'll help too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_20","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_20","text":"Queen takes a step closer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_21","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_06_e_21","text":"Um, Commander... would it be all right if I borrowed a gun next time too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_22","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_22","text":"Of course it's... Er, hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_23","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_23","text":"I start to answer, then stop myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_24","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_24","text":"Wait, Queen... you're not a soldier, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_25","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_25","text":"I'm not sure I should give a gun to a civilian who's never used one before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_26","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_06_e_26","text":"Actually, I normally carry a gun with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_27","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_06_e_27","text":"It's a model gun, which means I can't use it as a weapon in this world, so I've just been keeping it stored away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_28","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_28","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_29","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_06_e_29","text":"In our battles, model guns work just like real guns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_30","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_06_e_30","text":"Right, so we try to handle them as if they're real guns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_31","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_31","text":"Still, a real gun is a lot more dangerous than a model one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_32","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_32","text":"Besides, you can fight just fine with your Persona.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_33","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_06_e_33","text":"That's true, but if I could use a gun, it'd be easier to coordinate with the Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_34","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_06_e_34","text":"Yeah, I feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_35","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_06_e_35","text":"If only I could've fought alongside them without hesitating...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_36","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_37","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_1_06_e_37","text":"What's the big deal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_38","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_1_06_e_38","text":"They might not technically be soldiers, but from what I've seen 