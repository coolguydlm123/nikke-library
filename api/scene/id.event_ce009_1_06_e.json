1","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_06_e_51","text":"Well, when in Rome, right? I'm looking forward to the training, but I'm counting on you too, Quency!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_52","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_1_06_e_52","text":"Hmm... I don't really need any training, though...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_53","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_06_e_53","text":"Well, of course... you're an excellent shot...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_54","type":"Speech","speaker":"unknown","key":"Locale_SubScenario:event_ce009_1_06_e_54","text":"Well, this is a pleasant atmosphere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_55","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_55","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_56","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce009_1_06_e_56","text":"*Step, step*","jump":null,"exit":false,"enter":null,"bg":"EventScene_ce009_04_1","bgArt":"eventscene_ce009_04_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_06_e_57","type":"Speech","speaker":"verygentleman","key":"Locale_SubScenario:event_ce009_1_06_e_57","text":"Long time no see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"