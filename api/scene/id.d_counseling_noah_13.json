,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_13_7","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_13_7","text":"Since there's no limit, I can't have a moment's rest, no matter how strong I get.","jump":"d_counseling_noah_13_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_13_8","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_13_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_13_9","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_13_9","text":"You moron, of course there's no such thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_13_10","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_13_10","text":"If you defeat a formidable foe, a stronger one will come along and take its place. That is how it works.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_13_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_noah_13_11","text":"Noah and I talk about the upper limits of strength.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}