lse,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_6","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce004_1_01_s_6","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_7","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce004_1_01_s_7","text":"You said you belong to an organization called NERV?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_8","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_8","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_9","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_9","text":"We're also fighting to keep mankind alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_10","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_10","text":"However, this is the first time I've heard about any of this:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_11","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_11","text":"A vast underground city dubbed the Ark;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_12","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_12","text":"Humanity being threatened by mechanical creatures called Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_13","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_13","text":"The existence of these beings called Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_14","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_14","text":"That's understandable,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_15","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_15","text":"considering our worlds are different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_16","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_16","text":"Another world...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_17","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_17","text":"That's the part","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_18","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_18","text":"I'm having the most trouble accepting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_19","type":"Speech","speaker":"ce004_03","key":"Locale_SubScenario:event_ce004_1_01_s_19","text":"A different world...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_20","type":"Speech","speaker":"ce004_03","key":"Locale_SubScenario:event_ce004_1_01_s_20","text":"Hehe, pretty interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_21","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_21","text":"You're not pulling our legs, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_22","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_22","text":"This is all just too outlandish to be true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_23","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_23","text":"We're not lying. Anis, Neon, and I are not human. We're Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_24","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_24","text":"We are humanoid weapons designed for fighting Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_25","type":"Speech","speaker":"ce004_02","key":"Locale_SubScenario:event_ce004_1_01_s_25","text":"Humanoid... weapons?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_26","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_26","text":"You're not human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_27","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_27","text":"That's right. Except for our brains, our bodies are entirely mechanical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_28","type":"Speech","speaker":"ce004_02","key":"Locale_SubScenario:event_ce004_1_01_s_28","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_29","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_29","text":"But you look so human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_30","type":"Speech","speaker":"ce004_03","key":"Locale_SubScenario:event_ce004_1_01_s_30","text":"Yeah, totally life-like! Amazing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_31","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce004_1_01_s_31","text":"Hehe... I'm not quite sure what to say...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_32","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce004_1_01_s_32","text":"Yeah, it's a bit embarrassing being in the spotlight like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_33","type":"Speech","speaker":"ce004_03","key":"Locale_SubScenario:event_ce004_1_01_s_33","text":"Dang, it's starting to feel like we really are in another world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_34","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_34","text":"This is insane!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_35","type":"Speech","speaker":"ce004_02","key":"Locale_SubScenario:event_ce004_1_01_s_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_36","type":"Speech","speaker":"ce004_02","key":"Locale_SubScenario:event_ce004_1_01_s_36","text":"What about Ikari?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_37","type":"Speech","speaker":"ce004_02","key":"Locale_SubScenario:event_ce004_1_01_s_37","text":"Is he not here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_38","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_38","text":"You're right! What about Shinji?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_39","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce004_1_01_s_39","text":"Who?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_40","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_40","text":"Shinji, a boy around the same age as Rei.A and Asuka. Have you seen him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_41","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_41","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_42","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_42","text":"We scanned the area around the Ark, but we didn't see anyone else besides you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_43","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_43","text":"If someone else had come along with you, they would have been nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_44","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_44","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_45","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_45","text":"I guess Shinji didn't tag along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_46","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_01_s_46","text":"... I'm not sure if that's a good or a bad thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_47","type":"Speech","speaker":"ce004_03","key":"Locale_SubScenario:event_ce004_1_01_s_47","text":"It's a good thing, believe me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_48","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_48","text":"That idiot! What's he thinking going it alone at a time like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_49","type":"Speech","speaker":"ce004_02","key":"Locale_SubScenario:event_ce004_1_01_s_49","text":"Ikari...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_50","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_50","text":"*Sigh*... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_51","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_51","text":"Let's assume that we are, in fact, in another world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_52","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_52","text":"The question is, how do we get back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_53","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce004_1_01_s_53","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_54","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_54","text":"The first thing you asked us was if we had come from another world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_55","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_55","text":"That tells me you've met others like us who aren't from your planet, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_56","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce004_1_01_s_56","text":"Wow, you're sharp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_57","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce004_1_01_s_57","text":"Correct, we have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_58","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_01_s_58","text":"Then I assume you know how to get back as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_59","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce004_1_01_s_59","text":"If our past experiences are anything to go on, you need to defeat that Massive Object up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_01_s_60","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce004_1_01_s_60","text":"If you do that, you should be able to return to your world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}