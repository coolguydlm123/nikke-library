{"id":"msg_m_ex_poli_02","cat":"messenger","group":{"id":"room_poli","label":"Poli · Nikke"},"label":"2. Commander.","stage":null,"prev":"msg_m_ex_poli_01","next":"msg_m_ex_poli_03","speakers":{"poli":"Poli"},"icons":{"poli":"si_c030_00_s"},"lines":[{"id":"m_ex_poli_02_1","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_1","text":"Commander.","jump":null},{"id":"m_ex_poli_02_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_2","text":"What's up?","jump":null},{"id":"m_ex_poli_02_3","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_3","text":"Are you looking for something?","jump":null},{"id":"m_ex_poli_02_4","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_4","text":"I am!","jump":"m_ex_poli_02_6"},{"id":"m_ex_poli_02_5","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_5","text":"Nope.","jump":"m_ex_poli_02_8"},{"id":"m_ex_poli_02_6","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_6","text":"Ah hah!","jump":null},{"id":"m_ex_poli_02_7","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_7","text":"Then this must be yours.","jump":"m_ex_poli_02_10"},{"id":"m_ex_poli_02_8","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_8","text":"Huh? You're not?","jump":null},{"id":"m_ex_poli_02_9","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_9","text":"That can't be.","jump":null},{"id":"m_ex_poli_02_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_10","text":"Did you find something?","jump":null},{"id":"m_ex_poli_02_11","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_11","text":"Sure did.","jump":null},{"id":"m_ex_poli_02_12","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_12","text":"The police station received a lost item about a week ago.","jump":null},{"id":"m_ex_poli_02_13","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_13","text":"No one has claimed it yet.","jump":null},{"id":"m_ex_poli_02_14","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_14","text":"I planned on looking for the owner by myself, so I gave it a whiff.","jump":null},{"id":"m_ex_poli_02_15","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_15","text":"Turns out, it smells just like you.","jump":null},{"id":"m_ex_poli_02_16","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_16","text":"So I figured I'd ask you about it.","jump":null},{"id":"m_ex_poli_02_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_17","text":"Your nose would put a bloodhound to shame.","jump":null},{"id":"m_ex_poli_02_18","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_18","text":"Hehe, you're too kind!","jump":null},{"id":"m_ex_poli_02_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_19","text":"So, what exactly is this mystery item?","jump":null},{"id":"m_ex_poli_02_20","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_20","text":"It's a box.","jump":null},{"id":"m_ex_poli_02_21","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_21","text":"I don't feel right about opening it,","jump":null},{"id":"m_ex_poli_02_22","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_22","text":"so I've just been keeping it safe.","jump":null},{"id":"m_ex_poli_02_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_23","text":"A box?","jump":null},{"id":"m_ex_poli_02_24","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_24","text":"Yes, it is.","jump":null},{"id":"m_ex_poli_02_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_25","text":"Small and light?","jump":null},{"id":"m_ex_poli_02_26","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_26","text":"Exactly.","jump":null},{"id":"m_ex_poli_02_27","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_27","text":"Is it yours after all?!","jump":null},{"id":"m_ex_poli_02_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_28","text":"Sounds like it may be my parcel.","jump":null},{"id":"m_ex_poli_02_29","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_29","text":"But there's no tracking number on it...","jump":null},{"id":"m_ex_poli_02_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_30","text":"I think I forgot to write that down when I sent it out.","jump":null},{"id":"m_ex_poli_02_31","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_31","text":"No wonder!","jump":null},{"id":"m_ex_poli_02_32","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_32","text":"No sender, no recipient...","jump":null},{"id":"m_ex_poli_02_33","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_33","text":"that explains why it got sent to the Police Station.","jump":null},{"id":"m_ex_poli_02_34","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_34","text":"Hehe! Well, I'll have it returned to you.","jump":null},{"id":"m_ex_poli_02_35","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_02_35","text":"Please pay more attention from now on!","jump":null},{"id":"m_ex_poli_02_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_36","text":"Thank you.","jump":null},{"id":"m_ex_poli_02_37","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_02_37","text":"... I should double-check these things when I send a parcel in the future.","jump":null}],"chat":true}