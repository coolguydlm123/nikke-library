{"id":"d_ex_police_10","cat":"outpost","group":{"id":"outpost10201","label":"Police Station"},"label":"Bunny Girl vs Maid","stage":null,"prev":"d_ex_police_09","next":"d_ex_police_11","speakers":{"privaty_m":"Privaty","milk_b":"Milk"},"icons":{"privaty_m":"si_c313_00_s","milk_b":"si_c143_00_s"},"notes":["Unlock: Milk: Blooming Bunny · Privaty: Unkind Maid","Featuring Milk: Blooming Bunny · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_police_10_1","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_1","text":"One day, I stop by the police station to pick up some important documents.","jump":null,"exit":false,"enter":null,"bg":"Police","bgArt":"police","image":null,"bgm":"bgm_story_languor","movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_2","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_2","text":"But there, instead of the A.C.P.U., I find only two completely unexpected faces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["privaty_m","milk_b"],"affinity":null},{"id":"d_ex_police_10_3","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_3","text":"Does that even make sense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_4","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_4","text":"Showing up at a police station in that outfit and claiming it's for an investigation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_5","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_5","text":"Who'd ever believe that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_6","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_6","text":"Oh, that's rich coming from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_7","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_7","text":"Look who's talking, you little punk!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_8","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_8","text":"Parading around in that shameless getup and claiming you're on duty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_9","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_9","text":"As if anyone would buy that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_10","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_10","text":"Sh-shameless?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_11","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_11","text":"This outfit is worn solely to serve Master! There's absolutely nothing shameful about it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_12","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_12","text":"... What are you two doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_13","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_13","text":"M-Master...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_14","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_14","text":"Hey, Pal. You came just in time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_15","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_15","text":"Talk some sense into this blockhead, will you? She's completely uptight, unlike what she's wearing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_16","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_16","text":"And tell her I'm not doing anything shady!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_17","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_17","text":"Who exactly are you calling \"uptight\"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_18","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_18","text":"You show up at a police station in a bunny girl outfit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_19","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_19","text":"Do you not realize how ridiculously suspicious you look right now?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_20","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_20","text":"Don't tell me you actually walk around the Outpost dressed like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_21","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_21","text":"I already told you! I'm only wearing this for a mission, got it? That's it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_22","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_22","text":"Both of you, calm down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_23","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_23","text":"First, why don't you share why you came to the police station?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_24","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_24","text":"Fine, let's start with that one first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_25","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_25","text":"All right, then. Let's get this over with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_26","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_26","text":"Then, let's start with you, Milk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_27","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_27","text":"I came here to dig up some info on a target.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_28","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_28","text":"While I was working on the mission, I found out one of the target's lackeys is a wanted criminal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_29","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_29","text":"And if someone's on the wanted list, where else would you check but the police station, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_30","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_30","text":"So here I am, in the middle of digging through files,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_31","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_31","text":"when suddenly Privaty shows up out of nowhere and slaps cuffs on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_32","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_32","text":"Then, starts going off about how I look \"suspicious\" and she's taking me in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_33","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_33","text":"Like, seriously? If anyone's suspicious, it's her—strutting into the police station in that shameless outfit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_34","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_34","text":"Wh-who do you think you're calling—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_35","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_35","text":"Calm down, guys. It's Privaty's turn to speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_36","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_36","text":"Ugh... fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_37","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_37","text":"I stopped by on my way to the Maid Cafe","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_38","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_38","text":"because Admi asked me to request A.C.P.U.'s cooperation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_39","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_39","text":"But the moment I stepped into the station, I saw Milk doing something blatantly suspicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_40","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_40","text":"So I told her to stop and said I'd take her in for questioning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_41","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_41","text":"Doing something suspicious...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_42","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_42","text":"A Nikke in a bunny girl outfit tampering with the devices inside the police station without authorization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_43","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_43","text":"Doesn't that seem suspicious to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_44","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_10_44","text":"True that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_45","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_45","text":"Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_46","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_46","text":"Police stations and bunny girls... that's just a suspicious combo, no matter how you look at it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_47","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_47","text":"I've told you a dozen times! I'm only wearing this for the mission!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_48","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_48","text":"You could've changed before coming here, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_49","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_49","text":"There's absolutely no reason to be showing up here dressed like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_50","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_50","text":"Hey, I'm in a hurry, all right? There's no way I have time to change!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_51","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_51","text":"And what about you!? Don't you think *your* outfit is weird!?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_52","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_52","text":"You're just strutting around in that ridiculous, frilly thing like it's nothing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_53","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_53","text":"I-I'm not ashamed in the slightest!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_54","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_54","text":"Compared to what you're wearing, mine's practically tame.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_55","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_55","text":"Oh, really now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_56","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_56","text":"That thing's covered in ribbons and frills,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_57","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_57","text":"and the skirt's so short you'd give everyone a free show with one wrong move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_58","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_58","text":"And if you're supposed to be a maid, what's with the cat ears and tail?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_59","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_59","text":"I'd never be caught dead in something that humiliating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_60","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_60","text":"H-how dare you...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_61","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_61","text":"You should take a good look at yourself!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_62","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_62","text":"You've got rabbit ears and a tail too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_63","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_63","text":"And that outfit... it's practically skin-tight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_64","type":"Speech","speaker":"privaty_m","key":"Locale_SuddenStory:d_ex_police_10_64","text":"At least I'm wearing a skirt, so I'm clearly better off than you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_65","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_65","text":"It's not like this is unusual or anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_10_66","type":"Speech","speaker":"milk_b","key":"Locale_SuddenStory:d_ex_police_10_66","text":"Everyone else in Coin Rush is wearing the same thing too.","jump":null,"