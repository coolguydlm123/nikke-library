{"id":"d_main_16_04","cat":"main","group":{"id":"ch16","label":"Chapter 16 · Brand"},"label":"Comrade's Justice","stage":"16-7 STAGE · Start","prev":"d_main_16_03","next":"d_main_16_05_s","speakers":{"anis":"Anis","jackal":"Jackal","Narration":"Narration","neon":"Neon","Self":"Commander","crow":"Crow"},"icons":{"anis":"si_c012_00_s","jackal":"si_c111_00_s","Narration":"si_c999_00_s","neon":"si_c011_00_s","crow":"si_c110_00_s"},"lines":[{"id":"d_main_16_04_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_1","text":"We've got a problem.","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":"bgm_secondhand_a","movie":null,"shown":["anis","jackal","viper","crow"],"affinity":null},{"id":"d_main_16_04_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_2","text":"There are frozen sheets of ice between the streets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_3","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_3","text":"So what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_4","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_4","text":"Can't we just walk across?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_5","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_16_04_5","text":"*Stomp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_6","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_16_04_6","text":"*Stoooomp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_7","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_7","text":"Uh-oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_8","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_16_04_8","text":"*Splash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_9","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_9","text":"Ugh! Argh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_herecomestrouble","movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_10","text":"You tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_11","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_16_04_11","text":"... Some time later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi","neon","jackal"],"affinity":null},{"id":"d_main_16_04_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_12","text":"Listen carefully. Nikkes' bodies are incredibly heavy, so when you step on ice, you're in for an ice bath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_13","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_13","text":"W-w-why. Why are you telling me that n-n-n-now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_16_04_14","text":"Wow. I've never seen a Nikke chattering their teeth like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_15","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_04_15","text":"Put a jacket on Jackal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_16","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_16","text":"A-a-are you giving me this because I'm c-c-c-cold?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_17","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_04_17","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_18","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_18","text":"He... Commander, you are r-r-r-really a unique...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_19","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_19","text":"Nobody has e-e-ever done this for me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_20","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_21","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_21","text":"Don't let it get to your head, Jackal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_22","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_22","text":"They are just softening you up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_23","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_23","text":"When the time comes, they won't hesitate to use you as cannon fodder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_24","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_24","text":"Then after the fact, they will shower you with compliments and pretend they care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_25","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_25","text":"Haven't you ever interacted with a human before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_26","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_16_04_26","text":"You've been burnt before, and now you're taking it out on the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_27","text":"She complains when we're mean, then complains when we're nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_28","text":"If that's the case, we might as well be mean all the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_29","text":"After all, we can't win either way","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_30","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_30","text":"And what about all of you? How can you go through life being so gullible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_31","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_31","text":"This rookie Commander shows everyone the slightest bit of affection, and you seem to think you're colleagues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_32","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_04_32","text":"We are colleagues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_33","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_33","text":"You say that now, when you're on the battlefield and in the thick of it all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_34","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_34","text":"But what do you think will happen when we go back to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_35","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_35","text":"Some of us will be discarded and become lumps of scrap metal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_36","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_36","text":"Others will be lionized as they stand on the shoulders of those who have been sent to the scrap yard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_37","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_04_37","text":"If that's what you call a colleague, then the commander in chief of the Ark and I are very good colleagues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_04_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_16_04_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_16_04_40","text":"Master, should I take back the jacket?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_41","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_04_41","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_04_42","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_16_04_42","text":"Leave it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}