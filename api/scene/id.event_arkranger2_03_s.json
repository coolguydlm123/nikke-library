{"id":"event_arkranger2_03_s","cat":"event","group":{"id":"ev40113","label":"ARK RANGER · Part 2"},"label":"A Familiar Discomfort: A","stage":null,"prev":"event_arkranger2_02_e","next":"event_arkranger2_03_e","speakers":{"laplace_p":"Laplace","drake_p":"Drake","maxwell_p":"Maxwell"},"icons":{"laplace_p":"si_c103_00_s","drake_p":"si_c104_00_s","maxwell_p":"si_c105_00_s"},"lines":[{"id":"event_arkranger2_03_s_1","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":"bgm_theruinedcity","movie":null,"shown":["drake_p","laplace_p","maxwell_p"],"affinity":null},{"id":"event_arkranger2_03_s_2","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_3","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_4","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_4","text":"I can see them now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_5","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_5","text":"They're marching straight toward the Ark. Bold move for a bunch of Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_6","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_6","text":"The Ark's location must've been compromised a long time ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_7","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_7","text":"This is exactly why you don't go around just handing out your address.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_8","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_8","text":"Exactly. People these days have zero sense of caution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_9","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_9","text":"I doubt those Raptures are the main threat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_10","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_10","text":"Yeah. The chemical weapon's the real issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_11","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_11","text":"If we can't stop it from dropping down, the Ark's finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_12","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_13","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_13","text":"Even if we do intercept it, any leakage could still be dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_14","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_14","text":"Ugh, those cowards!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_15","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_15","text":"Yeah. It makes you wonder, though...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_16","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_16","text":"If they knew where we were, there's no reason they couldn't have done this before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_17","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_17","text":"It's not like the Ark moves around or anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_18","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_18","text":"I can't think of any explanation other than they've just been holding back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_19","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_19","text":"Hmph! I'll show them who's been going easy on who.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_20","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_20","text":"Either they were pulling their punches,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_21","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_21","text":"or a new Rapture leader is calling the shots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_22","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_22","text":"... The Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_23","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_23","text":"This isn't good. They're not going to stop at one missile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_24","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_24","text":"They're going to continue sieging the Ark. They're declaring war.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_25","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_25","text":"So what? All we have to do is crush them all, and that's the end of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_26","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_26","text":"They can send as big a swarm as they want. It changes nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_27","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_27","text":"Agreed! A hero never yields, no matter the odds!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_28","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_28","text":"Matis shall defeat any evil forces that assault the Ark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_03_s_29","text":"*Rumble, rumble*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_03_s_30","text":"The Rapture swarm is closing in. The vibrations intensify.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_31","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_31","text":"Five minutes until they're in range.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_32","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_32","text":"We also need to intercept the chemical weapon, so don't burn all your energy in the battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_33","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_33","text":"How do you expect us to win unless we go all out? If I end up losing because I have to hold back, I'll be so upset. It'll keep me up at night.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_34","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_34","text":"Counters will be joining us, so pace yourselves. Got it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_35","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_35","text":"Understood! I'll wipe them all out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_36","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_36","text":"... You did hear the part about pacing yourself, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_37","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:event_arkranger2_03_s_37","text":"Of course! I'll wipe them all out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_38","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_38","text":"Please, just listen for once in your life. Okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_39","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_39","text":"You never listen to others! Reflect on yourself as a hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_40","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_40","text":"Exactly. I'm glad at least you're on my side, Drake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_41","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:event_arkranger2_03_s_41","text":"Of course, that doesn't mean I won't wipe them all out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_03_s_42","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:event_arkranger2_03_s_42","text":"... Do whatever you want. Ugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}