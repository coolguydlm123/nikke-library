{"id":"d_counseling_mary_baygoddess_08","cat":"counsel","group":{"id":"char5064","label":"Mary: Bay Goddess"},"label":"Advising Mary: Bay Goddess: 08","stage":null,"prev":"d_counseling_mary_baygoddess_07","next":"d_counseling_mary_baygoddess_09","speakers":{"mary_s":"Mary"},"icons":{"mary_s":"si_c132_00_s"},"lines":[{"id":"d_counseling_mary_baygoddess_08_1","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_1","text":"Time flies by so quickly.\nThe sun is already setting.","jump":null,"exit":false,"enter":null,"bg":"Beach_s","bgArt":"beach_s","image":null,"bgm":"bgm_story_summermood","movie":null,"shown":["mary_s"],"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_2","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_2","text":"What do you think of when you see the sunset, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_08_3","text":"I feel as if I'm looking at a painting. It's beautiful.","jump":"d_counseling_mary_baygoddess_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_baygoddess_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_08_4","text":"I feel a bit melancholy.","jump":"d_counseling_mary_baygoddess_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_baygoddess_08_5","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_5","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_6","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_6","text":"It really is like looking at a painting. One with no imperfections.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_7","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_7","text":"It's so magical, it's hard to believe that it's real life.","jump":"d_counseling_mary_baygoddess_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_8","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_8","text":"You're so sentimental, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_9","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_9","text":"I keep having the feeling that I've seen this view before,\nback when I was living an ordinary life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_10","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_10","text":"But those times are long gone, much like the setting sun soon will be gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_11","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_08_11","text":"Hehe, I guess now that I think about it, I'm a bit melancholy myself. Of course, it bears mentioning that this entire view is artificial.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_08_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_08_12","text":"I watch the sunset with Mary.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}