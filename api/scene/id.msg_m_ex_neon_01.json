{"id":"msg_m_ex_neon_01","cat":"messenger","group":{"id":"room_neon","label":"Neon · Nikke"},"label":"1. I'm happy.","stage":null,"prev":null,"next":"msg_m_ex_neon_02","speakers":{"neon":"Neon"},"icons":{"neon":"si_c011_00_s"},"lines":[{"id":"m_ex_neon_01_1","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_1","text":"I'm happy.","jump":null},{"id":"m_ex_neon_01_2","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_2","text":"Lots of people don't understand the path of firepower.","jump":null},{"id":"m_ex_neon_01_3","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_3","text":"Until now,","jump":null},{"id":"m_ex_neon_01_4","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_4","text":"I've been all alone,","jump":null},{"id":"m_ex_neon_01_5","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_5","text":"walking the path on my lonesome.","jump":null},{"id":"m_ex_neon_01_6","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_6","text":"That is why I'm very happy to have met you, Master.","jump":null},{"id":"m_ex_neon_01_7","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_7","text":"Not only did you accompany me to walk this path,","jump":null},{"id":"m_ex_neon_01_8","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_8","text":"but you've also taught me a lot of things.","jump":null},{"id":"m_ex_neon_01_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_01_9","text":"It has been such a pleasure to meet you.","jump":null},{"id":"m_ex_neon_01_10","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_10","text":"In that case,","jump":null},{"id":"m_ex_neon_01_11","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_11","text":"I wanted to ask you something about the firepower theory.","jump":null},{"id":"m_ex_neon_01_12","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_12","text":"I would like to know,","jump":null},{"id":"m_ex_neon_01_13","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_13","text":"what does firepower mean to you?","jump":null},{"id":"m_ex_neon_01_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_01_14","text":"It's the sparkle of life.","jump":"m_ex_neon_01_16"},{"id":"m_ex_neon_01_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_01_15","text":"I have never thought about it.","jump":"m_ex_neon_01_19"},{"id":"m_ex_neon_01_16","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_16","text":"Even if it takes life to burn, it's still worth investing in.","jump":null},{"id":"m_ex_neon_01_17","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_17","text":"Wonderful.","jump":null},{"id":"m_ex_neon_01_18","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_18","text":"You are truly worthy of the name, Master.","jump":"m_ex_neon_01_22"},{"id":"m_ex_neon_01_19","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_19","text":"!!!","jump":null},{"id":"m_ex_neon_01_20","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_20","text":"You're saying it's just like breathing.","jump":null},{"id":"m_ex_neon_01_21","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_21","text":"I understand.","jump":null},{"id":"m_ex_neon_01_22","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_22","text":"Let me ask you one more question.","jump":null},{"id":"m_ex_neon_01_23","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_23","text":"What's the end of firepower for you?","jump":null},{"id":"m_ex_neon_01_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_01_24","text":"I don't know.","jump":null},{"id":"m_ex_neon_01_25","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_25","text":"Oh...","jump":null},{"id":"m_ex_neon_01_26","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_26","text":"I see.","jump":null},{"id":"m_ex_neon_01_27","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_27","text":"You haven't reached that level yet, Master.","jump":null},{"id":"m_ex_neon_01_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_01_28","text":"Let's find out together.","jump":null},{"id":"m_ex_neon_01_29","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_29","text":"Uh...","jump":null},{"id":"m_ex_neon_01_30","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_30","text":"Okay, haha...","jump":null},{"id":"m_ex_neon_01_31","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_31","text":"Let's find out together.","jump":null},{"id":"m_ex_neon_01_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_01_32","text":"Let's do this!","jump":null},{"id":"m_ex_neon_01_33","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_01_33","text":"Yes!","jump":null}],"chat":true}