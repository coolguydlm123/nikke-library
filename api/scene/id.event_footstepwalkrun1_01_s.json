l,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_31","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_31","text":"Yes, they are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_32","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_32","text":"Nikkes are amazing. Goddesses of Victory fighting for humanity... so cool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_33","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_33","text":"You really like Nikkes, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_34","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_34","text":"Of course. They're the best. They're so strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_35","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_35","text":"That they are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_36","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_36","text":"With them fighting on our behalf, we're sure to win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_37","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_37","text":"I don't understand. What's so great about winning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_38","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_38","text":"What a question. Everything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_39","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_39","text":"You've never seen the real sky, have you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_40","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_40","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_41","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_41","text":"I mean the actual sky, not an artificial projection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_42","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_42","text":"I'm still not following.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_43","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_43","text":"Haha. You'll understand soon enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_44","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_44","text":"The sky is absolutely breathtaking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_45","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_45","text":"If you say so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_46","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_46","text":"You're not interested?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_47","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_47","text":"You've been staring at that syringe during our entire conversation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_48","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_48","text":"... Is there any chance I can forego the shot today?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_49","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_49","text":"Come now, you know better than that. You need these shots and the medication to get better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_