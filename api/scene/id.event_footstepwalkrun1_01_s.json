:"event_footstepwalkrun1_01_s_18","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_18","text":"Haha. You were born in the Ark, weren't you, Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_secondhand","movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_19","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_19","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_20","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_20","text":"Then you might not realize how much this means to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_21","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_21","text":"All of our real homes are up there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_22","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_22","text":"Up where? In the sky?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_23","type":"Speech","speaker":"nurse","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_23","text":"No, a place called the Surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_01_s_24","type":"Speech","speaker":"youngrapi","key":"Locale_MainScenario:event_footstepwalkrun1_01_s_24","text":"I heard that it's dangerous