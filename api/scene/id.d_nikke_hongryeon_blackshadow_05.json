,"speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_11","text":"Good grief, how arrogant can you get?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_12","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_12","text":"I'm off. Take thine time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_13","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_13","text":"Scarlet heads off into the battlefield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_14","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_14","text":"Some plan. Charging headlong into the enemy formation without any sort of preparation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_15","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_15","text":"Is she really going to be okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_16","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_17","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_17","text":"Well, what'd you think of her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["dorothy","rapunzel_o"],"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_18","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_18","text":"As a spectator, I think she can more than pull her own weight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_19","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_19","text":"Yes. She was as still as a statue while meditating,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_20","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_20","text":"not even so much as a twitch of the eyebrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_21","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_21","text":"Her concentration and control over her own body are far above average.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_22","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_22","text":"She was able to make sense of how I assembled my weapon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_23","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_23","text":"I could sense her eyes meticulously tracking my every move, never once falling behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_24","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_24","text":"I'm willing to bet she knows my weapon inside and out now, all from a single glance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_25","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_25","text":"Not just anyone can split a bullet in half.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_26","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_26","text":"Once she kinda got the hang of it, she just went all in and nailed it every time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_27","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_27","text":"Haha! She's a beast!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_28","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_28","text":"... I knew Scarlet was manufactured using a mass-produced model as a base,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_29","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_29","text":"and it's embarrassing to admit that I'd exerted all my power against her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_30","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_30","text":"In terms of our stats, I should have easily triumphed over her. And yet, I fell short.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_31","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_31","text":"She clearly possesses exceptional control over her body and can manipulate her strength with stunning precision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_32","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_32","text":"Sounds like we're all in agreement. Well then, I guess it's time to get into the real action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_33","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_33","text":"A mid-scale battle will be coming up soon, so let's see how she handles it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_34","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_34","text":"Liliweiss, are you listening?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["commander"],"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_35","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_36","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_36","text":"Mecha Destruc...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_37","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_37","text":"Scarlet is strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_38","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_38","text":"So, it's okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_39","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_39","text":"All right, that's a load off my mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_40","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_40","text":"I trust your judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_41","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_41","text":"Hehe, naturally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_42","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_42","text":"Scarlet slashes through the Raptures like a woman possessed.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"event_bgm_redash_ashsmoke","movie":null,"shown":["hongryeon_o"],"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_43","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_43","text":"Her body is in peak condition, moving exactly as she intends to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_44","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_44","text":"She keeps slashing, slashing, and slashing without a pause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_45","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_45","text":"All the while, an incessant torrent of enemies continues to pour out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_46","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_46","text":"And so she continues to slash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_47","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_47","text":"At last, a battle befitting my skills!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_48","type":"Speech","speaker":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_48","text":"Come, then! Come for me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_49","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_49","text":"Are thou watching, everyone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_50","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_50","text":"I stand alone in battle","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_51","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_51","text":"as the sole survivor while brandishing my blade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_52","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_52","text":"Hyah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_53","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blacksha