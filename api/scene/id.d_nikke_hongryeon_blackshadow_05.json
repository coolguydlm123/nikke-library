":"hongryeon_o","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_59","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_60","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_60","text":"I hath acquired new comrades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_61","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_61","text":"They're quite different from thee,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_62","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_62","text":"yet they share the same noble quest as thee: fighting for the sake of mankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_63","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_63","text":"And I shall fight alongside with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_64","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_64","text":"So...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_blackshadow_05_65","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_hongryeon_blackshadow_05_65","text":"We've got a big boy incoming!","jump":null