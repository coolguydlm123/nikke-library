{"id":"d_counseling_bready_06","cat":"counsel","group":{"id":"char5135","label":"Bready"},"label":"Advising Bready: 06","stage":null,"prev":"d_counseling_bready_05","next":"d_counseling_bready_07","speakers":{"bready":"Bready"},"icons":{"bready":"si_c520_00_s"},"lines":[{"id":"d_counseling_bready_06_1","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_1","text":"Do you like that","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["bready"],"affinity":"_0"},{"id":"d_counseling_bready_06_2","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_2","text":"I call you Bonne Bouche?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_3","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_3","text":"I've been wondering whether it makes you uncomfortable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_06_4","text":"Not at all. It's a special nickname that you invented just for me.","jump":"d_counseling_bready_06_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_bready_06_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_06_5","text":"There are occasions where I think it's a bit too... cutesy.","jump":"d_counseling_bready_06_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_bready_06_6","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_bready_06_6","text":"I like it very much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_7","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_7","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_8","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_8","text":"You really are like no one else I've met, Bonne Bouche.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_9","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_9","text":"The more I get to know you, the more fascinating you become.","jump":"d_counseling_bready_06_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_10","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_10","text":"Hmm, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_11","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_11","text":"Well, if it ever makes you feel too uncomfortable, please do let me know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_06_12","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_06_12","text":"I don't ever want you to feel troubled because of me.","jump":"d_counseling_bready_06_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counsel