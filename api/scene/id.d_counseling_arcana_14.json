{"id":"d_counseling_arcana_14","cat":"counsel","group":{"id":"char5140","label":"Arcana"},"label":"Advising Arcana: 14","stage":null,"prev":"d_counseling_arcana_13","next":"d_counseling_arcana_15","speakers":{"arcana":"Arcana"},"icons":{"arcana":"si_c581_00_s"},"lines":[{"id":"d_counseling_arcana_14_1","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_1","text":"{AccountData.NickName}, I have a serious question to ask you, and I expect a serious and honest answer in return.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["arcana"],"affinity":"_0"},{"id":"d_counseling_arcana_14_2","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_2","text":"I've never been so serious about anything before in my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_3","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_3","text":"What do you think about marriage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_14_4","text":"I think it's something that I'd find very fulfilling.","jump":"d_counseling_arcana_14_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_arcana_14_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_14_5","text":"For me, it's a death sentence.","jump":"d_counseling_arcana_14_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_arcana_14_6","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_6","text":"Really? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_7","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_14_7","text":"Because I get to spend the rest of my life with the one I love.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_8","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_8","text":"Wow, I didn't expect you to be so romantic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_9","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_9","text":"I suppose you're right. What could be better than that?","jump":"d_counseling_arcana_14_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_10","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_10","text":"Oh my gosh, why would you think that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_11","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_14_11","text":"Because any time a problem comes up, I have to worry about someone else in addition to myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_12","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_14_12","text":"Then you face it together, with the person you love!","jump":"d_counseling_arcana_14_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_14_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_14_13","text":"I share my thoughts on marriage with Arcana.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}