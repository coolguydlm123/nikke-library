{"id":"d_counseling_hongryeon_02","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 02","stage":null,"prev":"d_counseling_hongryeon_01","next":"d_counseling_hongryeon_03","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_02_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_02_1","text":"My Lord, do you fancy the Outpost?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_02_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_02_2","text":"Yes, I do.","jump":"d_counseling_hongryeon_02_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_02_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_02_3","text":"No, I don't.","jump":"d_counseling_hongryeon_02_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_02_4","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_02_4","text":"I see. So it is very much to my Lord's liking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_02_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_02_5","text":"Because this is my Lord's home.","jump":"d_counseling_hongryeon_02_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_02_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_02_6","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_02_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_02_7","text":"If I may say so, I myself am not partial to this particular locale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_02_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_02_8","text":"There is no sky, no moonlight, no wind here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_02_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_02_9","text":"It's all rather stuffy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_02_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_02_10","text":"I have a conversation with Scarlet about the Outpost.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}