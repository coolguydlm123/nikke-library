ction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_54","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_54","text":"Excuse me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_55","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_55","text":"Have I done something wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_56","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_56","text":"Certainly not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_57","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_57","text":"Then I'm afraid I don't understand...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_58","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_58","text":"What I mean is that the very concept of a maid cafe is contradictory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_59","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_59","text":"I still don't follow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_60","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_60","text":"A cafe is supposed to be a place where customers are simply served a cup of coffee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_61","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_61","text":"But here, everyone who visits is treated as a master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_62","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_62","text":"That made me think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_63","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_63","text":"Masters and a guest are like two opposite sides of a coin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_64","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_64","text":"In this establishment, however, those two concepts become one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_65","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_65","text":"It is a place","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_66","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_66","text":"where these contradictory elements harmonize.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_67","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_67","text":"I have realized now the wellspring of the Conductor's inspiration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_68","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_68","text":"He finds joy in such contradictions, and thus derives inspiration from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_69","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_69","text":"I wanted to capture the exhilaration, the power of that contradiction within my melody,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_70","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_70","text":"but encapsulating such a paradox is like trying to make coffee that is both hot and cold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_71","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_71","text":"I have lost the path the notes were meant to take.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_72","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_72","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_73","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_73","text":"I know she's speaking English, but I don't understand a word of what she's saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_74","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_74","text":"That's not what a maid cafe is, Julia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_75","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_75","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_76","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_76","text":"Here, there are only masters and maids.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_77","text":"There are no guests, and so there is no contradiction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_78","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_78","text":"That's right! I've never thought of any of our masters as simply customers!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_79","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_79","text":"The same goes for you, Julia. You're not a customer, you're a lady.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_80","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_80","text":"Just enjoy it for what it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_81","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_81","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_82","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_82","text":"I think I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_83","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_83","text":"This place is filled with pure, unadulterated joy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_84","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_84","text":"You enjoy it, and so you are able to find inspiration here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_85","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_85","text":"I simply need to give in and enjoy something which is simple in nature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_86","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_86","text":"Wait! An excellent melody just came to me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_87","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_87","text":"Julia pulls out her notebook and starts writing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_88","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_88","text":"Thank you for taking me here, Conductor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_89","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_89","text":"Thanks to you, I've added another nuance to my melody.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_90","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_90","text":"I feel like a brilliant piece is about to be born.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_91","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_91","text":"I just showed you the way. You did the rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_92","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_92","text":"No, without you guiding me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_93","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_93","text":"I wouldn't have realized such a joyous place existed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_94","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_94","text":"Following you here was the right choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_95","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_95","text":"Soon, I'll be able to fill up this notebook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_96","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_96","text":"Still got a little more to go, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_97","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_97","text":"Yes, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_98","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_98","text":"I've managed to add a subtle new shade of color to the melody within me, but my goal is to fill it in completely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_99","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_99","text":"In order for that to happen, I must depend on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_100","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_100","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_101","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_101","text":"After finishing the coffee, I get up to head to the next location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_102","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_102","text":"I'm sorry that I couldn't follow what you were saying, Miss,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_103","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_103","text":"and couldn't be much help...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_104","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_104","text":"Do not worry. I have already received enough help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_105","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_105","text":"You have become my muse, Cocoa. It is as if a window has been opened to my soul, and a fresh breeze is blowing in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_106","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_106","text":"You mean I was helpful?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_107","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_107","text":"Absolutely. I will return here again to feel the flow of this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_108","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_04_108","text":"I wish you peace until then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_109","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_109","text":"See you next time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_110","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:treasurestory_julia_04_110","text":"Okay, take care, Master! Take care, Miss!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_111","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_111","text":"♬♪♩♬♪♩♬♪♩","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_04_112","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_04_112","text":"Instead of spoken words, Julia responds by playing a beautiful melody on her violin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}