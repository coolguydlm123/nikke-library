ty_mightybunny_03_18","text":"For example...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_03_19","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_03_19","text":"Just then, my phone rings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_03_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_03_20","text":"I think we'll stop here for today, Guilty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_03_21","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_03_21","text":"Huh...? But I didn't get to hear what you were going to say...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_03_22","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_03_22","text":"And I didn't finish cleaning... and we barely got to hold hands...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_03_23","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_03_23","text":"We can do it again next time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_03_24","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_03_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,