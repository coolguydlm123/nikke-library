eden_05_48","text":"Then pretend to be arrogant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_49","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_05_49","text":"Arrogant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_50","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_05_50","text":"Picture an arrogant, confident version of yourself standing before your timid self, acting as a shield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_51","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_05_51","text":"Even if people see you as annoying,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_52","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_05_52","text":"hold your head high and laugh arrogantly so you don't feel intimidated in front of others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_53","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_05_53","text":"Laugh arrogantly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_54","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_05_54","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_55","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_05_55","text":"Give me a laugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_56","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_05_56","text":"You want me to laugh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_57","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_05_57","text":"Uh... he... heh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_58","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_05_58","text":"Now that just sounds silly. Imagine you're lording above everyone else and let out a mighty guffaw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_59","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_05_59","text":"Ha... hahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_60","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_05_60","text":"That's more like it. Now, try a mocking laugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_61","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_05_61","text":"... Teehee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_05_62","type":"Speech","speaker":"harran",