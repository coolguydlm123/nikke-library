{"id":"msg_m_ex_pepper_01","cat":"messenger","group":{"id":"room_pepper","label":"Pepper · Nikke"},"label":"1. Hello, Commander!","stage":null,"prev":null,"next":"msg_m_ex_pepper_02","speakers":{"pepper":"Pepper"},"icons":{"pepper":"si_c131_00_s"},"lines":[{"id":"m_ex_pepper_01_1","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_1","text":"Hello, Commander!","jump":null},{"id":"m_ex_pepper_01_2","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_2","text":"My name is Pepper. It's my first day at the Outpost Hospital.","jump":null},{"id":"m_ex_pepper_01_3","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_3","text":"It's an honor to work with you.","jump":null},{"id":"m_ex_pepper_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_01_4","text":"Same here.","jump":null},{"id":"m_ex_pepper_01_5","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_5","text":"Great, hehe!","jump":null},{"id":"m_ex_pepper_01_6","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_6","text":"Commander...","jump":null},{"id":"m_ex_pepper_01_7","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_7","text":"can you help me with something?","jump":null},{"id":"m_ex_pepper_01_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_01_8","text":"Sure.","jump":null},{"id":"m_ex_pepper_01_9","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_9","text":"Before I came here,","jump":null},{"id":"m_ex_pepper_01_10","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_10","text":"I was told you were neglecting your health.","jump":null},{"id":"m_ex_pepper_01_11","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_11","text":"Is that true?","jump":null},{"id":"m_ex_pepper_01_12","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_01_12","text":"If anything, I paid too much attention to it.","jump":"m_ex_pepper_01_14"},{"id":"m_ex_pepper_01_13","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_01_13","text":"Well, I do overlook it a bit too much.","jump":"m_ex_pepper_01_16"},{"id":"m_ex_pepper_01_14","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_14","text":"Really?","jump":null},{"id":"m_ex_pepper_01_15","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_15","text":"I'm glad to hear that it's the total opposite!","jump":"m_ex_pepper_01_18"},{"id":"m_ex_pepper_01_16","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_16","text":"Wonderful!","jump":null},{"id":"m_ex_pepper_01_17","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_17","text":"Well, from now on, I'll be available to help look after your health.","jump":null},{"id":"m_ex_pepper_01_18","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_18","text":"If you feel sick or exhausted,","jump":null},{"id":"m_ex_pepper_01_19","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_19","text":"be sure to come to the Hospital,","jump":null},{"id":"m_ex_pepper_01_20","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_20","text":"okay?","jump":null},{"id":"m_ex_pepper_01_21","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_21","text":"Your health is the most important!","jump":null},{"id":"m_ex_pepper_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_01_22","text":"Got it.","jump":null},{"id":"m_ex_pepper_01_23","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_23","text":"All right, take it easy.","jump":null},{"id":"m_ex_pepper_01_24","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_01_24","text":"Don't work too hard.","jump":null},{"id":"m_ex_pepper_01_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_01_25","text":"Same to you!","jump":null}],"chat":true}