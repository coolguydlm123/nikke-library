{"id":"d_main_42_af_09","cat":"main","group":{"id":"ch42","label":"Chapter 42 · Only One"},"label":"Unexpected Contact","stage":null,"prev":"d_main_42_af_08","next":null,"speakers":{"anis_i":"Anis","rapi_red":"Rapi"},"icons":{"anis_i":"si_c017_00_s","rapi_red":"si_c016_00_s"},"lines":[{"id":"d_main_42_af_09_1","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_1","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":"bgm_story_luckybreak","movie":null,"shown":["rapi_red","anis_i"],"affinity":null},{"id":"d_main_42_af_09_2","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_42_af_09_2","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_3","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_3","text":"I know it hasn't been that long, but it feels like it's been ages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_4","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_4","text":"Tell me about it. Did you have fun while I was gone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_5","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_5","text":"A lot happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_6","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_6","text":"Let's head inside and talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_7","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_7","text":"Sure. I brought plenty of snacks and drinks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_8","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_42_af_09_8","text":"We recount to each other what we went through. By the time we're done, it's already dark outside.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom_n","bgArt":"commanderroom_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_9","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_9","text":"The Queen... Wow, that is quite the story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_10","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_10","text":"Same with you, pop star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_11","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_11","text":"Hm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_12","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_12","text":"Why did you insist on making a performance part of the deal, anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_13","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_13","text":"Because I kept fixating on just the ugly, rotten parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_14","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_14","text":"Mustang hoped that while I prepared for the performance, I'd meet different kinds of people and finally realize something:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_15","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_15","text":"that the Ark has a lot of good people in it, and that they need a star to look to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_16","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_16","text":"He should've just said that to you, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_17","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_17","text":"I mean... it's all entertainment for him, I suppose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_18","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_18","text":"He hasn't changed a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_19","text":"So, is everything at the Ark taken care of?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_20","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_20","text":"Yeah, for the time being. They say all the crystals are gone, and not too many people were injured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_42_af_09_21","text":"A terrorist attack using crystals...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_22","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_22","text":"For now, we should regroup with Neon. Then we can decide on our next move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_23","text":"It doesn't sound like we can just leave Sixo unchecked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_42_af_09_24","text":"Agreed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_25","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_25","text":"E.H. seems to be launching a full-on pursuit. If there's anything we can do to help, we should.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_26","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_26","text":"Fortunately, nothing has happened on the surface yet,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_27","text":"so we can focus on the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_28","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_28","text":"There's always a chance the Queen suddenly comes at us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_42_af_09_29","text":"We'll just have to trust Liberalio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_30","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_30","text":"Are you sure you're not being too trusting of everyone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_31","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_31","text":"It's because the Commander is so trusting that we're here now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_32","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_42_af_09_32","text":"Yeah, that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_09_33","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_af_09_33","text":"Besides, even if the Queen does come, we have you to shoot her down.","jump":null,"exi