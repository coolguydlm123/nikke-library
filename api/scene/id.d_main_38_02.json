movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_22","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_22","text":"Never mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_23","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_23","text":"First things first, we need to get Behemoth back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_24","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_24","text":"Otherwise, there's no telling what they'll do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_25","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_25","text":"They might take that egg back to the Ark and crack it open.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_26","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_27","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_27","text":"Ziz, go and find Behemoth. Now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_28","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_29","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_29","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_30","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_31","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_31","text":"Hey, can't you hear me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_32","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_32","text":"Huh? Oh, yeah, I can hear you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_33","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_33","text":"You need to go find Behemoth!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_34","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_34","text":"... *Sob*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_35","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_35","text":"What the... what's wrong now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_36","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_36","text":"Waaahhhhh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_37","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_38","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_38","text":"Ziz, what's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_39","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_39","text":"Waaahhhhh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_40","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_40","text":"Waaahhhhh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_41","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_41","text":"Okay, okay. Whatever I did, I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_42","type":"Speech","speaker":"leviathan","key":"Locale_MainScenario:d_main_38_02_42","text":"Just stop crying, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_43","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_43","text":"*Sniffle*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_02_44","type":"Speech","speaker":"ziz","key":"Locale_MainScenario:d_main_38_02_44","text":"I-it's just that it's been a long time, and I was happy to see you.","