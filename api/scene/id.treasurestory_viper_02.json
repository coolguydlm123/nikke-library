asurestory_viper_02_26","text":"Feast your eyes on this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_viper_02_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_viper_02_27","text":"Huh? A phone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_viper_02_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_viper_02_28","text":"... It looks a bit old too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_viper_02_29","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:treasurestory_viper_02_29","text":"That's right. Nobody uses phones like this anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_viper_02_30","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:treasurestory_viper_02_30","text":"It's the first one that I ever used.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_viper_02_31","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:treasurestory_viper_02_31","text":"What do you think? Isn't it cute?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_viper_02_32","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:treasurestory_viper_02_32","text":"Check out all the fun beads and stickers I put on it, hehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_viper_02_33","type":"Sel