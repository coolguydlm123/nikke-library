ck","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_13","text":"You've got dark circles under your eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_14","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_14","text":"Guess I've been running myself ragged lately...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_15","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_15","text":"Maybe you should get some rest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_16","text":"No, I'm in the mood for a walk. It's been a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_17","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_17","text":"I suppose a walk could help you unwind as well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_18","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_18","text":"A light stroll around the Ark will probably help you sleep better tonight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_19","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_19","text":"You're probably right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_20","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_20","text":"I don't know if saying this will bring you much comfort,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_21","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_21","text":"but I know you've been carrying a lot on your shoulders, fighting on the battlefield while keeping up with all the paperwork on top of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_22","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_22","text":"I'm always rooting for you, {AccountData.NickName}.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_23","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_23","text":"And I doubt I'm the only one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_24","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_24","text":"You've got plenty of people rooting for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_25","text":"Thanks. That really means a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_26","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_26","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_27","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_27","text":"I'm glad you feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_28","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_28","text":"Well, I should get going...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_29","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_29","text":"Actually, wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_30","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_30","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_31","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_31","text":"I'm about to start my patrol of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_32","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_32","text":"Why do you patrol the Ark anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_33","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_33","text":"There may be people out there who need a hero's help, yet aren't in a position to ask for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_34","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_34","text":"So I need to keep an eye on every corner of the Ark, from the places in plain sight, to the ones people rarely notice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_35","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_35","text":"That's all part of a hero's duty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_36","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_36","text":"Ah, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_37","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_37","text":"So, I was thinking...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_38","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_38","text":"Would you care to join me, {AccountData.NickName}?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_39","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_39","text":"You want me to go on an Ark patrol?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_40","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_40","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_41","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_41","text":"I've been wanting to do some heroic work with you for some time now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_42","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_42","text":"And since we'd be on patrol, it'd double nicely as your walk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_43","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_43","text":"Okay, let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_44","type":"Speech","speaker":"arkrangerblack","key":"Locale_NikkeEpisode:d_nikke_arkrangerblack_01_44","text":"Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arkrangerblack_01_45","type":"Speech","speake