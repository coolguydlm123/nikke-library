{"id":"d_counseling_neon_17","cat":"counsel","group":{"id":"char3002","label":"Neon"},"label":"Advising Neon: 17","stage":null,"prev":"d_counseling_neon_16","next":"d_counseling_neon_18","speakers":{"neon":"Neon"},"icons":{"neon":"si_c011_00_s"},"lines":[{"id":"d_counseling_neon_17_1","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_17_1","text":"Master, I want to ask you a serious question.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["neon"],"affinity":"_0"},{"id":"d_counseling_neon_17_2","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_17_2","text":"What would you be more afraid of: running out of bullets, or food?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_17_3","text":"Food.","jump":"d_counseling_neon_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_neon_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_17_4","text":"Bullets.","jump":"d_counseling_neon_17_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_neon_17_5","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_17_5","text":"What?! How can you say that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_6","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_17_6","text":"As a die-hard proponent of all things weaponry, I thought for sure you'd say bullets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_7","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_neon_17_7","text":"Off in the distance, I can hear the muffled sound of Anis cheering wildly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_8","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_17_8","text":"Sigh... I made a bet with Anis. I thought you saying bullets was a done deal... guess I lost.","jump":"d_counseling_neon_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_9","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_17_9","text":"Too right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_neon_17_10","text":"Off in the distance, I can hear the muffled sound of Anis's frustrated screams.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_11","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_17_11","text":"I made a bet with Anis. I said you would go for bullets, and I was right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_17_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_neon_17_12","text":"Watched Neon and Anis settle their bets.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}