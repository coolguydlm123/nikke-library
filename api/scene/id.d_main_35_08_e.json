ale_MainScenario:d_main_35_08_e_63","text":"Some have one Nikke leg and one Rapture leg,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_64","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_64","text":"whereas others are entirely Rapture-like, with only a single Nikke eye attached.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_65","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_65","text":"We didn't find any with Nikke heads attached, which I suppose is a small relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_66","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_66","text":"It's a complete mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_67","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_67","text":"It's as if someone disassembled a bunch of Raptures and Nikke parts and tossed them in a blender.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_68","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_08_e_68","text":"Can I see for myself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_69","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_69","text":"I don't think that's a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_70","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_70","text":"Personally, I'd request a memory wipe if I could.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_71","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_71","text":"I suggest you simply listen to our findings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_72","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_72","text":"I agree with Rapi, Cutey. Seeing what's out there might break you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_73","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_08_e_73","text":"... Okay. Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_74","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_74","text":"We've collected some samples.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_75","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_75","text":"We won't be able to conduct any proper research here. Not that we'd want to anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_76","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_76","text":"We'll hand it over to M.M.R. when we go back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_77","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_08_e_77","text":"That liquid which spilled out of the eggs was Dark Matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_78","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_35_08_e_78","text":"There must be a connection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_79","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_79","text":"Yeah. Apparently Dark Matter is also a type of nanomachine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_80","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_80","text":"There's a high chance that it's acting as a catalyst.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_81","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_81","text":"Absolute took some Dark Matter samples, so if we investigate those, something is bound to come out of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_82","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_82","text":"Who knows? We might find a clue as to how Heretics are created.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_83","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_08_e_83","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_84","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_84","text":"Cinderella, I realize this may be crass, but can I ask you something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_85","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_08_e_85","text":"I don't remember anything about becoming a Heretic, so I won't be of any help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_86","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_86","text":"I see. Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_87","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_08_e_87","text":"No. I appreciate you being upfront.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_88","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_88","text":"There's one more thing I can't get my mind off of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_89","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_08_e_89","text":"The calling signal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_90","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_90","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_91","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_91","text":"Historically, only Lord Class or higher Raptures have been able to emit those signals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_92","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_92","text":"That... thing that came from that egg, let's call it a fusion for now, was a Husk Class at best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_93","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_93","text":"It shouldn't have been able to activate a calling signal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_94","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_94","text":"At least, not according to the current knowledge we have on Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_95","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_95","text":"The other fusions from these eggs were either Husk Class or even lower,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_96","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_96","text":"but they all at least attempted to use a calling signal, even though none of them were able to succeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_97","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_08_e_97","text":"So this place is filled with these strange fusion creatures that are somehow able to emit calling signals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_98","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_98","text":"Correct, and it's clear to me that this isn't something that occurred naturally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_99","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_99","text":"There was some form of intelligent intervention, and Leviathan is the most plausible culprit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_100","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_101","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_101","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_102","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_102","text":"Leviathan probably has lots of information that we could use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_103","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_103","text":"I propose our next step be to capture and interrogate her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_104","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_08_e_104","text":"Capturing a Heretic... Is that even possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_105","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_08_e_105","text":"It's possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_106","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_08_e_106","text":"If it was Behemoth we were going up against, then it'd be a different story. But if it's Leviathan, then it's worth a shot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_107","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_08_e_107","text":"She's not terribly strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_108","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_108","text":"Yes. Leviathan's strength isn't all that formidable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_109","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_109","text":"If another one of the Four Beasts were to join her, then we'd have to reconsider, but if she's acting alone, it's entirely within the realm of possibility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_110","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_08_e_110","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_111","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_35_08_e_111","text":"Then our next aim is to capture Leviathan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_112","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_35_08_e_112","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_113","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_35_08_e_113","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_114","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_114","text":"Hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_115","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_115","text":"Haha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_116","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_08_e_116","text":"If Maxwell is laughing, I guess I should as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_117","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_35_08_e_117","text":"Mwahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_118","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_118","text":"We've really gone off the deep end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_35_08_e_119","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_35_08_e_119","text":"Capturing a Heretic? This is absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}