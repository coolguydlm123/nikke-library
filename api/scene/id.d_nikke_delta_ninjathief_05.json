null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_ninjathief_05_98","type":"Speech","speaker":"phantom","key":"Locale_NikkeEpisode:d_nikke_delta_ninjathief_05_98","text":"Hehe... I thought this would be the opportune moment,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_ninjathief_05_99","type":"Speech","speaker":"phantom","key":"Locale_NikkeEpisode:d_nikke_delta_ninjathief_05_99","text":"but it seems you are gazing farther than I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_ninjathief_05_100","type":"Speech","speaker":"phantom","key":"Locale_NikkeEpisode:d_nikke_delta_ninjathief_05_100","text":"Very well, I shall grant my permission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_ninjathief_05_101","type":"Speech","speaker":"phantom","key":"Locale_NikkeEpisode:d_nikke_delta_ninjathief_05_101","text":"Continue your efforts until the day you become an official member.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_ninjathief_05_102","type":"Speech","speaker":"delta_n","key":"Locale_NikkeEpisode:d_nikke_delta_ninjathief_05_102","text":"Thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_delta_ninjathief_05_103","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_delta_ninjathief_05_103","text":"Why are you the one giving permission...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nik