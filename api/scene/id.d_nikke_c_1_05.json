ty":null},{"id":"d_nikke_c_1_05_35","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_c_1_05_35","text":"... The food is tightly controlled.","jump":null,"exit":false,"enter":null,"bg":"Park","bgArt":"park","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_1_05_36","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_c_1_05_36","text":"Survival is not our main purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["yulha"],"affinity":null},{"id":"d_nikke_c_1_05_37","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_c_1_05_37","text":"We strive for more. We want the people to live their lives in peace,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_1_05_38","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_c_1_05_38","text":"even if they're unable to go up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_1_05_39","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_c_1_05_39","text":"That is what we, the Central Government, are responsible for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_1_05_40","type":"Speech","speaker":"yulha","key":"Locale_NikkeEpisode:d_nikke_c_1_05_40","text":"It's the entire reason why the Ark exists as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_c_1_05_41","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_c_1_05_41","text":"... But all of this results in a harmonious existence.","jump":null,"exit":false,"enter":null,"bg":"Office","