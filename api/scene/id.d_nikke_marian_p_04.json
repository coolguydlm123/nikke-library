l,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_p_04_83","type":"Speech","speaker":"ingrid","key":"Locale_NikkeEpisode:d_nikke_marian_p_04_83","text":"You were able to collect a skin tissue sample?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_p_04_84","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_marian_p_04_84","text":"I managed to do it when she wasn't paying attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_p_04_85","type":"Speech","speaker":"ingrid","key":"Locale_NikkeEpisode:d_nikke_marian_p_04_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_p_04_86","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_marian_p_04_86","text":"She's not as invincible as we thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_p_04_87","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_marian_p_04_87","text":"It's only when she's actively resisting that she can harden her skin to such an incredible degree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_p_04_88","type":"Speech","speaker":"ingrid","key":"Locale_NikkeEpisode:d_nikke_marian_p_04_88","text":"Well, what did you find?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marian_p_04_89","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_marian_p_04_89","text":"...","jump":null,"exit":false,"e