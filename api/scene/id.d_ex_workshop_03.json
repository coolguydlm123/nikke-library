_62","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_62","text":"I get it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_63","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_63","text":"It's like a collapsible hammock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_64","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_64","text":"It's easy to disassemble too. Here, you try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_65","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_workshop_03_65","text":"Maiden's excitement is palpable as she dismantles the hammock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_66","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_66","text":"Easy as pie! And it's even lighter than I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_67","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_67","text":"I can carry this in my bag no problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_68","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_68","text":"I guess you guys can make anything here after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_69","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_69","text":"Thank you. Now I can sneak in some cat naps when the Boss isn't looking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_70","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_70","text":"Um, well... how you decide to use it is up to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_71","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_71","text":"If you want to thank anyone, thank Greenhorn over here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_72","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_workshop_03_72","text":"Huh? Why me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_73","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_73","text":"If it weren't for you, I'd have never tried making this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_74","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_74","text":"I was being too close-minded, until you lit the fires of inspiration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_75","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_75","text":"If I'd given up because I thought it was impossible to make, we'd have lost a customer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_76","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_76","text":"Thank you Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_77","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_77","text":"Because of you, I found a new way to slack off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_78","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_workshop_03_78","text":"... You're welcome?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_79","type":"Speech","speaker":"maiden","key":"Locale_SuddenStory:d_ex_workshop_03_79","text":"I gotta go find someplace to test this baby out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_80","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_workshop_03_80","text":"*Ring*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_81","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_81","text":"Hehe, I've been building and tinkering for as long as I can remember, but I guess I still have a lot to learn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_82","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_82","text":"Now that I have some free time, I think I'll use it to do some studying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_83","type":"Speech","speaker":"liter","key":"Locale_SuddenStory:d_ex_workshop_03_83","text":"Care to help me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_84","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_workshop_03_84","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_workshop_03_85","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_workshop_03_85","text":"Liter and I studied all sorts of useful topics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}