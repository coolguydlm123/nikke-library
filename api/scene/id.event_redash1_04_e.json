give up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_109","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_109","text":"No matter who the adversary is, or how tough a mission lies ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_110","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_110","text":"You'd face it head-on with grit and mettle. You were never someone who'd resign themselves to defeat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_111","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_111","text":"In case you've forgotten, I'm dying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_112","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_112","text":"I don't have much time left. What other option do I have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_113","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_113","text":"All I can do is leave things in a better state for all of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_114","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_114","text":"You should fight it. \nLike you always have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,