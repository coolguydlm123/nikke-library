4_e_75","text":"Th-this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_76","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_76","text":"This is a dirty mag! My eyes! My eyes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_77","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_77","text":"Told ya it was anthropological in nature. Pretty interesting, eh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_78","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_78","text":"It's not interesting at all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_79","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_79","text":"How come you can't take your eyes off it, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_80","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_80","text":"It's just... it's my first time seeing this kind of stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_81","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_81","text":"I know. That's why I gave it to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_82","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_82","text":"You're trying to corrupt me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_83","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_83","text":"Oh, relax. Don't get your knickers in a twist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_84","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_84","text":"You've been living your entire life with safety wheels on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_85","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_85","text":"You were destined to become the next female religious leader from the day you were born, so you've been living your life based on other people's expectations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_marrybad","movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_86","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_86","text":"Becoming a Nikke wasn't your choice either, am I right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_87","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_88","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_88","text":"So how about pivoting and steering yourself in your own direction?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_89","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_89","text":"That... that doesn't mean I'm interested in stuff like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_90","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_90","text":"You say that, but you seem awfully intrigued whenever the topic crops up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_91","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_redash1_04_e_91","text":"What makes you so sure about that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_92","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_92","text":"I'm amazed that you thought people wouldn't realize.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_93","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_93","text":"Anyway, it might not be my business,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_04_e_94","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_04_e_94","text":"but I just thought it was a little sad, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},