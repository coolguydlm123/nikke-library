ll,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_14","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_14","text":"Elysion's tactical rust buckets are on this floor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_15","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_15","text":"The rest are in the basement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_16","text":"The rest? Who do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_17","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_17","text":"That scrap metal we've got no information on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_18","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_18","text":"Anyway, go see the Elysion rust buckets first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_19","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_19","text":"I'll wait here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_20","text":"Why bother waiting? Just go do what you have to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_21","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_21","text":"You think I'm waiting around for you because I want to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_22","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_22","text":"You need my pass to get into the basement. It's a top-secret area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_23","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_50_af_07_23","text":"So instead of making me leave and come back, I'll wait here, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_24","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_25","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_25","text":"To be honest, I was feeling pretty confident.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"event_bgm_absolute_1","movie":null,"shown":["eunhwa_t","emma_t","vesti_t"],"affinity":null},{"id":"d_main_50_af_07_26","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_26","text":"We made a good team with those monsters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_27","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_27","text":"... But we couldn't do much against the real monster, the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_28","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_28","text":"You'll have to improve your tactics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_29","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_29","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_30","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_30","text":"Anyway, we won. Absolute lost, but the Ark won.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_31","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_31","text":"That's tactical enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_32","text":"You fought really hard. Great work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_33","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_33","text":"Aw, you worked plenty hard yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_34","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_34","text":"Oh, and the Four Beasts are safe, so don't worry about them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_35","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_35","text":"It must be nice to recover naturally. They can get better just by sitting still.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_36","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_36","text":"After they healed, they brought us somewhere safe and then left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_37","text":"Do you know where they went?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_38","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_38","text":"They said they were going to Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_39","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_39","text":"They said something about needing to make sure someone gets food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_40","text":"Oh. I never got to thank them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_41","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_41","text":"Beast 4... I mean, Bahamut told me something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_42","type":"Speech","speaker":"emma_t","key":"Locale_MainScenario:d_main_50_af_07_42","text":"She said not all things have to be said out loud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_43","text":"I agree with that, but it's weird coming from Bahamut...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_44","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_50_af_07_44","text":"You don't have any injuries, huh? W-we can't move at all right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_45","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_50_af_07_45","text":"Y-you really are amazing, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_46","text":"By the way, why are you guys still in such bad shape? Have they not gotten around to treating you yet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_47","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_50_af_07_47","text":"Oh... Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_48","type":"Sp