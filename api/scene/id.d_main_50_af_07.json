sked to be deprioritized.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_56","type":"Speech","speaker":"vesti_t","key":"Locale_MainScenario:d_main_50_af_07_56","text":"We're alive and well... but a lot of Nikkes are in critical condition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_57","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_57","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_58","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_07_58","text":"I didn't realize so many died...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_59","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_59","text":"Chin up, Junior Blockhead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_60","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_60","text":"Every one of them knew what they were getting into when they set foot on that battlefield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_61","type":"Speech","speaker":"eunhwa_t","key":"Locale_MainScenario:d_main_50_af_07_61","text":"We won, the Ark ascended, and not a single civilian was harmed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_07_62","type":"Speech","speaker":"eunhwa_t","key":"Locale_Mai