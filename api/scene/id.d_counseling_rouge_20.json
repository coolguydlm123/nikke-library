{"id":"d_counseling_rouge_20","cat":"counsel","group":{"id":"char5049","label":"Rouge"},"label":"Advising Rouge: 20","stage":null,"prev":"d_counseling_rouge_19","next":null,"speakers":{"rouge":"Rouge"},"icons":{"rouge":"si_c272_00_s"},"lines":[{"id":"d_counseling_rouge_20_1","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_1","text":"Some people are such gaming fanatics, that they come to the Game Zone every day.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rouge"],"affinity":"_0"},{"id":"d_counseling_rouge_20_2","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_2","text":"While we appreciate that our customers enjoy our games,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_3","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_3","text":"we do worry sometimes that they may be addicted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_4","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_4","text":"What should I do in this situation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rouge_20_5","text":"Try offering different types of games every now and then.","jump":"d_counseling_rouge_20_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rouge_20_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rouge_20_6","text":"Put a limit on how long they can play.","jump":"d_counseling_rouge_20_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rouge_20_7","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_rouge_20_7","text":"For example, games that are more active and physical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_8","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_8","text":"Hmm... That sounds like a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_9","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_9","text":"It might also be helpful to have them enjoy various cultural activities here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_10","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_10","text":"Thanks for the advice, Highroller.","jump":"d_counseling_rouge_20_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_11","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_11","text":"Hmm... I'm not sure about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_12","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_12","text":"Sure, they're less likely to become obsessed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_13","type":"Speech","speaker":"rouge","key":"Locale_Counseling:d_counseling_rouge_20_13","text":"but I think we'd end up getting complaints afterwards.","jump":"d_counseling_rouge_20_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rouge_20_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_rouge_20_14","text":"Rouge and I brainstorm on strategies for dealing with customers who are too absorbed in the games.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}