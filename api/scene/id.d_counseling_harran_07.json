ull,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_07_7","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_07_7","text":"You are indeed qualified to stand by my side.","jump":"d_counseling_harran_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_07_8","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_07_8","text":"I see. Then your belief in me is not firm enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_07_9","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_07_9","text":"Nevertheless, it could be worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_07_10","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_07_10","text":"If you had said no, I would never let you lay eyes on me again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_07_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_harran_07_11","text":"I spend some meaningful time together with Harran.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}