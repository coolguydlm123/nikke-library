,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_20","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_03_s_20","text":"That's been bugging me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_21","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_21","text":"Why do you think Marciana was acting like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_22","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_22","text":"I really don't know. That's what makes it so frustrating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_23","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_23","text":"She won't tell us anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_24","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_24","text":"But one thing I'm sure of is that wasn't the Miss Marciana we know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_25","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_03_s_25","text":"This is just a thought,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_26","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_03_s_26","text":"but do you think the anxiety's just gotten to be too much for her to handle?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_27","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_03_s_27","text":"She looked like she was completely consumed by it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_28","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_28","text":"Agreed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_29","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_29","text":"She seemed very uneasy from the moment I first met her,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_30","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_30","text":"but I could tell she wanted to protect you, even in the middle of all that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_31","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_31","text":"That much was clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_03_s_32","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_03_s_32","text":"That's how strong those feelings of hers are,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt