{"id":"d_main_38_06","cat":"main","group":{"id":"ch38","label":"Chapter 38 · Gluttony"},"label":"How They Live Now","stage":"38-24 STAGE · Start","prev":"d_main_38_05_e","next":"d_main_38_07_s","speakers":{"anis":"Anis","mint":"Mint","neon":"Neon","prika":"Prika"},"icons":{"anis":"si_c012_00_s","mint":"si_c600_01_s","neon":"si_c011_00_s","prika":"si_c601_01_s"},"lines":[{"id":"d_main_38_06_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_38_06_1","text":"Ark. T.T. STAR practice room.","jump":null,"exit":false,"enter":null,"bg":"Gym","bgArt":"gym","image":null,"bgm":"bgm_story_apricot","movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_2","text":"Whew... I'm exhausted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon","anis","mint"],"affinity":null},{"id":"d_main_38_06_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_3","text":"Where did Prika go? She didn't even stop to rest afterwards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_4","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_4","text":"She's going to wash up. It's an endless cycle for her: finish practice, take a shower, finish showering, back to practice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_5","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_5","text":"She always says it's unacceptable to be unkempt, and daily practice is no excuse to change that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_6","text":"She hasn't changed a bit. If anything, it sounds like she's gotten worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_7","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_7","text":"Hehe, maybe a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_8","text":"How's her accessory business doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_9","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_9","text":"Great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_10","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_10","text":"It's doing much better than it was when she was a star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_11","text":"And despite that, she still practices this often?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_12","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_12","text":"Yes, so that she can be ready to return to the spotlight at any moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_14","text":"Mint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_15","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_15","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_16","text":"Uh... How was I? When I was practicing, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_17","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_17","text":"You were good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_18","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_18","text":"It's amazing how much the body remembers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_19","text":"Really? I... I guess I was a little surprised at how well I moved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_20","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_06_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_21","text":"What's wrong with you? You've been quiet as a mouse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_22","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_06_22","text":"I can't believe it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_06_23","text":"You really did used to be a pop star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_24","text":"How many times do I have to tell you until you'll believe me?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_25","text":"Anyway, we launched straight into practice, so we weren't really able to catch up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_26","text":"How have you been, Mint?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_27","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_27","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_28","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_28","text":"I recently released an EP.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_29","text":"I heard it. It's good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_30","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_30","text":"Really? You liked it? Prika and I paid for it with our own money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_31","text":"I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_32","text":"I've been buying all your albums and merchandise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_33","text":"And the accessories Prika makes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_34","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_35","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_35","text":"You should have reached out earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_36","text":"How could I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_37","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_39","text":"Are your hands feeling better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_38_06_40","text":"Mint smiles as she holds up her hands. Several fingers are wrapped up in bandages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_41","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_41","text":"I haven't gotten any better at cooking, I can say that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_42","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_42","text":"I've been appearing on a cooking show for years now, but I still keep injuring my fingers by mistake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_43","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_06_43","text":"Huh? Nikke can get injured by knives? Are you using a Goddesium sword to do your slicing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_44","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_44","text":"Haha. No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_45","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_45","text":"The bodies that we currently use are meant to resemble humans as much as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_46","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_46","text":"Even if we're injured, we can't swap those parts out for different ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_47","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_47","text":"Accumulating scars and bruises is important to keep everything feeling real.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_48","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_06_48","text":"Sounds like tough going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_49","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_49","text":"Hehe, that it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_50","text":"But why a cooking program? I didn't know you were interested in that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_51","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_52","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_52","text":"If I'm being honest, I prefer going out to eat over cooking it myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_53","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_53","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_54","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_54","text":"It's simply that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_55","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_55","text":"cooking is a good look for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_56","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_06_56","text":"Yeah, it does suit your image.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_57","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_57","text":"Haha. Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_58","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_58","text":"At any rate, I'm doing my best, and people seem to like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_59","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_59","text":"These days, most people know me as a cook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_60","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_60","text":"When I tell them I used to be a pop star, they think I'm lying. Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_61","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_62","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_62","text":"What about Prika? Is she doing anything else besides the accessory line?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_63","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_63","text":"No. Whenever she has any free time, she comes here and practices.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_64","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_64","text":"She still believes being able to sing and dance is all you need as an entertainer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_65","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_65","text":"She feels that things like character appeal are for people who aren't confident enough in their skills.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_66","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_66","text":"If you're good at what you do, you'll naturally be appealing to people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_67","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_67","text":"Maybe that used to be the case, but that era is long gone now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_68","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_68","text":"Prika knows that. That's why she's working as hard as she is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_69","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_69","text":"She's going against the grain, and I think that's kinda cool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_70","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_71","text":"I'm sorry... It's my fault that we fell apart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_72","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_72","text":"Didn't I tell you before? I don't want to hear \"sorry\" from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_73","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_73","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_74","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_74","text":"... Never mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_75","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_75","text":"Anyway, it seems like you're doing well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_76","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_76","text":"I heard you're doing great in the commando unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_77","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_77","text":"Yeah... I've met a lot of good people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_78","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_06_78","text":"It sounds like that's a better fit for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["prika"],"affinity":null},{"id":"d_main_38_06_79","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_06_79","text":"Back when you were here with us, you would complain just about every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_80","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_06_80","text":"Are you done washing up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_81","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_06_81","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_82","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_82","text":"I never said that it suits me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_83","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_06_83","text":"Things just ended up that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_84","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_06_84","text":"Pssh, people with talent always say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_06_85","type