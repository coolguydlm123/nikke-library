{"id":"d_counseling_crust_01","cat":"counsel","group":{"id":"char5136","label":"Crust"},"label":"Advising Crust: 01","stage":null,"prev":null,"next":"d_counseling_crust_02","speakers":{"crust":"Crust"},"icons":{"crust":"si_c521_00_s"},"lines":[{"id":"d_counseling_crust_01_1","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_01_1","text":"How do you manage your food intake when you're busy, Mr. Gourmand?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["crust"],"affinity":"_0"},{"id":"d_counseling_crust_01_2","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_01_2","text":"You're not skipping meals, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_01_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_crust_01_3","text":"No matter how busy I am, I always try to set aside time to eat.","jump":"d_counseling_crust_01_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_crust_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_crust_01_4","text":"There are times when I'm simply too busy, and don't have time to eat.","jump":"d_counseling_crust_01_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_crust_01_5","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_01_5","text":"Phew, that's a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_crust_01_6","type":"Speech","speaker":"crust","key":"Locale_Counseling:d_counseling_crust_01_6","text":"Sometimes you eat i