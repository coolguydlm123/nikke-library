{"id":"event_beautyfullshot2_01_e","cat":"event","group":{"id":"ev40052","label":"BEAUTY FULL SHOT · Part 2"},"label":"To Your Heart's Content: B","stage":null,"prev":"event_beautyfullshot2_01_s","next":"event_beautyfullshot2_02_s","speakers":{"sakura_s":"Sakura"},"icons":{"sakura_s":"si_c284_00_s"},"lines":[{"id":"event_beautyfullshot2_01_e_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_1","text":"As the sun sets, darkness falls.","jump":null,"exit":false,"enter":null,"bg":"BeachCave_n","bgArt":"beachcave_n","image":null,"bgm":"event_bgm_beautyfullshot_coral","movie":null,"shown":["sakura_s"],"affinity":null},{"id":"event_beautyfullshot2_01_e_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_2","text":"Sakura stands up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_3","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_3","text":"They say the sea is particularly beautiful at night.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_4","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_4","text":"I'd love for you to take a moonlit stroll with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_5","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_5","text":"We step outside of the cave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_6","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_6","text":"So bright is the moonlight,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_7","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_7","text":"that in terms of illumination, there is scarcely any difference from the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_8","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_8","text":"The thick fog is no more and moonlight streams forth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_9","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_9","text":"It's bright out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_10","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_10","text":"That's a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_11","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_11","text":"Why don't we go for a little walk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_12","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_12","text":"Sakura and I walk alongside the beach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_13","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_13","text":"Give me your hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_14","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_14","text":"As I grasp Sakura's hand in mine, I can feel her warmth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_15","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_15","text":"We continue to walk in silence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_16","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_16","text":"The wet sand softly caresses our toes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_17","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_17","text":"Only the soothing sound of gently lapping waves can be heard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_18","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_18","text":"You have such big hands, {AccountData.NickName}-kun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_19","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_19","text":"You're quite tall as well,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_20","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_20","text":"and you have nice broad shoulders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_21","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_21","text":"Such a masculine body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_22","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_22","text":"I never noticed how attractive you were.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_23","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_23","text":"Er... you're quite beautiful yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_24","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_24","text":"Which part of me do you find beautiful?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_25","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_25","text":"You really have decided to give in to your heart's desires, haven't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_26","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_26","text":"Hehe. It's quite a thrill declaring these things that I normally wouldn't dare say out loud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_27","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_27","text":"Now, if you would, please answer my question:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_28","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_28","text":"What is it about me that you find so beautiful?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_29","type":"Choice","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_29","text":"This feeling of gracefulness and serenity that you emanate.","jump":"event_beautyfullshot2_01_e_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_30","type":"Choice","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_30","text":"Your face and body.","jump":"event_beautyfullshot2_01_e_34","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_31","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_31","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_32","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_32","text":"I see that you appreciate a person's inner beauty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_33","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_33","text":"Of course, I imagine you have more base thoughts as well, but I appreciate that you can operate on a deeper level.","jump":"event_beautyfullshot2_01_e_39","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_34","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_35","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_35","text":"You're quite... obvious with your assessment of beauty, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_36","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_36","text":"Not that I'm offended. Certainly not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_37","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_37","text":"In fact, I'm almost flattered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_38","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_38","text":"Actually, no. I am flattered.","jump":"event_beautyfullshot2_01_e_39","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_39","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_39","text":"... Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_40","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_40","text":"It's a bit embarrassing hearing someone compliment me like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_41","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_41","text":"You don't look embarrassed at all, though. Apparently you must be used to being given compliments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_42","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_42","text":"Not exactly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_43","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_43","text":"Sakura leans in and kisses me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_44","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_44","text":"Something has been weighing on my mind these past few days:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_45","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_45","text":"Whether you can truly be mine, and mine alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_46","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_46","text":"I know that you're destined for great things, and your entire life can't revolve around me. I understand that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_47","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_47","text":"Sakura places her hand on my chest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_48","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_48","text":"But this here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_49","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_49","text":"It belongs to me, and no one else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_50","type":"Speech","speaker":"sakura_s","key":"Locale_MainScenario:event_beautyfullshot2_01_e_50","text":"Remember that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_01_e_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_01_e_51","text":"Sakura and I kiss once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}