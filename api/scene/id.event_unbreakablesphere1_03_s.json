"event_unbreakablesphere1_03_s_59","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_59","text":"Why are you going to such great lengths to save us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_60","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_60","text":"You've just met us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_61","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_61","text":"Why should you care whether we live or die?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_62","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_62","text":"Why do you keep acting like you don't expect anything from us in return?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_63","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_63","text":"I... I just wanted to rescue you. So I did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_64","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_64","text":"And I simply wanted to be nice. So I did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_65","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_65","text":"I don't like unconditional kindness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_66","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_66","text":"It makes me uncomfortable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_67","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_67","text":"Don't act all high and mighty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_68","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_68","text":"If you want something, just say it, and I'll do whatever you tell me to!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_69","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_69","text":"... I'm sorry,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_70","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_70","text":"but I really don't have any ulterior motives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_71","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_71","text":"Don't lie to me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_72","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_72","text":"People like you are the worst.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_73","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_73","text":"You put on a nice front and make it out like you're willing to do anything for someone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_74","type":"Speech","speaker":"mori","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_74","text":"and just when they trust you the most, you stab them in the back!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_75","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_unbreakablesphere1_03_s_75","text":"*Thud*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_76","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_unbreakablesphere1_03_s_76","text":"Mori shoves the bubble back into Little Mermaid's arms and runs off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_unbreakablesphere1_03_s_77","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_unbreakablesphere1_03_s_77","text":"... Mori.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}