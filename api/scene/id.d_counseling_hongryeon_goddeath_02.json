,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_02_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_6","text":"It was me, wasn't it?","jump":"d_counseling_hongryeon_goddeath_02_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_goddeath_02_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_7","text":"Was it your sister?","jump":"d_counseling_hongryeon_goddeath_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_goddeath_02_8","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_8","text":"Hm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_02_9","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_9","text":"Nay, not quite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_02_10","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_10","text":"Still, methinks I would not mind thee gracing my dreams.","jump":"d_counseling_hongryeon_goddeath_02_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_02_11","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_11","text":"Aye, 'twas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_02_12","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_12","text":"We crossed blades, shared a drink, and caught up on all that had passed since last we met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_02_13","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_13","text":"'Twas such a dream, I near wished never to wake.","jump":"d_counseling_hongryeon_goddeath_02_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_02_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_02_14","text":"Scarlet and I have a heart-to-heart as she reflects on her dream.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}