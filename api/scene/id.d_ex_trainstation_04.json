{"id":"d_ex_trainstation_04","cat":"outpost","group":{"id":"outpost10601","label":"Train Station"},"label":"The Best of the Best","stage":null,"prev":"d_ex_trainstation_03","next":"d_ex_trainstation_05","speakers":{"epinel":"Epinel","brid":"Brid","helm":"Helm"},"icons":{"epinel":"si_c241_00_s","brid":"si_c070_00_s","helm":"si_c352_00_s"},"notes":["Unlock: Helm · Brid · Epinel","Featuring Helm · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_trainstation_04_1","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_1","text":"Hey Coach, are you busy?","jump":null,"exit":false,"enter":null,"bg":"Station","bgArt":"station","image":null,"bgm":"bgm_story_girlstalk","movie":null,"shown":["epinel"],"affinity":null},{"id":"d_ex_trainstation_04_2","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_2","text":"I'm always free.","jump":"d_ex_trainstation_04_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_3","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_3","text":"I'm always busy.","jump":"d_ex_trainstation_04_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_4","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_4","text":"It certainly seems that way.","jump":"d_ex_trainstation_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_5","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_5","text":"... It certainly doesn't look like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_6","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_6","text":"... All right, I've got nothing going on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_7","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_7","text":"I knew it.","jump":"d_ex_trainstation_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_8","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_8","text":"Come with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_9","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_9","text":"Where to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_10","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_10","text":"The garage at the train station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_11","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_11","text":"A part from my board broke, and I'm having a hard time finding a replacement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_12","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_12","text":"Since the AZX is at the train station, I figured they'd have plenty of parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_13","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_13","text":"Is there really a need for me to go as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_14","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_15","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_15","text":"You said you were free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_16","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_16","text":"Got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_17","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_17","text":"In the garage of the train station.","jump":null,"exit":false,"enter":null,"bg":"Storage","bgArt":"storage","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_18","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_18","text":"Any chance I can use this part? I really need it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["brid"],"affinity":null},{"id":"d_ex_trainstation_04_19","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_19","text":"Sure, I've got a couple of spares in the back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_20","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_20","text":"But there's a beta type and a gamma type. I'm not sure which will fit your board.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_21","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_21","text":"Hmm... I'm sure both would fit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_22","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_22","text":"I'd go for the gamma type if I were you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["helm"],"affinity":null},{"id":"d_ex_trainstation_04_23","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_23","text":"Huh? Helm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_24","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_24","text":"What brings you here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_25","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_25","text":"I came to see the AZX. It's something of a companion to the Admire, so I actually come here fairly often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_26","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_26","text":"... Actually, the Admire isn't something I can see whenever I want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_27","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_27","text":"Hey Helm, how're you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_28","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_28","text":"What makes you recommend the gamma type? I think beta would fit better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_29","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_29","text":"Because that's what the Admire uses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_30","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_30","text":"... Ships and boards aren't exactly the same thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_31","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_31","text":"Epinel. The Admire is the strongest ship there is, yes or no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_32","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_32","text":"Um... yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_33","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_33","text":"The parts used by the strongest are also the strongest. So just use the gamma type.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_34","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_34","text":"Wait! When you put it like that, I must disagree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_35","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_35","text":"The AZX uses beta parts, so I think it's safe to say that they've got the better performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_36","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_36","text":"... Let me get this straight. Are you saying that the AZX is better than the Admire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_37","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_37","text":"What if I am? It's not like that's such an outrageous statement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_38","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_38","text":"I'm not saying the AZX isn't impressive, but it doesn't hold a candle to our ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_39","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_40","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_40","text":"What's the top speed of the Admire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_41","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_41","text":"That's not fair. It's a seafaring vessel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_42","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_42","text":"I'm well aware of that. Now tell me, how fast?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_43","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_43","text":"... The AZX uses traditional ammunition, doesn't it?\nThe Admire uses particle cannons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_44","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_44","text":"Which take forever and a day to recharge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_45","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_45","text":"And blow Tyrant-class Raptures to smithereens in the blink of an eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_46","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_46","text":"Those pea shooters of yours wouldn't even put a dent in the AZX's armor. From what I hear, the Admire might as well be made of paper-mâché.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_47","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_47","text":"It wouldn't ever get hit to begin with, thanks to our anti-aircraft guns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_48","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_48","text":"The only reason you need anti-aircraft guns is because you're too scared to be in the thick of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_49","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_49","text":"Everyone knows the most powerful weapons are kept on the rear flanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_50","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_50","text":"Oh, is that right? Well, let me tell you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_51","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_51","text":"Helm and Brid both start to raise their voices.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_52","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_52","text":"Don't you think you should stop them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_53","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_53","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_54","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_54","text":"You're the commander.\nYou should mediate any disputes between Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_55","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_55","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_56","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_56","text":"Helm. Brid. That's enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_57","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_57","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_58","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_58","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_59","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_trainstation_04_59","text":"Epinel will select the part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_60","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_trainstation_04_60","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_61","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_61","text":"Perfect! That'll settle it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_62","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_62","text":"Right. Whichever part Epinel selects will decide who's the strongest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_63","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_63","text":"Beta parts used by the AZX.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_64","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_64","text":"Gamma parts used by the Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_65","type":"Speech","speaker":"brid","key":"Locale_SuddenStory:d_ex_trainstation_04_65","text":"What'll it be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_trainstation_04_66","type":"Speech","speaker":"helm","key":"Locale_SuddenStory:d_ex_trainstation_04_66","text":"We