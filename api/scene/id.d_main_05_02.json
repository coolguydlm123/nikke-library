,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_02_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_02_14","text":"You're no fun, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_02_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_02_15","text":"Most people born in the Ark will never get to experience this.","jump":"d_main_05_02_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_02_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_02_16","text":"Humans living in the past must have been used to all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_02_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_02_17","text":"Guess so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_02_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_02_18","text":"Now they're not so lucky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_02_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_02_19","text":"That's the reason why we exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_02_20","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_02_20","text":"We're here to help bring them back to those times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"sh