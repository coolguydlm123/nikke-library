Locale_SubScenario:event_ce003_2_05_s_18","text":"Clara, you wanted to try a dish made with the legendary seasoning, isn't that right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_19","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_s_19","text":"Yep!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_20","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_20","text":"Well, here you are, Clara! Curry made with the one and only legendary seasoning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_21","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_s_21","text":"Whoa, is that a cat? So cute!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_22","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_22","text":"The curry offered by Emilia is topped with a cat-shaped pile of vegetables and cheese.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_23","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_23","text":"This cat is called Puck. He's like a father to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_24","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_s_24","text":"A cat who is like father... How intriguing! Can I try this curry now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_25","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_s_25","text":"Please. We made it for you, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_26","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_26","text":"Clara eats a spoonful of curry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_27","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_28","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_s_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_29","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_s_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_30","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_s_30","text":"It's delicious!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_31","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_31","text":"Phew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_32","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_32","text":"I'm glad you like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_33","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_s_33","text":"How could I not? You guys are super awesome cooks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_34","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_s_34","text":"Oh right,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_35","type":"Speech","speaker":"clara","key":"Locale_SubScenario:event_ce003_2_05_s_35","text":"was the legendary seasoning where my dad said it would be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_36","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_36","text":"Ah yes, I'm sure you're quite curious about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_37","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_37","text":"Well then, allow me to tell you a story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_38","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_2_05_s_38","text":"It's the story of our adventure on the surface to find the legendary seasoning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_39","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_39","text":"Emilia proceeds to regale Emilia about the trials and tribulations we encountered on the way to obtain the legendary seasoning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_40","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_40","text":"This legendary seasoning seems to have quite an effect on people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_41","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_s_41","text":"But it's just peppa... what was it you guys called it again... pepper?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_42","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_42","text":"Yeah. Just ordinary black pepper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_43","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_2_05_s_43","text":"Although it's of fine quality, it's just ordinary black pepper. So what's the point in boring her with that story?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_44","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_s_44","text":"Still, it doesn't change the fact that it's a dish you fall in love with after one taste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_45","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_s_45","text":"That's because Emilia, Sister, and I","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_46","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_s_46","text":"all poured our hearts into making it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_47","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_47","text":"In other words, the feeling you put into it is more important than the ingredients.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_48","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_2_05_s_48","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_49","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_49","text":"Now that we've tried your curry, should we check out what everyone else made?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_2_05_s_50","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_2_05_s_50","text":"While trying the dishes made by the other teams, we encounter Maid For You.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ade","soda","cocoa"],"affinity":null},{"id":"event_ce003_2_05_s_51","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_