{"id":"d_counseling_sora_08","cat":"counsel","group":{"id":"char5144","label":"Sora"},"label":"Advising Sora: 08","stage":null,"prev":"d_counseling_sora_07","next":"d_counseling_sora_09","speakers":{"sora":"Sora"},"icons":{"sora":"si_c532_00_s"},"lines":[{"id":"d_counseling_sora_08_1","type":"Speech","speaker":"sora","key":"Locale_Counseling:d_counseling_sora_08_1","text":"Do you like flying, Captain?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sora"],"affinity":"_0"},{"id":"d_counseling_sora_08_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sora_08_2","text":"Yeah, I like it.","jump":"d_counseling_sora_08_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sora_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sora_08_3","text":"No, I don't. It's scary.","jump":"d_counseling_sora_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sora_08_4","type":"Speech","speaker":"sora","key":"Locale_Counseling:d_counseling_sora_08_4","text":"I knew you'd say that. ♥","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sora_08_5","type":"Speech","speaker":"sora","key":"Locale_Counseling:d_counseling_sora_08_5","text":"It's such an incredible feeling, getting closer and closer to the light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sora_08_6","type":"Speech","speaker":"sora","key":"Locale_Counseling:d_counseling_sora_08_6","text":"And a wide open sky is a cure-all for any time you're feeling down! ★","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sora_08_7","type":"Speech","speaker":"sora","key":"Locale_Counseling:d_counseling_sora_08_7","text":"Flying is seriously the best! ♥","jump":"d_counseling_sora_08_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sora_08_8","type":"Speech","speaker":"sora","key":"Locale_Counseling:d_counseling_sora_08_8","text":"Oh my, are you afraid of heights?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sora_08_9","type":"Speech","speaker":"sora","key":"Locale_Counseling:d_counseling_sora_08_9","text":"For a captain to not know the joy of flying... what a tragedy!","jump":"d_counseling_sora_08_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sora_08_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_sora_08_10","text":"Sora and I talk more about flying.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}