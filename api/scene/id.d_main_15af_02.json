noisy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_27","type":"Speech","speaker":"reporter","key":"Locale_MainScenario:d_main_15af_02_27","text":"Matis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_28","type":"Speech","speaker":"reporter","key":"Locale_MainScenario:d_main_15af_02_28","text":"Matis has been resurrected!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_29","type":"Speech","speaker":"reporter","key":"Locale_MainScenario:d_main_15af_02_29","text":"President Syuen, did you finally give in to public demand and erase their memories?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_30","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_30","text":"Haha. Not a chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_31","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_31","text":"They have been resurrected with all of their memories fully intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_32","type":"Speech","speaker":"reporter","key":"Locale_MainScenario:d_main_15af_02_32","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_33","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_33","text":"I realize this is difficult to accept.","jump":null,"exit":false,"e