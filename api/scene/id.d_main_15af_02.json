ty":null},{"id":"d_main_15af_02_40","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_40","text":"Our researchers have developed a unique technology called Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_41","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_41","text":"We have this, then mankind...","jump":null,"exit":false,"enter":null,"bg":"EventScene_Main_15_After_01","bgArt":"eventscene_main_15_after_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_42","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_42","text":"Nikkes will be reborn. They will become truly unstoppable weapons that will never give in to corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}