inity":null},{"id":"d_main_15af_02_6","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_6","text":"I realize there have been many rumors about Missilis circulating as of late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_7","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_7","text":"For example,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_8","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_8","text":"that we did not participate in the offensive because we have been colluding with the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_9","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_9","text":"That we are deliberately ignoring how the members of Matis have been corrupted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_10","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_10","text":"I understand your concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_11","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_11","text":"When faced with a Nikke that does not follow orders, humans are nothing but helpless prey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_12","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_12","text":"So to assuage our apprehensive citizens,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_13","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_13","text":"I would like to announce that the previously corrupted Matis Squad has been resurrected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_14","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_15af_02_14","text":"Come on out, ladies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_lastbullet","movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_15","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_15af_02_15","text":"Ha. Ha. Hahaha!","jump":null,"exit":false,"enter":null,"bg":"EventScene_Main_15_After_01","bgArt":"eventscene_main_15_after_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_16","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_15af_02_16","text":"Hahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_17","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_15af_02_17","text":"Citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_18","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_15af_02_18","text":"Rest easy! Your heroes have returned from their absence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_15af_02_19","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_15af_02_19","text":"It takes more tha