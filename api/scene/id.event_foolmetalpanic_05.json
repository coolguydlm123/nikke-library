image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_124","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_foolmetalpanic_05_124","text":"Hehe. Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_125","type":"Speech","speaker":"nero","key":"Locale_SubScenario:event_foolmetalpanic_05_125","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}