nt_foolmetalpanic_05_111","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_05_111","text":"There is no soil on Planet Shifty, so we are unable to grow flowers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_112","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_05_112","text":"Really? Sounds like the \"blue star\" might be better in some ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_113","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_05_113","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_114","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_05_114","text":"Hmph. Quite the ignorant comment from an inferior species.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_115","type":"Speech","speaker":"mekamishifty","key":"Locale_SubScenario:event_foolmetalpanic_05_115","text":"Here, give that to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_116","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_05_116","text":"*Bzzz*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolmetalpanic_05_117","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolmetalpanic_05_117","text":"Mekami Shifty's abdomen opens, revealing an empty sp