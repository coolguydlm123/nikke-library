{"id":"msg_m_ex_neon_03","cat":"messenger","group":{"id":"room_neon","label":"Neon · Nikke"},"label":"3. Master,","stage":null,"prev":"msg_m_ex_neon_02","next":"msg_m_ex_neon_blueocean_01","speakers":{"neon":"Neon"},"icons":{"neon":"si_c011_00_s"},"lines":[{"id":"m_ex_neon_03_1","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_1","text":"Master,","jump":null},{"id":"m_ex_neon_03_2","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_2","text":"I wonder...","jump":null},{"id":"m_ex_neon_03_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_3","text":"What is it?","jump":null},{"id":"m_ex_neon_03_4","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_4","text":"Can we negotiate our salary?","jump":null},{"id":"m_ex_neon_03_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_5","text":"Excuse me?","jump":null},{"id":"m_ex_neon_03_6","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_6","text":"To be honest, with our current salary,","jump":null},{"id":"m_ex_neon_03_7","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_7","text":"it's difficult even to afford limited edition casings.","jump":null},{"id":"m_ex_neon_03_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_8","text":"I'll talk to Ingrid.","jump":null},{"id":"m_ex_neon_03_9","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_9","text":"What? Wait a minute.","jump":null},{"id":"m_ex_neon_03_10","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_10","text":"You're going straight to the boss? There aren't any middle stages?","jump":null},{"id":"m_ex_neon_03_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_11","text":"Do you want me to talk to her for you?","jump":null},{"id":"m_ex_neon_03_12","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_12","text":"I'd really appreciate it.","jump":null},{"id":"m_ex_neon_03_13","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_13","text":"Tell her that I'm doing a good job","jump":null},{"id":"m_ex_neon_03_14","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_14","text":"with all our tasks up on the surface.","jump":null},{"id":"m_ex_neon_03_15","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_15","text":"Oh yeah, and tell her my firepower has increased!","jump":null},{"id":"m_ex_neon_03_16","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_16","text":"Something tells me the salary is staying right where it is.","jump":"m_ex_neon_03_18"},{"id":"m_ex_neon_03_17","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_17","text":"You'll be lucky if your salary isn't cut.","jump":"m_ex_neon_03_18"},{"id":"m_ex_neon_03_18","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_18","text":"!!!","jump":null},{"id":"m_ex_neon_03_19","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_19","text":"What are you saying, Master?","jump":null},{"id":"m_ex_neon_03_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_20","text":"Just kidding.","jump":null},{"id":"m_ex_neon_03_21","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_21","text":"You can't kid around about something that serious!","jump":null},{"id":"m_ex_neon_03_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_22","text":"I'll put in a good word for you.","jump":null},{"id":"m_ex_neon_03_23","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_23","text":"Awesome!","jump":null},{"id":"m_ex_neon_03_24","type":"Speech","speaker":"neon","key":"Locale_SuddenMessage:m_ex_neon_03_24","text":"Thanks for doing this, Master!","jump":null},{"id":"m_ex_neon_03_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_neon_03_25","text":"No problem.","jump":null}],"chat":true}