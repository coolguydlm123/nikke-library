,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_34","text":"You've been doing a lot of that recently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_35","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_35","text":"Because so many have passed on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_36","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_36","text":"I realize that, but sometimes it feels like you act more on behalf of the dead than you do the living.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_37","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_37","text":"... The dead might be better right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_38","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_39","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_39","text":"They do not get angry, depressed, or hurt others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_40","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_40","text":"If you ask me, being here right now is worse than death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_41","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_41","text":"What are you saying?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_42","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_42","text":"Do you yearn for the silence that comes with death?\nSuch a yearning is not unreasonable given our current predicament.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_43","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_43","text":"I'm leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_44","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_44","text":"No, wait. We have to discuss our plans going forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_45","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_45","text":"Then why aren't you calling Snow White?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_46","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_46","text":"Because she is standing guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_47","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_47","text":"There hasn't been a single attack for five days now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_48","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_48","text":"She's been keeping watch for five days straight. Without any sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_49","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_49","text":"For us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_50","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_50","text":"Not for the dead, but for us. The living.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_51","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_51","text":"... I too need some time alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_52","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_52","text":"Then you stand guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_53","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_53","text":"Keep watch with your staff that couldn't hit the broad side of a barn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_54","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_54","text":"Are you saying that I'm of no help?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_55","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_56","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_56","text":"No. I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_57","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_57","text":"Enough. Cease with these squabbles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_58","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_58","text":"If we are to go hungry for a few days, then what of it? We are Nikkes, so we can withstand such... *hick*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_59","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_59","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_60","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_60","text":"What is this? *Hick*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_61","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_overzone1_03_e_61","text":"Dorothy approaches Scarlet and grabs her hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_62","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_62","text":"Halt! Steady thy hand!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_63","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_63","text":"I'm detecting high concentrations of alcohol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_64","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_64","text":"Given our paucity of options for nourishment, I elected to drink instead. 'Tis made of grain and all the same, hehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_65","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_65","text":"Have you lost your mind?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_66","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_66","text":"Drinking in a situation like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_67","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_67","text":"I fail to see what is so egregious about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_68","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_68","text":"I simply imbibed one drink. Merely one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_69","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_69","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_70","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_70","text":"Yikes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_71","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_71","text":"It got really tense in here all of a sudden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_72","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_72","text":"Everyone's tired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_73","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_73","text":"It pains me to see the Goddess Squad fighting like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_74","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_74","text":"My apologies, but we are not dancing simians sent here to entertain you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_75","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_75","text":"No, but you're a spectacle nonetheless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_76","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_76","text":"Thy tongue doth become loose. Watch thy words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_77","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_77","text":"Me and the other Nikkes have been watching you all this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_78","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_78","text":"Ever since you first came onto the battlefield.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_promise","movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_79","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_80","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_80","text":"Mankind's last hope. The Goddess of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_81","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_81","text":"Is there any other title more suitable for you than this one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_82","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_82","text":"So you have to keep it together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_83","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_83","text":"Don't fight with one another, and if you do, do it somewhere we can't see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_84","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_84","text":"I'm afraid we don't have the luxury of accommodating such a banal request.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_85","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_85","text":"I won't accept that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_86","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_86","text":"Even if you can't, you should at least try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_87","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_87","text":"Thou dares to speak to me in such a manner?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_88","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_88","text":"Every last one of the mass-produced Nikkes volunteered so that we could fight alongside you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_89","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_89","text":"That includes me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_90","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_90","text":"We didn't risk our lives to see our heroes bickering and tearing at each other's throats.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_91","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_92","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_92","text":"You dishonor those who gave their lives by acting like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_93","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_93","text":"So I'm begging you, please stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_94","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_94","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_95","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_95","text":"I'm going to rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_96","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_96","text":"Call me if anything happens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_97","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_overzone1_03_e_97","text":"With that, Pinne walks off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_98","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_99","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_99","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_100","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affin