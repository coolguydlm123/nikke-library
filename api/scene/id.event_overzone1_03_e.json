ech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_03_e_6","text":"Sorry, but I gathered every last morsel I could find. That place has been picked clean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_7","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_03_e_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_8","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_8","text":"Has there been any word from the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_9","text":"No. I'll keep trying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_10","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_10","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_11","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_03_e_11","text":"Did thou perchance notify them of the destruction of our water tank in the last skirmish?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_03_e_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_03_e_12","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity