_e_13","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_14","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_14","text":"Have you done any track and field in the past?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_15","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_16","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_16","text":"Can I walk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_17","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_17","text":"Of course. You're not paralyzed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_18","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_18","text":"With proper rehabilitation, you'll be able to walk unimpeded,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_19","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_19","text":"and I will help you achieve that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_20","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_20","text":"How?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_21","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_21","text":"First, I will find the treatment method that suits you best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_22","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_22","text":"Next, you will need to relearn how to make proper use of your remaining leg muscles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_23","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_23","text":"You haven't utilized your muscles in a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_24","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_24","text":"In a way, it's a miracle that your muscles are still in this state.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_25","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_25","text":"You're quite fortunate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_26","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_26","text":"Many of our gym members have similar experiences, and have gone on to make full recoveries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_27","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_27","text":"They all say that in the beginning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_28","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_28","text":"They bring up examples of how people got better from exercising.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_29","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_29","text":"But no one's been able to do anything. They all talk big, but nothing happens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_30","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_30","text":"I don't know how many times I've gotten my hopes up, only to have them dashed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_31","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_31","text":"Why is everyone lying to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_32","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_32","text":"I'm not lying to you, Nadia. I promise you that I'll have you up and walking...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_33","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_33","text":"I'm sick of this. It's the same old story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_34","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_01_e_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_35","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_35","text":"You just want money, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_36","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_36","text":"Be honest. Once you get your paycheck, your interest ends there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_37","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_lifeagain_01_e_37","text":"The tension is beginning to ratchet up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_38","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_lifeagain_01_e_38","text":"The other gym members who were exercising now have their attention focused on us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_39","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_39","text":"Yes, part of it is about making money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_40","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_01_e_40","text":"Rumani!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_41","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_41","text":"Ha, I knew it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_42","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_42","text":"I want a refund.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_43","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_43","text":"I'm not going to be able to walk anyway. This is all a waste of my money and time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_44","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_44","text":"That will be difficult.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_45","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_45","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_46","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_46","text":"The payment I received wasn't actually from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_47","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_47","text":"If I'm not mistaken, I believe it's from your parents?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_48","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_48","text":"Technically speaking then,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_49","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_49","text":"I didn't receive a request from you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_50","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_50","text":"and you can't say it's your money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_51","type":"Speech","speaker":"nadia","key":"Locale_SubScenario:event_lifeagain_01_e_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_52","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_52","text":"I'm not going to give you a refund.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_e_53","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_e_53","text":"So you have a choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":nul