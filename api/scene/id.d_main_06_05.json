{"id":"d_main_06_05","cat":"main","group":{"id":"ch6","label":"Chapter 6 · Pilgrim"},"label":"In Pursuit of the Pilgrim","stage":"6-12 STAGE · End","prev":"d_main_06_04","next":"d_main_06_06","speakers":{"ludmilla":"Ludmilla","anis":"Anis","Self":"Commander","alice":"Alice"},"icons":{"ludmilla":"si_c190_00_s","anis":"si_c012_00_s","alice":"si_c191_00_s"},"lines":[{"id":"d_main_06_05_1","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_1","text":"All right, that's it.","jump":null,"exit":false,"enter":null,"bg":"IceLand_03","bgArt":"iceland_03","image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":["alice","ludmilla","rapi","anis","neon"],"affinity":null},{"id":"d_main_06_05_2","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_2","text":"We'll stay here. Best of luck to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_06_05_3","text":"You're not coming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_4","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_4","text":"This is as far as we can go. Sorry, but there's nothing I can do about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_5","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_05_5","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_6","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_6","text":"We find lost Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_7","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_7","text":"Our paths do not cross.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_8","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_8","text":"Any Nikke who has lost their way may head north.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_9","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_9","text":"Now that we have found our home, we must continue fulfilling our duty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_10","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_10","text":"... And the sleeping princesses need us, as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_06_05_11","text":"I had you all wrong. You're a good egg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_12","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_12","text":"It's just that I know how to distinguish between what I should do and what I want to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_13","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_13","text":"Alice,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_14","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_14","text":"my servant and companions will be taking their leave to continue on their journey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_15","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_15","text":"I trust that you're fine with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_16","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_06_05_16","text":"No problem! I'll wait for you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_17","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_17","text":"Hopefully, we'll meet again. I'd like to see how this story of yours ends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_18","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_05_18","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_19","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_19","text":"You should get going then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_20","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_05_20","text":"I take a step.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_21","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_21","text":"Servant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_22","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_22","text":"One more thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_23","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_23","text":"Encountering something unfamiliar can feel like two worlds colliding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_24","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_24","text":"They seem utterly alien to you, and with that comes a fear of the unknown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_25","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_25","text":"But you must never destroy each other. No matter how insurmountable your differences may seem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_26","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_26","text":"No matter how much it seems your fear will consume you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_27","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_27","text":"You must learn to appreciate the world of others, even if you have to give up a piece of your own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_28","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_28","text":"What you must never do is destroy someone's world, for all of them are precious,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_29","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_29","text":"as all of them are someone's home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_30","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_30","text":"Do you understand what I'm trying to tell you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_31","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_05_31","text":"Yes, I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_32","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_32","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_33","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_05_33","text":"Good luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_05_34","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_06_05_34","text":"Let's go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"