{"id":"d_counseling_arkrangerblack_19","cat":"counsel","group":{"id":"char5174","label":"Ark Ranger Black"},"label":"Advising Ark Ranger Black: 19","stage":null,"prev":"d_counseling_arkrangerblack_18","next":"d_counseling_arkrangerblack_20","speakers":{"arkrangerblack":"Ark Ranger Black"},"icons":{"arkrangerblack":"si_c570_00_s"},"lines":[{"id":"d_counseling_arkrangerblack_19_1","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_1","text":"When you walk around the Ark, you see all kinds of people.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["arkrangerblack"],"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_2","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_2","text":"Families smiling happily, people hiding sad expressions beneath hats pulled low over their faces, people rushing off somewhere...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_3","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_3","text":"Seeing them makes me glad I became an Ark Ranger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arkrangerblack_19_4","text":"Because you can protect them?","jump":"d_counseling_arkrangerblack_19_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_arkrangerblack_19_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arkrangerblack_19_5","text":"Because they recognize you?","jump":"d_counseling_arkrangerblack_19_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_arkrangerblack_19_6","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_6","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_7","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_7","text":"I don't protect them because I'm an Ark Ranger, but becoming one only made me want to protect them even more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_8","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_8","text":"It feels like if I keep pushing myself, I can protect their everyday lives. That's why I'm glad I became an Ark Ranger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_9","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_9","text":"From here on out, I want to protect the Ark with everything I've got.","jump":"d_counseling_arkrangerblack_19_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_10","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_10","text":"Not really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_11","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_11","text":"Whether people recognize me or not doesn't matter much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_12","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_12","text":"When I see people just living their everyday lives, it makes me want to protect them even more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_13","type":"Speech","speaker":"arkrangerblack","key":"Locale_Counseling:d_counseling_arkrangerblack_19_13","text":"That's what pushes me to train harder.","jump":"d_counseling_arkrangerblack_19_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arkrangerblack_19_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_arkrangerblack_19_14","text":"Ark Ranger Black and I reaffirm our resolve.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}