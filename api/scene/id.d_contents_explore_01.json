_SubScenario:d_contents_explore_01_46","text":"At any rate, you know more about that than just about anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_explore_01_47","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_explore_01_47","text":"I won't bore you with the details.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_explore_01_48","type":"Choice","speaker":null,"key":"Locale_SubScenario:d_contents_explore_01_48","text":"If it's possible, I'll certainly try.","jump":"d_contents_explore_01_50","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_explore_01_49","type":"Choice","speaker":null,"key":"Locale_SubScenario:d_contents_explore_01_49","text":"That was a special case.","jump":"d_contents_explore_01_53","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_explore_01_50","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_explore_01_50","text":"That's the spirit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_explore_01_51","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_explore_01_51","text":"Just don't stick your neck too far out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_explore_01_52","type":"Speech","speaker":"cecil","key":"Locale_SubScenario:d_contents_explore_01_52","text":"Like I've said, your existence may be even more important to us than the Heretics.","jump":"d_contents_explore_01_56","exit":false,"enter":null,"bg":null,"bgArt