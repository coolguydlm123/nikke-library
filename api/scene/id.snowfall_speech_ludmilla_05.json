{"id":"snowfall_speech_ludmilla_05","cat":"event","group":{"id":"ev80903","label":"Snowfall"},"label":"snowfall_speech_ludmilla_05","stage":null,"prev":"snowfall_speech_ludmilla_04","next":"snowfall_speech_ludmilla_06","speakers":{"ludmilla_w":"Ludmilla"},"icons":{"ludmilla_w":"si_c194_00_s"},"lines":[{"id":"snowfall_speech_ludmilla_05_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_1","text":"I find Ludmilla at the bamboo forest.","jump":null,"exit":false,"enter":null,"bg":"BambooForest_s","bgArt":"bambooforest_s","image":null,"bgm":"event_bgm_neverland_snowflakes_sunset","movie":null,"shown":["ludmilla_w"],"affinity":null},{"id":"snowfall_speech_ludmilla_05_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_2","text":"If I wanted to, I think I could have a quick chat with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_3","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_3","text":"What should I do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_4","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_4","text":"Talk to Ludmilla.","jump":"snowfall_speech_ludmilla_05_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_5","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_5","text":"Go elsewhere.","jump":"snowfall_speech_ludmilla_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_6","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_6","text":"I still have a lot of things left to do, so I decide to leave the bamboo forest.","jump":null,"exit":true,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_7","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_7","text":"You did great this morning, Servant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_8","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_8","text":"If I hadn't had you or Mica helping me, we'd never have been able to open the hot spring in a timely fashion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_9","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_9","text":"You did a fair bit of heavy lifting yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_10","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_10","text":"Hehe, I merely performed my duty as the owner of Snowfield Hot Spring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_11","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_11","text":"When you have some time, you should visit the hot spring and relax.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_12","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_12","text":"And when are you planning on doing the same?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_13","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_13","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_14","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_14","text":"In the morning, most likely, since that's when I perform my daily inspections.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_15","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_15","text":"The moment you bring up daily inspections,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_16","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_16","text":"I know there's not a chance that you'll be stepping into that hot spring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_17","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_18","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_18","text":"Hehe, is it just me, Servant,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_19","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_19","text":"or am I getting the impression that you want to join me in the hot spring?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_20","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_20","text":"What? That's not what I was getting at.","jump":"snowfall_speech_ludmilla_05_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_21","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_21","text":"Well... of course that's something I've been looking forward to.","jump":"snowfall_speech_ludmilla_05_24","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_22","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_22","text":"I simply thought it would be good for you to take a load off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_23","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_23","text":"I know that's what you meant.","jump":"snowfall_speech_ludmilla_05_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_24","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_24","text":"My goodness!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_25","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_25","text":"You're nothing if not direct, Servant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_26","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_26","text":"Now is as good a time as any. Let's go in together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_27","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_27","text":"Sorry, I was only joking.","jump":"snowfall_speech_ludmilla_05_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_28","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_28","text":"Hehe, I should have known you'd be like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_29","type":"Speech","speaker":"ludmilla_w","key":"Locale_SubScenario:snowfall_speech_ludmilla_05_29","text":"Anyway, I appreciate your concern for my well-being.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_05_30","type":"Narration","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_05_30","text":"Had an enjoyable time with Ludmilla talking about the recently reopened hot spring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}