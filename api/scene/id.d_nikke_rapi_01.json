ale_NikkeEpisode:d_nikke_rapi_01_63","text":"Isn't that neglecting their jobs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_64","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_64","text":"It is the job of the Commander to give orders to Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_65","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_65","text":"The previous Commanders ordered me to fill out paperwork.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_66","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_66","text":"I followed the order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_67","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_67","text":"Thus, I do not feel either side was neglecting their duties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_68","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_68","text":"You keep mentioning orders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_69","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_69","text":"Yes. Orders are the link between a Commander and a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_70","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_70","text":"Nikkes follow human orders. It is our nature to do so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_71","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_71","text":"In particular, orders issued by a Commander are to be obeyed without question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_72","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_72","text":"Regardless of what that order may be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_73","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_73","text":"Any order?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_74","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_74","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_75","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_75","text":"Even if it is an unjust order?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_76","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_76","text":"That is of no importance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_77","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_77","text":"Once an order is issued, all that matters is that it is followed through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_78","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_78","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_79","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_79","text":"... But there is one other thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_80","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_80","text":"The act of keeping the Commander safe is as important as following the order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_81","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_81","text":"A Commander cannot be put in harm's way, no matter what. This is also of paramount importance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_82","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_82","text":"As a precaution, Nikkes have emergency response items, such as AED and hemostatic agents, built inside us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_83","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_83","text":"The safety of the Commander is our top priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_84","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_84","text":"If a Commander is injured or dies due to an oversight on a Nikke's part, that Nikke will be punished accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_85","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_85","text":"The only exception is when a Commander chooses to take their own life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_86","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_86","text":"So, the Commander who died before I joined...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_87","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_87","text":"... Yes. The Central Government ruled that they died of their own volition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_88","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_88","text":"Thankfully, Anis and I were able to avoid any punishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_89","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_89","text":"... I have spoken too much. Anyway, to summarize:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_90","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_90","text":"Follow the Commander's orders. Keep the Commander safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_91","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_91","text":"These are a Nikke's duties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_92","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_92","text":"Of course, it would be unreasonable for us to do absolutely nothing that we are not specifically ordered to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_93","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_93","text":"Thus, we are also capable of exercising our own judgment in our daily lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_94","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_94","text":"However, if an order does come, it supersedes everything else and must be followed. This is our primary function.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_95","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_95","text":"So do not feel that you are being unreasonable by asking us to do something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_96","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_97","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_97","text":"The reports are finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_98","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_98","text":"Please confirm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_99","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_01_99","text":"I read the reports written by Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_100","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_01_100","text":"They are clear and concise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_101","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_01_101","text":"But one thing sticks in my mind...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_102","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_102","text":"Don't you think it paints me as a bit too... heroic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_103","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_103","text":"The success of any operation depends on the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_104","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_104","text":"Their leadership. Their virtue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_105","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_105","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_106","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_106","text":"Reports must be written in this way, or else they will not be accepted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_107","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_01_107","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_108","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_108","text":"Now that the forms are complete, let's go submit them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_01_109","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_01_109","text":"We must go to the Ark's Central Government's office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}