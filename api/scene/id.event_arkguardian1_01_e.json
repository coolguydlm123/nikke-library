ull},{"id":"event_arkguardian1_01_e_58","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_58","text":"Red Hood's gone, and we don't know when Lilith will return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_59","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_59","text":"And there could be another Heretic like Anachiro out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_60","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_60","text":"We have to be ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_61","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_61","text":"Snow White...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_62","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_62","text":"Wh-why are you looking at me like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_63","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_63","text":"Thou art not mired in despair, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_64","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_65","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_65","text":"I am filled with sorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_66","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_66","text":"I miss Red Hood. I miss her so much already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_67","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_67","text":"But even so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_68","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_68","text":"I said everything I wanted to say. We parted on good terms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_69","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_69","text":"I can't afford to wallow in despair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_70","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_70","text":"Art thou burying that sorrow deep within thy bosom and continuing on thy path?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_71","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_71","text":"Well... I wouldn't go as far as to put it that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_72","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_72","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_73","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_73","text":"Methinks I have regarded thee far too much as a child, and unfairly so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_74","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_74","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_75","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_75","text":"N-never mind. Think naught of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_76","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_76","text":"In any case, about these attires...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_77","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_77","text":"What of Dorothy and Liliweiss? Are there none for them? Dost thou lack one too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_78","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_78","text":"Ah, yes. I figured I should start with the ones that have the highest priority...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_79","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_79","text":"Lo!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_80","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_80","text":"By those very words, thou dost acknowledge that I surpass Dorothy in strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_81","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_81","text":"Haha. A fine jest, but if thou were to attend first to us, how sorely disappointed would the others be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_82","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_82","text":"Ah... I actually started with the ones who take the most damage or are frequently injured...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_83","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_83","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_84","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_84","text":"I... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_85","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_85","text":"... Nay, 'tis no matter. All is well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_86","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_86","text":"But pray, whose foolishly large firearm be that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_87","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_87","text":"None among us would rightly wield such.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_88","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_88","text":"Oh, that's...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_89","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_89","text":"... I made a promise to someone that I'd make something special for her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_90","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_90","text":"So, I've been working on it whenever I can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_91","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_92","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_92","text":"Though the recipient remains unknown to me, yet they are the luckiest soul in all the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_93","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_93","text":"To be the beneficiary of a weapon crafted by the most accomplished artisan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_94","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_94","text":"Hehe, you flatter me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_95","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_e_95","text":"There you are.","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":"none","movie":null,"shown":["rapunzel_o","dorothy"],"affinity":null},{"id":"event_arkguardian1_01_e_96","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_96","text":"That was quick. You did get a chance to talk some sense into her, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_97","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_97","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_98","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_99","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_99","text":"*Sigh...* This won't do. As the acting leader, I'll—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_100","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_100","text":"Thou shalt not treat Snow White as a child!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_wm_riverside","movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_101","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_101","text":"You startled me! Why are you yelling all of a sudden? What's gotten into you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_102","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_102","text":"Snow White is... Snow White is...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_103","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_103","text":"Fie!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_104","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_104","text":"Dorothy, prithee, step out and spar with me for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_105","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_105","text":"My blood fulminates within me, and I must needs quell it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_106","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_e_106","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_107","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_107","text":"With all haste, before this fire within me fades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_108","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_108","text":"Uh, no thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_109","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_109","text":"The one thing I hate the most is getting sweaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_110","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_110","text":"Very well, then stand thee still. I shall see to the rest myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_111","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_e_111","text":"Oh my!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_112","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_112","text":"Count me out. You're good at playing by yourself, so why don't you do that instead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_113","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_e_113","text":"*Gasp* P-playing by herself? How could you say such a thing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_114","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_114","text":"Very well, I shall contend alone; do but grant me thine audience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_115","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_e_115","text":"Goodness gracious! Such noble... N-no, such indecency!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_116","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_116","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_117","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_117","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_118","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_01_e_118","text":"I suggest you stop talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_119","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_119","text":"Aye, that would be best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_120","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_01_e_120","text":"Huh? You're not going to keep going? But why? Aww.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}