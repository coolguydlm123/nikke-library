ull,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_26","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_26","text":"Ugh... What is it? What do you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_27","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_28","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_28","text":"Come, let us enter. I must have a word with thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_01_e_29","text":"Scarlet walks past Snow White and steps into the workshop.","jump":null,"exit":false,"enter":null,"bg":"Workshop","bgArt":"workshop","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_30","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_30","text":"H-hey, wait!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_31","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_31","text":"A-at least let me make some room for you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_01_e_32","text":"Scarlet's previously determined steps begin to falter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_01_e_33","text":"The spacious workshop is cluttered with countless tools and weapons, leaving barely any space to walk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_01_e_34","text":"Eventually, Scarlet stops in her tracks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_35","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_35","text":"You could have told me you were coming to visit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_36","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_36","text":"Had I done so, thou wouldst have striven to avoid me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_37","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_37","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_38","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_38","text":"I've heard from Rapunzel and Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt"