":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_01_e_45","text":"Scarlet continues to speak, her gaze never leaving the outfits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_46","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_46","text":"... What be these, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_47","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_47","text":"Oh, those... I was planning on showing them to you once they were finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_48","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_48","text":"... Art these new outfits for Rapunzel and myself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_49","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_01_e_49","text":"More like equipment than an outfit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_50","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_01_e_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_01_e_51","type":"Narration","speaker":null,"key":"Locale_MainScenario:ev