{"id":"d_counseling_eunhwa_tactical_10","cat":"counsel","group":{"id":"char5149","label":"Eunhwa: Tactical Upgrade"},"label":"Advising Eunhwa: Tactical Upgrade: 10","stage":null,"prev":"d_counseling_eunhwa_tactical_09","next":"d_counseling_eunhwa_tactical_11","speakers":{"eunhwa_t":"Eunhwa"},"icons":{"eunhwa_t":"si_c095_00_s"},"lines":[{"id":"d_counseling_eunhwa_tactical_10_1","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_1","text":"When I see you issuing commands up on the surface, you sometimes look like someone who's never known fear.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["eunhwa_t"],"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_2","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_2","text":"Have you ever experienced that on the battlefield?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_3","text":"Yes, when I thought the operation would fail.","jump":"d_counseling_eunhwa_tactical_10_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eunhwa_tactical_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_4","text":"Yes, when I thought I might lose a comrade.","jump":"d_counseling_eunhwa_tactical_10_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_eunhwa_tactical_10_5","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_5","text":"You worry about the strangest things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_6","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_6","text":"As long as you don't sustain fatal wounds, it's okay to fail momentarily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_7","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_7","text":"You can make good use of the data from those losses,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_8","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_8","text":"and win the final battle.","jump":"d_counseling_eunhwa_tactical_10_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_9","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_9","text":"That's a perfectly reasonable fear to have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_10","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_10","text":"Once you lose a comrade, they never come back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_11","type":"Speech","speaker":"eunhwa_t","key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_11","text":"Make sure you never forget that.","jump":"d_counseling_eunhwa_tactical_10_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_tactical_10_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_tactical_10_12","text":"Eunhwa and I have a serious conversation.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}