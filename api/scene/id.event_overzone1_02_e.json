m":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_60","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_60","text":"I have no right to mourn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_61","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_61","text":"If more than one of us leaves this place, we won't be able to protect ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_62","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_02_e_62","text":"... If anything happens, fire off a signal flare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_63","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_63","text":"I will. Don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_64","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_64","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pinne"],"affinity":null},{"id":"event_overzone1_02_e_65","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_02_e_65","text":"Pinne?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_66","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_02_e_66","text":"Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_67","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_67","text":"Wow. You remember my name?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_68","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_02_e_68","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_69","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_69","text":"It's just that most people do not remember us mass-produced Nikkes by name.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_70","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_70","text":"I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_71","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_71","text":"My comrades fought with all they had.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_72","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone1_02_e_72","text":"And we thank you all for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_73","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_73","text":"I apologize for intruding, but I overheard you say you're heading towards the temporary camp?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_74","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_74","text":"Yes. We have to procure more food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_75","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_75","text":"May I go with you? At the very least, I could help you carry whatever we find.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_76","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_76","text":"No, that won't be necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_77","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_77","text":"It's dangerous. There could be Raptures in hiding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_78","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_78","text":"What difference does it make whether I'm felled by a Rapture or starve to death? I end up the same either way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_79","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_80","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_80","text":"... I'm sorry. Bad joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_81","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_81","text":"I just want to be of some help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_82","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_02_e_82","text":"Pinne...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_83","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_83","text":"That's why we're here, isn't it? To help with mundane tasks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_84","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_02_e_84","text":"You don't have to say it like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_85","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_85","text":"I'm only joking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_86","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_86","text":"You may think I'm overstepping my boundaries by saying this, but are we not comrades-in-arms?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_87","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_87","text":"When times get tough, we must work together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_88","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone1_02_e_88","text":"Dorothy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_89","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_90","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_02_e_90","text":"Fine. I suppose I could use your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_02_e_91","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone1_02_e_91","text":"Thank you! I'll do my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}