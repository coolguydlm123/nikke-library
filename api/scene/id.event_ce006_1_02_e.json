Locale_MainScenario:event_ce006_1_02_e_74","text":"Comrade discovered!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_75","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_02_e_75","text":"... Fortunately, nothing's wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_76","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_02_e_76","text":"Dang it, Roam, you scared the heck out of me! Why are you always overreacting like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_77","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_02_e_77","text":"That's ri- *whew*... Right...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_78","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_78","text":"I'll take a look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_79","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_1_02_e_79","text":"Rapi approaches Roam and examines the transport robot it is attempting to transport.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_80","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_80","text":"The coloring on the exterior...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_81","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_81","text":"I've seen this in the manuals before. It's a transport robot which is also intended for combat support.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_82","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_82","text":"From what I can recall, it was in operation even before the First Rapture Invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_83","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_02_e_83","text":"No kidding? That thing's ancient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_84","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_84","text":"It was discontinued due to the combat support functions being too costly to implement. When it entered mass production, only the transport function remained.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_85","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_85","text":"Roam is one of those mass-produced models that followed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_86","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_02_e_86","text":"This is Roam's predecessor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_87","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_87","text":"You could say that, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_88","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_02_e_88","text":"Is it dead?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_89","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_89","text":"Not sure. It's such an old model, we'd have to check.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_90","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_02_e_90","text":"If it's as old as you say, wouldn't it be worth investigating?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_91","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_91","text":"Absolutely. The chances are low, but we might find traces of lost technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_92","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_02_e_92","text":"My suggestion is that we try to bring it back and attempt repairs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_02_e_93","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_02_e_93","text":"Are you saving it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["r