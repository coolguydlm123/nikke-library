gArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_52","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_alonesurvivor_03_e_52","text":"They're all in high spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_53","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_53","text":"High morale is a good thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_54","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_54","text":"Even better if it translates into good results.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_55","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_alonesurvivor_03_e_55","text":"It should be fine. She said she'd give it her all.","jump":"event_alonesurvivor_03_e_57","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_56","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_alonesurvivor_03_e_56","text":"Whatever the result, it'll be a valuable learning experience for them all.","jump":"event_alonesurvivor_03_e_57","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_57","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_57","text":"It's nice of you to say that. They're counting on me to believe in them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":n