_03_e_12","text":"the Ark would have notified us of it when they sent in an extraction request.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_13","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_alonesurvivor_03_e_13","text":"Then let's hurry and move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_14","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_14","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_15","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_15","text":"There is a deep valley that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_16","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_16","text":"There's a steep downhill curve up ahead. If we rush headlong into it, there could be a serious accident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_17","type":"Speech","speaker":"alice","key":"Locale_SubScenario:event_alonesurvivor_03_e_17","text":"Can't we just use it like a big slide?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_18","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_18","text":"If it were just us, we could.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_19","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_19","text":"However, Servant is bound to get injured trying such a maneuver.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_20","type":"Speech","speaker":"alice","key":"Locale_SubScenario:event_alonesurvivor_03_e_20","text":"Then let's make a sled and have Rabbity ride on it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_21","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_21","text":"... And how,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_22","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_22","text":"pray tell, do you intend on making a sled here of all places, with no materials?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_23","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_23","text":"I can do it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_24","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_24","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_25","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_25","text":"I can make a sled no problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_26","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_26","text":"We'll scrounge up the sturdiest wood we can find to make a frame,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_27","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_27","text":"and attach some animal hide to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_28","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_28","text":"With my know-how, I should be able to find an animal no problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_29","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_29","text":"We'll also have the help of Neve, who's an animal expert.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_30","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_30","text":"Give me one hour, and I'll have something workable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_31","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_32","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_32","text":"One hour. That's all I ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_33","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_33","text":"I may be green, but I'm still a member of Unlimited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_34","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_34","text":"This is my time to shine, I can feel it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_35","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_35","text":"On top of that, those lost Nikkes are waiting for us, and things may be getting desperate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_36","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_36","text":"Trust me, it pains me to delay their rescue even for a single hour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_37","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_37","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_38","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_38","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_frostpillar","movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_39","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_39","text":"I understand you've spent a lot of time researching this sort of thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_40","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_03_e_40","text":"You seem confident, so knock yourself out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_41","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_41","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_42","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_42","text":"Really? It's okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_43","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_43","text":"I'll give it everything I've got!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_44","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_03_e_44","text":"I'll whip up a warp-speed sled that'll get us where we need to go in no time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_03_e_45","t