{"id":"msg_m_ex_sakura_01","cat":"messenger","group":{"id":"room_sakura","label":"Sakura · Nikke"},"label":"1. Hello.","stage":null,"prev":null,"next":"msg_m_ex_sakura_02","speakers":{"sakura":"Sakura"},"icons":{"sakura":"si_c282_00_s"},"lines":[{"id":"m_ex_sakura_01_1","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_1","text":"Hello.","jump":null},{"id":"m_ex_sakura_01_2","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_2","text":"I'm Sakura, the head of Seimeikai.","jump":null},{"id":"m_ex_sakura_01_3","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_3","text":"Nice to meet you.","jump":null},{"id":"m_ex_sakura_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_4","text":"Nice to meet you, too.","jump":null},{"id":"m_ex_sakura_01_5","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_5","text":"All right then.","jump":null},{"id":"m_ex_sakura_01_6","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_6","text":"There's no further reply from Sakura. She seems to be considering what to say next.","jump":null},{"id":"m_ex_sakura_01_7","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_7","text":"There's something I wanted to ask you.","jump":null},{"id":"m_ex_sakura_01_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_8","text":"What is it?","jump":null},{"id":"m_ex_sakura_01_9","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_9","text":"What are some things you like?","jump":null},{"id":"m_ex_sakura_01_10","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_10","text":"I feel this is something I should know about.","jump":null},{"id":"m_ex_sakura_01_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_11","text":"I like you.","jump":null},{"id":"m_ex_sakura_01_12","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_12","text":"... {AccountData.NickName}-kun.","jump":null},{"id":"m_ex_sakura_01_13","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_13","text":"Do you really think it's appropriate to be making such childish jokes","jump":null},{"id":"m_ex_sakura_01_14","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_14","text":"when we've only just met?","jump":null},{"id":"m_ex_sakura_01_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_15","text":"Sorry...","jump":null},{"id":"m_ex_sakura_01_16","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_16","text":"Let's try this again.","jump":null},{"id":"m_ex_sakura_01_17","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_17","text":"What are some things you like?","jump":null},{"id":"m_ex_sakura_01_18","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_18","text":"I like drinking tea.","jump":"m_ex_sakura_01_20"},{"id":"m_ex_sakura_01_19","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_19","text":"I like gazing at flowers.","jump":"m_ex_sakura_01_25"},{"id":"m_ex_sakura_01_20","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_20","text":"You do?","jump":null},{"id":"m_ex_sakura_01_21","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_21","text":"What kind of tea do you prefer?","jump":null},{"id":"m_ex_sakura_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_22","text":"I enjoy pretty much all kinds of tea.","jump":null},{"id":"m_ex_sakura_01_23","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_23","text":"In that case, how about I invite you over for tea sometime?","jump":null},{"id":"m_ex_sakura_01_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_24","text":"That sounds nice.","jump":"m_ex_sakura_01_31"},{"id":"m_ex_sakura_01_25","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_25","text":"Is that so?","jump":null},{"id":"m_ex_sakura_01_26","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_26","text":"One of my favorite activities is going for a stroll and taking in the flora.","jump":null},{"id":"m_ex_sakura_01_27","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_27","text":"Sounds like we have the same hobby.","jump":null},{"id":"m_ex_sakura_01_28","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_28","text":"If you'd like to,","jump":null},{"id":"m_ex_sakura_01_29","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_29","text":"the next time we talk online, we could each have a cup of tea and share our thoughts.","jump":null},{"id":"m_ex_sakura_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sakura_01_30","text":"That'd be nice.","jump":"m_ex_sakura_01_31"},{"id":"m_ex_sakura_01_31","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_31","text":"How fantastic that we share the same hobby.","jump":null},{"id":"m_ex_sakura_01_32","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_32","text":"As long as you're free,","jump":null},{"id":"m_ex_sakura_01_33","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_33","text":"I'd like to invite you over to my residence.","jump":null},{"id":"m_ex_sakura_01_34","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_34","text":"For now though, I must go.","jump":null},{"id":"m_ex_sakura_01_35","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_sakura_01_35","text":"Have a nice day.","jump":null}],"chat":true}