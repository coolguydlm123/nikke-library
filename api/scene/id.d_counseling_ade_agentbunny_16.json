{"id":"d_counseling_ade_agentbunny_16","cat":"counsel","group":{"id":"char5151","label":"Ade: Agent Bunny"},"label":"Advising Ade: Agent Bunny: 16","stage":null,"prev":"d_counseling_ade_agentbunny_15","next":"d_counseling_ade_agentbunny_17","speakers":{"ade_b":"Ade"},"icons":{"ade_b":"si_c315_00_s"},"lines":[{"id":"d_counseling_ade_agentbunny_16_1","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_1","text":"Master, by chance, is there anything you wish to ask me?","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ade_b"],"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_2","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_ade_agentbunny_16_2","text":"Actually, yeah. You said that you became a bunny girl at Mustang's request, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_3","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_3","text":"Yes, that is correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_4","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_4","text":"O-of course, I refused at first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ade_agentbunny_16_5","text":"Is it because you didn't want to show me?","jump":"d_counseling_ade_agentbunny_16_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ade_agentbunny_16_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ade_agentbunny_16_6","text":"Gotta love Mustang.","jump":"d_counseling_ade_agentbunny_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ade_agentbunny_16_7","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_7","text":"... N-no! That is inconceivable!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_8","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_8","text":"Please do not misunderstand my intentions...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_9","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_9","text":"It is merely that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_10","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_ade_agentbunny_16_10","text":"Merely what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_11","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_11","text":"B-because I am embarrassed for you to see me in such a manner! Oh dear... I cannot believe I uttered such a thing out loud...","jump":"d_counseling_ade_agentbunny_16_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_12","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_12","text":"In the end, you have seen me in this outfit regardless...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_13","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_13","text":"so I suppose Mr. Mustang must be chuckling to himself over his own witticism.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_14","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_ade_agentbunny_16_14","text":"Well, I'm a big fan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_15","type":"Speech","speaker":"ade_b","key":"Locale_Counseling:d_counseling_ade_agentbunny_16_15","text":"I-if you are pleased, Master... then it is quite worth it to me.","jump":"d_counseling_ade_agentbunny_16_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ade_agentbunny_16_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ade_agentbunny_16_16","text":"Ade continues to explain to me why she refused to wear the bunny girl outfit at first.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}