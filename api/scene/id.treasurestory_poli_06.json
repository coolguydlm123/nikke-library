{"id":"treasurestory_poli_06","cat":"favorite","group":{"id":"fav5016","label":"Poli"},"label":"Veteran Officer Poli's Relaxation Methods","stage":null,"prev":"treasurestory_poli_05","next":null,"speakers":{"poli":"Poli"},"icons":{"poli":"si_c030_00_s"},"notes":["Favorite item quest step: Go to the Command Center"],"lines":[{"id":"treasurestory_poli_06_1","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_1","text":"The Commander's Room is the perfect place to share this story.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"none","movie":null,"shown":["poli"],"affinity":null},{"id":"treasurestory_poli_06_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_2","text":"... I don't think this place is as private as Poli seems to think it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_3","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_4","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_4","text":"Hmm... Where should I start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_5","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_5","text":"I've been working all hours of the night for the past few days,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_6","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_6","text":"and it got me thinking","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_7","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_7","text":"all sorts of things:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_8","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_8","text":"Am I being too perfunctory in performing my duties?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_9","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_9","text":"Am I even doing my job all that well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_10","text":"So, even you have moments of self-doubt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_11","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_11","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_12","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_12","text":"I'm not a machine bereft of emotion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_13","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_13","text":"But then this notebook caught my eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_14","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_14","text":"As you probably could have guessed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_15","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_15","text":"it's from when I was human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_16","text":"I thought as much, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_17","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_17","text":"I was completely different back then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_sceneofmemory","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_18","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_18","text":"I was clumsy, and overly cautious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_19","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_19","text":"I would be reeling from a single compliment and be devastated by a single complaint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_20","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_20","text":"In other words, I was your typical rookie officer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_21","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_21","text":"I made a lot of mistakes too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_22","text":"Everyone's like that at first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_23","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_23","text":"You may find this hard to believe,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_24","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_24","text":"but I used to be afraid of citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_25","text":"Why? Were you worried about what they'd say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_26","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_26","text":"That was part of it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_27","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_27","text":"but it was more of the thought that my actions could result in innocent people getting hurt which terrified me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_28","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_28","text":"I didn't trust my own judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_29","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_29","text":"Who could possibly have faith in me if I didn't even trust myself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_30","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_30","text":"That fear caused me to be overly passive in my duties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_31","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_31","text":"The only thought in my head was to finish work quickly and get some rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_32","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_32","text":"That's why I find Quiry and Miranda so remarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_33","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_33","text":"They don't get dismayed from their mistakes or doubts, and instead always remain motivated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_34","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_34","text":"It's that tenacity that shows me they have a true and sincere love for their work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_35","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_35","text":"... Of course, there are days when they drive me up the wall, but still.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_36","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_36","text":"I get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_37","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_37","text":"Maybe that's why I couldn't tell them about this notebook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_38","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_38","text":"I was embarrassed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_39","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_39","text":"These pages contain all of my past mistakes and failures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_40","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_40","text":"Not exactly things I'm proud of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_41","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_41","text":"I felt self-conscious admitting how much of a coward I used to be,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_42","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_42","text":"especially to the two of them, who take their work so seriously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_43","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_43","text":"The way I was at the start of my career was entirely different from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_44","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_44","text":"Leaving the station today was just me avoiding the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_45","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_45","text":"Now that I think about it, maybe I haven't really progressed all that much since then, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_46","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_46","text":"I stretch out my hand towards Poli,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_47","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_47","text":"who is attempting to mask her sadness with an awkward smile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_48","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_48","text":"*Pat pat*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_49","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_49","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_50","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_50","text":"What are you patting my shoulder for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_51","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_51","text":"... It does feel nice, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_52","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_52","text":"I can feel my worries melting away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_53","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_53","text":"Thank you for telling me all this. I'm sure it wasn't easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_54","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_54","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_55","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_55","text":"I feel I can be comfortable sharing these mortifying stories with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_56","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_56","text":"Maybe it's because you see me for who I am?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_57","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_57","text":"Or maybe it's because there wasn't anything shameful about them to begin with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_58","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_58","text":"Huh? What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_59","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_59","text":"All your past experiences have shaped you into who you are today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_60","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_60","text":"Today of all days should have helped you realize that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_61","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_61","text":"Isn't that right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_62","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_63","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_63","text":"You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_64","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_64","text":"Many people thanked me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_65","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_65","text":"and that's when I realized:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_66","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_66","text":"I'm no longer afraid of the citizens, and they trust me now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_67","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_67","text":"I'm not the rookie I used to be. I've grown up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_68","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_68","text":"That's why I was able to tell you my story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_69","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_69","text":"Thank you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_70","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_70","text":"I didn't do anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_71","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_71","text":"On the contrary. You've done a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_72","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_72","text":"If it weren't for you, I'd probably have simply wandered around aimlessly before heading back to the station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_73","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_73","text":"When I have a lot of thoughts running through my mind like today,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_74","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_74","text":"I look at Quiry and Miranda, compare myself to them, and end up feeling like I don't measure up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_75","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_75","text":"Thanks to you, I now have the confidence to show them my notebook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_76","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_76","text":"Now I can tell them I've had my awkward moments as well, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_77","text":"Spoken like a true veteran officer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_78","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_78","text":"Hehe, thanks for the compliment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_79","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_79","text":"Having said that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_80","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_80","text":"is it okay if I come to you sometimes just to let off some steam?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_81","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_81","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_82","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_82","text":"I used to eat sweets and go for walks when things got tough,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_83","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_83","text":"but now, all I'll need are a few pats from you, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_84","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_84","text":"Nothing will get me in better spirits than that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_85","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_85","text":"In that case, I'll have to be sure to give you plenty of pats.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_86","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_86","text":"*Pat pat*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_87","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_87","text":"Aahhh... It's really addictive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_88","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_88","text":"I'll be here for you whenever you need me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_89","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_06_89","text":"In the meantime, keep looking out for the citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_90","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_90","text":"I will!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_91","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_91","text":"You can always count on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_06_92","type":"Speech","speaker":"poli","key":"Locale_NikkeEpisode:treasurestory_poli_06_92","text":"As a member of the A.C.P.U., I'll protect every last citizen, including you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}