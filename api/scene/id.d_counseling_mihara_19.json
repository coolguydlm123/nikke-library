{"id":"d_counseling_mihara_19","cat":"counsel","group":{"id":"char3006","label":"Mihara"},"label":"Advising Mihara: 19","stage":null,"prev":"d_counseling_mihara_18","next":"d_counseling_mihara_20","speakers":{"mihara":"Mihara"},"icons":{"mihara":"si_c161_00_s"},"lines":[{"id":"d_counseling_mihara_19_1","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_1","text":"I have to be honest with you Commander, I've been keeping a secret from you this entire time.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mihara"],"affinity":"_0"},{"id":"d_counseling_mihara_19_2","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_2","text":"Can you guess what it is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_3","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_3","text":"I'll let you know if you get it right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_19_4","text":"But if you tell me, it'll no longer be a secret.","jump":"d_counseling_mihara_19_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mihara_19_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_19_5","text":"You know Syuene's weakness?","jump":"d_counseling_mihara_19_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mihara_19_6","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_6","text":"Very true. By definition, a secret is only a secret when no one else knows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_7","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_7","text":"The moment I tell you what it is, it will cease to be a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_8","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_8","text":"You're a tough nut to crack, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_9","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_9","text":"I think that's what I like about you.","jump":"d_counseling_mihara_19_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_10","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_10","text":"Let me see... correct, or incorrect?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_11","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_11","text":"As soon as I tell you it's correct, it no longer becomes a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_12","type":"Speech","speaker":"mihara","key":"Locale_Counseling:d_counseling_mihara_19_12","text":"Therefore I can't tell you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_19_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_19_13","text":"Mihara and I talk about secrets.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}