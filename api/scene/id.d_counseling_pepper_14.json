{"id":"d_counseling_pepper_14","cat":"counsel","group":{"id":"char5027","label":"Pepper"},"label":"Advising Pepper: 14","stage":null,"prev":"d_counseling_pepper_13","next":"d_counseling_pepper_15","speakers":{"pepper":"Pepper"},"icons":{"pepper":"si_c131_00_s"},"lines":[{"id":"d_counseling_pepper_14_1","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_1","text":"Administering a shot to younger patients is a real challenge.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["pepper"],"affinity":"_0"},{"id":"d_counseling_pepper_14_2","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_2","text":"Is there any way to make it easier?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_pepper_14_3","text":"You should use anesthesia.","jump":"d_counseling_pepper_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_pepper_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_pepper_14_4","text":"Give them some candy, like a lollipop.","jump":"d_counseling_pepper_14_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_pepper_14_5","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_5","text":"You mustn't use anesthesia so recklessly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_14_6","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_6","text":"You could end up causing serious injury to someone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_14_7","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_7","text":"I guess all I can do is do my best to comfort them to get them through it.","jump":"d_counseling_pepper_14_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_14_8","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_8","text":"Good idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_14_9","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_9","text":"After they get their shot, I'll give them a little treat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_14_10","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_14_10","text":"That way they won't be as terrified about getting a shot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_14_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_pepper_14_11","text":"Pepper and I discuss the widely held fear of shots.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}