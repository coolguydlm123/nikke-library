{"id":"d_counseling_trina_03","cat":"counsel","group":{"id":"char5134","label":"Trina"},"label":"Advising Trina: 03","stage":null,"prev":"d_counseling_trina_02","next":"d_counseling_trina_04","speakers":{"trina":"Trina"},"icons":{"trina":"si_c412_00_s"},"lines":[{"id":"d_counseling_trina_03_1","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_03_1","text":"I had a dream yesterday.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["trina"],"affinity":"_0"},{"id":"d_counseling_trina_03_2","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_03_2","text":"I was running away from someone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_03_3","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_03_3","text":"and when they caught me, I transformed into a laurel tree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_03_4","text":"What a pleasant dream.","jump":"d_counseling_trina_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_trina_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_03_5","text":"What an awful nightmare.","jump":"d_counseling_trina_03_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_trina_03_6","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_03_6","text":"Haha, you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"