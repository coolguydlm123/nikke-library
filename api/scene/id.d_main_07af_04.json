e":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_14","text":"I did some snooping around the past month, and didn't turn up anything useful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_15","text":"I couldn't find out what's inside this bullet that Pilgrim gave you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_16","text":"It's some kind of unknown substance that's not registered in the database.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_17","text":"I tried asking around in the Outer Rim, but couldn't turn up anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_18","text":"Exia also said that the substance database has apparently been expunged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_19","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_19","text":"So one thing, maybe the ONLY thing, we know so far is that the Central Government is good at covering their tracks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_20","text":"The Heretic is a dead end as well. There are next to no records on them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_21","text":"Just rumors that read more like urban legends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_22","text":"Nothing reliable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_23","text":"We haven't been able to figure out how Marian could have been turned into a Heretic after her brain was destroyed either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_24","text":"We may be able to turn up something if we can get ourselves into the Central Government library...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_07af_04_25","text":"... But there's one small problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_07af_04_26","text":"The Central Government keeps that place under lock and key.","jump":