on","key":"Locale_MainScenario:d_main_07af_04_33","text":"Also, that bullet is no ordinary bullet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_34","text":"What makes you think that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_35","text":"A little gunpowder elf inside the bullet told me so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_36","text":"I like where you're going with this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_07af_04_37","text":"It's better we solve this problem ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_07af_04_38","text":"Agreed, the less people involved, the better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_39","text":"For sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_07af_04_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_07af_04_40","