{"id":"d_counseling_chime_15","cat":"counsel","group":{"id":"char5157","label":"Chime"},"label":"Advising Chime: 15","stage":null,"prev":"d_counseling_chime_14","next":"d_counseling_chime_16","speakers":{"chime":"Chime"},"icons":{"chime":"si_c331_00_s"},"lines":[{"id":"d_counseling_chime_15_1","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_15_1","text":"The noble speech of Her Highness doth stir the hearts of all who hear it.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["chime"],"affinity":"_0"},{"id":"d_counseling_chime_15_2","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_15_2","text":"Dost thou not agree?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_15_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_15_3","text":"Yeah... she's definitely dignified.","jump":"d_counseling_chime_15_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_chime_15_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_15_4","text":"She messes up quite a few words, doesn't she?","jump":"d_counseling_chime_15_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_chime_15_5","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_15_5","text":"Indeed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_15_6","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_15_6","text":"the dignity of Her Highness is the very force that upholds our kingdom.","jump":null