":null,"shown":null,"affinity":null},{"id":"event_ce009_2_04_e_108","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_04_e_108","text":"Roger that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_04_e_109","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_2_04_e_109","text":"Queen is the first to catch on, and the others follow suit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_04_e_110","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_2_04_e_110","text":"Sh-she's really intimidating...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_04_e_111","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_04_e_111","text":"She seems like a very strict instructor... But if the Commander says she's the best, then I'm sure she knows what she's doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_04_e_112","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_2_04_e_112","text":"We also need to learn how Nikkes fight and how to use the weapons we've borrowed. Let's do our best!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_04_e_113","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_2_04_e_113","text":"Training is beneficial for improving our coordination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_2_04_e_114","type":"Spee