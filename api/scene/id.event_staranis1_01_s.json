ity":null},{"id":"event_staranis1_01_s_77","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_77","text":"But there's an even bigger reason I'm not selling this car.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_78","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_78","text":"When you all arrive at a venue and step out of a ride like this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_79","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_79","text":"that's a picture-perfect moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_80","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_80","text":"Fair enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_81","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_81","text":"So... how do you feel about your first performance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_82","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_82","text":"You saw it, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_83","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_83","text":"I think it was good.","jump":null,"exit":false,"enter":null,"bg":null,"bg