11","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_111","text":"under Tetra, dreaming of stardom,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_112","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_112","text":"dreaming of becoming the next Pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_113","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_113","text":"Their songs, their dances, even their personas were modeled after Pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_114","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_114","text":"That's what they mean when they say we're not unique.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_115","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_115","text":"So we're just another bunch of Pretty-wannabes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_116","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_116","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_117","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_117","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_118","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_118","text":"There are just too many.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_119","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_119","text":"Tetra handled the Nikke conversions, but it can't manage all the Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_120","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_120","text":"More precisely, it's risky for a single company to control so many Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_121","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_121","text":"To keep this in check, any Nikke aiming to become a celebrity is placed under the Central Government's supervision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_122","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_122","text":"They're free to act as they wish, but must follow orders if the government issues one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_123","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_123","text":"Only the truly exceptional are directly managed by Tetra.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_124","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_124","text":"As a result, offices have sprung up everywhere, brimming with hopeful Nikkes chasing their dreams.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_125","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_125","text":"As much as I hate to admit it, we're just one of those countless small offices.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_126","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_126","text":"If we want to survive among all these Pretty-wannabes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_127","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_127","text":"we've got no choice but to go all-in on originality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_128","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_128","text":"Many pop stars have thought the same thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_129","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_129","text":"Naturally, the competition to recruit famous composers and songwriters is intense,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_130","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_130","text":"and we're not in any position to take part in it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_131","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_131","text":"'Cause we're broke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_132","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_132","text":"What are you talking about? It's not just money. We hardly have any name recognition either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_133","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_133","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_134","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_134","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_135","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_135","text":"Maybe you should let us go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_136","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_136","text":"No, not happening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_137","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_137","text":"We've got no money, no connections.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_138","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_138","text":"Aren't you ashamed of letting talent like ours rot in this dump of an office?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_139","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_139","text":"Not at all. I'm completely fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_140","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_01_s_140","text":"Well, we're not!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_141","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_01_s_141","text":"Ah... so our first performance ended up being a complete flop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_142","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_01_s_142","text":"Hopefully, that's the only time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_143","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_01_s_143","text":"Let's hurry and grab something to eat. I'm starving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_144","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_01_s_144","text":"Step on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_01_s_145","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_01_s_145","text":"All right, all right. Since that didn't work out, let's go get some food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}