{"id":"msg_m_subquest_1063_e","cat":"messenger","group":{"id":"room_treasurehunter","label":"Treasure Hunter · Quest"},"label":"6. Chat 6","stage":null,"prev":"msg_m_subquest_1063_s","next":"msg_m_subquest_1064_s","speakers":{"treasurehunter":"Treasure Hunter"},"icons":{},"lines":[{"id":"m_subquest_1063_e_0","type":"Narration","speaker":"treasurehunter","key":null,"text":"Reward: Tattered Sheet Music ×2","jump":null},{"id":"m_subquest_1063_e_2","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_2","text":"\"Agreed Location 9:00 PM\"?","jump":null},{"id":"m_subquest_1063_e_3","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_3","text":"Agreed Location...","jump":null},{"id":"m_subquest_1063_e_4","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_4","text":"They stipulated the time as well.","jump":null},{"id":"m_subquest_1063_e_5","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1063_e_5","text":"Do you know where this is?","jump":null},{"id":"m_subquest_1063_e_6","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_6","text":"Absolutely!","jump":null},{"id":"m_subquest_1063_e_7","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_7","text":"I wasn't sure at first,","jump":null},{"id":"m_subquest_1063_e_8","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_8","text":"but now I do.","jump":null},{"id":"m_subquest_1063_e_9","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_9","text":"They won't be happy until they muck everything up...","jump":null},{"id":"m_subquest_1063_e_10","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1063_e_10","text":"What did you say?","jump":null},{"id":"m_subquest_1063_e_11","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_11","text":"I said I know where this is!","jump":null},{"id":"m_subquest_1063_e_12","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_12","text":"I'll mark the location on your map.","jump":null},{"id":"m_subquest_1063_e_13","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_13","text":"That should be the last thing","jump":null},{"id":"m_subquest_1063_e_14","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_14","text":"standing between you and the treasure.","jump":null},{"id":"m_subquest_1063_e_15","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1063_e_15","text":"Why don't you go looking for it yourself?","jump":null},{"id":"m_subquest_1063_e_16","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_16","text":"That's simple.","jump":null},{"id":"m_subquest_1063_e_17","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_17","text":"It's because I can't walk.","jump":null},{"id":"m_subquest_1063_e_18","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_18","text":"So they won't allow me to go up to the surface.","jump":null},{"id":"m_subquest_1063_e_19","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_19","text":"All this time,","jump":null},{"id":"m_subquest_1063_e_20","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_20","text":"I've worked like a dog","jump":null},{"id":"m_subquest_1063_e_21","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_21","text":"And now look at me.","jump":null},{"id":"m_subquest_1063_e_22","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_22","text":"This is all because","jump":null},{"id":"m_subquest_1063_e_23","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_23","text":"the Nikkes betrayed us.","jump":null},{"id":"m_subquest_1063_e_24","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_24","text":"The traitors... Their greed knows no bounds.","jump":null},{"id":"m_subquest_1063_e_25","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_25","text":"They broke my leg.","jump":null},{"id":"m_subquest_1063_e_26","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_26","text":"They broke me.","jump":null},{"id":"m_subquest_1063_e_27","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_27","text":"They've been deceiving me all along.","jump":null},{"id":"m_subquest_1063_e_28","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_28","text":"Hiding hints in my old haunts,","jump":null},{"id":"m_subquest_1063_e_29","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_29","text":"taunting me.","jump":null},{"id":"m_subquest_1063_e_30","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_30","text":"It's true, I tell you!","jump":null},{"id":"m_subquest_1063_e_31","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_31","text":"Don't end up like me, Commander.","jump":null},{"id":"m_subquest_1063_e_32","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_32","text":"Don't believe in any Nikke, not for a second.","jump":null},{"id":"m_subquest_1063_e_33","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_33","text":"Got it?","jump":null},{"id":"m_subquest_1063_e_34","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1063_e_34","text":"I'll call you later.","jump":null}],"chat":true}