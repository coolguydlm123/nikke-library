{"id":"d_counseling_guilty_mightybunny_04","cat":"counsel","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Advising Guilty: Mighty Bunny: 04","stage":null,"prev":"d_counseling_guilty_mightybunny_03","next":"d_counseling_guilty_mightybunny_05","speakers":{"guilty_b":"Guilty"},"icons":{"guilty_b":"si_c404_00_s"},"lines":[{"id":"d_counseling_guilty_mightybunny_04_1","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_1","text":"I look at Guilty's new restraints.","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty_b"],"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_2","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_2","text":"The shape of them reminds me of drooping bunny ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_3","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_3","text":"Those restraints look good on you, Guilty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_4","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_4","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_5","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_5","text":"I'm not really sure whether I'll make a good bunny girl, though... Do I seem like a bunny to you, Counselor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_6","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_6","text":"What about bunnies specifically reminds you of me...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_7","text":"Rabbits die when they get lonely.","jump":"d_counseling_guilty_mightybunny_04_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_mightybunny_04_8","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_8","text":"Rabbits are extremely fast.","jump":"d_counseling_guilty_mightybunny_04_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_mightybunny_04_9","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_9","text":"Really...?! Is that true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_10","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_10","text":"Then I guess being a bunny fits me... After all, I get really lonely without you, Counselor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_11","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_11","text":"Hehe, I really am like a bunny... Now I'm glad I became a bunny girl.","jump":"d_counseling_guilty_mightybunny_04_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_12","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_12","text":"Bunnies are fast? I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_13","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_13","text":"Well, I'd be able to run really fast if I wasn't restrained... I guess that makes me like them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_14","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_14","text":"Huh? Running isn't what you meant...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_15","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_15","text":"Then what else about bunnies is fast?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_16","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_16","text":"Counselor...? Why aren't you answering?","jump":"d_counseling_guilty_mightybunny_04_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_04_17","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_04_17","text":"Guilty and I discuss the characteristics of rabbits.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}