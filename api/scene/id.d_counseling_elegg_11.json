{"id":"d_counseling_elegg_11","cat":"counsel","group":{"id":"char5107","label":"Elegg"},"label":"Advising Elegg: 11","stage":null,"prev":"d_counseling_elegg_10","next":"d_counseling_elegg_12","speakers":{"elegg":"Elegg"},"icons":{"elegg":"si_c500_00_s"},"lines":[{"id":"d_counseling_elegg_11_1","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_1","text":"Ah, lightning bolts, those searing flashes of light streaking across the night sky!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["elegg"],"affinity":"_0"},{"id":"d_counseling_elegg_11_2","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_2","text":"Have you ever seen one in real life, Mr. Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_11_3","text":"I have.","jump":"d_counseling_elegg_11_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_elegg_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_11_4","text":"Can't say I have.","jump":"d_counseling_elegg_11_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_elegg_11_5","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_5","text":"Not entirely surprising, considering how often you go up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_6","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_6","text":"Lightning is an immense energy resource, \nbut it's still beyond human control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_7","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_7","text":"Someday, I want to hold lightning in my own two hands.","jump":"d_counseling_elegg_11_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_8","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_8","text":"You haven't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_9","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_9","text":"I thought with how often you go up to the surface, you'd have seen some at some point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_10","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_10","text":"Well, I can tell you that it's a spectacular sight! First the flash, then the resounding BOOM!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_11","type":"Speech","speaker":"elegg","key":"Locale_Counseling:d_counseling_elegg_11_11","text":"One day I want to be able to harness the power of lightning.","jump":"d_counseling_elegg_11_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_elegg_11_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_elegg_11_12","text":"Elegg and I spend time talking about lightning.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}