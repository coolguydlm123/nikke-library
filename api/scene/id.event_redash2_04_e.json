ight","movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_5","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_5","text":"Wow, so you're all the Goddesses?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_6","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_6","text":"I'm Red Hood. Nice to meet you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_7","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_7","text":"Is anyone here a fan of the oldies, by any chance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_8","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_8","text":"No one? Then come here. I'll play some for you. You're gonna love this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_9","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_9","text":"Hey, Snooty, what's with the umbrella? It's not even raining.","jump":null,"exit":false,"enter":null,"bg":"land_d","bgArt":"land_d","image":null,"bgm":null,"movie":null,"shown":["dorothy"],"affinity":null},{"id":"event_redash2_04_e_10","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_04_e_10","text":"How many times have I told you? Don't call me \"Snooty\"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_11","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_04_e_11","text":"And this isn't an umbrella. It's a parasol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_12","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_12","text":"A parasol. What the heck is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_04_e_13","text":"You can use it to block the sunlight... um... \nWell, it serves the same purpose as an umbrella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_14","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_14","text":"So it's an umbrella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_15","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_04_e_15","text":"I've already told you, it's a parasol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_16","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_16","text":"Does it do a good job of blocking out the sun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_04_e_17","text":"Of course. That's what a parasol is meant to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_18","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_18","text":"Then let me borrow it. \nI wanna take a nap, but the sun is practically burning into my retinas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_04_e_19","text":"... Actually, I misspoke. This isn't a parasol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_20","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_20","text":"Oh come on, don't be like that. Let me borrow it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash2_04_e_21","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_22","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_22","text":"She never did end up giving it to me... that parsimonious...","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_23","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_23","text":"How much could a stinkin' umbrella possibly cost, anyway?","jump":null,"exit":false,"enter":null,"bg":"land_d","bgArt":"land_d","image":null,"bgm":null,"movie":null,"shown":["hongryeon_o"],"affinity":null},{"id":"event_redash2_04_e_24","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_24","text":"How come you're always so sensitive? That's no way to make friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_25","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_04_e_25","text":"Instruct them to be gone. My sensitivity is paramount to maintaining my edge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_26","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_04_e_26","text":"Only then can I assure that I never lose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_27","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_27","text":"A sword must be kept in its sheath when not in use for it not to lose its edge. Don't you know that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_28","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash2_04_e_28","text":"Same goes for people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_29","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_04_e_29","text":"Remain in its sheath...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2_04_e_30","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash2_04_e_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash2