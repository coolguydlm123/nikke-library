la_winterowner_04_55","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_55","text":"That was the day where I realized:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_56","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_56","text":"My family was little more than a parasite, leeching off of the disadvantaged in order to prove our so-called nobility to others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_57","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_57","text":"And here I had been all that time, waiting for a response from the orphanage, like a fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_58","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_58","text":"As for the rest, you already know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_59","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_59","text":"Once I encountered the first Nikkes, the Goddesses,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_60","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_60","text":"I abandoned my life as a Sovereign and became a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null