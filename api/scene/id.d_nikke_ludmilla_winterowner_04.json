":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_67","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_67","text":"However,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_68","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_68","text":"the orphanage had some financial troubles a while back and has long since shut down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_69","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_69","text":"Now I have a letter to which there can be no recipient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_70","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_70","text":"There must have been something I could have done for the children...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_71","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_71","text":"I never once thought about how I could have helped them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_72","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_72","text":"All I cared about was trying to protect and maintain my pride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_73","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_73","text":"And those innocent children paid the price for my vanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_74","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_74","text":"The letter has become yellowed over all these years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_75","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_75","text":"Once open, I can see there are sentences which have been revised numerous times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_76","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_76","text":"Every time I see this letter,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_77","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_77","text":"I think to myself about","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_78","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_78","text":"whether I'm still trying to prove my nobility,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_79","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_79","text":"and if I am attempting to prove it","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_80","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_80","text":"at the expense of others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_81","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_82","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_82","text":"Looking at Snowfield becoming so desolate,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_83","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_83","text":"I feel like history is repeating itself, and I've made the same mistake again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_84","type":"Speech","speaker":"ludmilla_w","key":"Locale_NikkeEpisode:d_nikke_ludmilla_winterowner_04_84","text":"I was running Snowfield","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ludmilla_winterowner_04_85","type":"