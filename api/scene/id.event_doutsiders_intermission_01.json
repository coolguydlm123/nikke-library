h","key":"Locale_SubScenario:event_doutsiders_intermission_01_12","text":"... Yes. I'm well aware of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_13","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_13","text":"But loyalty means something even to someone at the bottom of society like me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_14","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_14","text":"You guys saved my skin back there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_15","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_15","text":"This is something that I have to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_16","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_intermission_01_16","text":"Are you absolutely sure about this?","jump":"event_doutsiders_intermission_01_18","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_17","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_intermission_01_17","text":"You're taking a major risk here.","jump":"event_doutsiders_intermission_01_18","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_18","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_19","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_19","text":"To be honest, I'm a little afraid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_20","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_20","text":"But there's a reason why I'm doing this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_21","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_21","text":"At one point, I used to be a citizen of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_22","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_intermission_01_22","text":"Huh? You mean you're not originally from here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_23","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_23","text":"No. I was an ordinary office worker with a wife and kids.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_24","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_24","text":"Everyone has their own story,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_25","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_25","text":"but mine is more tragic than most.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_26","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_26","text":"One day, I was kidnapped by some criminals, and my citizenship chip was stolen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_27","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_27","text":"After that, well... you can see where I ended up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_28","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_28","text":"I was caught by a police officer who was on patrol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_29","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_29","text":"To them, I was a criminal attempting to illegally escape from the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_30","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_30","text":"I was tossed in with the dregs of society, who aren't even regarded as human, much less citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_31","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_intermission_01_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_32","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_intermission_01_32","text":"Is there anything I can do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_33","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_33","text":"No, it's okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_34","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_34","text":"After everything I've done, my hands are far from clean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_35","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_35","text":"A helping hand can't pull me out of this quagmire of chaos.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_intermission_01_36","type":"Speech","speaker":"joseph","key":"Locale_SubScenario:event_doutsiders_intermission_01_36","text":"But I can help you. Just give me one day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image