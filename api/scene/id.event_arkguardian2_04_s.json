ull,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_37","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_37","text":"Wait. They're taking position.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_38","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_38","text":"Bombardment-type Raptures, and it looks like they're aiming for the mass-produced Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_39","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_arkguardian2_04_s_39","text":"I shall go forth and hew them all down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_40","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_40","text":"Leave them. Rapunzel's here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_41","text":"A shower of missiles traces an arc as they rain down upon the field.","jump":null,"exit":false,"enter":null,"bg":"Desert_05","bgArt":"desert_05","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_42","text":"Multiple bombardment-type Raptures shell the mass-produced Nikkes' lines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_43","text":"Rapunzel steps forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapunzel"],"affinity":null},{"id":"event_arkguardian2_04_s_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_44","text":"With a prayer-like chant, she raises her staff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_45","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_45","text":"A shield to protect everyone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_46","text":"A golden veil descends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_47","text":"Missiles rain down and explode against the golden veil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_48","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_48","text":"This is truly impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_49","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_49","text":"You like it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["commander_op_r"],"affinity":null},{"id":"event_arkguardian2_04_s_50","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_50","text":"It's more than that. With such power...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_51","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_51","text":"Let's do it for real this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_52","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_52","text":"Yes. Let's make it happen. Zero casualties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_53","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_53","text":"You got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_54","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_54","text":"A golden glow surges from Rapunzel's staff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_55","text":"It skims through the ranks of Rapture, triggering a series of explosions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_56","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_56","text":"Did you see that? Our offensive capabilities have skyrocketed as well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_57","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_57","text":"Snow White... what exactly did she build?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_59","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_59","text":"I should have asked her to make mine first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["dorothy_op_l"],"affinity":null},{"id":"event_arkguardian2_04_s_60","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_60","text":"Well, maybe you should've been friendlier from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_61","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_61","text":"The order of these improvements wasn't based on affinity. I know that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_62","type":"Speech","speaker":"liliweiss_op_c","key":"Locale_MainScenario:event_arkguardian2_04_s_62","text":"*Huff... huff...* Where's Snow White?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liliweiss_op_c"],"affinity":null},{"id":"event_arkguardian2_04_s_63","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_64","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_64","text":"She's on her way there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_65","type":"Speech","speaker":"liliweiss_op_c","key":"Locale_MainScenario:event_arkguardian2_04_s_65","text":"She'll... *huff...* she'll be okay, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_66","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_66","text":"She'll be fine. She was the one who suggested it, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_67","type":"Speech","speaker":"liliweiss_op_c","key":"Locale_MainScenario:event_arkguardian2_04_s_67","text":"Maybe we should... *huff...* help her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_68","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_68","text":"Don't. She can handle it just fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_69","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_69","text":"She's right. Now is not the time to worry about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_70","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_70","text":"Storm Bringer has arrived, along with several aerial Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_71","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_71","text":"We've also spotted five mass-produced Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_72","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_72","text":"Even the Raptures that were waiting in the rear are on the move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_73","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_73","text":"They're throwing everything at us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_74","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_74","text":"We're seriously outnumbered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_75","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_75","text":"So we go big and finish strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_76","type":"Speech","speaker":"dorothy_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_76","text":"Let's hope Snow White doesn't show up late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_77","type":"Speech","speaker":"hongryeon_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_77","text":"Pray tell, whither hath Snow White absconded? I have scarcely seen her this entire time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["hongryeon_op_l"],"affinity":null},{"id":"event_arkguardian2_04_s_78","type":"Speech","speaker":"hongryeon_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_78","text":"Shirking her duty already, is she? Good grief... Youngsters these days are most incorrigible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_79","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_79","text":"... You didn't listen during the mission briefing, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_80","type":"Speech","speaker":"hongryeon_op_l","key":"Locale_MainScenario:event_arkguardian2_04_s_80","text":"Of course not. I pay no mind to the words of the weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_81","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_arkguardian2_04_s_81","text":"Snow White... umm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_82","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04