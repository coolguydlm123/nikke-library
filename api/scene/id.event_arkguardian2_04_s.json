guardian2_04_s_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_5","text":"After briefly tracing an arc through the air, Ultra crashes to the ground and crumples with a sickening sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_6","text":"Even amid a massive battlefield filled with Raptures, this sight can be seen and heard from everywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_7","text":"Liliweiss dusts off her hands and admires her handiwork.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_8","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_8","text":"Aren't you pushing yourself too hard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["commander_op_r"],"affinity":null},{"id":"event_arkguardian2_04_s_9","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_9","text":"I'm letting them know that I'm here to finish them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_10","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_10","text":"There's no point. Raptures aren't even capable of grasping a concept such as morale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_11","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_11","text":"I'm doing it for our own forces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_12","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_12","text":"It's solid showmanship, I'll give you that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_13","text":"Liliweiss wipes the lukewarm liquid flowing from somewhere on her face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian2_04_s_14","text":"There's no need for her to check; she already knows what it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_15","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_16","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_16","text":"... Just hold on a little longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_17","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_18","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_18","text":"Lilith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_19","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_19","text":"What is it? Why are you saying my name like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_20","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_20","text":"What do you say we go on a trip when this is over?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_21","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_21","text":"Are you trying to get me killed? You're distracting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_22","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_22","text":"Cliches are meant to be broken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_23","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_23","text":"... Okay then. Where are we going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_24","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_24","text":"Hmm... Let's go see the ocean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_25","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_26","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian2_04_s_26","text":"Sure. Let's do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_27","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_27","text":"Scarlet, how's it going?","jump":null,"exit":false,"enter":null,"bg":"Desert_03","bgArt":"desert_03","image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"event_arkguardian2_04_s_28","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_arkguardian2_04_s_28","text":"No need for words. I feel as light as the very air. At this pace, I shall eclipse Lilith herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_29","type":"Speech","speaker":"commander_op_r","key":"Locale_MainScenario:event_arkguardian2_04_s_29","text":"You do realize you've been hit more than five times, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian2_04_s_30","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_arkguardian2_04_s_30","text":"Thy calculations doth