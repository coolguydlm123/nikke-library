ocale_MainScenario:event_arkranger2_02_s_67","text":"Forgive me, Master, for greeting you in such a disheveled state.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_68","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_02_s_68","text":"Ugh... my head still hurts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_69","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_s_69","text":"It's okay. I'm just glad you're safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_70","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_s_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_71","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_s_71","text":"There are fallen Nikkes and Raptures lying scattered around the crater.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_72","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_s_72","text":"Wild animals too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_73","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_s_73","text":"Neon collapsed the moment she approached, and I started coughing up blood the moment I breathed in that scent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_74","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_s_74","text":"I \"died\" and came back. If not for the special gene in my blood, I'd just be dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_75","type":"Self","speaker":null,"key":"Locale_MainScenario:event_arkranger2_02_s_75","text":"... Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_76","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_s_76","text":"Yeah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_77","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:event_arkranger2_02_s_77","text":"We are likely dealing with a chemical weapon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_78","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_02_s_78","text":"Not just \"likely.\" When I approached, all kinds of warning alerts popped up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_79","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_02_s_79","text":"I'm certain it's a chemical weapon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_02_s_80","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:event_arkranger2_02_s_80","text"