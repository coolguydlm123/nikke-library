{"id":"msg_m_ex_mica_04","cat":"messenger","group":{"id":"room_mica","label":"Mica · Nikke"},"label":"4. Hey, Old-Timer,","stage":null,"prev":"msg_m_ex_mica_03","next":"msg_m_ex_mica_05","speakers":{"mica":"Mica"},"icons":{"mica":"si_c061_00_s"},"lines":[{"id":"m_ex_mica_04_1","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_1","text":"Hey, Old-Timer,","jump":null},{"id":"m_ex_mica_04_2","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_2","text":"do you have a free moment?","jump":null},{"id":"m_ex_mica_04_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_3","text":"What's wrong?","jump":null},{"id":"m_ex_mica_04_4","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_4","text":"There was something I was hoping I could get your advice on.","jump":null},{"id":"m_ex_mica_04_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_5","text":"That there are no customers coming to the toy store?","jump":null},{"id":"m_ex_mica_04_6","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_6","text":"That is a big issue, yes, but this is something","jump":null},{"id":"m_ex_mica_04_7","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_7","text":"even more important than that.","jump":null},{"id":"m_ex_mica_04_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_8","text":"What is it?","jump":null},{"id":"m_ex_mica_04_9","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_9","text":"Do you know a lot about make-up?","jump":null},{"id":"m_ex_mica_04_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_10","text":"Make-up?","jump":null},{"id":"m_ex_mica_04_11","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_11","text":"Yeah.","jump":null},{"id":"m_ex_mica_04_12","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_12","text":"Now that I'm all grown up,","jump":null},{"id":"m_ex_mica_04_13","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_13","text":"I feel that I should know a bit more about cosmetics.","jump":null},{"id":"m_ex_mica_04_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_14","text":"Do you really feel you're old enough for all that?","jump":null},{"id":"m_ex_mica_04_15","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_15","text":"Of course!","jump":null},{"id":"m_ex_mica_04_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_16","text":"I don't know a whole lot about it myself, but...","jump":null},{"id":"m_ex_mica_04_17","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_17","text":"Go on.","jump":null},{"id":"m_ex_mica_04_18","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_18","text":"Eyebrow makeup is important as it determines the impression of the face!","jump":"m_ex_mica_04_20"},{"id":"m_ex_mica_04_19","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_19","text":"Dark lipstick that exudes a mature look should be what you're after.","jump":"m_ex_mica_04_20"},{"id":"m_ex_mica_04_20","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_20","text":"Oh!","jump":null},{"id":"m_ex_mica_04_21","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_21","text":"Are you sure that won't be too overt?","jump":null},{"id":"m_ex_mica_04_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_22","text":"Make-up should always stand out.","jump":null},{"id":"m_ex_mica_04_23","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_23","text":"I see.","jump":null},{"id":"m_ex_mica_04_24","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_24","text":"I'll keep that in mind.","jump":null},{"id":"m_ex_mica_04_25","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_25","text":"I'm really looking forward","jump":null},{"id":"m_ex_mica_04_26","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_26","text":"to the next mission now!","jump":null},{"id":"m_ex_mica_04_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_27","text":"What do you mean?","jump":null},{"id":"m_ex_mica_04_28","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_28","text":"Cause of camouflage makeup.","jump":null},{"id":"m_ex_mica_04_29","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_29","text":"I was always taught to blend in on the battlefield,","jump":null},{"id":"m_ex_mica_04_30","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_30","text":"but apparently,","jump":null},{"id":"m_ex_mica_04_31","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_31","text":"you should stand out.","jump":null},{"id":"m_ex_mica_04_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_32","text":"No, that's not","jump":null},{"id":"m_ex_mica_04_33","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_33","text":"Thanks, Old-Timer!","jump":null},{"id":"m_ex_mica_04_34","type":"Speech","speaker":"mica","key":"Locale_SuddenMessage:m_ex_mica_04_34","text":"Talk to you next time.","jump":null},{"id":"m_ex_mica_04_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_35","text":"Mica, I don't think you quite understand...","jump":null},{"id":"m_ex_mica_04_36","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_mica_04_36","text":"Mica, however, doesn't reply.","jump":null}],"chat":true}