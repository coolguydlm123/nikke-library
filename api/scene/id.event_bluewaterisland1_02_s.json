uewaterisland1_02_s_72","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland1_02_s_72","text":"They're red as well... I wonder if they'd help my firepower...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_02_s_73","type":"Speech","speaker":"mary_s","key":"Locale_SubScenario:event_bluewaterisland1_02_s_73","text":"Neon, don't get distracted, or you may fall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_02_s_74","type":"Speech","speaker":"mary_s","key":"Locale_SubScenario:event_bluewaterisland1_02_s_74","text":"You should look straight ahead when crossing a narrow path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_02_s_75","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland1_02_s_75","text":"Oh, good point!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_02_s_76","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland1_02_s_76","text":"I'll just turn around and walk backward then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_02_s_77","type":"Speech","speaker":"pepper_s","key":"Locale_SubScenario:event_bluewaterisland1_02_s_77","text":"You idiot, that's even more dangerous!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_02_s_78","type":"Speech","speaker":"mary_s","key":"Locale_SubScenario:event_bluewaterisland1_02_s_78