l},{"id":"event_coinrushshowdown1_intermission_01_108","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_intermission_01_108","text":"In the aftermath, we are met with even frostier gazes than before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}