owdown1_intermission_01_97","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_intermission_01_97","text":"We apologize for not making this rule clear beforehand!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_intermission_01_98","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_intermission_01_98","text":"We assumed everyone would share the same spirit and enjoy the competition!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_intermission_01_99","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_intermission_01_99","text":"In light of these circumstances, this round will be nullified, and all current participants will advance to the third round!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_intermission_01_100","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_intermission_01_100","text":"In addition, rounds will no longer be initiated without prior notice!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_intermission_01_101","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:event_coinrushshowdown1_intermission_01_101","text":"We believed that elements of surprise were the very essence of entertainment,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_intermission_01_102","type":"Speech","speaker":"guardleader","key":"Locale_MainScenario:e