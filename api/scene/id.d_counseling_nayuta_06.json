{"id":"d_counseling_nayuta_06","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 06","stage":null,"prev":"d_counseling_nayuta_05","next":"d_counseling_nayuta_07","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_06_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_06_1","text":"Beholding thee,","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_06_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_06_2","text":"my mind returns unto the very moment I first encountered the Forerunners.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_06_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_06_3","text":"They were more ordinary than you thought, right?","jump":"d_counseling_nayuta_06_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_06_4","text":"They were more impressive than you thought, right?","jump":"d_counseling_nayuta_06_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_06_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_06_5","text":"Haha! Ordinary... sayest thou so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_06_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_06_6","text":"If the Forerunners be deemed but ordinary, then verily, none in all this world canst be called ordinary.","jump":"d_counseling_nayuta_06_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_06_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_06_7","text":"Verily so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_06_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_06_8","text":"'Twas a most remarkable first meeting;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_06_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_06_9","text":"so wondrous vivid it was, that even unto this day it doth yet stand before mine very eyes.","jump":"d_counseling_nayuta_06_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_06_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_06_10","text":"I listen to the story of Nayuta's first meeting with the Pioneers.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}