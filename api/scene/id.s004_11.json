ed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_73","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_73","text":"Verily, such words are unbecoming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_74","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_74","text":"I'm saying it as it is! We're bloody screwed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_75","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_75","text":"Jellyfish is coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_76","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_11_76","text":"... Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_77","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_77","text":"I said Liberalio is coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_78","type":"Speech","speaker":"isabel_op_r","key":"Locale_SideStory:s004_11_78","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["isabel_op_r"],"affinity":null},{"id":"s004_11_79","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_11_79","text":"... Tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_80","type":"Speech","speaker":"isabel_op_r","key":"Locale_S