cale_SideStory:s004_11_95","text":"So even a Heretic won't be able to see Eden right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_96","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_96","text":"They might just be passing by, but it's best to stay on combat alert for now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_97","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_97","text":"Rain...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_98","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_98","text":"If she be the master of this torrential downpour,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_99","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_99","text":"and if perchance she possesses the skill to glean knowledge from each falling raindrop,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_100","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_100","text":"she shall not behold Eden itself, yet she shall know that it lieth near.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_101","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_101","text":"I verily deem it unlikely that she would advance with an army of Raptures in tow without good cause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_102","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_11_102","text":"... Monk, tell me everything you know about Liberalio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_103","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_103","text":"I perished ere I could ascertain aught of her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_104","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_104","text":"She is the Heretic who moves least, and of whom I know least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_105","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_105","text":"Forgive me, for she remaineth nigh unto an enigma.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_106","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_11_106","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_107","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_11_107","text":"Johan touches the pistol inside his coat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_108","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_11_108","text":"After a moment, as if he has made up his mind, he pulls out the gun,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_109","type":"Narration","speaker":null,"key":"Locale_Sid