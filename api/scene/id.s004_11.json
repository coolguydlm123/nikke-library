{"id":"s004_11","cat":"side","group":{"id":"side4","label":"EDEN SPEAR"},"label":"EDEN SPEAR: 11","stage":null,"prev":"s004_10","next":"s004_12","speakers":{"papillon":"Papillon","cecil":"Cecil","johan_op_l":"Johan","nihilister_a":"Nihilister","nayuta_n":"Nayuta","johan":"Johan","isabel_op_r":"Isabel"},"icons":{"papillon":"si_c890_00_s","cecil":"si_c929_00_s","johan_op_l":"si_c925_00_s","nihilister_a":"si_c261_00_s","nayuta_n":"si_c9008_00_s","johan":"si_c925_00_s","isabel_op_r":"si_c231_00_s"},"lines":[{"id":"s004_11_1","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_11_1","text":"*Ssshhhhhh*","jump":null,"exit":false,"enter":null,"bg":"EdenIndoor","bgArt":"edenindoor","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":["papillon","cecil"],"affinity":null},{"id":"s004_11_2","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_2","text":"... Man, it's really pouring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_3","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_3","text":"How long has it been raining like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_4","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_4","text":"Not sure. But it's definitely been over two weeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_5","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_5","text":"It's so boring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_6","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_6","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_7","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_7","text":"There's no TV or anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_8","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_8","text":"On the surface, it's common for the signal to be cut off in bad weather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_9","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_9","text":"Since we don't use the Ark's network, this is definitely a weakness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_10","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_10","text":"Ah, right. We're on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_11","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_11","text":"I've been cooped up in that room for so long that I forgot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_12","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_12","text":"What do you usually occupy your time with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_13","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_13","text":"... Oh, you know, this and that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_14","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_14","text":"Look out the window, poke around the fridge, do some laps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_15","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_15","text":"I've gotten incredibly efficient at killing time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_16","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_16","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_17","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_18","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_18","text":"Cecil, when do you think long-range communications will be back up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_19","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_19","text":"It's hard to say. The forecasting system didn't detect this downpour,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_20","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_20","text":"and it came suddenly, so it could just as easily cease without warning,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_21","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_21","text":"or continue without end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_22","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_22","text":"Ugh... I'm dying of boredom over here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_23","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_23","text":"Perhaps a board game would suffice?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_24","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_24","text":"I have no one to play with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_25","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_25","text":"Convincing Noah might be worth attempting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_26","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_26","text":"Forget it. She gets so smug whenever she wins, and it really annoys me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_27","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_27","text":"That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_28","type":"Speech","speaker":"johan_op_l","key":"Locale_SideStory:s004_11_28","text":"Cecil, it's done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["johan_op_l"],"affinity":null},{"id":"s004_11_29","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_29","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_30","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_30","text":"I guess the preparations are complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_31","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_31","text":"Excuse me, I'll take my leave now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_32","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_32","text":"... Preparations? What preparations?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_33","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_33","text":"That's classified for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_34","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s004_11_35","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_11_35","text":"So Nihilister has recovered?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_36","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_36","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_heartdestroyer","movie":null,"shown":["nihilister_a","cecil","johan","nayuta_n"],"affinity":null},{"id":"s004_11_37","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_37","text":"my weapons aren't restored yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_38","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_38","text":"This isn't exactly what I'd call a fair deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_39","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_39","text":"Young Lady Fire Dragon, thou truly lackest a conscience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_40","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_40","text":"Should thy weapons be restored, who can say if thou wouldst not set fire and take flight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_41","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_41","text":"We, too, find ourselves in need of safeguards for our own safety.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_42","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_42","text":"... Tsk. Fine, I suppose you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_43","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_11_43","text":"How long to get to where Lilith's body is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_44","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_44","text":"If I were to transform and fly there, it'd be quick. But of course, that's not even a remote possibility right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_45","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_45","text":"So, it'll take about two weeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_46","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_11_46","text":"That far?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_47","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_47","text":"Hadst thou revealed the location sooner, we might already have retrieved her. It seems, however, that thou delightest in wasting others' time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_48","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_48","text":"Give me a break. How do I know you wouldn't just eviscerate me once you had the location?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_49","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_49","text":"I daresay that is true. Were I in such a case, I should have acted likewise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_50","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_50","text":"Then let's move out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_51","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_51","text":"That's not feasible at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_52","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_52","text":"We will depart once the weather improves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_53","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_53","text":"What a joke. You're worrying about something like the weather?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_54","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_54","text":"Let's hit the road. I don't want to be stuck here for another second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_55","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_55","text":"Why, is not the Atlas Cage a most agreeable and snug abode? It doth make no sound, nor doth it break.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_56","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_11_56","text":"'Tis most fitting for meditation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_57","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_57","text":"I'll leave the meditating to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_58","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_59","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_59","text":"Haha, that's funny when I hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_60","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_60","text":"You can't go outside just because the weather's bad? What, do you live in some sheltered little world, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_61","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_61","text":"It's been pouring for weeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_62","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_62","text":"Long-range communications are down,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_63","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_11_63","text":"so going outside now would be unwise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_11_64","type":"Speech","speaker":"nihilister_a","key":"Locale_SideStory:s004_11_64","text":"So what if we get a little wet...?","jump":null,"exit":false,"enter":null,"bg":n