{"id":"d_counseling_drake_greatvillain_04","cat":"counsel","group":{"id":"char5181","label":"Drake: Great Villain"},"label":"Advising Drake: Great Villain: 04","stage":null,"prev":"d_counseling_drake_greatvillain_03","next":"d_counseling_drake_greatvillain_05","speakers":{"drake_p":"Drake"},"icons":{"drake_p":"si_c104_00_s"},"lines":[{"id":"d_counseling_drake_greatvillain_04_01","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_01","text":"Laplace started watching her diet after she became the strongest hero there is.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["drake_p"],"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_02","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_02","text":"She's forcing me to follow a set diet, saying I should eat a wider variety of foods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_03","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_03","text":"But I hate vegetables!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_04","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_greatvillain_04_04","text":"You'll still be the strongest villain there is, with or without a set diet.","jump":"d_counseling_drake_greatvillain_04_06","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_drake_greatvillain_04_05","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_greatvillain_04_05","text":"Obeying a hero disqualifies you as a villain!","jump":"d_counseling_drake_greatvillain_04_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_drake_greatvillain_04_06","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_06","text":"That's right! I became the strongest villain there is without going on a diet!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_07","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_07","text":"That means there's no need to start eating vegetables now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_08","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_08","text":"Now, go tell Laplace what I said!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_09","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_09","text":"It feels awkward telling her myself...","jump":"d_counseling_drake_greatvillain_04_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_10","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_10","text":"... I'm following the advice of a colleague, not a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_11","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_11","text":"And don't you think that was a little harsh, Moron?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_12","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_04_12","text":"Saying I'm disqualified from being a villain...","jump":"d_counseling_drake_greatvillain_04_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_04_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_drake_greatvillain_04_13","text":"I talk with Drake about her diet.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}