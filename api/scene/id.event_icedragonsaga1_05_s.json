ech","speaker":"eunhwa","key":"Locale_MainScenario:event_icedragonsaga1_05_s_38","text":"Time is money, Weakling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_05_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:event_icedragonsaga1_05_s_39","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_05_s_40","type":"Speech","speaker":"narration","key":"Locale_MainScenario:event_icedragonsaga1_05_s_40","text":"Eunhwa proceeds to show the party a wide variety of weapons fit for a hero, including:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_05_s_41","type":"Speech","speaker":"narration","key":"Locale_MainScenario:event_icedragonsaga1_05_s_41","text":"a great sword where various orbs could be inserted;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_05_s_42","type":"Speech","speaker":"narration","key":"Locale_MainScenario:event_icedragonsaga1_05_s_42","text":"an iron crowbar that could knock an enemy out cold;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_05_s_43","type":"Speech","speaker":"narration","key":"Locale_MainScenario:event_icedragonsaga1_05_s_43","text":"and a diamantine sword, all surrounded by piles of books.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_05_s_44","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:event_icedragonsaga1_05_s_44","text":"...","jump":null,"exit":