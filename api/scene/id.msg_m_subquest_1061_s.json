{"id":"msg_m_subquest_1061_s","cat":"messenger","group":{"id":"room_treasurehunter","label":"Treasure Hunter · Quest"},"label":"1. Hello, Commander.","stage":null,"prev":null,"next":"msg_m_subquest_1061_e","speakers":{"treasurehunter":"Treasure Hunter"},"icons":{},"lines":[{"id":"m_subquest_1061_s_1","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_1","text":"Hello, Commander.","jump":null},{"id":"m_subquest_1061_s_2","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_2","text":"You've helped out so much on the surface!","jump":null},{"id":"m_subquest_1061_s_3","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_3","text":"So, I'm here with something very, very interesting.","jump":null},{"id":"m_subquest_1061_s_4","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_4","text":"I'm a Treasure Hunter, btw.","jump":null},{"id":"m_subquest_1061_s_5","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1061_s_5","text":"Something very interesting?","jump":null},{"id":"m_subquest_1061_s_6","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_6","text":"Oho.","jump":null},{"id":"m_subquest_1061_s_7","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_7","text":"Seems I've already piqued your interest, huh?","jump":null},{"id":"m_subquest_1061_s_8","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_8","text":"Do you like treasure, Commander?","jump":null},{"id":"m_subquest_1061_s_9","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_9","text":"I've got with me here a treasure map!","jump":null},{"id":"m_subquest_1061_s_10","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_10","text":"No matter how much I look at it, it doesn't seem to be anywhere in the Ark.","jump":null},{"id":"m_subquest_1061_s_11","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_11","text":"It has to be on the surface...","jump":null},{"id":"m_subquest_1061_s_12","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_12","text":"But I can't go to the surface for now.","jump":null},{"id":"m_subquest_1061_s_13","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1061_s_13","text":"For now?","jump":null},{"id":"m_subquest_1061_s_14","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_14","text":"Anyway...","jump":null},{"id":"m_subquest_1061_s_15","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_15","text":"I heard you're such a competent Commander","jump":null},{"id":"m_subquest_1061_s_16","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_16","text":"that you'll agree to any request.","jump":null},{"id":"m_subquest_1061_s_17","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_17","text":"How about we find this treasure together?","jump":null},{"id":"m_subquest_1061_s_18","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_18","text":"How's that? Still interested?","jump":null},{"id":"m_subquest_1061_s_19","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_19","text":"If we can find the treasure,","jump":null},{"id":"m_subquest_1061_s_20","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_20","text":"and I mean IF,","jump":null},{"id":"m_subquest_1061_s_21","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_21","text":"we'll split it 50-50.","jump":null},{"id":"m_subquest_1061_s_22","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1061_s_22","text":"60-40.","jump":null},{"id":"m_subquest_1061_s_23","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_23","text":"That's too much!","jump":null},{"id":"m_subquest_1061_s_24","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_24","text":"I'm the one with the treasure map, after all!","jump":null},{"id":"m_subquest_1061_s_25","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1061_s_25","text":"80-20.","jump":null},{"id":"m_subquest_1061_s_26","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_26","text":"What? You are such a...","jump":null},{"id":"m_subquest_1061_s_27","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1061_s_27","text":"A what?","jump":null},{"id":"m_subquest_1061_s_28","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_28","text":"Such a mule who doesn't know when to quit.","jump":null},{"id":"m_subquest_1061_s_29","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_29","text":"Let's make it 60-40.","jump":null},{"id":"m_subquest_1061_s_30","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_30","text":"Final offer.","jump":null},{"id":"m_subquest_1061_s_31","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1061_s_31","text":"Deal.","jump":null},{"id":"m_subquest_1061_s_32","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_32","text":"I'll take a photo of the map and send it to you.","jump":null},{"id":"m_subquest_1061_s_33","type":"Speech","speaker":"treasurehunter","key":"Locale_SubScenario:m_subquest_1061_s_33","text":"I'll be waiting for the good news ♡","jump":null}],"chat":true}