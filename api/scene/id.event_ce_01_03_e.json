":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce_01_03_e_6","text":"but her bullets always find their target.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_e_7","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_03_e_7","text":"This body of mine cannot be beaten!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_e_8","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_03_e_8","text":"What about Denji?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_e_9","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_03_e_9","text":"Good. His powers are quite useful in a fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_e_10","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_03_e_10","text":"But a typical battle formation consists of five people. There are seven of us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_e_11","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_03_e_11","text":"Two of us will always have to sit the battle out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_e_12","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_03_e_12","text":"We'll have Power and Himeno at the front since they hit the hardest and have the highest accuracy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null