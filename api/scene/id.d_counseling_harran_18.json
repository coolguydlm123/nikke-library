{"id":"d_counseling_harran_18","cat":"counsel","group":{"id":"char5042","label":"Harran"},"label":"Advising Harran: 18","stage":null,"prev":"d_counseling_harran_17","next":"d_counseling_harran_19","speakers":{"harran":"Harran"},"icons":{"harran":"si_c230_00_s"},"lines":[{"id":"d_counseling_harran_18_1","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_1","text":"A few days ago I encountered an abandoned Nikke up on the surface who was on the verge of death.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["harran"],"affinity":"_0"},{"id":"d_counseling_harran_18_2","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_2","text":"Do you know what she said to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_3","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_3","text":"She wanted to return to the time before she was a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_4","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_4","text":"Have you ever wanted to go back to the past?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_18_5","text":"Sure, there are times when I've wanted to go back.","jump":"d_counseling_harran_18_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_harran_18_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_18_6","text":"For me, the past should remain in the past.","jump":"d_counseling_harran_18_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_harran_18_7","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_7","text":"But what good does getting lost in the past do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_8","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_8","text":"If you're unhappy with your past, then make up for it in the here and now.","jump":"d_counseling_harran_18_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_9","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_9","text":"You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_10","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_10","text":"There's no point in trying to go back and fix what has already happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_11","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_11","text":"If you're unhappy with your past, then make up for it in the here and now.","jump":"d_counseling_harran_18_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_18_12","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_18_12","text":"If you ever feel like doing th