lse,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_14","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_14","text":"Good thing we didn't report her missing... That would've been a mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_15","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_15","text":"Now then, who else do we still need to find?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_16","type":"Speech","speaker":"miranda","key":"Locale_SubScenario:event_goodworld_02_s_16","text":"We were just about to go look for you, Miss Snow!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_17","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_17","text":"Oh my, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_18","text":"Yeah, we were starting to think you got lost or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_19","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_19","text":"I see. I'm sorry, dear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_20","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_20","text":"It's been a while since I've been up in the Ark, so I got a little lost along the way. I hope I didn't keep you waiting too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_21","text":"It's been a while...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_22","type":"Speech","speaker":"miranda","key":"Locale_SubScenario:event_goodworld_02_s_22","text":"Uh... well then, since it looks like her friend's been found safe and sound, we'll be heading off now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_23","type":"Speech","speaker":"miranda","key":"Locale_SubScenario:event_goodworld_02_s_23","text":"Thank you for your cooperation, Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_24","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_24","text":"Anytime. I'll leave the rest to you, Miranda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_25","type":"Speech","speaker":"littlegirl3","key":"Locale_SubScenario:event_goodworld_02_s_25","text":"Bye-bye, Miss Snow! Bye-bye, mister!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_26","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_26","text":"You take care now, little one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_27","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_27","text":"Miranda and the little girl leave together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_28","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_28","text":"Oh my, I didn't think it would take me this long to find her toy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_29","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_29","text":"Thank you for comforting the little one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_30","text":"I'm not great with kids, so thanks for stepping in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_31","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_31","text":"You're really good with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_32","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_32","text":"I like children. They're so pure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_33","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_33","text":"And I like kind people like you too,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_34","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_34","text":"the kind who help others out of genuine kindness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_35","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_35","text":"I wouldn't go as far as calling myself a good person...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_36","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_36","text":"Now then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_37","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_37","text":"Snow Crane stares straight at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_38","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_02_s_38","text":"Why are you staring at me like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_39","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_02_s_39","text":"I'm glad you're awake now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_02_s_40","type":"Speech","spe