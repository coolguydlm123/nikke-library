{"id":"d_counseling_liter_05","cat":"counsel","group":{"id":"char5011","label":"Liter"},"label":"Advising Liter: 05","stage":null,"prev":"d_counseling_liter_04","next":"d_counseling_liter_06","speakers":{"liter":"Liter"},"icons":{"liter":"si_c082_00_s"},"lines":[{"id":"d_counseling_liter_05_1","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_1","text":"Centi is such an amazing kid.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["liter"],"affinity":"_0"},{"id":"d_counseling_liter_05_2","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_2","text":"She does everything I tell her, without any complaining.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_3","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_3","text":"But, I'm worried that she might become too dependent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_05_4","text":"Centi is not a kid.","jump":"d_counseling_liter_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_liter_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_05_5","text":"It's okay. She has you to watch out for her.","jump":"d_counseling_liter_05_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_liter_05_6","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_6","text":"... Right. She probably has thoughts of her own, I suppose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_7","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_7","text":"Soon, she will be independent enough to make it without me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_8","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_8","text":"Haha. When I think about it, delight and sorrow mix in my heart...","jump":"d_counseling_liter_05_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_9","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_9","text":"Haha! That's the right answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_10","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_10","text":"... But, you know, even I will die one day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_11","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_05_11","text":"I can't always be by her side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_05_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_liter_05_12","text":"I listen to Liter brag about Centi.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}