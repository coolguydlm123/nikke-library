e door!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_27","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_27","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_28","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_28","text":"The door opens, and Maxwell and Laplace come in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["laplace","maxwell"],"affinity":null},{"id":"d_nikke_drake_05_29","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_29","text":"What's going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_30","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_30","text":"Drake! I heard you put a stop to that cowardly terrorist attack!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_31","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_31","text":"Incredible! So you really are a hero! I knew you had it in you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_32","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_drake_05_32","text":"I knew you were off wandering about for the past few days, but I never imagined this is what you were up to!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_33","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_drake_05_33","text":"Just incredible. I see you in an entirely different light now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_34","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_34","text":"Thanks to you, you proved that justice is alive and well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_35","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_35","text":"You're such a motivation to me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_36","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_36","text":"Everything... Everything is thanks to you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_37","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_37","text":"I'll never forget this as long as I live!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_38","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_38","text":"I can't believe how ignorant I was before!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_39","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_drake_05_39","text":"Here I was trying to prove that justice still existed, and the very incarnation of justice itself was right next to me the whole time!","jump":null,"exit":f