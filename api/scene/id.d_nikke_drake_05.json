{"id":"d_nikke_drake_05","cat":"bond","group":{"id":"char5024","label":"Drake"},"label":"Drake, Hero of the Ark","stage":null,"prev":"d_nikke_drake_04","next":null,"speakers":{"announcer":"Announcer","drake":"Drake","laplace":"Laplace","maxwell":"Maxwell"},"icons":{"announcer":"si_c912_00_s","drake":"si_c101_00_s","laplace":"si_c100_00_s","maxwell":"si_c102_00_s"},"lines":[{"id":"d_nikke_drake_05_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_1","text":"Drake watches the TV screen blankly as if in a daze.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"none","movie":null,"shown":["drake"],"affinity":null},{"id":"d_nikke_drake_05_2","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_2","text":"Just yesterday,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_3","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_3","text":"an incident occurred during the \"Lament for the Lost\" event held to honor those who were unable to make it to the Ark during the first Rapture invasion.","jump":null,"exit":false,"enter":null,"bg":"Stage","bgArt":"stage","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_4","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_4","text":"An armed terrorist group hailing from the Outer Rim, \"Heavenly Ascension\", attempted to carry out a suicide bombing at the venue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_5","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_5","text":"Fortunately, one of the members of Matis, Drake managed to subdue them single-handedly, preventing what could have been a terrible tragedy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_6","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_6","text":"There were about 4000 Ark citizens at the venue, all of whom now owe their lives to Drake's heroic actions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_7","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_7","text":"In addition to putting a stop to this terrorist incident, her previous good deeds also make her worthy of being called a true hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_8","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_8","text":"Thanks to this, the popularity of the Missilis industry as well as Matis is soaring, with no end in sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_9","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_05_9","text":"The committee responsible for organizing the event thanked Drake for stopping the terrorist attack as well as...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_10","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_herecomestrouble","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_11","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_11","text":"I've become famous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_12","text":"Very.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_13","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_14","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_14","text":"None of it matters so long as I'm not famous for being a villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_15","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_15","text":"I've failed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_16","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_16","text":"I'm garbage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_17","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_17","text":"I don't deserve to live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_18","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_18","text":"Why are you being so hard on yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"