,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_47","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_47","text":"Laplace breaks the window with her body as she leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_48","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_05_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_49","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_drake_05_49","text":"Security for the event was lax because it's been around for such a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_50","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_drake_05_50","text":"Those two took advantage of that, but you put a stop to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_51","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_drake_05_51","text":"Simply amazing. How did you find them out? Tell me everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_52","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_05_52","text":"Well, it was...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_05_53","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_drake_05_53","text":"Yes...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt"