{"id":"d_main_08_01","cat":"main","group":{"id":"ch8","label":"Chapter 8 · Conflict"},"label":"Two Spies?","stage":"8-1 STAGE · Start","prev":null,"next":"d_main_08_02","speakers":{"shifty":"Shifty","anis":"Anis","neon":"Neon","Narration":"Narration"},"icons":{"shifty":"si_c907_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_08_01_1","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_1","text":"Hello! Did you enjoy your vacation?","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":"bgm_theruinedcity","movie":null,"shown":["rapi","anis","neon","shifty"],"affinity":null},{"id":"d_main_08_01_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_2","text":"Shifty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_3","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_3","text":"Haha, it's been a hot minute, hasn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_4","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_4","text":"I applied to be the exclusive operator for Counters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_5","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_5","text":"There weren't many applicants, so here I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_6","text":"So will you be working with us from now on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_7","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_7","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_8","text":"Nice!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_9","text":"Although, isn't it a bit overkill having two spies in one squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_10","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_08_01_10","text":"Huh? What do you mean two?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_11","text":"You and Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_08_01_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_08_01_13","text":"Oh yeah, I totally forgot about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_08_01_14","text":"I was a spy for Ingrid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_15","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_15","text":"Erm... Anis, I'm not sure if joking about being a spy is really appropriate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_16","text":"What makes you think I'm joking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_17","text":"Hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_18","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_19","text":"Lighten up, will ya?! Of course, I'm only joking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_20","text":"You're starting to make me wonder if you really are a spy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_21","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_21","text":"Wha... I was just taken aback, that's all! Hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_22","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_22","text":"So, where are you guys headed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_23","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_23","text":"Since you all become a Special Commando unit, there's been no official information coming in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_24","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_24","text":"I know it's a bit cumbersome, but I'll need to ask for each mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_25","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_25","text":"Of course, it would be more convenient if you tell me first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_26","text":"We're just going out for a nice stroll.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_27","text":"It's been a month since we were up on the surface. We were starting to get withdrawals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_28","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_28","text":"... Ah ha... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_29","text":"We're on our way back now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_30","text":"Get a whiff of that fresh air! You won't find that underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_31","text":"Being a Special Commando rules! We can go right up to the surface without asking for permission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_32","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_33","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_33","text":"I see. Is it all right with you then if I end my shift and take off?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_34","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_34","text":"To be honest, I really want to catch a special episode of Ark Rangers that's airing tonight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_35","text":"Oh, really? Can you please record it for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_36","text":"I love that show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_37","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_37","text":"Sure thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_38","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_08_01_38","text":"Well, I'll be off then. I'll be in touch next time you all venture outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_08_01_39","text":"Sounds good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_40","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_08_01_40","text":"*Click*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_41","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_08_01_41","text":"Hey...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_42","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_08_01_42","text":"Anis raises her finger and puts it up to her lips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_43","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_08_01_43","text":"With her other hand, she points off towards the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_08_01_44","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_08_01_44","text":"She seems to be saying it'd be best to move without making any sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}