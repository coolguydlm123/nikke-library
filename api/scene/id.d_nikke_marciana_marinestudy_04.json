keEpisode:d_nikke_marciana_marinestudy_04_73","text":"That's all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_74","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_74","text":"You've already done more than enough by helping me understand how I truly feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_75","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_75","text":"I'll take it from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_76","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_76","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_77","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_77","text":"It seems you've already made up your mind. We'd only be overstepping if we got involved any further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_78","type":"Speech","speaker":"tia_l","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_78","text":"Still, it'd be nice if we could help somehow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_79","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_79","tex