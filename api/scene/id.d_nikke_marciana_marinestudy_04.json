ull},{"id":"d_nikke_marciana_marinestudy_04_37","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_37","text":"H-how'd you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_38","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_38","text":"Just as I thought...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_39","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_39","text":"So it was the two of you who arranged for the Commander and me to be alone today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_40","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_41","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_41","text":"We were pretty sure you had feelings for Teacher,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_42","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_42","text":"but you were the only one who didn't seem to realize it, and it was hard to watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_43","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_43","text":"We're truly sorry for taking it upon ourselves to push the two of you together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_44","type":"Speech","speaker":"tia_l","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_44","text":"We thought that if you two were alone together, you might figure out your feelings...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_45","type":"Speech","speaker":"tia_l","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_45","text":"We're sorry...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_46","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_46","text":"Naga and Tia lower their heads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_47","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_47","text":"Why are you apologizing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_48","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_48","text":"You were both only trying to help me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_49","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_49","text":"I thought you were going to scold us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_50","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_50","text":"What kind of teacher would I be if I scolded students who care about me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_51","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_51","text":"If anything, I should be thanking you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_52","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_52","text":"Naga and Tia stand frozen, dumbfounded by Marciana's unexpected reaction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_53","type":"Speech","speaker":"naga_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_53","text":"B-but Miss Marciana, when did you realize you had feelings for him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_54","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_54","text":"On the way back, I found myself reflecting on the difference","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_55","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_55","text":"between the unease I felt yesterday and the warmth I felt today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_56","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_56","text":"Yesterday, seeing how kind he was to everyone else left my heart feeling unbearably heavy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_57","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_57","text":"So why was it that being alone with him filled me with such warmth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_58","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_58","text":"If one of my students had come to me with the very same concern, what advice would I have given them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_59","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_59","text":"Once I looked at it that way, the answer became clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_marciana_marinestudy_04_60","type":"Speech","speaker":"marciana_s","key":"Locale_NikkeEpisode:d_nikke_marciana_marinestudy_04_60","text":"I have feelings for the Commander all along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null