{"id":"d_main_01af_04","cat":"main","group":{"id":"ch1","label":"Chapter 1 · Corruption"},"label":"The Trial","stage":null,"prev":"d_main_01af_03","next":"d_main_01af_05","speakers":{"anis":"Anis","rapi":"Rapi","Self":"Commander","andersen":"Andersen","ingrid":"Ingrid","shifty":"Shifty"},"icons":{"anis":"si_c012_00_s","rapi":"si_c010_00_s","andersen":"si_c903_00_s","ingrid":"si_c900_00_s","shifty":"si_c907_00_s"},"lines":[{"id":"d_main_01af_04_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_1","text":"Argh, so tired.","jump":null,"exit":false,"enter":null,"bg":"SimulationRoom","bgArt":"simulationroom","image":null,"bgm":"bgm_inark","movie":null,"shown":["rapi","anis"],"affinity":null},{"id":"d_main_01af_04_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_2","text":"The operation results have already been reported. She told us to wait here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_4","text":"Rapi, what do you think this is all about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_5","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_5","text":"Just like she said, it's a test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_6","text":"Apparently, our performance was good enough to arouse suspicion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_7","text":"You do poorly, they give you a hard time. You do well, same thing. You can't win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_8","text":"Commander, do you know anything about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_9","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01af_04_9","text":"I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_10","text":"Well, it's not like it's a bad thing... Doing our part for the cause and all that jazz.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_11","text":"I suppose so. So what now, do we just wait?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_12","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_04_12","text":"Well? How'd it go?","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["ingrid","andersen"],"affinity":null},{"id":"d_main_01af_04_13","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_04_13","text":"I can't believe it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_14","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_04_14","text":"... Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_15","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_04_15","text":"A complete and utter disaster.\nIf they were really out on the field, they'd all have been killed in less than 3 minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_16","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_04_16","text":"Oh? Most unexpected indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_17","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_04_17","text":"That's putting it lightly.\nCould it be that they only excel in actual combat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_18","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_04_18","text":"Only one way to find out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_19","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_04_19","text":"We have plenty of missions to send them on.\nTake your pick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_20","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_04_20","text":"Whichever is most difficult.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_21","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_04_21","text":"So...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_22","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_04_22","text":"This one should do the trick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_23","text":"Investigate a power station? The one in the coastal city?","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":"bgm_inark","movie":null,"shown":["rapi","anis"],"affinity":null},{"id":"d_main_01af_04_24","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_24","text":"... Is this the entire team?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_25","text":"I can't believe this!\nWe go through hell for them, and we're sent straight back out without a word of thanks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_26","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01af_04_26","text":"This is an order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_27","text":"Yeah, yeah. What a good little doggie you are. Gotta please your master, am I right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_28","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_30","text":"Sorry... that was out of line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_31","text":"Who's the assigned Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_32","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01af_04_32","text":"Me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_33","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_33","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_34","text":"This is... most unusual.\nWhat are they up to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_35","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01af_04_35","text":"Is there something wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_36","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_36","text":"They never assign the same Commander to a Nikke squad multiple times in a row.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_37","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_37","text":"Otherwise, things tend to go south.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_38","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_38","text":"It usually results in infighting, and the team eventually falls apart. That's why they've enforced this rule for so long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_39","text":"You end up with Commanders executing Nikkes on the spot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_40","text":"Sometimes, even the other way around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_41","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_41","text":"It's precisely to avoid these kinds of catastrophes","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_42","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_42","text":"that a Commander and any given Nikke squad can only cooperate once every three missions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_43","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_43","text":"So this is truly bizarre.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_44","text":"They're trying to get rid of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_45","text":"They want to send us up to the surface and have us all killed without anyone noticing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_46","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_04_46","text":"But... what reason could they possibly have for doing that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_01af_04_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_47","text":"Gah! You scared me! Where did you come from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_48","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_04_48","text":"I heard there's a new mission, so I came to assist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_49","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_04_49","text":"If they wanted you dead, you'd be dead already. They wouldn't bother with sending you back up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_50","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_04_50","text":"In other words, this is a normal operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_51","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_51","text":"Normal as can be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_52","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_52","text":"If it's an order, I'll follow it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_53","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_53","text":"But, Commander, are you okay with all this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_54","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_01af_04_54","text":"I won't shoot you.","jump":"d_main_01af_04_56","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_55","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_01af_04_55","text":"I believe in you all.","jump":"d_main_01af_04_58","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_56","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_56","text":"Same here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_57","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_57","text":"Well, for now, at least.","jump":"d_main_01af_04_61","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_58","text":"Hey now! Where'd all that confidence come from all of a sudden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_59","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_59","text":"Well, we trust you, too, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_60","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_04_60","text":"For the time being, that is.","jump":"d_main_01af_04_61","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_04_61","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_04_61","text":"Let's head up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}