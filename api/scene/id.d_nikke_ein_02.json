_02_15","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ein_02_15","text":"No, you weren't out of line, so don't worry.","jump":"d_nikke_ein_02_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ein_02_16","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ein_02_16","text":"You weren't out of line, but...","jump":"d_nikke_ein_02_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ein_02_17","type":"Speech","speaker":"ein","key":"Locale_NikkeEpisode:d_nikke_ein_02_17","text":"I knew I wasn't the problem!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ein_02_18","type":"Speech","speaker":"ein","key":"Locale_NikkeEpisode:d_nikke_ein_02_18","text":"I knew you'd get it, Teacher.","jump":"d_nikke_ein_02_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ein_02_19","type":"Speech","speaker":"ein","key":"Locale_NikkeEpisode:d_nikke_ein_02_19","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ein_02_20","type":"Speech","speaker":"ein","key":"Locale_NikkeEpisode:d_nikke_ein_02_20","text":"Why are you being so evasive?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ein_02_21","type":"Speech","speaker":"ein","key":"Locale_NikkeEpisode:d_nikke_ein_02_21","text":"If you have something to say, just say it.","jump":"d_nikke_ein_02_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ein_02_22","type":"Speech","speaker":