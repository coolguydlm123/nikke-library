{"id":"d_counseling_marian_p_04","cat":"counsel","group":{"id":"char5044","label":"Modernia"},"label":"Advising Modernia: 04","stage":null,"prev":"d_counseling_marian_p_03","next":"d_counseling_marian_p_05","speakers":{"marian_p":"Marian"},"icons":{"marian_p":"si_c260_00_s"},"lines":[{"id":"d_counseling_marian_p_04_1","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_1","text":"Commander. I will protect you.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["marian_p"],"affinity":"_0"},{"id":"d_counseling_marian_p_04_2","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_2","text":"I won't fail you this time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_3","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_3","text":"Huh? ... Why did I say \"this time\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_4","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_4","text":"Did I... fail to protect you before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marian_p_04_5","text":"No. You've always protected me.","jump":"d_counseling_marian_p_04_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_marian_p_04_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marian_p_04_6","text":"This time, I'll protect you.","jump":"d_counseling_marian_p_04_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_marian_p_04_7","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_7","text":"Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_8","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_8","text":"What's that sad look on your face?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_9","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_9","text":"Don't do that. You'll make me sad, too.","jump":"d_counseling_marian_p_04_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_10","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_10","text":"What? No! I should be the one who protects you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_11","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_11","text":"Oh! That's it! We can protect each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_12","type":"Speech","speaker":"marian_p","key":"Locale_Counseling:d_counseling_marian_p_04_12","text":"How about it? I think it'll work out great!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_p_04_