{"id":"memorial_104003","cat":"memorial","group":{"id":"memorial104000","label":"Memoirs · Diary of Despair"},"label":"The Bad Guys","stage":null,"prev":"memorial_104002","next":"memorial_104004","speakers":{},"icons":{},"lines":[{"id":"memorial_104003_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_40_03_description","text":"A friend of mine got badly hurt."},{"id":"memorial_104003_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_40_03_description","text":"All we did was go over to say hello, and we ended up getting beat up as a result."},{"id":"memorial_104003_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_40_03_description","text":"They called us defective products. Said we were fakes."},{"id":"memorial_104003_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_40_03_description","text":"The other two didn't say anything in our defense."},{"id":"memorial_104003_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_40_03_description","text":"I didn't speak up either."},{"id":"memorial_104003_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_40_03_description","text":"My friend cried, but the pain wasn't physical."},{"id":"memorial_104003_7","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_40_03_description","text":"I'm so angry, I can't sleep."}]}