{"id":"d_counseling_centi_08","cat":"counsel","group":{"id":"char5021","label":"Centi"},"label":"Advising Centi: 08","stage":null,"prev":"d_counseling_centi_07","next":"d_counseling_centi_09","speakers":{"centi":"Centi"},"icons":{"centi":"si_c080_00_s"},"lines":[{"id":"d_counseling_centi_08_1","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_1","text":"I freaking love vehicles!\n I wanna get one!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["centi"],"affinity":"_0"},{"id":"d_counseling_centi_08_2","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_2","text":"I just can't decide between a motorcycle or a truck!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_3","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_3","text":"Can you pick one for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_centi_08_4","text":"A truck!","jump":"d_counseling_centi_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_centi_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_centi_08_5","text":"A motorcycle!","jump":"d_counseling_centi_08_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_centi_08_6","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_6","text":"Yeah, Boss! I think you've got the right idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_7","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_7","text":"Just think of all the stuff I could fit in there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_8","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_8","text":"I wonder why some people just don't seem to appreciate trucks!","jump":"d_counseling_centi_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_9","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_9","text":"Really? Come to think of it, motorcycles can't carry very many tools!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_10","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_10","text":"I couldn't take Liter with me, either!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_11","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_08_11","text":"So, no motorcycles for me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_08_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_centi_08_12","text":"I talk about driving routes with Centi.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}