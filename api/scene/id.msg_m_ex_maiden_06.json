{"id":"msg_m_ex_maiden_06","cat":"messenger","group":{"id":"room_maiden","label":"Maiden · Nikke"},"label":"6. Commander,","stage":null,"prev":"msg_m_ex_maiden_05","next":null,"speakers":{"maiden":"Maiden"},"icons":{"maiden":"si_c181_00_s"},"lines":[{"id":"m_ex_maiden_06_1","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_1","text":"Commander,","jump":null},{"id":"m_ex_maiden_06_2","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_2","text":"I...","jump":null},{"id":"m_ex_maiden_06_3","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_3","text":"Um...","jump":null},{"id":"m_ex_maiden_06_4","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_4","text":"...","jump":null},{"id":"m_ex_maiden_06_5","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_5","text":"Ugh,","jump":null},{"id":"m_ex_maiden_06_6","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_6","text":"I can't say it.","jump":null},{"id":"m_ex_maiden_06_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_7","text":"What is it?","jump":"m_ex_maiden_06_9"},{"id":"m_ex_maiden_06_8","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_8","text":"You don't have to force yourself to say anything.","jump":"m_ex_maiden_06_10"},{"id":"m_ex_maiden_06_9","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_9","text":"Well...","jump":"m_ex_maiden_06_11"},{"id":"m_ex_maiden_06_10","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_10","text":"!!","jump":"m_ex_maiden_06_11"},{"id":"m_ex_maiden_06_11","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_11","text":"I think there's something wrong with my heart.","jump":null},{"id":"m_ex_maiden_06_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_12","text":"Are you all right?","jump":null},{"id":"m_ex_maiden_06_13","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_13","text":"My heart keeps pounding constantly.","jump":null},{"id":"m_ex_maiden_06_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_14","text":"We better call Mary.","jump":"m_ex_maiden_06_16"},{"id":"m_ex_maiden_06_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_15","text":"We better call Guillotine.","jump":"m_ex_maiden_06_18"},{"id":"m_ex_maiden_06_16","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_16","text":"I'd rather not.","jump":null},{"id":"m_ex_maiden_06_17","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_17","text":"She'd just jab me with a needle.","jump":"m_ex_maiden_06_19"},{"id":"m_ex_maiden_06_18","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_18","text":"If we do that, I think my symptoms might get worse.","jump":"m_ex_maiden_06_19"},{"id":"m_ex_maiden_06_19","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_19","text":"What should I do?","jump":null},{"id":"m_ex_maiden_06_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_20","text":"When do the symptoms tend to appear?","jump":null},{"id":"m_ex_maiden_06_21","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_21","text":"Um...","jump":null},{"id":"m_ex_maiden_06_22","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_22","text":"Whenever I think of a certain someone,","jump":null},{"id":"m_ex_maiden_06_23","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_23","text":"my heart starts racing, and won't let up.","jump":null},{"id":"m_ex_maiden_06_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_24","text":"And who is this \"certain someone\"?","jump":null},{"id":"m_ex_maiden_06_25","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_25","text":"He has a small scar on his right collarbone that almost resembles a medal.","jump":null},{"id":"m_ex_maiden_06_26","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_26","text":"His forearms are as solid as the grip of a sniper rifle,","jump":null},{"id":"m_ex_maiden_06_27","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_27","text":"and he's got a perfectly chiseled six-pack.","jump":null},{"id":"m_ex_maiden_06_28","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_28","text":"And...","jump":null},{"id":"m_ex_maiden_06_29","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_29","text":"he has three moles on his pelvis!","jump":null},{"id":"m_ex_maiden_06_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_30","text":"Hold on...","jump":null},{"id":"m_ex_maiden_06_31","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_31","text":"It's whenever I think of you, Commander.","jump":null},{"id":"m_ex_maiden_06_32","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_32","text":"That's when my heart starts to beat out of control.","jump":null},{"id":"m_ex_maiden_06_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_33","text":"How did you know about those moles of mine?","jump":null},{"id":"m_ex_maiden_06_34","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_34","text":"Don't tell me you forgot?","jump":null},{"id":"m_ex_maiden_06_35","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_35","text":"A few days ago,","jump":null},{"id":"m_ex_maiden_06_36","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_36","text":"we were hanging out","jump":null},{"id":"m_ex_maiden_06_37","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_37","text":"in your room late at night.","jump":null},{"id":"m_ex_maiden_06_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_38","text":"All we did was playing video games together...","jump":null},{"id":"m_ex_maiden_06_39","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_39","text":"You ended up falling asleep in your uniform,","jump":null},{"id":"m_ex_maiden_06_40","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_40","text":"so I had no choice but to change you into your pajamas.","jump":null},{"id":"m_ex_maiden_06_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_41","text":"You \"had to\"?","jump":null},{"id":"m_ex_maiden_06_42","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_42","text":"I couldn't let your precious uniform get wrinkled.","jump":null},{"id":"m_ex_maiden_06_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_43","text":"Wait...","jump":null},{"id":"m_ex_maiden_06_44","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_44","text":"You don't need to thank me.","jump":null},{"id":"m_ex_maiden_06_45","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_45","text":"I got to see a lot of amazing things that day.","jump":null},{"id":"m_ex_maiden_06_46","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_46","text":"Even now,","jump":null},{"id":"m_ex_maiden_06_47","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_47","text":"just thinking about it sends my heart into a tailspin.","jump":null},{"id":"m_ex_maiden_06_48","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_48","text":"That's it!","jump":null},{"id":"m_ex_maiden_06_49","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_49","text":"I need to go see Mary.","jump":null},{"id":"m_ex_maiden_06_50","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_maiden_06_50","text":"I'll see you later, Commander.","jump":null},{"id":"m_ex_maiden_06_51","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_51","text":"Maiden, waaaait!","jump":null},{"id":"m_ex_maiden_06_52","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_maiden_06_52","text":"There is no response from Maiden.","jump":null}],"chat":true}