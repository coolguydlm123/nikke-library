{"id":"d_counseling_nayuta_09","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 09","stage":null,"prev":"d_counseling_nayuta_08","next":"d_counseling_nayuta_10","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_09_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_1","text":"Pray tell, Great Hero, in all matters concerning the fairer sex,","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_09_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_2","text":"doth thy fancy lean unto the larger, or the smaller?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_09_3","text":"Smaller.","jump":"d_counseling_nayuta_09_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_09_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_09_4","text":"Bigger.","jump":"d_counseling_nayuta_09_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_09_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_5","text":"Most unexpected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_6","text":"I hadst surmised thy preference wouldst lean toward women of greater stature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_7","text":"Ah, but indeed, thou art of considerable height; 'tis only natural thou art drawn to one of petite frame, one who may repose within thine embrace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_8","text":"'Tis clear to me at last.","jump":"d_counseling_nayuta_09_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_9","text":"Foreseen have I thy reply.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_10","text":"Thou art of lofty stature;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_11","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_11","text":"certain was I that thou wouldst favor a lady of like height.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_12","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_12","text":"Sound is my reasoning; wouldst thou not agree therewith?","jump":"d_counseling_nayuta_09_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_13","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_09_13","text":"Oh, you meant height...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_14","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_14","text":"Hmm? So it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_15","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_09_15","text":"Didst thou perchance think my meaning referred not to height, but to aught else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_09_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_09_16","text":"I offer no answer and make a swift exit.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}