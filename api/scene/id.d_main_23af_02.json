mp":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_7","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_7","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_8","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_8","text":"No, it can't be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_9","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_9","text":"People killed by Raptures... in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_10","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_11","type":"Speech","speaker":"syuen_op_l","key":"Locale_MainScenario:d_main_23af_02_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["syuen_op_l"],"affinity":null},{"id":"d_main_23af_02_12","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_12","text":"The injured are being rushed to Missilis's medical center using AZX.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"d_main_23af_02_13","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_13","text":"The medical staff that were stationed at the shelter are coming too. I think we've staunched the bleeding as far as that's concerned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_14","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_14","text":"Why were the shelters opened in the first place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_15","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_15","text":"Someone showed up on Tetra's live broadcast,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_16","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_16","text":"and présenté false rumors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_17","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_17","text":"People fell into a panique and forcibly opened the shelter doors. Then they proceeded to walk directement into the hordes of Raptures waiting for them downtown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_18","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_18","text":"Enikk had locked the shelter doors to prevent this exact situation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_19","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_19","text":"but the people manually opened them using the emergency override.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_20","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_20","text":"C'est un miracle that only a few shelters saw the broadcast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_21","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_21","text":"False rumors?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_22","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_22","text":"Wh-who did that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_23","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_23","text":"Who would do such a thing?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_24","type":"Speech","speaker":"syuen_op_l","key":"Locale_MainScenario:d_main_23af_02_24","text":"We're looking into it. We've got a recording of their voice, so that should help us track down whoever's responsible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["syuen_op_l"],"affinity":null},{"id":"d_main_23af_02_25","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_25","text":"There have also been reports that the hole in the Ark was the Nikkes' doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"d_main_23af_02_26","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_26","text":"Missilis's Exotic Squad are the primary suspects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_27","type":"Speech","speaker":"syuen_op_l","key":"Locale_MainScenario:d_main_23af_02_27","text":"Hey, loose lips sink ships! Don't fire off accusations when you don't have evidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["syuen_op_l"],"affinity":null},{"id":"d_main_23af_02_28","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_28","text":"I received the data from Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_29","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_29","text":"D-don't Exotics usually deal with the Outer Rim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_30","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_30","text":"Ca-Catch them and question them. \nWe'll find out quickly enough with a brain scan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_31","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_31","text":"I'm afraid that won't be easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"d_main_23af_02_32","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_32","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_33","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_33","text":"We've been unable to track down the Exotic Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_34","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_34","text":"What about Enikk? C-can't she help?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_35","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_35","text":"Enikk is busy keeping an eye on all the Raptures in the Ark. \nShe has no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_36","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_36","text":"There is no room for error.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_37","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_37","text":"She was distracted for only a moment, and that caused her to neglect keeping the locking mechanisms in place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_38","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_38","text":"The result? She lost track of 10 Raptures' movements, and now we have a pile of dead bodies on our hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_39","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_39","text":"We should have allowed her to link with Einkk from the very beginning. Choosing the Counters instead was a mistake...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_40","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_40","text":"Fine. Everyone j-just send out your own squads to hunt down Exotic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_41","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_42","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_43","type":"Speech","speaker":"syuen_op_l","key":"Locale_MainScenario:d_main_23af_02_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["syuen_op_l"],"affinity":null},{"id":"d_main_23af_02_44","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_44","text":"Wh-what's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_45","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_45","text":"The Raptures have spread to nearly every corner of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"d_main_23af_02_46","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_46","text":"The cost to hunt them all down will be astronomical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_47","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_47","text":"The same goes for repairing the hole in the Ark's roof.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_48","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_48","text":"A considerable amount of troops were deployed to escort the AZX as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_49","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_23af_02_49","text":"Not to mention the ones Doban took with him to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_50","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_50","text":"S-so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_51","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_51","text":"I'm saying that we're stretched thin enough as is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_52","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_52","text":"Th-then I'll send out an APB.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_53","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_53","text":"Tetra's communications have l'habitude of being compromised.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_54","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_54","text":"Using the Central Government line would be préférable,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_55","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_55","text":"but sending out an APB for Nikkes at a time like this","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_56","type":"Speech","speaker":"mustang_op_r","key":"Locale_MainScenario:d_main_23af_02_56","text":"would only create greater turmoil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_57","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_57","text":"Fine then!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_58","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_58","text":"Wh-what the hell do you suggest, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_59","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_23af_02_59","text":"Syuen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_02_60","type":"Speech","speaker":"