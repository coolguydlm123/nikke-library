rio:d_main_21_07_e_20","text":"Johan, can you tell us how to load it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_21","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_07_e_21","text":"Okay. I'll teach you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_22","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_22","text":"And me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_23","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_07_e_23","text":"You rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_24","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_07_e_24","text":"There's not much to loading these cannons. As long as you're strong enough, you're golden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_25","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_21_07_e_25","text":"You stay here and take it easy until the battle kicks off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_07_e_26","text":"I'll be back. You take a rest, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_27","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_27","text":"All right, I'll let you guys handle this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_28","type":"Monologue","speaker":"Monologue","key":"Locale_MainScenario:d_main_21_07_e_28","text":"Johan, Rapi, Anis, Neon, and Noah all head to the cannons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_29","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_30","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_30","text":"Are you alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_c"],"affinity":null},{"id":"d_main_21_07_e_31","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_31","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_32","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_32","text":"Now, where were we...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_33","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_33","text":"Ah yes, the NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_34","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_34","text":"Why is the NIMPH so dangerous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_35","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_35","text":"Honestly, it's like you don't know anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_36","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_36","text":"Humans are utterly clueless when it comes to the NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_37","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_37","text":"I'm not sure I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_38","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_38","text":"NIMPH can control information and memory,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_39","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_39","text":"but it's highly unstable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_40","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_40","text":"Despite this, NIMPH is injected into you when you're still human, and it proceeds to make a copy of all the memories stored in your brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_41","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_41","text":"That information is processed, after which you're made into a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_42","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_42","text":"Most Nikkes lose all of the memories they had when they were human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_43","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_43","text":"Instead, they're replaced with information that's pre-entered before the NIMPH is injected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_44","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_44","text":"However, there are cases where Nikkes have retained certain habits, traits, and preferences.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_45","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_45","text":"There have also been instances where they have retained certain select memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_46","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_46","text":"What they remember can range from a single moment, to a span of years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_47","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_47","text":"It's exceedingly rare, but there have even been cases where Nikkes retain their memory in its entirety.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_48","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_48","text":"In short, how much a Nikke remembers varies wildly depending on the individual. You've witnessed this yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_49","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_49","text":"Could it be because certain memories leave stronger impressions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_50","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_50","text":"We already know that the NIMPH is unstable. It's been well-proven.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_51","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_51","text":"The code pertaining to behavior which the NIMPH implants into a Nikkes brain is its own entity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_52","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_52","text":"The prime directive in this code dictates that Nikkes cannot harm a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_53","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_53","text":"You've seen for yourself how inconsistent that directive is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_54","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_54","text":"... Come to think of it, nearly every Nikke I've known has been different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_55","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_55","text":"Exactly. Some can't lay a finger on a human,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_56","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_56","text":"whereas others can go as far as firing suppression bullets at them. Of course, none of them can kill a human outright, but nevertheless,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_57","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_57","text":"there's a wide range according to each individual Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_58","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_58","text":"While it's impossible to say whether its intentions are malicious or benevolent, the NIMPH can apparently, to a large degree, be \"overridden\" by each Nikke's individual personality traits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_59","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_59","text":"The input is the same every time, but the output is wildly inconsistent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_60","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_60","text":"This is just about the furthest thing from being considered stable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_61","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_61","text":"To say it serves no useful function whatsoever isn't far off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_62","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_62","text":"The basic function of the NIMPH is to erase memories, memorize new ones, and implant comportment parameters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_63","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_63","text":"Out of all those things, does it do a single one properly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_64","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_64","text":"But there is a case where it succeeded in leaving certain memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_65","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_65","text":"That was one case, out of how many?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_66","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_66","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_67","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_67","text":"It's too unstable. It's far too random.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_68","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_68","text":"I thought using it was de rigueur.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_69","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_69","text":"Let's use a bicycle as an example.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_70","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_70","text":"Say I want to change to a wider tire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_71","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_71","text":"I remove the original tire and swap it out for a wider one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_72","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_72","text":"If I want the light on the front to be brighter,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_73","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_73","text":"I can put in another bulb, or some new batteries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_74","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_74","text":"I can change all of those things, because I know how they work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_75","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_75","text":"But the funny thing is, if the seat is broken,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_76","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_76","text":"I can't fix it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_77","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_77","text":"I know what a bicycle is, but I don't know how every single component works. Only some.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_78","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_78","text":"That means I can make some alterations, but there are still parts that I can't touch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_79","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_79","text":"Naturally, making a new seat from scratch is out of the question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_80","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_80","text":"That's what NIMPH is like for humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_81","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_81","text":"How come no one understands its structure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_82","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_82","text":"We just don't, that's why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_83","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_83","text":"We don't know what it is, where it came from, who made it, how the inner workings function, or what kind of side effects it may or may not have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_84","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_84","text":"No one knows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_85","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_86","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_86","text":"Back to the bike analogy. I can copy and paste certain fix-it methods from other bikes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_87","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_87","text":"I can make small modifications.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_88","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_88","text":"But anything beyond that, and I'm out of my depth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_89","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_89","text":"That's what mankind is doing with the NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_90","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_90","text":"And it's in every Nikke's brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_91","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_92","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_92","text":"Now you see why I say NIMPH is so dangerous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_93","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_93","text":"It's like a ticking time bomb implanted in our brains that could go off at any moment,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_94","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_94","text":"yet humans continue to use it simply because it's \"convenient\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_95","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_95","text":"It may be more convenient, but there's potentially a terrible price to pay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_96","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_96","text":"So I don't disagree with what you are doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_97","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_97","text":"And neither does Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_98","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_07_e_98","text":"He doesn't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_07_e_99","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_21_07_e_99","text":"He's not against it. It's just that he has other priorities higher on his list.","jump":null,"exit":false,"enter":nul