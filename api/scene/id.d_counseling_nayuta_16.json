{"id":"d_counseling_nayuta_16","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 16","stage":null,"prev":"d_counseling_nayuta_15","next":"d_counseling_nayuta_17","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_16_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_1","text":"'Tis a rice cake I did receive from White Snow.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_16_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_2","text":"Dost thou wish to taste it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_16_3","text":"Ask what the rice cake is made of.","jump":"d_counseling_nayuta_16_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_16_4","text":"Refuse outright.","jump":"d_counseling_nayuta_16_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_16_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_5","text":"What spake she... I shall strive to recall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_6","text":"A pork-flavored... scorpion, I trow?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_7","text":"Or perchance a chicken-flavored... spider?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_8","text":"Ha, I cannot with certainty recollect the particulars thereof, but 'twas of such sort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_9","text":"Fret not, it shall not prove fatal.","jump":"d_counseling_nayuta_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_10","text":"She did labor most diligently to craft it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_11","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_16_11","text":"and to refuse would be a discourtesy, verily.","jump":"d_counseling_nayuta_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_16_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_16_12","text":"Nayuta seems a little disappointed when I refuse the rice cake.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}