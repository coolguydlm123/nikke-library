_puregrace_04_4","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_5","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_6","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_7","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_7","text":"What happened to the Nikke that we ran into?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_8","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_8","text":"Sedatives and sleeping pills had no effect on her,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_9","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_9","text":"so we had to restrain her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_10","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_10","text":"What's most important is the testimony from the other Nikkes who were nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_11","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_11","text":"She apparently helped the Raptures and attacked other Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_12","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_12","text":"What in the world is going on here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_13","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_13","text":"Until recently, this corruption seemed to only cloud their thoughts,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_14","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_14","text":"but now it seems to make them go full turncoat and side with the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_15","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_15","text":"Seems like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_16","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_16","text":"One thing is for certain, we'll keep encountering corruption-inducing entities in the future,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_17","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_17","text":"and, inevitably, more Nikkes will end up affected by corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_18","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_18","text":"So we need to decide","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_19","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_19","text":"what is going to be our procedure for handling Nikkes who attack their own kind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_20","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_21","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_22","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_23","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_23","text":"Hmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_24","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_24","text":"We don't have all the details yet, so it might be too soon for us to make a judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_25","type":"Speech","speaker":"liliweiss","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_25","text":"You'll have to decide, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_26","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_26","text":"Hmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_27","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_27","text":"They can't communicate, they attack other Nikkes, and they help the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_28","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_28","text":"Essentially, they're just Raptures themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_29","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_29","text":"We may be left with no choice but to shoot them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_30","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_30","text":"... You're right. Trying to find alternative measures may only result in more casualties like today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_31","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_31","text":"But... isn't there some other way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_32","type":"Speech","speaker":"snowwhite_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_32","text":"Shooting them on sight feels a bit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_33","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_33","text":"I'm with Snow White. These people used to be our comrades, who fought alongside us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_34","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_34","text":"Declaring them our enemy and attacking them right away seems a bit harsh, doesn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_35","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_35","text":"If you have any suggestions, we'd love to hear them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_36","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_36","text":"We can restrain them like we did today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_37","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_37","text":"Hmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_38","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_39","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_39","text":"I'll be going now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_40","type":"Speech","speaker":"commander","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_40","text":"Huh? Where to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapunzel_puregrace_04_41","type":"Speech","speaker":"rapunzel_o","key":"Locale_NikkeEpisode:d_nikke_rapunzel_puregrace_04_41","text":"The research lab.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown"