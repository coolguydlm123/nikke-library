:"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_01_e_75","text":"Good job out there, Chisato. You can really run.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_76","type":"Speech","speaker":"ce008_01","key":"Locale_SubScenario:event_ce008_2_01_e_76","text":"Phew... Being popular is tiring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_77","type":"Speech","speaker":"frima","key":"Locale_SubScenario:event_ce008_2_01_e_77","text":"Any. Leads?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_78","type":"Speech","speaker":"ce008_01","key":"Locale_SubScenario:event_ce008_2_01_e_78","text":"Hmm. Everyone looks like they're having fun,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_79","type":"Speech","speaker":"ce008_01","key":"Locale_SubScenario:event_ce008_2_01_e_79","text":"but... a lot of the kids have scars on their hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_80","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_01_e_80","text":"Yeah, we saw that too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_81","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_01_e_81","text":"One of them said he got them while playing with his friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_82","type":"Speech","speaker":"ce008_01","key":"Locale_SubScenario:event_ce008_2_01_e_82","text":"They all have marks in the same place, though. And they're not just ordinary scrapes, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_83","type":"Speech","speaker":"frima","key":"Locale_SubScenario:event_ce008_2_01_e_83","text":"Meaning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_84","type":"Speech","speaker":"ce008_01","key":"Locale_SubScenario:event_ce008_2_01_e_84","text":"I've seen marks like that a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_85","type":"Speech","speaker":"ce008_01","key":"Locale_SubScenario:event_ce008_2_01_e_85","text":"They're the kinds of calluses and blisters you see on people who handle guns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_01_e_86","type":"Speech","speaker":"frima","key":"Locale_SubScenario:event_ce008_2_01_e_86","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}