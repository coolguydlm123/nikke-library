{"id":"d_counseling_pepper_01","cat":"counsel","group":{"id":"char5027","label":"Pepper"},"label":"Advising Pepper: 01","stage":null,"prev":null,"next":"d_counseling_pepper_02","speakers":{"pepper":"Pepper"},"icons":{"pepper":"si_c131_00_s"},"lines":[{"id":"d_counseling_pepper_01_1","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_1","text":"It's very gloomy in the hospital these days. It feels like everyone is down in the dumps.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["pepper"],"affinity":"_0"},{"id":"d_counseling_pepper_01_2","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_2","text":"I feel depressed as well. I can't shake the feeling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_3","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_3","text":"What can I do to change the atmosphere?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_pepper_01_4","text":"You should dance to cheer them up.","jump":"d_counseling_pepper_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_pepper_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_pepper_01_5","text":"Change your gloomy hospital lights for brighter ones.","jump":"d_counseling_pepper_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_pepper_01_6","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_6","text":"A cheer-up dance?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_7","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_7","text":"H-how does that dance go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_8","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_8","text":"Uh... No, I won't learn it. I will never dance.","jump":"d_counseling_pepper_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_9","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_9","text":"The lights?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_10","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_10","text":"Huh, come to think of it, it looks like the lighting has become dimmer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_11","type":"Speech","speaker":"pepper","key":"Locale_Counseling:d_counseling_pepper_01_11","text":"I'll change it immediately!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_pepper_01_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_pepper_01_12","text":"I help Pepper out with the atmosphere at the hospital.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}