{"id":"msg_m_ex_all_06","cat":"messenger","group":{"id":"room_ex_all","label":"Outpost Group Chat · Group"},"label":"6. Man,","stage":null,"prev":"msg_m_ex_all_05","next":"msg_m_ex_all_07","speakers":{"biscuit":"Biscuit","poli":"Poli","jackal":"Jackal"},"icons":{"biscuit":"si_c381_00_s","poli":"si_c030_00_s","jackal":"si_c111_00_s"},"lines":[{"id":"m_ex_all_06_1","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_1","text":"Man,","jump":null},{"id":"m_ex_all_06_2","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_2","text":"the weather is absolutely lovely today.","jump":null},{"id":"m_ex_all_06_3","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_3","text":"Does anyone want to go out on a walk together?","jump":null},{"id":"m_ex_all_06_4","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_4","text":"A walk?","jump":null},{"id":"m_ex_all_06_5","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_5","text":"Where are you going?","jump":null},{"id":"m_ex_all_06_6","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_6","text":"That one place... what's it called again?","jump":null},{"id":"m_ex_all_06_7","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_7","text":"It's got the statue with the wings.","jump":null},{"id":"m_ex_all_06_8","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_06_8","text":"The park with Wings of Victory?","jump":"m_ex_all_06_10"},{"id":"m_ex_all_06_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_06_9","text":"The park with Goddess of Victory?","jump":"m_ex_all_06_12"},{"id":"m_ex_all_06_10","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_10","text":"That's the one.","jump":null},{"id":"m_ex_all_06_11","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_11","text":"You know everything, Trainer!","jump":"m_ex_all_06_16"},{"id":"m_ex_all_06_12","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_12","text":"It's not a goddess statue,","jump":null},{"id":"m_ex_all_06_13","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_13","text":"but it does have these great big wings.","jump":null},{"id":"m_ex_all_06_14","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_14","text":"Are you talking about the Wings of Victory?","jump":null},{"id":"m_ex_all_06_15","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_15","text":"That's it!","jump":"m_ex_all_06_16"},{"id":"m_ex_all_06_16","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_16","text":"I'm gonna round up the troops at the shelter,","jump":null},{"id":"m_ex_all_06_17","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_17","text":"get some exercise, and enjoy some treats.","jump":null},{"id":"m_ex_all_06_18","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_18","text":"Treats?!","jump":null},{"id":"m_ex_all_06_19","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_19","text":"Treats?","jump":null},{"id":"m_ex_all_06_20","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_20","text":"I wanna go too!","jump":null},{"id":"m_ex_all_06_21","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_21","text":"If Jackal's coming,","jump":null},{"id":"m_ex_all_06_22","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_22","text":"then I wanna go.","jump":null},{"id":"m_ex_all_06_23","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_23","text":"Aren't you part of the A/C unit or whatever it's called?","jump":null},{"id":"m_ex_all_06_24","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_24","text":"A.C.P.U.!","jump":null},{"id":"m_ex_all_06_25","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_25","text":"Right.","jump":null},{"id":"m_ex_all_06_26","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_26","text":"In that case, I don't want to go.","jump":null},{"id":"m_ex_all_06_27","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_27","text":"Huh? How come?","jump":null},{"id":"m_ex_all_06_28","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_28","text":"I prepared some really delicious snacks.","jump":null},{"id":"m_ex_all_06_29","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_29","text":"You did?","jump":null},{"id":"m_ex_all_06_30","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_30","text":"... Okay, I'm back in.","jump":null},{"id":"m_ex_all_06_31","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_31","text":"Wow, you were dead set on not going,","jump":null},{"id":"m_ex_all_06_32","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_32","text":"but then some tasty treats won you over again.","jump":null},{"id":"m_ex_all_06_33","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_33","text":"To be fair, I can see where you're coming from.","jump":null},{"id":"m_ex_all_06_34","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_34","text":"I'm just happy that all of you are coming.","jump":null},{"id":"m_ex_all_06_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_06_35","text":"It's gonna be a canine catastrophe.","jump":null},{"id":"m_ex_all_06_36","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_36","text":"!!","jump":null},{"id":"m_ex_all_06_37","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_37","text":"What makes you say that?","jump":null},{"id":"m_ex_all_06_38","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_38","text":"Hehe, you may well be right.","jump":null},{"id":"m_ex_all_06_39","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_39","text":"There are definitely gonna be a lot of dogs.","jump":null},{"id":"m_ex_all_06_40","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_40","text":"Are you coming too, Trainer?","jump":null},{"id":"m_ex_all_06_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_06_41","text":"Me?","jump":null},{"id":"m_ex_all_06_42","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_42","text":"Yeah!","jump":null},{"id":"m_ex_all_06_43","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_all_06_43","text":"Come and play with us!","jump":null},{"id":"m_ex_all_06_44","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_44","text":"It'll be fun!","jump":null},{"id":"m_ex_all_06_45","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_all_06_45","text":"Come on!","jump":null},{"id":"m_ex_all_06_46","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_46","text":"Pleeeaaase?","jump":null},{"id":"m_ex_all_06_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_all_06_47","text":"Okay, let me know when you're here.","jump":null},{"id":"m_ex_all_06_48","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_48","text":"Woohoo!","jump":null},{"id":"m_ex_all_06_49","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_49","text":"See you all later, then!","jump":null},{"id":"m_ex_all_06_50","type":"Speech","speaker":"biscuit","key":"Locale_SuddenMessage:m_ex_all_06_50","text":"U>ᴥ<U","jump":null}],"chat":true}