null,"affinity":null},{"id":"event_staranis2_04_s_33","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_33","text":"If I can't see them, why the hell should I believe in them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_34","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_34","text":"Anis...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_35","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_35","text":"Yeah, no, not happening. I can't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_36","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_36","text":"Pop star? Give me a break. That's way out of my league...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_37","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_37","text":"Anis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_38","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_38","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_39","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":nul