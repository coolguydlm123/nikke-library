ack of trash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_7","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_7","text":"... Riss is gone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_8","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_8","text":"and Boss hasn't shown his face in days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_9","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_9","text":"So what, we just do it anyway? Wait around to get screwed over again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_10","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_11","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_11","text":"What if we can change it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_12","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis2_04_s_12","text":"... Change what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_13","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_13","text":"When you're still unknown, you can disappear at any time. So you have to do whatever it takes just to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_14","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_14","text":"You have to put yourself out there, take every chance you get to win people over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_15","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_15","text":"That's why we ended up in such a vulnerable position.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_16","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_16","text":"Please don't misunderstand. I'm not saying the fans were right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_17","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_17","text":"But if we make it to the mainstream, things will be different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_18","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_18","text":"We'll have people who'll stand up for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_04_s_19","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis2_04_s_19","text":"We won't just have to take it anymore.","jump":null,"exit":false,"enter":nu