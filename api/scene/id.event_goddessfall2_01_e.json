{"id":"event_goddessfall2_01_e","cat":"event","group":{"id":"ev40094","label":"GODDESS FALL · Part 2"},"label":"A Mother's Heart: B","stage":null,"prev":"event_goddessfall2_01_s","next":"event_goddessfall2_02_s","speakers":{"nayuta":"Nayuta","johan":"Johan","harran":"Harran","isabel":"Isabel","mirror_r":"Mirror","janghwa_n":"Rose","chime":"Chime","crown":"Crown","papillon":"Papillon","nayuta_n_03":"Nayuta","nayuta_n_02":"Nayuta","nayuta_n_01":"Nayuta","nayuta_n_04":"Nayuta","nayuta_n_05":"Nayuta","nayuta_n_07":"Nayuta","nayuta_n_06":"Nayuta","cecil_op_r":"Cecil"},"icons":{"nayuta":"si_c223_00_s","johan":"si_c925_00_s","harran":"si_c230_00_s","isabel":"si_c231_00_s","mirror_r":"si_c982_00_s","janghwa_n":"si_c971_01_s","chime":"si_c331_00_s","crown":"si_c330_00_s","papillon":"si_c890_00_s","nayuta_n_03":"si_c9008_00_s","nayuta_n_02":"si_c9008_00_s","nayuta_n_01":"si_c9008_00_s","nayuta_n_04":"si_c9008_00_s","nayuta_n_05":"si_c9008_00_s","nayuta_n_07":"si_c9008_00_s","nayuta_n_06":"si_c9008_00_s","cecil_op_r":"si_c929_00_s"},"lines":[{"id":"event_goddessfall2_01_e_1","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_1","text":"Young Hero, is there aught thou wouldst say?","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLobby","bgArt":"brokenedenlobby","image":null,"bgm":"event_bgm_goddessfall_coldnessandmercy","movie":null,"shown":["nayuta","johan","harran","isabel"],"affinity":null},{"id":"event_goddessfall2_01_e_2","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_2","text":"What nonsense are you spouting?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_3","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_3","text":"I cannot fathom the significance that Young Lady Marian holds for thee, yet a Queen is still a Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_4","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_4","text":"A Queen is not to be forgiven. Eden's warriors shall slay the wicked Queen without fail, or something of the sort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_5","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_01_e_5","text":"What choice do we have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_6","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_6","text":"... None, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_7","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_01_e_7","text":"You see? We've got no choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_8","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_01_e_8","text":"The Queen's right there, a threat plain as day","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_9","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_01_e_9","text":"and casually firing beams from heights most weapons couldn't even dream of reaching.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_10","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_01_e_10","text":"And, for reasons I can't quite figure... Marian sent it right back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_11","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_01_e_11","text":"Not just a little push, she hit with enough force to actually tip the scales of the battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_12","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_01_e_12","text":"... And","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_13","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_01_e_13","text":"if we try to move against Marian, we'll end up fighting both the Pioneers and the Crown Kingdom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_14","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_01_e_14","text":"A fight among ourselves right now could be the end of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_15","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_15","text":"Marian isn't a problem for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_16","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_16","text":"That could change later, but for the moment, she isn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_17","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_17","text":"Therefore, we'll exploit her fully.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_18","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_18","text":"What I want is to reproach Marian for the pathetic weakness that made her conceal her true identity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_19","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_19","text":"Because of it, she arrived late to Eden, and we lost Noah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_20","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_01_e_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_21","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_01_e_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_22","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_22","text":"But I won't speak of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_23","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_23","text":"I can't gauge the depth of her struggles, so I won't speak lightly of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_24","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_25","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_25","text":"Permit me to add but one word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_26","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_26","text":"Go ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_27","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_27","text":"Pray, lend thy strength that we might raise Young Lady Marian to the throne of Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_28","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_29","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_29","text":"Do you believe the world Marian spoke of, one where all will love one another, will ever come?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_30","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_30","text":"... Such a thing shall never come to pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_31","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_32","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_32","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_33","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_33","text":"You're no different from them, Monk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_34","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_34","text":"No, you're worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_35","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_01_e_35","text":"Utter scum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_36","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_36","text":"Did I not say it ere?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_37","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_37","text":"Verily, this humble self shall do whatever is needful to achieve victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_38","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_38","text":"But Eden won't make a move against Marian.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"event_bgm_goddessfall_anothermirror","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_39","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_39","text":"Or rather, it's more accurate to say they simply can't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_40","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_40","text":"... The one we should be watching is Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_41","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_41","text":"It's just a hunch, but I believe she has another agenda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_42","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall2_01_e_42","text":"What other agenda could she have?\nThe two possibilities are either Marian becomes Queen or she gets killed when the Queen Gene is taken from her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_43","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_43","text":"Yes, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_44","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_44","text":"I have a feeling that Nayuta was the one who planted the idea in Marian's head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_45","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_45","text":"Because of that, she arranged some strong protectors for Marian—not just for Marian herself, but for Queen Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_46","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_46","text":"There's no reason for her to be that proactive otherwise...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_47","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall2_01_e_47","text":"Weren't you allies?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_48","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_48","text":"We are, but our ultimate goals differ.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_49","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_49","text":"I require a puppet Queen, whereas Nayuta desires a surface without one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_50","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_50","text":"From Nayuta's perspective, a Queen under my control is still one she can negotiate with, which is why we formed an alliance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_51","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall2_01_e_51","text":"When the time comes, will you agree to Nayuta's terms?","jump":null,"exit":false,"enter":null,"bg":"land_d","bgArt":"land_d","image":null,"bgm":null,"movie":null,"shown":["janghwa_n","mirror_r"],"affinity":null},{"id":"event_goddessfall2_01_e_52","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_52","text":"Of course, there's no reason I wouldn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_53","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall2_01_e_53","text":"Ah, that explains why Nayuta is being so proactive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_54","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_55","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_55","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_56","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_56","text":"Well, we shall see soon enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_57","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_57","text":"But isn't that quite a sight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_58","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_58","text":"All those Nayuta look-alikes assembled just like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_59","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall2_01_e_59","text":"I find it a bit unsettling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_60","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_60","text":"It's effective, that much is certain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_61","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_61","text":"The great and merciful Mother is scared stiff again, merely watching from afar!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_62","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_62","text":"Haha. Honestly,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_63","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall2_01_e_63","text":"it's utterly pathetic.","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLobby","bgArt":"brokenedenlobby","image":null,"bgm":null,"movie":null,"shown":["nayuta","chime","crown"],"affinity":null},{"id":"event_goddessfall2_01_e_64","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_64","text":"Hmm... This doth prove a difficult matter. All the Alva particles I had gathered are now exhausted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_eyes","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_65","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_01_e_65","text":"... Aye, the Naked King may not be used upon this battlefield. A shame it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_66","type":"Speech","speaker":"crown","key":"Locale_MainScenario:event_goddessfall2_01_e_66","text":"It's all right, Chime. I remain strong even without it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_67","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_01_e_67","text":"I know it well, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_68","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_01_e_68","text":"Yet, to think that I might never gaze upon thy majestic presence again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_69","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_69","text":"Verily, all hope is not utterly lost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_70","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_70","text":"For but an instant—an instant most fleeting—I could transmute the Alva particles thus gathered into a heat shockwave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_71","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_71","text":"Yet, I would not counsel such a course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_72","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_72","text":"With but a single motion shall all be spent, the ill effects shall descend upon thee in their full measure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_73","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_01_e_73","text":"... Still, best have it ready, for it may yet serve in times of dire need, so say I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_74","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_01_e_74","text":"Oho! What curious things hast thou found?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_75","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_01_e_75","text":"I should be pleased were this one meant for me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_76","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_76","text":"... Nay, I am no coffer that doth spit forth riches at a mere tap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_77","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_01_e_77","text":"Eh? Was it not thus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_78","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_01_e_78","text":"Nay, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_01_e_79","text":"Papillon leans against the railing, gazing out at the Nayutas that fill the space before Eden.","jump":null,"exit":false,"enter":null,"bg":"BrokenEden","bgArt":"brokeneden","image":null,"bgm":null,"movie":null,"shown":["papillon"],"affinity":null},{"id":"event_goddessfall2_01_e_80","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_81","type":"Speech","speaker":"nayuta_n_03","key":"Locale_MainScenario:event_goddessfall2_01_e_81","text":"Lamentably, I lost 820 of them in the preceding fray.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nayuta_n_01","nayuta_n_02","nayuta_n_03","nayuta_n_04","nayuta_n_05","nayuta_n_06","nayuta_n_07"],"affinity":null},{"id":"event_goddessfall2_01_e_82","type":"Speech","speaker":"nayuta_n_02","key":"Locale_MainScenario:event_goddessfall2_01_e_82","text":"'Twas fewer than I had feared, for which I am relieved...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_83","type":"Speech","speaker":"nayuta_n_01","key":"Locale_MainScenario:event_goddessfall2_01_e_83","text":"Yet 'tis more than I had hoped, a grievous matter indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_84","type":"Speech","speaker":"nayuta_n_04","key":"Locale_MainScenario:event_goddessfall2_01_e_84","text":"Ah! Behold yonder, a butterfly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_85","type":"Speech","speaker":"nayuta_n_05","key":"Locale_MainScenario:event_goddessfall2_01_e_85","text":"Pray, why dost thou make such a loud clamor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_86","type":"Speech","speaker":"nayuta_n_03","key":"Locale_MainScenario:event_goddessfall2_01_e_86","text":"I heard thy auditory sensors suffered ill from thy long sojourn beside a waterfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_87","type":"Speech","speaker":"nayuta_n_03","key":"Locale_MainScenario:event_goddessfall2_01_e_87","text":"Thou seemest skilled with firearms. Pray, are they of any worth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_88","type":"Speech","speaker":"nayuta_n_05","key":"Locale_MainScenario:event_goddessfall2_01_e_88","text":"In the western lake lurks a fearsome beast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_89","type":"Speech","speaker":"nayuta_n_03","key":"Locale_MainScenario:event_goddessfall2_01_e_89","text":"A spear far surpasseth a gun. Take this, and do give it a whirl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_90","type":"Speech","speaker":"nayuta_n_04","key":"Locale_MainScenario:event_goddessfall2_01_e_90","text":"Yet truly, whether spear or gun, explosives reign supreme. Didst thou not witness mine prowess in action?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_91","type":"Speech","speaker":"nayuta_n_07","key":"Locale_MainScenario:event_goddessfall2_01_e_91","text":"Ah, two days without sustenance... mine belly clings to mine spine!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_92","type":"Speech","speaker":"nayuta_n_06","key":"Locale_MainScenario:event_goddessfall2_01_e_92","text":"Didst thou know this curious fact? The male deer casteth off his antlers in winter. I have seen it with mine own eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_93","type":"Speech","speaker":"nayuta_n_05","key":"Locale_MainScenario:event_goddessfall2_01_e_93","text":"Behold, here is a golden axe I did pull forth from beneath the lake...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_94","type":"Speech","speaker":"nayuta_n_03","key":"Locale_MainScenario:event_goddessfall2_01_e_94","text":"I did misstep upon the lava, and an ankle I have lost!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_95","type":"Speech","speaker":"nayuta_n_02","key":"Locale_MainScenario:event_goddessfall2_01_e_95","text":"Prithee, doth any among thee possess a spare eyeball?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_96","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_96","text":"...","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLobby","bgArt":"brokenedenlobby","image":null,"bgm":null,"movie":null,"shown":["papillon"],"affinity":null},{"id":"event_goddessfall2_01_e_97","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_97","text":"I feel like I'm about to lose my mind...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_98","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:event_goddessfall2_01_e_98","text":"Papillon, your break is over, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_r"],"affinity":null},{"id":"event_goddessfall2_01_e_99","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_99","text":"Oh, coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_100","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_100","text":"But when will long-range comms be restored?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_101","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:event_goddessfall2_01_e_101","text":"It's already been restored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_102","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_102","text":"Really? That's fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_103","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:event_goddessfall2_01_e_103","text":"Each of Eden's facilities and functions was designed to operate as independently as possible, minimizing reliance on external systems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_104","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_104","text":"... So that means we can get in touch with the outside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_105","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:event_goddessfall2_01_e_105","text":"Regrettably, that's impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_106","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:event_goddessfall2_01_e_106","text":"The Queen is jamming our systems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_107","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_107","text":"... Ugh, this sucks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_108","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_108","text":"Looks like hauling supplies is all I can do for now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_109","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:event_goddessfall2_01_e_109","text":"Brace for impact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_fear","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_110","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:event_goddessfall2_01_e_110","text":"Attack incoming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_111","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_01_e_111","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_112","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_01_e_112","text":"Papillon hurriedly ducks under the railing and looks across.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_01_e_113","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_01_e_113","text":"Countless red lights are flying toward Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}