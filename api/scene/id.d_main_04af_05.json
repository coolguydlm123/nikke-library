{"id":"d_main_04af_05","cat":"main","group":{"id":"ch4","label":"Chapter 4 · Bouquet"},"label":"Commander's Order","stage":null,"prev":"d_main_04af_04","next":"d_main_04af_06","speakers":{"anis":"Anis","rapi":"Rapi","neon":"Neon","Self":"Commander"},"icons":{"anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_04af_05_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_1","text":"What's my name?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_mystery","movie":null,"shown":["neon","anis","rapi"],"affinity":null},{"id":"d_main_04af_05_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_2","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_3","text":"My name is Bucephalus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_4","text":"Got it, Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_5","text":"You are my subordinate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_6","text":"You owe me 2 million credits as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_8","text":"Don't waste your time. I remember everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_9","text":"Did they really try and erase your memory?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_10","text":"I remember that too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_11","text":"So you just pretended that you don't remember anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_12","text":"Wow, so there are Nikkes who are immune to memory wipes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_13","text":"But what if they find out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_14","text":"They'll probably give it another go, and if it doesn't work that time...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_15","text":"Then you'll be discarded. You are, to some extent, an Irregular after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_16","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_16","text":"No exceptions. Ark policy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_18","text":"Commander, it's up to you whether you want to report this case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_19","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_05_19","text":"How about I report it to Andersen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_20","text":"Him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_21","text":"Can he be trusted?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_22","text":"I always feel like he's up to something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_23","text":"Then we are going to leave it alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_24","text":"What's wrong with that? No one else will know about it so long as we keep our mouths shut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_25","text":"It's harder to get close to Nikkes whose memories have been erased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_26","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_26","text":"You're right about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_27","text":"What if I need a brain scan for whatever reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_28","text":"I may be exposed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_29","text":"That's easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_30","text":"We just toss your brain into a fire the moment you get discovered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_31","text":"Happy ending for everybody!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_32","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_32","text":"Doesn't sound so happy to me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_33","text":"If you do get found out, you'll have to sell out the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_34","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_05_34","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_35","text":"We're just talking right now. Nobody's deciding anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_36","text":"You're the one who has to make the final decision, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_37","text":"Nikkes shall obey any and every order issued by their Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_38","text":"If the Commander orders us to keep it a secret, then that's what will happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_39","text":"If that's true, then if we're exposed, Master will be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_40","text":"relieved of duty. Worst case scenario, the Commander could be banished to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_41","text":"At the end of the day, that's what it means to be the Commander of a squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_42","text":"Making decisions freely and then taking responsibility for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_43","text":"When you think about it, this is freedom in the truest sense of the word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_44","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_44","text":"Anis, are you upset?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_45","text":"You're damn right I am!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_46","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_46","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_47","text":"Because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_48","text":"whatever the decision ends up being, we have to stick to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_49","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_49","text":"We're only making things harder on ourselves by talking in circles like we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_50","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_51","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_51","text":"No matter what the outcome is, we are... or more specifically, the Commander... is already in a dilemma.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_52","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_52","text":"You're not unhappy because Rapi is back, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_53","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_53","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_54","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_54","text":"I'm happy! Ecstatic. Over the moon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_55","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_55","text":"Look at her. You think getting so close to someone like her happened overnight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_56","text":"We're good friends. We can share anything with each other. Of course, I'm happy that my friend has returned safe and sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_57","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_57","text":"That's not why I'm upset.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_58","text":"I'm upset because she didn't even consider how barging in here and blurting out how her memory hasn't been erased would affect us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_59","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_59","text":"Then she puts the onus on us to make a decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_60","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_60","text":"I'm sorry, I never considered that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_61","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_61","text":"You don't have to apologize, just try not to let it happen again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_62","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_62","text":"Something this rare may not happen again anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_63","text":"So, Commander, what do you want us to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_64","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_05_64","text":"Keep it a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_65","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_65","text":"Are you okay with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_66","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_66","text":"I think so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_67","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_67","text":"Very well then. None of this ever leaves this room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_68","text":"Commander, please give us the order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_69","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_05_69","text":"Hide the truth that Rapi hasn't lost her memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_70","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_05_70","text":"... Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_71","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_72","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_72","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_73","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_73","text":"... Hang on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_74","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_74","text":"I'm a spy, aren't I? You're not supposed to be telling me stuff like this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_75","text":"I guess you're right about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_76","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04af_05_76","text":"Oh! I can be a double agent!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_05_77","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_05_77","text":"Just like the movies!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}