{"id":"d_counseling_mary_baygoddess_01","cat":"counsel","group":{"id":"char5064","label":"Mary: Bay Goddess"},"label":"Advising Mary: Bay Goddess: 01","stage":null,"prev":null,"next":"d_counseling_mary_baygoddess_02","speakers":{"mary_s":"Mary"},"icons":{"mary_s":"si_c132_00_s"},"lines":[{"id":"d_counseling_mary_baygoddess_01_1","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_1","text":"Are you all right, Commander?","jump":null,"exit":false,"enter":null,"bg":"Beach_d","bgArt":"beach_d","image":null,"bgm":"bgm_story_summermood","movie":null,"shown":["mary_s"],"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_2","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_2","text":"I saw you having a really intense water fight with Neon by the beach earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_3","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_3","text":"You didn't hurt yourself, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_01_4","text":"I'm just fine.","jump":"d_counseling_mary_baygoddess_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_baygoddess_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_01_5","text":"Actually, I did take a tumble and swallowed a mouthful of salt water.","jump":"d_counseling_mary_baygoddess_01_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_baygoddess_01_6","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_6","text":"Are you sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_7","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_7","text":"You should know better than to lie to a doctor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_8","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_8","text":"I clearly saw you fall into the water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_9","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_9","text":"Considering how long you were under, you must be 90% filled with salt water by now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_10","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_10","text":"How about letting me take a look?","jump":"d_counseling_mary_baygoddess_01_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_11","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_11","text":"I knew it. I told you not to play in the water for too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_12","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_12","text":"Drinking too much seawater can make you dehydrated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_13","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_13","text":"Come along, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_14","type":"Speech","speaker":"mary_s","key":"Locale_Counseling:d_counseling_mary_baygoddess_01_14","text":"It's time to give you some treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_baygoddess_01_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_baygoddess_01_15","text":"I obediently let Mary lead me to the clinic by hand.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}