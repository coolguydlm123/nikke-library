{"id":"d_main_14_09","cat":"main","group":{"id":"ch14","label":"Chapter 14 · Journey"},"label":"Burningum","stage":null,"prev":"d_main_14_08","next":"d_main_14_10","speakers":{"andersen":"Andersen","burningum":"Burningum"},"icons":{"andersen":"si_c903_00_s","burningum":"si_c914_00_s"},"lines":[{"id":"d_main_14_09_1","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_1","text":"Using Triangle and Perilous Siege? Just when I thought you couldn't stoop any lower.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_b","movie":null,"shown":["andersen","burningum"],"affinity":null},{"id":"d_main_14_09_2","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_2","text":"You're a Deputy Commander-in-Chief,\ndon't you feel any shame?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_3","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_3","text":"You know perfectly well how much Marian means to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_4","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_4","text":"We can win.\nIf we figure out what exactly happened to Marian, we can beat the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_5","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_5","text":"How can you be so sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_6","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_6","text":"A... gut feeling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_7","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_7","text":"I respect your instincts,\nbut this time, you're wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_8","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_8","text":"Marian is a Nikke serving under the Commando unit.\nYou might be a Deputy Commander-in-Chief, but your reach only extends so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_9","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_9","text":"I don't believe you had any ill intentions, so I won't bring any of this up in our next meeting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_10","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_10","text":"But this ends here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_11","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_11","text":"N-no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_12","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_12","text":"Marian is the key to the future.\nEven you must realize that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_13","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_13","text":"Next time we meet, I won't be so friendly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_14","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_14","text":"Uh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_15","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_16","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_16","text":"I-I can't give up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_17","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_17","text":"I will do everything in my power to open up Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_18","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_19","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_19","text":"You can beat me up, put a gun to my head... nothing will stop me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_20","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_20","text":"Even if you do,\nmy subordinates will come after her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_21","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_21","text":"Do you really want me as your enemy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_22","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_22","text":"You're the one who is doing this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_23","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_23","text":"I'm disappointed in you, Andersen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_24","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_24","text":"I thought you would understand what I'm trying to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_25","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_25","text":"Is humanity no longer your top priority?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_26","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_26","text":"Or is it the former commander in you that doesn't want to see a Nikke treated this way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_27","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_27","text":"If you know what's good for you, you won't bring that up again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_28","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_28","text":"S-sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_29","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_30","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_30","text":"I understand you. I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_31","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_31","text":"I have to figure out another way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_32","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_14_09_32","text":"Do what you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_14_09_33","text":"Burningum staggered away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_09_34","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_14_09_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]