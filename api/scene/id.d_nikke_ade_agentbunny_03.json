e_agentbunny_03_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_65","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_65","text":"I offer my sincerest thanks once more, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_66","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_66","text":"As both your maid and a special agent, I shall endeavor that your precious time be not squandered,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_67","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_67","text":"and will apply myself fully to maintaining the utmost distinction between my two sides.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_68","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_68","text":"The time I spend with you is never a waste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_69","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_69","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_70","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_70","text":"O-oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie