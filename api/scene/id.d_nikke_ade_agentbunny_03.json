{"id":"d_nikke_ade_agentbunny_03","cat":"bond","group":{"id":"char5151","label":"Ade: Agent Bunny"},"label":"Perfect, not Maid","stage":null,"prev":"d_nikke_ade_agentbunny_02","next":"d_nikke_ade_agentbunny_04","speakers":{"ade_b":"Ade"},"icons":{"ade_b":"si_c315_00_s"},"lines":[{"id":"d_nikke_ade_agentbunny_03_1","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_1","text":"My plan is a switch in behavior whenever you switch outfits.","jump":null,"exit":false,"enter":null,"bg":"MaidCafe","bgArt":"maidcafe","image":null,"bgm":"bgm_story_girlstalk","movie":null,"shown":["ade_b"],"affinity":null},{"id":"d_nikke_ade_agentbunny_03_2","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_2","text":"A... switch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_3","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_3","text":"So, Master, what you mean is that depending on which outfit I am wearing,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_4","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_4","text":"the goal is to adjust my behavior accordingly,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_5","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_5","text":"thereby separating the two sides of myself and allowing me to switch between them at will?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_6","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_6","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_7","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_7","text":"... Now that I think on it, I once offered the same counsel to Soda.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_8","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_8","text":"I told her that the foundation of a maid lies in her attire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_9","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_9","text":"One's mindset is shaped from what one wears,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_10","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_10","text":"for it is common enough that a person's manner of conduct shifts according to their dress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_11","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_11","text":"Hehe, I now fully comprehend your intent, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_12","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_12","text":"Very well, then. Shall we begin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_13","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_13","text":"Where would you have me start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_14","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_14","text":"First, do your maid work in the bunny girl outfit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_15","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_15","text":"You wish me to serve you as your maid dressed thus...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_16","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_16","text":"I-I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_17","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_17","text":"I-I fear I am unable...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_18","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_18","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_19","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_19","text":"B-because serving you in such unbecoming attire is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_20","text":"You're still feeling embarrassed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_21","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_21","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_22","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_22","text":"This attire reveals far too much, and I cannot help but feel uneasy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_23","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_23","text":"To offer you perfect service as your maid whilst clad thus is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_24","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_24","text":"This is why you have to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_25","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_25","text":"Oh...? Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_26","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_26","text":"Even if you can become a perfect maid right now, it wouldn't be any different from your usual self.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_27","text":"That's why it's hard to separate your usual self from your current self.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_28","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_28","text":"I-I see!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_29","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_29","text":"As you have said, there is no need for me to be perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_30","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_30","text":"Um... then, how ought I to proceed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_31","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_31","text":"I have always endeavored to be the perfect maid,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_32","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_32","text":"and so I find myself at a loss as to how to act otherwise...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_33","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_33","text":"Don't overthink it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_34","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_34","text":"Think of yourself as a special agent carrying out a maid mission, like in the video we just watched.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_35","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_35","text":"A special agent going undercover as a maid...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_36","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_37","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_37","text":"The self captured in that video was, I fear, far removed from the image I had long conceived and endeavored to embody.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_38","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_38","text":"Having forsaken the dignity and grace that befits a maid,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_39","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_39","text":"it seemed as though I strove only to present perfection","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_40","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_40","text":"with executing the mission flawlessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_41","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_41","text":"Though the execution of my duties may have been perfect, it struck a subtly peculiar note for a maid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_42","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_42","text":"No doubt that is why the customers perceived something amiss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_43","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_43","text":"It was unlike my customary self.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_44","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_44","text":"... Yet, if such a manner is only permitted whilst garbed thus, and whilst fulfilling the duties of a special agent...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_45","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_45","text":"Then you can make a switch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_46","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_46","text":"Yes, Master, just as you have said. I shall be able to keep them separate—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_47","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_47","text":"my perfect self as a maid,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_48","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_48","text":"and a special agent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_49","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_49","text":"Hehe, thanks to you, Master, I now perceive the path I must tread.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_50","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_50","text":"I am most grateful indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_51","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_51","text":"Ade gives a graceful bow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_52","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_52","text":"... Hey, don't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_53","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_53","text":"... Pardon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_54","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_54","text":"Not allowed...? In what way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_55","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_55","text":"That's something only a perfect maid would do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_56","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_56","text":"Ah...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ade_agentbunny_03_57","type":"Speech","speaker":"ade_b","key":"Locale_NikkeEpisode:d_nikke_ade_agentbunny_03_57","text":"I-I see, I had not realized...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":nu