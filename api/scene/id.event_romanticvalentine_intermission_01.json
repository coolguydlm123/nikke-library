nt_romanticvalentine_intermission_01_5","text":"Here's to a job well done, everyone!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_6","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_intermission_01_6","text":"Who would've thought we'd turn the Maid Cafe into a pirate cafe for Valentine's Day...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_7","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_7","text":"Everyone seemed to enjoy it, so what's the problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_8","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_8","text":"Here, Master Captain, have a cold one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_9","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_9","text":"Phew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_10","type":"Speech","speaker":"sin_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_10","text":"※You look exhausted, Trony.▣※","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_11","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_11","text":"There's just so much pirate stuff... and it's so noisy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_12","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_12","text":"I'm mentally exhausted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_13","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_13","text":"You pushed yourself to the limit, Trony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_14","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_14","text":"I saw it with my own eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_15","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_intermission_01_15","text":"She did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_16","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_16","text":"Absolutely. Every time she handed over a dish from the kitchen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_17","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_17","text":"I heard her say \"Enjoy your meal\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_18","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_18","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_intermission_01_19","text":"Nicely done, Trony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_20","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_20","text":"Sure... thanks for helping out,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_21","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_21","text":"Ma-Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_22","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_intermission_01_22","text":"Mast, Anchor, Sin, you all worked hard too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_23","type":"Speech","speaker":"anchor_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_23","text":"I had fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,