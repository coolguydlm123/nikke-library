e mood...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_30","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_intermission_01_30","text":"Sin looks around the cafe, which now resembles a tavern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_31","type":"Speech","speaker":"sin_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_31","text":"□※But are you really□▣satisfied with this?※","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_32","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_32","text":"Wha...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_33","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_33","text":"You're really hittin' me where it hurts, Sin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_34","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_35","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_intermission_01_35","text":"*Gulp gulp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i