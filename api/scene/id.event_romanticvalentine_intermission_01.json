":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_42","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_42","text":"Isn't that right, Master Captain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_43","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_intermission_01_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_44","type":"Speech","speaker":"anchor_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_44","text":"Mast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_45","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_45","text":"Aye?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_46","type":"Speech","speaker":"anchor_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_46","text":"You sound like an old woman.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_47","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_47","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_48","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_48","text":"How can you say that to a sprightly young lady like me?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_49","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_49","text":"He-hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_50","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_50","text":"... I think that's the first time I've seen you crack a smile, Trony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_51","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_51","text":"Well, anyway. This was fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_52","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_52","text":"It'd be nice if we could all meet up for a meal once in a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_53","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_53","text":"I'd like that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_54","type":"Speech","speaker":"sin_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_54","text":"Sure. □□▣※Let's meet up□※▣whenever we have time.※","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_55","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_55","text":"That's what people always say when they're not going to see each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_56","type":"Speech","speaker":"sin_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_56","text":"▣Well, I'm not※※wrong, am I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_57","type":"Speech","speaker":"sin_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_57","text":"□▣▣We're always being deployed on missions and fighting up on the▣※surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_58","type":"Speech","speaker":"sin_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_58","text":"□□We barely▣have any time to rest.▣※","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_intermission_01_59","type":"Speech","speaker":"anchor_m","key":"Locale_SubScenario:event_romanticvalentine_intermission_01_59","text":"You're right. I want to hang out with Master for longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie