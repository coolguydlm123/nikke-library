{"id":"event_secretgarden_01_s","cat":"event","group":{"id":"ev40063","label":"SECRET GARDEN"},"label":"Rare Flower: A","stage":null,"prev":"event_secretgarden_prologue","next":"event_secretgarden_01_e","speakers":{"flora":"Flora"},"icons":{"flora":"si_c411_00_s"},"lines":[{"id":"event_secretgarden_01_s_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_1","text":"It feels like whenever I'm about to get some rest, some Nikke comes barging into my office.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_2","text":"I'm going to put up a \"Do Not Disturb\" sign on the door so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_3","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_3","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_4","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_4","text":"Blossom?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["flora"],"affinity":null},{"id":"event_secretgarden_01_s_5","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_5","text":"Flora?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_6","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_6","text":"I thought you'd be here.","jump":null,"exit":false,"enter":null,"bg":null,"bg