ent_secretgarden_01_s_20","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_20","text":"The flower I'm looking for isn't just any ordinary flower, so it'll fit the bill for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_21","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_21","text":"What kind of flower is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_22","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_22","text":"It's called Aurora Bloom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_23","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_23","text":"It's sometimes referred to as the Flower of the Heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_24","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_24","text":"The sap extracted from Aurora Bloom helps people forget unpleasant memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_25","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_25","text":"So it heals any emotional distress people have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_26","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_26","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_27","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_27","text":"We've attempted to cultivate it in the garden several times before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_28","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_28","text":"but we've never been able to succeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_29","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_29","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_30","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_30","text":"Perhaps due to a lack of proper facilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_31","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_31","text":"Now, we have watering robots that patrol the garden, and a greenhouse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_32","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_32","text":"When we first brought back an Aurora Bloom, however, we didn't have any of those things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_33","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_33","text":"We managed to get it to sprout, but it was never able to form any buds of its own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_34","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_34","text":"Although we tried several times, it kept wilting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_35","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_36","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_36","text":"We haven't tried bringing it back since.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_37","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_37","text":"We couldn't bear to watch the flower wither away anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_38","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_38","text":"Maybe it can't survive away from the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_39","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_39","text":"It's a possibility,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_40","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_40","text":"but the garden has undergone a complete overhaul.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_41","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_41","text":"Right now, it's an environment where plants are bound to thrive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_42","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_42","text":"The temperature, humidity, soil, and sunlight are just right. It has everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_43","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_43","text":"Of course, it's all provided by artificial machines,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_44","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_44","text":"but it's still an optimal environment for flowers to bloom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_45","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_45","text":"All the other flowers we've brought from the surface have done well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_46","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_46","text":"I'm sure Aurora Bloom will do just fine in the garden now,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_47","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_47","text":"and so I plan on going to search for it again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_48","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_48","text":"Flora hands me a photo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_49","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_01_s_49","text":"That's the Aurora Bloom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_50","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_50","text":"Other than the admittedly eye-catching array of colors, there's nothing particularly special about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_51","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_01_s_51","text":"It looks a bit ordinary, to be honest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_01_s_52","type":"Speech","speaker":"flora","key":"Loca