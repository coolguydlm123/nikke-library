{"id":"d_counseling_naga_04","cat":"counsel","group":{"id":"char5099","label":"Naga"},"label":"Advising Naga: 04","stage":null,"prev":"d_counseling_naga_03","next":"d_counseling_naga_05","speakers":{"naga":"Naga"},"icons":{"naga":"si_c450_00_s"},"lines":[{"id":"d_counseling_naga_04_1","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_1","text":"Once in a while, I get a bit frustrated.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["naga"],"affinity":"_0"},{"id":"d_counseling_naga_04_2","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_2","text":"At times like that, I just want to get as far away from the school as I can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_naga_04_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_naga_04_3","text":"You're more than welcome to come hang out with me anytime you want.","jump":"d_counseling_naga_04_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_naga_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_naga_04_4","text":"No matter how bad you feel, you can't forget your responsibilities as a student.","jump":"d_counseling_naga_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_naga_04_5","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_5","text":"I thought you'd say something like that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_naga_04_6","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_6","text":"but it feels nice to hear you really say it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_naga_04_7","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_7","text":"I might just take you up on that offer sometime.","jump":"d_counseling_naga_04_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_naga_04_8","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_8","text":"A truly professional answer if there ever was one. I expected no less from you, Teacher.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_naga_04_9","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_9","text":"It might not be easy, but I feel like I'm back on track.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_naga_04_10","type":"Speech","speaker":"naga","key":"Locale_Counseling:d_counseling_naga_04_10","text":"And it's thanks to you.","jump":"d_counseling_naga_04_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_naga_04_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_naga_04_11","text":"I speak with Naga about the difficulties of attending school.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}