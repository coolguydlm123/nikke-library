ype":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_02_14","text":"I'm sorry, but... please don't touch me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_02_15","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_03_02_15","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_02_16","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_02_16","text":"I said don't touch my wound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_02_17","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_03_02_17","text":"Mihara has a thing for scars. She doesn't like others touching them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_02_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_03_02_18","text":"You can't be serious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_02_19","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_02_19","text":"No, I mean it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_03_02_20","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_03_02_20","text":"I appreciate the gesture, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}