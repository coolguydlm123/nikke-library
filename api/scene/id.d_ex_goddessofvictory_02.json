ale_SuddenStory:d_ex_goddessofvictory_02_59","text":"Sure, but my prayers may not be heard, and it might not rain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_60","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_60","text":"If the weather is sunny tomorrow then I want to go on a picnic with you two!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_61","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_61","text":"That way, I'll be happy whether it rains or not!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_62","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_62","text":"Rapunzel smiles weakly at N102's comment, a bittersweet look on her face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_63","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_63","text":"So this is how it feels to be erased from someone's memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_64","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_64","text":"I wonder... how many people have I forgotten?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_65","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_66","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_66","text":"I should pray to the statue as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_67","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_67","text":"Rapunzel kneels in front of the Goddess of Victory statue, filled with reverence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_68","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_68","text":"It's quite the sight seeing Sister Rapunzel pray.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_69","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_69","text":"What do you think she'll pray for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_70","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_70","text":"That the weather is sunny tomorrow.","jump":"d_ex_goddessofvictory_02_72","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_71","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_71","text":"That she can remember this moment.","jump":"d_ex_goddessofvictory_02_75","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_72","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_72","text":"Does she not like the rain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_73","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_73","text":"I like the rain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_74","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_74","text":"But it'd be nicer if we can all go on a picnic together.","jump":"d_ex_goddessofvictory_02_81","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_75","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_75","text":"Really? I should pray for the same thing then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_76","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_76","text":"It was great that all three of us were able to spend time together today!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_77","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_77","text":"I've got to get going, gotta buy some juice...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_78","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_78","text":"Let's go together after you finish praying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_79","type":"Speech","speaker":"n102","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_79","text":"Okay, sounds good!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_80","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_80","text":"N102 kneels beside Rapunzel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_81","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_81","text":"Believer...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_82","type":"Speech","speaker":"rapunzel","key":"Locale_SuddenStory:d_ex_goddessofvictory_02_82","text":"Will you pray as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_83","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_83","text":"We all knelt down and prayed for some time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_84","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_84","text":"Tomorrow, the weather will be sunny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_goddessofvictory_02_85","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_goddessofvictory_02_85","text":"Tomorrow, the day after, and a year from now, the Goddess of Victory statue will remember all the Nikkes who knelt before it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}