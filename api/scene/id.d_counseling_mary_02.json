{"id":"d_counseling_mary_02","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 02","stage":null,"prev":"d_counseling_mary_01","next":"d_counseling_mary_03","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_02_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_1","text":"Commander, would you rather be very ill for a short period of time...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_02_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_2","text":"... or be just a little sick for a long time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_02_3","text":"Option 1.","jump":"d_counseling_mary_02_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_02_4","text":"Option 2.","jump":"d_counseling_mary_02_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_02_5","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_5","text":"Just as I thought!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_6","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_6","text":"I figured you would say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_7","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_7","text":"After all, you're always being so reckless on missions and getting yourself hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_8","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_8","text":"The syringe I prepared for you is perfect, then. It'll hurt for a little bit, but then you'll be as good as new.","jump":"d_counseling_mary_02_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_9","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_9","text":"Oh, is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_10","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_10","text":"Hm... I'm not sure what to do, then. The syringe I prepared is the other way around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_11","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_11","text":"Oh well. There's no other way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_12","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_02_12","text":"I guess you'll just have to take it anyway...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_02_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_02_13","text":"I persuade Mary into not giving me a shot.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}