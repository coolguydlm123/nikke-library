{"id":"d_counseling_d_15","cat":"counsel","group":{"id":"char1007","label":"D"},"label":"Advising D: 15","stage":null,"prev":"d_counseling_d_14","next":"d_counseling_d_16","speakers":{"d":"D"},"icons":{"d":"si_c040_00_s"},"lines":[{"id":"d_counseling_d_15_1","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_1","text":"What is atonement to you?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["d"],"affinity":"_0"},{"id":"d_counseling_d_15_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_d_15_2","text":"Doing whatever it takes to be forgiven.","jump":"d_counseling_d_15_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_d_15_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_d_15_3","text":"Taking full responsibility for your actions.","jump":"d_counseling_d_15_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_d_15_4","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_4","text":"Forgiveness?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_5","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_5","text":"If you murdered someone, who would forgive you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_6","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_6","text":"The one you killed? Their friends and loved ones?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_7","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_7","text":"No. There is no such thing as forgiveness in that instance.","jump":"d_counseling_d_15_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_8","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_8","text":"Well said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_9","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_9","text":"If you have committed a transgression,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_10","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_10","text":"you must face the consequences.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_11","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_11","text":"Once you have sinned, that is a cross that you must bear for the rest of your life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_12","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_12","text":"That to me, is what atonement is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_13","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_13","text":"I, too, have my own cross to bear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_14","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_15_14","text":"And it will be with me for all my days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_15_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_d_15_15","text":"I have a conversation with D about the repercussions of sin.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}