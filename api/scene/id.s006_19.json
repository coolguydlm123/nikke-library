{"id":"s006_19","cat":"side","group":{"id":"side6","label":"GINGERBREAD HOUSE"},"label":"GINGERBREAD HOUSE: EPILOGUE","stage":null,"prev":"s006_18","next":null,"speakers":{"mori":"Mori","bernoullia":"Bernoullia","littlemermaid":"Little Mermaid","cinderella":"Cinderella","hansel":"Hansel","gretel":"Gretel","grave_p":"Grave"},"icons":{"mori":"si_c590_00_s","bernoullia":"si_c9042_00_s","littlemermaid":"si_c513_00_s","cinderella":"si_c511_00_s","hansel":"si_c980_00_s","gretel":"si_c981_00_s","grave_p":"si_c514_00_s"},"lines":[{"id":"s006_19_1","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_1","text":"*Sob*","jump":null,"exit":false,"enter":null,"bg":"CoastalCliff_n","bgArt":"coastalcliff_n","image":null,"bgm":"none","movie":null,"shown":["mori"],"affinity":null},{"id":"s006_19_2","type":"Narration","speaker":null,"key":"Locale_SideStory:s006_19_2","text":"Mori lowers the hand she's been waving toward the distant sea and wipes away her tears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_3","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_3","text":"Stop crying... What right do you have to cry?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_4","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_4","text":"I'm such an idiot...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_5","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_5","text":"Does that vex you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_blackgunsmoke","movie":null,"shown":null,"affinity":null},{"id":"s006_19_6","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_6","text":"*Sniff* H-huh?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_7","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_7","text":"*Gasp!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["bernoullia"],"affinity":null},{"id":"s006_19_8","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_8","text":"When did you get here...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_9","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_9","text":"Are you really that bitter about being left behind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_10","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_10","text":"N-no...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_11","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_11","text":"It's just... I feel so pathetic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_12","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_12","text":"I wanted to fight alongside them...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_13","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_13","text":"but in the end, all I could do was run away to save myself...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_14","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_14","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_15","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_15","text":"You had plenty to say earlier. Why are you shrinking back now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_16","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_16","text":"Eek...! Y-you were listening to everything we said?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_17","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_17","text":"You mean that business about protecting me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_18","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_18","text":"Gah... s-so you did hear everything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_19","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_19","text":"Then why didn't you come out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_20","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_20","text":"To be honest... when we talked earlier, you said it was okay, so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_21","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_21","text":"I thought you'd come out to see Hansel and Gretel off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_22","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_22","text":"I never permitted the hellions to leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_23","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_23","text":"Huh? But I thought you said...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_24","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_24","text":"I merely allowed you to become my new slave. Nothing more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_25","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_25","text":"Err...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_26","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_26","text":"I can't stand tearful goodbyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_27","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_27","text":"Such things are for those marching off to their deaths.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_28","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_28","text":"For little hellions who'll be coming back, running away from home is far more fitting than marching off to war.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_29","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_29","text":"Because then they'll come home?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_30","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_30","text":"Heh! Think what you want...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_31","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_31","text":"Hmph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_32","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_32","text":"Duckling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_33","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_33","text":"Duckling...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_34","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_34","text":"Why do you keep calling me that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_35","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_35","text":"You're rather like a duckling, waddling along as you struggle to grow stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_36","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_36","text":"Remember this frustration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_37","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_37","text":"Never forget how powerless you felt when you couldn't even make it to the battlefield to fight alongside your friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_38","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_38","text":"And with that feeling in your heart, keep running. Don't you dare give up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_39","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_39","text":"The world is certainly unreasonable and unfair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_40","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_40","text":"And yet, amusingly enough, so long as you can show that you've put in the effort,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_41","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_41","text":"this world will also give you the chance to overcome what you were born with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_42","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_42","text":"Ah...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_43","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_43","text":"Of course... What constitutes enough effort differs from one person to the next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_44","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_44","text":"And because there is no end to it, every passing hour may feel like a cruel tease of hope just out of reach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_45","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_45","text":"But who knows?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_46","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_46","text":"Keep at it with those little feet of yours,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_47","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_47","text":"and perhaps one day, this duckling of mine will grow into a swan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_48","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_48","text":"Right! I'll... do my best,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_49","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_49","text":"so that someday, I can fight alongside them, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_50","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_50","text":"Now then, keep that spirit up and make me some delicious bread for breakfast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_51","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_19_51","text":"If you burn it like last time, I'll have you baking bread all day long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_52","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_19_52","text":"G-gah... Yes, ma'am!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_53","type":"Narration","speaker":null,"key":"Locale_SideStory:s006_19_53","text":"A few days later, on Little Mermaid's bubble above the ocean...","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_06_05","bgArt":"eventscene_side_06_05","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s006_19_54","type":"Speech","speaker":"littlemermaid","key":"Locale_SideStory:s006_19_54","text":"Hmm...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_55","type":"Narration","speaker":null,"key":"Locale_SideStory:s006_19_55","text":"Little Mermaid looks down at the water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_19_56","type":"Speech","speaker":"littlemermaid","key":"Locale_SideStory:s006_19_56","text":"... What could that green light be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_oldtales_beautifulthing","movie":null,"shown":null,"affinity":null},{"id":"s006_19_57","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_19_57","text":"Green light?","