{"id":"memorial_103101","cat":"memorial","group":{"id":"memorial103100","label":"Memoirs · Emergency news scripts _FB_3_final_2.pdf"},"label":"Feedback 01_2","stage":null,"prev":null,"next":"memorial_103102","speakers":{"FB":"FB"},"icons":{},"lines":[{"id":"memorial_103101_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_31_01_description","text":"Raptures have penetrated Block No.150 of the Dome of Eternity."},{"id":"memorial_103101_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_31_01_description","text":"-> An unprecedented incident has occurred: Raptures have entered the Ark."},{"id":"memorial_103101_3","type":"Speech","speaker":"FB","key":"Locale_Memorial:memorial_31_01_description","text":"No need to delve into excessive detail."},{"id":"memorial_103101_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_31_01_description","text":"The fact that Raptures have invaded the Ark is what matters."},{"id":"memorial_103101_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_31_01_description","text":"Added word \"unprecedented\" to punch it up."}]}