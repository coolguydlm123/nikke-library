 are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_1_01_s_56","text":"*Boom*!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_57","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_01_s_57","text":"This is bad. It's only a matter of time before the Tetrapod gets hit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_58","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_01_s_58","text":"I'll go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_59","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_01_s_59","text":"I think it'd be best for us to conduct a bit more recon before moving out. We have no idea what these \"Rapture\" things are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_60","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_01_s_60","text":"I understand that, but if we lose the Tetrapod, we're in big trouble.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_61","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_01_s_61","text":"It's not the end of the world. Machines can be repaired. If one of us gets hurt though, then we're really screwed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"