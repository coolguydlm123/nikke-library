06_1_01_s_20","text":"I'd have to agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_1_01_s_21","text":"Rapi gets up and grabs my phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_1_01_s_22","text":"*Beep* *Beep* *Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_23","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_01_s_23","text":"Would it be okay if I check them for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_01_s_24","text":"Don't do it, Rapi. What if they're all flirty messages from different Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_01_s_25","text":"You might end up resenting the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_01_s_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_01_s_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_01_s