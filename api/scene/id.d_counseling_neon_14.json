{"id":"d_counseling_neon_14","cat":"counsel","group":{"id":"char3002","label":"Neon"},"label":"Advising Neon: 14","stage":null,"prev":"d_counseling_neon_13","next":"d_counseling_neon_15","speakers":{"neon":"Neon"},"icons":{"neon":"si_c011_00_s"},"lines":[{"id":"d_counseling_neon_14_1","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_1","text":"Do you think there are elevators that can teleport?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["neon"],"affinity":"_0"},{"id":"d_counseling_neon_14_2","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_2","text":"I don't like waiting to go up and down to and from the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_14_3","text":"You could always spend that time waiting with someone you like.","jump":"d_counseling_neon_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_neon_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_neon_14_4","text":"You could cut the elevator cables.","jump":"d_counseling_neon_14_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_neon_14_5","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_5","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_14_6","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_6","text":"Good point! Then time would pass more quickly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_14_7","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_7","text":"All right then, next time I'll stay close to you.","jump":"d_counseling_neon_14_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_14_8","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_8","text":"Let me guess, then let gravity do the rest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_14_9","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_9","text":"I'd plummet to the ground about as quickly as teleporting would get me there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_14_10","type":"Speech","speaker":"neon","key":"Locale_Counseling:d_counseling_neon_14_10","text":"Then I can become a ghost and float my way back up, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_neon_14_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_neon_14_11","text":"Neon and I racked our brains trying to come up with ways to save time waiting for the elevator.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}