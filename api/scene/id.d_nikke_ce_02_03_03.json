{"id":"d_nikke_ce_02_03_03","cat":"bond","group":{"id":"char5096","label":"Pascal"},"label":"This is Not Hell","stage":null,"prev":"d_nikke_ce_02_03_02","next":"d_nikke_ce_02_03_04","speakers":{"ce_02_03":"Pascal","massproduction01":"Mass-produced Nikke"},"icons":{"ce_02_03":"si_c812_00_s","massproduction01":"si_c253_00_s"},"lines":[{"id":"d_nikke_ce_02_03_03_1","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_1","text":"After all those overcast and gloomy skies, the weather is looking much nicer today.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":"event_bgm_ce002_story_2","movie":null,"shown":["ce_02_03","massproduction01"],"affinity":null},{"id":"d_nikke_ce_02_03_03_2","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_2","text":"It would be nice if we're treated to some pretty flowers while we're out gathering parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_3","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_3","text":"You're asking for a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_4","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_4","text":"The fact that we haven't met a single Rapture for the past few days could be considered a miracle by some.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_5","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_5","text":"As for me, I say it just means we're all the more likely to get our heads kicked in by one of them at any second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_6","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_6","text":"Oh! I just remembered there was a question I wanted to ask you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_7","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_7","text":"These \"Raptures\" who you keep mentioning, who are these people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_8","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_8","text":"Took you long enough to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_9","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_9","text":"First off, they hardly deserve to be called 'people'.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_10","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_10","text":"Raptures are the enemy of mankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_11","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_11","text":"They have occupied the surface and forced all humans to hide underground in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_12","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_12","text":"But what about you, Miss Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_13","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_13","text":"I'm a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_14","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_14","text":"We are weapons designed to fight against those Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_15","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_15","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_16","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_16","text":"And, as you can clearly see from the condition I'm in, the conflict up on the surface has been never-ending.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_17","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_17","text":"Do you have any other companions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_18","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_18","text":"I work with some other people, but I wouldn't go so far as to call them companions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_19","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_19","text":"There are a lot of people around me who look and sound like me, but I've never spoken to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_20","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_20","text":"I fight. That's all I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_21","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_21","text":"I was born to kill Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_22","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_22","text":"In many ways, this world sounds vastly different from my own, but there are similarities as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_23","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_23","text":"How so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_24","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_24","text":"Is the world you came from a living hell like this one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_25","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_25","text":"Hell?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_26","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_26","text":"You regard this place as hell?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_27","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_27","text":"I grapple with Raptures tooth and nail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_28","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_28","text":"I put them in the ground until my legs were decimated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_29","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_29","text":"If this place isn't hell, what is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_30","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_30","text":"So we can never let our guard down, not for an instant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_31","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_31","text":"The second a Rapture finds us, everyone can kiss their asses goodbye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_32","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_32","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_33","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_33","text":"Nevertheless, calling this place a living hell is perhaps a bit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_34","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_35","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_36","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_36","text":"What is your world like?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_37","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_37","text":"Why do you ask?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_38","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_38","text":"I'm just curious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_39","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_39","text":"Tell me about where you used to live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_40","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_40","text":"Well, in our world...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_41","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_41","text":"the sky is blue.","jump":null,"exit":false,"enter":null,"bg":"Grassland","bgArt":"grassland","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_42","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_42","text":"The trees tower above the ground, perhaps due to the abundant sunlight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_43","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_43","text":"Animals frolic freely amongst the meadows and pathways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_44","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_44","text":"Despite all of this, the strife between the androids and machines has been ceaseless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_45","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_45","text":"The village I lived in was a tranquil and peaceful place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_46","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_46","text":"Oh, come off it.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_47","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_47","text":"Your world and mine sound like night and day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_48","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_48","text":"Yours sounds positively idyllic in comparison.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_49","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_49","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_50","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_50","text":"That's very kind of you to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_51","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_51","text":"However, I think this world is very nice, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_52","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_52","text":"What? Here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_53","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_53","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_54","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_54","text":"Isn't it obvious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_55","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_55","text":"You've got a blue sky, cool breeze, and an abundance of flora and fauna.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_56","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_56","text":"You're only saying that because you haven't seen a Rapture yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_57","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_57","text":"Every day for us is about constant fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_58","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_58","text":"What's so nice about that? How is that similar to your world in any way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_59","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_59","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_60","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_60","text":"How about we find out together?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_61","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_61","text":"Huh? Find out what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_03_62","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_03_62","text":"Evidence that can prove this world isn't so hellish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}