{"id":"msg_m_ex_trina_02","cat":"messenger","group":{"id":"room_trina","label":"Trina · Nikke"},"label":"2. Hi, Sun.","stage":null,"prev":"msg_m_ex_trina_01","next":"msg_m_ex_trina_03","speakers":{"trina":"Trina"},"icons":{"trina":"si_c412_00_s"},"lines":[{"id":"m_ex_trina_02_1","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_1","text":"Hi, Sun.","jump":null},{"id":"m_ex_trina_02_2","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_2","text":"What lovely weather we're having today.","jump":null},{"id":"m_ex_trina_02_3","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_3","text":"The little ones and I","jump":null},{"id":"m_ex_trina_02_4","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_4","text":"are at the Park.","jump":null},{"id":"m_ex_trina_02_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_5","text":"Did you go with the birds?","jump":null},{"id":"m_ex_trina_02_6","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_6","text":"Yes, I did.","jump":null},{"id":"m_ex_trina_02_7","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_7","text":"They're usually quite timid","jump":null},{"id":"m_ex_trina_02_8","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_8","text":"and always stick close to me,","jump":null},{"id":"m_ex_trina_02_9","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_9","text":"but they must be in a great mood today","jump":null},{"id":"m_ex_trina_02_10","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_10","text":"as they went off soaring on their own.","jump":null},{"id":"m_ex_trina_02_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_11","text":"The weather really is spectacular today.","jump":null},{"id":"m_ex_trina_02_12","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_12","text":"Hehe,","jump":null},{"id":"m_ex_trina_02_13","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_13","text":"isn't it just?","jump":null},{"id":"m_ex_trina_02_14","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_14","text":"The temperature is just right","jump":null},{"id":"m_ex_trina_02_15","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_15","text":"for a lovely outing.","jump":null},{"id":"m_ex_trina_02_16","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_16","text":"In fact,","jump":null},{"id":"m_ex_trina_02_17","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_17","text":"if you're free,","jump":null},{"id":"m_ex_trina_02_18","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_18","text":"how about stopping by, Sun?","jump":null},{"id":"m_ex_trina_02_19","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_19","text":"I think the little ones miss you.","jump":null},{"id":"m_ex_trina_02_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_20","text":"Sorry, but I have an important meeting in the afternoon :(","jump":null},{"id":"m_ex_trina_02_21","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_21","text":"Oh,","jump":null},{"id":"m_ex_trina_02_22","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_22","text":"I see.","jump":null},{"id":"m_ex_trina_02_23","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_23","text":"That's too bad :'(","jump":null},{"id":"m_ex_trina_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_24","text":"Maybe next time.","jump":null},{"id":"m_ex_trina_02_25","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_25","text":"Of course.","jump":null},{"id":"m_ex_trina_02_26","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_26","text":"That would be nice.","jump":null},{"id":"m_ex_trina_02_27","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_27","text":"Hehe.","jump":null},{"id":"m_ex_trina_02_28","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_28","text":"By the way...","jump":null},{"id":"m_ex_trina_02_29","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_29","text":"Considering that we're inside the Ark,","jump":null},{"id":"m_ex_trina_02_30","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_30","text":"it's surprisingly lush and verdant here.","jump":null},{"id":"m_ex_trina_02_31","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_31","text":"It feels like I could almost","jump":null},{"id":"m_ex_trina_02_32","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_32","text":"become one with the greenery.","jump":null},{"id":"m_ex_trina_02_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_33","text":"Huh? What do you mean?","jump":null},{"id":"m_ex_trina_02_34","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_34","text":"Hehe.","jump":null},{"id":"m_ex_trina_02_35","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_35","text":"Hehehe.","jump":null},{"id":"m_ex_trina_02_36","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_36","text":"Just a moment.","jump":null},{"id":"m_ex_trina_02_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_37","text":"Trina?","jump":null},{"id":"m_ex_trina_02_38","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_38","text":"Trina doesn't reply.","jump":null},{"id":"m_ex_trina_02_39","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_39","text":"She surely can't be doing what I think she is... right?","jump":null},{"id":"m_ex_trina_02_40","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_40","text":"Phew...","jump":null},{"id":"m_ex_trina_02_41","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_41","text":"That feels much better.","jump":null},{"id":"m_ex_trina_02_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_42","text":"What did you do?","jump":null},{"id":"m_ex_trina_02_43","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_43","text":"With one less layer, I've gotten one step closer to nature, hehe.","jump":null},{"id":"m_ex_trina_02_44","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_44","text":"Now I'm thinking about taking a nap here.","jump":null},{"id":"m_ex_trina_02_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_45","text":"With the way you're right now, you should sleep indoors.","jump":null},{"id":"m_ex_trina_02_46","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_46","text":"I don't know,","jump":null},{"id":"m_ex_trina_02_47","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_47","text":"lying down on the grass like this is so comfortable.","jump":null},{"id":"m_ex_trina_02_48","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_48","text":"I'm already feeling a bit drowsy.","jump":null},{"id":"m_ex_trina_02_49","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_49","text":"Hold on, I'll be there soon.","jump":null},{"id":"m_ex_trina_02_50","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_50","text":"Oh my, really?","jump":null},{"id":"m_ex_trina_02_51","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_51","text":"All rght.","jump":null},{"id":"m_ex_trina_02_52","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_52","text":"The little ones and I will be haer, reesting.","jump":null},{"id":"m_ex_trina_02_53","type":"Speech","speaker":"trina","key":"Locale_SuddenMessage:m_ex_trina_02_53","text":"Teak your time.","jump":null},{"id":"m_ex_trina_02_54","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_54","text":"All right.","jump":null},{"id":"m_ex_trina_02_55","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_55","text":"If those typos are any indication, I'd say Trina must have dozed off by now.","jump":null},{"id":"m_ex_trina_02_56","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_56","text":"I need to hurry over there","jump":null},{"id":"m_ex_trina_02_57","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_trina_02_57","text":"and cover her with something before someone sees her.","jump":null}],"chat":true}