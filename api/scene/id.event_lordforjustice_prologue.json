_prologue_64","text":"The Judges are a committee. Everyone has an equal say and therefore all decisions are impartial.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_prologue_65","type":"Speech","speaker":"x","key":"Locale_SubScenario:event_lordforjustice_prologue_65","text":"However, the letters in our code names also stand for something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_prologue_66","type":"Speech","speaker":"x","key":"Locale_SubScenario:event_lordforjustice_prologue_66","text":"To borrow the terminology you just used, one could say we're divided into the Upper and Lower Strata, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_prologue_67","type":"Speech","speaker":"x","key":"Locale_SubScenario:event_lordforjustice_prologue_67","text":"So tell me, what do you think that means?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_prologue_68","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_lordforjustice_prologue_68","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_prologue_69","type":"Speech","speaker":"x","key":"Locale_SubScenario:event_lordforjustice_prologue_69","text":"Remember what your name stands for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_prologue_70","type":"Speech","speaker":"x","key":"Locale_SubScenario:event_lordforjustice_prologue_70","text":"Accept the conseque