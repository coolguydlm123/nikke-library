","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_48","text":"You don't look so hot.","jump":"d_nikke_anis_sparklingsummer_03_59","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_49","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_49","text":"Good thinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_50","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_50","text":"There's not a whole lot in here, anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_51","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_51","text":"I did manage to glean some useful information, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_52","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_52","text":"Apparently the sunset here is prettier than the sunrise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_53","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_53","text":"The view from the hotel is especially nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_54","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_54",