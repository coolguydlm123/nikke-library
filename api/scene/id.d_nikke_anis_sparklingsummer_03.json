and begins to read.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_19","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_19","text":"I should look around as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_20","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_20","text":"Look on top of the table.","jump":"d_nikke_anis_sparklingsummer_03_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_21","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_21","text":"Look on top of the bed.","jump":"d_nikke_anis_sparklingsummer_03_25","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_22","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_22","text":"On top of the table is a picture frame containing what appears to be a family photo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_23","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_23","text":"After wiping off the obscuring layer of dust, I can see that it's a photo of a family standing on the beach. One of them is holding a surfboard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_24","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_24","text":"The all-too-familiar background clearly belongs to this very island.","jump":"d_nikke_anis_sparklingsummer_03_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_25","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_25","text":"Resting atop the bed are a plethora of rather adorable dolls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_26","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_26","text":"Time has not been kind to them; their cotton clothing has become brittle, and mold is forming on them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_27","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_27","text":"It is as if they've been placed there to fill the void left by someone's absence.","jump":"d_nikke_anis_sparklingsummer_03_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_weare","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_29","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_29","text":"Someone was living on this island.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_30","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_30","text":"They must have made this cave as a shelter to hide from the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_31","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_31","text":"That would explain that rather ingenious trap as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_32","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_32","text":"You wanna take a gander at this journal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_33","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_33","text":"Personally, I wouldn't recommend it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_34","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_34","text":"Read.","jump":"d_nikke_anis_sparklingsummer_03_36","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_35","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_35","text":"Don't read.","jump":"d_nikke_anis_sparklingsummer_03_49","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_36","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_36","text":"I take the journal from Anis and gingerly open it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_37","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_37","text":"The weather was nice so I went outside secretly.","jump":null,"exit":false,"enter":null,"bg":"Beach_d","bgArt":"beach_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_38","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_38","text":"Of course, I could have stormed out with all the bluster I wanted and no one would have known.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_39","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_39","text":"This island is safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_40","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_40","text":"And quiet. Almost painfully so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_41","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_41","text":"There are no grotesque monsters or other people sharing this island with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_42","type":"Narration","s