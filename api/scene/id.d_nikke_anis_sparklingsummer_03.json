_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_6","text":"I'm going in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_7","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_7","text":"*Creeeek*","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_8","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_8","text":"The dimly lit interior is very simple,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_9","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_9","text":"containing only a worn-down bed, sofa, table, and other bits of furniture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_10","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_10","text":"Everything is coated in a thick layer of dust, indicating how much time has passed since it was inhabited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_11","type":"Speech","speaker":"anis_s","key":"Locale_NikkeEpisode:d_nikke_anis_sparklingsummer_03_11","text":"How is electricity being supplied here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anis_sparklingsummer_03_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anis_spar