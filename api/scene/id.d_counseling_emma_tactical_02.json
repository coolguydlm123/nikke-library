al_02_6","type":"Speech","speaker":"emma_t","key":"Locale_Counseling:d_counseling_emma_tactical_02_6","text":"But I think it's really important to have squadmates who walk beside the leader and help carry the load.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_emma_tactical_02_7","type":"Speech","speaker":"emma_t","key":"Locale_Counseling:d_counseling_emma_tactical_02_7","text":"That way, the leader can keep running forward without having to stop.","jump":"d_counseling_emma_tactical_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_emma_tactical_02_8","type":"Speech","speaker":"emma_t","key":"Locale_Counseling:d_counseling_emma_tactical_02_8","text":"Hehe, I figured that's the way to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_emma_tactical_02_9","type":"Speech","speaker":"emma_t","key":"Locale_Counseling:d_counseling_emma_tactical_02_9","text":"Leader or member, we're all in the same squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_emma_tactical_02_10","type":"Speech","speaker":"emma_t","key":"Locale_Counseling:d_counseling_emma_tactical_02_10","text":"So I think it's best we stand side by side and be each other's strength.","jump":"d_counseling_emma_tactical_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_emma_tactical_02_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_emma_tactical_02_11","text":"Emma and I have a conversation about how to follow one's leader.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,