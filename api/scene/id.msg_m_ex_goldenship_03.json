{"id":"msg_m_ex_goldenship_03","cat":"messenger","group":{"id":"room_goldenship","label":"Golden Pirate Crew · Group"},"label":"2. Did everyone get home safely?","stage":null,"prev":"msg_m_ex_goldenship_01","next":"msg_m_ex_goldenship_04","speakers":{"mast":"Mast","frima_s":"Frima","anchor":"Anchor"},"icons":{"mast":"si_c350_00_s","frima_s":"si_c142_01_s","anchor":"si_c351_00_s"},"lines":[{"id":"msg_m_ex_goldenship_03_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 102310112 · After Blue EZS chat 1. Hey","key":null},{"id":"m_ex_goldenship_03_1","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_1","text":"Did everyone get home safely?","jump":null},{"id":"m_ex_goldenship_03_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_2","text":"Yeah, I'm in the Commander's Room.","jump":null},{"id":"m_ex_goldenship_03_3","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_3","text":"How about Frima?","jump":null},{"id":"m_ex_goldenship_03_4","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_4","text":"Yeah.","jump":null},{"id":"m_ex_goldenship_03_5","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_5","text":"At Cafe.","jump":null},{"id":"m_ex_goldenship_03_6","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_6","text":"Anchor?","jump":null},{"id":"m_ex_goldenship_03_7","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_7","text":"?","jump":null},{"id":"m_ex_goldenship_03_8","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_8","text":"You literally just said goodbye to me","jump":null},{"id":"m_ex_goldenship_03_9","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_9","text":"in the hallway.","jump":null},{"id":"m_ex_goldenship_03_10","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_10","text":"I know,","jump":null},{"id":"m_ex_goldenship_03_11","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_11","text":"but who's to say something couldn't have happened between then and now?","jump":null},{"id":"m_ex_goldenship_03_12","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_12","text":"Besides, since everyone else is reporting in,","jump":null},{"id":"m_ex_goldenship_03_13","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_13","text":"you might as well do the same.","jump":null},{"id":"m_ex_goldenship_03_14","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_14","text":"Okay, fine.","jump":null},{"id":"m_ex_goldenship_03_15","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_15","text":"I arrived back safe and sound.","jump":null},{"id":"m_ex_goldenship_03_16","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_16","text":"Morgan and I are all good as well.","jump":null},{"id":"m_ex_goldenship_03_17","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_17","text":"Oh.","jump":null},{"id":"m_ex_goldenship_03_18","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_18","text":"One thing.","jump":null},{"id":"m_ex_goldenship_03_19","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_19","text":"Golden drink.","jump":null},{"id":"m_ex_goldenship_03_20","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_20","text":"Where?","jump":null},{"id":"m_ex_goldenship_03_21","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_21","text":"Didn't you take it with you, Captain?","jump":null},{"id":"m_ex_goldenship_03_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_22","text":"I did.","jump":null},{"id":"m_ex_goldenship_03_23","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_23","text":"Okay, good.","jump":null},{"id":"m_ex_goldenship_03_24","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_24","text":"I thought we'd gotten distracted by the Golden Ship","jump":null},{"id":"m_ex_goldenship_03_25","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_25","text":"and left it there.","jump":null},{"id":"m_ex_goldenship_03_26","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_26","text":"I was so mesmerized by the Golden Ship","jump":null},{"id":"m_ex_goldenship_03_27","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_27","text":"that I forgot all about the elixir myself.","jump":null},{"id":"m_ex_goldenship_03_28","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_28","text":"It was only when we were","jump":null},{"id":"m_ex_goldenship_03_29","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_29","text":"on the elevator leading down to the Ark","jump":null},{"id":"m_ex_goldenship_03_30","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_30","text":"that I realized I'd forgotten to bring it.","jump":null},{"id":"m_ex_goldenship_03_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_31","text":"Yeah, everyone seemed a bit out of it, so I made sure to bring it.","jump":null},{"id":"m_ex_goldenship_03_32","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_32","text":"Good.","jump":null},{"id":"m_ex_goldenship_03_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_33","text":"Can't be leaving precious treasure like this behind.","jump":null},{"id":"m_ex_goldenship_03_34","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_34","text":"!","jump":null},{"id":"m_ex_goldenship_03_35","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_35","text":"Very good.","jump":null},{"id":"m_ex_goldenship_03_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_36","text":"Do you want to drink some now?","jump":null},{"id":"m_ex_goldenship_03_37","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_37","text":"No.","jump":null},{"id":"m_ex_goldenship_03_38","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_38","text":"Said I drank it.","jump":null},{"id":"m_ex_goldenship_03_39","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_39","text":"Sugar and Milk","jump":null},{"id":"m_ex_goldenship_03_40","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_40","text":"want some.","jump":null},{"id":"m_ex_goldenship_03_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_41","text":"We can always share.","jump":null},{"id":"m_ex_goldenship_03_42","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_42","text":"No!","jump":null},{"id":"m_ex_goldenship_03_43","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_43","text":"Waste.","jump":null},{"id":"m_ex_goldenship_03_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_44","text":"Heh, maybe you're right.","jump":null},{"id":"m_ex_goldenship_03_45","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_45","text":"Yeah, we shouldn't be too generous with it.","jump":null},{"id":"m_ex_goldenship_03_46","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_46","text":"Definitely.","jump":null},{"id":"m_ex_goldenship_03_47","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_47","text":"Well, for the time being,","jump":null},{"id":"m_ex_goldenship_03_48","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_48","text":"we'll leave the bottle with you, Captain.","jump":null},{"id":"m_ex_goldenship_03_49","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_49","text":"Whenever adventure comes knocking,","jump":null},{"id":"m_ex_goldenship_03_50","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_50","text":"the Golden Pirates will","jump":null},{"id":"m_ex_goldenship_03_51","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_51","text":"band together once again","jump":null},{"id":"m_ex_goldenship_03_52","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_52","text":"and have a few swigs of the fabled elixir!","jump":null},{"id":"m_ex_goldenship_03_53","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_53","text":"Good idea.","jump":null},{"id":"m_ex_goldenship_03_54","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_54","text":"I like it.","jump":null},{"id":"m_ex_goldenship_03_55","type":"Speech","speaker":"mast","key":"Locale_SuddenMessage:m_ex_goldenship_03_55","text":"Until next time!","jump":null},{"id":"m_ex_goldenship_03_56","type":"Speech","speaker":"frima_s","key":"Locale_SuddenMessage:m_ex_goldenship_03_56","text":"Okay.","jump":null},{"id":"m_ex_goldenship_03_57","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_goldenship_03_57","text":"See you around.","jump":null},{"id":"m_ex_goldenship_03_58","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_03_58","text":"Bye bye.","jump":null}],"chat":true}