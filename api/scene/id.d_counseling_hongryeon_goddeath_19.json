{"id":"d_counseling_hongryeon_goddeath_19","cat":"counsel","group":{"id":"char5186","label":"Scarlet: Goddeath"},"label":"Advising Scarlet: Goddeath: 19","stage":null,"prev":"d_counseling_hongryeon_goddeath_18","next":"d_counseling_hongryeon_goddeath_20","speakers":{"hongryeon_g":"Scarlet"},"icons":{"hongryeon_g":"si_c472_00_s"},"lines":[{"id":"d_counseling_hongryeon_goddeath_19_1","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_1","text":"'Tis a pity that so few Nikkes wield the sword.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon_g"],"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_2","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_2","text":"Such a splendid weapon, it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_3","text":"Well, guns are just easier to use.","jump":"d_counseling_hongryeon_goddeath_19_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_goddeath_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_4","text":"Yeah, swords are definitely cooler.","jump":"d_counseling_hongryeon_goddeath_19_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_goddeath_19_5","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_5","text":"Aye, that standeth to reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_6","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_6","text":"'Tis but a shame that many there be who know naught of the manifold charms of a sword.","jump":"d_counseling_hongryeon_goddeath_19_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_7","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_7","text":"Lo, my Lord hath a discerning eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_8","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_8","text":"All fear the foe who standeth before them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_9","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_9","text":"Yet one who bears the sword must overcome that fear, draw nigh unto the foe, and strike beneath the chin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_10","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_10","text":"Is that not the truest path to conquering oneself?","jump":"d_counseling_hongryeon_goddeath_19_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_19_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_19_11","text":"Scarlet explains to me what makes swords unique.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}