{"id":"d_counseling_liter_03","cat":"counsel","group":{"id":"char5011","label":"Liter"},"label":"Advising Liter: 03","stage":null,"prev":"d_counseling_liter_02","next":"d_counseling_liter_04","speakers":{"liter":"Liter"},"icons":{"liter":"si_c082_00_s"},"lines":[{"id":"d_counseling_liter_03_1","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_03_1","text":"Do you ever think about leashes?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["liter"],"affinity":"_0"},{"id":"d_counseling_liter_03_2","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_03_2","text":"A lot of people think a leash restricts a dog's freedom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_03_3","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_03_3","text":"But what do you think, Greenhorn?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_03_4","text":"It's about their safety, not their freedom.","jump":"d_counseling_liter_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_liter_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_03_5","text":"Dogs deserve their freedom.","jump":"d_counseling_liter_03_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_liter_03_6","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_03_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null