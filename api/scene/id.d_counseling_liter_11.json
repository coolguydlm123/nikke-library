{"id":"d_counseling_liter_11","cat":"counsel","group":{"id":"char5011","label":"Liter"},"label":"Advising Liter: 11","stage":null,"prev":"d_counseling_liter_10","next":"d_counseling_liter_12","speakers":{"liter":"Liter"},"icons":{"liter":"si_c082_00_s"},"lines":[{"id":"d_counseling_liter_11_1","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_1","text":"I have a long-time customer. He's been coming to Mighty Tools for over 10 years.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["liter"],"affinity":"_0"},{"id":"d_counseling_liter_11_2","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_2","text":"We're actually close enough that we've gone out to eat a couple of times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_3","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_3","text":"However, I recently discovered he's been tampering with the construction funds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_4","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_4","text":"I'm at a loss. What do I do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_11_5","text":"Give him a piece of your mind.","jump":"d_counseling_liter_11_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_liter_11_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_11_6","text":"Let it slide so your relationship can remain intact.","jump":"d_counseling_liter_11_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_liter_11_7","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_7","text":"That's what I was thinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_8","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_8","text":"But I keep psyching myself out and can't take the plunge. I was hoping someone could give me one last push.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_9","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_9","text":"And thanks to you, I got just that!","jump":"d_counseling_liter_11_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_10","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_10","text":"You're right. He and I have a good thing going with our friendship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_11","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_11","text":"No matter what, I won't jeopardize that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_12","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_11_12","text":"Gosh, living in this world sure isn't easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_11_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_liter_11_13","text":"Liter tells me more about this customer that was giving her trouble.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}