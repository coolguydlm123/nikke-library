{"id":"d_counseling_mary_13","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 13","stage":null,"prev":"d_counseling_mary_12","next":"d_counseling_mary_14","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_13_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_13_1","text":"We've been having a lot of patients who have been exaggerating their symptoms.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_13_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_13_2","text":"Hooting and hollering about being scared of shots, even crying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_13_3","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_13_3","text":"How on earth am I supposed to administer a shot to these people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_13_4","text":"Flash them a big smile.","jump":"d_counseling_mary_13_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_13_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_13_5","text":"Distract them by talking about something else, then give them a stealthy jab.","jump":"d_counseling_mary_13_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_13_6","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseli