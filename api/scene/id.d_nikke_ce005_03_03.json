keEpisode:d_nikke_ce005_03_03_19","text":"Please excuse me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_03_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_03_20","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_03_21","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_03_21","text":"Mary doesn't seem to know the meaning of rest...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_03_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_03_22","text":"Nikkes are definitely different from us, but Mary especially tends to push herself too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_03_23","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_03_23","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_03_24","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_03_24","text":"Nikkes also needs rest. Commander, please try to convince Mary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_03_25","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_03_25","text":"I'm on it. But why did you go into the operating room?","jump":"d_nikke_ce005_03_03_27","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":nu