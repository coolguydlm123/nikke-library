{"id":"event_ce006_1_03_s","cat":"event","group":{"id":"ev40079","label":"MEMORIES TELLER · Part 1"},"label":"Roam and Com: A","stage":null,"prev":"event_ce006_1_02_e","next":"event_ce006_1_03_e","speakers":{"ce006_03":"Lily","ce006_npc_01":"Adam","roam":"Roam","anis":"Anis","ce006_01":"EVE","rapi":"Rapi","neon":"Neon","com":"Com"},"icons":{"ce006_03":"si_c852_00_s","ce006_npc_01":"si_c853_00_s","roam":"si_c931_00_s","anis":"si_c012_00_s","ce006_01":"si_c850_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","com":"si_c931_00_s"},"lines":[{"id":"event_ce006_1_03_s_1","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_1","text":"Let's see... Hmm... Okay, with these parts, I think we can manage.","jump":null,"exit":false,"enter":null,"bg":"artcity_d","bgArt":"artcity_d","image":null,"bgm":"collab_bgm_sb_field_floodedcs_inst","movie":null,"shown":["ce006_01","ce006_npc_01","ce006_03","roam","rapi","anis"],"affinity":null},{"id":"event_ce006_1_03_s_2","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_2","text":"Ideally we'd be able to check the compatibility and all that, but given our current situation, that's pretty much impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_3","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_3","text":"Let's just get this over and done with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_4","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_4","text":"As far as I can tell, I think an emergency fix should do the trick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_5","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_5","text":"Let's work together. You check the drive system and swap out the parts while I keep an eye on the control system.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_6","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_6","text":"I'd hate to be ambushed at a time like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_7","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_7","text":"You're telling me. I'd take any help I could get right about now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_8","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_8","text":"Well, I'm afraid you'll have to settle for these two junkers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_9","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_s_9","text":"Can you fix Roam's friend?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_10","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_10","text":"Hmm... not sure. I've never seen this type of robot before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_11","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_s_11","text":"Useless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_12","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_12","text":"Excuse me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_13","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_s_13","text":"Useless. As in you have no ability.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_14","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_14","text":"What the— Nobody insults me like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_15","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_15","text":"Get out of the way! I'll fix this robot friend of yours if it's the last thing I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_s_16","text":"... You okay there, Lily?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_17","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_17","text":"I, Lily Artemis II, am capable of handling any technology!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_18","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_18","text":"A robot is the technological pinnacle of whichever world it hails from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_19","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_19","text":"I'll prove to you that I can even fix technologies from other worlds!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_20","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_20","text":"Um, don't you think the Tetrapod is a tad more urgent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_21","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_21","text":"No, I don't!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_22","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_03_s_22","text":"I'm inclined to agree with Adam here...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_23","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_23","text":"Everyone, quiet! I need to concentrate!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_24","type":"Speech","speaker":"ce006_01","key":"Locale_MainScenario:event_ce006_1_03_s_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_1_03_s_25","text":"... Roam and I will assist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_26","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_s_26","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_27","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_s_27","text":"Lily, Roam, and Rapi begin examining the robot Roam picked up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon"],"affinity":null},{"id":"event_ce006_1_03_s_28","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_29","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_29","text":"So what do we do? Wait?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_30","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_s_30","text":"Is there anything we can help with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_31","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_31","text":"I don't think so, not at the moment at least. We can only hope that Lily fixes that robot quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_32","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_32","text":"Oh, by the way, while you guys were out gathering parts, I checked out the surroundings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_33","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_33","text":"There's nothing particularly special in the area. Just some run-of-the-mill ruins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_34","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_34","text":"If I had to pick anything that stood out, it would be that lake over there. It seems like it was originally the ground level of this city.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_35","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_35","text":"The water is too murky to get a good look inside, but it seems deep. I think it's best we give it a wide berth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_36","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_03_s_36","text":"Can I go for a swim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_37","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_37","text":"I'd give that a hard pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_38","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_38","text":"For some reason, the water is electrified.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_39","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_39","text":"If you took a dip, you'd end up getting fried. So I'd save the swimming for another day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_03_s_40","text":"I can still dream about it though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_41","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_41","text":"... Well, I certainly can't stop you from doing that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_03_s_42","text":"Can we go fishing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_43","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_43","text":"I doubt it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_44","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_44","text":"Considering how much electricity is coursing through that water, there's no way any fish would survive in there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_45","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_1_03_s_45","text":"What about electric eels? Maybe there's some of those in there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_46","type":"Speech","speaker":"ce006_npc_01","key":"Locale_MainScenario:event_ce006_1_03_s_46","text":"Ooh, touché.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_s_47","text":"What in the world is this conversation I'm listening to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_48","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_48","text":"Everyone! Come here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce006_03"],"affinity":null},{"id":"event_ce006_1_03_s_49","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_49","text":"It's all fixed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_1_03_s_50","text":"The robot Roam picked up rattles as it looks around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["roam","rapi","com"],"affinity":null},{"id":"event_ce006_1_03_s_51","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_s_51","text":"You fixed it already?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_52","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_52","text":"I told you I could do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_53","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_s_53","text":"There was a fuse missing. She took one from mine and plugged it in, and it came to life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_54","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_1_03_s_54","text":"... So all you did was swap the batteries?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_55","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_55","text":"W-well, I'm still the one who figured out what the problem was!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_56","type":"Speech","speaker":"roam","key":"Locale_MainScenario:event_ce006_1_03_s_56","text":"That's right. Lily figured it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1_03_s_57","type":"Speech","speaker":"ce006_03","key":"Locale_MainScenario:event_ce006_1_03_s_57","text":"Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_1