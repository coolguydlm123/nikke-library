a_04_12","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_04_12","text":"they poured money into creating an environment that would allow us to mass produce these flowers without any need for sunlight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_04_13","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_04_13","text":"... But there was a bit of a problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_04_14","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_04_14","text":"Sakura snips the stem of a flower with her scissors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_04_15","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_04_15","text":"*Snap*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_04_16","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_04_16","text":"The pollen of this flower contains lethal doses of toxins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_04_17","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_04_17","text":"Those who attempt to cultivate it end up dead before long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_04_18","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_04_18","text":"*Snap*","jump":null,"exit":false,"enter":null,"bg":null,"b