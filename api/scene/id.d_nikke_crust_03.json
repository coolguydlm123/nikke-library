":"Locale_NikkeEpisode:d_nikke_crust_03_7","text":"Don't touch that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_8","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_8","text":"If my memory serves me correctly, that's poisonous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_9","type":"Speech","speaker":"bready","key":"Locale_NikkeEpisode:d_nikke_crust_03_9","text":"One taste of that and your head will be spinning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_10","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_10","text":"I'm starting to think these two would be better off without my \"help\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_11","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_11","text":"*Wiggle*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_12","text":"Oooh, a worm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_13","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_13","text":"We've done research on worms, so we don't need any more of those.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_14","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_14","text":"You eat worms as well?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_15","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_15","text":"Of course. There are many more edible things in this world than you think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_16","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_16","text":"You can boil, fry, or even make a broth out of worms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_17","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_17","text":"It's simply that their texture and flavor make them a bit divisive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_18","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_18","text":"What with them being so squishy and all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_19","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_19","text":"I want to come up with recipes we can use in the event of a food scarcity up on the surface, and—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_20","type":"Speech","speaker":"bready","key":"Locale_NikkeEpisode:d_nikke_crust_03_20","text":"Crust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_21","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_21","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_22","type":"Speech","speaker":"bready","key":"Locale_NikkeEpisode:d_nikke_crust_03_22","text":"Bonne Bouche doesn't look so good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_23","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_23","text":"Oh my gosh, you're right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_24","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_24","text":"Are you okay, Mr. Gourmand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_25","text":"Yeah... I'm okay. I appreciate the rather... detailed explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_26","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_26","text":"But at this rate, I don't think I'm going to be of much help to you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_27","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_27","text":"That's not true!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_28","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_28","text":"Bready and I have tried almost everything there is, so sometimes we tend to miss something that may be obvious to others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_29","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_29","text":"I think it's really nice that you ask questions from your perspective.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_30","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_30","text":"I'm glad you feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_31","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_31","text":"We'll keep looking around, so please, keep informing us whenever you find anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_32","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_32","text":"Okay, will do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_33","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_33","text":"Afterwards, I continue letting Bready and Crust know what I see,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_34","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_34","text":"but each time, it ends up either being something we can't use, or an ingredient they'd already conducted research on.","jump":null,"exit":false,"enter":null,"bg":"land_n","bgArt":"land_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_35","type":"Speech","speaker":"bready","key":"Locale_NikkeEpisode:d_nikke_crust_03_35","text":"I finished installing the decoys.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_36","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_36","text":"Thanks, Bready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_37","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_37","text":"We can set our blanket down here","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_38","type":"Speech","speaker":"crust","key":"Locale_NikkeEpisode:d_nikke_crust_03_38","text":"and enjoy our meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_39","type":"Speech","speaker":"bready","key":"Locale_NikkeEpisode:d_nikke_crust_03_39","text":"Whoohoo!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_40","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_40","text":"*Clank blank*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_frostpillar","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crust_03_41","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crust_03_41","text":"Is this really the appropriate t