{"id":"d_main_19af_02","cat":"main","group":{"id":"ch19","label":"Chapter 19 · Eden"},"label":"Operation: Fight off the Heretics","stage":null,"prev":"d_main_19af_01","next":null,"speakers":{"anis":"Anis","papillon":"Papillon","Monologue":"Monologue","Self":"Commander","neon":"Neon","rapi":"Rapi","Narration":"Narration","dorothy":"Dorothy"},"icons":{"anis":"si_c012_00_s","papillon":"si_c890_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","Narration":"si_c999_00_s","dorothy":"si_c233_00_s"},"lines":[{"id":"d_main_19af_02_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_1","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":"EdenIndoor","bgArt":"edenindoor","image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":["rapi","anis","papillon","neon"],"affinity":null},{"id":"d_main_19af_02_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_2","text":"You're safe! We were so worried that something had happened to y...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_3","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_3","text":"Honey!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_4","type":"Monologue","speaker":"Monologue","key":"Locale_MainScenario:d_main_19af_02_4","text":"Papillon hugs me tightly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_5","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_5","text":"We were worried sick about you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_6","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_6","text":"Are you hurt? Let me kiss your boo-boos and make it all better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_7","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_7","text":"I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_9","text":"Mwwwah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_10","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_10","text":"Ech!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_11","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_11","text":"Why're you kissing my forehead?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_12","text":"You just said you should kiss boo-boos to make them better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_13","text":"I figured there was something wrong with your brain, so I thought a smooch there might help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_14","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_14","text":"... Very funny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_15","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_15","text":"How did all of you...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_16","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19af_02_16","text":"We managed to pass that deranged test of theirs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_17","text":"Individually, I might add.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_18","text":"That numbskull with the shield said if we managed to pin her to the ground, we could pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_19","text":"That motormouth was the worst part of the entire ordeal. We couldn't shut her up if we tried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_20","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_20","text":"I had to take down a flying bomber. It was so hard!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_21","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_21","text":"I also went through the test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_22","text":"What?! How did you make it out in one piece?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_23","text":"In the heat of battle, you must have turned to firepower as your savior, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_24","type":"Monologue","speaker":"Monologue","key":"Locale_MainScenario:d_main_19af_02_24","text":"I regale the squad with the tale of Harran's test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_25","text":"But why subject humans to the same test? What do they have against you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_26","text":"I don't see the point in trying to weed out people like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_27","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_27","text":"If you really think it over,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_28","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_28","text":"I suppose I can see where they're coming from. They only want to be with those who have proven themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_29","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_29","text":"But to try and say that they're helping us by doing all this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_30","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_30","text":"is a bit rich.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_32","text":"Did Harran mention her great plan to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_33","text":"Nod.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_34","text":"What are you planning on doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_35","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_35","text":"I'm not sure. What do you all think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_36","text":"To be honest, I'm leaning towards turning her down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_37","text":"But if we decline, then we may lose our only opportunity to get our hands on Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_38","text":"Knowing you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_39","text":"I'm sure you're not keen on taking on all of Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_40","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_40","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_41","text":"I guess it's decided, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_42","text":"If it's a Heretic, we'd have to go up against them eventually anyway, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_43","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_43","text":"You do realize that if we accept their proposal,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_44","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19af_02_44","text":"we're aligning ourselves with that psychopath Johan, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_45","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19af_02_45","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_46","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_47","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_47","text":"Hmm... what if he tosses Master out of another window?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_48","text":"I'd like to see him try. If he does, we'll toss him even further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_49","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19af_02_49","text":"I should practice my throws.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_50","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_50","text":"... If it comes to that, I'll leave it to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_51","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_19af_02_51","text":"... Soon after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_52","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_52","text":"I've been told that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_inark","movie":null,"shown":["dorothy","anis"],"affinity":null},{"id":"d_main_19af_02_53","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_53","text":"you've agreed to our proposition?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_54","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_54","text":"We have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_55","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_55","text":"Excellent. I have good news for you as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_56","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_56","text":"I was successful in persuading Cecil about our deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_57","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_57","text":"The operation to exterminate the Heretic will take place tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_58","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_19af_02_58","text":"I thought Johan was the one to convince.","jump":"d_main_19af_02_60","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_59","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_19af_02_59","text":"Don't we need more time?","jump":"d_main_19af_02_64","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_60","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_60","text":"I felt it would be easier to sway Cecil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_61","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_61","text":"Usually, when Cecil makes a decision, then the comman... I mean, Johan, typically agrees.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_62","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_62","text":"Slight disagreements are commonplace during operations such as this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_63","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_63","text":"but I'll be there to mediate should any such instances occur, so there's no need to worry.","jump":"d_main_19af_02_68","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_64","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_64","text":"Delaying our plans will only hurt us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_65","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_65","text":"Just as we are monitoring every move the Heretic makes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_66","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_66","text":"she is doing precisely the same to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_67","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_67","text":"If we want any hope of catching her unawares, we must make a move before she discovers we have secured the Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_68","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_68","text":"As a gesture of trust, allow me to bestow this upon you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_69","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_19af_02_69","text":"Dorothy handed over a loaded handgun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_70","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_70","text":"The first bullet is Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_71","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_71","text":"Don't forget.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_72","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_72","text":"Make sure you don't use it unless it is absolutely necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_73","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_73","text":"Why are you doing this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_74","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_74","text":"Why give us the Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19af_02_75","text":"We could run off in the middle of the night and take it along with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_76","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_76","text":"It's hard to explain. None of you seem like someone who would do such a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_77","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_77","text":"Also, if something like that were to happen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_78","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_78","text":"we have a tracker who can take to the skies and reach Mach speed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_79","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_79","text":"I assure you, she always nabs her prey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_80","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_80","text":"We won't run away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_81","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19af_02_81","text":"This Heretic is our enemy as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_82","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_82","text":"I knew I could count on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_83","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_83","text":"You mustn't be nervous about tomorrow's operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_84","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_84","text":"We may have never won against a Heretic,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_85","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_85","text":"but by the same token, we've never lost either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_86","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_86","text":"Now that we've got an ace up our sleeve,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19af_02_87","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_19af_02_87","text":"I'm certain that victory is within our grasp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}