":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_03_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_03_7","text":"This isn't right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_03_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_03_8","text":"But no one can overturn Enikk's decision. Her judgment is absolute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_03_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_03_9","text":"At least the squad will continue on. This isn't a farewell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_03_10","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_03_10","text":"What will happen if your memory is erased?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_03_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_03_11","text":"We'll revert back to the way we were fresh off the assembly line. We won't remember a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_03_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04af_03_12","text":"I've heard that in most cases the combat data remains, but everything else...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_03_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario