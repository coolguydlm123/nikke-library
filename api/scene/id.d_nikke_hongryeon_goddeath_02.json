{"id":"d_nikke_hongryeon_goddeath_02","cat":"bond","group":{"id":"char5186","label":"Scarlet: Goddeath"},"label":"A Sisterly Bond","stage":null,"prev":"d_nikke_hongryeon_goddeath_01","next":"d_nikke_hongryeon_goddeath_03","speakers":{"cecil":"Cecil","hongryeon_g":"Scarlet"},"icons":{"cecil":"si_c929_00_s","hongryeon_g":"si_c472_00_s"},"lines":[{"id":"d_nikke_hongryeon_goddeath_02_1","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_1","text":"Cecil leads Scarlet farther into the laboratory.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_story_repaircenter","movie":null,"shown":["hongryeon_g","cecil"],"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_2","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_2","text":"She then picks up an item from her desk and holds it out to Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_3","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_3","text":"Take this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_4","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_4","text":"Rose's hair ornament.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_5","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_5","text":"That thou wouldst show me this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_6","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_6","text":"Yes, your body was built using Rose's as a base.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_7","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_7","text":"Even with Eden and the Ark's Nikke manufacturing technology,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_8","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_8","text":"we couldn't have brought you back without using Rose's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_9","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_9","text":"To explain in more detail, your original body was mass-produced, so—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_10","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_10","text":"Nay, thou needst not trouble thyself with further explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_11","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_11","text":"I seek but one answer from thee:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_12","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_12","text":"What befell Rose in her final moments?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_13","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_14","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_14","text":"Rose was moving without a core,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_15","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_15","text":"driven solely by the instincts brought on by corruption, with no capacity for rational thought...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_16","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_16","text":"In that sense, she was essentially a zombie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_17","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_17","text":"But she sacrificed herself to give you her body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_18","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_18","text":"So her concern for me was born of instinct, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_19","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_19","text":"You could say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_20","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_20","text":"Prithee, by what means did Rose sacrifice herself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_21","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_21","text":"... First, I owe you an apology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_22","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_22","text":"If there had been a way to save you both, I would have looked for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_23","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_23","text":"I bear thee no blame.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_24","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_24","text":"I desire only to know how she met her end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_25","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_25","text":"Cecil closes her eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_26","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_26","text":"It's not a memory I'd care to revisit, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_27","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_27","text":"Rose stabbed herself in the head","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_28","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_28","text":"so I could revive you without hesitation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_29","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_29","text":"Truly... an end most befitting her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_30","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_30","text":"I'm truly sorry I couldn't save Rose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_31","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_31","text":"I understand if you resent me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_32","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_32","text":"By thy grace, I was granted one final chance to see mine elder sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_33","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_33","text":"How could I ever lay the blame upon thee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_34","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_34","text":"And yet, I daresay thou hast grown somewhat gentler thyself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_35","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_35","text":"... I'm only human, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_36","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_36","text":"I lost my comrades over nothing more than wounded pride and trivial ideals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_37","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_37","text":"I regretted it only after it was too late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_38","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_38","text":"After suffering one loss after another, I suppose I've grown a little softer...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_39","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_39","text":"No, perhaps weaker is the better word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_40","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_40","text":"Chide thyself not so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_41","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_41","text":"Folk oft speak as though it were folly to mend the stable door once the horse hath bolted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_42","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_42","text":"Yet what ill is there in mending it, though the horse be lost?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_43","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_43","text":"For such is the nature of man: he knoweth not the worth of a mended stable door till his horse hath fled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_44","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_44","text":"... Thank you for saying that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_45","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_45","text":"Come now, square thy shoulders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_46","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_46","text":"Surely Eden's finest mind should not look so downcast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_47","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_48","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_48","text":"Let's move on to practical matters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_distress","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_49","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_49","text":"First, check your body over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_50","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_50","text":"Let me know if you experience any discomfort,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_51","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_51","text":"if there's anything you're dissatisfied with,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_52","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_52","text":"or if you need anything else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_53","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_53","text":"I'll make any necessary adjustments promptly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_54","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_54","text":"A matter yet to be set aright...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_55","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_55","text":"Scarlet gazes at the dormant red blade floating beside her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_56","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_56","text":"Might my sister's blade and mine be joined as one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_57","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_57","text":"*Shiing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_58","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_58","text":"She draws her sword,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_59","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_59","text":"then quickly sheathes it with a clack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_60","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_60","text":"I have need of naught else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_61","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_61","text":"Are you sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_62","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_62","text":"If there's anything you need, just let me know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_63","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_63","text":"There's no need to hold back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_64","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_64","text":"This alone shall suffice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_65","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_65","text":"A swordsman need only take a blade in hand","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_66","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_66","text":"to know whether it befits him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_67","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_67","text":"And my hand doth know this blade was wrought for me alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_68","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_68","text":"So there's no need to test it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_69","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_69","text":"What better practice couldst thou find than battle itself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_70","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_70","text":"Though I can't say I recommend it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_71","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_71","text":"If that's your decision, I have nothing more to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_72","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_72","text":"Still, if you change your mind before we depart, let me know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_73","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_73","text":"We're short on time, so I can't prepare much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_74","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_74","text":"But I'll do what I can...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_75","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_75","text":"Weapons, equipment, whatever you need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_76","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_76","text":"If that be so, I have but one favor to ask of thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_77","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_77","text":"Go ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_02_78","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_02_78","text":"Might I behold the flowers that bloom in Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}