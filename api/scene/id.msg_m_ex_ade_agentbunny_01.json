{"id":"msg_m_ex_ade_agentbunny_01","cat":"messenger","group":{"id":"room_ade","label":"Ade · Nikke"},"label":"4. Master,","stage":null,"prev":"msg_m_ex_ade_03","next":"msg_m_ex_ade_agentbunny_02","speakers":{"ade_b":"Ade"},"icons":{"ade_b":"si_c315_00_s"},"lines":[{"id":"m_ex_ade_agentbunny_01_1","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_1","text":"Master,","jump":null},{"id":"m_ex_ade_agentbunny_01_2","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_2","text":"may I have a moment of your time?","jump":null},{"id":"m_ex_ade_agentbunny_01_3","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_3","text":"There is something I wish to discuss with you concerning our future plans.","jump":null},{"id":"m_ex_ade_agentbunny_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_4","text":"Sure, what's the matter?","jump":null},{"id":"m_ex_ade_agentbunny_01_5","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_5","text":"Well,","jump":null},{"id":"m_ex_ade_agentbunny_01_6","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_6","text":"as I will now be serving as a secret agent,","jump":null},{"id":"m_ex_ade_agentbunny_01_7","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_7","text":"I believe there will be occasions when I must contact you.","jump":null},{"id":"m_ex_ade_agentbunny_01_8","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_8","text":"Rather than establishing a new means of communication,","jump":null},{"id":"m_ex_ade_agentbunny_01_9","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_9","text":"I would like to continue using this one.","jump":null},{"id":"m_ex_ade_agentbunny_01_10","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_10","text":"Would that be all right with you?","jump":null},{"id":"m_ex_ade_agentbunny_01_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_11","text":"That's fine.","jump":null},{"id":"m_ex_ade_agentbunny_01_12","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_12","text":"I see.","jump":null},{"id":"m_ex_ade_agentbunny_01_13","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_13","text":"That's a relief. :)","jump":null},{"id":"m_ex_ade_agentbunny_01_14","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_14","text":"Henceforth,","jump":null},{"id":"m_ex_ade_agentbunny_01_15","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_15","text":"I shall continue to use this","jump":null},{"id":"m_ex_ade_agentbunny_01_16","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_16","text":"to contact you, Master.","jump":null},{"id":"m_ex_ade_agentbunny_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_17","text":"Okay.","jump":null},{"id":"m_ex_ade_agentbunny_01_18","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_18","text":"Hehe.","jump":null},{"id":"m_ex_ade_agentbunny_01_19","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_19","text":"Thank you kindly. :)","jump":null},{"id":"m_ex_ade_agentbunny_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_20","text":"But Ade...","jump":null},{"id":"m_ex_ade_agentbunny_01_21","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_21","text":"Yes, Master?","jump":null},{"id":"m_ex_ade_agentbunny_01_22","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_22","text":"Is something the matter?","jump":null},{"id":"m_ex_ade_agentbunny_01_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_23","text":"Did you change your profile picture?","jump":null},{"id":"m_ex_ade_agentbunny_01_24","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_24","text":"Oh, that?","jump":null},{"id":"m_ex_ade_agentbunny_01_25","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_25","text":"Well,","jump":null},{"id":"m_ex_ade_agentbunny_01_26","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_26","text":"I merely thought that setting a new profile picture","jump":null},{"id":"m_ex_ade_agentbunny_01_27","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_27","text":"would make it easier for you, Master, to recognize that I am currently on a mission.","jump":null},{"id":"m_ex_ade_agentbunny_01_28","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_28","text":"I had no other intention.","jump":null},{"id":"m_ex_ade_agentbunny_01_29","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_29","text":"It is solely to prevent any misunderstandings from others.","jump":null},{"id":"m_ex_ade_agentbunny_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_30","text":"Hehe, it's fine.","jump":null},{"id":"m_ex_ade_agentbunny_01_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_31","text":"I like it.","jump":null},{"id":"m_ex_ade_agentbunny_01_32","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_32","text":"Ah...","jump":null},{"id":"m_ex_ade_agentbunny_01_33","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_33","text":"... Ade doesn't reply for a while.","jump":null},{"id":"m_ex_ade_agentbunny_01_34","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_34","text":"I apologize.","jump":null},{"id":"m_ex_ade_agentbunny_01_35","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_35","text":"I was momentarily at a loss for words,","jump":null},{"id":"m_ex_ade_agentbunny_01_36","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_36","text":"and thus my reply was delayed.","jump":null},{"id":"m_ex_ade_agentbunny_01_37","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_37","text":"I am relieved to hear that it pleases you, Master.","jump":null},{"id":"m_ex_ade_agentbunny_01_38","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_38","text":"Henceforth,","jump":null},{"id":"m_ex_ade_agentbunny_01_39","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_39","text":"whenever I am on a mission, I shall use this profile picture.","jump":null},{"id":"m_ex_ade_agentbunny_01_40","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_40","text":"I would be grateful if upon seeing it,","jump":null},{"id":"m_ex_ade_agentbunny_01_41","type":"Speech","speaker":"ade_b","key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_41","text":"you could interpret the context of my messages accordingly, Master.","jump":null},{"id":"m_ex_ade_agentbunny_01_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_ade_agentbunny_01_42","text":"Sure thing, haha.","jump":null}],"chat":true}