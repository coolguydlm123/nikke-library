{"id":"d_main_28_04_s","cat":"main","group":{"id":"ch28","label":"Chapter 28 · The Unknown"},"label":"Exploration: A","stage":"28-25 STAGE · Start","prev":"d_main_28_03","next":"d_main_28_04_e","speakers":{"liveryn":"Liveryn","elegg":"Elegg","anis":"Anis","neon":"Neon","rapi":"Rapi","hammering":"Hammering"},"icons":{"liveryn":"si_c480_00_s","elegg":"si_c500_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","hammering":"si_c490_00_s"},"lines":[{"id":"d_main_28_04_s_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_28_04_s_1","text":"After taking some deep breaths, Liveryn manages to calm herself down.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"bgm_destroyingcalamity_a","movie":null,"shown":["elegg","liveryn","hammering","rapi","anis","neon"],"affinity":null},{"id":"d_main_28_04_s_2","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_04_s_2","text":"... I'm okay now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_3","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_04_s_3","text":"I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_4","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_04_s_4","text":"No, I'm sorry. I didn't mean what I said back there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_5","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_04_s_5","text":"It's all right. I overreacted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_6","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_04_s_6","text":"Don't worry about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_7","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_28_04_s_7","text":"Okay...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_28_04_s_8","text":"What happened back there, anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_28_04_s_9","text":"You really fell apart. That can't be normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_28_04_s_10","text":"You were hyperventilating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_28_04_s_11","text":"Was it perhaps triggered by some past trauma?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_12","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_04_s_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_13","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_04_s_13","text":"Liveryn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_14","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_04_s_14","text":"I don't want to die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_15","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_28_04_s_15","text":"Huh? N-neither do I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_16","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_04_s_16","text":"I volunteered for this mission so that I could better my life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_17","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_04_s_17","text":"But it's not worth giving my life for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_18","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_04_s_18","text":"I can't better my life if I lose it entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_19","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_04_s_19","text":"The same applies to you; all of this will be for naught if you end up dead because of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_28_04_s_20","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_28_04_s_20","text":"I refuse to go any further until you