{"id":"msg_m_ex_poli_01","cat":"messenger","group":{"id":"room_poli","label":"Poli · Nikke"},"label":"1. Hi, Commander,","stage":null,"prev":null,"next":"msg_m_ex_poli_02","speakers":{"poli":"Poli"},"icons":{"poli":"si_c030_00_s"},"lines":[{"id":"m_ex_poli_01_1","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_1","text":"Hi, Commander,","jump":null},{"id":"m_ex_poli_01_2","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_2","text":"my name is Poli!","jump":null},{"id":"m_ex_poli_01_3","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_3","text":"Nice to finally meet you","jump":null},{"id":"m_ex_poli_01_4","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_4","text":"and pleased to be working with you.","jump":null},{"id":"m_ex_poli_01_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_5","text":"Same here.","jump":null},{"id":"m_ex_poli_01_6","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_6","text":"Hehe!","jump":null},{"id":"m_ex_poli_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_7","text":"So, what do you do?","jump":null},{"id":"m_ex_poli_01_8","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_8","text":"I'm a police officer who is","jump":null},{"id":"m_ex_poli_01_9","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_9","text":"in charge of keeping","jump":null},{"id":"m_ex_poli_01_10","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_10","text":"all citizens in the Ark safe!","jump":null},{"id":"m_ex_poli_01_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_11","text":"What an important role!","jump":null},{"id":"m_ex_poli_01_12","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_12","text":"If you're ever in a tough spot,","jump":null},{"id":"m_ex_poli_01_13","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_13","text":"don't hesitate to throw me a line,","jump":null},{"id":"m_ex_poli_01_14","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_14","text":"and I'll be there as soon as possible.","jump":null},{"id":"m_ex_poli_01_15","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_15","text":"Don't forget that!","jump":null},{"id":"m_ex_poli_01_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_16","text":"I won't forget that!","jump":null},{"id":"m_ex_poli_01_17","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_17","text":"??!","jump":null},{"id":"m_ex_poli_01_18","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_18","text":"What do you think you're doing, Commander?","jump":null},{"id":"m_ex_poli_01_19","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_19","text":"Are you imitating me?","jump":null},{"id":"m_ex_poli_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_20","text":"Yes, I'm imitating you.","jump":null},{"id":"m_ex_poli_01_21","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_21","text":"Hey!","jump":null},{"id":"m_ex_poli_01_22","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_22","text":"What's the big idea?!","jump":null},{"id":"m_ex_poli_01_23","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_23","text":"Grrrrr...","jump":null},{"id":"m_ex_poli_01_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_24","text":"Sorry. You're just too cute, so I couldn't resist.","jump":null},{"id":"m_ex_poli_01_25","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_25","text":"That's no way to describe a police officer!","jump":null},{"id":"m_ex_poli_01_26","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_26","text":"I'd prefer people think I'm cool, not cute.","jump":null},{"id":"m_ex_poli_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_27","text":"All right, you're the coolest police officer around.","jump":null},{"id":"m_ex_poli_01_28","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_28","text":"Pssh, that doesn't count! I practically forced you to say it.","jump":null},{"id":"m_ex_poli_01_29","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_29","text":"Anyway, I'll let you off this time.","jump":null},{"id":"m_ex_poli_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_30","text":"Thanks.","jump":null},{"id":"m_ex_poli_01_31","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_31","text":"You're welcome.","jump":null},{"id":"m_ex_poli_01_32","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_32","text":"I gotta go.","jump":null},{"id":"m_ex_poli_01_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_33","text":"Where to?","jump":null},{"id":"m_ex_poli_01_34","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_34","text":"Miranda is causing trouble again.","jump":null},{"id":"m_ex_poli_01_35","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_35","text":"I gotta go pick up the pieces.","jump":null},{"id":"m_ex_poli_01_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_poli_01_36","text":"Sounds like fun.","jump":null},{"id":"m_ex_poli_01_37","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_37","text":"Hehe.","jump":null},{"id":"m_ex_poli_01_38","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_38","text":"Catch you later, Commander.","jump":null},{"id":"m_ex_poli_01_39","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_poli_01_39","text":"Looking forward to working with you.","jump":null}],"chat":true}