ffinity":null},{"id":"d_main_38_05_e_14","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_05_e_14","text":"Don't worry. Your body will remember. A half day of practice, and you'll slip right back into it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_e_15","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_05_e_15","text":"Mint, can you take care of all the staging?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_e_16","type":"Speech","speaker":"mint","key":"Locale_MainScenario:d_main_38_05_e_16","text":"Sure thing. Leave it to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_e_17","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_05_e_17","text":"How about you, Neon? Are you going to join?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_e_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_e_18","text":"Huh? I'm allowed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_e_19","type":"Speech","speaker":"prika","key":"Locale_MainScenario:d_main_38_05_e_19","text":"Sure, if you've had some practice before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_e_20","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_e_20","text":"Oh... then I guess that's a no-go. I'll have to settle for being the manager.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i