:null},{"id":"d_main_21_09_s_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_28","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_29","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_29","text":"... What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_30","text":"Am I crazy... or is that thing headed straight towards us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_31","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_31","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_32","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_32","text":"Guess something didn't work out as planned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_33","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_34","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_34","text":"We need to join the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_35","text":"Are you talking about Master, or Johan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_36","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_36","text":"Who cares?! They're both at the same spot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_37","text":"I don't think heading over there will do us any good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_38","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_38","text":"Fine, you do whatever you want. All I know is that we were supposed to regroup if anything went wrong, and th...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_40","text":"Do you feel safe when we're all together?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_41","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_41","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_42","text":"You must get awful lonely a lot of the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_43","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_43","text":"Ha! Please. What are you talking about? Why would I ever get lonely?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_44","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_44","text":"Defense is my specialty, so I need to protect those pipsqueaks you call squadmates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_45","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_45","text":"That's why I want all of us to gather together... yeah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_46","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_46","text":"Were you the last to join the squad, by any chance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_47","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_47","text":"Huh? Ho-how did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_48","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_48","text":"I thought so. Guess you could never really fit in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_49","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_49","text":"Not fit in, me? What are you babbling about...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_50","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_50","text":"It's tough when everybody knows something and you're the odd one out. It happens to me all the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_51","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_51","text":"You try to be nice and get along, but sometimes it feels like there's nothing you can do about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_52","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_52","text":"Especially since I haven't spent as much time with them as they have with each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_53","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_54","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_54","text":"It's lonely. I want to get close with them. I want to be a part of their conversations, and do everything together with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_55","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_55","text":"At least then I can be useful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_56","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_56","text":"... Please shut up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_57","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_57","text":"But you have to let it be. You can't change the memories they've had before you came into their lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_58","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_58","text":"For those of us who came late in the picture, all we can do is","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_59","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_59","text":"make memories of our own, memories that we're proud of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_60","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_60","text":"... Uh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_61","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_61","text":"I say we take this tub of whale blubber down ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_62","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_62","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_63","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_63","text":"That's what we came here for, isn't it? It doesn't look like things are working out on their side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_64","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_64","text":"So what should we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_65","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_65","text":"How are we going to take it down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_66","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_66","text":"We'll climb the hookwire and get inside this whopper of a whale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_67","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_21_09_s_67","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_68","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_68","text":"Once we're inside, kablammo!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_09_s_69","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_09_s_69","text":"We'll send this big boy tumbling down to