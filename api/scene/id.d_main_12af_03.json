"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_46","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_46","text":"Ah, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_47","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_47","text":"This is just something I noticed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_48","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_48","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_49","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_49","text":"The underground facility that the Raptures created","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_50","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_50","text":"has a very similar structure to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_51","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_51","text":"You could even call it a miniature version.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_52","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_52","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affini