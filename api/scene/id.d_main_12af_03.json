{"id":"d_main_12af_03","cat":"main","group":{"id":"ch12","label":"Chapter 12 · Hometown"},"label":"Material H","stage":null,"prev":"d_main_12af_02","next":"d_main_12af_04","speakers":{"mana":"Mana","ingrid":"Ingrid","anis":"Anis","neon":"Neon","rapi":"Rapi"},"icons":{"mana":"si_c290_00_s","ingrid":"si_c900_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_12af_03_1","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_1","text":"Oh, hi there. We've just finished cleaning up.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["mana","ingrid","rapi","anis","neon"],"affinity":null},{"id":"d_main_12af_03_2","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_2","text":"It's a bit chaotic in here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_3","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_3","text":"There was an accident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_4","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_4","text":"Report.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_5","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_5","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_6","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_6","text":"The Heretic Fragment will be referred to as Material H.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_12af_03_7","text":"Heretic... H... makes sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_8","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_8","text":"After confirming that Material H is composed of various nanomachines, we examined its response to electrical stimulation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_9","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_9","text":"Upon electrical stimulation, a tentacle shaped appendage extended and immediately attacked all 18 Nikkes in the nearby vicinity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_10","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_10","text":"After the Nikkes were neutralized, they proceeded to be absorbed by the material.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_11","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_11","text":"... Absorbed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_12","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_12","text":"Yes. Material H does not respond to humans or machines, but only to Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_13","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_13","text":"After absorbing all of the Nikkes, its weight increased by 378 grams.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_14","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_14","text":"That's all?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_15","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_15","text":"Nikkes are completely disintegrated during the absorption process, after which it is assumed that only substances deemed necessary are absorbed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_16","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_16","text":"Since the accident, it is now being stored in an Atlas case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_17","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_17","text":"What is the Heretic Fra... I mean, what is Material H's current weight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_18","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_18","text":"Approximately 12kg. To date, it appears it has absorbed 450 Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_19","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_12af_03_19","text":"Then all those boxes piled up in the underground facility were...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_20","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_20","text":"We've concluded our investigation into the underground facility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_21","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_21","text":"Would you care to hear our findings?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_22","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_22","text":"You do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_23","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_23","text":"The underground facility is what the Intelligence department refers to as an ant colony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_24","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_24","text":"The section that you were in is just a small portion of the structure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_25","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_25","text":"There are many more similar facilities spread throughout the area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_26","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_26","text":"We haven't figured out the exact size, but it is estimated to be close to 1300 square kilometers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_12af_03_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_28","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_28","text":"And all the routes head towards one area, which is the center where Material H was situated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_29","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_29","text":"Fluctuating routes are used to induce panic or inflict corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_30","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_30","text":"If their prey perishes close to Material H, they are used as food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_31","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_31","text":"If they are far from the center, they are put in \"storage\" rooms scattered through the colony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_32","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_32","text":"The purpose of this underground facility is to produce Material H using Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_33","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_33","text":"Our conclusion is that they are attempting to resurrect the Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_34","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_12af_03_34","text":"It's not an ant colony, it's a breeding facility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_35","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_35","text":"We estimate there are approximately 200 Nikkes who are \"stored\" in the underground facility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_36","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_36","text":"It is believed they are Nikkes who became lost during a patrol or other mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_37","type":"Speech","speaker":"mana","key":"Locale_MainScenario:d_main_12af_03_37","text":"This figure aligns with how many Nikkes have been reported M.I.A. in that area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_12af_03_38","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_12af_03_38","text":"Ludmilla said it's gotten more difficult to find Nikkes who have gone missing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt"