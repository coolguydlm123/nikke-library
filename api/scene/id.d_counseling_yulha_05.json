{"id":"d_counseling_yulha_05","cat":"counsel","group":{"id":"char5029","label":"Yulha"},"label":"Advising Yulha: 05","stage":null,"prev":"d_counseling_yulha_04","next":"d_counseling_yulha_06","speakers":{"yulha":"Yulha"},"icons":{"yulha":"si_c171_00_s"},"lines":[{"id":"d_counseling_yulha_05_1","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_1","text":"I have a favor. Could you try to reign in your Nikkes a little more?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["yulha"],"affinity":"_0"},{"id":"d_counseling_yulha_05_2","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_2","text":"Because of all the troubles you're causing on the surface and the Outpost, the amount of paperwork...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_3","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_3","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yulha_05_4","text":"Okay. I'll be more controlling.","jump":"d_counseling_yulha_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_yulha_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yulha_05_5","text":"I'm sorry, but that is impossible.","jump":"d_counseling_yulha_05_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_yulha_05_6","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_6","text":"Don't make promises you can't keep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_7","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_7","text":"I know very well you can't control all those Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_8","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_8","text":"Not by yourself, anyway.","jump":"d_counseling_yulha_05_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_9","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_9","text":"Oh, yeah? You're not up to the task?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_10","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_10","text":"... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_11","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_11","text":"You can't possibly control all those Nikkes by yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_12","type":"Speech","speaker":"yulha","key":"Locale_Counseling:d_counseling_yulha_05_12","text":"Admitting your shortcomings is better than making promises you can't keep, anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yulha_05_13","type"