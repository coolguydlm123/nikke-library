{"id":"d_counseling_rapunzel_puregrace_03","cat":"counsel","group":{"id":"char5123","label":"Rapunzel: Pure Grace"},"label":"Advising Rapunzel: Pure Grace: 03","stage":null,"prev":"d_counseling_rapunzel_puregrace_02","next":"d_counseling_rapunzel_puregrace_04","speakers":{"Narration":"Narration","rapunzel_o":"Rapunzel"},"icons":{"Narration":"si_c999_00_s","rapunzel_o":"si_c966_00_s"},"lines":[{"id":"d_counseling_rapunzel_puregrace_03_1","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_1","text":"Rapunzel closes her eyes and recalls the past, which has become a blur.","jump":null,"exit":false,"enter":null,"bg":"black","bgArt":"black","image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":["rapunzel"],"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_2","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_2","text":"Commander, how do you overcome distracting thoughts while working?","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":null,"movie":null,"shown":["rapunzel_o"],"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_3","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_3","text":"Sometimes while I'm praying, these thoughts come into my mind and take away my focus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_4","text":"I'd take a break from working.","jump":"d_counseling_rapunzel_puregrace_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rapunzel_puregrace_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_5","text":"I try and think about other things.","jump":"d_counseling_rapunzel_puregrace_03_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rapunzel_puregrace_03_6","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_6","text":"I see, that's a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_7","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_7","text":"The fact that I'm getting distracted so easily might mean I need a break.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_8","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_8","text":"If I stop in the middle of a prayer, I have to start over from the beginning, but no matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_9","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_9","text":"More importantly, I should consider whether I am in the right state of mind to pray and take some time to compose myself.","jump":"d_counseling_rapunzel_puregrace_03_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_10","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_10","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_11","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_11","text":"But won't that eventually lead to other distracting thoughts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_12","type":"Speech","speaker":"rapunzel_o","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_12","text":"One thought leads to another, and before long, I won't be able to focus on my original prayers.","jump":"d_counseling_rapunzel_puregrace_03_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_puregrace_03_13","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_rapunzel_puregrace_03_13","text":"Rapunzel leaves to clear her mind and pray.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}