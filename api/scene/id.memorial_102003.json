{"id":"memorial_102003","cat":"memorial","group":{"id":"memorial102000","label":"Memoirs · Doomsday Book"},"label":"Prayer for Descent","stage":null,"prev":"memorial_102002","next":null,"speakers":{},"icons":{},"lines":[{"id":"memorial_102003_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"Skeletons lie buried under the frozen earth."},{"id":"memorial_102003_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"Such is man's original sin."},{"id":"memorial_102003_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"They are the Lord's holy vessel."},{"id":"memorial_102003_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"All shall bow to that direction."},{"id":"memorial_102003_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"For the Second Coming,"},{"id":"memorial_102003_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"saturate the earth with the blood of sinners,"},{"id":"memorial_102003_7","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"and bow to she who will be reborn."},{"id":"memorial_102003_8","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_20_03_description","text":"Pray to God, who will one day descend."}]}