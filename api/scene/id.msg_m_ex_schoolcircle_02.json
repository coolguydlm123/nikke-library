circle_02_38"},{"id":"m_ex_schoolcircle_02_34","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_34","text":"I see.","jump":null},{"id":"m_ex_schoolcircle_02_35","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_35","text":"More or less the answer I expected,","jump":null},{"id":"m_ex_schoolcircle_02_36","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_36","text":"but it's still quite touching hearing it from you personally.","jump":null},{"id":"m_ex_schoolcircle_02_37","type":"Speech","speaker":"rei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_37","text":"You're so cool, Teacher!","jump":"m_ex_schoolcircle_02_42"},{"id":"m_ex_schoolcircle_02_38","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_38","text":"Hmm...","jump":null},{"id":"m_ex_schoolcircle_02_39","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_39","text":"I see.","jump":null},{"id":"m_ex_schoolcircle_02_40","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_40","text":"I can't say that's quite the answer I was expecting.","jump":null},{"id":"m_ex_schoolcircle_02_41","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_41","text":"LOL.","jump":"m_ex_schoolcircle_02_42"},{"id":"m_ex_schoolcircle_02_42","type":"Speech","speaker":"rei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_42","text":"All right, next up is my question:","jump":null},{"id":"m_ex_schoolcircle_02_43","type":"Speech","speaker":"rei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_43","text":"How do you relieve stress?","jump":null},{"id":"m_ex_schoolcircle_02_44","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_schoolcircle_02_44","text":"I eat snacks.","jump":"m_ex_schoolcircle_02_46"},{"id":"m_ex_schoolcircle_02_45","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_schoolcircle_0