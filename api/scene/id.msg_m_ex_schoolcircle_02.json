{"id":"msg_m_ex_schoolcircle_02","cat":"messenger","group":{"id":"room_schoolcircle","label":"School Circle · Group"},"label":"3. Teacher,","stage":null,"prev":"msg_m_ex_schoolcircle_01","next":null,"speakers":{"zwei":"Zwei","ein":"Ein","rei":"Rei"},"icons":{"zwei":"si_c390_00_s","ein":"si_c391_00_s","rei":"si_c392_00_s"},"lines":[{"id":"m_ex_schoolcircle_02_1","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_1","text":"Teacher,","jump":null},{"id":"m_ex_schoolcircle_02_2","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_2","text":"I just got some new homework assigned to me.","jump":null},{"id":"m_ex_schoolcircle_02_3","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_3","text":"Could you help me?","jump":null},{"id":"m_ex_schoolcircle_02_4","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_4","text":"Me too, me too!","jump":null},{"id":"m_ex_schoolcircle_02_5","type":"Speech","speaker":"rei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_5","text":"And me!","jump":null},{"id":"m_ex_schoolcircle_02_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_schoolcircle_02_6","text":"All three of you?","jump":null},{"id":"m_ex_schoolcircle_02_7","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_7","text":"Yes.","jump":null},{"id":"m_ex_schoolcircle_02_8","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_8","text":"We have to interview someone who we respect,","jump":null},{"id":"m_ex_schoolcircle_02_9","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_9","text":"but as it turns out...","jump":null},{"id":"m_ex_schoolcircle_02_10","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schoolcircle_02_10","text":"We all respect the same person.","jump":null},{"id":"m_ex_schoolcircle_02_11","type":"Self","speaker":null,"key":"Loc