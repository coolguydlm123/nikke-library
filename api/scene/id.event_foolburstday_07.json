","speaker":null,"key":"Locale_SubScenario:event_foolburstday_07_78","text":"What a terrifying humanoid weapon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_07_79","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_07_79","text":"Anyway, now I must prove its combat capabilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_07_80","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_07_80","text":"Best not to overthink things. Let's head up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_07_81","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_07_81","text":"Huh? To the surface?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_07_82","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_07_82","text":"Where else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_07_83","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_07_83","text":"Let's go to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}