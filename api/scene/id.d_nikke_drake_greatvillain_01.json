{"id":"d_nikke_drake_greatvillain_01","cat":"bond","group":{"id":"char5181","label":"Drake: Great Villain"},"label":"A Villain's Debut Showcase","stage":null,"prev":null,"next":"d_nikke_drake_greatvillain_02","speakers":{"drake_p":"Drake"},"icons":{"drake_p":"si_c104_00_s"},"lines":[{"id":"d_nikke_drake_greatvillain_01_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_1","text":"The door to the Commander's Room opens, and Drake walks in.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":["drake_p"],"affinity":null},{"id":"d_nikke_drake_greatvillain_01_2","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_2","text":"Whirr.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_3","text":"Why are you saying the sound effects out loud?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_4","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_4","text":"A special villain like me deserves a special entrance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_5","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_5","text":"Well, it sure is special, I'll give you that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_6","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_6","text":"It's not something just anyone could come up with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_7","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_7","text":"Only I, the great Drake, could've thought of something like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_8","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_8","text":"Marvel at my greatness!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_9","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_9","text":"Wow, very impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_10","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_10","text":"Hahaha! Surely you can be more enthusiastic than that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_11","text":"So, what brings you to the Commander's Room?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_12","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_13","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_13","text":"Well, no matter. You'll have plenty more opportunities to behold my greatness in the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_14","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_14","text":"Before I state my business, let me ask you a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_15","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_15","text":"Who do you think I am?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_16","text":"A villain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_17","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_17","text":"I'm not just any villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_18","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_18","text":"I'm the Great Villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_19","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_19","text":"A super great one, at that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_20","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_20","text":"Therefore, I must distinguish myself from my former self.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_21","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_21","text":"I must earn everyone's recognition as a true villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_22","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_22","text":"However, as of late, people keep calling me a hero instead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_23","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_23","text":"Worse yet, they're calling me the Great Hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_24","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_24","text":"Why do you think that is, Moron?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_25","text":"Maybe you haven't committed enough acts of villainy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_26","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_26","text":"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_27","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_27","text":"I doubt there are any villains out there who commit villainous deeds as diligently as I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_28","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_29","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_29","text":"This is entirely unfair!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_30","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_30","text":"I'm filing a complaint to the labor authorities!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_31","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_31","text":"Wouldn't that be kind of difficult, since villains are freelancers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_32","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_32","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_33","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_33","text":"Damn it! This is an outrage!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_34","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_34","text":"Freelancers deserve the right to stand up against injustice too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_35","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_35","text":"Well, what did you figure the reason was?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_36","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_36","text":"Right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_37","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_37","text":"The reason why I'm still perceived as a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_38","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_38","text":"That's because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_39","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_39","text":"Because?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_40","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_40","text":"Because I haven't had my official villain debut showcase yet!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_41","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_41","text":"... A debut showcase?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_42","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_42","text":"Plebs will never understand unless you spell it out for them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_43","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_43","text":"Hence, I must make an official announcement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_44","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_44","text":"Did you just call the citizens of the Ark \"plebs\"?","