"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_51","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_51","text":"That sounds like a huge undertaking. It won't be easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_52","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_52","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_53","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_53","text":"Which is why I am here to enlist your aid!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_54","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_54","text":"Why me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_55","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_55","text":"The Villain Union's motto is to overcome hardships by working together and supporting each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_greatvillain_01_56","type":"Speech","speaker":"drake_p","key":"Locale_NikkeEpisode:d_nikke_drake_greatvillain_01_56","text":"And you are a member of the Villain Union.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id"