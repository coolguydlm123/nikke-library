{"id":"d_main_14_04","cat":"main","group":{"id":"ch14","label":"Chapter 14 · Journey"},"label":"Triangle","stage":null,"prev":"d_main_14_03","next":"d_main_14_05","speakers":{"privaty":"Privaty","admi":"Admi","yulha":"Yulha","rapi":"Rapi","anis":"Anis","neon":"Neon"},"icons":{"privaty":"si_c170_00_s","admi":"si_c172_00_s","yulha":"si_c171_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_14_04_1","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_1","text":"No way they're getting out of this one.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_14_02","bgArt":"eventscene_chap_14_02","image":null,"bgm":"bgm_emergency","movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_2","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_04_2","text":"Isn't this a bit overkill?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_3","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_04_3","text":"We're using suppression bullets, so I don't think it'll cause any issues. Probably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_4","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_4","text":"Well, I think they've got the point now. It's time for the main event.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_14_04_5","text":"*Pew*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_14_04_6","text":"A bullet whizzes past Privaty's ear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_7","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_8","text":"Next one goes between your eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_9","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_9","text":"W-with that lousy aim of yours?! I'd like to see you try!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_10","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_14_04_10","text":"Privaty, your legs are shaking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_11","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_14_04_11","text":"You really shouldn't be standing out in the open like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_12","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_12","text":"Be quiet!!\nCan't you see I'm talking?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_13","text":"Explain this.","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":null,"movie":null,"shown":["privaty","yulha","admi","rapi","anis","neon"],"affinity":null},{"id":"d_main_14_04_14","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_14","text":"I have orders from my superiors to secure Marian by any means necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_15","text":"Superiors?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_16","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_16","text":"Yes. It's an order from the Deputy Commander-in-Chief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_17","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_14_04_17","text":"Andersen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_04_18","text":"He is not the only Deputy Commander-in-Chief. It has to be someone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_19","text":"She's not yours to take.\nShe belongs to the Commando Unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_20","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_20","text":"The Nikke known as Marian is suspected of secretly communicating with the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_21","text":"Nonsense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_22","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_22","text":"There are reports of Marian showing sympathy towards a Rapture on a recent visit to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_23","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_23","text":"Nikkes are not capable of such actions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_24","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_24","text":"Investigation into those suspected of colluding with the enemy is a top priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_25","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_25","text":"An order has been issued to conduct an investigation into this matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_26","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_26","text":"We've been authorized to use force if necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_27","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_27","text":"So just hand over Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_04_28","text":"Oh,\njust can it already!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_04_29","text":"Don't try and give us the runaround. You just want Marian for yourself, admit it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_30","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_30","text":"Absolutely not.\nI'm here on orders from my superiors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_04_31","text":"Woof! Woof woof woof! Arrrr...! Woof woof woof woof!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_32","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_32","text":"What on earth are you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_04_33","text":"I'm talking to a Central Government lapdog.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_34","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_14_04_34","text":"All troops!! Move in!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_35","text":"Commander,\nwe need to fall back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_36","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_36","text":"I do not think we stand a chance going head to head with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_14_04_37","text":"Should we go to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_38","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_38","text":"No, the Ark will be crawling with Central Government troops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_39","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_14_04_39","text":"Then...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_40","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_40","text":"We should hide on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_41","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_41","text":"We can't lose Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_14_04_42","text":"While we move, I'll contact Andersen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_43","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_14_04_43","text":"Yes, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_14_04_44","text":"Escaping up to the surface...\nnever thought I'd see the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_14_04_45","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_14_04_45","text":"It's kinda poetic when you think about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}