":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_6","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_6","text":"so I think we both feel a lot better now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_7","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_7","text":"I'm really glad to hear that, you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_8","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_8","text":"Thanks, Siren.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_9","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_9","text":"It made me realize, though, that we really don't have too much longer until we graduate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_10","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_10","text":"And once we do, we'll have to say goodbye to Miss Marciana.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_11","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_11","text":"Oh, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_12","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_12","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_13","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_13","text":"You know, since we'll be leaving the school and all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_14","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_14","text":"Thinking about it makes me sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_15","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_15","text":"I kinda wish we had more time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_16","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_16","text":"I understand that feeling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_17","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_17","text":"Saying goodbye is always hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_18","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_18","text":"It's hard to say this sort of stuff to Miss Marciana, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_19","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_19","text":"Now that I think about it, I haven't properly thanked her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_20","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_20","text":"She did a lot to help us get here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_21","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_21","text":"even going so far as to accompany us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_22","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_22","text":"It's hard to put everything you want to say into words, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_23","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_23","text":"If putting it into words is hard, why not try a different way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_24","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_24","text":"When I couldn't speak very well, I often used to express myself through my bubbles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_25","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_25","text":"Sometimes they got my feelings across even better than words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_26","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_26","text":"Ooh, that's a good idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_27","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_27","text":"Hmm... Maybe we could get her a gift or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_28","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_28","text":"You mean a surprise gift, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_29","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_29","text":"I like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_30","type":"Speech","speaker":"tia_l","key":"Locale_MainScenario:event_wavetoyou2_04_e_30","text":"I wanna give her something special that she'll remember for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_04_e_31","type":"Speech","speaker":"naga_s","key":"Locale_MainScenario:event_wavetoyou2_04_e_31","text":"That sounds pretty ambitious... I'm not sure we'll be able to get her something that good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"s