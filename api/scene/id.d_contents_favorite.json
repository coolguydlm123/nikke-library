e in their overall performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_favorite_27","type":"Speech","speaker":"maxwell","key":"Locale_SubScenario:d_contents_favorite_27","text":"After proof comes the application.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_favorite_28","type":"Speech","speaker":"maxwell","key":"Locale_SubScenario:d_contents_favorite_28","text":"If we have a miniature doll of you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_favorite_29","type":"Speech","speaker":"maxwell","key":"Locale_SubScenario:d_contents_favorite_29","text":"one which resembles you physically and even contains your genetic information,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_favorite_30","type":"Speech","speaker":"maxwell","key":"Locale_SubScenario:d_contents_favorite_30","text":"couldn't we call such a product a clone of you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_favorite_31","type":"Self","speaker":"Self","key":"Locale_SubScenario:d_contents_favorite_31","text":"Hmm, that might be pushing it a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_favorite_32","type":"Speech","speaker":"maxwell","key":"Locale_SubScenario:d_contents_favorite_32","text":"If a Nikke possesses this doll, will we see an improvement in her performance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":