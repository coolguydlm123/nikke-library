g":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_12","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_s_12","text":"This is why I keep telling you to treat people with some decency,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_13","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_s_13","text":"and to manage your image a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_14","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_s_14","text":"Do you have any idea how much you've been cursing lately? And your behavior has gotten way too aggressive!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_15","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_15","text":"I don't care!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_16","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_16","text":"You're the one who said if people treat me like dirt, I should dish it right back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_17","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_17","text":"You think it's easy being the CEO? Anyone who assumes this title ends up like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_18","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_18","text":"Act sweet and clueless, and they'll take you for a pushover and eat you alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_19","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_19","text":"How am I supposed to play nice?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_20","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_s_20","text":"There are plenty of CEOs who don't do things that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_21","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_21","text":"I know that! So what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_22","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_22","text":"Did any of them become a CEO at my age?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_23","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_23","text":"... You think I chose to turn out this way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_24","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_24","text":"It's because everyone kept coming at me from all sides that I ended up like this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_25","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_25","text":"And besides, so what if that's how the public sees me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_26","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_26","text":"Missilis won't crumble over something like that. Never!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_27","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_s_27","text":"Sure, Missilis will be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_28","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_s_28","text":"But you know full well that it's not Missilis they're after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_29","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_29","text":"What's gotten into you? Why do you keep acting like I did something wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_s_30","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_s_30","text":"W