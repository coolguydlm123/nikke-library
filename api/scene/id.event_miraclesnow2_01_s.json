Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_59","text":"Are you sure you want to do this? You do realize the repercussions this may have for Anne, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_60","type":"Speech","speaker":"rupee","key":"Locale_SubScenario:event_miraclesnow2_01_s_60","text":"But this is what Anne wants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_61","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_62","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_62","text":"You mentioned that Anne has just begun regaining her memories, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_63","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_63","text":"Do you know why that is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_64","type":"Speech","speaker":"rupee","key":"Locale_SubScenario:event_miraclesnow2_01_s_64","text":"Because it's... a Christmas miracle?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_65","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_65","text":"Frankly speaking,","jump":null,"exit":false,"enter":null,"bg":null,"bg