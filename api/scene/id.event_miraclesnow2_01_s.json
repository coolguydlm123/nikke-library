{"id":"event_miraclesnow2_01_s","cat":"event","group":{"id":"ev40004","label":"Eternal Memory"},"label":"Ties that Bind: A","stage":null,"prev":null,"next":"event_miraclesnow2_01_e","speakers":{"anne":"Anne","exia":"Exia","rupee":"Rupee"},"icons":{"anne":"si_c121_00_s","exia":"si_c210_00_s","rupee":"si_c200_00_s"},"lines":[{"id":"event_miraclesnow2_01_s_1","type":"Speech","speaker":"anne","key":"Locale_SubScenario:event_miraclesnow2_01_s_1","text":"The one thing I remember so vividly is her smile. She had such a lovely smile.","jump":null,"exit":false,"enter":null,"bg":"White","bgArt":"white","image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":["angelina"],"affinity":null},{"id":"event_miraclesnow2_01_s_2","type":"Speech","speaker":"anne","key":"Locale_SubScenario:event_miraclesnow2_01_s_2","text":"Her smiling face when she looked at me, her warmth that I felt when she held me tight in her arms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_3","type":"Speech","speaker":"anne","key":"Locale_SubScenario:event_miraclesnow2_01_s_3","text":"This everlasting sense of... contentment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_4","type":"Speech","speaker":"anne","key":"Locale_SubScenario:event_miraclesnow2_01_s_4","text":"I remember other things too.","jump":null,"exit":false,"enter":null,"bg":"black","bgArt":"black","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_5","type":"Speech","speaker":"anne","key":"Locale_SubScenario:event_miraclesnow2_01_s_5","text":"The weary face. The cold stare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_trauma","movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_6","type":"Speech","sp