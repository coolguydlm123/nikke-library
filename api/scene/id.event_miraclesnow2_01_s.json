ull,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_27","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_27","text":"They are the ties that bind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_28","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_28","text":"Fighting for mankind up on the surface, absolute deference to orders...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_29","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_29","text":"None of that would ever happen if a Nikke's mind were filled with thoughts of her family.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_30","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_30","text":"They would cling to the mistaken belief that they're still human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_31","type":"Self","speaker":null,"key":"Locale_SubScenario:event_miraclesnow2_01_s_31","text":"So that means...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_32","type":"Self","speaker":null,"key":"Locale_SubScenario:event_miraclesnow2_01_s_32","text":"All memories of your family are erased when you become a Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_33","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_33","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_34","type":"Speech","speaker":"rupee","key":"Locale_SubScenario:event_miraclesnow2_01_s_34","text":"All so that they can be better soldiers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_35","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_35","text":"No, that's not the only reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_36","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_36","text":"Nikkes would still regard themselves as a part of their family,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_37","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_37","text":"but their family might not necessarily feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_38","type":"Speech","speaker":"rupee","key":"Locale_SubScenario:event_miraclesnow2_01_s_38","text":"I don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_39","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_39","text":"Nikkes are machines. Ones with long lifespans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_40","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_40","text":"Your baby sibling would enter old age, yet you'd remain the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_41","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_41","text":"Who would feel more isolated? Nikkes or their families?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_42","type":"Speech","speaker":"rupee","key":"Locale_SubScenario:event_miraclesnow2_01_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_43","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_43","text":"We all know the mortality rate is high amongst Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_44","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_44","text":"The primary reason is the battles on the surface, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_45","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_45","text":"Apart from that, there was also another cause of death in the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_46","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_46","text":"One which claimed just as many lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_47","type":"Speech","speaker":"rupee","key":"Locale_SubScenario:event_miraclesnow2_01_s_47","text":"When they met their families again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_48","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_48","text":"Yes, the shock was far more than they could bear,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_49","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_49","text":"and they took their own lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_50","type":"Self","speaker":null,"key":"Locale_SubScenario:event_miraclesnow2_01_s_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_51","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_51","text":"Self-termination incidents spike abnormally","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow2_01_s_52","type":"Speech","speaker":"exia","key":"Locale_SubScenario:event_miraclesnow2_01_s_52","text":"whenever Nikkes make contact with their families.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_mi