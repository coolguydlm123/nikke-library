{"id":"d_counseling_drake_greatvillain_20","cat":"counsel","group":{"id":"char5181","label":"Drake: Great Villain"},"label":"Advising Drake: Great Villain: 20","stage":null,"prev":"d_counseling_drake_greatvillain_19","next":null,"speakers":{"drake_p":"Drake","Self":"Commander"},"icons":{"drake_p":"si_c104_00_s"},"lines":[{"id":"d_counseling_drake_greatvillain_20_1","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_1","text":"Now that I'm all powered up, I'm done with committing petty acts of villainy.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["drake_p"],"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_2","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_2","text":"You're a member of the Villain Union! Think of something truly villainous to do!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_greatvillain_20_3","text":"Let's gather all the trash in one place and make a mountain of trash.","jump":"d_counseling_drake_greatvillain_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_drake_greatvillain_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_greatvillain_20_4","text":"Let's knock out the Ark's entire power grid.","jump":"d_counseling_drake_greatvillain_20_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_drake_greatvillain_20_5","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_5","text":"That's a good idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_6","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_6","text":"If we put all the Ark's trash in one place, it'll create a terrible stench.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_7","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_7","text":"Mwahaha! Now that's an act of villainy worthy of a Villain Union member.","jump":"d_counseling_drake_greatvillain_20_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_8","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_8","text":"Do you have no sense of moderation, Moron?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_9","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_9","text":"That'd be taking things way too far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_10","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_10","text":"Think of something safer, something horribly villainous that won't hurt anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_11","type":"Self","speaker":"Self","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_11","text":"Then how about gathering all the Ark's trash and making a trash mountain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_12","type":"Speech","speaker":"drake_p","key":"Locale_Counseling:d_counseling_drake_greatvillain_20_12","text":"That's a good idea! I'll get started right away!","jump":"d_counseling_drake_greatvillain_20_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_greatvillain_20_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_drake_greatvillain_20_13","text":"The following day, news outlets report that Drake had gathered all of the Ark's trash in one place, making it easier to dispose of than before.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}