{"id":"event_miraclesnow1_03_s","cat":"event","group":{"id":"ev40003","label":"Miracle Snow"},"label":"Limited Happiness: A","stage":null,"prev":"event_miraclesnow1_02_e","next":"event_miraclesnow1_03_e","speakers":{"n102":"N102","maiden":"Maiden","rupee":"Rupee","sugar":"Sugar","mc":"Host"},"icons":{"n102":"si_c120_00_s","maiden":"si_c181_00_s","rupee":"si_c200_00_s","sugar":"si_c140_00_s","mc":"si_c911_00_s"},"lines":[{"id":"event_miraclesnow1_03_s_1","type":"Speech","speaker":"n102","key":"Locale_SubScenario:event_miraclesnow1_03_s_1","text":"Do you play this game too?","jump":null,"exit":false,"enter":null,"bg":"ShoppingMall","bgArt":"shoppingmall","image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["rupee","n102","maiden"],"affinity":null},{"id":"event_miraclesnow1_03_s_2","type":"Speech","speaker":"maiden","key":"Locale_SubScenario:event_miraclesnow1_03_s_2","text":"Yeah. I haven't been at it for long, but I think I'm starting to get the hang of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_03_s_3","type":"Speech","speaker":"n102","key":"Locale_SubScenario:event_miraclesnow1_03_s_3","text":"Look at all the happy faces in this place! What's gotten you so down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_03_s_4","type":"Speech","speaker":"n102","key":"Locale_SubScenario:event_miraclesnow1_03_s_4","text":"This is a great place to have fun. Can't you just be happy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_miraclesnow1_03_s_5","type":"Speech","speaker":"maiden","key":"Locale_SubScenario:event_miraclesnow1_03_s_5","text":"That's the problem. It's precisely because I'm happy, that I'm unhappy.","jump":null,"exit":false,"enter":null,"bg"