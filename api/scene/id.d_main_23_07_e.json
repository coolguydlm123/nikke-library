{"id":"d_main_23_07_e","cat":"main","group":{"id":"ch23","label":"Chapter 23 · Prison"},"label":"Guardian of the Partition: B","stage":"23-21 STAGE · End","prev":"d_main_23_07_s","next":"d_main_23_08_s","speakers":{"outerrimman":"Outer Rim Citizen","sakura":"Sakura","rosanna":"Rosanna","consigliere":"Consigliere","moran":"Moran","jin_op_l":"Jin","doban":"Doban"},"icons":{"outerrimman":"si_c918_00_s","sakura":"si_c282_00_s","rosanna":"si_c280_00_s","consigliere":"si_c920_00_s","moran":"si_c281_00_s","jin_op_l":"si_c922_00_s","doban":"si_c939_00_s"},"lines":[{"id":"d_main_23_07_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_07_e_1","text":"Outer Rim. Evacuation camp.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_greyhaze_b","movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_2","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_2","text":"Miss, you're making a mistake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["sakura","outerrimman"],"affinity":null},{"id":"d_main_23_07_e_3","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_3","text":"We need to defend ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_4","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_4","text":"I'm going to make this short.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_5","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_5","text":"Have everyone put down their weapons and stand by.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_6","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_6","text":"I will do no such thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_7","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_7","text":"Thanks to E.H., the entire Outer Rim is now public enemy number one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_8","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_8","text":"Do you really think Doban is just going to let us go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_9","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_9","text":"His goal in life has always been to wipe out the Outer Rim!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_10","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_10","text":"Apparently, Deputy Chief Doban has sent in troops. \nMass-produced Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_11","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_11","text":"You see! We need to be prepared!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_12","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_12","text":"Let's say Deputy Chief Doban does bring troops into the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_13","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_13","text":"And when he gets there, he finds that everyone is armed and waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_14","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_14","text":"What do you think his next course of action will be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_15","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_16","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_16","text":"You all need to be victims. Act like them. After all, it's the truth, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_17","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_17","text":"So lay down your weapons.\nWe need to avoid any misunderstandings that might arise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_18","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_18","text":"But Doban doesn't think like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_19","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_19","text":"He won't bother listening to us! He'll just wipe us out the first chance he has!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_20","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_20","text":"Ah, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_21","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_21","text":"There's something I forgot to mention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_22","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_22","text":"I was in a hurry, so it must have slipped my mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_23","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_23","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_24","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_24","text":"Doban won't lay a finger on any of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_25","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_25","text":"The entire Seimeikai and I are behind you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_26","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_26","text":"It's not only Doban.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_27","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_27","text":"Whoever falsely pins these attacks on the Outer Rim,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_28","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_28","text":"will have to answer to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_29","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_23_07_e_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_30","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_30","text":"So please, for the last time, lay down your weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_31","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_31","text":"Or else I'll have to do it by force.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_32","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_32","text":"You know I will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_33","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_33","text":"The Seimeikai and I always get what we want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_34","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_23_07_e_34","text":"If you want to test just how strong our resolve is, keep holding onto your weapons and find out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_35","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_35","text":"Consigliere.","jump":null,"exit":false,"enter":null,"bg":"DestroyedStreet","bgArt":"destroyedstreet","image":null,"bgm":null,"movie":null,"shown":["rosanna","consigliere"],"affinity":null},{"id":"d_main_23_07_e_36","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_36","text":"Yes, Boss?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_37","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_37","text":"How many minutes do you need to take care of them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_38","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_39","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_39","text":"20 mass-produced Nikkes, was it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_40","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_40","text":"20 minutes should be sufficient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_41","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_41","text":"Doban sent them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_42","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_42","text":"Unlike regular mass-produced Nikkes, their Inhibitors are probably deactivated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_43","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_43","text":"Don't think they won't be able to shoot you just because they're Nikkes. They could be quite a formidable adversary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_44","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_44","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_45","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_45","text":"Good. Now wipe them out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_46","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_46","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_47","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_47","text":"Get some of your underlings to do the actual fighting. You stay here and chat with me. Is that okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_48","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_48","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_49","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_07_e_49","text":"Soon after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_50","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_07_e_50","text":"*Tudududu*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_emergency","movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_51","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_07_e_51","text":"*Crash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_07_e_52","text":"The square is filled with the sounds of gunshots and explosions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_53","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_53","text":"Never thought I'd be part of a gunfight inside the city, and in broad daylight at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_54","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_54","text":"The only reason we can do it is because everyone has been evacuated to the shelters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_55","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_55","text":"Let's see... you said there were more forces being sent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_56","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_56","text":"According to our intel, 50 additional units are being prepared, while Doban himself is coming with 20.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_57","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_57","text":"That man is crazy! Raptures are running rampant around the Ark and instead of help, this is what he does.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_58","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_58","text":"He's got some bats in the belfry if he actually thinks he can take down the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_59","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_59","text":"The notion does seem rather risible, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_60","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_60","text":"You said he's originally from the Outer Rim, correct?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_61","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_61","text":"Doban? Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_62","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_62","text":"He sang like a canary and gave up everything he knew about this place to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_63","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_63","text":"In exchange for selling the Outer Rim down the river, he brought greater stability to the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_64","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_64","text":"and put himself on the fast track to becoming second-in-command.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_65","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_65","text":"Let me ask you, why do you think he's chosen that path in life?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_66","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_66","text":"Perhaps he wants to erase his past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_67","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_67","text":"Do you think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_68","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_68","text":"Yes. For Doban, coming from the Outer Rim is a humiliating blight on his reputation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_69","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_69","text":"My thoughts differ from yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_70","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_70","text":"In my opinion,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_71","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_71","text":"that psychopath just enjoys maiming people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_72","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_72","text":"He's human filth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_73","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_73","text":"I cannot disagree with that assessment, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_74","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_74","text":"Anyway, what is taking them so long?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_75","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_75","text":"Those mass-produced Nikkes must be putting up a decent fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_76","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_76","text":"Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_77","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_23_07_e_77","text":"Let's go. It's been a while since we've seen some action. There are plenty of other places we can help at.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_78","type":"Speech","speaker":"consigliere","key":"Locale_MainScenario:d_main_23_07_e_78","text":"Yes, Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_23_07_e_79","text":"Outer Rim. Near the partition.","jump":null,"exit":false,"enter":null,"bg":"OuterrimWall","bgArt":"outerrimwall","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_80","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_facetoface","movie":null,"shown":["moran","jin_op_l"],"affinity":null},{"id":"d_main_23_07_e_81","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_81","text":"Sakura, Rosanna.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_82","type":"Speech","speaker":"jin_op_l","key":"Locale_MainScenario:d_main_23_07_e_82","text":"What are you going to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_83","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_83","text":"Prevent any more reinforcements from coming, and keep the people of the Outer Rim from bearing arms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_84","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_84","text":"There's only one thing I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_85","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_85","text":"I will halt the attack from Doban's units.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_86","type":"Speech","speaker":"jin_op_l","key":"Locale_MainScenario:d_main_23_07_e_86","text":"By yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_87","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_87","text":"By myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_88","type":"Speech","speaker":"doban","key