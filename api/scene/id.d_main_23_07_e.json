ocale_MainScenario:d_main_23_07_e_102","text":"Interfering with my plans again, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_103","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_23_07_e_103","text":"If you value your life, move aside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_104","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_104","text":"You took the words right out of my mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_105","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_105","text":"If you all value your lives, then scram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_106","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_106","text":"Or try and find another entrance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_107","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_23_07_e_107","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_108","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_23_07_e_108","text":"No? Well, it'll be awfully humiliating if you head back with your tail between your legs after getting whooped by a single Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_07_e_109