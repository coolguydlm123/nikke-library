{"id":"memorial_101303","cat":"memorial","group":{"id":"memorial101300","label":"Memoirs · A Girl's Memoir"},"label":"July 25, XX (Sunny)","stage":null,"prev":"memorial_101302","next":"memorial_101304","speakers":{},"icons":{},"lines":[{"id":"memorial_101303_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_03_description","text":"I played in the amusement park for a whole day!"},{"id":"memorial_101303_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_03_description","text":"There weren't any other people, and the roller coasters didn't work either."},{"id":"memorial_101303_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_03_description","text":"I still had a great time, though. 'Cause I hadn't played with Daddy for soooo long."},{"id":"memorial_101303_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_03_description","text":"He promised to take me for a ride on the carousel tomorrow."}]}