{"id":"d_counseling_sky_11","cat":"counsel","group":{"id":"char5188","label":"Sky"},"label":"Advising Sky: 11","stage":null,"prev":"d_counseling_sky_10","next":"d_counseling_sky_12","speakers":{"sky":"Sky"},"icons":{"sky":"si_c530_00_s"},"lines":[{"id":"d_counseling_sky_11_1","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_11_1","text":"Captain, what would you do if the weather suddenly turned bad mid-flight?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sky"],"affinity":"_0"},{"id":"d_counseling_sky_11_2","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_11_2","text":"You know, if you had to decide whether to stay on course or take a different route.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_11_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_11_3","text":"Stay on course until the weather clears.","jump":"d_counseling_sky_11_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sky_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_11_4","text":"Find another route, even if it takes longer.","jump":"d_counseling_sky_11_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sky_11_5","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_11_5","text":"Sometimes the weather does clear up quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_11_6","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_11_6","text":"But personally, I'd look f