:null,"shown":null,"affinity":null},{"id":"d_main_47_04_128","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_128","text":"Since that noisy attendant of theirs delivered the message, it can be trusted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_129","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_129","text":"... Any other questions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_130","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_130","text":"No. None for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_131","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_131","text":"All right. Then that concludes our briefing on the current situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_132","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_132","text":"Let's prepare to depart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_133","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_133","text":"Before we leave, could I go see Marian for a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_134","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_134","text":"Sure. Do as you please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity"