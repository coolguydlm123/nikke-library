{"id":"d_main_47_04","cat":"main","group":{"id":"ch47","label":"Chapter 47 · Outbreak"},"label":"Those Who Slumber","stage":"47-27 STAGE · End","prev":"d_main_47_03","next":"d_main_47_05","speakers":{"johan":"Johan","cecil":"Cecil","snowwhite_h_no":"Snow White","anis_i":"Anis","enikk_op_l":"Enikk"},"icons":{"johan":"si_c925_00_s","cecil":"si_c929_00_s","snowwhite_h_no":"si_c9013_00_s","anis_i":"si_c017_00_s","enikk_op_l":"si_c904_00_s"},"lines":[{"id":"d_main_47_04_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_47_04_1","text":"We move to Eden's Repair Center.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_story_repaircenter","movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_47_04_2","text":"Inside, two massive machines are being assembled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_47_04_3","text":"Against one wall are three brain shelters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_4","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_47_04_4","text":"Against another wall is a bed where Rose lies, battered and broken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis_i","johan","cecil","snowwhite_h_no"],"affinity":null},{"id":"d_main_47_04_5","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_47_04_5","text":"I shake my head, trying to shake off the lifeless, chilling atmosphere that hangs over the entire Repair Center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_6","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_47_04_6","text":"Johan and Cecil continue their conversation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_7","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_7","text":"... Use Red Shoes as Rapunzel's equipment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_8","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_8","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_9","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_9","text":"We have no idea what Mirror might have done to her inside. It's far too dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_10","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_10","text":"We've completed all precision scans. There's no sign of corruption, and her entire operating system has been completely wiped... Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_11","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_11","text":"She's essentially undergone a factory reset.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_12","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_12","text":"She's nothing more than a machine now. Albeit an ultra-high-performance one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_13","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_14","text":"What do you think, Snow White?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_15","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_15","text":"What happens if we use Red Shoes as equipment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_16","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_16","text":"She was originally designed with advanced mobility and physical strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_17","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_17","text":"Rapunzel isn't skilled in physical combat, so she won't be able to make much use of the body offensively. But in terms of mobility, she's in a completely different league.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_18","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_18","text":"Excellent. Let's do it immediately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_19","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_47_04_19","text":"Wait, shouldn't we deliberate on this a little more?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_20","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_20","text":"Rapunzel would have been thrilled. She was always frustrated by her lack of mobility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_21","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_21","text":"She's always racing all over the place, providing healing and support...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_22","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_22","text":"Just thinking about it makes me feel more at ease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_23","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_23","text":"And above all else, we have no one to back us now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_24","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_24","text":"So we must use every means at our disposal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_25","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_25","text":"Since her squadmate has given her approval, I'll take that as permission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_26","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_26","text":"All right. I'll leave it in your hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_27","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_27","text":"If your suggestion was about Red Shoes, what's the other issue?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_28","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_28","text":"Scarlet is the issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_29","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_29","text":"We are currently attempting to design a body blueprint based on her ideal form, as derived from her brain scan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_30","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_30","text":"It's not working.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_31","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_31","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_32","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_32","text":"When she was attacked by the Queen, her brain suffered severe damage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_33","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_33","text":"Scarlet's NIMPH is currently compensating for the damaged areas,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_34","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_34","text":"which technically qualifies as a malfunction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_35","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_35","text":"What do you mean malfunction?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_36","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_36","text":"Ah, I mean from a functional standpoint. But thanks to that, Scarlet's brain is still intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_37","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_37","text":"However, a malfunction is still a malfunction, so it's preventing us from creating a proper body blueprint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_38","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_38","text":"In the worst case scenario, we might have to put Scarlet's brain into a standard mass-produced body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_39","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_39","text":"What happens in that case?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_40","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_40","text":"We'd have to leave it all to chance. Either her memories remain, or she's reduced to a blank slate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_41","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_41","text":"Not to mention Scarlet would lose all the advantages of the highly customized mass-produced body she's had until now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_42","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_42","text":"Can't you just modify it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_43","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_43","text":"Modifying a mass-produced body is significantly harder than modifying a standard one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_44","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_44","text":"We have limited resources available after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_45","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_45","text":"... Well, it's not entirely impossible... if we're prepared to create dozens of corpses, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_46","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_46","text":"The problem is, there's only one Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_47","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_47","text":"Just in case...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_48","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_48","text":"I ran a simulation to see what would happen if we forcibly attached a completed body without going through a brain scan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_49","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_49","text":"The result showed a 98.2% probability of her NIMPH going berserk. In other words, it would mean a catastrophic Mind Switch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_50","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_51","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_51","text":"So... Scarlet can't be saved, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_52","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_52","text":"There's only one option.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_53","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_53","text":"We use Rose's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_54","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_54","text":"Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_55","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_55","text":"Scarlet's and Rose's bodies should be identical models, so they should be a perfect match.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_56","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_56","text":"What if we just build a body according to Rose's body data?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_57","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_57","text":"There are many inherent problems with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_58","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_58","text":"There are a plethora of black boxes in Rose's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_59","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_59","text":"The fact that she can function without a core is abnormal in itself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_60","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_60","text":"Mirror must have used every trick imaginable to make her operational. As far as we're concerned, that's technology that's completely unknown to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_61","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_61","text":"We can't replicate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_62","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_62","text":"... Also, there's no way to obtain the data for Scarlet's original body, the close-combat mass-produced model.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_63","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_63","text":"That means...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_64","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_64","text":"Unless we use Rose's body as-is, Scarlet can't be saved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_65","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_65","text":"... Yes. That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_66","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_66","text":"In that case, Rose would die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_67","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_67","text":"... That's also true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_68","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_68","text":"Hold on. What if we scan Rose's NIMPH and create a new body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_69","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_69","text":"Rose's NIMPH is a mess. There are traces of corruption as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_70","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_70","text":"I scanned Rose's NIMPH and tried creating a body blueprint based on that data, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_71","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_72","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_72","text":"Ugh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_73","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_73","text":"Pardon me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_74","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_74","text":"The result was something unidentifiable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_75","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_75","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_76","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_76","text":"Rose isn't even aware of what she is anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_77","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_77","text":"She's completely broken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_78","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_78","text":"All we've managed to do is keep her alive until now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_79","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_79","text":"What if we remove her NIMPH with Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_80","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_47_04_80","text":"Cecil shakes her head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_81","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_81","text":"Rose's brain has lost most of its functions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_82","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_82","text":"She is entirely dependent on her NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_83","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_83","text":"And right now, that NIMPH is in complete disarray.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_84","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_84","text":"Furthermore, a Nikke's body blueprint is read directly from the NIMPH. Without the NIMPH, there's nothing we can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_85","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_85","text":"So to summarize...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_86","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_86","text":"We can only save one of them. Either Rose or Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_87","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_87","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_88","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_88","text":"And we don't know what would happen if we transplanted Rose's body directly onto Scarlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_89","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_89","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_90","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_90","text":"Do the black boxes inside Rose's body pose any risks?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_91","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_91","text":"Plenty. She might have been implanted with corruption, or perhaps even a self-destruct code.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_92","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_92","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_93","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_93","text":"Ah, {AccountData.NickName}. Could you look up body data for close-combat specialized squads in the Ark? If there's any data left, we might have a chance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_94","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_94","text":"Sure. Just a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_95","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_95","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_96","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_96","text":"You called?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_l"],"affinity":null},{"id":"d_main_47_04_97","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_97","text":"Enikk. Is it possible to obtain body data from Nikkes belonging to a close-combat squad from around a hundred years ago?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_98","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_98","text":"Are you referring to Scarlet's original affiliation before joining the Goddess Squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_99","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_99","text":"Yes. That's the one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_100","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_100","text":"Please wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_101","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_101","text":"What is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_102","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_102","text":"You're calling Enikk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_103","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_103","text":"Thank you for waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_l"],"affinity":null},{"id":"d_main_47_04_104","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_104","text":"No records of that squad currently exist in the Ark's database.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_105","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_105","text":"It was the first squad to be documented as having directly killed a human. Consequently, all records were purged. Only traces of their deletion remain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_106","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_106","text":"The data may still exist in the Forbidden Library. However, all information stored in that location consists solely of handwritten records.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_107","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_107","text":"It is highly unlikely that a Nikke's body data was ever recorded by hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_108","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_108","text":"... Right. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_109","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_47_04_109","text":"Certainly. Please contact me anytime should you require further assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_110","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_110","text":"Yeah. I'll reach out in the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_111","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_111","text":"Sorry. I guess that wasn't much help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_112","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_112","text":"... Nothing we can do about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_113","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_113","text":"I'll exhaust every available resource to find a solution, so give me a little more time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_114","type":"Speech","speaker":"snowwhite_h_no","key":"Locale_MainScenario:d_main_47_04_114","text":"All right. I'm counting on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_115","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_115","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_116","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_116","text":"I know what you're thinking, Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_117","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_117","text":"But we haven't become monsters yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_118","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_118","text":"Rose is still alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_119","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_47_04_119","text":"Hmm. Fine. I'll keep that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_120","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_47_04_120","text":"What about Liberalio?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_47_04_121","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_47_04_121","text":"We're leaving her alone and keeping her stored away.",