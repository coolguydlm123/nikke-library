{"id":"d_counseling_nayuta_17","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 17","stage":null,"prev":"d_counseling_nayuta_16","next":"d_counseling_nayuta_18","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_17_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_17_1","text":"Now that I bethink me, I can scarce recall e'er hearing thee laugh so heartily.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_17_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_17_2","text":"Pray, wouldst thou do so now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_17_3","text":"Laugh out loud.","jump":"d_counseling_nayuta_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_17_4","text":"Smile silently.","jump":"d_counseling_nayuta_17_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_17_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_17_5","text":"Verily, a most mirthful guffaw!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_17_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_17_6","text":"It doth lift even mine own spirits, hoho!","jump":"d_counseling_nayuta_17_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_17_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_17_7","text":"Perchance thou art more bashful than I did surmise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_17_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_17_8","text":"I had a mind to hear thy laughter, yet, alas, 'tis not to be.","jump":"d_counseling_nayuta_17_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_17_9","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_17_9","text":"I share a hearty laugh with Nayuta.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}