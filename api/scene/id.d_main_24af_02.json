{"id":"d_main_24af_02","cat":"main","group":{"id":"ch24","label":"Chapter 24 · Banishment"},"label":"Reasonable Judgment","stage":null,"prev":"d_main_24af_01","next":"d_main_24af_03","speakers":{"syuen":"Syuen","enikk":"Enikk"},"icons":{"syuen":"si_c901_00_s","enikk":"si_c904_00_s"},"lines":[{"id":"d_main_24af_02_1","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_1","text":"I'm only just getting some movement back.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":"bgm_story_enikksroom","movie":null,"shown":["syuen"],"affinity":null},{"id":"d_main_24af_02_2","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_2","text":"You've got some nerve asking me to come here... ouch...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_3","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_3","text":"Ugh, my head is killing me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_4","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_4","text":"Welcome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk"],"affinity":null},{"id":"d_main_24af_02_5","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_5","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_6","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_6","text":"You're the one who's going to judge me? Really, using AI?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_7","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_7","text":"You think I'm just gonna roll over and accept whatever ruling you toss out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_8","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_8","text":"I'm Syuen, the CEO of Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_9","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_9","text":"You do know how important Missilis is to the Ark, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_10","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_10","text":"If something happens to me, then the Ark is done for. \nYou got that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_11","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_11","text":"Keep that in mind when you're making your judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_12","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_12","text":"My head is pounding, so let's get this show on the road.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_13","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_13","text":"I will make my judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_14","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_14","text":"First, you intentionally lured Raptures into the Ark for the benefit of Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_15","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_15","text":"Second, you were unable to take care of your own Exotic squad and prevent the attacks on the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_16","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_16","text":"Third, you personally attempted to destroy Exotic squad members in order to cover your tracks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_17","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_17","text":"Fourth, you neglected your own Wardress squad and failed to prevent the shelter incident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_18","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_18","text":"Your actions have resulted in a terrible loss of human life and material resources.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_19","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_19","text":"On the basis of these facts, a search has shown that there are no cases perfectly matching this incident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_20","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_20","text":"This case will be judged on its own merits. The judgment made is as follows:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_21","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_21","text":"Yeah yeah, can we wrap this up? Just tell me how much the fine is, so I can be on my way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_22","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_22","text":"You will be turned into a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_23","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_23","text":"As you have made great contributions to the Ark in the past, your brain will not be subjected to a memory wipe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_24","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_24","text":"However, your propensity for illicit actions and thoughts are likely to cause further issues, so we will calibrate it through NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_25","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_25","text":"You will become a Nikke and be stripped of your position as CEO of Missilis industry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_26","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_26","text":"You will be placed under the commander of the special division Counters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_27","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_24af_02_27","text":"That is all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_28","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_02_29","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_24af_02_29","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}