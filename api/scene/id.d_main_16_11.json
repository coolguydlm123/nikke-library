{"id":"d_main_16_11","cat":"main","group":{"id":"ch16","label":"Chapter 16 · Brand"},"label":"A Dream of Freedom","stage":"16-22 STAGE · Start","prev":"d_main_16_10","next":"d_main_16_12","speakers":{"rapi":"Rapi","jackal":"Jackal","neon":"Neon","anis":"Anis","Self":"Commander","crow":"Crow"},"icons":{"rapi":"si_c010_00_s","jackal":"si_c111_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","crow":"si_c110_00_s"},"lines":[{"id":"d_main_16_11_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_11_1","text":"There's a steep slope ahead of us.","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":"bgm_secondhand","movie":null,"shown":["rapi","jackal","neon","anis","crow"],"affinity":null},{"id":"d_main_16_11_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_16_11_2","text":"I recommend a detour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_11_3","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_11_3","text":"Huh? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_11_4","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_11_4","text":"It's all covered in snow anyway,\ncan't we just slide down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_11_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_16_11_5","text":"You don't have a clue, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_11_6","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_16_11_6","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":nu