{"id":"d_counseling_laplace_15","cat":"counsel","group":{"id":"char1010","label":"Laplace"},"label":"Advising Laplace: 15","stage":null,"prev":"d_counseling_laplace_14","next":"d_counseling_laplace_16","speakers":{"laplace":"Laplace"},"icons":{"laplace":"si_c100_00_s"},"lines":[{"id":"d_counseling_laplace_15_1","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_1","text":"A while ago, a package was delivered in front of our building.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["laplace"],"affinity":"_0"},{"id":"d_counseling_laplace_15_2","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_2","text":"When I opened it, there was a knife, and a small note with the word \"Kill!\" on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_15_3","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_3","text":"What do you think that's all about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_15_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_laplace_15_4","text":"It means someone is accusing you of being a killer.","jump":"d_counseling_laplace_15_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_laplace_15_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_laplace_15_5","text":"I think it may be a threat.","jump":"d_counseling_laplace_15_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_laplace_15_6","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_6","text":"Well, they're not wrong. I do kill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_15_7","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_7","text":"Killing it as a hero, that is!","jump":"d_counseling_laplace_15_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_15_8","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_8","text":"But why? Was it something I did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_15_9","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_9","text":"No way. I haven't done anything wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_15_10","type":"Speech","speaker":"laplace","key":"Locale_Counseling:d_counseling_laplace_15_10","text":"Besides, threats don't scare me. I'm a hero! I'm invincible!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_laplace_15_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_laplace_15_11","text":"Laplace teaches me how to properly gift-wrap a box.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}