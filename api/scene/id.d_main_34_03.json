{"id":"d_main_34_03","cat":"main","group":{"id":"ch34","label":"Chapter 34 · Inheritance"},"label":"Far Away","stage":"34-9 STAGE · End","prev":"d_main_34_02","next":"d_main_34_04","speakers":{"rapi":"Rapi","anis":"Anis","neon":"Neon"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_34_03_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_1","text":"It's exactly as the Commander said.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_34_01","bgArt":"eventscene_chap_34_01","image":null,"bgm":"bgm_story_monochrome","movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_2","text":"There's nothing left for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_3","text":"No... I never had anything to begin with, so it's more accurate to say things haven't changed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_4","text":"I never had a purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_5","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_5","text":"No goal, no mission, no dreams. Nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_6","text":"Then, by sheer luck,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_7","text":"I met a hero called Red Hood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_8","text":"I wanted to become like her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_9","text":"I saw how her life came to an end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_10","text":"I believed it was my duty to carry on her legacy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_11","text":"I thought it was something like destiny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_12","text":"But it wasn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_13","text":"I couldn't become Red Hood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_14","text":"I was just a pale imitation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_15","text":"I had none of her skills,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_16","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_16","text":"and I certainly had no virtuous mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_17","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_17","text":"It didn't take long for it to dawn on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_18","text":"I was simply imitating her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_19","text":"So I gave up everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_20","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_20","text":"I never had been capable of assuming the mantle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_21","text":"For me, a nobody, to take the place of a hero who was everything, made no sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_22","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_22","text":"I realized that an ideal was an ideal precisely because it was so far out of reach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_23","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_23","text":"I gave up on the notion of succeeding Red Hood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_24","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_25","text":"There was nothing left for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_26","text":"I didn't know what to live for anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_27","text":"In my aimless wandering that followed, I met the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_28","text":"Those piercing eyes, that determined gait. You were remarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_29","text":"I thought if I aligned myself with you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_30","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_30","text":"if I saw the same things you did and walked the same path as you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_31","text":"maybe, just maybe, something would fill the emptiness within me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_32","text":"Something. Anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_33","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_33","text":"I felt an overriding desire to protect you, because you shone a light into the darkness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_34","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_34_03_34","text":"Like a ray of hope sent to me when I was about to give up everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_34_03_35","type":"Speech","speaker":"rapi","key":"Locale_Ma