ype":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_23","text":"They didn't say anything...","jump":null},{"id":"m_subquest_1122_e_24","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_24","text":"not a single word.","jump":null},{"id":"m_subquest_1122_e_25","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_25","text":"No thank yous, or remarks on how pretty they were...","jump":null},{"id":"m_subquest_1122_e_26","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_26","text":"I could have been their friend...","jump":null},{"id":"m_subquest_1122_e_27","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_27","text":"Even if their friendship was bought, I'd have been okay with it...","jump":null},{"id":"m_subquest_1122_e_28","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_28","text":"You're my friend,","jump":null},{"id":"m_subquest_1122_e_29","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_29","text":"aren't you, Commander?","jump":null},{"id":"m_subquest_1122_e_30","type":"Self","speaker":null,"key":"Locale_SubScenario:m_subquest_1122_e_30","text":"That's right.","jump":null},{"id":"m_subquest_1122_e_31","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_31","text":"That's a relief.","jump":null},{"id":"m_subquest_1122_e_32","type":"Speech","speaker":"serial","key":"Locale_SubScenario:m_subquest_1122_e_32","text":"At least I have one friend.","jump":null}],"chat":true}