{"id":"d_counseling_yuni_10","cat":"counsel","group":{"id":"char5006","label":"Yuni"},"label":"Advising Yuni: 10","stage":null,"prev":"d_counseling_yuni_09","next":"d_counseling_yuni_11","speakers":{"yuni":"Yuni"},"icons":{"yuni":"si_c160_00_s"},"lines":[{"id":"d_counseling_yuni_10_1","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_10_1","text":"Commander, what kind of hit hurts the most?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["yuni"],"affinity":"_0"},{"id":"d_counseling_yuni_10_2","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_10_2","text":"A hit to the shins? A punch to the gut? Stubbing your toe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_10_3","text":"I haven't been hit that much, so I really can't say.","jump":"d_counseling_yuni_10_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_yuni_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_10_4","text":"It hurts no matter where you get hit.","jump":"d_counseling_yuni_10_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_yuni_10_5","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_10_5","text":"Ha ha! You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_10_6","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_10_6","text":"Then, would you let me teach you...?","jump":"d_counseling_yuni_10_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_10_7","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_10_7","text":"No way. They can't all be the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_10_8","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_10_8","text":"Commander, you're either lying, or you really don't know anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_10_9","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_10_9","text":"But that's not a problem. Just let me teach you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_10_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_10_10","text":"Yuni teaches me a lot of things.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}