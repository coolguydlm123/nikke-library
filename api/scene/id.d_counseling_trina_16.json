{"id":"d_counseling_trina_16","cat":"counsel","group":{"id":"char5134","label":"Trina"},"label":"Advising Trina: 16","stage":null,"prev":"d_counseling_trina_15","next":"d_counseling_trina_17","speakers":{"trina":"Trina"},"icons":{"trina":"si_c412_00_s"},"lines":[{"id":"d_counseling_trina_16_1","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_1","text":"Sun, what do you think about having to trim a tree which has superfluous branches?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["trina"],"affinity":"_0"},{"id":"d_counseling_trina_16_2","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_2","text":"Is it the right thing to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_16_3","text":"They need to be pruned.","jump":"d_counseling_trina_16_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_trina_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_16_4","text":"There's no such thing as an unnecessary branch.","jump":"d_counseling_trina_16_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_trina_16_5","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_5","text":"You're not necessarily wrong, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_6","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_6","text":"If a tree, which cannot speak, slowly extends its branches over time, only to have them cut away in an instant,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_7","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_7","text":"don't you find that terribly sad?","jump":"d_counseling_trina_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_8","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_8","text":"I feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_9","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_9","text":"The very act of exerting itself in order to extend its branches...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_10","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_10","text":"I wonder if there's a reason behind it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_11","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_16_11","text":"That's why I always feel a little sorry when I have to prune the trees by the roadside.","jump":"d_counseling_trina_16_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_16_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_trina_16_12","text":"Trina and I talk more about \"unnecessary\" branches.","jump":null,"exit":false,"enter":null,"bg":"none","bgAr