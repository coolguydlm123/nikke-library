{"id":"d_subquest_1122","cat":"sub","group":{"id":"req_cereal","label":"Request · Cereal"},"label":"Request 1122","stage":null,"prev":"d_subquest_1121","next":null,"speakers":{"anis":"Anis","neon":"Neon","rapi":"Rapi"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_subquest_1122_1","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1122_1","text":"There's a sucker born every minute.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":"bgm_risk","movie":null,"shown":["anis","neon","rapi"],"affinity":null},{"id":"d_subquest_1122_2","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1122_2","text":"A friend fee? Who thought up that one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1122_3","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1122_3","text":"Is that something you pay in order to maintain a friendship?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1122_4","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1122_4","text":"I think I'm paying a friend fee, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1122_5","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1122_5","text":"Since Anis eats so much of my food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1122_6","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1122_6","text":"There's no such thing as a friend fee. It's stealing, plain and simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgA