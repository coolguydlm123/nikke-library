null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1122_14","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1122_14","text":"It won't hurt to take a few minutes out of our schedule to help her out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1122_15","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1122_15","text":"She said she's had a hard time making friends, right? Now that she finally has, she's not going to give them up so easily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1122_16","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1122_16","text":"I just hope we're not late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}