{"id":"d_counseling_sakura_06","cat":"counsel","group":{"id":"char1012","label":"Sakura"},"label":"Advising Sakura: 06","stage":null,"prev":"d_counseling_sakura_05","next":"d_counseling_sakura_07","speakers":{"sakura":"Sakura"},"icons":{"sakura":"si_c282_00_s"},"lines":[{"id":"d_counseling_sakura_06_1","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_06_1","text":"I find it troubling that I never seem to have anything to say to Moran.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sakura"],"affinity":"_0"},{"id":"d_counseling_sakura_06_2","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_06_2","text":"What would you do if you were me, {AccountData.NickName}-kun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_06_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_06_3","text":"Keep hammering away at it until something you say makes an impression.","jump":"d_counseling_sakura_06_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sakura_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_06_4","text":"Just give it up.","jump":"d_counseling_sakura_06_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sakura_06_5","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_06_5","text":"It's clear that you're a very patient person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_06_6","type":"Speech","speaker":"sakura","key":"Locale_Counseling: