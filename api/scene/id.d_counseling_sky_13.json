{"id":"d_counseling_sky_13","cat":"counsel","group":{"id":"char5188","label":"Sky"},"label":"Advising Sky: 13","stage":null,"prev":"d_counseling_sky_12","next":"d_counseling_sky_14","speakers":{"sky":"Sky"},"icons":{"sky":"si_c530_00_s"},"lines":[{"id":"d_counseling_sky_13_1","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_13_1","text":"Captain, I tried dressing up like one of the members from my favorite rock band the other day.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sky"],"affinity":"_0"},{"id":"d_counseling_sky_13_2","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_13_2","text":"I really liked it, but people around me told me I should try a different style.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_13_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_13_3","text":"I think something cutesy would suit you better.","jump":"d_counseling_sky_13_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sky_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_13_4","text":"All that matters is you like it.","jump":"d_counseling_sky_13_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sky_13_5","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_13_5","text":"... Something cutesy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_13_6","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_13_6","text":"Hmm... I've never even considered tha