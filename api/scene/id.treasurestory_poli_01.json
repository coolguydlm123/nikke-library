l,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_01_83","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_poli_01_83","text":"Poli blusters out of the station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_01_84","type":"Speech","speaker":"quiry","key":"Locale_NikkeEpisode:treasurestory_poli_01_84","text":"Th-this can't be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_poli_01_85","type":"Speech","speaker":"quiry","key":"Locale_NikkeEpisode:treasurestory_poli_01_85","text":"That isn't the Poli I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}