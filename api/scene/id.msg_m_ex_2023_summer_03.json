2023_summer_03_21","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_2023_summer_03_21","text":"Message failed to send.","jump":null},{"id":"m_ex_2023_summer_03_22","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_22","text":"That doesn't mean I don't miss you, Commander!","jump":null},{"id":"m_ex_2023_summer_03_23","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_23","text":"Come to think of it,","jump":null},{"id":"m_ex_2023_summer_03_24","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_24","text":"you're a human being!","jump":null},{"id":"m_ex_2023_summer_03_25","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_25","text":"You could float your way over here, or try swimming.","jump":null},{"id":"m_ex_2023_summer_03_26","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_26","text":"Or...","jump":null},{"id":"m_ex_2023_summer_03_27","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_27","text":"Maybe you could build a raft and row over?","jump":null},{"id":"m_ex_2023_summer_03_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_2023_summer_03_28","text":"Liter already made blueprints for a boat.","jump":null},{"id":"m_ex_2023_summer_03_29","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_2023_summer_03_29","text":"Message failed to send.","jump":null},{"id":"m_ex_2023_summer_03_30","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_30","text":"Liter is there too.","jump":null},{"id":"m_ex_2023_summer_03_31","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_31","text":"Ask her if she can make","jump":null},{"id":"m_ex_2023_summer_03_32","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_2023_summer_03_32","text":"an amphibious motorcycle.","jump":null},{"id"