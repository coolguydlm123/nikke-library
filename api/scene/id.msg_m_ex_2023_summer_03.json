{"id":"msg_m_ex_2023_summer_03","cat":"messenger","group":{"id":"room_2023_summer","label":"Working Holiday Group Chat · Group"},"label":"3. I used to dream about summer vacation.","stage":null,"prev":"msg_m_ex_2023_summer_02","next":"msg_m_ex_2023_summer_04","speakers":{"anis":"Anis","sugar":"Sugar"},"icons":{"anis":"si_c012_00_s","sugar":"si_c140_00_s"},"lines":[{"id":"msg_m_ex_2023_summer_03_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 102110103 · After Working Holiday Group Chat chat 2. Ahhhhhhhh","key":null},{"id":"m_ex_2023_summer_03_1","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_1","text":"I used to dream about summer vacation.","jump":null},{"id":"m_ex_2023_summer_03_2","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_2","text":"The sky would be clear blue.","jump":null},{"id":"m_ex_2023_summer_03_3","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_3","text":"The sea was emerald green.","jump":null},{"id":"m_ex_2023_summer_03_4","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_4","text":"Instead, I'm lumped together with Sugar, going full castaway.","jump":null},{"id":"m_ex_2023_summer_03_5","type":"Speech","speaker":"anis","key":"Locale_SuddenMessage:m_ex_2023_summer_03_5","text":"There's not a hint of sweet summer vibes anywhere.","jump":null},{"id":"m_ex_2023_summer_03_6","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_2023_summer_03_6","text":"I'm sorry to hear that.","jump":"m_ex_2023_summer_03_8"},{"id":"m_ex_2023_summer_03_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_2023_summer_03_7","text":"I'll get back to you soon.","jump":"m_ex_2023_summer_03_8"},{"id":"m_ex_2023_summer_03_8","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_2023_summer_03_8","text":"Message failed to send.","jump":null},{"id":"m_ex_2023_summer_03_9","type":"Speec