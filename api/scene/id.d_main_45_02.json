ainScenario:d_main_45_02_28","text":"I figured that much, but what are all these floatie bits on the side?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_02_29","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_45_02_29","text":"Ah, those?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_02_30","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_45_02_30","text":"They're spotlights.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_02_31","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:d_main_45_02_31","text":"... There's gotta be more to them than that, though, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_02_32","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_45_02_32","text":"Non, that is all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_02_33","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:d_main_45_02_33","text":"But... why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_02_34","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_45_02_34","text":"A star must shine anytime, anywhere! She must appear belle at all times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_02_35","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:d_main_45_02_35","text":"Still, th