{"id":"d_main_04_05","cat":"main","group":{"id":"ch4","label":"Chapter 4 · Bouquet"},"label":"The Wounded","stage":"4-9 STAGE · End","prev":"d_main_04_04_e","next":"d_main_04_06","speakers":{"rapi":"Rapi","anis":"Anis","neon":"Neon","Narration":"Narration","mihara":"Mihara","yuni":"Yuni","Self":"Commander"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","Narration":"si_c999_00_s","mihara":"si_c161_00_s","yuni":"si_c160_00_s"},"lines":[{"id":"d_main_04_05_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_1","text":"I've administered first aid,","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":"bgm_mystery","movie":null,"shown":["rapi","anis","neon","mihara","yuni"],"affinity":null},{"id":"d_main_04_05_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_2","text":"but it's only a short-term solution. We need to get back to the Ark for proper treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_3","text":"It'll take too long to head back the way we came.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04_05_4","text":"Communications have been cut off. We can't call in a transport ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_5","text":"Plus...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_6","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_04_05_6","text":"Anis looks at Mihara and Yuni.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_7","text":"Those two are banged up real bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_8","text":"In other words, half of our squad is out of commission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_9","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_05_9","text":"... Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_10","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04_05_10","text":"... Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_11","text":"Don't beat yourself up. We were all in over our heads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_12","text":"What should we do? Should we risk it and light up a beacon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_13","text":"No. We need to keep moving forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_14","text":"Are you serious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_15","text":"There's a large radio tower nearby that should have a direct line to the Ark. Let's make our way there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_16","text":"How long will that take?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_17","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_17","text":"I'm not sure. Normally it would take 2 hours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_18","text":"Given the state we're in, I'd say we'll need half a day. The longer we take, the more likely we'll be going up against more Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_19","text":"Commander, can you do this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_20","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04_05_20","text":"I'm okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_21","text":"Yuni, can you cut off the Commander's feeling in the legs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_22","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04_05_22","text":"Um... For a short time, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_23","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04_05_23","text":"I can switch with the Commander. I'm a bit more well-versed in dealing with pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_24","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_24","text":"That's not a good idea. The last thing we need is another compromised Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_25","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04_05_25","text":"I'll try and fight through the pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_26","text":"... Thank you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_04_05_27","text":"Just try and bear through it for a little longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_28","text":"We're all done for once we get back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04_05_30","text":"They'll never let us get away with allowing the Commander to be injured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_31","text":"Now's not the time to be thinking about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04_05_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_04_05_32","text":"Our priority now is to contact the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}