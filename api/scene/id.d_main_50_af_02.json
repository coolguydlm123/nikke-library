{"id":"d_main_50_af_02","cat":"main","group":{"id":"ch50","label":"Chapter 50 · Ascension"},"label":"The Real Sky","stage":null,"prev":"d_main_50_af_01","next":"d_main_50_af_03","speakers":{"elegg":"Elegg","trony":"Trony","miranda":"Miranda"},"icons":{"elegg":"si_c500_00_s","trony":"si_c501_00_s","miranda":"si_c032_00_s"},"lines":[{"id":"d_main_50_af_02_1","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_1","text":"Hey! Mr. Commanderrr!","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":"none","movie":null,"shown":["elegg","trony"],"affinity":null},{"id":"d_main_50_af_02_2","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_2","text":"Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_3","text":"Elegg, Trony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_4","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_4","text":"So? How do you feel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_5","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_5","text":"I heard you fainted... Is it okay for you to be walking around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_6","text":"Yeah, I'm okay. Thanks for asking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_7","text":"You two look busy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_8","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_8","text":"Mmm... Yeah. The Ark's power just isn't what it was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_9","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_9","text":"We managed to ascend with Ms. Enikk's help, but the power source has gotten a lot weaker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_10","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_10","text":"It's causing problems all over the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_11","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_11","text":"The whole reason we're here right now is because it seems this place isn't getting electricity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_12","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_12","text":"You said before that the Ark's power source didn't have a lot of... well, power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_13","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_13","text":"Yeah, which is why have to do all we can right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_14","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_14","text":"At the moment, we have enough power to take care of problems that come up, but soon enough we won't be able to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_15","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_15","text":"That's why the Central Government is working fast. They're going to build power plants.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_16","text":"Inside the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_17","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_17","text":"That's the plan for now, but thinking long-term, they'll eventually have to build outside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_18","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_18","text":"Missilis is reeeally pushing this stuff through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_19","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_19","text":"Once it really gets started, we're gonna be working around the clock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_20","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_20","text":"We're already working around the clock...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_21","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_21","text":"*Sigh* Yeah we are...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_22","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_22","text":"Still,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_23","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_23","text":"at least we won't have to rely on that mysterious power source from now on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_24","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_24","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_25","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_26","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_26","text":"Anyway!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_27","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_27","text":"Until they sort out the power plant situation, we have to divvy out what limited power we have according to priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_28","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_28","text":"We won't be able to enjoy all the facilities we did before, but we'll survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_29","text":"Do you know what happened to the Ultra Massive Core that the Queen used?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_30","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_30","text":"Oh... that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_31","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_31","text":"We found out that if it gets too close to the Ark's core, they'd resonate with each other and then explode, so it got sent far away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_32","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_32","text":"It was also just judged to be too big, and most importantly, too easy to, um... abuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_33","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_33","text":"They sent it to a place called... Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_34","text":"... Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_35","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_35","text":"Yeah. I don't know where that is, but that's what I heard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_36","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_36","text":"Whoever's there said they'll take care of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_37","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_38","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_38","text":"Oh, just a second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_39","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_39","text":"Trony fiddles with her phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_40","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_40","text":"Mm... Elegg, I think we're done here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_41","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_41","text":"Let's move on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_42","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_42","text":"Oh. How long did we take?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_43","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_43","text":"A little over an hour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_44","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_44","text":"Nice! We're starting to get faster. At this rate, we might end up getting too fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_02_45","text":"Heading straight to your next job?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_46","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_46","text":"Yep. We gotta keep moving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_47","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_47","text":"Right now, in this moment, there might be a place where they can't even turn on a single computer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_48","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_48","text":"We have to hurry and help them, no matter what!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_49","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_50","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_50","text":"You know, they canceled the limited quest event scheduled for tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_51","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_51","text":"It's been postponed indefinitely... I-I guess it's only natural, given the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_52","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_50_af_02_52","text":"Wh-wh-why bring that up, Ms. Trony? Y-you make it sound like I'm just trying to finish quickly so I can go home and game...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_53","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_50_af_02_53","text":"Oh... I just thought you might not know...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_02_54","type":"Speech","speaker":"elegg","key":"Locale_MainSc