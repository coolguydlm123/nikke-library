{"id":"d_counseling_viper_09","cat":"counsel","group":{"id":"char1022","label":"Viper"},"label":"Advising Viper: 09","stage":null,"prev":"d_counseling_viper_08","next":"d_counseling_viper_10","speakers":{"viper":"Viper"},"icons":{"viper":"si_c112_00_s"},"lines":[{"id":"d_counseling_viper_09_1","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_1","text":"Jackal is such a brown-noser.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["viper"],"affinity":"_0"},{"id":"d_counseling_viper_09_2","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_2","text":"It's like she can't even think for herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_3","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_3","text":"If Crow told her to jump off a bridge, she'd probably do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_4","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_4","text":"Do you think that's why Crow likes Jackal more than me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_09_5","text":"Are you jealous of Jackal?","jump":"d_counseling_viper_09_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_viper_09_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_09_6","text":"You have plenty of your own positive qualities.","jump":"d_counseling_viper_09_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_viper_09_7","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_7","text":"Absolutely not!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_8","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_8","text":"How could anyone be jealous of a mindless sycophant?","jump":"d_counseling_viper_09_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_9","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_9","text":"Hey, you're right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_10","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_10","text":"I'm me, and no one else. I don't have to be like Jackal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_11","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_11","text":"I'd hate spending my life as a brainless lackey. How could I ever be jealous of Jackal?","jump":"d_counseling_viper_09_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_12","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_12","text":"Besides, if there's anyone whose affection I'm after,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_13","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_13","text":"it's you, not Crow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_14","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_09_14","text":"So I was hoping... you could show me some affection...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_09_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_viper_09_15","text":"I take my hand and caress Viper's face.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}