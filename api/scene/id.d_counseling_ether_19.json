{"id":"d_counseling_ether_19","cat":"counsel","group":{"id":"char3010","label":"Ether"},"label":"Advising Ether: 19","stage":null,"prev":"d_counseling_ether_18","next":"d_counseling_ether_20","speakers":{"ether":"Ether"},"icons":{"ether":"si_c291_00_s"},"lines":[{"id":"d_counseling_ether_19_1","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_1","text":"NO.7, have you been taking good care of yourself?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ether"],"affinity":"_0"},{"id":"d_counseling_ether_19_2","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_2","text":"Let me know if you're not feeling well. I'll prescribe you some medicine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ether_19_3","text":"... That won't be necessary.","jump":"d_counseling_ether_19_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ether_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ether_19_4","text":"Um... sure. Got it. Don't worry about me.","jump":"d_counseling_ether_19_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ether_19_5","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_5","text":"Why do you look so weirded out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_6","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_6","text":"I'm going out of my way to be nice to you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_7","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_7","text":"If that's how you show gratitude, maybe I'll send you the wrong medicine to teach you a lesson.","jump":"d_counseling_ether_19_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_8","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_8","text":"What is it? Why are you so nervous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_9","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_9","text":"At least you didn't turn me down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_10","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_10","text":"If you had, I might have ended up using it against you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_11","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_19_11","text":"You're as sharp as a tack!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_19_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ether_19_12","text":"Ether and I talk about how we look after our health.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}