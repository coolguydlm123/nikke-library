{"id":"s004_04","cat":"side","group":{"id":"side4","label":"EDEN SPEAR"},"label":"EDEN SPEAR: 4","stage":null,"prev":"s004_03","next":"s004_05","speakers":{"cecil":"Cecil","johan":"Johan","nayuta_n":"Nayuta","cecil_op_r":"Cecil"},"icons":{"cecil":"si_c929_00_s","johan":"si_c925_00_s","nayuta_n":"si_c9008_00_s","cecil_op_r":"si_c929_00_s"},"lines":[{"id":"s004_04_1","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_1","text":"Nihilister is practically dead right now.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_1","bgArt":"eventscene_side_04_01_1","image":null,"bgm":"bgm_story_cecil","movie":null,"shown":null,"affinity":null},{"id":"s004_04_2","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_2","text":"If she were human, she'd be in a coma.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_3","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_3","text":"Her body is only maintaining minimal functions, and she is unconscious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_4","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_4","text":"If left in this state, she will likely die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_5","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_5","text":"This Heretic will die...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_6","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_6","text":"Are her nanomachines not working?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_7","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_7","text":"Yes, not in the slightest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_8","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_8","text":"Normally, they would be working busily to repair her, but right now they're utterly still. You can scarcely tell they exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_9","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_9","text":"It's likely due to her core output having fallen to an extreme low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_10","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_10","text":"How far below normal is the output?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_11","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_11","text":"Assuming the maximum output is the same as before, it's down by approximately 97.8%.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_12","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_12","text":"It's no different from a corpse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_13","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_13","text":"Pretty much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_14","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_14","text":"I've tried injecting power into the core, electric stimulation, and everything else, but there's no response.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_15","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_15","text":"In fact, her body has rejected every attempt, causing output to drop even further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_16","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_16","text":"At this point, there's nothing new I can even try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_17","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_17","text":"There's intel that Nihilister can absorb Raptures to repair herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_18","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_18","text":"Have you tried using Rapture parts or cores?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_19","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_19","text":"That was the first thing I tried. Unfortunately, it failed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_20","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_21","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_21","text":"I see. We'll dispose of her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_22","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_22","text":"You're not intending to revive her? She's one of the high-ranking Raptures, so she must hold a wealth of valuable intel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_23","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_23","text":"Then dissect her. We might get some intel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_24","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_24","text":"She's essentially a mass of nanomachines and black boxes. We won't be able to extract anything useful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_25","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_25","text":"Besides, we have no interest in unknown technologies like nanomachines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_26","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_26","text":"That just makes her even more worthless. Dispose of her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_27","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_27","text":"I have two proposals.","jump":null,"exit":false,"enter":null,"bg":"AtlasCage_02","bgArt":"atlascage_02","image":null,"bgm":null,"movie":null,"shown":["cecil","johan"],"affinity":null},{"id":"s004_04_28","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_28","text":"First, we dedicate all efforts to revive Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_29","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_29","text":"Second, we bring in an expert on this unknown technology that she possesses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_30","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_31","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_31","text":"The first has the problem of a drastically low chance of success.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_32","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_32","text":"The second is something I have no intention of doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_33","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_33","text":"Then we will proceed with the second proposal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_34","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_34","text":"Anyone nearby?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_35","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_35","text":"Just a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_36","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_37","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_37","text":"There are two within a 20-kilometer radius. Four within 50 kilometers. Seven within 100.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_38","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_38","text":"The closest one is... 12 kilometers away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_39","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_39","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_40","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_40","text":"Looks like she was loitering nearby again, as if nothing happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_41","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_41","text":"Shall I call her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_42","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_43","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_43","text":"Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_44","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_44","text":"This is a once-in-a-lifetime opportunity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_45","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_45","text":"Must I really explain to you how huge a deal it is that we've captured a Heretic alive?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_46","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_46","text":"Wasn't it your principle to avoid taking risks?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_47","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_47","text":"This opportunity is so important that I'm prepared to cast that principle aside entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_48","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_49","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_04_49","text":"Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_50","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_50","text":"... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s004_04_51","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_51","text":"Call the monk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_52","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_52","text":"Truly, it hath been long,","jump":null,"exit":false,"enter":null,"bg":"Eden","bgArt":"eden","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta_n"],"affinity":null},{"id":"s004_04_53","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_53","text":"Young Hero Johan and Lady Cecil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_54","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_54","text":"Methinks it was wise indeed to send forth a summons, lest thou find thyself in need of aid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_55","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_56","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_56","text":"I still can't get used to her, no matter how many times I see her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_57","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_57","text":"To judge another's visage upon meeting strikes me as most unseemly, dost thou not agree?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_58","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_58","text":"I couldn't care less about your appearance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_59","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_59","text":"I've seen your head blow up more than once while you were loitering around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_60","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_60","text":"And every time, you come back like it's nothing. You might want to consider how that makes me feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_61","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_61","text":"It is not uncommon, verily, for a Nikke presumed dead to return alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_62","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_62","text":"Not when their head is blown to smithereens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_63","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_64","type":"Speech","speaker":"cecil_op_r","key":"Locale_SideStory:s004_04_64","text":"Johan, you're being awfully rude to our guest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_r"],"affinity":null},{"id":"s004_04_65","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_65","text":"Verily, it is so. This humble one's heart is narrow and petty, and thus hath been wounded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_66","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_66","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_67","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_67","text":"Cecil, are we really bringing this thing into Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_68","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_68","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_69","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_69","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_70","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_70","text":"Nay, what meanest thou by this? Bringing this thing within Eden? Me, sayest thou?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_71","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_71","text":"Hath thou at last perceived mine intent? I am deeply moved beyond measure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_72","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_72","text":"Then I shall take upon myself the charge of the alliance henceforth...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_73","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_73","text":"This is exactly the embodiment of an unknown technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_74","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_74","text":"The risk is far too great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_75","type":"Speech","speaker":"cecil_op_r","key":"Locale_SideStory:s004_04_75","text":"It's a bit late for that now, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_76","type":"Speech","speaker":"cecil_op_r","key":"Locale_SideStory:s004_04_76","text":"Besides, there's something even more dangerous already inside Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_77","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_77","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_78","type":"Speech","speaker":"cecil_op_r","key":"Locale_SideStory:s004_04_78","text":"Fear vanishes the moment you understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_79","type":"Speech","speaker":"cecil_op_r","key":"Locale_SideStory:s004_04_79","text":"And Nayuta can help you achieve that understanding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_80","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_81","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_81","text":"Monk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_82","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_82","text":"You called, Young Hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_83","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_83","text":"We will take you inside Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_84","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_84","text":"Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_85","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_85","text":"Let me make this clear: Don't try anything funny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_86","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_86","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_87","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_87","text":"I shall not go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_88","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_88","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_89","type":"Speech","speaker":"cecil_op_r","key":"Locale_SideStory:s004_04_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_90","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_90","text":"'Twas ye who summoned me. Verily, I presume thou hadst need of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_91","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_91","text":"And yet, having summoned me, thou dost turn me away at thy door?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_92","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_92","text":"As I have oft said, I am of narrow and petty heart, and in such a humor can I lend no aid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_93","type":"Speech","speaker":"cecil_op_r","key":"Locale_SideStory:s004_04_93","text":"Johan, ever heard of the term \"social skills\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_94","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_94","text":"I know. Now be quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_95","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_95","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_96","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_96","text":"We need your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_97","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_04_97","text":"I'll lead the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_98","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_04_98","text":"Johan turns and walks away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_99","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_99","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_04_100","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_04_100","text":"Very well, I shall turn a blind eye to this, but only this once, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}