{"id":"event_arkguardian1_05_s","cat":"event","group":{"id":"ev40098","label":"ARK GUARDIAN · Part 1"},"label":"The Strongest Nikke: A","stage":null,"prev":"event_arkguardian1_04_e","next":"event_arkguardian1_05_e","speakers":{"liliweiss":"Liliweiss","rapunzel_o":"Rapunzel","hongryeon_o":"Scarlet","dorothy":"Dorothy","snowwhite_o":"Snow White","commander":"Commander"},"icons":{"liliweiss":"si_c943_00_s","rapunzel_o":"si_c966_00_s","hongryeon_o":"si_c225_00_s","dorothy":"si_c233_00_s","snowwhite_o":"si_c224_00_s","commander":"si_c942_00_s"},"lines":[{"id":"event_arkguardian1_05_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_05_s_1","text":"*Rumble*","jump":null,"exit":false,"enter":null,"bg":"ArkGate_Far_d","bgArt":"arkgate_far_d","image":null,"bgm":"event_bgm_arkguardian_arkguardian","movie":null,"shown":["liliweiss","rapunzel_o","hongryeon_o","dorothy","snowwhite_o","commander"],"affinity":null},{"id":"event_arkguardian1_05_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_05_s_2","text":"The ground trembles as a deafening roar echoes through the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_3","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_05_s_3","text":"Here we go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_4","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_05_s_4","text":"That's quite the sound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_5","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_05_s_5","text":"Hmph. 'Tis naught but a mere door closing, yet it soundeth as though the earth itself doth tremble.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_05_s_6","text":"Try not to make it painfully obvious that you weren't listening during the briefing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_7","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_05_s_7","text":"The supply passage is massive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_8","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_05_s_8","text":"It's a multi-phase sealing process. Of course it's bound to be loud—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_05_s_9","text":"The words have barely left Liliweiss's mouth when, off in the distance, a cloud of dust begins to rise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_10","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_arkguardian1_05_s_10","text":"... They're coming. A lot of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_11","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_11","text":"Damn Raptures, scurrying around like a bunch of roaches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_12","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_12","text":"Multiple Tyrant-class Raptures confirmed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_13","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_13","text":"Those aren't small fry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_14","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_05_s_14","text":"Rapunzel, what's the status?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_15","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_05_s_15","text":"The mass-produced units are ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_16","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_05_s_16","text":"Good. Now all that's left is to fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_17","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_05_s_17","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_18","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_18","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_19","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_19","text":"Everyone, listen up.","jump":null,"exit":false,"enter":null,"bg":"EventScene_arkguardian_01","bgArt":"eventscene_arkguardian_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_20","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_20","text":"We're not gods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_21","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_21","text":"We can't save everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_22","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_22","text":"But we can save everything we see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_05_s_23","text":"The Commander turns around, pointing toward the buildings near the Ark's entrance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_24","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_24","text":"See that? That's a temporary bunker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_25","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_25","text":"It's called \"temporary\" because that's exactly what it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_26","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_26","text":"It's so badly constructed rifle rounds can easily penetrate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_27","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_27","text":"I don't know how many people are inside, but I'd bet it's a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_28","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_28","text":"So protect them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_29","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_29","text":"No matter what happens, protect the people inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_30","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_30","text":"Don't overthink things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_31","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_31","text":"Thought breeds doubt, and doubt breeds hesitation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_32","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_32","text":"Every time you hesitate, someone in there dies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_05_s_33","text":"The Commander turns back again, pointing at the rising cloud of dust in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_34","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_34","text":"Focus all your thoughts on them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_35","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_35","text":"We don't know what those things are or why they're here. But one thing's certain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_36","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_36","text":"They hate us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_37","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_37","text":"So don't let them do as they please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_38","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_38","text":"Don't let those damned scrap heaps take what you love.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_39","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_39","text":"There's no one else but us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_40","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_40","text":"It's up to us to stop them from doing what they please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_41","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_41","text":"So no matter what, we must win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_42","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_42","text":"Show them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_43","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_43","text":"Show them who they're trying to steal from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_05_s_44","text":"Everyone's gaze intensifies as they stare at the Raptures beyond the dust cloud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_05_s_45","text":"Their weapons are drawn, and their bodies are tense, poised to charge at any moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_46","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_46","text":"Goddess Squad, get ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_05_s_47","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_05_s_47","text":"Go. Destroy them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}