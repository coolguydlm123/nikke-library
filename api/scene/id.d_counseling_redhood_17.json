{"id":"d_counseling_redhood_17","cat":"counsel","group":{"id":"char5101","label":"Red Hood"},"label":"Advising Red Hood: 17","stage":null,"prev":"d_counseling_redhood_16","next":"d_counseling_redhood_18","speakers":{"redhood":"Red Hood"},"icons":{"redhood":"si_c470_00_s"},"lines":[{"id":"d_counseling_redhood_17_1","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_1","text":"You may find this hard to believe,","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":["redhood"],"affinity":"_0"},{"id":"d_counseling_redhood_17_2","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_2","text":"but Dorothy had a cute side to her as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_17_3","text":"Quit pulling my leg.","jump":"d_counseling_redhood_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_redhood_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_17_4","text":"Are we thinking of the same Dorothy?","jump":"d_counseling_redhood_17_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_redhood_17_5","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_5","text":"I'm not joking. I mean it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_6","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_6","text":"For example, how mad she'd get if you called her \"Snooty\",","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_7","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_7","text":"or the way she pretended to be indifferent about something, when everyone else could clearly see how upset she was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_8","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_8","text":"Actually...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_9","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_9","text":"Now that I think about it, maybe those can't really be filed under \"cute\".","jump":"d_counseling_redhood_17_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_10","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_10","text":"Of course we are!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_11","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_11","text":"There's only one true fair lady, and that's our dear Snooty Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_12","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_12","text":"She looks radically different from how she did in the past,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_13","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_17_13","text":"so I can't blame you finding it hard to imagine another side of her.","jump":"d_counseling_redhood_17_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_17_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_17_14","text":"Red Hood tells me more about how Dorothy differed in the past.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}