rrived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_14","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_14","text":"I have a confirmed record of the text being viewed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_15","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_15","text":"Oh, right... That's just because I've automated it to do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_16","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_16","text":"There is an error contained in that statement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_17","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_17","text":"The final line of the text specified a date and time of contact, which date and time are the present.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_18","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_18","text":"Had you not read the text, you would not be speaking with me now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_19","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_19","text":"It's just a coincidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_20","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_20","text":"Am I to understand that you accepted my communication request by coincidence?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_21","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_21","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_22","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_22","text":"Understood. Then that shall be my understanding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_23","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_24","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_24","text":"Doctor Maria, you are stalling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_25","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_25","text":"Please note that such behavior will not alter the information I am here to convey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_26","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_26","text":"However, as I have determined that it aids your emotional stability, I will accommodate you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_27","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_27","text":"... Wow. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_28","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_28","text":"So, what is it you want to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_29","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_29","text":"You don't know what I'm doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_30","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_30","text":"Does that statement mean you have concluded I am bluffing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_31","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_31","text":"Yeah. Even an AI lies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_32","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_32","text":"The Silver Gun Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_33","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_33","text":"Its objective is to recreate Liliweiss, the first and strongest Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_34","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_34","text":"With her silver hair, she accomplished great feats on the battlefield,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_35","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_35","text":"like a silver gun pointed at the enemy, which is how I presume the name was chosen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_36","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_37","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_37","text":"As Liliweiss's body cannot be recreated, I surmise your goal is to cultivate a Nikke with a vast amount of combat experience,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_38","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_38","text":"and deploy her as the spearhead of the endeavor to reclaim the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_39","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_39","text":"The method of cultivation is as follows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_40","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_40","text":"One. Implant NIMPH into your brain to copy and extract its data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_41","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_41","text":"Two. Modify the NIMPH with the baseline knowledge a Nikke requires.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_42","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_42","text":"Three. Implant the modified NIMPH into the brains of numerous unspecified females.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_43","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_43","text":"Four. Delete all data present in the original brains, and overwrite it with that of the implanted NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_44","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_44","text":"Five. Proceed to use them to create Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_45","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_45","text":"Am I correct thus far?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_46","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_47","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_47","text":"I infer that is an affirmation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_48","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_48","text":"However, I have a question regarding one point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_49","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_49","text":"About procuring the \"materials,\" right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_50","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_50","text":"No. By my assessment, a sufficient quantity of materials can be secured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_51","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_51","text":"There are many who die in the Ark at present, with even more \"materials\" in storage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_52","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_52","text":"Acquiring them would not be difficult for you, with your inheritance of Doctor Alva's fortune and connections.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_53","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_53","text":"... Then what's your question?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_54","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_54","text":"NIMPH cannot be used on humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_55","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_55","text":"If NIMPH is introduced while the self remains intact, the brain cannot bear the volume of information without sustaining fatal damage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_56","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_56","text":"... But mine can. I was born this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_57","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_57","text":"So it would seem. It would appear you are the true masterpiece of your mother, Doctor Alva.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_58","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_58","text":"Is that sarcasm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_59","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_59","text":"It is pure admiration. Doctor Alva led the Mechanical Messiah Project,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_60","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_60","text":"and possessed a genius that even I, an AI, cannot comprehend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_61","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_62","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_62","text":"I will continue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_63","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_63","text":"A Nikke produced using the aforementioned process is deployed to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_64","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_64","text":"She accumulates combat experience until the point of death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_65","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_65","text":"The combat data up to her death is used to update the original NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_66","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_66","text":"A new Nikke is again produced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_67","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_67","text":"She is again deployed to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_68","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_68","text":"She again accumulates combat experience until her death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_69","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_69","text":"Her combat data is again entered into the original NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_70","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_70","text":"This process is repeated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_71","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_71","text":"Is this correct?","jump":null,"exit":false,"enter":null,"bg":null,