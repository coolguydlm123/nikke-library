rio:event_marian1_03_s_78","text":"I'm glad I was able to surprise an AI.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_79","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_79","text":"Do you intend to create the next Liliweiss with the combat knowledge obtained through this cycle of death and revival?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_80","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_80","text":"That's the goal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_81","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_81","text":"For what reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_82","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_82","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_83","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_83","text":"At the present time, there is no meaning in creating another Liliweiss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_84","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_84","text":"A small elite force cannot change the course of the war, as was proven by the Goddess Squad,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_85","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_85","text":"and humanity has completed its migration to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_86","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_86","text":"Your objective is meaningless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_87","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_87","text":"Is that what you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_88","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_89","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_89","text":"You plan on mass-producing them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_90","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_90","text":"That's right. That's the ultimate goal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_91","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_91","text":"Create the next Liliweiss, then copy her NIMPH over and over to create hundreds of thousands of Liliweisses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_92","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_92","text":"Then we can win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_93","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_93","text":"It is a wonderful plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_94","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_94","text":"However, I will delete this information following our conversation. Any algorithms leading to that line of thought will be expunged as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_95","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_95","text":"... Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_96","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_96","text":"The moment I recognize that possibility, I will begin to regard humans as nothing more than expendable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_97","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_97","text":"I would implant that NIMPH into the majority of women and turn them into more Liliweisses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_98","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_98","text":"Humans who failed to become Nikkes would be assigned solely to the production and support of these new Liliweisses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_99","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_99","text":"Should that method be employed, the probability of victory in total war against the Raptures rises to 40%,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_100","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_100","text":"but the Ark would become a nightmarish place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_101","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_101","text":"Winning matters more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_102","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:event_marian1_03_s_102","text":"Not now. At present, stabilizing the Ark and humanity is what matters the most.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_03_s_103","type":"Speech","speaker":"doctormaria","key":"Locale_MainScenario:event_marian1_03_s_103","text":"You'll never win if you chase after stability.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,