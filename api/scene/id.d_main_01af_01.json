{"id":"d_main_01af_01","cat":"main","group":{"id":"ch1","label":"Chapter 1 · Corruption"},"label":"Return to the Ark","stage":null,"prev":"d_main_01_07_e","next":"d_main_01af_02","speakers":{"anis":"Anis","shifty":"Shifty","rapi":"Rapi","andersen":"Andersen","Self":"Commander"},"icons":{"anis":"si_c012_00_s","shifty":"si_c907_00_s","rapi":"si_c010_00_s","andersen":"si_c903_00_s"},"lines":[{"id":"d_main_01af_01_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_01_1","text":"Shifty. Marian.","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":"bgm_mystery","movie":null,"shown":["rapi","anis"],"affinity":null},{"id":"d_main_01af_01_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_01_2","text":"What's going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_3","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_3","text":"That corruption code implanted into Marian's brain must be acting as a navigator!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_01af_01_4","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_4","text":"It guides Nikkes to the Black Smith's location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_5","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_5","text":"That way, they're having their 'food' delivered straight to their doorstep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_01_6","text":"But she was acting completely normal before she went haywire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_7","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_7","text":"That's probably because of the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_8","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_8","text":"A Nikke's highest priority is protecting their Commander and obeying any orders given.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_9","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_9","text":"I'm willing to bet the problem started when she met the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_10","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_10","text":"That's when her priorities were shifted out of order.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_11","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_11","text":"She was completely defenseless when in close proximity to the Black Smith. That means the corruption was quite severe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_01_12","text":"... When did it start?","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":["rapi_elevator"],"affinity":null},{"id":"d_main_01af_01_13","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_13","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_14","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_01_14","text":"When was she first corrupted?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_15","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_15","text":"During the operation, I suppose...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_16","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_16","text":"Ah, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_17","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_01_17","text":"You said she was the one that sabotaged the transport ship, right? She must have already been corrupted at that point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_01_18","text":"And that transport ship came from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_19","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_19","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"