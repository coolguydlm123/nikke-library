ll,"shown":null,"affinity":null},{"id":"d_main_01af_01_27","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_27","text":"Yes, sir. However, one Nikke was destroyed during the operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_28","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_01_28","text":"If I didn't know any better, I'd say you're starting to develop a sense of humor, Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_29","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_29","text":"Should I forward the combat data to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_30","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_01_30","text":"No, that won't be necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_31","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_01_31","text":"I would, however, like to meet this Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_32","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_01af_01_32","text":"Make an appointment for this afternoon, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_01_33","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_01af_01_33","text":"I'll inform them.","jump":null,"exit":false,"enter":null,"