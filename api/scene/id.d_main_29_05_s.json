legg","key":"Locale_MainScenario:d_main_29_05_s_27","text":"Ah, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_05_s_28","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_05_s_28","text":"Sorry, but I have no idea where either of them are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_05_s_29","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_05_s_29","text":"What? Are you telling me you abandoned them and came here alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_05_s_30","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_05_s_30","text":"I know you're not on the same squad, but this is beyond the pale!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_05_s_31","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_05_s_31","text":"Hehe, awfully harsh words for someone you've only just met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_05_s_32","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_29_05_s_32","text":"I suppose I should explain what happened before you all arrived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_05_s_33","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_05_s_33","text":"This better be good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"