ump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_diesel_01_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_diesel_01_14","text":"I talk with Diesel while eating the strawberry candy she gives me.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}