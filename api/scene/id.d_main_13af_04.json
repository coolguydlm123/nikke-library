{"id":"d_main_13af_04","cat":"main","group":{"id":"ch13","label":"Chapter 13 · Comeback"},"label":"Fatigue","stage":null,"prev":"d_main_13af_03","next":"d_main_13af_05","speakers":{"rapi":"Rapi","anis":"Anis","neon":"Neon","mary":"Mary"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","mary":"si_c130_00_s"},"lines":[{"id":"d_main_13af_04_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_1","text":"Ugh... Argh..!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_emergency","movie":null,"shown":["neon","anis"],"affinity":null},{"id":"d_main_13af_04_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_2","text":"Neon! Coolant!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_3","text":"W-we used it all up!\nAll five boxes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_4","text":"Damn!\nWhy isn't her temperature going down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_5","text":"It's no use, we have to call the Repair Center!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_6","text":"It's... okay...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_7","text":"It's... stabilizing...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_8","text":"Do you know how many times you've said that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_9","text":"Stop being so stubborn and let's go.\nYou'll die if you keep this up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_13af_04_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_11","text":"It's okay.\nI feel... much better, really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_13af_04_13","text":"Anis grabs Rapi's wrist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_14","text":"... Her temperature is back to normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_15","text":"Oops...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_16","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_16","text":"Thanks you two. Sorry to worry you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_17","text":"Does this have something to do with your hair turning red?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_18","text":"... Mm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_inark","movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_19","text":"If you'd stayed like that for a millisecond longer, your brain would have been fried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_20","text":"You saved our skins back there, but it was a dangerous move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_21","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_22","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_22","text":"Are you going to explain what that was?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_23","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_23","text":"Think of it as a last resort. When you use it, it ravages your body.\nPretty simple stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_24","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_24","text":"I wouldn't call hurling an object at the speed of sound simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_26","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_26","text":"Fine, I won't press you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_27","text":"... Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_28","text":"The Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_29","text":"They got stabbed in the stomach, so they're being treated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_30","text":"Hey, come to think of it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_31","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_31","text":"Master is returning today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_32","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_33","text":"How can they have recovered so soon?\nAre they even human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_34","text":"Master is heads and shoulders above regular humans!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_35","text":"What are you so proud for? You didn't do anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_36","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_36","text":"... And Marian?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_38","text":"The corruption seems to have had a direct effect on her brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_39","text":"After the neural wipe, she'll be assigned to our squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_40","text":"This was the decision of the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_41","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_13af_04_41","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_13af_04_42","text":"Do you think Master is okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_43","text":"I... I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_13af_04_44","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_45","text":"Yikes, speak of the devil!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mary"],"affinity":null},{"id":"d_main_13af_04_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_47","text":"What's with this bed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_48","text":"What's all that equipment beside it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_49","type":"Speech","speaker":"mary","key":"Locale_MainScenario:d_main_13af_04_49","text":"We're going to have the Commander's Room double as a hospital room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_50","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_51","type":"Speech","speaker":"mary","key":"Locale_MainScenario:d_main_13af_04_51","text":"That's what the Commander requested.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_52","text":"Is that okay? Doing all of this, I mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_53","type":"Speech","speaker":"mary","key":"Locale_MainScenario:d_main_13af_04_53","text":"Of course, it's not okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_54","type":"Speech","speaker":"mary","key":"Locale_MainScenario:d_main_13af_04_54","text":"The risk of infection is higher and it's not as well-equipped as a proper hospital room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_55","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_55","text":"Commander, go back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_13af_04_56","text":"Go back and return when you've fully recuperated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_13af_04_57","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_13af_04_57","text":"I can't do that.","jump":null,"exit":false,"ente