{"id":"msg_m_ex_seraphim_01","cat":"messenger","group":{"id":"room_seraphim","label":"Seraphim · Group"},"label":"1. Commander","stage":null,"prev":null,"next":"msg_m_ex_seraphim_02","speakers":{"pepper":"Pepper","mary":"Mary"},"icons":{"pepper":"si_c131_00_s","mary":"si_c130_00_s"},"lines":[{"id":"m_ex_seraphim_01_1","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_1","text":"Commander","jump":null},{"id":"m_ex_seraphim_01_2","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_2","text":"did you go to the hospital today?","jump":null},{"id":"m_ex_seraphim_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_01_3","text":"Nope.","jump":null},{"id":"m_ex_seraphim_01_4","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_4","text":"??","jump":null},{"id":"m_ex_seraphim_01_5","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_5","text":"Is that so?","jump":null},{"id":"m_ex_seraphim_01_6","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_6","text":"How come I saw you at the hospital, then?","jump":null},{"id":"m_ex_seraphim_01_7","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_7","text":"Oh, that. Hee-hee.","jump":null},{"id":"m_ex_seraphim_01_8","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_8","text":"Isn't it because we miss Commander too much?","jump":null},{"id":"m_ex_seraphim_01_9","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_9","text":"That's true, aha.","jump":null},{"id":"m_ex_seraphim_01_10","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_10","text":"We miss you, Commander!!","jump":null},{"id":"m_ex_seraphim_01_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_01_11","text":"Thanks for your concern.","jump":null},{"id":"m_ex_seraphim_01_12","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_12","text":"Pepper.","jump":null},{"id":"m_ex_seraphim_01_13","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_13","text":"Are there times,","jump":null},{"id":"m_ex_seraphim_01_14","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_14","text":"when you wanna tie Commander up to a bed,","jump":null},{"id":"m_ex_seraphim_01_15","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_15","text":"and just examine them all day?","jump":null},{"id":"m_ex_seraphim_01_16","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_16","text":"Nope! I never thought about that kind of thing!","jump":null},{"id":"m_ex_seraphim_01_17","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_17","text":"That's so wrong!","jump":null},{"id":"m_ex_seraphim_01_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_01_18","text":"That's a crime!","jump":null},{"id":"m_ex_seraphim_01_19","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_19","text":"It sure is!","jump":null},{"id":"m_ex_seraphim_01_20","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_20","text":"However,","jump":null},{"id":"m_ex_seraphim_01_21","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_21","text":"why do I feel","jump":null},{"id":"m_ex_seraphim_01_22","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_22","text":"that is more like therapy, though?","jump":null},{"id":"m_ex_seraphim_01_23","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_23","text":"It's all because Commander always gets wounded. Hehe.","jump":null},{"id":"m_ex_seraphim_01_24","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_24","text":"What's worse, they're always leaving the hospital ahead of schedule","jump":null},{"id":"m_ex_seraphim_01_25","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_25","text":"for the sake of completing tasks. Hehe.","jump":null},{"id":"m_ex_seraphim_01_26","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_26","text":"They never considering other people's feelings, hehe.","jump":null},{"id":"m_ex_seraphim_01_27","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_27","text":"Hehehe.","jump":null},{"id":"m_ex_seraphim_01_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_01_28","text":"Even so, you can't tie me up for a medical examination.","jump":null},{"id":"m_ex_seraphim_01_29","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_29","text":"That's for sure.","jump":null},{"id":"m_ex_seraphim_01_30","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_30","text":"You really think I'd do that?","jump":null},{"id":"m_ex_seraphim_01_31","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_31","text":"That's right, Commander.","jump":null},{"id":"m_ex_seraphim_01_32","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_32","text":"Marry is not that kind of person.","jump":null},{"id":"m_ex_seraphim_01_33","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_33","text":"That's to say, Commander.","jump":null},{"id":"m_ex_seraphim_01_34","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_34","text":"Before I really tie you up to the bed,","jump":null},{"id":"m_ex_seraphim_01_35","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_35","text":"you should come and take a comprehensive examination, understand?","jump":null},{"id":"m_ex_seraphim_01_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_01_36","text":"Got it.","jump":null},{"id":"m_ex_seraphim_01_37","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_37","text":"Huh? Are you sure?","jump":null},{"id":"m_ex_seraphim_01_38","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_38","text":"Then, lemme make an appointment for you!","jump":null},{"id":"m_ex_seraphim_01_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_01_39","text":"Wait a sec.","jump":null},{"id":"m_ex_seraphim_01_40","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_40","text":"Good idea, hee-hee.","jump":null},{"id":"m_ex_seraphim_01_41","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_41","text":"As expected from our Pepper. Always quick on her feet.","jump":null},{"id":"m_ex_seraphim_01_42","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_42","text":"Tee-hee, I'll take that as a compliment.","jump":null},{"id":"m_ex_seraphim_01_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_seraphim_01_43","text":"Hold on a sec!","jump":null},{"id":"m_ex_seraphim_01_44","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_seraphim_01_44","text":"See you then, Commander!","jump":null},{"id":"m_ex_seraphim_01_45","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_seraphim_01_45","text":"See you then!","jump":null}],"chat":true}