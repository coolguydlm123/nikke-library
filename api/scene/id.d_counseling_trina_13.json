nt form.","jump":"d_counseling_trina_13_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_trina_13_7","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_13_7","text":"I know... I ought to try communicating more with them from now on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_13_8","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_13_8","text":"There might be others who are hiding their pain.","jump":"d_counseling_trina_13_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_13_9","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_13_9","text":"... That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_13_10","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_13_10","text":"Even in death, that tree will be of help to someone, so I shouldn't dwell only on the sadness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_13_11","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_13_11","text":"Thank you, Sun. Your words comforted me a lot.","jump":"d_counseling_trina_13_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_13_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_trina_13_12","text":"Trina and I talk about the death of a tree.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}