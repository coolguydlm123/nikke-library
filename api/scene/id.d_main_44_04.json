{"id":"d_main_44_04","cat":"main","group":{"id":"ch44","label":"Chapter 44 · Path"},"label":"The Forgotten Ones","stage":"44-20 STAGE · Start","prev":"d_main_44_03","next":"d_main_44_05","speakers":{"papillon":"Papillon","rapi_red":"Rapi","anis_i":"Anis","johan":"Johan","cecil":"Cecil"},"icons":{"papillon":"si_c890_00_s","rapi_red":"si_c016_00_s","anis_i":"si_c017_00_s","johan":"si_c925_00_s","cecil":"si_c929_00_s"},"lines":[{"id":"d_main_44_04_1","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_1","text":"Hey, my buzzing bees!","jump":null,"exit":false,"enter":null,"bg":"Eden","bgArt":"eden","image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":["rapi_red","anis_i","papillon"],"affinity":null},{"id":"d_main_44_04_2","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_04_2","text":"Papillon!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_3","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_3","text":"It's been a while. Thanks for coming over in such a hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_4","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_4","text":"Oh my. Honey looks the same as ever, but you two have gotten quite the makeover.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_5","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_5","text":"And it's not just your clothes. A lot of exciting things must have happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_6","text":"Yeah. A lot has happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_7","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_7","text":"Well, we've had our fair share of excitement too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_8","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_8","text":"Hold up, why are you the one coming to greet us? Where's Inherit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_9","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_10","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_10","text":"Aren't you their hostage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_11","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_11","text":"I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_12","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_12","text":"However, Eden's a bit short-handed these days,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_13","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_13","text":"so even a hostage like me is being put to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_14","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_04_14","text":"Short-handed...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_15","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_15","text":"Come on, I'll tell you more inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_16","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_16","text":"Oh, and just a heads-up. You'll want to brace yourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_17","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_17","text":"It's not a pleasant story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_18","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_18","text":"What's with the creepy foreshadowing...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_19","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_19","text":"You'll understand once you hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_20","text":"Papillon...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_21","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_21","text":"Yes, Honey?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_22","text":"You look pretty banged up. Are you sure you're okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_23","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_24","text":"You're covered in scratches and cuts. If they're mistreating you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_25","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_25","text":"Oh, come now, Honey. What are you even talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_26","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_26","text":"They're not that kind of people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_04_27","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_28","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_28","text":"These are... training injuries. No need to worry your pretty head over it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_29","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_29","text":"Hehe. By the way, did you just check me out as soon as we met? So naughty, Honey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_30","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_30","text":"Save that interest for later, when it's just the two of us, all right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_31","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_31","text":"Now, off to Eden we go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_04_32","text":"Papillon turns around and walks off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_33","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_33","text":"Rapi, Commander... Papillon seems like she's kinda...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_34","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_04_34","text":"Coming on strong? I know. She's a typical flirt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_35","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_35","text":"That's not what I was gonna say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_36","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_36","text":"Why is she overdoing it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_38","text":"Now that you mention it, she does seem unusually chipper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_39","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_39","text":"Yeah... People usually talk like that right before they drop some really bad news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_40","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_40","text":"First that disaster zone we saw back there, and now Papillon's acting all strange... What the heck happened here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_41","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_04_41","text":"I doubt it was anything catastrophic. This is Eden, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_42","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_04_42","text":"It's probably a minor issue that they need some help dealing with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_43","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_43","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_44","text":"... Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_45","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_45","text":"You're here.","jump":null,"exit":false,"enter":null,"bg":"EdenIndoor","bgArt":"edenindoor","image":null,"bgm":"bgm_chapter44_field_ashesofeden","movie":null,"shown":["papillon","cecil","johan"],"affinity":null},{"id":"d_main_44_04_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_46","text":"Johan!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_47","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_47","text":"Don't think you can just come in here and give me a hug. Step back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_48","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_49","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_49","text":"One of you is missing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_50","text":"You mean Neon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_51","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_51","text":"Yeah, that firepower girl with the glasses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_52","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_53","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_53","text":"Did something happen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_54","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_54","text":"Huh? No. She's just kinda... temporarily doing her own thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_55","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_55","text":"I see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_56","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_56","text":"Where's Inherit, by the way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_57","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_04_57","text":"They always like picking fights over everything, so I've got a bunch of comebacks ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_58","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_59","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_04_59","text":"Looks like you've done some renovations to Eden's interior? The materials seem different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_60","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_44_04_60","text":"Yes, we basically rebuilt it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_61","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_61","text":"I hate to break up the big happy reunion, but how about we move it along?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_62","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_44_04_62","text":"You ready, Cecil?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_04_63","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_44_04_63","text":"Yes. The meeting room and the data are all re