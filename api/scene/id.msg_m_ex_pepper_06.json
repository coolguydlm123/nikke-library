{"id":"msg_m_ex_pepper_06","cat":"messenger","group":{"id":"room_pepper","label":"Pepper · Nikke"},"label":"6. Commander,","stage":null,"prev":"msg_m_ex_pepper_05","next":null,"speakers":{"pepper":"Pepper"},"icons":{"pepper":"si_c131_00_s"},"lines":[{"id":"m_ex_pepper_06_1","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_1","text":"Commander,","jump":null},{"id":"m_ex_pepper_06_2","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_2","text":"I wanted to consult with you about something.","jump":null},{"id":"m_ex_pepper_06_3","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_3","text":"Are you free?","jump":null},{"id":"m_ex_pepper_06_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_06_4","text":"Sure, what's up?","jump":null},{"id":"m_ex_pepper_06_5","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_5","text":"I've been thinking for a while","jump":null},{"id":"m_ex_pepper_06_6","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_6","text":"about adding some decorations to the rooms","jump":null},{"id":"m_ex_pepper_06_7","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_7","text":"where long-term patients are staying.","jump":null},{"id":"m_ex_pepper_06_8","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_8","text":"That way, we could make them feel more at home during their stay.","jump":null},{"id":"m_ex_pepper_06_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_06_9","text":"That's a great idea.","jump":null},{"id":"m_ex_pepper_06_10","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_10","text":"You think so?","jump":null},{"id":"m_ex_pepper_06_11","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_11","text":"The only thing is that I don't really have a lot of money to spare,","jump":null},{"id":"m_ex_pepper_06_12","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_12","text":"so what are some affordable things you think I could buy?","jump":null},{"id":"m_ex_pepper_06_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_06_13","text":"How about hanging some paintings?","jump":null},{"id":"m_ex_pepper_06_14","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_14","text":"Paintings?","jump":null},{"id":"m_ex_pepper_06_15","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_15","text":"Hmm...","jump":null},{"id":"m_ex_pepper_06_16","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_16","text":"Wouldn't it get expensive to hang one in every room?","jump":null},{"id":"m_ex_pepper_06_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_06_17","text":"You can hang the pictures made by the young patients.","jump":null},{"id":"m_ex_pepper_06_18","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_18","text":"!!","jump":null},{"id":"m_ex_pepper_06_19","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_19","text":"Ooh!","jump":null},{"id":"m_ex_pepper_06_20","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_20","text":"That's a really good idea.","jump":null},{"id":"m_ex_pepper_06_21","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_21","text":"The young patients can have fun drawing,","jump":null},{"id":"m_ex_pepper_06_22","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_22","text":"and the long-term patients","jump":null},{"id":"m_ex_pepper_06_23","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_23","text":"can benefit from having a bit more color in their rooms.","jump":null},{"id":"m_ex_pepper_06_24","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_24","text":"You're the best, Commander!","jump":null},{"id":"m_ex_pepper_06_25","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_25","text":"I better go prepare the art supplies.","jump":null},{"id":"m_ex_pepper_06_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_pepper_06_26","text":"Good luck.","jump":null},{"id":"m_ex_pepper_06_27","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_27","text":"Thanks,","jump":null},{"id":"m_ex_pepper_06_28","type":"Speech","speaker":"pepper","key":"Locale_SuddenMessage:m_ex_pepper_06_28","text":"Commander!","jump":null}],"chat":true}