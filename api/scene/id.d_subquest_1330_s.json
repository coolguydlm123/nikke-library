{"id":"d_subquest_1330_s","cat":"sub","group":{"id":"req_centralgovernmenttriangle","label":"Request · Central Government: Triangle"},"label":"Request 1330 · Start","stage":null,"prev":null,"next":"d_subquest_1330_e","speakers":{"privaty":"Privaty","yulha":"Yulha","admi":"Admi","anis":"Anis","rapi":"Rapi","neon":"Neon"},"icons":{"privaty":"si_c170_00_s","yulha":"si_c171_00_s","admi":"si_c172_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_subquest_1330_s_1","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_1","text":"Hey, Commander.","jump":null,"exit":false,"enter":null,"bg":"DestroyedStreet","bgArt":"destroyedstreet","image":null,"bgm":"bgm_collapse","movie":null,"shown":["neon","anis","rapi","privaty","yulha","admi"],"affinity":null},{"id":"d_subquest_1330_s_2","type":"Speech","speaker":"yulha","key":"Locale_SubScenario:d_subquest_1330_s_2","text":"You got here fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_3","type":"Speech","speaker":"admi","key":"Locale_SubScenario:d_subquest_1330_s_3","text":"Hello, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_4","type":"Self","speaker":null,"key":"Locale_SubScenario:d_subquest_1330_s_4","text":"What's the matter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_5","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_5","text":"We received reports that a civilian entered an unused shelters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_6","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_6","text":"We were trying to search the inside but because of the Raptures, it's proving difficult to break through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_7","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_7","text":"It pains me to say this, but you are the only unit which has a degree of autonomy in terms of deployment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_8","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_8","text":"That's why we requested assistance from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_9","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1330_s_9","text":"You're telling me you can't even handle a few Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_10","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1330_s_10","text":"You're just trying to pawn off this job, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_11","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_12","type":"Speech","speaker":"yulha","key":"Locale_SubScenario:d_subquest_1330_s_12","text":"Our current bodies are not meant for combat use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_13","type":"Speech","speaker":"yulha","key":"Locale_SubScenario:d_subquest_1330_s_13","text":"As a result, our combat capabilities are significantly reduced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_14","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1330_s_14","text":"So you're basically the same as humans while you're in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_15","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_15","text":"You're not far off. As we are a defense force typically stationed in the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_16","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_16","text":"we are kept out of combat mode unless we are sent to the surface or are actively involved in a special assignment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_17","type":"Speech","speaker":"admi","key":"Locale_SubScenario:d_subquest_1330_s_17","text":"Given the abruptness of this Rapture attack, we didn't have time to switch into our combat builds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_18","type":"Speech","speaker":"admi","key":"Locale_SubScenario:d_subquest_1330_s_18","text":"We're doing all we can to help the civilians, but taking Raptures head-on in our current state would be suicide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_19","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1330_s_19","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_20","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1330_s_20","text":"Commander, this is a fantastic opportunity for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_21","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1330_s_21","text":"Having the Triangle Squad in our debt would be greatly advantageous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_22","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_22","text":"Huh? What's all this about debt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_23","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_23","text":"What about helping us out of the goodness of your heart?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_24","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1330_s_24","text":"Don't be so naïve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_25","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1330_s_25","text":"You're always making our lives a living hell, so don't try and act like we're buddy-buddy and gonna be doing you a favor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_26","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1330_s_26","text":"Yeah, what she said!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_27","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1330_s_27","text":"I understand that you're close to the Commander, but that doesn't make us friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_28","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1330_s_28","text":"Tell 'em, Anis!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_29","type":"Speech","speaker":"anis","key":"Locale_SubScenario:d_subquest_1330_s_29","text":"We haven't forgotten about Ex... I mean, Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_30","type":"Speech","speaker":"neon","key":"Locale_SubScenario:d_subquest_1330_s_30","text":"Mhmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_31","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_32","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_32","text":"We were under orders. We had no choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_33","type":"Speech","speaker":"yulha","key":"Locale_SubScenario:d_subquest_1330_s_33","text":"Privaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_34","type":"Speech","speaker":"yulha","key":"Locale_SubScenario:d_subquest_1330_s_34","text":"You are an agent of the Central Government, and part of the Triangle Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_35","type":"Speech","speaker":"admi","key":"Locale_SubScenario:d_subquest_1330_s_35","text":"Conduct yourself accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_36","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_37","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_37","text":"I will issue a formal report notifying the relevant bodies of the support you have provided.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_38","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_38","text":"There will be commensurate rewards issued to you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_39","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1330_s_39","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_40","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_subquest_1330_s_40","text":"Let's head in, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_41","type":"Self","speaker":null,"key":"Locale_SubScenario:d_subquest_1330_s_41","text":"Yes. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_42","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_42","text":"Once you take out the Raptures, we'll head into the shelter and confirm the status of the civilian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1330_s_43","type":"Speech","speaker":"privaty","key":"Locale_SubScenario:d_subquest_1330_s_43","text":"Thank you for your assistance in this matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}