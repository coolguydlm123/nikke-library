:"isabel","key":"Locale_SubScenario:d_subquest_1311_e_21","text":"There was something about you that I found so endearing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1311_e_22","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:d_subquest_1311_e_22","text":"I started to imagine you treating me\nthe way you treated them... and what that would be like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1311_e_23","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:d_subquest_1311_e_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1311_e_24","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:d_subquest_1311_e_24","text":"If it hadn't been for that tiff you and Eden have over the Vapaus,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1311_e_25","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:d_subquest_1311_e_25","text":"I'd have expressed my feelings a little sooner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1311_e_26","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:d_subquest_1311_e_26","text":"So, erm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_subquest_1311_e_27","type":"Speech","speaker":"isabel","key":"Locale_SubScenario:d_subquest_1311_e_27","text":"Would you like to go on another mission sometime? Just you and me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movi