{"id":"d_counseling_ludmilla_02","cat":"counsel","group":{"id":"char5033","label":"Ludmilla"},"label":"Advising Ludmilla: 02","stage":null,"prev":"d_counseling_ludmilla_01","next":"d_counseling_ludmilla_03","speakers":{"ludmilla":"Ludmilla"},"icons":{"ludmilla":"si_c190_00_s"},"lines":[{"id":"d_counseling_ludmilla_02_1","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_1","text":"I have been thinking.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ludmilla"],"affinity":"_0"},{"id":"d_counseling_ludmilla_02_2","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_2","text":"This world is a cruel place. It is my wish that Alice will quickly come of age, so that she can get by on her own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_3","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_3","text":"However, I fear that she may lose her innocence in the process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_4","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_4","text":"Then again, as her guardian, perhaps I am just being selfish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_02_5","text":"Even if she has to grow up, Alice will always be Alice.","jump":"d_counseling_ludmilla_02_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ludmilla_02_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_02_6","text":"It's fine. All parents are like that.","jump":"d_counseling_ludmilla_02_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ludmilla_02_7","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_7","text":"Do you truly think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_8","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_8","text":"Even when they come of age, people don't really change.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_9","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_9","text":"Hearing that puts me at ease. I thank you.","jump":"d_counseling_ludmilla_02_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_10","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_10","text":"Somehow, I thought that I would be different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_11","type":"Speech","speaker":"ludmilla","key":"Locale_Counseling:d_counseling_ludmilla_02_11","text":"I shouldn't worry so much. This all will pass in time, like everything else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_02_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_02_12","text":"I spend time with Ludmilla while thinking about Alice.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}