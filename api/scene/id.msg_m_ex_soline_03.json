{"id":"msg_m_ex_soline_03","cat":"messenger","group":{"id":"room_soline","label":"Soline · Nikke"},"label":"3. Commander,","stage":null,"prev":"msg_m_ex_soline_02","next":"msg_m_ex_soline_frostticket_01","speakers":{"soline":"Soline"},"icons":{"soline":"si_c071_00_s"},"lines":[{"id":"m_ex_soline_03_1","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_1","text":"Commander,","jump":null},{"id":"m_ex_soline_03_2","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_2","text":"are you busy?","jump":null},{"id":"m_ex_soline_03_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_3","text":"Nope, what's up?","jump":null},{"id":"m_ex_soline_03_4","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_4","text":"Um... well,","jump":null},{"id":"m_ex_soline_03_5","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_5","text":"since you're not judgmental, I wanted to ask you","jump":null},{"id":"m_ex_soline_03_6","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_6","text":"whether or not you think it's childish to have a sweet tooth?","jump":null},{"id":"m_ex_soline_03_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_7","text":"What makes you ask?","jump":null},{"id":"m_ex_soline_03_8","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_8","text":"Well...","jump":null},{"id":"m_ex_soline_03_9","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_9","text":"I've a young friend who","jump":null},{"id":"m_ex_soline_03_10","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_10","text":"loves to eat sweets,","jump":null},{"id":"m_ex_soline_03_11","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_11","text":"so people always end up treating her like a little kid.","jump":null},{"id":"m_ex_soline_03_12","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_12","text":"She told me that she tried to stop eating as much candy","jump":null},{"id":"m_ex_soline_03_13","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_13","text":"to counter this, but it inevitably","jump":null},{"id":"m_ex_soline_03_14","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_14","text":"puts her in a foul mood.","jump":null},{"id":"m_ex_soline_03_15","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_15","text":"Do you happen to have any solutions?","jump":null},{"id":"m_ex_soline_03_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_16","text":"I have a sweet tooth myself.","jump":null},{"id":"m_ex_soline_03_17","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_17","text":"Really?","jump":null},{"id":"m_ex_soline_03_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_18","text":"Do I seem childish to you?","jump":null},{"id":"m_ex_soline_03_19","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_19","text":"No, not at all.","jump":null},{"id":"m_ex_soline_03_20","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_20","text":"Hey, that's it!","jump":null},{"id":"m_ex_soline_03_21","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_21","text":"Having a sweet tooth isn't the issue!","jump":null},{"id":"m_ex_soline_03_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_22","text":"Exactly, so tell your friend not to let others get her down.","jump":null},{"id":"m_ex_soline_03_23","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_23","text":"So it's okay to have a sweet tooth?","jump":null},{"id":"m_ex_soline_03_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_24","text":"Of course.","jump":null},{"id":"m_ex_soline_03_25","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_25","text":"Woo-hoo!","jump":null},{"id":"m_ex_soline_03_26","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_26","text":"This was really bugging me for the past couple of days.","jump":null},{"id":"m_ex_soline_03_27","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_27","text":"Thanks, Commander!","jump":null},{"id":"m_ex_soline_03_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_28","text":"Remember to pass what I've said onto your friend.","jump":null},{"id":"m_ex_soline_03_29","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_29","text":"Who?","jump":null},{"id":"m_ex_soline_03_30","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_30","text":"Oh! Um... right!","jump":null},{"id":"m_ex_soline_03_31","type":"Speech","speaker":"soline","key":"Locale_SuddenMessage:m_ex_soline_03_31","text":"I'll be sure to tell her...","jump":null},{"id":"m_ex_soline_03_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soline_03_32","text":"I'm sure you will.","jump":null}],"chat":true}