{"id":"d_counseling_kilo_20","cat":"counsel","group":{"id":"char5053","label":"Kilo"},"label":"Advising Kilo: 20","stage":null,"prev":"d_counseling_kilo_19","next":null,"speakers":{"kilo":"Kilo"},"icons":{"kilo":"si_c977_00_s"},"lines":[{"id":"d_counseling_kilo_20_1","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_1","text":"If I want to be liked by someone that I've only met recently,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["kilo","talos"],"affinity":"_0"},{"id":"d_counseling_kilo_20_2","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_2","text":"how should I act?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_kilo_20_3","text":"The most important thing is confidence. Conduct yourself as if that person is already a long-time friend.","jump":"d_counseling_kilo_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_kilo_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_kilo_20_4","text":"Be careful not to act too impetuously, so as not to arouse suspicion.","jump":"d_counseling_kilo_20_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_kilo_20_5","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_5","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_6","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_6","text":"I've never had a close friend...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_7","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_7","text":"so I don't really know what that feels like.","jump":"d_counseling_kilo_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_8","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_8","text":"Oh, okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_9","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_9","text":"That is exactly what I do anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_10","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_10","text":"As long as the other person doesn't think poorly of me or think I'm strange, that's good enough for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_11","type":"Speech","speaker":"kilo","key":"Locale_Counseling:d_counseling_kilo_20_11","text":"I'm glad that I'm on the right track.","jump":"d_counseling_kilo_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_kilo_20_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_kilo_20_12","text":"I have a conversation with Kilo about how to be liked by someone.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}