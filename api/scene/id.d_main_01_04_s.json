{"id":"d_main_01_04_s","cat":"main","group":{"id":"ch1","label":"Chapter 1 · Corruption"},"label":"Conflict: A","stage":"1-1 STAGE · Start","prev":"d_main_01_03_e","next":"d_main_01_04_e","speakers":{"rapi":"Rapi","Self":"Commander","marian":"Marian","anis":"Anis"},"icons":{"rapi":"si_c010_00_s","marian":"si_c013_00_s","anis":"si_c012_00_s"},"lines":[{"id":"d_main_01_04_s_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_1","text":"Did you really just take up your post yesterday?","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":"bgm_distress_b","movie":null,"shown":["marian","rapi","anis"],"affinity":null},{"id":"d_main_01_04_s_2","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01_04_s_2","text":"Is there something wrong with that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_3","text":"How can a complete amateur be sent to replace a commander killed in the line of duty...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_4","text":"What were they thinking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_5","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_5","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_6","text":"... Nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_7","text":"Anyway, you're the Commander of this squad from here on out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_8","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_8","text":"If you don't have any objections, I'd like to go over our current course of action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_9","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01_04_s_9","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_10","text":"Okay, I'll brief you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_11","text":"Forty-six hours ago, we lost communication with a Nikke squad that was patrolling this area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_12","text":"They went completely dark, so we decided to send out a search party.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_13","text":"During our search, an accident resulted in the death of our now-former Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_14","text":"The only problem is that the deceased Commander was the one who knew the coordinates to our destination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_15","text":"You wouldn't happen to know anything about that, would you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_16","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01_04_s_16","text":"No, I don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_17","text":"I figured as much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_18","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_18","text":"I know the coordinates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_19","text":"Yeah, I figured that too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_20","text":"... Wait, what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_21","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_21","text":"That information was input into my system when I was sent out on this operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_22","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_22","text":"I'll take the lead. Follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_23","text":"Oh... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_24","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_24","text":"And you... You said your name was Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_25","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_26","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_26","text":"You failed to protect your former Commander. Who are you to call someone else an amateur?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_27","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_27","text":"They're putting their lives on the line just like we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_28","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_28","text":"If I ever hear you talk like that again, it'll be the last time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_29","text":"Whoa, let's settle down! No need to get all riled up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_30","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_30","text":"Fine, I misspoke. I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_31","type":"Speech","speaker":"marian","key":"Locale_MainScenario:d_main_01_04_s_31","text":"Don't apologize to me. Apologize to the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_32","text":"I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01_04_s_33","text":"Don't worry about it. I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_34","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_04_s_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_35","text":"Whoa, no yelling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_04_s_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_04_s_36","text":"Definitely not an ordinary Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}