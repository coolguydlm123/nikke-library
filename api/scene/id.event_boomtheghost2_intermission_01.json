{"id":"event_boomtheghost2_intermission_01","cat":"event","group":{"id":"ev40085","label":"BOOM! THE GHOST! · Part 2"},"label":"Resurfacing Memories","stage":null,"prev":"event_boomtheghost2_03_e","next":"event_boomtheghost2_04_s","speakers":{"alfred":"Alfred","rapi_ss":"Rapi","elegg_s":"Elegg","centi_s":"Centi","yan_s":"Yan","pepper_s":"Pepper","tove_s":"Tove"},"icons":{"alfred":"si_c9000_00_s","rapi_ss":"si_c016_01_s","elegg_s":"si_c502_00_s","centi_s":"si_c080_02_s","yan_s":"si_c201_01_s","pepper_s":"si_c131_01_s","tove_s":"si_c192_02_s"},"lines":[{"id":"event_boomtheghost2_intermission_01_1","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_1","text":"The luxury cruise ship Utopia","jump":null,"exit":false,"enter":null,"bg":"EventScene_boomtheghost_05_1","bgArt":"eventscene_boomtheghost_05_1","image":null,"bgm":"bgm_areah","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_2","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_2","text":"is a vessel that set sail two years after the First Rapture Invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_3","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_3","text":"At that time, the ocean was safe from Rapture attacks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_4","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_4","text":"However, the goal was not survival,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_5","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_5","text":"but to provide an environment to face the end of one's life without fear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_6","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_intermission_01_6","text":"... Just like at the amusement park.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_7","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_7","text":"I heard many people made that choice back then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_8","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_8","text":"The Utopia was outfitted with all manner of accommodations,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_9","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_9","text":"as well as top-class facilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_10","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_10","text":"AI holograms were provided to ease the burden of the crew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_11","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_11","text":"Every day, there were parties and events. A true Utopia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_12","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_12","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_13","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_13","text":"The supplies lasted one month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_14","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_14","text":"They were never meant to last longer than that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_15","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_15","text":"After the final opulent gala,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_16","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_16","text":"the Utopia switched to minimal power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_17","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_17","text":"The final choices of the passengers varied.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_18","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_18","text":"There were those who chose to enter eternal sleep,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_19","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_19","text":"and there were some who resisted, angry or saddened by the destiny foisted upon them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_20","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_20","text":"Eventually, however...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_21","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_22","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_22","text":"The end came for everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_23","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_23","text":"After that, I gathered all the passengers and drifted around the ocean until the power ran out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_24","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_24","text":"That is when you all came along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_25","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_25","text":"These high-tier holograms weren't here originally, were they?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_26","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_26","text":"That's correct. I oversaw all aspects of the Utopia myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_27","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_27","text":"That explains why you'd regain more memories every time we interacted with them. I thought that was odd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_28","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_29","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_29","text":"That means these high-tier holograms are fragments of yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_30","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_31","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_31","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_32","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_32","text":"I helped the passengers in various ways at the end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_33","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_33","text":"I tried my best to provide the perfect last meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_34","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_34","text":"I hoped they would get the most out of the facilities until the very end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_35","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_35","text":"I wanted to make sure there were no accidents, no matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_36","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_36","text":"Provide any and all items that were needed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_37","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_37","text":"And when they eventually met their end,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_38","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_38","text":"I did everything I could so that they could face it without fear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_39","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_39","text":"But despite all my efforts...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_40","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_40","text":"It didn't work out.","jump":null,"exit":false,"enter":null,"bg":"EventScene_boomtheghost_05_2","bgArt":"eventscene_boomtheghost_05_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_41","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_41","text":"I ran out of ingredients, and wasn't able to provide a proper last meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_42","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_42","text":"Many of the facilities broke down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_43","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_43","text":"Due to a lack of safety testing, accidents were abundant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_44","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_44","text":"I didn't monitor the ship's inventory correctly, and thus wasn't able to provide many of the items passengers desired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_45","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_45","text":"When they met their end, it was with fear, and that's my fault.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_46","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_47","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_47","text":"I'll never forget the disappointment in their eyes, even as they insisted it was okay, when I served them inferior food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_48","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_48","text":"Their forced smiles as they shivered in a cold shower because there was no hot water, joking how cold showers are good for the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_49","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_49","text":"Once, after being hit by a pipe that fell from the ceiling, someone good-naturedly claimed that bleeding is good for circulation. I'll never forget their face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_50","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_50","text":"Even when I ran out of toiletries, they would proclaim that bathing too often wasn't good for you anyway. Those words are burned in my memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_51","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_51","text":"I'll never forget those final fear-stricken expressions of the passengers in the moments before falling asleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_52","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_53","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_53","text":"I cursed the one who made me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_54","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_54","text":"Why did they make me an AI capable of reliving such tragic memories?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_55","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_55","text":"Why did they make me capable of thought? I was resentful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_56","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_56","text":"So you broke up your memories into holograms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_intermission_01_57","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_intermission_01_57","text":"Yes. Carrying those memories all the time was too painful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"