contents_madeinrush_05_13","type":"Speech","speaker":"ade_b","key":"Locale_SubScenario:d_contents_madeinrush_05_13","text":"You don't think she might have been hurt, do you...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_madeinrush_05_14","type":"Speech","speaker":"blanc","key":"Locale_SubScenario:d_contents_madeinrush_05_14","text":"No, no, it's actually the opposite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_madeinrush_05_15","type":"Speech","speaker":"blanc","key":"Locale_SubScenario:d_contents_madeinrush_05_15","text":"One of those guys was a huge fan and gave her flowers, gifts, and all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_madeinrush_05_16","type":"Speech","speaker":"blanc","key":"Locale_SubScenario:d_contents_madeinrush_05_16","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_madeinrush_05_17","type":"Speech","speaker":"ade_b","key":"Locale_SubScenario:d_contents_madeinrush_05_17","text":"But...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_madeinrush_05_18","type":"Speech","speaker":"blanc","key":"Locale_SubScenario:d_contents_madeinrush_05_18","text":"He was super jacked and really intimidating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_madeinrush_05_19","type":"Speech","speaker":"blanc","key":"Locale_SubScenario:d_contents_madeinrush_05_19","text":"I swear his shoulders were wider than you and I put together.","jump":null,"exit":fa