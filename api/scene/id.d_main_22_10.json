ull,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_71","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_71","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_72","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_72","text":"I made these explosives myself, so I'm afraid they're not all that powerful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_73","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_73","text":"The Nikkes will live, but it'll still be more than enough to kill you and me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_74","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_74","text":"You filthy terrorist...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_75","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_75","text":"Back off. I'm going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_76","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_10_76","text":"E.H., wait! You can't!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_77","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_77","text":"... We want to live too, Moran.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_78