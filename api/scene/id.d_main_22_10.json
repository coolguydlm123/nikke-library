{"id":"d_main_22_10","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"Covert Operatives","stage":"22-30 STAGE · Start","prev":"d_main_22_09","next":"d_main_22_11","speakers":{"moran":"Moran","eh":"E.H.","doban":"Doban","sakura":"Sakura","rosanna":"Rosanna"},"icons":{"moran":"si_c281_00_s","eh":"si_c940_00_s","doban":"si_c939_00_s","sakura":"si_c282_00_s","rosanna":"si_c280_00_s"},"lines":[{"id":"d_main_22_10_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_10_1","text":"The Ark. Elevator hub J-910.","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":"bgm_story_conflict","movie":null,"shown":["eh","moran","rosanna","sakura"],"affinity":null},{"id":"d_main_22_10_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_10_2","text":"30 minutes prior to the incident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_3","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_10_3","text":"Harper!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_4","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_4","text":"Ugh...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_5","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_10_5","text":"You've been hit in the shoulder! Don't move!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_6","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_6","text":"For crying out loud. I told you to aim for the head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["doban"],"affinity":null},{"id":"d_main_22_10_7","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_7","text":"I even turned off your inhibitors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_8","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_8","text":"Then again, I should have known better than to expect anything from mass-production models.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_9","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_9","text":"You must have kissed a lot of asses for them","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_10","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_10","text":"to let you come out this far,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_11","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_11","text":"Deputy Chief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_12","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_12","text":"Well done, Underworld Queen. You followed my orders to the T.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_13","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_13","text":"You stalled her just long enough for me to arrive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_14","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_14","text":"...!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_15","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_10_15","text":"What are you talking about? Who gave us orders?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_16","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_16","text":"I did. To you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_17","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_17","text":"I heard the terrorist leader was on the run, so I ordered you to buy me some time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_18","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_10_18","text":"Bullshit! We never received any such order!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_19","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_19","text":"Moran, he's just saying this to cover his ass later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_20","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_20","text":"I assume this entire conversation is being recorded somehow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_21","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_10_21","text":"We never received any orders from you, Deputy Chief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_22","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_10_22","text":"Why would we ever accept an order from you, anyways?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_23","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_10_23","text":"Everyone knows you've never had a single Nikke under your command all these years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_24","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_25","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_25","text":"What, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_26","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_26","text":"Are you saying that you were helping the terrorist escape?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_27","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_10_27","text":"Terrorist? Who are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_28","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_28","text":"Don't play games with me. I'm talking about that subversive piece of filth lying over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_29","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_29","text":"... How did he know we were here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_30","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_30","text":"Hmph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_31","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_31","text":"Do you know what this elevator is used for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_32","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_32","text":"We often use it to dispose of any sub-human filth and dump them into the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_33","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_33","text":"So, it was blindingly obvious this is where I would find you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_34","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_34","text":"After all, loathsome flies are naturally attracted to excrement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_35","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_36","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_36","text":"Is there a traitor among us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_37","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_37","text":"No... only five people knew about this plan...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_38","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_39","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_39","text":"... Viper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_40","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_41","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_41","text":"We've been bitten by a venomous snake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_42","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_42","text":"I must admit, very well said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_43","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_43","text":"I want to talk to you. Honestly, I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_44","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_44","text":"Fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_10_45","text":"*Bang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_10_46","text":"The gun that the mass-produced Nikke was about to fire shatters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_10_47","text":"Sakura's arm is extended. In her hand, smoke billows out of the barrel of her rifle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_48","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_48","text":"I feel I must remind you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_49","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_49","text":"When you're in our domain,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_50","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_50","text":"you need our permission to make any kind of move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_51","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_10_51","text":"No exceptions. That includes you, Doban.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_52","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_52","text":"What is this?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_53","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_53","text":"Are you protecting this terrorist?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_54","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_54","text":"You're Nikkes! You should be protecting mankind! Now you're siding with a known terrorist threatening the entire Ark?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_55","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_55","text":"This is treason!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_56","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_56","text":"Stay back, all of you. You mustn't get yourselves involved in this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_57","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_10_57","text":"Sorry, but we can't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_58","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_58","text":"All traitors are to be executed. None will be spared!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_59","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_59","text":"Contact Ingrid. Ask her to send Extrinsic immediately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_60","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_22_10_60","text":"Tell her we have some Irregulars who have betrayed their benefactors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_61","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_61","text":"Extrinsic...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_62","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_10_62","text":"So they finally finished it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_10_63","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_10_63","text":"Go ahead, call them! And tell 'em to make it snappy!","jump":null,"exit":false,"enter":null,"