"id":"m_ex_soda_02_13","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_13","text":"!!","jump":null},{"id":"m_ex_soda_02_14","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_14","text":"Whoops, sorry!","jump":null},{"id":"m_ex_soda_02_15","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_15","text":"I thought you might be tired after a long day at work, so I tidied up your room for you.","jump":null},{"id":"m_ex_soda_02_16","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_16","text":"I never thought about having to ask for permission...","jump":null},{"id":"m_ex_soda_02_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soda_02_17","text":"I'm just kidding. Thank you.","jump":null},{"id":"m_ex_soda_02_18","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_18","text":"Oh, haha! Very funny!","jump":null},{"id":"m_ex_soda_02_19","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_19","text":"What do you think? Super clean, isn't it?","jump":null},{"id":"m_ex_soda_02_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soda_02_20","text":"Yes, but...","jump":null},{"id":"m_ex_soda_02_21","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_21","text":"But?","jump":null},{"id":"m_ex_soda_02_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soda_02_22","text":"There's a pair of rubber gloves on the desk.","jump":null},{"id":"m_ex_soda_02_23","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_23","text":"Huh?","jump":null},{"id":"m_ex_soda_02_24","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_24","text":"What are those doing there?","jump":null},{"id":"m_ex_soda_02_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soda_02_25","text":"You tell me.","jump":null},{"id":"m_ex_soda_02_26","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_26","text":"I swore I took all my cleaning supplies back with me.","jump":null},{"id":"m_ex_soda_02_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soda_02_27","text":"There's a spray bottle on the sofa as well.","jump":null},{"id":"m_ex_soda_02_28","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_28","text":"Huh?","jump":null},{"id":"m_ex_soda_02_29","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_29","text":"Hmm...","jump":null},{"id":"m_ex_soda_02_30","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_30","text":"Oh, that!","jump":null},{"id":"m_ex_soda_02_31","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_31","text":"I was going to come back for that later.","jump":null},{"id":"m_ex_soda_02_32","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_32","text":"I guess I ended up forgetting about it.","jump":null},{"id":"m_ex_soda_02_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soda_02_33","text":"The cap is loose, and there's liquid seeping out.","jump":null},{"id":"m_ex_soda_02_34","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_34","text":"That doesn't sound good...","jump":null},{"id":"m_ex_soda_02_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_soda_02_35","text":"The sofa is soaked.","jump":null},{"id":"m_ex_soda_02_36","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_36","text":"Oh no!","jump":null},{"id":"m_ex_soda_02_37","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_37","text":"I'm sorry.","jump":null},{"id":"m_ex_soda_02_38","type":"Speech","speaker":"soda","key":"Locale_SuddenMessage:m_ex_soda_02_38","text":"I'll clean it right away!","jump":null}],"chat":true}