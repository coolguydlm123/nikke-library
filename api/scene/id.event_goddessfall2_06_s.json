{"id":"event_goddessfall2_06_s","cat":"event","group":{"id":"ev40094","label":"GODDESS FALL · Part 2"},"label":"GODDESS FALL: A","stage":null,"prev":"event_goddessfall2_05_e","next":"event_goddessfall2_06_e","speakers":{"nayuta":"Nayuta","nihilister":"Nihilister","snowwhite":"Snow White","hongryeon":"Scarlet","rapunzel":"Rapunzel","cecil":"Cecil","johan":"Johan"},"icons":{"nayuta":"si_c223_00_s","nihilister":"si_c261_00_s","snowwhite":"si_c220_00_s","hongryeon":"si_c222_00_s","rapunzel":"si_c221_00_s","cecil":"si_c929_00_s","johan":"si_c925_00_s"},"lines":[{"id":"event_goddessfall2_06_s_1","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_1","text":"The Queen's regenerative powers surpass all that we hath ever imagined.","jump":null,"exit":false,"enter":null,"bg":"Grassland","bgArt":"grassland","image":null,"bgm":"event_bgm_goddessfall_assemble","movie":null,"shown":["nayuta","nihilister"],"affinity":null},{"id":"event_goddessfall2_06_s_2","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_2","text":"Though her assaults reach us not, so long as ours avail her not,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_3","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_3","text":"we shall be drawn into a war of attrition, and our defeat shall be assured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_4","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_4","text":"She is a being who hath wandered the expanse of the cosmos these hundred years past. Who can fathom the measure of power which she hath amassed therein?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_5","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_5","text":"So, what are you trying to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_6","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_6","text":"We must needs seal her regenerative powers. There is but a single means to do so:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_7","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_7","text":"to fashion a chalice of poison.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_8","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_8","text":"Yet a mundane chalice shall perish ere it e'er touch the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_9","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_9","text":"So what are we supposed to do...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_10","text":"Nayuta stares straight at Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_11","text":"Meeting her gaze, Nihilister lets out a loud, mocking laugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_12","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_12","text":"Hah, you crazy monk!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_13","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_13","text":"You really think trusting me is a good idea? Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_14","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_14","text":"May I place my trust in thee, Fire Dragon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_15","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_15","text":"You should only trust those worth trusting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_16","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_16","text":"So it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_17","text":"Nayuta takes out a red-tipped bullet from her bosom and tosses it to Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_18","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_18","text":"Use it as thou wilt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_19","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_19","text":"Haha, you crazy monk!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_20","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_20","text":"Must be thrilled that everything's gone your way, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_21","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_21","text":"But you better remember this:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_22","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_22","text":"I'm the one who chose this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_23","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_23","text":"Verily, I shall ne'er forget it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_24","text":"The red dragon charges.","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_26","bgArt":"eventscene_goddessfall_26","image":null,"bgm":"event_bgm_icedragonsaga_icedragon","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_25","text":"The Queen looms closer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_26","text":"Nihilister bites down on the red-tipped bullet wedged between her teeth","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_27","text":"and shatters it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_28","text":"Then the red dragon charges at the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_29","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_06_s_29","text":"Eaaat this, Motherrr!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_30","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_30","text":"The red dragon becomes a poisoned chalice","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_27","bgArt":"eventscene_goddessfall_27","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_31","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_31","text":"and hurls herself at her Great Mother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_32","text":"*Bangggg!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_33","text":"The two-headed red dragon rams into the Queen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_34","text":"and Nihilister's body begins to break apart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_35","text":"At the same time, all of the Queen's arms spread wide","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_36","text":"as if to embrace a child she has not seen for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_37","text":"She holds the disintegrating Nihilister close,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_38","text":"and the latter is absorbed into the Queen's body.","jump":null,"exit":false,"enter":null,"bg":"BrokenEden","bgArt":"brokeneden","image":null,"bgm":null,"movie":null,"shown":["snowwhite","hongryeon","rapunzel"],"affinity":null},{"id":"event_goddessfall2_06_s_39","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_39","text":"A suicide attack...!?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_40","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_06_s_40","text":"But prithee, for what cause...?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_41","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_41","text":"Surely she didn't heal the Queen...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_42","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall2_06_s_42","text":"Everyone! Look!","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_25_3","bgArt":"eventscene_goddessfall_25_3","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_43","text":"The Queen's body begins to creak,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_44","text":"then tremble violently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_45","text":"*Thunk* *Plop*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_46","text":"As black liquid oozes out, parts of the Queen fall away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_47","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall2_06_s_47","text":"This...! Could it be...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_48","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_48","text":"Her power of regeneration hath been sealed. Verily, the hour of our opportunity hath now cometh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_49","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_49","text":"Nayuta, what's going on here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_50","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_50","text":"Verily, a foul stratagem have I wrought, yet mine own hands remain unsullied.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_51","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_51","text":"... Is that so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_52","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_52","text":"There be no certainty how long this effect shall endure;","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_53","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_53","text":"now is the very instant wherein all our fortunes must be laid upon the venture...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_54","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_06_s_54","text":"Everyone, stay put.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_55","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_06_s_55","text":"I've got a clear line of fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_56","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_06_s_56","text":"It's been exactly 3 hours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_57","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_06_s_57","text":"Eden's Spear. Fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_58","text":"A flash appears in the distance,","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_25_4","bgArt":"eventscene_goddessfall_25_4","image":null,"bgm":"event_bgm_goddessfall_assemble","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_59","text":"and a blue beam of light strikes the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_06_s_60","text":"As the light fades, the staggering Queen comes into view.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_61","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall2_06_s_61","text":"... I hate to say it, but this is truly a monster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_62","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_06_s_62","text":"... We've done everything we can. The rest is up to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_63","type":"Speech","speaker":"johan","key":"Locale_MainScenario:event_goddessfall2_06_s_63","text":"Win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_64","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_64","text":"We shall see it done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_65","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_06_s_65","text":"Yet thou answerst quickest, though thou wert the last to join us.","jump":null,"exit":false,"enter":null,"bg":"BrokenEden","bgArt":"brokeneden","image":null,"bgm":null,"movie":null,"shown":["snowwhite","hongryeon","rapunzel","nayuta"],"affinity":null},{"id":"event_goddessfall2_06_s_66","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall2_06_s_66","text":"Yeah, someone might think you've been fighting alongside us from the very beginning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_67","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_67","text":"Next time, don't be late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_68","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_68","text":"Dost thou think I have been idly wandering? Even I, in mine own fashion, have hither and thither run, much occupied with mine affairs—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_69","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_69","text":"Cut the chatter. We're in combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_70","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_06_s_70","text":"Thou still lackest the faintest sense of battle, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_71","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall2_06_s_71","text":"You were late, so make sure to work twice as hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_72","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_72","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_73","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_06_s_73","text":"Very well, I shall do my utmost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_74","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_74","text":"... Moving out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_06_s_75","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_06_s_75","text":"Encounter!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}