{"id":"treasurestory_julia_05","cat":"favorite","group":{"id":"fav5014","label":"Julia"},"label":"Gratitude to the Conductor","stage":null,"prev":"treasurestory_julia_04","next":"treasurestory_julia_06","speakers":{"julia":"Julia"},"icons":{"julia":"si_c150_00_s"},"notes":["Favorite item quest step: Go to the Command Center"],"lines":[{"id":"treasurestory_julia_05_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_1","text":"After wandering around with Julia, which feels like an odd mixture of both relaxation and work,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom_n","bgArt":"commanderroom_n","image":null,"bgm":"none","movie":null,"shown":["julia"],"affinity":null},{"id":"treasurestory_julia_05_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_2","text":"it is already deep into the night by the time we return to the Commander's Room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_3","text":"Well, what'd you think of the day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_4","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_4","text":"How was it, you ask?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_5","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_5","text":"The reason I first decided to seek you out was","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_6","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_6","text":"to regain the inspirational imagery I received from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_7","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_7","text":"Today, as I accompanied you, I was able to fill in many parts of myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_8","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_8","text":"Even more than I had hoped for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_9","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_9","text":"Thanks to you, Conductor, it was an exceedingly fulfilling day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_10","text":"I'm glad I could help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_11","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_11","text":"I can't thank you enough, Conductor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_12","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_12","text":"Today was profoundly nourishing to my soul in many ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_13","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_13","text":"In places that are bastions of safety and peace,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_14","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_14","text":"I gained inspiration about the balance between responsibility and freedom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_15","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_15","text":"In locales overflowing with the joy of serving others,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_16","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_16","text":"I could feel the melody inherent in pure enjoyment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_17","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_17","text":"Being with you, Conductor, made my soul more vibrant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_18","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_18","text":"Completing the last part of my notebook won't be difficult now, as I can fill in the rest with my own story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_19","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_19","text":"I don't see it taking any longer than a few days, in fact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_20","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_20","text":"Once again, my greatest thanks to you, Conductor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_21","text":"It was my pleasure, really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_22","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_22","text":"Well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_23","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_24","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_24","text":"However, there is still something missing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_25","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_25","text":"Would you promise me something, Conductor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_26","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_26","text":"If you can do that for me, the completion of my story will not be far off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_27","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_27","text":"Julia steps closer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_28","text":"Of course. I promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_29","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_29","text":"Thank you for your kindness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_30","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_30","text":"Please take a look at this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_31","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_31","text":"Julia takes out her notebook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_32","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_32","text":"During my journey across the surface, I've discovered untold musical scores.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_33","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_33","text":"The notes that almost perished in those damaged music sheets and were nearly lost to time have found a new home in this notebook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_34","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_34","text":"In doing this, I could make it so the souls of those who came before us aren't forgotten.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_35","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_35","text":"But my rapacity got the best of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_36","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_36","text":"I wanted to include my own soul within this notebook, along with the souls of those who have passed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_37","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_37","text":"Conductor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_38","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_38","text":"I want to be remembered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_39","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_39","text":"And I want that to be accomplished through my music.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_40","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_40","text":"Just like how the compositions in this notebook carry on the memory of their composers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_41","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_41","text":"I am still not quite at that level,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_42","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_42","text":"but after spending time with you today,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_43","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_43","text":"I earnestly wish that my music at least reaches you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_44","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_44","text":"So, to that end, I have a favor to ask of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_45","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_45","text":"When this notebook is complete, I would like you to have it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_46","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_46","text":"As proof that my story reached you. As a testament that you remember it, and remember me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_47","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_47","text":"Of course, I'll accept it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_48","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_48","text":"Is there anything else I can do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_49","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_49","text":"No, you've helped me enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_50","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_50","text":"To want anything more would be the epitome of avarice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_51","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_51","text":"I'm sorry that our journey has ended.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_52","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_52","text":"Please, don't feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_53","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_53","text":"Once the music I've begun to create today with you is completed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_54","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_54","text":"it will connect us, always.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_55","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_julia_05_55","text":"Then I'll wait for the piece to be completed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_56","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_56","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_57","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_57","text":"After I finish the last page of this notebook,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_58","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_58","text":"you will be my very first audience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_julia_05_59","type":"Speech","speaker":"julia","key":"Locale_NikkeEpisode:treasurestory_julia_05_59","text":"My first audience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}