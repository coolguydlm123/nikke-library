{"id":"event_doutsiders_02_s","cat":"event","group":{"id":"ev40006","label":"D-OUTSIDERS"},"label":"Outer Rim Patrol: A","stage":null,"prev":"event_doutsiders_01_e","next":"event_doutsiders_02_e","speakers":{"Narration":"Narration","viper":"Viper","jackal":"Jackal","Self":"Commander","fatman":"Bulky Man","youngman":"Young Man"},"icons":{"Narration":"si_c999_00_s","viper":"si_c112_00_s","jackal":"si_c111_00_s","fatman":"si_c919_00_s","youngman":"si_c999_00_s"},"lines":[{"id":"event_doutsiders_02_s_1","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_02_s_1","text":"Soon after, on one of the roads in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_2","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_2","text":"All right, listen closely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["viper","jackal"],"affinity":null},{"id":"event_doutsiders_02_s_3","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_3","text":"You'll arouse suspicion if you parade around town like a tourist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_4","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_4","text":"Just act like you're part of our routine patrols.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_5","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_02_s_5","text":"You patrol the Outer Rim?","jump":"event_doutsiders_02_s_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_6","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_doutsiders_02_s_6","text":"Who put you in charge of patrols? Sounds like you're a vigilante.","jump":"event_doutsiders_02_s_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_7","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_7","text":"Ah, right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_8","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_8","text":"We've never been properly introduced, have we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_9","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_9","text":"Our squad is called Exotic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_10","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_10","text":"We work for the Ministry of Information under the Central Intelligence Agency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_11","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_11","text":"In a nutshell, we're responsible for conducting surveillance in the Outer Rim on behalf of the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_12","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_02_s_12","text":"Surveillance? We've never done that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_13","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_14","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_14","text":"I can see how one could feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_15","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_15","text":"In truth, what we do is more akin to management.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_16","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_02_s_16","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_17","type":"Speech","speaker":"viper","key":"Locale_SubScenario:event_doutsiders_02_s_17","text":"What I mean is, when times are tough, you've got to learn to be flexible♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_18","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_s_18","text":"You !#$!!@#)","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["fatman","joseph"],"affinity":null},{"id":"event_doutsiders_02_s_19","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_02_s_19","text":"*crassssh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_20","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_s_20","text":"You agreed to give us 500kg of product, so hand it over or shut up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_21","type":"Speech","speaker":"fatman","key":"Locale_SubScenario:event_doutsiders_02_s_21","text":"You better cough it up fast, or I'm gonna start chopping off fingers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_22","type":"Speech","speaker":"youngman","key":"Locale_SubScenario:event_doutsiders_02_s_22","text":"I'm sorry, I'm sorry...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_23","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_02_s_23","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_02_s_24","type":"Speech","speaker":"jackal","key":"Locale_SubScenario:event_doutsiders_02_s_24","text":"Looks like something's going on up ahead. Let's check it out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}