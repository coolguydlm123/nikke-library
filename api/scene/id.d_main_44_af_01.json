_01_41","text":"It's precisely the sort of thing that could get you branded a traitor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_01_42","text":"I don't think now's the time to worry about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_43","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_44","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_44","text":"Fair enough. So you're saying this isn't the time to concern yourself with power and authority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_45","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_45","text":"I get your point. I'll make sure to put in a good word for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_01_46","text":"... What do you mean by that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_47","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_47","text":"I don't have authority over the Ark's core technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main