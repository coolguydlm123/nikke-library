":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_15","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_15","text":"I feel like rushing up to the surface and wreaking havoc, but there's nothing I can do with this damn body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_16","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_16","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_17","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_01_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_18","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_18","text":"Ah, there's no need to be on edge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_19","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_19","text":"I have no intention of venting my frustration on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_20","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_20","text":"That said, each time you return from the surface, you bring back information that never fails to surprise me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_21","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_21","text":"This time, however, it is beyond what I can deal with on my own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_22","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_22","text":"If the matter of the Four Beasts and their Queen is kept strictly between you and those involved, we may be able to contain the spread of information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_23","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_23","text":"But the fact that the Rapture Queen—an enemy to humanity—has descended to the surface","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_24","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_24","text":"means this is no longer Eden's problem alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_25","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_25","text":"The newly created Heretic is openly targeting the Ark as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_26","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_26","text":"... This is a grave situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_27","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_27","text":"For now, I will gather opinions from various areas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_28","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_28","text":"From there, we should be able to determine a rational course of action.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_29","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_01_29","text":"Got it, I'll be waiting to hear from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_30","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_30","text":"All right. Given the gravity of the matter, I shall ensure we reach a decision without delay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_31","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_31","text":"And of course, I will share this only with those who have reason to know it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_01_32","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_33","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_44_af_01_33","text":"Didn't you say you had something else to report?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_01_34","type":"Self","sp