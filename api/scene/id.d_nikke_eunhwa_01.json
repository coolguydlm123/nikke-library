ity":null},{"id":"d_nikke_eunhwa_01_114","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_01_94","text":"No matter how pathetic they might seem,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_01_115","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_01_95","text":"if a commander tells you to die, you must die, and if they tell you to be a human shield, you do so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_01_116","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_01_96","text":"Therefore, during this training process, if there is an Owl that crosses the line with the human commander, I will kill them. Got it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_01_117","type":"Speech","speaker":"owls","key":"Locale_NikkeEpisode:d_nikke_eunhwa_01_97","text":"Yes, Instructor!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_01_118","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_01_98","text":"Good. Let us now proceed to the battle simulation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}