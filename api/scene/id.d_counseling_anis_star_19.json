{"id":"d_counseling_anis_star_19","cat":"counsel","group":{"id":"char5169","label":"Anis: Star"},"label":"Advising Anis: Star: 19","stage":null,"prev":"d_counseling_anis_star_18","next":"d_counseling_anis_star_20","speakers":{"anis_i":"Anis"},"icons":{"anis_i":"si_c017_00_s"},"lines":[{"id":"d_counseling_anis_star_19_1","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_19_1","text":"Y'know, sometimes I wonder... what if I'd stayed a pop star?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis_i"],"affinity":"_0"},{"id":"d_counseling_anis_star_19_2","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_19_2","text":"They'd be on my case like, \"No dating. Company policy.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_19_3","type":"Speech","speaker":"anis_i","key":"Locale_Counseling:d_counseling_anis_star_19_3","text":"... So if you were my boyfriend in that situation, what would you do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_star_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_star_19_4","text":"If that's company policy, then I guess we'll have to break up.","jump":"d_counseling_anis_star_19_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anis_star_19_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_star_19_5","text":"Nothing beats sneaking around.","jump":"d_counseling_anis_star_19_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_anis_st