den_w","key":"Locale_MainScenario:event_icedragonsaga1_intermission_01_24","text":"Objection!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_intermission_01_25","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:event_icedragonsaga1_intermission_01_25","text":"I said be quiet!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_intermission_01_26","type":"Speech","speaker":"maiden_w","key":"Locale_MainScenario:event_icedragonsaga1_intermission_01_26","text":"Your Honor, subjective witness accounts are of little importance in this case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_intermission_01_27","type":"Speech","speaker":"maiden_w","key":"Locale_MainScenario:event_icedragonsaga1_intermission_01_27","text":"The only thing that matters in a court of law is objective evidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_intermission_01_28","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:event_icedragonsaga1_intermission_01_28","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":"HotSpringInnIn_d","bgArt":"hotspringinnin_d","image":null,"bgm":null,"movie":null,"shown":["novel","yulha","guillotine_w_no","maiden_w"],"affinity":null},{"id":"event_icedragonsaga1_intermission_01_29","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:event_icedragonsaga1_intermission_01_29","text":"Makes sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_intermission_01_30","type":"Speech","speaker":"novel"