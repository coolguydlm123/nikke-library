 embarrassing to watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_5","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_5","text":"Next! Where to next? The park?","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":null,"movie":null,"shown":["anis_idol","mint_o","prika_o","hanson"],"affinity":null},{"id":"event_staranis1_04_s_6","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_6","text":"Yes, the park! In 20 minutes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_7","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_7","text":"Hurry! Get to the car!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_8","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_04_s_8","text":"Hold on! I just need to do this first!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_9","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_04_s_9","text":"Leave it, we can't take it all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_10","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_04_s_10","text":"We can't go without the lighting panels!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_11","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_11","text":"Hey, I've got this! Get to the car! Pop stars shouldn't be doing this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_12","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_12","text":"What are you talking about?! We're swamped here! And you can barely keep up as it is!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_13","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_04_s_13","text":"At least eat before you go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_14","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_14","text":"Sorry, we'll eat when we get back!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_15","text":"- Heard they're only taking gigs that actually pay now.","jump":null,"exit":false,"enter":null,"bg":"EventScene_staranis_02","bgArt":"eventscene_staranis_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_16","text":"- Source?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_17","text":"- All the places they bailed on were hole-in-the-wall places.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_18","text":"- They've always performed at hole-in-the-wall venues. Lol, what are you even talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_19","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_19","text":"... Oh crap,","jump":null,"exit":false,"enter":null,"bg":"Park","bgArt":"park","image":null,"bgm":null,"movie":null,"shown":["anis_idol","mint_o","prika_o","hanson"],"affinity":null},{"id":"event_staranis1_04_s_20","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_20","text":"I don't think this is the right place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_21","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_21","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_22","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_22","text":"Oh... I must've confused it with tomorrow's schedule.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_23","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_04_s_23","text":"How could you possibly get that wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_24","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_04_s_24","text":"What, you didn't even think to double-check?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_25","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_04_s_25","text":"Look who's talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_26","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_26","text":"... So where are we supposed to be right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_27","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_27","text":"... It's just one block over, and we're already late.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_28","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_28","text":"Ah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_29","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_29","text":"Argh! Seriously?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_30","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_30","text":"I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_31","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_31","text":"Oh no, it's fine! I wasn't mad at you, Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_32","text":"Title: Why take on so many gigs anyway?","jump":null,"exit":false,"enter":null,"bg":"EventScene_staranis_02","bgArt":"eventscene_staranis_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_33","text":"If you know you can't handle it, why even accept them in the first place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_34","text":"- Loads of places these days pay upfront and just lock in the date.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_35","text":"- Yeah, big-name pop stars get to negotiate, but groups like T.T. STAR? They get bossed around all the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_36","text":"- Wait, so they pay you first and then just tell you when to show up? What if you don't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_37","text":"- Exactly. Some places do it on purpose, hoping to hit you with contract penalties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_38","text":"- And if you skip a gig? The press spins it like you're arrogant or full of yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_39","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_39","text":"- So basically... damned if you do, damned if you don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_40","text":"- Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_41","text":"- Sheesh, the life of a pop star sure is brutal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_04_s_42","text":"- And with so many wannabes out there, weird stuff like this happens all the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_43","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_43","text":"... We're very sorry. We have no excuses.","jump":null,"exit":false,"enter":null,"bg":"HansonOffice","bgArt":"hansonoffice","image":null,"bgm":null,"movie":null,"shown":["anis_idol","mint_o","prika_o","hanson"],"affinity":null},{"id":"event_staranis1_04_s_44","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_44","text":"Yes, we'll transfer the full amount, including the penalty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_45","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_45","text":"We're truly sorry. If you'd give us one more chance—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_46","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_46","text":"... They hung up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_47","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_48","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_48","text":"I'm really sorry, everyone. I keep missing things when I check the schedule.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_49","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_49","text":"Um, Boss... You've been getting enough sleep, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_50","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_50","text":"Yeah, I'm getting enough sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_51","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_51","text":"... Seriously, when do you even sleep? All you do is run to meetings, give us rides, and go over contracts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_52","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_52","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_53","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_53","text":"Probably while driving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_54","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_04_s_54","text":"Don't brush this off as a joke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_55","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_04_s_55","text":"Don't worry, I can take care of myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_04_s_56","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_04_s_56","text":"Have any resumes come in yet?","jump":null,"exit":false,"enter":null,"bg":null,"bg