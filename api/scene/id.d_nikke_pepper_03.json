r","key":"Locale_NikkeEpisode:d_nikke_pepper_03_95","text":"They are criminals. They are like cancer that should get eradicated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_96","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_96","text":"Some doctors choose this job just for money or fame.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_97","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_97","text":"But Mary is different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_98","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_98","text":"She became a doctor because she wanted to save people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_99","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_99","text":"I could even say she is more like an immaculate saint than a doctor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_100","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_100","text":"Her pursuit of an ideal doctor is one of the best things about her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_101","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_101","text":"You seem to admire Mary so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_102","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_102","text":"Yes, that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_103","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_103","text":"Do you remember what I said about getting blamed for getting too close to patients?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_104","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_104","text":"Honestly, at that time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_105","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_105","text":"I was so depressed about being a doctor like that, and I even wanted to quit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_106","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_106","text":"But Mary told me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_107","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_pepper_03_107","text":"You have nothing special except to befriend every patient?","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":["mary"],"affinity":null},{"id":"d_nikke_pepper_03_108","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_pepper_03_108","text":"That's im