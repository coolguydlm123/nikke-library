e:d_nikke_pepper_03_20","text":"Because sometimes, part of patients feel bored staying in the ward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_21","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_21","text":"They would probably get out to smell some fresh air, just like someone here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_22","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_23","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_23","text":"It's cold today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_24","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_24","text":"The cold night wind will harm their health if they stay out for so long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_25","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_25","text":"So, I plan to stroll around the yard. Maybe I'll meet some patients and take them back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_26","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_26","text":"But, it seems there's no one outside other than you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_27","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_27","text":"You work so hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_28","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_28","text":"Hehe. That's nothing. It's my job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_29","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_29","text":"Looks like you have a close relationship with all the patients.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_30","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_30","text":"That's right... I got blamed for this many times in the beginning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_31","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_31","text":"They told me not to get too close to patients.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_32","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_32","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_33","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_33","text":"Because if you get too close to patients, the bond between you and them may get deeper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_34","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_34","text":"And their inevitable departure will be more painful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_35","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_36","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_36","text":"Then, I answered, \"I will never be apart from my patients.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_37","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_37","text":"And I got blamed again for being incompetent but arrogant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_38","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_38","text":"I know you would say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_39","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_39","text":"Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_40","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_40","text":"However... Recently, I started to understand their words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_sunshinesorrow","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_41","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_41","text":"I came to realize how hard to avoid saying goodbye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_42","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_42","text":"The longer I stay in the hospital, the feeling will become deeper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_43","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_44","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_44","text":"What's bothering you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_45","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_45","text":"Nothing. It's just...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_46","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_46","text":"Now that I'm a Nikke...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_47","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_47","text":"... How nice if they designed the function of saving people on me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_48","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_48","text":"... Thoughts like this always haunt me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_49","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_49","text":"Aren't you already saving lots of people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_50","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_50","text":"Yeah, but... even as a doctor, sometimes I can do nothing but watch the patients becoming lifeless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_51","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_52","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_52","text":"Oh, did I upset you? I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_53","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_53","text":"I'm just a little nervous about the operation tomorrow. I shouldn't talk about these upsetting things with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_54","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_54","text":"Do you have an operation tomorrow?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_55","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_55","text":"It's about that girl you met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_56","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_56","text":"The cause of this \"boyfriend madness\"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_57","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_57","text":"Tomorrow is her operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_58","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_58","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_59","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_59","text":"Just like I said, even if the chance of survival is 1%...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_60","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_60","text":"I still believe it's the right choice to do the operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_61","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_61","text":"I asked her to trust me. I promised that I would cure her...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_62","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_62","text":"And she told me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_63","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_63","text":"Don't burden yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_64","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_64","text":"My gosh, is that something a kid would say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_65","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_66","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_66","text":"All the kids in the hospital are a little bit different from the ordinary children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_67","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_67","text":"Especially those who survived terrorist attacks are easily affected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_68","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_68","text":"Before sent here, they went through all kinds of investigations conducted by the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_69","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_69","text":"That caused them to lose their innocence and to think so maturely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_70","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_70","text":"And I know she's a precocious girl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_71","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_71","text":"It's not her fault, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_72","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_72","text":"Her words make me feel that I didn't work hard enough to earn her trust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_73","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_73","text":"So, I'm still nervous about the operation tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_74","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_74","text":"You are doing great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_75","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_75","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_76","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_76","text":"Don't you see? So many Patients trust you and love you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_77","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_77","text":"I know, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_78","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_78","text":"You should trust their love for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_79","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_80","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_80","text":"You are a doctor. If you did your work too bad, how should they love you so much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_81","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_82","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_82","text":"... Commander, you and Mary, you two are very much alike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_83","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_83","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_84","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_84","text":"Why are you so surprised?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_85","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_85","text":"... I don't know if that is a compliment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_86","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_86","text":"Yes, it is!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_87","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_87","text":"Mary is a nice person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_88","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_88","text":"And as a doctor, she is the best for sure!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":nu