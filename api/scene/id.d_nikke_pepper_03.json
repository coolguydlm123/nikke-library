{"id":"d_nikke_pepper_03","cat":"bond","group":{"id":"char5027","label":"Pepper"},"label":"Proud to be Loved","stage":null,"prev":"d_nikke_pepper_02","next":"d_nikke_pepper_04","speakers":{"Monologue":"Monologue","Self":"Commander","pepper":"Pepper","mary":"Mary","Narration":"Narration"},"icons":{"pepper":"si_c131_00_s","mary":"si_c130_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_nikke_pepper_03_1","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_03_1","text":"I have been confined in the hospital for a whole week now...","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_2","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_03_2","text":"I stayed in the ward all day today to avoid others. And now, I can't fall asleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_3","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_4","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_03_4","text":"It's already late at night. There shouldn't be anyone outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_5","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_03_5","text":"Maybe it's okay to go for a walk.","jump":null,"exit":false,"enter":null,"bg":"Park_n","bgArt":"park_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_6","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_03_6","text":"I walk into the front yard of the hospital.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_7","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_7","text":"In... Out...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_8","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_03_8","text":"I take a deep breath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_9","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_pepper_03_9","text":"It feels like all my worries fade away along the breath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pepper"],"affinity":null},{"id":"d_nikke_pepper_03_10","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_10","text":"What are you doing here, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_11","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_11","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_12","type":"Speech","speaker":"pepper","key":"Locale_NikkeEpisode:d_nikke_pepper_03_12","text":"Can't sleep?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_pepper_03_13","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_pepper_03_13","text":"It's boring