":null,"affinity":"_100"},{"id":"d_counseling_marian_queen_03_6","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_03_6","text":"I thought you'd say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_03_7","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_03_7","text":"I don't think lying is always bad. It depends on the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_03_8","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_03_8","text":"A lie can give someone hope, too.","jump":"d_counseling_marian_queen_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_03_9","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_03_9","text":"Hmm... I suppose you could see it that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_03_10","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_03_10","text":"But I think white lies are sometimes necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_03_11","type":"Speech","speaker":"marian","key":"Locale_Counseling:d_counseling_marian_queen_03_11","text":"So long as they bring someone hope and happiness.","jump":"d_counseling_marian_queen_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marian_queen_03_12