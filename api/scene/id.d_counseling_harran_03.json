{"id":"d_counseling_harran_03","cat":"counsel","group":{"id":"char5042","label":"Harran"},"label":"Advising Harran: 03","stage":null,"prev":"d_counseling_harran_02","next":"d_counseling_harran_04","speakers":{"harran":"Harran"},"icons":{"harran":"si_c230_00_s"},"lines":[{"id":"d_counseling_harran_03_1","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_1","text":"Noah is such an arrogant child.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["harran"],"affinity":"_0"},{"id":"d_counseling_harran_03_2","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_2","text":"There are rumors that she has been perturbing my crow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_3","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_3","text":"What would you have me do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_03_4","text":"You ought to teach her a lesson.","jump":"d_counseling_harran_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_harran_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_03_5","text":"You're an adult, so you should rise above all this and forgive her.","jump":"d_counseling_harran_03_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_harran_03_6","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_6","text":"Teach her lesson...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_7","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_7","text":"If I were on the receiving end, corporal punishment would not seem desirable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_8","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_8","text":"I suddenly feel as if I have been swayed by this child. Give me another idea.","jump":"d_counseling_harran_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_9","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_9","text":"Wise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_10","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_10","text":"I mustn't allow myself to be affected by such childish acts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_11","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_03_11","text":"Very well, I will forgive her. Just for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_03_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_harran_03_12","text":"I talk with Harran a bit more, thinking about Noah.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}