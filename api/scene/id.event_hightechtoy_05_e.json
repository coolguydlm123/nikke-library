{"id":"event_hightechtoy_05_e","cat":"event","group":{"id":"ev40002","label":"Hightech Toy"},"label":"Heroes and Toys: B","stage":null,"prev":"event_hightechtoy_05_s","next":"event_hightechtoy_06_s","speakers":{"laplace":"Laplace","maxwell_w":"Maxwell","massproduction01":"Mass-produced Nikke","drake":"Drake"},"icons":{"laplace":"si_c100_00_s","maxwell_w":"si_c102_01_s","massproduction01":"si_c253_00_s","drake":"si_c101_00_s"},"lines":[{"id":"event_hightechtoy_05_e_1","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_05_e_1","text":"Score another one for justice!","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["laplace","drake","maxwell_w","massproduction01"],"affinity":null},{"id":"event_hightechtoy_05_e_2","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_05_e_2","text":"That's right. Now that we've done what we set out to accomplish, let's head back. I'm beaten.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_e_3","type":"Speech","speaker":"laplace","key":"Locale_SubScenario:event_hightechtoy_05_e_3","text":"Don't talk like that. A true hero never tires.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_e_4","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_05_e_4","text":"Just a moment. Is this yours?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_05_e_5","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_05_e_5","text":"The mass-produced Nikke holds up Laplace's cellphone.","jump":null,"exit":false,"enter":null,"bg":null,"