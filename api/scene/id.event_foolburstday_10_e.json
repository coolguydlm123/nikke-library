{"id":"event_foolburstday_10_e","cat":"event","group":{"id":"ev130007","label":"Foolburstday"},"label":"Are the Central Government's Robots Monsters?!: B","stage":null,"prev":"event_foolburstday_10_s","next":"event_foolburstday_11","speakers":{"mechashifty":"Mecha Shifty","shifty_s":"Shifty"},"icons":{"mechashifty":"si_c993_00_s","shifty_s":"si_c907_00_s"},"lines":[{"id":"event_foolburstday_10_e_1","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_1","text":"Easy.","jump":null,"exit":false,"enter":null,"bg":"CityForest_01","bgArt":"cityforest_01","image":null,"bgm":"bgm_story_cottoncandy","movie":null,"shown":["mechashifty","shifty_s"],"affinity":null},{"id":"event_foolburstday_10_e_2","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_2","text":"Far too easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_3","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_3","text":"How can humanity have struggled going up against such pathetic creatures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_4","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_4","text":"Now I understand just how pitiable humans are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_5","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_5","text":"I grow weary of this fighting. In fact, I'm bored to death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_6","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_6","text":"Shifty. Can we talk for a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_7","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_10_e_7","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_8","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_8","text":"What in the world is that thing? Why is it so strong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_9","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_9","text":"It doesn't make any sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_10","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_10_e_10","text":"I don't know. I didn't think it would be so absurdly overpowered either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_11","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_10_e_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_12","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_10_e_12","text":"But isn't that a good thing? After all, it's on our side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_13","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_13","text":"That's true, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_14","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_10_e_14","text":"To be honest, I thought it wouldn't be terribly adept in combat scenarios.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_15","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_10_e_15","text":"Especially since it looked like it'd been cobbled together out of random parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_16","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_16","text":"That's what I thought too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_17","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_10_e_17","text":"I always thought it was joking when it went on about wiping us out and all that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_18","text":"Same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_19","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_19","text":"How dare you whisper amongst each other in front of a superior being? Where are your manners?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mechashifty"],"affinity":null},{"id":"event_foolburstday_10_e_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_20","text":"Oh, er... m-magnificently done, Mecha Shifty. You truly are the superior species.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_21","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_21","text":"Haha, so you're surrendered to the fact that my power is superior?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_22","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_22","text":"Given how strong I am, it's understandable for you to feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_23","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_23","text":"Whew... that was quite the workout. I'm parched.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_24","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_24","text":"I could go for a nice tall glass of premium gasoline.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_25","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_25","text":"Let's head to the Commander's Room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_26","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_26","text":"I don't really have gasoline over there...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_27","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_27","text":"What was that? Do I need to demonstrate the power of my Death Arm once more?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_28","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_29","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_10_e_29","text":"I'll try to see what I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_10_e_30","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_10_e_30","text":"Very good. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}