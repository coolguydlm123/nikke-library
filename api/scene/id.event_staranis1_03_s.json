se,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_61","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_61","text":"Well, well, if it isn't Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_trueentertainment","movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_62","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_62","text":"Hanson, Hanson, my darling Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_63","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_63","text":"Thank you for making the time to meet with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_64","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_65","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_65","text":"I've been enjoying your new song, Yoyo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_66","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_66","text":"Congratulations on holding the top spot on the charts. I have much to learn from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_67","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_67","text":"You flatter me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_68","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_68","text":"So, what brings you here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_69","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_69","text":"I do hope it's exactly what I'm hoping for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_70","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_70","text":"... I need your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_71","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_71","text":"Of course you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_72","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_72","text":"Miss being under Tetra's protection, huh? I bet leaving all that behind and struggling out there was a real pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_73","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_73","text":"Now... what was it again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_74","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_74","text":"T.T. STAR.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_75","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_75","text":"Ah, right, T.T. STAR.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_76","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_76","text":"I heard you're the one managing them. From what I've seen, they don't seem all that impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_77","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_77","text":"How's it feel, handling those half-baked ones after dealing with the perfectly groomed Nikkes at Tetra? Must be like night and day, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_78","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_78","text":"So, you want us to take them on, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_79","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_79","text":"Fine, it's no big deal, really. We can do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_80","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_80","text":"I'll even give you your director position back. I've been keeping it open just for this reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_81","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_81","text":"Get them in here. Let's get the ink on paper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_82","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_83","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_83","text":"I see you're still only saying what you want to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_84","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_84","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_85","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_85","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_86","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_86","text":"I'm here to purchase a song","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_87","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_87","text":"that's perfect for a three-member group.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_88","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_89","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_89","text":"That's it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_90","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_90","text":"Yes, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_91","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_91","text":"Sure, twenty billion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_92","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_92","text":"You're being unreasonable here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_93","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_93","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_94","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_94","text":"You're the one being unreasonable!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_95","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_95","text":"You stormed out of the company like it was nothing, and now you're crawling back asking for a song!?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_96","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_96","text":"Do you and Mrs. Miss think I'm a damn joke?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_97","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_97","text":"I've already shared the reason I left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_98","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_98","text":"... Hah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_99","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_99","text":"That damn Pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_100","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_100","text":"She's already a corpse, and the Central Government wanted it, so I gave it to them. What's the issue?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_101","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_101","text":"I'm a victim here too, you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_102","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_102","text":"The leftovers from V.T.C. started going crazy, trying to make enhanced weapons or whatever with those scrap bodies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_103","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_103","text":"After Pretty died, those rust buckets were recognized as living beings, and suddenly, everything they did was labeled as biological experimentation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_104","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_104","text":"Missilis took that chance and wiped the whole damn V.T.C. off the map.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_105","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_105","text":"And guess who had to supply all the materials? Me. All the connections I'd built up, gone just like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_106","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_106","text":"So, tell me, who do you think took the biggest hit in all this, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_107","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_107","text":"You're still incapable of thinking of anyone other than yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_108","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_108","text":"That's how the entertainment world works, Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_109","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_109","text":"As long as I'm enjoying myself, that's all that matters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_110","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_110","text":"And enjoyment? It only comes when someone else is suffering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_111","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_111","text":"Look at you now, you're enjoying this, aren't you? Because I'm the one in pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_112","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_112","text":"I won't deny it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_113","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_113","text":"... Ha. How nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_114","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_114","text":"So tell me, why should I give you a song?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_115","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_115","text":"If you help me this time, I'll be sure to return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_116","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_116","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_117","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_117","text":"But that's only if things don't go well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_118","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_118","text":"And if it does?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_119","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_03_s_119","te