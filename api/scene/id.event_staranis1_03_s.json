{"id":"event_staranis1_03_s","cat":"event","group":{"id":"ev40108","label":"STAR ANIS · Part 1"},"label":"All Eyes On Me: A","stage":null,"prev":"event_staranis1_02_e","next":"event_staranis1_03_e","speakers":{"yoyo":"Yoyo","mustang_past":"Mustang","hanson":"Hanson"},"icons":{"yoyo":"si_c9024_00_s","mustang_past":"si_c9022_00_s","hanson":"si_c9023_00_s"},"lines":[{"id":"event_staranis1_03_s_1","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_1","text":"Have you heard of T.T. STAR?","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"event_bgm_staranis_yoyo","movie":null,"shown":["mustang_past","yoyo"],"affinity":null},{"id":"event_staranis1_03_s_2","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_2","text":"What's that supposed to be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_3","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_3","text":"Um... It's the pop group Hanson put together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_4","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_4","text":"... Hanson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_5","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_5","text":"So? Where are they on the charts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_6","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_6","text":"They didn't even make the charts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_7","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_7","text":"You mean the major charts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_8","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_8","text":"No, the indie charts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_9","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_9","text":"What the hell...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_10","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_10","text":"Seems they're just covering Pretty's songs and parroting her choreography. Utterly unremarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_11","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_11","text":"Heh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_12","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_12","text":"So Hanson's cranking out those dime-a-dozen Pretty knockoffs now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_13","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_14","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_14","text":"He left the company for something so worthless?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_15","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_15","text":"What a damn fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_16","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_16","text":"You're just going to let that slide? If it were me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_17","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_18","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_18","text":"Yoyo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_19","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_19","text":"... Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_20","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_20","text":"Don't overstep. I'll be the judge of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_21","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_21","text":"You were nothing when I made you a Nikke and pushed you as Pretty's successor. And now you think that's because you're special?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_22","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_22","text":"... I've never thought of it that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_23","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_23","text":"Then shut it. I've already got enough crap to deal with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_24","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_24","text":"... I'll keep that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_25","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_25","text":"Where do you sit on the charts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_26","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_26","text":"Still firmly at number one,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_27","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_27","text":"all thanks to the great CEO. And someone like me is sitting in a spot I don't even deserve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_28","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_28","text":"You're nowhere near Pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_29","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_29","text":"Don't fool yourself. Either step it up or don't bother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_30","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_30","text":"And how, exactly, am I supposed to try harder than this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_31","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_31","text":"How'd you like...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_32","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_32","text":"a bullet through the head?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_33","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_33","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_34","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_34","text":"Heh... thinking about it now, the way Pretty died was a work of art.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_35","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_35","text":"Thanks to that, Tetra's stock shot through the roof.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_36","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_36","text":"All she did was get taken out by some whacko, and yet the media wrapped it up like some grand, noble sacrifice. Beautiful, really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_37","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_37","text":"Even dead, she's still pulling weight for the company. Now that's what I call a devoted daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_38","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_39","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_39","text":"Don't just stand there like an idiot and start using that puny brain of yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_40","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_40","text":"How do you plan to surpass Pretty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_41","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_03_s_41","text":"... I'll give it some thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_42","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_42","text":"Yeah, yeah. Let me know if you come up with something worth my time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_03_s_43","text":"*Bzzzz*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_44","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_44","text":"What now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_03_s_45","text":"*Bzzzz*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_03_s_46","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_03_s_46","text":"Tch. I told them