{"id":"d_main_02_07","cat":"main","group":{"id":"ch2","label":"Chapter 2 · Identification"},"label":"Dark, Damp, and Stinky","stage":"2-11 STAGE · Start","prev":"d_main_02_06","next":"d_main_02_08_s","speakers":{"neon":"Neon","anis":"Anis","rapi":"Rapi","Self":"Commander"},"icons":{"neon":"si_c011_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_02_07_1","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02_07_1","text":"Man, it stinks to high heaven!","jump":null,"exit":false,"enter":null,"bg":"EventScene_Main_02_01","bgArt":"eventscene_main_02_01","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":null,"affinity":null},{"id":"d_main_02_07_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_07_2","text":"If there aren't any people living here, how come it smells so bad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_07_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_07_3","text":"Because it's a drainpipe. All sorts of stuff build up in here over time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_07_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02_07_4","text":"Guys...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_07_5","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_07_5","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_07_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_02_07_6","text":"I think I'm gonna throw up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":nul