{"id":"d_main_46_03","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"Into Enemy Lines","stage":"46-11 STAGE · Start","prev":"d_main_46_02","next":"d_main_46_04","speakers":{"nayuta":"Nayuta","johan_op_l":"Johan","snowwhite_h":"Snow White","cecil_op_r":"Cecil"},"icons":{"nayuta":"si_c223_00_s","johan_op_l":"si_c925_00_s","snowwhite_h":"si_c471_00_s","cecil_op_r":"si_c929_00_s"},"lines":[{"id":"d_main_46_03_1","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_1","text":"This spot shall serve admirably. 'Tis inconspicuous, and affords a most advantageous vantage point.","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":"bgm_chapter46_field_redlight","movie":null,"shown":["snowwhite_h","nayuta"],"affinity":null},{"id":"d_main_46_03_2","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_2","text":"What are you playing at, Monk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_r","johan_op_l"],"affinity":null},{"id":"d_main_46_03_3","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_3","text":"Why did you insist on meeting near the Lift, of all places?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_4","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_4","text":"You couldn't pick a more dangerous location if you tried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_5","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_5","text":"It's a fair distance from the main structure, but that doesn't mean we're in the clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_6","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_6","text":"I am not oblivious. You are exceedingly given to quibbling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_7","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_7","text":"Would I summon White Snow hither without due cause?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_8","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_8","text":"Explain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_9","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_9","text":"Since the encounter with the Queen, I dispatched my remaining replicas to reconnoiter places of import.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_10","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_10","text":"Wait. You have more clones left?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_11","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_11","text":"... Aye. Not combat units proper, but adequate for reconnaissance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_12","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_12","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_13","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_14","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_14","text":"Nevertheless, my replicas have scouted locations upon the surface deemed of strategic import.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_15","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_15","text":"Alas, none evinced any reaction of note.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_03_16","text":"Nayuta silently raises her finger and points off in the distance.","jump":null,"exit":false,"enter":null,"bg":"SpaceElevator","bgArt":"spaceelevator","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_03_17","text":"She gestures to a towering structure that seems to pierce the sky, the greatest construct humanity ever created.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_03_18","text":"The Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_19","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_19","text":"Save for that place. The Orbital Spire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_20","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_03_20","text":"You're getting a special reading from over there?","jump":null,"exit":false,"enter":null,"bg":"CityForest_02","bgArt":"cityforest_02","image":null,"bgm":null,"movie":null,"shown":["snowwhite_h","nayuta","cecil_op_r","johan_op_l"],"affinity":null},{"id":"d_main_46_03_21","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_21","text":"Indeed. Observe closely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_22","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_22","text":"Lights kindle within.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_23","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_23","text":"Venture nearer, and perchance a mechanical hum shall reach thy ear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_24","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_03_24","text":"... No way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_25","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_25","text":"The Orbital Spire yet functions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_26","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_26","text":"The Lift is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_27","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_27","text":"That means the Raptures we saw earlier are being produced there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_28","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_28","text":"You speak of the new sort of Raptures. Aye, that hath troubled me likewise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_29","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_29","text":"During my reconnaissance, Raptures of the new sort were observed in considerable number.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_30","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_30","text":"These new Raptures were all manufactured within the orbital stations, yet the stations themselves are now ruins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_31","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_31","text":"I desire to confirm whether a connection doth exist between these two facts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_32","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_03_32","text":"So you want to scout the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_33","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_33","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_34","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_03_34","text":"Fine. Then let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_35","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_35","text":"Much obliged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_36","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_36","text":"Wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_37","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_37","text":"Snow White is the only fighting force Eden's got right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_38","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_38","text":"I won't authorize her to conduct such a dangerous recon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_39","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_39","text":"It doth prove quite impossible for me to do alone. Thus I venture to solicit a favor from thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_40","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_40","text":"You've got plenty of clones who can handle the scouting just fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_41","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_42","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_42","text":"I did dispatch several score of them nigh unto the Orbital Spire,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_43","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_43","text":"yet to this hour, no word hath reached me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_44","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_44","text":"As their NIMPH hath not yet returned unto me, while I do not think they have perished outright,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_45","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_45","text":"and yet, I cannot shake the conviction that all is not well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_46","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_46","text":"I desire to investigate that matter in my reconnaissance as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_47","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_48","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_49","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_49","text":"Put from thy mind the one who hath departed. Young Lady Isabel is gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_50","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_50","text":"I know that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_51","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_51","text":"... Proceed with extreme caution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_52","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:d_main_46_03_52","text":"The moment you feel it's too dangerous, withdraw at once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_53","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_46_03_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_03_54","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_03_54","text":"Understood. I shall bear that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}