{"id":"d_contents_tribetower_01","cat":"sub","group":{"id":"d_contents_tribetower","label":"Contents Tribetower"},"label":"d_contents_tribetower_01","stage":null,"prev":null,"next":null,"speakers":{"shifty_c":"Shifty"},"icons":{"shifty_c":"si_c907_00_s"},"lines":[{"id":"d_contents_tribetower_01_01","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_01","text":"Welcome, Commander.","jump":null,"exit":false,"enter":null,"bg":"MachineRoom","bgArt":"machineroom","image":null,"bgm":"bgm_inark","movie":null,"shown":["shifty_c"],"affinity":null},{"id":"d_contents_tribetower_01_02","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_02","text":"Are you here for the battle training?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_03","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_tribetower_01_03","text":"What is this place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_04","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_04","text":"Allow me to explain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_05","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_05","text":"This is Tribe Tower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_06","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_06","text":"It's a training area where Nikkes can put their combat skills to the test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_07","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_07","text":"This place is outfitted with the most advanced tech in the entire Ark, so we can conduct VR battle simulations with Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_08","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_tribetower_01_08","text":"Everything is simulated?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_09","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_09","text":"That's right. Everything is reproduced in VR.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_10","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_10","text":"The Raptures, the environment, even the Nikkes themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_11","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_11","text":"The massive amounts of data we have available allows us to recreate reality down the smallest detail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_12","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_12","text":"And of course, there's no need to worry about fatalities in VR.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_13","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_13","text":"There have, however, been a few deaths resulting from extreme shock. Some people are unable to cope with just how realistic the simulations can be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_14","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_tribetower_01_14","text":"You're telling me Nikkes have died because it was \"too real\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_15","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_15","text":"Actually, they weren't Nikkes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_16","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_16","text":"but Commanders...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_17","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_tribetower_01_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_18","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_18","text":"Ahem... Nevertheless, I still suggest you try it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_19","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_19","text":"The higher level you reach, the stronger your Nikkes will be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_20","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_20","text":"As a commander, it's imperative to know what your squad is capable of, is it not? This is the best place to put them to the test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_21","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_21","text":"Not only that, you'll get rewards from the Central Government for every floor you clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_22","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_22","text":"There's high risk, but even higher rewards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_23","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_tribetower_01_23","text":"All right, I'll give it a shot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_24","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_24","text":"Great!\nJust let me know when you're ready to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_tribetower_01_25","type":"Speech","speaker":"shifty_c","key":"Locale_SubScenario:d_contents_tribetower_01_25","text":"Good luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}