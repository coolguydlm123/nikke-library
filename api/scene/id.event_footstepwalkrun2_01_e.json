nter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_20","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_20","text":"I'll help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_21","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_21","text":"You're not just \"helping\". We're doing this together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun2_01_e_22","text":"Rapi and Red Hood dig graves and bury the scattered bodies of the mass-produced Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun2_01_e_23","text":"After some hesitation, Red Hood sticks the guns upright so they can act as impromptu gravestones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_24","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_24","text":"You all made the ultimate sacrifice. Now, rest in peace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_25","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_25","text":"The dead can't hear you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":nul