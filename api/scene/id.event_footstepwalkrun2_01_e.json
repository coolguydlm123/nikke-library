_e_52","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_52","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_53","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_53","text":"Because I need it, that's why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_54","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_54","text":"I see no reason to fix a cassette player right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_55","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_55","text":"The surface is dangerous. We should not waste our time on frivolous tasks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_56","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_56","text":"Frivolous? Ouch, that stings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_57","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_57","text":"Music can help you get through all sorts of rough patches in life, don't you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_01_e_58","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_01_e_58",