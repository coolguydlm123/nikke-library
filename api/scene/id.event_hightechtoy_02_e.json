techtoy_02_e_13","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_02_e_13","text":"No... Don't... Take...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_14","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_14","text":"The mass-produced Nikke desperately clings onto something with what's left of her arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_15","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_15","text":"What is that she's holding?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_16","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_16","text":"Whatever it is, she doesn't want us to take it. Let's see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_17","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_17","text":"Ah, it's a brain haven.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_18","text":"What is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_19","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_19","text":"A portable freezer that helps preserve the brain of a Nikke that has lost her body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_20","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_20","text":"It's only good for 7 days. After that, the brain is no good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_21","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_21","text":"They're typically handed out to mass-produced Nikkes who have to work on the surface for extended periods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_22","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_22","text":"Either that, or to squads who are conducting search & rescue missions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_23","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_23","text":"Maxwell comes closer to the mass-produced Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_24","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_24","text":"Calm down, we're not here for the brain haven. We're here to save you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_25","type":"Speech","speaker":"massproduction01","key":"Locale_SubScenario:event_hightechtoy_02_e_25","text":"Sa... ve... Help...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_26","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_26","text":"Yes, I know. We'll see what we can do. Just hang tight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_27","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_27","text":"Are you hurt anywhere else other than your arms and legs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_28","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_28","text":"Your head... hmm... yes, it seems okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_29","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_29","text":"Can you save her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_30","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_30","text":"Yes. I figured this would happen, so I brought some extra parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_31","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_31","text":"Fortunately, what I brought just happens to be what needs replacing, so I think I can fix her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_32","type":"Self","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_32","text":"You're going to do the repairs yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_33","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_33","text":"If not me, then who else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_34","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_34","text":"Didn't I ever tell you? When I was a human, I was a researcher at Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_35","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_35","text":"Oh right, maybe you did.","jump":"event_hightechtoy_02_e_37","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_36","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_hightechtoy_02_e_36","text":"I don't think so.","jump":"event_hightechtoy_02_e_38","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_37","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_37","text":"I'm positive I've told you before.","jump":"event_hightechtoy_02_e_40","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_hightechtoy_02_e_38","type":"Speech","speaker":"maxwell_w","key":"Locale_SubScenario:event_hightechtoy_02_e_38","text":"Really? I was positive that I'd told you before.","jump"