"d_main_17_06_21","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_06_21","text":"Snow White. Please calm down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_06_22","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_06_22","text":"Indeed, you mustn't be so impetuous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_06_23","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_06_23","text":"Calm thyself and lend them your ear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_06_24","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_06_24","text":"Is this fellow standing before you truly as crude as you make him out to be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_06_25","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_06_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_06_26","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_06_26","text":"Fine, I overreacted. I admit it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_06_27","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_06_27","text":"Good, still thine hand as you are now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_06_28","type":"Speech","speaker"