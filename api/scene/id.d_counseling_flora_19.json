{"id":"d_counseling_flora_19","cat":"counsel","group":{"id":"char5126","label":"Flora"},"label":"Advising Flora: 19","stage":null,"prev":"d_counseling_flora_18","next":"d_counseling_flora_20","speakers":{"flora":"Flora"},"icons":{"flora":"si_c411_00_s"},"lines":[{"id":"d_counseling_flora_19_1","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_1","text":"People often ask me","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["flora"],"affinity":"_0"},{"id":"d_counseling_flora_19_2","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_2","text":"how much water they should give to flowers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_flora_19_3","text":"It's not that hard. You just water them until it's enough.","jump":"d_counseling_flora_19_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_flora_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_flora_19_4","text":"Shouldn't you just ask the flowers directly?","jump":"d_counseling_flora_19_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_flora_19_5","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_5","text":"If you tell people that, they get confused.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_6","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_6","text":"After all, everyone's idea of enough is different.","jump":"d_counseling_flora_19_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_7","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_7","text":"Haha, yes. That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_8","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_8","text":"I know that you do that as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_9","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_9","text":"You check in with the little ones, ask how much water they want,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_10","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_10","text":"and then give them precisely that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_11","type":"Speech","speaker":"flora","key":"Locale_Counseling:d_counseling_flora_19_11","text":"Of course, many people find it difficult to speak with the little ones, so it's not always easy.","jump":"d_counseling_flora_19_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_flora_19_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_flora_19_12","text":"Flora and I talk more about how much water is the right amount.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"sh