aker":"marian","key":"Locale_MainScenario:d_main_01_03_s_21","text":"I'm Marian. The Commander is here with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_03_s_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_03_s_22","text":"Are you serious? How did you survive that explosion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_03_s_23","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_03_s_23","text":"I get that you're a Nikke, but isn't he a human?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_03_s_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01_03_s_24","text":"Yes, I'm a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_03_s_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_03_s_25","text":"... Something's fishy about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_03_s_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01_03_s_26","text":"Are you really the Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_03_s_27","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_01_03_s_27","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01_03_s_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01_03_s_28","text":"Excuse m