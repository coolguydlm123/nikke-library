{"id":"d_main_27_03_e","cat":"main","group":{"id":"ch27","label":"Chapter 27 · Exploration"},"label":"Circumstances All Their Own: B","stage":"27-12 STAGE · End","prev":"d_main_27_03_s","next":"d_main_27_04_s","speakers":{"elegg":"Elegg","hammering":"Hammering","liveryn":"Liveryn","neon":"Neon","anis":"Anis","rapi":"Rapi"},"icons":{"elegg":"si_c500_00_s","hammering":"si_c490_00_s","liveryn":"si_c480_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_27_03_e_1","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_e_1","text":"Whoa!","jump":null,"exit":false,"enter":null,"bg":"Desert_05","bgArt":"desert_05","image":null,"bgm":"bgm_aztec_a","movie":null,"shown":["anis","neon","rapi","hammering","liveryn","elegg"],"affinity":null},{"id":"d_main_27_03_e_2","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_e_2","text":"Amazing, right? Feels like we're a band of Rapture hunters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_3","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_e_3","text":"... Impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_4","type":"Speech","speaker":"hammering","key":"Locale_MainScenario:d_main_27_03_e_4","text":"I've gone up against a few Raptures in my time, but you guys are on another level.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_5","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_e_5","text":"I'm not gonna be forgetting that anytime soon, I can tell you that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_27_03_e_6","text":"Okay okay, you're all making me blush! I'll only allow further compliments for the next five minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_03_e_7","text":"We've been through a lot up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_8","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_e_8","text":"You're the ones who defeated the members of Exotic, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_9","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_e_9","text":"You also bested the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_10","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_e_10","text":"Seems like you really excel in cooperative battles as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_11","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_03_e_11","text":"What are you bringing all that up for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_03_e_12","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_03_e_12","text":"Nothing, it's just... they seemed practically invincible.","jump":null,"exit":false,"en