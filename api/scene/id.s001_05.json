e","movie":null,"shown":null,"affinity":null},{"id":"s001_05_23","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_23","text":"You can keep me company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_24","type":"Narration","speaker":null,"key":"Locale_SideStory:s001_05_24","text":"Nearby stream.","jump":null,"exit":false,"enter":null,"bg":"land_n","bgArt":"land_n","image":null,"bgm":"bgm_story_thepilgrimacv","movie":null,"shown":null,"affinity":null},{"id":"s001_05_25","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_25","text":"Hmm, these are proving tougher to catch than I anticipated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_26","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_26","text":"What are you doing, exactly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_27","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_27","text":"This is a tool called a fishing rod used to catch fish in the water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_28","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_28","text":"Don't be silly. Fish come from the refrigerator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_29","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_29","text":"Er... there are various types of fish in the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_30","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_31","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_31","text":"Do they taste good?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_32","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_32","text":"Their flavor is on a whole different plane, far exceeding whatever you have had in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_33","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_33","text":"So when will the fish come out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_34","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_34","text":"Patience, my friend. Nothing gets accomplished by rushing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_35","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_36","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_37","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_37","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_38","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_38","text":"Don't look so sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_39","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_39","text":"... But I am sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_40","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_40","text":"That is how the world works. As there are happy things, so there are sad things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_41","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_41","text":"How can life be full of only good things?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_42","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_42","text":"How were things when you were with your Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_43","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_43","text":"It was nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_44","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_44","text":"So those were happy days,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_45","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_45","text":"and today is a sad day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_46","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_46","text":"That's all there is to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_47","type":"Speech","speaker":"marian_p","key":"Locale_SideStory:s001_05_47","text":"When will the good times come back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_48","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_48","text":"That is up to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_49","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_49","text":"Let me impart upon thee the secret to living life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_50","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_50","text":"Think only of the good things. Then the good times will last longer and the melancholy will quickly fade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_51","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_51","text":"Should thou commence thinking only of good things now, and set your heart to creating good things,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s001_05_52","type":"Speech","speaker":"hongryeon","key":"Locale_SideStory:s001_05_52","text":"the sadness of today will be washed 