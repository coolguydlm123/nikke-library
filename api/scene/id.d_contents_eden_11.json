,"affinity":null},{"id":"d_contents_eden_11_82","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_11_82","text":"None of you are Goddesses of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_11_83","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_11_83","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_11_84","type":"Speech","speaker":"noah","key":"Locale_SubScenario:d_contents_eden_11_84","text":"Aren't you being a bit too harsh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_11_85","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_11_85","text":"You can't be Goddesses of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_11_86","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_11_86","text":"Because you're no longer fighting for humanity,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_11_87","type":"Speech","speaker":"johan","key":"Locale_SubScenario:d_contents_eden_11_87","text":"and you're not reclaiming the surface for humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_eden_11_88","type":"Speech","speaker":"harran","key":"Locale_SubScenario:d_contents_eden_11_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_e