{"id":"event_doutsiders_01_s","cat":"event","group":{"id":"ev40006","label":"D-OUTSIDERS"},"label":"Entering the Outer Rim: A","stage":null,"prev":"event_doutsiders_prologue","next":"event_doutsiders_01_e","speakers":{"announcer":"Announcer","Narration":"Narration","reporter":"Reporter","andersen":"Andersen","Self":"Commander","Monologue":"Monologue"},"icons":{"announcer":"si_c912_00_s","Narration":"si_c999_00_s","reporter":"si_c999_00_s","andersen":"si_c903_00_s"},"lines":[{"id":"event_doutsiders_01_s_1","type":"Speech","speaker":"announcer","key":"Locale_SubScenario:event_doutsiders_01_s_1","text":"Heavenly Ascension is reported to have been responsible for two terrorist attacks on the Dome of Eternity:","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":"bgm_mystery","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_2","type":"Speech","speaker":"announcer","key":"Locale_SubScenario:event_doutsiders_01_s_2","text":"one in the downtown area, and another in Sunland Park.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_3","type":"Speech","speaker":"announcer","key":"Locale_SubScenario:event_doutsiders_01_s_3","text":"Residents living in these areas are in a panic,","jump":null,"exit":false,"enter":null,"bg":"Park_n","bgArt":"park_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_4","type":"Speech","speaker":"announcer","key":"Locale_SubScenario:event_doutsiders_01_s_4","text":"as all light sources have ceased to function as of 10 this morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_5","type":"Speech","speaker":"announcer","key":"Locale_SubScenario:event_doutsiders_01_s_5","text":"Many inhabitants are claiming to suffer from claustrophobia during this blackout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_6","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_01_s_6","text":"*beep*","jump":null,"exit":false,"enter":null,"bg":"Stage","bgArt":"stage","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_7","type":"Speech","speaker":"reporter","key":"Locale_SubScenario:event_doutsiders_01_s_7","text":"... Breaking news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["adultwoman"],"affinity":null},{"id":"event_doutsiders_01_s_8","type":"Speech","speaker":"reporter","key":"Locale_SubScenario:event_doutsiders_01_s_8","text":"The terrorist group Heavenly Ascension has revealed that they plan on carrying out more attacks in the near future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_9","type":"Speech","speaker":"reporter","key":"Locale_SubScenario:event_doutsiders_01_s_9","text":"According to a video uploaded on Tetra TV, their next target is Royal Road, and...","jump":null,"exit":false,"enter":null,"bg":"RoyalRoad","bgArt":"royalroad","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_10","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_01_s_10","text":"*beep*","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_11","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_11","text":"The next attack will be in 4 days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["andersen"],"affinity":null},{"id":"event_doutsiders_01_s_12","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_12","text":"If those responsible for these attacks aren't captured by then,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_13","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_13","text":"the top brass is considering possibly sending in troops to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_14","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_s_14","text":"Does anyone know what led to this situation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_15","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_15","text":"I'm afraid not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_16","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_16","text":"There is no way of knowing for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_17","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_17","text":"People in the Outer Rim were wary of those from the outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_18","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_18","text":"It's a veritable cesspool of crime and corruption, and functions as Heavenly Ascension's operation base. Most agents who are sent there never return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_19","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_20","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_20","text":"The Exotic Squad has been the only exception.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_21","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_21","text":"Ever heard of them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_22","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_s_22","text":"I know of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_23","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_23","text":"As I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_24","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_24","text":"To say they're notorious would be putting it mildly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_25","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_25","text":"Every one of their members is a hardened criminal and outlaw. There are even rumors swirling around that they are connected with Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_26","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_26","text":"Be that as it may, they are the only remaining organization in the Outer Rim that we can use for gathering intelligence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_27","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_27","text":"Someone needs to get in contact with them and find out what they know,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_28","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_28","text":"or we may end up with a civil war on our hands between the Ark and the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_29","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_doutsiders_01_s_29","text":"I suppose that \"someone\" is me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_30","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_30","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_31","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_31","text":"You're the only one cut out for this operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_32","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_32","text":"Syuen claims that she knows a way for us to make a deal with Exotic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_33","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_doutsiders_01_s_33","text":"Whatever it ends up being, make good use of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_34","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_01_s_34","text":"*beep*","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_35","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_doutsiders_01_s_35","text":"I instal the app and try running it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_36","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_doutsiders_01_s_36","text":"The portraits of three Nikkes show up on the screen. Underneath the portraits is a UI declaring each of their communication statuses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_37","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_01_s_37","text":"Crow: ON, Viper: ON, Jackal: ON","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_01_s_38","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_01_s_38","text":"Once the button is pressed, detonation will occur in 3 seconds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}