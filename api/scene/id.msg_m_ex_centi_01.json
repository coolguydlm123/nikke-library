{"id":"msg_m_ex_centi_01","cat":"messenger","group":{"id":"room_centi","label":"Centi · Nikke"},"label":"1. Hi, I'm Centi.","stage":null,"prev":null,"next":"msg_m_ex_centi_02","speakers":{"centi":"Centi"},"icons":{"centi":"si_c080_00_s"},"lines":[{"id":"m_ex_centi_01_1","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_1","text":"Hi, I'm Centi.","jump":null},{"id":"m_ex_centi_01_2","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_2","text":"Are you the new Boss?","jump":null},{"id":"m_ex_centi_01_3","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_3","text":"Nice to meet you!","jump":null},{"id":"m_ex_centi_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_4","text":"You too.","jump":null},{"id":"m_ex_centi_01_5","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_5","text":"Looking forward to working with you.","jump":null},{"id":"m_ex_centi_01_6","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_6","text":"Are you handy with tools?","jump":null},{"id":"m_ex_centi_01_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_7","text":"Sure am.","jump":"m_ex_centi_01_9"},{"id":"m_ex_centi_01_8","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_8","text":"Not at all.","jump":"m_ex_centi_01_9"},{"id":"m_ex_centi_01_9","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_9","text":"Oh yeah?","jump":null},{"id":"m_ex_centi_01_10","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_10","text":"Actually, it doesn't really matter whether you're good with tools or not.","jump":null},{"id":"m_ex_centi_01_11","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_11","text":"If you ever need someone to craft something","jump":null},{"id":"m_ex_centi_01_12","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_12","text":"or make repairs, feel free to contact me!","jump":null},{"id":"m_ex_centi_01_13","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_13","text":"I'll solve your problem","jump":null},{"id":"m_ex_centi_01_14","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_14","text":"right in a jiffy!","jump":null},{"id":"m_ex_centi_01_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_15","text":"You seem very reliable.","jump":null},{"id":"m_ex_centi_01_16","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_16","text":"Thanks!","jump":null},{"id":"m_ex_centi_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_17","text":"Can you repair someone's heart?","jump":null},{"id":"m_ex_centi_01_18","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_18","text":"You mean a human heart?","jump":null},{"id":"m_ex_centi_01_19","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_19","text":"Um... it may be faster if you see a doctor for that.","jump":null},{"id":"m_ex_centi_01_20","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_20","text":"But if you want, I could give it a few whacks with some of my tools!","jump":null},{"id":"m_ex_centi_01_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_21","text":"...","jump":null},{"id":"m_ex_centi_01_22","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_22","text":"I wonder if there are any blue prints or schematics","jump":null},{"id":"m_ex_centi_01_23","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_23","text":"of the human heart?","jump":null},{"id":"m_ex_centi_01_24","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_24","text":"Those would be a big help.","jump":null},{"id":"m_ex_centi_01_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_25","text":"I was joking.","jump":null},{"id":"m_ex_centi_01_26","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_26","text":"Oh, you were?","jump":null},{"id":"m_ex_centi_01_27","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_27","text":"Thank goodness!","jump":null},{"id":"m_ex_centi_01_28","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_28","text":"I was wondering how the heck I'd repair a human heart!","jump":null},{"id":"m_ex_centi_01_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_29","text":"Hahaha.","jump":null},{"id":"m_ex_centi_01_30","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_30","text":"I gotta get back to work.","jump":null},{"id":"m_ex_centi_01_31","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_01_31","text":"Call me if you ever need anything!","jump":null},{"id":"m_ex_centi_01_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_01_32","text":"Will do.","jump":null}],"chat":true}