{"id":"d_counseling_cinderella_01","cat":"counsel","group":{"id":"char5124","label":"Cinderella"},"label":"Advising Cinderella: 01","stage":null,"prev":null,"next":"d_counseling_cinderella_02","speakers":{"cinderella":"Cinderella","Narration":"Narration"},"icons":{"cinderella":"si_c511_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_counseling_cinderella_01_1","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_1","text":"Take a look at me, Prince.","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["cinderella"],"affinity":"_0"},{"id":"d_counseling_cinderella_01_2","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_2","text":"Tell me, what do you think of me today?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_01_3","text":"You're beautiful.","jump":"d_counseling_cinderella_01_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_01_4","text":"You're very impressive.","jump":"d_counseling_cinderella_01_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_01_5","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_5","text":"An acceptable, but somewhat typical answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_6","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_6","text":"I hope for a more delightful remark next time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_7","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_7","text":"Anyone can give a perfunctory compliment such as that. It's beneath you, Prince.","jump":"d_counseling_cinderella_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_8","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_8","text":"A perfect compliment!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_9","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_9","text":"I thought the same thing whenever I looked in the mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_10","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_10","text":"I often find myself admiring my own exquisiteness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_11","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_01_11","text":"Are you not curious about how ravishing I can become?","jump":"d_counseling_cinderella_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_01_12","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_cinderella_01_12","text":"Cinderella and I have a discussion about her beauty.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}