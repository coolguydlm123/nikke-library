{"id":"d_counseling_cinderella_crystalwave_08","cat":"counsel","group":{"id":"char5175","label":"Cinderella: Crystal Wave"},"label":"Advising Cinderella: Crystal Wave: 08","stage":null,"prev":"d_counseling_cinderella_crystalwave_07","next":"d_counseling_cinderella_crystalwave_09","speakers":{"cinderella_s":"Cinderella"},"icons":{"cinderella_s":"si_c515_00_s"},"lines":[{"id":"d_counseling_cinderella_crystalwave_08_1","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_1","text":"This is my first time spending this much time just watching the ocean.","jump":null,"exit":false,"enter":null,"bg":"JungleIsland_Out_d","bgArt":"jungleisland_out_d","image":null,"bgm":"event_bgm_wtu_seabreeze","movie":null,"shown":["cinderella_s"],"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_08_2","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_2","text":"There are so many beautiful shells, colors and fish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_3","text":"Do you like the ocean more now?","jump":"d_counseling_cinderella_crystalwave_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_crystalwave_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_4","text":"Do you think the ocean is beautiful now?","jump":"d_counseling_cinderella_crystalwave_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_crystalwave_08_5","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_5","text":"Yes, I'm starting to like it more and more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_08_6","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_6","text":"Truthfully, I never gave much thought to the ocean before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_08_7","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_7","text":"Perhaps there's a kind of beauty to it that can only be seen when you take a closer look.","jump":"d_counseling_cinderella_crystalwave_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_08_8","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_8","text":"I've always thought the ocean to be beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_08_9","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_9","text":"Even then, I've never really liked it that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_08_10","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_08_10","text":"But looking at it now... I think I'm starting to like it a bit more.","jump":"d_counseling_cinderella_crystalwave_08_11","exit":false,"enter":null,"bg":null,"bgArt":n