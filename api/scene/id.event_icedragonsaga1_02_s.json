event_icedragonsaga1_02_s_72","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_72","text":"I'm sorry, but I'm not particularly hungry at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_73","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_73","text":"Besides, I have urgent business with the Association.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_74","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_74","text":"I really must be going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_75","type":"Speech","speaker":"emma","key":"Locale_MainScenario:event_icedragonsaga1_02_s_75","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_76","type":"Speech","speaker":"emma","key":"Locale_MainScenario:event_icedragonsaga1_02_s_76","text":"My goodness, she left in an awful hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_77","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_77","text":"I can't believe I ran into the Green-Eyed Culinary Murderer.","jump":null,"exit":false,"enter":null,"bg":"SnowTown_d","bgArt":"snowtown_d","image":null,"bgm":null,"movie":null,"shown":["guillotine_w_no"],"affinity":null},{"id":"event_icedragonsaga1_02_s_78","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_78","text":"Whenever I'm forced to ingest her dishes, I feel like I've been banished to purgatory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_79","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_79","text":"Even Ingrid asked me to cover for her and say she was in a meeting when Emma brought some food over once,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_80","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_80","text":"and Ingrid was never one for lying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_81","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_81","text":"If I hadn't beaten a swift retreat like I did,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_82","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_82","text":"my adventure would have ended right then and there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_83","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_83","text":"Crisis averted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_84","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_84","text":"I'm sure Emma doesn't mean any harm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_85","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_85","text":"But that's precisely the problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_86","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_86","text":"At any rate, I was so focused on running away, that I haven't the foggiest idea of where I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_87","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_87","text":"Which way must I go to get to the Association?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_88","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_88","text":"Hmm? Is that...?","jump":null,"exit":false,"enter":null,"bg":"EventScene_icedragonsaga_02_1","bgArt":"eventscene_icedragonsaga_02_1","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_89","type":"Speech","speaker":"narration","key":"Locale_MainScenario:event_icedragonsaga1_02_s_89","text":"Guillotine finds herself standing in front of an old shrine located at the center of the village.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_90","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_90","text":"Laplace?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_91","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_91","text":"What's a statue of Laplace doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_92","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_92","text":"Don't you know? That's Laplace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_icedragonsaga_anotherhero","movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_93","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_93","text":"She's protected this land for as long as we can remember.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_94","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_94","text":"So there was another hero besides me?","jump":null,"exit":false,"enter":null,"bg":"SnowTown_d","bgArt":"snowtown_d","image":null,"bgm":null,"movie":null,"shown":["guillotine_w_no","drake_m"],"affinity":null},{"id":"event_icedragonsaga1_02_s_95","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_95","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_96","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_96","text":"Hehe, good old Laplace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_97","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_97","text":"She always said how she wanted to be the best hero anyone's ever known,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_98","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_98","text":"only to end up an ordinary hero. Tragic, really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_99","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_99","text":"Wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_100","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_100","text":"If Laplace has been protecting this place for so long,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_101","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_101","text":"what is she doing now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_102","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_102","text":"Why is she sitting back while the remnants of the Big O roam freely","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_103","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_103","text":"and the Winter's Bane spreads unchecked?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_104","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_104","text":"Hard to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_105","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_105","text":"Let me tell you a story that's been passed down in our village.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_106","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_106","text":"When the White Ice Dragon came here, it brought the Big O along with it, blighting our lands and cursing us with the Winter's Bane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_107","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_107","text":"When that happened, the hero Laplace gathered her companions and embarked on a quest to lift the curse.","jump":null,"exit":false,"enter":null,"bg":"IceLand_05","bgArt":"iceland_05","image":null,"bgm":null,"movie":null,"shown":["laplace"],"affinity":null},{"id":"event_icedragonsaga1_02_s_108","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_108","text":"The hero and her companions defeated Shifty, the strongest of the Big O's Four Heavenly Kings,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty_s"],"affinity":null},{"id":"event_icedragonsaga1_02_s_109","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_109","text":"and slowed the spread of the Winter's Bane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_110","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_110","text":"However, Laplace eventually found herself bereft of proper companions,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_111","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_111","text":"and so she was soundly defeated by the Heavenly Kings which remained.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_112","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_112","text":"She did not even reach the Demon King's castle, where the White Ice Dragon resides.","jump":null,"exit":false,"enter":null,"bg":"SnowTown_d","bgArt":"snowtown_d","image":null,"bgm":null,"movie":null,"shown":["guillotine_w_no","drake_m"],"affinity":null},{"id":"event_icedragonsaga1_02_s_113","type":"Speech","speaker":"drake_m","key":"Locale_MainScenario:event_icedragonsaga1_02_s_113","text":"If you do not wish to suffer the same fate,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_icedragonsaga1_02_s_114","type":"Speech","speaker":"guillotine_w_no","key":"Locale_MainScenario:event_icedragonsaga1_02_s_114","text":"you must make sure to form a tight