{"id":"msg_m_ex_n102_05","cat":"messenger","group":{"id":"room_n102","label":"N102 · Nikke"},"label":"8. Teacher!","stage":null,"prev":"msg_m_ex_n102_04","next":"msg_m_ex_n102_06","speakers":{"n102":"N102"},"icons":{"n102":"si_c120_00_s"},"lines":[{"id":"m_ex_n102_05_1","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_1","text":"Teacher!","jump":null},{"id":"m_ex_n102_05_2","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_2","text":"*Pop pop*","jump":null},{"id":"m_ex_n102_05_3","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_3","text":"*Pop pop pop*","jump":null},{"id":"m_ex_n102_05_4","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_4","text":"Do you know what's making that popping sound?","jump":null},{"id":"m_ex_n102_05_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_5","text":"??","jump":null},{"id":"m_ex_n102_05_6","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_6","text":"*Pop pop pop pop*","jump":null},{"id":"m_ex_n102_05_7","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_7","text":"*Pop pop pop pop pop*","jump":null},{"id":"m_ex_n102_05_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_8","text":"*Pop pop pop pop pop pop*","jump":null},{"id":"m_ex_n102_05_9","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_9","text":"!!","jump":null},{"id":"m_ex_n102_05_10","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_10","text":"*Pop pop pop pop*","jump":null},{"id":"m_ex_n102_05_11","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_11","text":"*Pop pop pop pop pop*","jump":null},{"id":"m_ex_n102_05_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_12","text":"*Pop pop pop pop pop pop*","jump":null},{"id":"m_ex_n102_05_13","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_13","text":"Do you have one too?","jump":null},{"id":"m_ex_n102_05_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_14","text":"What are you talking about?","jump":null},{"id":"m_ex_n102_05_15","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_15","text":"It's a plastic sheet with lots of round bubbles on it.","jump":null},{"id":"m_ex_n102_05_16","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_16","text":"Anis gave me some.","jump":null},{"id":"m_ex_n102_05_17","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_17","text":"She said it feels really good to pop them.","jump":null},{"id":"m_ex_n102_05_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_18","text":"Ah, bubble wrap!","jump":null},{"id":"m_ex_n102_05_19","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_19","text":"I knew you'd know what it is.","jump":null},{"id":"m_ex_n102_05_20","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_20","text":"Anis was right.","jump":null},{"id":"m_ex_n102_05_21","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_21","text":"It's so fun to pop them!","jump":null},{"id":"m_ex_n102_05_22","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_22","text":"It is quite addictive.","jump":"m_ex_n102_05_24"},{"id":"m_ex_n102_05_23","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_23","text":"Have you tried rolling it up and squeezing it?","jump":"m_ex_n102_05_27"},{"id":"m_ex_n102_05_24","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_24","text":"Hehe,","jump":null},{"id":"m_ex_n102_05_25","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_25","text":"so you enjoy it too?","jump":null},{"id":"m_ex_n102_05_26","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_26","text":"That's great! *Pop pop*","jump":"m_ex_n102_05_30"},{"id":"m_ex_n102_05_27","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_27","text":"I can't do that! T_T","jump":null},{"id":"m_ex_n102_05_28","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_28","text":"That'd be such a waste.","jump":null},{"id":"m_ex_n102_05_29","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_29","text":"I'd be done with it way too quickly... *Pop*","jump":"m_ex_n102_05_30"},{"id":"m_ex_n102_05_30","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_30","text":"Huh?","jump":null},{"id":"m_ex_n102_05_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_31","text":"What's wrong?","jump":null},{"id":"m_ex_n102_05_32","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_32","text":"I found something interesting, Teacher!","jump":null},{"id":"m_ex_n102_05_33","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_33","text":"One of the bubbles is shaped like a heart.","jump":null},{"id":"m_ex_n102_05_34","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_34","text":"It's so cute!","jump":null},{"id":"m_ex_n102_05_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_35","text":"The bubble wrap gods have chosen you.","jump":null},{"id":"m_ex_n102_05_36","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_36","text":"Exactly!","jump":null},{"id":"m_ex_n102_05_37","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_37","text":"I've got to show Anis.","jump":null},{"id":"m_ex_n102_05_38","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_38","text":"I heard that happiness multiplies when you share it with others.","jump":null},{"id":"m_ex_n102_05_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_39","text":"I'm sure she'll appreciate that.","jump":null},{"id":"m_ex_n102_05_40","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_40","text":"I'll show it to you tomorrow as well.","jump":null},{"id":"m_ex_n102_05_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_05_41","text":"Looking forward to it.","jump":null},{"id":"m_ex_n102_05_42","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_05_42","text":"*Pop pop*","jump":null}],"chat":true}