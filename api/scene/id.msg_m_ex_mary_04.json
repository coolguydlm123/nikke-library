{"id":"msg_m_ex_mary_04","cat":"messenger","group":{"id":"room_mary","label":"Mary · Nikke"},"label":"7. Knock knock!","stage":null,"prev":"msg_m_ex_mary_baygoddess_03","next":"msg_m_ex_mary_05","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"m_ex_mary_04_1","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_1","text":"Knock knock!","jump":null},{"id":"m_ex_mary_04_2","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_2","text":"Knock knock knock!","jump":null},{"id":"m_ex_mary_04_3","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_04_3","text":"Who's there?","jump":"m_ex_mary_04_8"},{"id":"m_ex_mary_04_4","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_04_4","text":"I don't have time for this.","jump":"m_ex_mary_04_5"},{"id":"m_ex_mary_04_5","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_5","text":"Aw, come now, Commander, don't be like that!","jump":null},{"id":"m_ex_mary_04_6","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_6","text":"I was just trying out a harmless knock-knock joke.","jump":null},{"id":"m_ex_mary_04_7","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_7","text":"No need to get grumpy.","jump":"m_ex_mary_04_8"},{"id":"m_ex_mary_04_8","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_8","text":"It's me, Mary!","jump":null},{"id":"m_ex_mary_04_9","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_9","text":"I'm reaching out because last time when you came in for a checkup,","jump":null},{"id":"m_ex_mary_04_10","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_10","text":"I noticed something after examining your back.","jump":null},{"id":"m_ex_mary_04_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_04_11","text":"Is there something wrong?","jump":null},{"id":"m_ex_mary_04_12","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_12","text":"Hmmm...","jump":null},{"id":"m_ex_mary_04_13","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_13","text":"Have you been experiencing any stiffness in your shoulders recently?","jump":null},{"id":"m_ex_mary_04_14","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_14","text":"Or back pain?","jump":null},{"id":"m_ex_mary_04_15","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_15","text":"If you would, consider this part of an official medical checkup.","jump":null},{"id":"m_ex_mary_04_16","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_16","text":"Please answer honestly.","jump":null},{"id":"m_ex_mary_04_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_04_17","text":"Actually, my whole body has been aching.","jump":null},{"id":"m_ex_mary_04_18","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_18","text":"I knew it.","jump":null},{"id":"m_ex_mary_04_19","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_19","text":"Your body alignment is off,","jump":null},{"id":"m_ex_mary_04_20","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_20","text":"and it's causing your back to hunch more than usual.","jump":null},{"id":"m_ex_mary_04_21","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_21","text":"If we don't do something,","jump":null},{"id":"m_ex_mary_04_22","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_22","text":"the imbalance will only increase,","jump":null},{"id":"m_ex_mary_04_23","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_23","text":"and that will lead to more aggravated shoulder stiffness, lower back pain, and possibly sciatic issues.","jump":null},{"id":"m_ex_mary_04_24","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_24","text":"If left untreated for long enough, your internal organs could even be affected.","jump":null},{"id":"m_ex_mary_04_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_04_25","text":"That bad?!","jump":null},{"id":"m_ex_mary_04_26","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_26","text":"I'm just saying it's a possibility.","jump":null},{"id":"m_ex_mary_04_27","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_27","text":"Basically,","jump":null},{"id":"m_ex_mary_04_28","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_28","text":"what I'm getting at is that you should come in regularly for physical therapy.","jump":null},{"id":"m_ex_mary_04_29","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_29","text":"Understood?","jump":null},{"id":"m_ex_mary_04_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_04_30","text":"Okay.","jump":null},{"id":"m_ex_mary_04_31","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_04_31","text":"Hehe, good. Just remember that you promised to show up!","jump":null}],"chat":true}