{"id":"event_goddessfall2_03_s","cat":"event","group":{"id":"ev40094","label":"GODDESS FALL · Part 2"},"label":"Wings That Graced the Sky: A","stage":null,"prev":"event_goddessfall2_02_e","next":"event_goddessfall2_03_e","speakers":{"snowwhite":"Snow White","harran":"Harran","hongryeon":"Scarlet","isabel":"Isabel","papillon":"Papillon"},"icons":{"snowwhite":"si_c220_00_s","harran":"si_c230_00_s","hongryeon":"si_c222_00_s","isabel":"si_c231_00_s","papillon":"si_c890_00_s"},"lines":[{"id":"event_goddessfall2_03_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_03_s_1","text":"Moments before the assault on the Queen's space station.","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLobby","bgArt":"brokenedenlobby","image":null,"bgm":"event_bgm_goddessfall_lastflight","movie":null,"shown":["snowwhite","harran"],"affinity":null},{"id":"event_goddessfall2_03_s_2","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_2","text":"I'll go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_3","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_3","text":"I'm better at annihilation battles than you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_4","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_4","text":"You're deluding yourself, Snow White.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_5","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_5","text":"You may fight well, but by raw specs, you're no match for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_6","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_7","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_7","text":"This space station is no match for your clever tricks. It will be a contest of raw strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_8","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_8","text":"And I have no intention of making Isabel carry someone as heavy as you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_9","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_9","text":"Harran.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_10","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_10","text":"You might die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_11","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_11","text":"That's precisely why I should go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_12","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_12","text":"You... all of you... must survive until the very end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_13","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_13","text":"You're, hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_14","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_14","text":"utterly mad, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_15","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_16","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_16","text":"I deem your way superior to Eden's—an ideal, indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_17","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_17","text":"Yet you have forgiven the Ark, something we could never bring ourselves to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_18","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_18","text":"In that, you are the madder ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_19","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_19","text":"You neither despise the Ark nor cherish it enough to extend a hand, and still you burden yourselves with its troubles, sparing them even the smallest inconvenience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_20","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_20","text":"Only one truly consumed by madness could live so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_21","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_21","text":"That very madness is my ideal. But I am not as mad as you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_22","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_22","text":"I could not cast aside my own feelings for the sake of some greater design.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_23","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_24","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_24","text":"You are most worthy of bearing that glorious title—of that there can be no doubt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_25","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_25","text":"As for us, we shall never claim it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_26","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_26","text":"How lamentable... yet what can be done? We are not quite so mad as you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_27","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_27","text":"So remain as you are—mad. Bear that glorious title. Become true Pioneers, as your very name proclaims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_28","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_28","text":"Drive all who follow you mad,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_29","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_29","text":"for it is always the mad who change the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_30","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_30","text":"I'll leave the Queen to you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_31","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall2_03_s_31","text":"See to it that her head strikes the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_32","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_33","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_03_s_33","text":"I promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_34","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_34","text":"So, thou art going?","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLandingStrip","bgArt":"brokenedenlandingstrip","image":null,"bgm":null,"movie":null,"shown":["isabel","hongryeon"],"affinity":null},{"id":"event_goddessfall2_03_s_35","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_35","text":"Yes, this is something only I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_36","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_36","text":"Wouldst thou quaff a cup afore thou takest thy leave?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_37","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_37","text":"Sorry, no drunk driving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_38","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_38","text":"Aye, then I shall ready me one of mine choicest bottles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_39","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_39","text":"When thou returnest, we shall quaff a cup together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_40","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_40","text":"You really think I'll come back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_41","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_41","text":"Ho! Was't thy desire to perish so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_42","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_42","text":"I'm not planning on it, but the chances of survival are slim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_43","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_43","text":"'Tis a mighty draught for one to quaff alone, methinks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_44","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_45","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_45","text":"Then don't drink it just yet, save it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_46","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_46","text":"If you're bragging that it's so good, it must be really something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_47","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_47","text":"Aye, I shall be waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_48","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_03_s_48","text":"Off with thee, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_49","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_49","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_50","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_03_s_50","text":"Scarlet walks away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_51","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_52","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_52","text":"Papillon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_53","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_03_s_53","text":"My, you're like a ghost. How'd you know I was here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["papillon"],"affinity":null},{"id":"event_goddessfall2_03_s_54","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_54","text":"You haven't stopped staring at me ever since the mission was decided.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_55","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_03_s_55","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_56","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_56","text":"Weren't you going to say something to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_57","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_03_s_57","text":"Well... I don't really know. Must've slipped my mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_58","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_58","text":"Papillon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_59","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_59","text":"Go back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_60","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_03_s_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_61","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_61","text":"This isn't a defensive mission anymore. It's an all-out assault.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_62","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_62","text":"You don't need to risk your life just because you're a hostage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_63","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_03_s_63","text":"You haven't trusted me this entire time, and now you're letting me go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_64","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_03_s_64","text":"Did you plant a bomb on me or something? I'm not gonna blow up when I get to the Ark, am I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_65","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_65","text":"That's actually a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_66","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_66","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_67","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_67","text":"I admit I doubted you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_68","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_68","text":"You came across as frivolous and entirely self-absorbed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_69","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:event_goddessfall2_03_s_69","text":"And I don't anymore?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_70","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_70","text":"You didn't run.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_03_s_71","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:event_goddessfall2_03_s_71","text":"I don't know why