{"id":"d_nikke_noir_03","cat":"bond","group":{"id":"char5009","label":"Noir"},"label":"Walking on Air","stage":null,"prev":"d_nikke_noir_02","next":"d_nikke_noir_04","speakers":{"noir":"Noir"},"icons":{"noir":"si_c271_00_s"},"lines":[{"id":"d_nikke_noir_03_1","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_1","text":"What you want to do first is try and hold the pole over here.","jump":null,"exit":false,"enter":null,"bg":"Gym","bgArt":"gym","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["noir"],"affinity":null},{"id":"d_nikke_noir_03_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_2","text":"I put my hands onto the pole like Noir explains.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_3","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_3","text":"The metal is cold to the touch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_4","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_4","text":"The main crux of pole dancing is to make use of the friction between your skin and the pole.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_5","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_5","text":"That friction allows you to hang onto the pole, like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_6","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_6","text":"Keeping a loose grip on the pole, Noir hops up and wraps her legs around it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_7","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_7","text":"See how I'm squeezing my thighs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_8","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_8","text":"As I watch closely, Noir wraps her inner thighs around the pole to keep herself up in the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_9","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_9","text":"As gravity slowly pulls her body downward, the flesh on her thighs is being rubbed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_10","text":"Looks painful...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_11","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_11","text":"It does hurt a little at first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_12","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_12","text":"You get used to it though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_13","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_13","text":"You may get a bruise or two in the beginning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_14","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_14","text":"Would you like to try it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_15","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_15","text":"... I suppose it's similar to climbing a rope, just in reverse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_16","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_16","text":"I jump onto the pole and wrap my legs around it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_17","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_17","text":"Ooof!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_18","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_18","text":"How do you feel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_19","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_19","text":"So far, so good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_20","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_20","text":"You're doing good!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_21","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_21","text":"Now, while staying in the position you're in, can you let go of your hands?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_22","text":"... Both of them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_23","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_23","text":"Yep!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_24","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_24","text":"So long as you keep the tension in your thighs, the friction will keep you from falling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_25","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_25","text":"But it will sting a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_26","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_27","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_27","text":"I gingerly release my hands one by one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_28","text":"!!!!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_29","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_29","text":"It feels as if my skin is going to tear, and I jump down from the pole.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_30","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_30","text":"Are you all right?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_31","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_31","text":"You didn't hurt yourself, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_32","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_32","text":"Sorry, this is my first time teaching someone else how to pole dance...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_33","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_33","text":"That was probably a bit too advanced for a beginner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_34","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_34","text":"It's okay. You're good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_35","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_35","text":"Huh...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_36","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_36","text":"Learning to endure the pain is an integral part of all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_37","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_37","text":"I-I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_38","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_38","text":"I appreciate you saying that, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_39","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_39","text":"it seems somewhat cruel to ask you to keep going","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_40","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_40","text":"if you're in such pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_41","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_41","text":"It's okay. I can do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_42","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_42","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_43","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_43","text":"Oh, wait a second!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_44","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_44","text":"There's a move we can try that shouldn't be painful at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_45","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_45","text":"We'll have to work together, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_46","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_46","text":"Here, grip onto my pole and stand there for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_47","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_47","text":"That's all I have to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_48","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_48","text":"Yep, just hold onto the pole with one hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_49","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_49","text":"I gently hold the pole that Noir was riding on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_50","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_50","text":"... It's warm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_51","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_51","text":"Noir skillfully clambers up to the top of the pole, maneuvering around my head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_52","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_52","text":"This move makes it look like you're sitting down while you're still on the pole.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_53","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_53","text":"Once at the top,  Noir squeezes with her inner thighs and crosses her legs,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_54","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_54","text":"making it look as if she is sitting down in mid-air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_55","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_55","text":"As you can see, I'm using my thighs to stay up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_56","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_56","text":"This is... a bit too close for comfort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_57","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_57","text":"Standing directly below Noir and looking up, there's far less distance between us than I thought there would be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_58","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_58","text":"Hmm, the ceiling in here isn't high enough...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_59","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_59","text":"and you're too tall!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_60","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_60","text":"It was fine when I was with Blanc.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_61","type":"Speech","speaker":"noir","key":"Locale_NikkeEpisode:d_nikke_noir_03_61","text":"Well, this is a bit awkward...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_62","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noir_03_62","text":"I wouldn't say awkward, more like...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noir_03_63","type":