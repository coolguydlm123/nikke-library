{"id":"d_counseling_phantom_04","cat":"counsel","group":{"id":"char5122","label":"Phantom"},"label":"Advising Phantom: 04","stage":null,"prev":"d_counseling_phantom_03","next":"d_counseling_phantom_05","speakers":{"phantom":"Phantom"},"icons":{"phantom":"si_c580_00_s"},"lines":[{"id":"d_counseling_phantom_04_1","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_04_1","text":"I can't believe how many evil people there are in this world.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["phantom"],"affinity":"_0"},{"id":"d_counseling_phantom_04_2","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_04_2","text":"It pains me how much good people suffer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_04_3","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_04_3","text":"How can we make the world a fairer place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_04_4","text":"We just have to keep working at it.","jump":"d_counseling_phantom_04_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_phantom_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_04_5","text":"No matter how hard you try, making the world a fair place is still pretty tough.","jump":"d_counseling_phantom_04_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_phantom_04_6","type":"Speech","speaker":"phantom","key"