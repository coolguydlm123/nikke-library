{"id":"d_counseling_sakura_02","cat":"counsel","group":{"id":"char1012","label":"Sakura"},"label":"Advising Sakura: 02","stage":null,"prev":"d_counseling_sakura_01","next":"d_counseling_sakura_03","speakers":{"sakura":"Sakura"},"icons":{"sakura":"si_c282_00_s"},"lines":[{"id":"d_counseling_sakura_02_1","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_1","text":"{AccountData.NickName}-kun, what would you do if you were the leader of an organization","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sakura"],"affinity":"_0"},{"id":"d_counseling_sakura_02_2","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_2","text":"and you couldn't tell if the decision you were making was the right one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_02_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_02_3","text":"I would believe in myself and keep moving forward.","jump":"d_counseling_sakura_02_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sakura_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_02_4","text":"I'd ask others for their opinion.","jump":"d_counseling_sakura_02_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sakura_02_5","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_5","text":"You're one tough cookie, that's for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_02_6","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_6","text":"You're right. The leader of an organization should have faith in themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_02_7","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_7","text":"Only in this way can the organization be stable.","jump":"d_counseling_sakura_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_02_8","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_8","text":"That is one way of going about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_02_9","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_9","text":"But there's an old saying: too many cooks in the kitchen can spoil the broth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_02_10","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_02_10","text":"It's good if the leader of an organization trusts their own judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_02_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_02_11","text":"I have a deep conversation with Sakura.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}