":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_exotic_02_12","text":"come to think of it, what's the Commander doing in our chat room?","jump":null},{"id":"m_ex_exotic_02_13","type":"Speech","speaker":"viper","key":"Locale_SuddenMessage:m_ex_exotic_02_13","text":"Hey doofus,","jump":null},{"id":"m_ex_exotic_02_14","type":"Speech","speaker":"viper","key":"Locale_SuddenMessage:m_ex_exotic_02_14","text":"it's because you're in the wrong chat room.","jump":null},{"id":"m_ex_exotic_02_15","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_exotic_02_15","text":"Agh!","jump":null},{"id":"m_ex_exotic_02_16","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_exotic_02_16","text":"Jackal left the group chat.","jump":null},{"id":"m_ex_exotic_02_17","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_exotic_02_17","text":"Jackal has joined the group.","jump":null},{"id":"m_ex_exotic_02_18","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_exotic_02_18","text":"What about now??","jump":null},{"id":"m_ex_exotic_02_19","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_exotic_02_19","text":"Is the chat history cleared??","jump":null},{"id":"m_ex_exotic_02_20","type":"Speech","speaker":"viper","key":"Locale_SuddenMessage:m_ex_exotic_02_20","text":"Seriously...?","jump":null},{"id":"m_ex_exotic_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_exotic_02_21","text":"What is it that you buried?","jump":null},{"id":"m_ex_exotic_02_22","type":"Speech","speaker":"viper","key":"Locale_SuddenMessage:m_ex_exotic_02_22","text":"Oh, that?","jump":null},{"id":"m_ex_exotic_02_23","type":"Speech","speaker":"viper","key":"Locale_SuddenMessage:m_ex_exotic_02_23","text":"Nothing special ;)","jump":null},{"id":"m_ex_exotic_02_24","type":"Speech","speaker":"viper","key":"Locale_SuddenMessage:m_ex_exotic_02_24","text":"It's a little time capsule","jump":null},{"id":"m_ex_exotic_02_25",