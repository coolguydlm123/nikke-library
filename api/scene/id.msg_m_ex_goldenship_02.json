{"id":"msg_m_ex_goldenship_02","cat":"messenger","group":{"id":"room_blueezs","label":"Blue EZS · Group"},"label":"1. Hey","stage":null,"prev":null,"next":null,"speakers":{"blueezs":"Blue EZS"},"icons":{},"lines":[{"id":"msg_m_ex_goldenship_02_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 102310107 · After Golden Pirate Crew chat 1. Mast has invited {AccountData.NickName} to joi…","key":null},{"id":"m_ex_goldenship_02_1","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_1","text":"Hey","jump":null},{"id":"m_ex_goldenship_02_2","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_2","text":"Er","jump":null},{"id":"m_ex_goldenship_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_3","text":"Who's this?","jump":null},{"id":"m_ex_goldenship_02_4","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_4","text":"Hello, Subordinate.","jump":null},{"id":"m_ex_goldenship_02_5","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_5","text":"It's Helm.","jump":null},{"id":"m_ex_goldenship_02_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_6","text":"It is?","jump":null},{"id":"m_ex_goldenship_02_7","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_7","text":"Yes.","jump":null},{"id":"m_ex_goldenship_02_8","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_8","text":"Sorry if I caught you off guard.","jump":null},{"id":"m_ex_goldenship_02_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_9","text":"What's with the \"Blue EZS\" name?","jump":null},{"id":"m_ex_goldenship_02_10","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_10","text":"EZS is the vessel code","jump":null},{"id":"m_ex_goldenship_02_11","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_11","text":"for the Admire,","jump":null},{"id":"m_ex_goldenship_02_12","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_12","text":"and blue stands for the ocean.","jump":null},{"id":"m_ex_goldenship_02_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_13","text":"Uh-huh.","jump":null},{"id":"m_ex_goldenship_02_14","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_14","text":"I'm sorry","jump":null},{"id":"m_ex_goldenship_02_15","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_15","text":"for bothering you with trivial matters.","jump":null},{"id":"m_ex_goldenship_02_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_16","text":"Why didn't you just send me a personal message?","jump":null},{"id":"m_ex_goldenship_02_17","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_17","text":"Hmm...","jump":null},{"id":"m_ex_goldenship_02_18","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_18","text":"I thought you would be with Mast and Anchor.","jump":null},{"id":"m_ex_goldenship_02_19","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_19","text":"If I sent you a message","jump":null},{"id":"m_ex_goldenship_02_20","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_20","text":"and they happened to see a notification from me...","jump":null},{"id":"m_ex_goldenship_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_21","text":"You don't want them knowing you're in contact with me?","jump":null},{"id":"m_ex_goldenship_02_22","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_22","text":"Yes.","jump":null},{"id":"m_ex_goldenship_02_23","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_23","text":"A little bit.","jump":null},{"id":"m_ex_goldenship_02_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_24","text":"Why's that?","jump":null},{"id":"m_ex_goldenship_02_25","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_25","text":"Er...","jump":null},{"id":"m_ex_goldenship_02_26","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_26","text":"Well...","jump":null},{"id":"m_ex_goldenship_02_27","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_27","text":"It's the first time either of them has been sent out to the desert,","jump":null},{"id":"m_ex_goldenship_02_28","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_28","text":"so I wanted to see how they were doing.","jump":null},{"id":"m_ex_goldenship_02_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_29","text":"They're doing just fine.","jump":null},{"id":"m_ex_goldenship_02_30","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_30","text":"Okay,","jump":null},{"id":"m_ex_goldenship_02_31","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_31","text":"good.","jump":null},{"id":"m_ex_goldenship_02_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_32","text":"So you wanted to see if they're adjusting to the surroundings okay?","jump":null},{"id":"m_ex_goldenship_02_33","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_33","text":"That's not the only reason.","jump":null},{"id":"m_ex_goldenship_02_34","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_34","text":"It's just that","jump":null},{"id":"m_ex_goldenship_02_35","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_35","text":"we've always prepared ourselves for naval-based missions.","jump":null},{"id":"m_ex_goldenship_02_36","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_36","text":"Our training has taken place exclusively in and around water.","jump":null},{"id":"m_ex_goldenship_02_37","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_37","text":"They might have trouble adapting to a desert environment.","jump":null},{"id":"m_ex_goldenship_02_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_38","text":"Ha, I can see you're quite worried about them.","jump":null},{"id":"m_ex_goldenship_02_39","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_39","text":"Er...","jump":null},{"id":"m_ex_goldenship_02_40","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_40","text":"Don't laugh!","jump":null},{"id":"m_ex_goldenship_02_41","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_41","text":"I shouldn't have to explain this,","jump":null},{"id":"m_ex_goldenship_02_42","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_42","text":"but I'm the leader of the Aegis Squad.","jump":null},{"id":"m_ex_goldenship_02_43","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_43","text":"Seeing how my squadmates are doing","jump":null},{"id":"m_ex_goldenship_02_44","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_44","text":"is part of my job.","jump":null},{"id":"m_ex_goldenship_02_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_45","text":"Don't you worry. Actually, we even had time to hang out at the beach today.","jump":null},{"id":"m_ex_goldenship_02_46","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_46","text":"!!","jump":null},{"id":"m_ex_goldenship_02_47","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_47","text":"I see...","jump":null},{"id":"m_ex_goldenship_02_48","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_48","text":"So you went to the ocean?","jump":null},{"id":"m_ex_goldenship_02_49","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_49","text":"You're not just immersed in the desert, then.","jump":null},{"id":"m_ex_goldenship_02_50","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_50","text":"That's... nice.","jump":null},{"id":"m_ex_goldenship_02_51","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_51","text":"Yep.","jump":null},{"id":"m_ex_goldenship_02_52","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_52","text":"That's good.","jump":null},{"id":"m_ex_goldenship_02_53","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_53","text":"We might end up actually catching a glimpse of the Golden Ship.","jump":null},{"id":"m_ex_goldenship_02_54","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_54","text":"The Golden Ship?","jump":null},{"id":"m_ex_goldenship_02_55","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_55","text":"Oh yes, now I remember.","jump":null},{"id":"m_ex_goldenship_02_56","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_56","text":"Mast is obsessed with that kind of stuff.","jump":null},{"id":"m_ex_goldenship_02_57","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_57","text":"Um... Subordinate,","jump":null},{"id":"m_ex_goldenship_02_58","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_58","text":"this is a bit embarrassing to say,","jump":null},{"id":"m_ex_goldenship_02_59","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_59","text":"but please look after Mast and Anchor.","jump":null},{"id":"m_ex_goldenship_02_60","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_60","text":"Don't worry, I will. We'll be back before you know it.","jump":null},{"id":"m_ex_goldenship_02_61","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_61","text":"Thanks.","jump":null},{"id":"m_ex_goldenship_02_62","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_62","text":"And don't tell them that","jump":null},{"id":"m_ex_goldenship_02_63","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_63","text":"we had this conversation.","jump":null},{"id":"m_ex_goldenship_02_64","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_64","text":"My lips are sealed.","jump":null},{"id":"m_ex_goldenship_02_65","type":"Speech","speaker":"blueezs","key":"Locale_SuddenMessage:m_ex_goldenship_02_65","text":"Good. I know you can keep a secret.","jump":null},{"id":"m_ex_goldenship_02_66","type":"Narration","speaker":null,"key":"Locale_SuddenMessage:m_ex_goldenship_02_66","text":"Blue EZS left the group chat.","jump":null}],"chat":true}