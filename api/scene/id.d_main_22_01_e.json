iranda","key":"Locale_MainScenario:d_main_22_01_e_28","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_29","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_29","text":"I-I will!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_30","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_30","text":"Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_01_e_31","text":"Poli, what happened here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_32","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_32","text":"Sorry, but we don't have the details either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_33","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_33","text":"Miranda and I were wrapping up our shift, when all of a sudden this massive hole appeared in the Dome of Eternity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_01_e_34","text":"So it has something to do with the dome breaking down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_35","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_35","text":"I think so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_36","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_01_e_36","text":"What caused the hole to appear?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_37","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_37","text":"I don't know. Like I told you, it came out of nowhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_38","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_38","text":"After that, Raptures started pouring through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_39","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_39","text":"The last thing we remember was going toe-to-toe with a Lord-class Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_40","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_40","text":"Once we came to, we were assessing the situation, and that's when we ran into you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_41","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_01_e_41","text":"Give me a damage report.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_42","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_42","text":"Plenty of buildings and roadways have been totaled,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_43","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_43","text":"but thankfully I don't think there have been any human casualties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_44","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_44","text":"At least not according to what we've seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_45","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_45","text":"There could be bodies out there we simply haven't discovered yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_46","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_01_e_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_47","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_47","text":"It's not all doom and gloom. The emergency power is running properly, so there's that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_48","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_48","text":"We've been hearing a lot of gunfire off in the distance as well. The other Nikkes must be giving those Raptures a hard time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":n