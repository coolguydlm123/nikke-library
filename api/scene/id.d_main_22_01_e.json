{"id":"d_main_22_01_e","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"A.C.P.U.","stage":"22-3 STAGE · Start","prev":"d_main_22_01_s","next":"d_main_22_02_s","speakers":{"anis":"Anis","neon":"Neon","rapi":"Rapi","poli":"Poli","miranda":"Miranda"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","poli":"si_c030_00_s","miranda":"si_c032_00_s"},"lines":[{"id":"d_main_22_01_e_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_22_01_e_1","text":"Damn! How many of these things are there?!","jump":null,"exit":false,"enter":null,"bg":"DestroyedStreet","bgArt":"destroyedstreet","image":null,"bgm":"bgm_collapse_a","movie":null,"shown":["rapi","anis","neon"],"affinity":null},{"id":"d_main_22_01_e_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_22_01_e_2","text":"There may be more here than there are on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_22_01_e_3","text":"Enemy concentration is exceedingly high. This may take longer than expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_4","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_4","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["poli","miranda"],"affinity":null},{"id":"d_main_22_01_e_5","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_5","text":"Ahhh! Commander!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_22_01_e_6","text":"Poli! Miranda!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_7","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_7","text":"You're safe! What a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_8","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_8","text":"Commander! The Ark...! The Ark...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_9","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_9","text":"Get a hold of yourself, Miranda! Now's not the time to lose your faculties.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_10","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_10","text":"But...! The Ark...! The Ark...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_11","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_22_01_e_11","text":"Ahhhh! The Ark!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_12","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_22_01_e_12","text":"Hyyyyah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_01_e_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_01_e_13","text":"*Bam*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":