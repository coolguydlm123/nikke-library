,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_12","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_12","text":"I know, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_13","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_13","text":"I'm just so stoked that we're making real chocolate and not the fake stuff using Splendamin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_14","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_14","text":"Aren't you excited as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_15","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_16","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_16","text":"... Maybe a little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_17","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_17","text":"Ade, have you made real chocolate before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_18","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_18","text":"No. This is my first time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_19","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_19","text":"Then I presume you're feeling excited?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_20","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_20","text":"Yes. This is not an opportunity that comes by often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_21","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_21","text":"In fact, if we remained in the Ark, we would never have this opportunity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_22","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_22","text":"Thank you for bringing us out, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_maidinvalentine_intermission_01_23","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_maidinvalentine_intermission_01_23","text":"I'll make you some genuine Valentine's Day chocolate if it's the last thing I do, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":