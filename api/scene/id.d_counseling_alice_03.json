{"id":"d_counseling_alice_03","cat":"counsel","group":{"id":"char5004","label":"Alice"},"label":"Advising Alice: 03","stage":null,"prev":"d_counseling_alice_02","next":"d_counseling_alice_04","speakers":{"alice":"Alice"},"icons":{"alice":"si_c191_00_s"},"lines":[{"id":"d_counseling_alice_03_1","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_03_1","text":"The Queen has brought soooooo much snow.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["alice"],"affinity":"_0"},{"id":"d_counseling_alice_03_2","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_03_2","text":"Is there a way we can ask her to stop?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_03_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_alice_03_3","text":"We could soothe her nerves with a cup of black tea.","jump":"d_counseling_alice_03_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_alice_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_alice_03_4","text":"Actually, the snow has nothing to do with Ludmilla.","jump":"d_counseling_alice_03_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_alice_03_5","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_03_5","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_alice_03_6","type":"Speech","speaker":"alice","key":"Locale_Counseling:d_counseling_alice_03_6","text":"You're right! If the Queen is in a good mood, she won't bring any more sno