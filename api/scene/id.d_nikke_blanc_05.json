anc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_140","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_141","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_141","text":"Um... is it okay if I get another go at telling you how I feel about you later on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_142","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_blanc_05_142","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_143","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_143","text":"It's just that I'd like to tell Noir beforehand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_144","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_blanc_05_144","text":"Noir? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_145","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_145","text":"She's my sister. She deserves to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_146","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_146","text":"So, later on, when we're all together,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_147","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_147","text":"I'll tell you how I feel... again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_148","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_148","text":"Until then, just be patient!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_149","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_blanc_05_149","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_150","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_blanc_05_150","text":"I'm somewhat befuddled, but with Blanc right in front of me, I feel I should humor her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_151","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_blanc_05_151","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_152","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_blanc_05_152","text":"As soon as Blanc hears my response, she leaps up from the hospital bed and into my arms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_153","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_153","text":"From now on, I'll be your good luck charm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_154","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_154","text":"I want to share my luck with you, and you alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_155","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_blanc_05_155","text":"That's great, but shouldn't we keep our distance for the time being?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_156","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_blanc_05_156","text":"Since your stamina isn't fully recovered yet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_157","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_157","text":"Everything will be all right, since I know you've got my best interests in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_158","type":"Speech","speaker":"blanc","key":"Locale_NikkeEpisode:d_nikke_blanc_05_158","text":"I really am infatuated with you, Pit Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_blanc_05_159","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_blanc_05_159","text":"And just like that, our weirdly wonderful (and not to mention, lucky) date came to an end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}