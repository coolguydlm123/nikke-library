e_arcana_04_64","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_64","text":"But these days, I'm like a zombie. Maybe because I'm becoming relaxed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_65","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_65","text":"Why did you used to be like that with sleep?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_66","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_66","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_67","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_67","text":"Wanna take a guess?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_68","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_68","text":"Arcana stops walking and turns to face me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_69","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_69","text":"Pop quiz.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_70","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_70","text":"Every night, the imperturbable, icy professional Arcana erased all memory of the time from when clocking in to clocking out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_71","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_71","text":"What do you think that means?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_72","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_72","text":"I don't know. What does it mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_73","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_73","text":"The answer is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_74","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_74","text":"In essence, I only had half the time available to me that other people do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_75","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_75","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_76","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_76","text":"Time was a precious thing to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_77","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_77","text":"I wasn't going to live long anyway, and my days were shorter than everyone else's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_78","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_78","text":"Now, don't get me wrong. I'm not saying that I hated what I was doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_79","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_79","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_80","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_80","text":"So I found a remedy to the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_81","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_81","text":"Since I would be a Nikke, any negative side effects from a lack of sleep would be of no significance to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_82","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_83","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_83","text":"You see? This is why I wasn't going to tell you anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_84","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_84","text":"You're quite the empath, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_85","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_85","text":"I suppose so, yes.","jump":"d_nikke_arcana_04_87","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_86","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_86","text":"Depends on the situation.","jump":"d_nikke_arcana_04_87","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_87","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_87","text":"Then, since you have such a kind heart, I'll lay it all bare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_88","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_88","text":"I'm sure you picked up on how I was speaking in the past tense, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_89","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_89","text":"What do you think that means?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_90","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_90","text":"I don't know. What?","jump":"d_nikke_arcana_04_92","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_91","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_91","text":"Was it...?","jump":"d_nikke_arcana_04_92","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_92","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_92","text":"It means that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_93","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_93","text":"you saved my life!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_94","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_94","text":"You gave me back the other half of my life that I didn't have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_95","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_95","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_96","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_96","text":"Uh... I don't mean to be a wet blanket,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_97","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_97","text":"but I don't really feel like I did anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_98","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_98","text":"Hehe, how pragmatic of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_99","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_99","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_100","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_100","text":"Yes, I suppose you didn't do much besides provide emotional support.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_101","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_101","text":"Most of this is thanks to the improvements the Boss made to the memory wiping tech,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_102","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_102","text":"and also to me hanging in for as long as I have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_103","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_103","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_104","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_104","text":"Yes, you could say all you did was provide \"emotional support\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_105","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_105","text":"That is, as long as you exclude how you risked your life for us to get where you are now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_106","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_106","text":"Which led to you meeting Phantom, and thus knowing me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_107","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_107","text":"How you are a kind and caring person without expecting anything in return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_108","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_108","text":"How you helped a strange girl, who you've never met, regain her memories, nearly at the cost of your own life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_109","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_109","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_110","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_110","text":"But, did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_111","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_111","text":"Having someone be there for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_112","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_112","text":"To stay by my side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_113","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_113","text":"There's only one person in the whole wide world who can do that for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_114","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_114","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_115","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_115","text":"Arcana clasps her trembling hands tightly and forces a smile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_116","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_116","text":"No matter how close I get to someone, they'll never be able to know everything about me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_117","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_117","text":"They'll only know half of me, at best. The version of me that lives outside the Forbidden Library.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_118","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_118","text":"The only one who can know me, all of me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_119","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_119","text":"right now, and for forever, is you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_120","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_120","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_121","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_121","text":"Arcana...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_122","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_122","text":"... We're here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_123","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_123","text":"We arrive at the front of the library.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_124","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_124","text":"You said you were being deployed early tomorrow, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_125","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_125","text":"... Yeah. Before lunchtime, most likely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_126","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_126","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_127","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_127","text":"Arcana takes a step back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_128","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_128","text":"Thank you for walking me back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_129","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_129","text":"Be careful. I'll be rooting for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_130","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_130","text":"Because you're a fan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_131","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_04_131","text":"... Yeah. Because I'm a fan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_04_132","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_04_132","text":"Arcana smiles brightly, then turns and walks inside the library.","jump":null,"exi