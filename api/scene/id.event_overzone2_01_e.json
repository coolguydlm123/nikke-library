{"id":"event_overzone2_01_e","cat":"event","group":{"id":"ev80304","label":"OVER ZONE · Part 2"},"label":"Utopia: B","stage":null,"prev":"event_overzone2_01_s","next":"event_overzone2_02_s","speakers":{"dorothy":"Dorothy","rapunzel":"Rapunzel"},"icons":{"dorothy":"si_c233_00_s","rapunzel":"si_c221_00_s"},"lines":[{"id":"event_overzone2_01_e_1","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_1","text":"It's our first time coming out this far. Before this, we were restricted to that small area right outside the Ark's entryway.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_promise","movie":null,"shown":["dorothy","rapunzel"],"affinity":null},{"id":"event_overzone2_01_e_2","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_2","text":"Isn't this exciting?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_3","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_3","text":"How about we have a little fun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_4","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_4","text":"I don't see any problem with it. After all, it's not every day we get to do this kind of thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_5","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_5","text":"It's nice to see you're in such high spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_6","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_6","text":"Feeling better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_7","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_7","text":"Of course. Everything's peachy. Always has been.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_8","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_8","text":"All right, well, that puts my mind at ease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_9","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_9","text":"We'll be arriving at the Alva particle generator area soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_10","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_10","text":"Once we get there, even my jamming skills will be hampered. If we encounter any resistance, a confrontation will be unavoidable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_11","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_11","text":"Your jamming ability comes from your hair, doesn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_12","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_12","text":"Yep. Each strand is a small jamming device.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_13","text":"I heard that a Nikke's skills and appearance are the manifestations of whatever they considered their ideal when they were a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_14","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_14","text":"What was that for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_15","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_15","text":"Easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_16","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_16","text":"To return home unharmed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_17","text":"So that desire sublimated itself into a jamming skill. Kind of sounds like a monkey's paw situation to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_18","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_18","text":"Heh, let's hope not. Wouldn't want the other shoe to drop on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_19","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_19","text":"What about you? What was the ultimate for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_20","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_20","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_22","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_22","text":"I'm not sure. I forgot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_23","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_23","text":"Come on, don't be like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_24","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_24","text":"I... just wanted to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_25","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_25","text":"The idea of the Raptures taking over seemed so implausible that once it happened, all I wanted was to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_26","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_26","text":"I don't know what skills that would have given birth to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_27","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_27","text":"Well, it seems to have worked at any rate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_28","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_28","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_29","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_29","text":"You're still alive, aren't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_30","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_30","text":"Hehe, I suppose you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_31","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_31","text":"We haven't bought the farm just yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_32","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_32","text":"And we're going to keep it that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_33","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_33","text":"All of us. Together in paradise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_e_34","text":"Do you remember? We promised each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_e_35","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_e_35","text":"I remember.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}