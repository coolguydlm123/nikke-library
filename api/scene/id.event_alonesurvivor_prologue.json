 already am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_51","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_51","text":"I've got all the knowledge I could possibly need right up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_52","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_52","text":"All that's left to do is put it into practice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_53","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_53","text":"But then what if I come off as too much of a try-hard to the others?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_54","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_54","text":"It might be better if I try and maintain some modesty throughout this process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}