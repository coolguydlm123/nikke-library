{"id":"event_alonesurvivor_prologue","cat":"event","group":{"id":"ev40033","label":"ALONE SURVIVOR"},"label":"A Survivalist on Paper","stage":null,"prev":null,"next":"event_alonesurvivor_01_s","speakers":{"Monologue":"Monologue","tvvoice":"TV","tove":"Tove","Narration":"Narration"},"icons":{"tvvoice":"si_c999_00_s","tove":"si_c192_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"event_alonesurvivor_prologue_1","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_alonesurvivor_prologue_1","text":"In a dark room.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_2","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_2","text":"Temperatures up on the surface have plummeted,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_3","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_3","text":"especially in the northernmost regions where the Unlimited Squad is stationed,","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_4","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_4","text":"with winter temperatures reaching staggering lows of negative 65 degrees.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_5","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_5","text":"The conditions in these areas are so frigid that if you throw hot water into the air,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_6","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_6","text":"it will evaporate and proceed to freeze instantaneously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_7","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_7","text":"To survive in an environment like that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_8","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_8","text":"you must never forget the four things that I'm about to tell you.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["tove"],"affinity":null},{"id":"event_alonesurvivor_prologue_9","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_9","text":"... Water, food, fire, and shelter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_10","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_alonesurvivor_prologue_10","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_11","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_11","text":"In cold environments, constant movement is imperative.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_12","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_12","text":"The moment you stop, your body will begin to seize up, and items will freeze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_13","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_13","text":"As you can see here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_14","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_14","text":"my gun is stuck to my hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_15","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_15","text":"If I were to encounter a Rapture in this situation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_16","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_16","text":"our squad would be wiped out before we even knew what hit us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_17","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_17","text":"In order to extricate the gun from my hand, what you want to do is...","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_18","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_18","text":"Use warm urine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_19","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_alonesurvivor_prologue_19","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_20","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_20","text":"You're lost and adrift in a snowy plain, and you're low on water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_21","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_21","text":"Surely you could simply take a few handfuls of snow and use them to hydrate?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_22","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_22","text":"One might mistakenly think it's that easy,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_23","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_23","text":"but if you were to make this mistake, the inside of your mouth would hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_24","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_24","text":"It also won't help with maintaining your body temperature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_25","type":"Speech","speaker":"tvvoice","key":"Locale_SubScenario:event_alonesurvivor_prologue_25","text":"So, what should you do?","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_26","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_26","text":"Take the snow, pack it into a bottle, and warm it up using your body's thermal heat before drinking it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_27","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_alonesurvivor_prologue_27","text":"Tove turns off the TV.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_28","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_28","text":"Well, that should do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_29","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_29","text":"This is the tenth time I've watched this recording.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_30","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_30","text":"I've read all the survival books back to front as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_31","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_31","text":"At this point, I should be beyond prepared to","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_32","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_32","text":"participate in a rescue operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_33","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_34","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_34","text":"Still...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_35","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_35","text":"Maybe I should do a final check, just in case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_36","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_alonesurvivor_prologue_36","text":"Tove looks at herself in the mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_37","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_37","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_38","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_39","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_39","text":"What about grasshoppers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_40","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_40","text":"They're an excellent source of protein.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_41","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_41","text":"Can't forget about grubs, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_42","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_42","text":"You've just got to be sure to remove the heads before eating them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_prologue_43","type":"Speech","speaker":"tove","key":"Locale_SubScenario:event_alonesurvivor_prologue_43","text":"Reindeer hides can be stretched","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,