eech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_47","text":"Aaaaahhh, that's the spot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_48","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_48","text":"I guess ordinary Nikkes can come through in a pinch after all. I may have to ask for your help in the next couple of days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_49","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_49","text":"I've got to take it easy for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_50","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_laplace_03_50","text":"Huh? Why should we? Have your friends at Matis do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_51","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_51","text":"They're busy. They don't have time to take care of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_52","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_laplace_03_52","text":"And we're not busy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_53","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_53","text":"Thaaaaanks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,