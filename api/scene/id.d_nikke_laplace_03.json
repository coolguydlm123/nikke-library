{"id":"d_nikke_laplace_03","cat":"bond","group":{"id":"char1010","label":"Laplace"},"label":"A Hero's Sense of Duty","stage":null,"prev":"d_nikke_laplace_02","next":"d_nikke_laplace_04","speakers":{"maxwell":"Maxwell","laplace":"Laplace","anis":"Anis","neon":"Neon","citizen":"Citizen"},"icons":{"maxwell":"si_c102_00_s","laplace":"si_c100_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","citizen":"si_c999_00_s"},"lines":[{"id":"d_nikke_laplace_03_1","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_1","text":"There doesn't seem to be anything wrong.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["maxwell","laplace"],"affinity":null},{"id":"d_nikke_laplace_03_2","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_2","text":"None of her parts are malfunctioning, and her battery is fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_laplace_03_3","text":"Then what's the problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_4","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_4","text":"I'm not sure. It could be anything. Laplace, has anything unusual happened lately?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_5","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_5","text":"Have you, for example, been under a lot of stress?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_6","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_6","text":"... No!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_7","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_7","text":"Hmm, really? One thing is for sure, it can't be a mechanical issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_8","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_8","text":"I've been under a little pressure, but nothing that would cause me to lose control of my arms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_9","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_9","text":"I wouldn't be so sure if I were you. I'm willing to bet that stress is exactly what's causing this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_10","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_10","text":"Stress is the leading cause of almost every disease we know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_11","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_11","text":"We'll need to observe you for a couple of days. Even if it's not stress, it could be some other inner influence or reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_laplace_03_12","text":"So does that mean...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_13","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_13","text":"She'll have to stay like this for a while. There's nothing I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_14","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_14","text":"We'll just have to wait until Laplace feels better, or less stressed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_15","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_15","text":"I see! Thanks, doc!\nI'll get some rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_16","type":"Speech","speaker":"maxwell","key":"Locale_NikkeEpisode:d_nikke_laplace_03_16","text":"Yes. Right. That's a good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_17","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_17","text":"Hero!! Opening the door!!","jump":null,"exit":false,"enter":null,"bg":"Corridor","bgArt":"corridor","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_18","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_18","text":"... Could you open the door for me, Birdie?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_19","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_laplace_03_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_20","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_laplace_03_20","text":"*Swoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_laplace_03_21","text":"I'll help you out until you regain control of your arms.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_22","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_22","text":"It's okay. A hero shouldn't be receiving help from a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_23","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_laplace_03_23","text":"What would you call what I just did then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_24","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_24","text":"Well... that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_laplace_03_25","type":"Speech","speaker":"laplace","key":"Locale_NikkeEpisode:d_nikke_laplace_03_25","text":"That was just a favor!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,