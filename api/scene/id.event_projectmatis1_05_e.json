{"id":"event_projectmatis1_05_e","cat":"event","group":{"id":"ev40116","label":"PROJECT MATIS · Part 1"},"label":"The Third CEO: B","stage":null,"prev":"event_projectmatis1_05_s","next":"event_projectmatis1_06_s","speakers":{"jien":"Jien","syuen":"Syuen","maxwell_h":"Maxwell"},"icons":{"jien":"si_c973_00_s","syuen":"si_c901_00_s","maxwell_h":"si_c105_01_s"},"lines":[{"id":"event_projectmatis1_05_e_1","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_1","text":"How have you been?","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"event_bgm_pmatis_mdaughters","movie":null,"shown":["syuen","jien"],"affinity":null},{"id":"event_projectmatis1_05_e_2","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_2","text":"What the hell?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_3","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_3","text":"Why are you here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_4","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_4","text":"Why do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_5","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_5","text":"I missed my cute little sister after all this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_6","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_6","text":"Aren't you glad to see me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_7","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_7","text":"You wish. Get back down there, now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_8","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_8","text":"I never gave you permission to come up here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_9","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_9","text":"Come now, that's a bit harsh. I only just got here, and you're already sending me back down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_10","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_10","text":"Besides, I can come up without the CEO's permission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_11","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_11","text":"Are you saying...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_12","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_12","text":"The board has been making a fuss about how much you've been struggling lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_13","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_13","text":"I went through all this trouble just to make this trip here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_14","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_14","text":"... Those bastards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_15","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_15","text":"It must be pretty bad if word reached even me, shut away down in that basement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_16","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_16","text":"Wouldn't you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_17","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_17","text":"Hehe. We're underground here too, so it's a little funny to call my place a \"basement.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_18","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_18","text":"You...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_19","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_19","text":"Now, what was it I heard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_20","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_20","text":"Something about needing to deliver results, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_21","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_21","text":"It seems what they want from you is innovation, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_22","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_22","text":"Whether it's true or not, it's none of your concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_23","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_23","text":"Use it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_24","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_24","text":"The hero Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_25","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_25","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_26","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_26","text":"Now that Father's gone, you can use it, can't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_27","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_27","text":"I said it's none of your concern!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_28","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_28","text":"Besides...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_29","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_29","text":"I won't use it. I can do this without it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_30","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_30","text":"I won't use something Father disapproved of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_31","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_32","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_32","text":"Syuen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_33","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_33","text":"Do you still truly believe Father disliked it? Even now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_34","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_34","text":"I mean...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_35","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_35","text":"By now, even you must know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_36","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_36","text":"No one has managed to match what you created, even to this very day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_37","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_37","text":"Then why did Father...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_38","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_38","text":"Why else? Because he had ulterior motives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_39","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_39","text":"Ulterior motives...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_40","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_40","text":"Fine. Let's think of it this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_41","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_41","text":"Why do you suppose Father put you in that seat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_42","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_42","text":"Because you're the legitimate heir and I'm not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_43","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_43","text":"You of all people should know that, for all his other faults, Father would never discriminate based on something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_44","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_44","text":"Wh-who says I don't know that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_45","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_45","text":"Don't talk as if you know Father so well!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_46","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_46","text":"Then there's only one answer, isn't there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_47","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_47","text":"It's because you made that blueprint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_48","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_48","text":"Because... I made the hero Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_49","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_49","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_50","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_50","text":"He believed you were capable of taking Nikkes in a new direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_51","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_51","text":"That's why he gave you that position.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_52","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_52","text":"Not me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_53","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_53","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_54","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_54","text":"That man may have been a liar, but he had an infallible eye for talent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_55","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_55","text":"Looking back, even I can admit that I was... a little unhinged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_56","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_56","text":"My true intentions were showing plain as day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_57","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_57","text":"Even I wouldn't hand the CEO position over to someone like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_58","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_58","text":"Watch what you say about Father!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_59","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_59","text":"Even after everything he put you through, you're still protecting him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_60","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_60","text":"What remarkable devotion, my dear little sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_61","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_61","text":"Don't mock me. Of course Father means a lot to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_62","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_62","text":"Hmm... is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_63","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_63","text":"Is that why you won't use it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_64","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_64","text":"For the sake of a man who trampled on his daughter's efforts to serve his own ambitions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_65","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_65","text":"Someone who threw away his lofty position and vanished?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_66","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_66","text":"Even though he's not here to see it, you still can't bring yourself to use the greatest masterpiece you ever created?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_67","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_67","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_68","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_68","text":"This devotion of yours... Heh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_69","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_69","text":"If you're still hung up on something that pointless, I suppose you're not quite desperate yet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_70","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_70","text":"Since going down there, I've learned all sorts of things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_71","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_71","text":"I don't covet your position quite as much as I used to anymore...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_72","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_72","text":"But maybe I should start gunning for the CEO title again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_73","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_73","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_74","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_74","text":"What I'm saying is, don't get complacent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_75","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_75","text":"If you keep letting your guard down like this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_76","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_76","text":"How should I put it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_77","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_77","text":"It kind of makes me want to go after your position again, even when I had no intentions of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_78","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:event_projectmatis1_05_e_78","text":"You psy