ainScenario:event_projectmatis1_05_e_104","text":"so surely it's fine if someone like me can stay up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_105","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_e_105","text":"Don't tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_106","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_05_e_106","text":"Does it bother you that your little sister has good people by her side?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_107","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_107","text":"Not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_108","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_108","text":"What kind of person would resent having someone as dependable as you by her cute little sister's side?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_109","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_109","text":"Then again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_05_e_110","type":"Speech","speaker":"jien","key":"Locale_MainScenario:event_projectmatis1_05_e_110","text":"My little sister's been getting a lot of flak lately, hasn't she?","jump":null,"exi