p":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_27","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_overthehorizon_01_e_27","text":"Wings of Victory...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_28","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_overthehorizon_01_e_28","text":"Cool name!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_29","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_overthehorizon_01_e_29","text":"Yeah, super cool!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_30","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_30","text":"Right?! I see that you all have good taste! I've always felt the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_31","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_31","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_32","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_32","text":"Right now, we're not able to take on missions to find that, sadly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_33","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_overthehorizon_01_e_33","text":"Why's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_34","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_overthehorizon_01_e_34","text":"Isn't an aerial search way easier than searching from the ground?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_35","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_35","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_36","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_36","text":"That's because of the Tyrant-class Rapture, Storm Bringer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_37","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_37","text":"Going up against it with just a transport ship is basically a suicide mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_38","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_38","text":"Unless it is a huge, fully armed airship like Wings of Victory that was used in the past,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_39","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_39","text":"there is almost no chance of winning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_40","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_40","text":"That's why flight missions are usually limited to areas without anti-air weaponry,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_41","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_41","text":"and even then, flight time is capped at around an hour max.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_42","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_42","text":"At higher speeds, the engine noise gets too loud to hide,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_43","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_43","text":"so we can't move as fast as we would like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_44","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_overthehorizon_01_e_44","text":"Basically, proper search missions have become impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_45","type":"Self","speaker":null,"key":"Locale_SubScenario:event_overthehorizon_01_e_45","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_46","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_46","text":"So, right now,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_47","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_47","text":"our squad's main job is to provide support for resource-gathering squads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_48","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_48","text":"We help make sure all the stuff they find gets safely transported back without any trouble.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_49","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_overthehorizon_01_e_49","text":"That's still pretty darn cool!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_50","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_50","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_51","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_51","text":"Wow, today... I've heard so many things for the first time! I'm really happy that there are people who appreciate what we do!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_52","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_52","text":"Lately, there have been cases where the amount of resources found on the surface","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_53","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_53","text":"and the amount that actually arrives at the Ark after inspection don't match up,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_54","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_54","text":"and that's been really upsetting me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_55","type":"Self","speaker":null,"key":"Locale_SubScenario:event_overthehorizon_01_e_55","text":"So the resources that are initially being found aren't all showing up in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_56","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_56","text":"Yeah, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_57","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_57","text":"Like I said earlier, since our flight time is limited,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_58","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_58","text":"we don't really have enough time on the surface to get an exact count of the resources.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_59","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_59","text":"So there are sometimes tiny differences, like a missing item or two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_60","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_60","text":"This time was pretty much the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_61","type":"Speech","speaker":"cielo","key":"Locale_SubScenario:event_overthehorizon_01_e_61","text":"But the thing is, the gatherers actually confirmed that all the stuff they found was there and accounted for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_62","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_overthehorizon_01_e_62","text":"Huh? But why would that be a problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_63","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_overthehorizon_01_e_63","text":"Isn't it a good thing that nothing was stolen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overthehorizon_01_e_64","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_overthehorizon_01_e_64","text":"Put simply, the problem is that unknown items have made it into t