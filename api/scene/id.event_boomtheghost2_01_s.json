{"id":"event_boomtheghost2_01_s","cat":"event","group":{"id":"ev40085","label":"BOOM! THE GHOST! · Part 2"},"label":"Alfred: A","stage":null,"prev":null,"next":"event_boomtheghost2_01_e","speakers":{"alfred":"Alfred","rapi_ss":"Rapi","elegg_s":"Elegg","tove_s":"Tove","centi_s":"Centi","frima_s":"Frima","yan_s":"Yan","pepper_s":"Pepper"},"icons":{"alfred":"si_c9000_00_s","rapi_ss":"si_c016_01_s","elegg_s":"si_c502_00_s","tove_s":"si_c192_02_s","centi_s":"si_c080_02_s","frima_s":"si_c142_01_s","yan_s":"si_c201_01_s","pepper_s":"si_c131_01_s"},"lines":[{"id":"event_boomtheghost2_01_s_1","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_1","text":"Welcome aboard the luxury cruise ship, Utopia.","jump":null,"exit":false,"enter":null,"bg":"Pilothouse_d","bgArt":"pilothouse_d","image":null,"bgm":"bgm_story_littlehauntedwaltz","movie":null,"shown":["alfred","elegg_s","rapi_ss","frima_s","yan_s","tove_s","pepper_s","centi_s"],"affinity":null},{"id":"event_boomtheghost2_01_s_2","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_2","text":"It has been some time since I've encountered dear passengers like yourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_3","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_3","text":"Please wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_4","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_s_4","text":"*Ziiiiing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_5","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_5","text":"Oh my! The ship's facilities are currently operating at less than 10% capacity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_6","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_6","text":"I intended on offering you a drink, but it appears I will be unable to do so. I apologize.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_7","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_7","text":"Are you... a hologram?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_8","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_8","text":"That is correct, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_9","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_9","text":"I am Alfred, the central AI controlling the luxury cruise ship Utopia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_10","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_10","text":"For greater convenience and visibility, I physically manifest myself as a hologram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_11","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_11","text":"If I may be permitted to boast,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_12","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_12","text":"all the equipment onboard the Utopia is managed by augmented reality holograms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_13","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_13","text":"We prioritize the comfort of our passengers above all else; therefore, everything on this ship is equipped with its own AI system.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_14","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_14","text":"This extends to even simple functions such as opening and closing doors, turning lights on and off, and covering passengers with a blanket or cooking meals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_15","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_15","text":"What? How are holograms even capable of that? They're intangible objects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_16","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_16","text":"A terrific question, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_17","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_17","text":"Allow me to explain by showing you an example of how I can open and close the door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_18","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_18","text":"The door itself is electronically controlled,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_19","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_19","text":"while a well-timed holographic projection simultaneously acts out the motion of opening or closing the door.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_20","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_20","text":"This synchronization is applied to everything else as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_21","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_21","text":"This gives the appearance of the holograms serving the passengers and fulfilling any needs they have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_22","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_22","text":"It's a unique feature of the Utopia which makes passengers feel truly attended to, and we're quite proud of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_23","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_23","text":"What about transporting objects? Can the holograms do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_24","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_24","text":"Technically speaking, no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_25","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_25","text":"The Utopia is outfitted with countless rails and small launch ports,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_26","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_26","text":"creating an efficient transport network throughout the ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_27","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_27","text":"In rare cases where objects need to be sent to passengers, the items are physically launched, while the holograms perform a throwing motion to match the timing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_28","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_28","text":"Are holograms free to move around the ship?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_29","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_29","text":"Unfortunately, that is not possible, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_30","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_30","text":"Each hologram is assigned a designated service area, and cannot leave it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_31","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_31","text":"That explains why they all seemed like moribund spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_32","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_33","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_33","text":"Since you're the main AI, can you control the other holograms?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_34","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_34","text":"Of course. I am a hologram made for that purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_35","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_35","text":"I see, so the central AI calls the shots for all the other AI systems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_36","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_36","text":"Could you possibly do something about the gho... holograms crowding around the lower deck?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_37","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_37","text":"Those are the holograms in charge of maintaining and servicing all facilities aboard the ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_38","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_38","text":"They are meant to assist passengers, so if you need anything, do not hesitate to reach out to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_39","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_39","text":"They were throwing steel crates at us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_40","type":"Speech","speaker":"frima_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_40","text":"Surprising.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_41","type":"Speech","speaker":"yan_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_41","text":"They made a complete mess of all the merchandise I'd arranged too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_42","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_42","text":"Pardon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_43","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_43","text":"Oh, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_44","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_44","text":"It seems there might be a minor glitch in their programming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_45","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_45","text":"I will ensure everything returns to normal shortly. Please wait a moment, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_s_46","text":"*Ziiiiing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_47","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_47","text":"Are we finally rid of the ghostly menace?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_48","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_48","text":"How many times do I have to tell you? Believing in ghosts is for children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_49","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_50","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_51","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_51","text":"There seems to be a problem, dear passengers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_52","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_52","text":"I am being denied access.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_53","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_53","text":"So what do we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_54","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_54","text":"I apologize for the inconvenience, but you will have to use the ship's facilities manually for the time being.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_55","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_55","text":"I will work on resolving the issue as soon as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_56","type":"Speech","speaker":"pepper_s","key":"Locale_MainScenario:event_boomtheghost2_01_s_56","text":"The problem is not about using the facilities. It's that these things are attacking us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_57","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_57","text":"They hurled steel crates at us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_58","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_59","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_59","text":"Are you sure they did not mean to offer it to you as a gift?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_60","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_60","text":"No. They flung it with full force, intending to hit us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_61","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_62","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_62","text":"They were clearly trying to kill us and screaming death curses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_63","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_s_63","text":"... They didn't say anything like that, but they did intentionally throw the crates at us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_64","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_65","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_65","text":"What is happening...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_66","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost2_01_s_66","text":"They must be really rattled. We weren't even addressed as \"Dear passengers\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_67","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_67","text":"My apologies! I will get to the bottom of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_68","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_boomtheghost2_01_s_68","text":"*Ziiiiing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_69","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_69","text":"This cannot be!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_spookaboo","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_70","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_70","text":"The Utopia is no longer a luxury cruise ship,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_01_s_71","type":"Speech","speaker":"alfred","key":"Locale_MainScenario:event_boomtheghost2_01_s_71","text":"but a hellish ghost vessel!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}