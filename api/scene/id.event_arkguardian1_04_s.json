ouldn't have stood idle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_33","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_33","text":"They've accepted it and moved on. So should we.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_34","text":"Our duty is to strive for the best possible outcome in our current situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_35","text":"Don't be one of those people who rage when there's no solution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_36","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_36","text":"Very well... Forgive me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_37","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_37","text":"... Hmm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_38","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_04_s_38","text":"I know there's no helping it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_39","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_04_s_39","text":"But I guess we really can't save everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_40","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_04_s_40","text":"When I became a Nikke, I thought I'd be capable of anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_41","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_arkguardian1_04_s_41","text":"I feel so powerless...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_42","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_42","text":"... I am of like mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_43","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_43","text":"Why am I so feeble thus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_44","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_44","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_45","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_46","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_46","text":"Come now, Dorothy. 'Twas but a passing remark. Surely thou dost not truly deem me weak?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_47","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_47","text":"You can't even remember what you said a moment ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_48","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_48","text":"Wilt thou step outside with me for a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_49","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_49","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_50","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_50","text":"... Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_51","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_51","text":"You told me to step outside with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_52","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_52","text":"I mean to cross blades with thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_53","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_53","text":"Fine. Let's do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_54","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_54","text":"Rapunzel, Snow White, mind being our referees?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_55","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_55","text":"I fear she might start throwing a fit the moment she loses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_56","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_56","text":"Ha! Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_57","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_57","text":"Then prepare to prostrate thyself and admit defeat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_58","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_58","text":"Heh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_59","ty