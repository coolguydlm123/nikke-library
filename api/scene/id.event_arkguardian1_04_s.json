l,"affinity":null},{"id":"event_arkguardian1_04_s_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_6","text":"Of course it's not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_7","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_7","text":"Truth be told, I'd love to do the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_8","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkguardian1_04_s_8","text":"Is there truly no other way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_9","text":"It's as you said—the only option left is to defeat the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_10","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_10","text":"... And even then, there's no guarantee the situation will change.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_11","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_s_11","text":"No one can say for sure that everything will end the moment the Queen falls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_s_12","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_arkg