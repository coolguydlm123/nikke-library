nity":null},{"id":"d_ex_wingofvictory_07_75","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_07_75","text":"In stark contrast to the previous effort, both the dogs and Biscuit remain firmly in place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_76","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_07_76","text":"They are all, however, drooling quite heavily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_77","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_07_77","text":"Three minutes later,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_78","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_07_78","text":"all the dogs are still in their original spots, firmly beside Biscuit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_79","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_07_79","text":"Amazing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_80","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_80","text":"Told you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_81","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_81","text":"Nothing is impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_82","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_82","text":"Very good, everyone. You've officially passed the test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_83","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_83","text":"You've all earned your sweet potato treats, so help yourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_84","type":"Speech","speaker":"max","key":"Locale_SuddenStory:d_ex_wingofvictory_07_84","text":"Woof woof!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_85","type":"Speech","speaker":"puppies","key":"Locale_SuddenStory:d_ex_wingofvictory_07_85","text":"Bark bark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_86","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_07_86","text":"The dogs rush towards the treats that I'm holding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_87","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_wingofvictory_07_87","text":"Hehe, delicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_88","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_07_88","text":"... Biscuit included.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_89","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_89","text":"No matter what happens, you must never allow your loyalty to waver, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_90","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_90","text":"You have to protect your master, Biscuit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_91","type":"Speech","speaker":"max","key":"Locale_SuddenStory:d_ex_wingofvictory_07_91","text":"Woof woof!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_92","type":"Speech","speaker":"puppies","key":"Locale_SuddenStory:d_ex_wingofvictory_07_92","text":"Bark bark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_93","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_93","text":"The same goes for you too, Biscuit. You're their owner and you need to protect them as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_94","type":"Speech","speaker":"biscuit","key":"Locale_SuddenStory:d_ex_wingofvictory_07_94","text":"Got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_07_95","type":"Speech","speaker":"moran","key":"Locale_SuddenStory:d_ex_wingofvictory_07_95","text"