{"id":"msg_m_nikke_epinel_02","cat":"messenger","group":{"id":"room_rumani_s","label":"Rumani · Chat"},"label":"1. Gym Rat.","stage":null,"prev":null,"next":null,"speakers":{"rumani":"Rumani"},"icons":{"rumani":"si_c240_00_s"},"lines":[{"id":"m_nikke_epinel_02_1","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_1","text":"Gym Rat.","jump":null},{"id":"m_nikke_epinel_02_2","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_2","text":"Tell me.","jump":null},{"id":"m_nikke_epinel_02_3","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_3","text":"What did they say about her condition?","jump":null},{"id":"m_nikke_epinel_02_4","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_4","text":"Why did she freeze up all of a sudden?","jump":null},{"id":"m_nikke_epinel_02_5","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_5","text":"There was nothing wrong with her physically.","jump":"m_nikke_epinel_02_7"},{"id":"m_nikke_epinel_02_6","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_6","text":"They suspect may be something psychological.","jump":"m_nikke_epinel_02_11"},{"id":"m_nikke_epinel_02_7","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_7","text":"No surprise there.","jump":null},{"id":"m_nikke_epinel_02_8","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_8","text":"Maintenance is mandatory before every competition.","jump":null},{"id":"m_nikke_epinel_02_9","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_9","text":"I'm more concerned that","jump":null},{"id":"m_nikke_epinel_02_10","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_10","text":"it could be something psychological.","jump":"m_nikke_epinel_02_13"},{"id":"m_nikke_epinel_02_11","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_11","text":"That's what I was thinking.","jump":null},{"id":"m_nikke_epinel_02_12","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_12","text":"It has to be.","jump":null},{"id":"m_nikke_epinel_02_13","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_13","text":"She's already been put","jump":null},{"id":"m_nikke_epinel_02_14","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_14","text":"through the wringer","jump":null},{"id":"m_nikke_epinel_02_15","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_15","text":"as it is.","jump":null},{"id":"m_nikke_epinel_02_16","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_16","text":"What do you mean?","jump":"m_nikke_epinel_02_18"},{"id":"m_nikke_epinel_02_17","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_17","text":"Are you referring to the Pisa Dome explosion?","jump":"m_nikke_epinel_02_20"},{"id":"m_nikke_epinel_02_18","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_18","text":"Have you ever heard of","jump":null},{"id":"m_nikke_epinel_02_19","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_19","text":"the Pisa Dome explosion?","jump":"m_nikke_epinel_02_23"},{"id":"m_nikke_epinel_02_20","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_20","text":"Wha...","jump":null},{"id":"m_nikke_epinel_02_21","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_21","text":"I didn't realize you already knew.","jump":null},{"id":"m_nikke_epinel_02_22","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_22","text":"You always surprise me.","jump":null},{"id":"m_nikke_epinel_02_23","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_23","text":"That was three years ago.","jump":null},{"id":"m_nikke_epinel_02_24","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_24","text":"Back then, many TV programs","jump":null},{"id":"m_nikke_epinel_02_25","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_25","text":"were eager to test Nikkes","jump":null},{"id":"m_nikke_epinel_02_26","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_26","text":"like Epinel and me","jump":null},{"id":"m_nikke_epinel_02_27","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_27","text":"and see how far","jump":null},{"id":"m_nikke_epinel_02_28","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_28","text":"we could push it.","jump":null},{"id":"m_nikke_epinel_02_29","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_29","text":"They all but forced Epinel","jump":null},{"id":"m_nikke_epinel_02_30","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_30","text":"to skateboard on","jump":null},{"id":"m_nikke_epinel_02_31","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_31","text":"rails under the Pisa Dome's ceiling.","jump":null},{"id":"m_nikke_epinel_02_32","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_32","text":"Do you know","jump":null},{"id":"m_nikke_epinel_02_33","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_33","text":"how high the Pisa Dome's ceiling is?","jump":null},{"id":"m_nikke_epinel_02_34","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_34","text":"20 meters?","jump":"m_nikke_epinel_02_37"},{"id":"m_nikke_epinel_02_35","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_35","text":"30 meters?","jump":"m_nikke_epinel_02_37"},{"id":"m_nikke_epinel_02_36","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_36","text":"I don't know.","jump":"m_nikke_epinel_02_37"},{"id":"m_nikke_epinel_02_37","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_37","text":"It was 50 meters.","jump":null},{"id":"m_nikke_epinel_02_38","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_38","text":"50 meters.","jump":null},{"id":"m_nikke_epinel_02_39","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_39","text":"The rails were the only place you could get a foothold.","jump":null},{"id":"m_nikke_epinel_02_40","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_40","text":"It wasn't designed to be ridden with a board.","jump":null},{"id":"m_nikke_epinel_02_41","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_41","text":"She was set up for failure. She was bound to fall.","jump":null},{"id":"m_nikke_epinel_02_42","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_42","text":"How was Epinel?","jump":null},{"id":"m_nikke_epinel_02_43","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_43","text":"She couldn't get anywhere near anything with wheels.","jump":null},{"id":"m_nikke_epinel_02_44","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_44","text":"Let alone her favorite skateboard.","jump":null},{"id":"m_nikke_epinel_02_45","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_45","text":"She'd start shaking and couldn't even walk.","jump":null},{"id":"m_nikke_epinel_02_46","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_46","text":"In the end, they decided to wipe her memory.","jump":null},{"id":"m_nikke_epinel_02_47","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_47","text":"She's been fine since then,","jump":null},{"id":"m_nikke_epinel_02_48","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_48","text":"and regained all her skateboarding skills.","jump":null},{"id":"m_nikke_epinel_02_49","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_49","text":"It seems that her old memories have resurfaced, however.","jump":null},{"id":"m_nikke_epinel_02_50","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_50","text":"I'll look after her.","jump":"m_nikke_epinel_02_52"},{"id":"m_nikke_epinel_02_51","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_epinel_02_51","text":"I'll protect Epinel.","jump":"m_nikke_epinel_02_52"},{"id":"m_nikke_epinel_02_52","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_52","text":"Please do.","jump":null},{"id":"m_nikke_epinel_02_53","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_53","text":"You're the only thing","jump":null},{"id":"m_nikke_epinel_02_54","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_54","text":"that she can rely on right now.","jump":null},{"id":"m_nikke_epinel_02_55","type":"Speech","speaker":"rumani","key":"Locale_NikkeEpisode:m_nikke_epinel_02_55","text":"Please help her.","jump":null}],"chat":true}