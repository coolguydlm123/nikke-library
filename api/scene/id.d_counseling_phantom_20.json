{"id":"d_counseling_phantom_20","cat":"counsel","group":{"id":"char5122","label":"Phantom"},"label":"Advising Phantom: 20","stage":null,"prev":"d_counseling_phantom_19","next":null,"speakers":{"phantom":"Phantom"},"icons":{"phantom":"si_c580_00_s"},"lines":[{"id":"d_counseling_phantom_20_1","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_20_1","text":"Do you know countless movies, comics, and cartoons about thieves exist?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["phantom"],"affinity":"_0"},{"id":"d_counseling_phantom_20_2","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_20_2","text":"It's not just books.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_20_3","text":"Of course, I knew that.","jump":"d_counseling_phantom_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_phantom_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_20_4","text":"Wow, I had no idea.","jump":"d_counseling_phantom_20_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_phantom_20_5","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_20_5","text":"R-really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_20_6","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_20_6","text":"But why... why did you not tell me?","jump":null,"exit":false,"enter":null,"bg":n