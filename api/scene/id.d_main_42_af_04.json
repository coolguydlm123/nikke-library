inScenario:d_main_42_af_04_53","text":"Then why not capture her and confirm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_04_54","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_42_af_04_54","text":"I cannot apprehend Sixo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_04_55","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_42_af_04_55","text":"She knows too much about me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_04_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_42_af_04_56","text":"Huh...?! I never expected you of all people to say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_04_57","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_42_af_04_57","text":"I am not omnipotent, a reality of which I have recently become convinced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_04_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_42_af_04_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_04_59","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_42_af_04_59","text":"Rest for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_af_04_60","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_42_