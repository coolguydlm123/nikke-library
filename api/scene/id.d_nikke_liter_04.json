n a little bit of it would get through.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_98","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_98","text":"Wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_99","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_liter_04_99","text":"Liter stands up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_100","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_100","text":"You came all this way for two Nikkes fighting over something trivial.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_101","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_101","text":"Even for you, the kind-hearted Commander, I guess I should at least try to tell Anis what I think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_102","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_102","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null}]}