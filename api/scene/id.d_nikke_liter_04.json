_liter_04_76","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_77","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_77","text":"They say Nikkes live forever,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_78","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_78","text":"but that's nonsense if you think about it a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_79","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_79","text":"Nothing in this world lasts forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_80","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_80","text":"I've lived long enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_81","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_81","text":"So I'll die one day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_82","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_82","text":"Even if my body never decays, my mind surely will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_83","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_83","text":"When that time comes, or long after,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_84","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_84","text":"I hope the world and those around me will remember me","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_85","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_85","text":"for the right reasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_86","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_86","text":"That way, I can face my death with no regrets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_87","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_87","text":"And I hope everyone else will be the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_88","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_liter_04_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_89","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_04_90","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_04_90","text":"It's such a shame.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":n