{"id":"d_ex_hospital_03","cat":"outpost","group":{"id":"outpost11201","label":"Hospital"},"label":"A Little Nurse","stage":null,"prev":"d_ex_hospital_01","next":"d_ex_hospital_02","speakers":{"mary":"Mary","noah":"Noah"},"icons":{"mary":"si_c130_00_s","noah":"si_c232_00_s"},"notes":["Unlock: Mary · Noah","Featuring Mary · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_hospital_03_1","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_1","text":"At the very least, you'll have to stay in the hospital overnight.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["mary"],"affinity":null},{"id":"d_ex_hospital_03_2","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_2","text":"I really don't think it's that serious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_3","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_3","text":"Now Commander, who is the doctor here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_4","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_4","text":"You've been pushing yourself too hard lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_5","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_5","text":"I'll put you on an IV drip, and I want you to take it easy, understand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_6","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_6","text":"I'm just a little tired, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_7","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_7","text":"I'll need a caregiver to keep tabs on... Um, I mean look after you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_8","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_8","text":"As for me, I have to move on to my next patient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_9","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_9","text":"I'm okay, honestly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_10","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_10","text":"I've already instructed the nearest Nikke in the vicinity to come to the hospital.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_11","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_11","text":"Don't even think about running off. What you need is some rest!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_12","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_12","text":"Which Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_13","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_13","text":"Well, I'm not sure. The emergency button here simply calls for the nearest Nikke, so I can't say who it'll be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_14","type":"Speech","speaker":"mary","key":"Locale_SuddenStory:d_ex_hospital_03_14","text":"Now be good and rest up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_15","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_16","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_16","text":"As I lie on the bed with my IV drip, I begin to feel groggy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_17","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_17","text":"... My eyelids are beginning to feel heavy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_18","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_18","text":"... Eyes...","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_19","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_19","text":"*Bang*","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_20","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_20","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_21","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_21","text":"Pssh... Haha...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["noah"],"affinity":null},{"id":"d_ex_hospital_03_22","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_22","text":"My goodness, what happened? Let me guess: you're so feeble that you got sick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_23","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_23","text":"That would happen to a weakling like you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_24","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_24","text":"Noah? What are you doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_25","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_25","text":"I got summoned here by the hospital, duh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_26","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_26","text":"There I was minding my own business, and this thing suddenly went off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_27","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_27","text":"So, here I am! At your service, hehe!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_28","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_28","text":"What were you doing so close to the hospital?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_29","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_29","text":"I just wanted to check if you are better recently, so I decided to come for a visit. Guess what, I saw someone go into this hospital.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_30","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_30","text":"And I wondered who that guy was and why they were so puny that they even needed to come to the hospital.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_31","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_31","text":"And to my surprise, it was you, Imposter!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_32","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_32","text":"Hee hee...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_33","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_34","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_34","text":"Anyway, I'll be responsible for looking after you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_35","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_35","text":"So...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_36","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_36","text":"what exactly do I need to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_37","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_37","text":"I've never really done this before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_38","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_38","text":"You can just go home.","jump":"d_ex_hospital_03_40","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_39","type":"Choice","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_39","text":"Get me some water then.","jump":"d_ex_hospital_03_50","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_40","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_40","text":"You really want me to leave?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_41","type":"Self","spea