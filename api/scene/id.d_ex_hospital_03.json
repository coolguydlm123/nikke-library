":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_48","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_48","text":"Pssh... you could at least play along...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_49","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_49","text":"I'm not leaving until you say something.","jump":"d_ex_hospital_03_58","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_50","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_50","text":"Water?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_51","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_51","text":"Sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_52","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_52","text":"Noah heads out into the hall to fetch a bottle of water from the fridge, then comes back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_53","type":"Speech","speaker":"noah","key":"Locale_SuddenStory:d_ex_hospital_03_53","text":"Here, drink up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_54","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_hospital_03_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_hospital_03_55","