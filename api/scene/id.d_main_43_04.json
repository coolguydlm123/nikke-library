{"id":"d_main_43_04","cat":"main","group":{"id":"ch43","label":"Chapter 43 · Key"},"label":"House Within the Lines","stage":"43-10 STAGE · Start","prev":"d_main_43_03","next":"d_main_43_05","speakers":{"stall3rd":"Stall III","princess":"Princess"},"icons":{"stall3rd":"si_c9019_00_s","princess":"si_c9018_00_s"},"lines":[{"id":"d_main_43_04_1","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_1","text":"You can stay here.","jump":null,"exit":false,"enter":null,"bg":"UndergroundTunnel","bgArt":"undergroundtunnel","image":null,"bgm":"bgm_chapter43_field_password","movie":null,"shown":["stall3rd","princess"],"affinity":null},{"id":"d_main_43_04_2","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_2","text":"Where?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_3","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_3","text":"Right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_4","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_4","text":"No, I mean where is my room?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_5","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_5","text":"Like I said, right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_6","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_6","text":"... Are you telling me to sleep on the floor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_7","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_7","text":"Yeah. The ceiling's sealed, so it'll be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_8","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_8","text":"This place wasn't cheap. I busted my chops to buy it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_9","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_9","text":"You bought this place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_10","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_10","text":"Yeah, it's my home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_11","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_11","text":"Don't be ridiculous. There's no way this could be someone's home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_12","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_12","text":"It is, though. It's my home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_13","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_13","text":"... Fine. We'll call it that for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_14","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_14","text":"So you bought this entire place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_15","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_15","text":"Wow, you really don't know anything, do you? You literally just sat around doing nothing for two whole years, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_16","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_16","text":"Explain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_17","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_17","text":"See this yellow line?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_18","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_18","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_19","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_19","text":"Everything inside this yellow line is my home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_20","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_20","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_21","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_21","text":"Most of the Outer Rim doesn't belong to anyone, so the concept of having a house doesn't really exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_22","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_22","text":"But you can buy a marked-off area like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_23","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_23","text":"As long as the owner's inside it, they're guaranteed absolute safety. *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_24","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_24","text":"Absolute safety? How?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_25","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_25","text":"The organization that manages this area keeps it safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_26","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_26","text":"You pay them and rent the space from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_27","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_27","text":"See that guy over there? The one by the pillar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_28","text":"Princess looks toward the pillar. A large man is leaning against it, glancing around with a bored expression.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_29","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_29","text":"Right now, that guy's in charge of this area. Think of him as a security guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_30","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_30","text":"If something happens, he either handles it himself or reports it to his superiors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_31","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_31","text":"Just so you know, Big Madam's organization runs this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_32","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_32","text":"You sound like a bunch of children playing house.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_33","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_33","text":"It's a basic safety net, more or less. Without it, this place would be filled with people at each other's throats all the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_34","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_34","text":"In fact, that's apparently how it used to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_35","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_36","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_36","text":"... Has the priestess contacted you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_37","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_37","text":"That is none of your concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_38","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_38","text":"I heard you've been wandering around the whole month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_39","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_39","text":"Looks like you've gained nothing but people's resentment. *Cough, cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_40","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_40","text":"Simpletons like you would never understand my thoughts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_41","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_41","text":"Princess...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_42","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_42","text":"You're going to get yourself killed if you keep acting like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_43","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_43","text":"You think you can survive another thrashing like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_44","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_45","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_45","text":"Work and earn your place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_46","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_46","text":"That way, you won't get ganged up on like that again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_47","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_47","text":"You expect me to work in this filthy dump?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_48","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_48","text":"You're in the Outer Rim right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_49","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_49","text":"This place decides whether you live or die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_50","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_50","text":"I did nothing wrong! They attacked me for no reason!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_51","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_51","text":"That's the problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_52","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_52","text":"Most of the inhabitants here did nothing at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_53","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_53","text":"That's what Heavenly Ascension believed was the main reason the Outer Rim's being eaten away from within.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_54","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_54","text":"Heavenly Ascension... so that's what you call those terrorists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_55","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_55","text":"When Heavenly Ascension gained influence out here, their words started to carry weight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_56","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_56","text":"Before long, most folks in the Outer Rim ended up with jobs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_57","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_57","text":"Ha! Scavenging for Rapture parts, selling corpses, running black-market trades... You call those jobs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_58","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_58","text":"In this place? Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_59","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_59","text":"How embarrassing. I'd laugh if it weren't so sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_60","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_60","text":"So, at some point, *cough* anyone in the Outer Rim who does nothing...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_61","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_61","text":"is seen as either a leech or someone with a death wish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_62","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_62","text":"Especially those from the Ark. Most of them are considered suicidal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_63","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_63","text":"They despair over their situation, and then go around causing trouble everywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_64","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_64","text":"Just like you are now, Princess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_65","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_66","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_66","text":"You've got a way of making people dislike you. That's why you keep getting into fights everywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_67","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_67","text":"You need to work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_68","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_68","text":"The priestess isn't coming back for you, and you're causing way too many problems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_69","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_69","text":"Work under someone, and you'll naturally receive protection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_70","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_70","text":"The Outer Rim isn't just a stopover anymore. It's a place you have to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_71","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_71","text":"Enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_72","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_72","text":"I can always just go back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_73","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_73","text":"You fled from that place, remember?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_74","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_74","text":"I didn't flee. I merely sought temporary refuge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_75","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_75","text":"That's what fleeing is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_76","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_76","text":"Hmph, whatever. There's no point in talking to someone like you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_77","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_77","text":"I'm going back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_78","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_78","text":"Fine. Then go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_79","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_79","text":"Want me to show you the way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_80","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_81","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_81","text":"Big Madam says you get used to corpses if you see enough of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_82","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_82","text":"Maybe this is my chance to start getting used to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_83","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_83","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_84","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_84","text":"What are you waiting for? Let's go. *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_85","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_86","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_86","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_87","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_87","text":"Get some sleep. Apply the ointment I got from Big Madam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_88","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_88","text":"Tomorrow, we'll go see her together,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_89","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_89","text":"and we can get you a job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_90","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_90","text":"Stall III lies on the floor, with nothing but a thin strip of cloth underneath her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_91","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_91","text":"Princess remains awake, unable to fall asleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_92","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_92","text":"Her body aches, and her pride in tatters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_93","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_93","text":"Noise fills the air. Laughter, crying, and all kinds of sounds reach her ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_94","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_94","text":"She tosses and turns.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_95","text":"Beside her, Stall III's ragged coughing continues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_96","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_96","text":"A closed-off ceiling. Faint light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_97","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_97","text":"She lets out a deep sigh and closes her eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_98","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_99","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_99","text":"As sleep eludes her, she opens her eyes again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_100","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_100","text":"You up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_101","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_101","text":"What...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_102","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_102","text":"Come on, let's go job-hunting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_103","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_103","text":"What are you talking about? I've only been lying down for five minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_104","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_104","text":"What are you... *cough* What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_105","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_105","text":"You slept like a log.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_106","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_106","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_107","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_04_107","text":"For some reason, Princess's body feels unusually light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_108","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_108","text":"... I did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_109","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_109","text":"Yeah, you were snoring like crazy. The neighbors even made a big fuss about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_110","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_110","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_111","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_04_111","text":"Get up. Let's get going.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_112","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_112","text":"No, wait! I didn't sleep at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_04_113","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_04_113","text":"I wasn't asleep! I merely closed my eyes for a moment!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}