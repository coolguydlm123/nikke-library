anticvalentine_04_s_5","text":"*Gulp*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["sweetjohnny214"],"affinity":null},{"id":"event_romanticvalentine_04_s_6","type":"Speech","speaker":"sin_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_6","text":"※□My character sounds like▣▣fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_7","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_7","text":"There isn't much to the protagonist...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_8","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_8","text":"The only information I got pertaining to my character was that he's the owner of a Maid Cafe he inherited from his parents, who are deceased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_9","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_9","text":"I intentionally left out anything related to the females in the game, so you wouldn't be too shocked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_10","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_10","text":"Shocked...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_11","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_11","text":"Are you ready, Johnny?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_12","type":"Speech","speaker":"sweetjohnny214","key":"Locale_SubScenario:event_romanticvalentine_04_s_12","text":"I am. I'll only intervene when absolutely necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_13","type":"Speech","speaker":"sweetjohnny214","key":"Locale_SubScenario:event_romanticvalentine_04_s_13","text":"Don't want to break the immersion for you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_14","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_14","text":"Sounds good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_15","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_15","text":"All right, Master Captain, now it's time we tell you more about the female characters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_16","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_16","text":"Why do you sound so serious...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_17","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_17","text":"Because we've tweaked them from how they are in the game.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_18","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_18","text":"We've revised them based on our own relationships in real life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_19","text":"... Okay. Tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_20","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_20","text":"I'll start with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_21","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_21","text":"I was your childhood friend, but we lost touch when you moved away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_22","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_22","text":"Despite that, I still remember the promise we made when we were young to marry each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_23","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_23","text":"As an adult, I sail the open sea as a pirate in search of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_24","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_24","text":"At this point in the story, I stumble into a job at the Maid Cafe where you're the manager.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_25","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_25","text":"The same applies to all the other female characters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_26","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_26","text":"Can I ask you something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_27","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_27","text":"Save all your questions for the end. Next!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_28","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_28","text":"Everyone proceeds to tell me the backstories of their characters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_29","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_29","text":"Anchor is Mast's younger sibling, and also a childhood friend of mine. She believes she is the one who made a matrimonial promise with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_30","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_30","text":"Sin is a woman that my character met after leaving home. Although initially intended as a side character, she was such a hit with audiences that she's gotten several of her own spin-offs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_31","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_31","text":"As for Trony...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_32","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_32","text":"I'm a tortured youth attending a trade school for maids. If you choose poorly, the ending has me become obsessed with you and kidnapping you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_33","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_34","text":"What made you go for that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_35","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_35","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_36","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_36","text":"I figured that since it's so unlike me, that it would actually make it easier to inhabit the character.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_37","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_37","text":"To think I'd become infatuated with such... such a garbage man!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_38","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_39","type":"Speech","speaker":"trony_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_39","text":"Er, sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_40","type":"Self","speaker":null,"key":"Locale_SubScenario:event_romanticvalentine_04_s_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_41","type":"Speech","speaker":"mast_m","key":"Locale_SubScenario:event_romanticvalentine_04_s_41","text":"What do you think, Master Captain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":null,"affinity":null},{"id":"event_romanticvalentine_04_s_42","type":"Speech","speaker":"mast_m","key":"Locale_