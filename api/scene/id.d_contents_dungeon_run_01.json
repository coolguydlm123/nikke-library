ech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_26","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_26","text":"But are you sure we aren't forgetting anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_27","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_27","text":"Guillotine. Don't make me repeat myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_28","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_28","text":"Eep! L-let's go. That includes you too, Partner!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_29","type":"Self","speaker":null,"key":"Locale_SubScenario:d_contents_dungeon_run_01_29","text":"But I wanted to rest for a little bit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_30","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_01_30","text":"*Gasp* *Gasp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["vesti_c"],"affinity":null},{"id":"d_contents_dungeon_run_01_31","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_01_31","text":"I'm here...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_32","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_01_32","text":"So-sorry for being late...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_33","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_01_33","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_34","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_01_34","text":"Guillotine? Maiden? Armored Knight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_35","type":"Speech","speaker":"vesti_c","key":"Locale_SubScenario:d_contents_dungeon_run_01_35","text":"Wh-where did everybody go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_36","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_dungeon_run_01_36","text":"I later found out that they went back into the dungeon without me because they were worried it might be too much for me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_37","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_dungeon_run_01_37","text":"Aren't they all so thoughtful?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_38","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_dunge