{"id":"d_contents_dungeon_run_01","cat":"event","group":{"id":"ev81701","label":"ICE DRAGON SAGA"},"label":"Chronicles of the Ark Mage 01","stage":null,"prev":"d_contents_dungeon_run_prologue","next":"d_contents_dungeon_run_02","speakers":{"guillotine_w_no":"Guillotine","maiden_w":"Maiden","vesti_c":"Vesti"},"icons":{"guillotine_w_no":"si_c182_00_s","maiden_w":"si_c183_00_s","vesti_c":"si_c091_01_s"},"lines":[{"id":"d_contents_dungeon_run_01_1","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_dungeon_run_01_1","text":"To my adorable staff, Kitty,","jump":null,"exit":false,"enter":null,"bg":"DragonCastleIn","bgArt":"dragoncastlein","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_2","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_dungeon_run_01_2","text":"Today was my first time acting as a bullet shiel—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_3","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_contents_dungeon_run_01_3","text":"No, I mean... today was the first time my party members and I went out dungeon crawling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["guillotine_w_no","maiden_w"],"affinity":null},{"id":"d_contents_dungeon_run_01_4","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_4","text":"Hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_5","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_5","text":"Mwahahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_6","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_6","text":"Remarkable! We made it without a single one of us falling behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_7","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_7","text":"What's so remarkable about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_8","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_8","text":"We could have progressed even further","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_9","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_9","text":"if you hadn't insisted on taking the front and then falling into the water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_10","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_10","text":"Hey!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_11","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_11","text":"I've also been meaning to ask you about those wings on your back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_12","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_12","text":"Are those just for show or what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_13","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_13","text":"What?! Decorative?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_14","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_14","text":"No, I've intentionally given myself a handicap!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_15","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_15","text":"If I were to make these wings operational, I'd be able to clear the dungeon far too easily! It'd completely defeat the purpose of training.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_16","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_16","text":"She's new to the game... she doesn't know any better... don't get mad...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_17","type":"Speech","speaker":"guillotine_w_no","key":"Locale_SubScenario:d_contents_dungeon_run_01_17","text":"Huh? You okay, Maiden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_dungeon_run_01_18","type":"Speech","speaker":"maiden_w","key":"Locale_SubScenario:d_contents_dungeon_run_01_18","text":