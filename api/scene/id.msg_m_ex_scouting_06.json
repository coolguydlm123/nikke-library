{"id":"msg_m_ex_scouting_06","cat":"messenger","group":{"id":"room_scouting","label":"The Scouts · Group"},"label":"7. Delta, can I ask you something?","stage":null,"prev":"msg_m_ex_scouting_05","next":"msg_m_ex_scouting_07","speakers":{"signal":"Signal","delta_n":"Delta"},"icons":{"signal":"si_c022_00_s","delta_n":"si_c023_00_s"},"lines":[{"id":"m_ex_scouting_06_1","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_1","text":"Delta, can I ask you something?","jump":null},{"id":"m_ex_scouting_06_2","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_2","text":"What is it?","jump":null},{"id":"m_ex_scouting_06_3","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_3","text":"Um, there's something on the table.","jump":null},{"id":"m_ex_scouting_06_4","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_4","text":"Do you know what it is?","jump":null},{"id":"m_ex_scouting_06_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_5","text":"What do you see?","jump":null},{"id":"m_ex_scouting_06_6","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_6","text":"Hmm...","jump":null},{"id":"m_ex_scouting_06_7","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_7","text":"Looks like some kind of mask,","jump":null},{"id":"m_ex_scouting_06_8","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_8","text":"and a ninja outfit, maybe?","jump":null},{"id":"m_ex_scouting_06_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_9","text":"Oh!","jump":null},{"id":"m_ex_scouting_06_10","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_10","text":"Ah!","jump":null},{"id":"m_ex_scouting_06_11","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_11","text":"It's nothing.","jump":null},{"id":"m_ex_scouting_06_12","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_12","text":"I'll head over and take care of it immediately.","jump":null},{"id":"m_ex_scouting_06_13","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_13","text":"No!","jump":null},{"id":"m_ex_scouting_06_14","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_14","text":"I can take care of it right away!","jump":null},{"id":"m_ex_scouting_06_15","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_15","text":"Eh?","jump":null},{"id":"m_ex_scouting_06_16","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_16","text":"Now that I think about it, this outfit...","jump":null},{"id":"m_ex_scouting_06_17","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_17","text":"looks kind of familiar...","jump":null},{"id":"m_ex_scouting_06_18","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_18","text":"I see,","jump":null},{"id":"m_ex_scouting_06_19","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_19","text":"is that so?","jump":null},{"id":"m_ex_scouting_06_20","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_20","text":"Hmm...","jump":null},{"id":"m_ex_scouting_06_21","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_21","text":"Could it really be...","jump":null},{"id":"m_ex_scouting_06_22","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_22","text":"what I'm thinking?","jump":null},{"id":"m_ex_scouting_06_23","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_23","text":"Signal,","jump":null},{"id":"m_ex_scouting_06_24","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_24","text":"about that...","jump":null},{"id":"m_ex_scouting_06_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_25","text":"Do you want me to explain?","jump":null},{"id":"m_ex_scouting_06_26","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_26","text":"No,","jump":null},{"id":"m_ex_scouting_06_27","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_27","text":"you don't need to explain.","jump":null},{"id":"m_ex_scouting_06_28","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_28","text":"Ah, that's why you've been going out so often lately, Delta.","jump":null},{"id":"m_ex_scouting_06_29","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_29","text":"Apologies, Signal.","jump":null},{"id":"m_ex_scouting_06_30","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_30","text":"I should have informed you earlier.","jump":null},{"id":"m_ex_scouting_06_31","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_31","text":"Delta,","jump":null},{"id":"m_ex_scouting_06_32","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_32","text":"so you've gotten into cosplay lately?!","jump":null},{"id":"m_ex_scouting_06_33","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_33","text":"Ohh, now I get why","jump":null},{"id":"m_ex_scouting_06_34","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_34","text":"you changed your profile picture this time!","jump":null},{"id":"m_ex_scouting_06_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_35","text":"Huh?","jump":null},{"id":"m_ex_scouting_06_36","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_36","text":"Hmm...","jump":null},{"id":"m_ex_scouting_06_37","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_37","text":"Yes.","jump":null},{"id":"m_ex_scouting_06_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_38","text":"Yeah, I guess she's been really into her hobby lately.","jump":null},{"id":"m_ex_scouting_06_39","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_39","text":"Oh, really!?","jump":null},{"id":"m_ex_scouting_06_40","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_40","text":"If you had a hobby like that,","jump":null},{"id":"m_ex_scouting_06_41","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_41","text":"you should've told me!","jump":null},{"id":"m_ex_scouting_06_42","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_42","text":"Why would you hide it from me?","jump":null},{"id":"m_ex_scouting_06_43","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_43","text":"Well,","jump":null},{"id":"m_ex_scouting_06_44","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_44","text":"that's because...","jump":null},{"id":"m_ex_scouting_06_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_45","text":"You're feeling shy?","jump":null},{"id":"m_ex_scouting_06_46","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_46","text":"Impossible.","jump":null},{"id":"m_ex_scouting_06_47","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_47","text":"I take pride in my ninja duties. There is no shame in them.","jump":null},{"id":"m_ex_scouting_06_48","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_48","text":"Oh, Delta,","jump":null},{"id":"m_ex_scouting_06_49","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_49","text":"you can be honest with me sometimes, you know?","jump":null},{"id":"m_ex_scouting_06_50","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_50","text":"It's really okay!","jump":null},{"id":"m_ex_scouting_06_51","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_51","text":"I'll keep today's matter just between us,","jump":null},{"id":"m_ex_scouting_06_52","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_scouting_06_52","text":"so you don't need to worry at all.","jump":null},{"id":"m_ex_scouting_06_53","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_53","text":"That's a relief.","jump":null},{"id":"m_ex_scouting_06_54","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_54","text":"As expected, Signal.","jump":null},{"id":"m_ex_scouting_06_55","type":"Speech","speaker":"delta_n","key":"Locale_SuddenMessage:m_ex_scouting_06_55","text":"I trust you.","jump":null},{"id":"m_ex_scouting_06_56","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_56","text":"... There was a bit of a misunderstanding at first, but it looks like things turned out fine.","jump":null},{"id":"m_ex_scouting_06_57","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_scouting_06_57","text":"Signal says she'll keep it a secret, so I guess we can trust her.","jump":null}],"chat":true}