null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_69","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_69","text":"Show me this new path you're pursuing, which required my destruction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_70","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_70","text":"I don't need a dog that bites the hand which fed it for so long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_71","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_71","text":"If it's obedience you want, then that is what I will be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_72","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_72","text":"Please, let me remain with you and see your plan through until the end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_73","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_73","text":"Sometime later, Main hall in the Seimeikai mansion.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_74","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_74","text":"Per your orders,","jump":null,"exit":false,"enter":null,"bg":"TatamiRoom","bgArt":"tatamiroom","image":null,"bgm":null,"movie":null,"shown":["sakura","genzou"],"affinity":null},{"id":"d_nikke_sakura_05_75","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_75","text":"we have smuggled in 13 different tea trees and planted them in the garden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_76","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_76","text":"We've consulted records in the Wildlife Agency, and have followed them assiduously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_77","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_77","text":"How did they fare?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_78","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_78","text":"Out of the 13 seeds planted, 6 did not survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_79","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_79","text":"Of the 7 which sprouted, 5 later dried up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_80","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_80","text":"We determined it to be a result of insufficiently rich soil and incorrect temperature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_81","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_81","text":"There were various other reasons pertaining to the ecosystem, but we have improved all the areas that we could.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_82","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_83","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_83","text":"And what of the two that remained?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_84","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_84","text":"Did they also wither and die?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_85","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_85","text":"The results...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_86","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_86","text":"... were rather unexpected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_87","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_87","text":"From what we have observed to date,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_88","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_88","text":"they have been growing better than those found in natural environments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_impression","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_89","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_89","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_90","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_90","text":"On top of that, the two types which survived are the rarest on the market.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_91","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_91","text":"I believe our profit margins will be well above what we initially expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_92","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_92","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_93","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_93","text":"Congratulations, Leader.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_94","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_94","text":"You were right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_95","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_95","text":"Even now, I'm not sure I entirely agree with your obsession with right and wrong,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_96","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_96","text":"but you took me back in, even after everything I'd done...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_97","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_97","text":"I hope you can let me prove my worth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_98","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_98","text":"... Do as you please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_99","type":"Speech","speaker":"genzou","key":"Locale_NikkeEpisode:d_nikke_sakura_05_99","text":"... I'll report back to the garden, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_100","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_100","text":"Sometime later, mansion's garden.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_101","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_101","text":"Looks like everything worked out nicely.","jump":null,"exit":false,"enter":null,"bg":"CherryBlossom","bgArt":"cherryblossom","image":null,"bgm":null,"movie":null,"shown":["sakura"],"affinity":null},{"id":"d_nikke_sakura_05_102","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_102","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_103","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_103","text":"We may not have gone about it in the way you hoped, but we achieved the desired results.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_104","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_104","text":"Thank you for being with me through all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_105","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_105","text":"I feel words alone aren't enough to properly thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_106","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_106","text":"Is there anything that you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_107","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_107","text":"Name it, and I shall grant it to you. Money? Power?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_108","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_108","text":"If it is something I cannot give to you straight away, then I will work to see that it is done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_109","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_109","text":"Seimeikai is an organization with a long history.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_110","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_110","text":"I'm confident we have just as many years ahead of us as there are behind us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_111","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_111","text":"You don't have to give me anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_112","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_112","text":"I achieved what I came here for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_113","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_113","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_114","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_114","text":"I thought you came here without a goal in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_115","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_115","text":"So there was something in it for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_116","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_116","text":"Well, what was it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_117","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_117","text":"...","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_118","type":"Speech","speaker":"kitsune","key":"Locale_NikkeEpisode:d_nikke_sakura_05_118","text":"You'll use your pre-existing friendship with Sakura to gain access to the Seimeikai.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_119","type":"Speech","speaker":"kitsune","key":"Locale_NikkeEpisode:d_nikke_sakura_05_119","text":"I want you to mediate the relationship between Sakura and the opposing organizations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_120","type":"Speech","speaker":"kitsune","key":"Locale_NikkeEpisode:d_nikke_sakura_05_120","text":"None of these groups will exactly roll out the red carpet for a stranger,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_121","type":"Speech","speaker":"kitsune","key":"Locale_NikkeEpisode:d_nikke_sakura_05_121","text":"but they won't harm any personnel from the Central Government either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_122","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_122","text":"If it will help out Sakura, I'll do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_123","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_123","text":"I was told you were in danger.","jump":null,"exit":false,"enter":null,"bg":"CherryBlossom","bgArt":"cherryblossom","image":null,"bgm":null,"movie":null,"shown":["sakura"],"affinity":null},{"id":"d_nikke_sakura_05_124","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_124","text":"I wanted to protect you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_125","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_125","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_126","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_126","text":"Yes, there was an internal conflict between me and the organization members, but","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_127","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_127","text":"I never felt I personally was in any jeopardy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_128","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_128","text":"Who put such a ridiculous notion in your head?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_129","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_129","text":"I don't know who they were.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_130","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_05_130","text":"It was a text sent anonymously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_131","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_131","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_132","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_132","text":"So you got a text.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_shapeofhope","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_133","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_133","text":"No idea from who. No idea whether what they were telling you was the truth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_134","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_134","text":"Yet you came rushing in without a second thought, all because you were worried about me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_05_135","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_05_135","text":"... Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,