id":"d_nikke_aria_05_74","type":"Speech","speaker":"audience02","key":"Locale_NikkeEpisode:d_nikke_aria_05_74","text":"She seemed more... like a real person I suppose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_75","type":"Speech","speaker":"audience02","key":"Locale_NikkeEpisode:d_nikke_aria_05_75","text":"In particular, the close bond between Sophia and her guardian really stood out to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_76","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_aria_05_76","text":"I agree, that part was a real standout.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_77","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_77","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_78","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_78","text":"That's because there was someone I could identify them with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_79","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_aria_05_79","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_80","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_80","text":"Maestro,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_81","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_81","text":"do you remember the finale of this opera?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_82","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_aria_05_82","text":"Even if Music Abandons Me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_83","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_83","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_84","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_84","text":"It describes the affection Sophia has towards her guardian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_85","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_85","text":"To be honest, I've never felt that way about someone before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_86","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_86","text":"Everyone tells me they love my singing,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_05_87","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_05_87","text":"but I don't even understand myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ni