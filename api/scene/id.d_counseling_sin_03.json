{"id":"d_counseling_sin_03","cat":"counsel","group":{"id":"char5059","label":"Sin"},"label":"Advising Sin: 03","stage":null,"prev":"d_counseling_sin_02","next":"d_counseling_sin_04","speakers":{"sin":"Sin"},"icons":{"sin":"si_c401_00_s"},"lines":[{"id":"d_counseling_sin_03_1","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_1","text":"Coun▣□selor.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sin"],"affinity":"_0"},{"id":"d_counseling_sin_03_2","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_2","text":"If you rescued a ※※kid who was about to drown\n▣▣※and they said afterwards that they wanted some Nutrium□, what would you do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sin_03_3","text":"I'd probably buy them some.","jump":"d_counseling_sin_03_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sin_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sin_03_4","text":"What makes you ask such a random question?","jump":"d_counseling_sin_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sin_03_5","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_5","text":"You're a good person,※▣ so I'm not surprised▣□to hear you※say that.","jump":"d_counseling_sin_03_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_6","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_6","text":"□□I'm just▣※curious about your personality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_7","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_7","text":"No※▣other reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_8","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_sin_03_8","text":"Personally, I'd buy the kid whatever they wanted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_9","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_9","text":"I□※※see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_10","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_10","text":"▣※Then how about※※a Nikke who almost drowned?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_11","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_11","text":"※※□And▣what if it wasn't drowning, □※but being locked up in the Rehabilitation Center?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_12","type":"Speech","speaker":"sin","key":"Locale_Counseling:d_counseling_sin_03_12","text":"If you ask me,▣▣※I feel worse for those Nikkes.\n□□They're the ones who are most put upon by※society.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_03_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_sin_03_13","text":"I promise Sin that I'll buy her some Nutrium soon.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}