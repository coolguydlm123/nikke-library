{"id":"d_counseling_phantom_14","cat":"counsel","group":{"id":"char5122","label":"Phantom"},"label":"Advising Phantom: 14","stage":null,"prev":"d_counseling_phantom_13","next":"d_counseling_phantom_15","speakers":{"phantom":"Phantom"},"icons":{"phantom":"si_c580_00_s"},"lines":[{"id":"d_counseling_phantom_14_1","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_14_1","text":"The more I read these books about thieves,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["phantom"],"affinity":"_0"},{"id":"d_counseling_phantom_14_2","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_14_2","text":"the more I think I can write one myself. So I gave it a try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_14_3","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_14_3","text":"... Would you like to read it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_14_4","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_14_4","text":"Phantom hands me a stack of papers, the first of which is labeled \"The 102 Menings of Bing a Thiaf\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_14_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_14_5","text":"Uh... sure, I guess.","jump":"d_counseling_phantom_14_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_phantom_14_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseli