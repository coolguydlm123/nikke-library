null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_33","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_33","text":"Operation: Ark Guardian is approximately 72% complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_34","text":"There are officially no more humans remaining on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_35","text":"The Goddess Squad and several mass-produced Nikkes are stationed at temporary outposts situated at the Ark's entrance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_36","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_36","text":"We are to protect the entrance against any future Rapture raids until the Ark is completed and sealed off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_37","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_37","text":"It is expected that we will be required to do this for approximately two months.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_38","text":"However, the situation is becoming dire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_39","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_39","text":"Our resources and troops are both slowly being depleted, and we are becoming physically drained due to the incessant fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_40","text":"We do not expect any form of backup from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_41","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_41","text":"We will do everything in our power to succeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_42","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_42","text":"In exchange for this, you must promise us one thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_43","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_43","text":"Once the city has been sealed, we are to be taken back to the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_44","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_44","text":"where we will be regarded as Goddess of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_45","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_45","text":"Make us feel proud for continuing to fight for humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_46","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone1_01_e_47","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone1_01_e_47","text":"That is all. \nI will be waiting for your answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}