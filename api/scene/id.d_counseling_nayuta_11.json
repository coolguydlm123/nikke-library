{"id":"d_counseling_nayuta_11","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 11","stage":null,"prev":"d_counseling_nayuta_10","next":"d_counseling_nayuta_12","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_11_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_11_1","text":"Should a comrade fall upon the field of battle,","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_11_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_11_2","text":"how wouldst thou bear such a sorrow?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_11_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_11_3","text":"My comrades will never fall in battle.","jump":"d_counseling_nayuta_11_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_11_4","text":"I'll carry on their will and fight to the very end.","jump":"d_counseling_nayuta_11_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_11_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_11_5","text":"An answer most adamant; verily, 'tis most admirable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_11_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_11_6","text":"Yet on the field of