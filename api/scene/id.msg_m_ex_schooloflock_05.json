oflock_05_33","text":"Says who?","jump":null},{"id":"m_ex_schooloflock_05_34","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_schooloflock_05_34","text":"Come on, just come with us.","jump":null},{"id":"m_ex_schooloflock_05_35","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_schooloflock_05_35","text":"Tercera told me she knows a great place.","jump":null},{"id":"m_ex_schooloflock_05_36","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schooloflock_05_36","text":"Yeah!","jump":null},{"id":"m_ex_schooloflock_05_37","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schooloflock_05_37","text":"I prefer celebrating with my teachers.","jump":null},{"id":"m_ex_schooloflock_05_38","type":"Speech","speaker":"tercera","key":"Locale_SuddenMessage:m_ex_schooloflock_05_38","text":"We want to treat you to some good food.","jump":null},{"id":"m_ex_schooloflock_05_39","type":"Speech","speaker":"tercera","key":"Locale_SuddenMessage:m_ex_schooloflock_05_39","text":"Would you please go with us?","jump":null},{"id":"m_ex_schooloflock_05_40","type":"Speech","speaker":"marciana","key":"Locale_SuddenMessage:m_ex_schooloflock_05_40","text":"Well, I...","jump":null},{"id":"m_ex_schooloflock_05_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_schooloflock_05_41","text":"You should come. The students are really looking forward to it.","jump":null},{"id":"m_ex_schooloflock_05_42","type":"Speech","speaker":"marciana","key":"Locale_SuddenMessage:m_ex_schooloflock_05_42","text":"Even you, Commander?","jump":null},{"id":"m_ex_schooloflock_05_43","type":"Speech","speaker":"rei","key":"Locale_SuddenMessage:m_ex_schooloflock_05_43","text":"Come on, let's go!","jump":null},{"id":"m_ex_schooloflock_05_44","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_schooloflock_05_44","text":"Join us!","jump":null},{"id":"m_ex_schooloflock_05_45","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schooloflock_05_45","text":"Yeah, join us!","jump":null},{"id":"m_ex_schooloflock_05_46","type":"Speech","speaker":"tercera","key":"Locale_SuddenMessage:m_ex_schooloflock_05_46","text":"It'll be fun!","jump":null},{"id":"m_ex_schooloflock_05_47","type":"Speech","speaker":"marciana","key":"Locale_SuddenMessage:m_ex_schooloflock_05_47","text":"All right, fine.","jump":null},{"id":"m_ex_schooloflock_05_48","type":"Speech","speaker":"marciana","key":"Locale_SuddenMessage:m_ex_schooloflock_05_48","text":"I'll come.","jump":null},{"id":"m_ex_schooloflock_05_49","type":"Speech","speaker":"rei","key":"Locale_SuddenMessage:m_ex_schooloflock_05_49","text":"Yahoo!","jump":null},{"id":"m_ex_schooloflock_05_50","type":"Speech","speaker":"tercera","key":"Locale_SuddenMessage:m_ex_schooloflock_05_50","text":"Yipee!","jump":null},{"id":"m_ex_schooloflock_05_51","type":"Speech","speaker":"ein","key":"Locale_SuddenMessage:m_ex_schooloflock_05_51","text":"We'll meet you at the school gate after school. See you then.","jump":null},{"id":"m_ex_schooloflock_05_52","type":"Speech","speaker":"zwei","key":"Locale_SuddenMessage:m_ex_schooloflock_05_52","text":"See you around!","jump":null},{"id":"m_ex_schooloflock_05_53","type":"Speech","speaker":"marciana","key":"Locale_SuddenMessage:m_ex_schooloflock_05_53","text":"See you.","jump":null},{"id":"m_ex_schooloflock_05_54","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_schooloflock_05_54","text":"Okay, catch you all later.","jump":null}],"chat":true}