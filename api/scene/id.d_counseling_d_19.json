{"id":"d_counseling_d_19","cat":"counsel","group":{"id":"char1007","label":"D"},"label":"Advising D: 19","stage":null,"prev":"d_counseling_d_18","next":"d_counseling_d_20","speakers":{"d":"D"},"icons":{"d":"si_c040_00_s"},"lines":[{"id":"d_counseling_d_19_1","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_1","text":"One day you receive a gift from a stranger.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["d"],"affinity":"_0"},{"id":"d_counseling_d_19_2","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_2","text":"What do you do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_d_19_3","text":"I check whether the gift contains anything dangerous.","jump":"d_counseling_d_19_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_d_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_d_19_4","text":"I celebrate the fact I've gotten a gift.","jump":"d_counseling_d_19_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_d_19_5","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_5","text":"Very good. You must be cautious at all times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_6","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_6","text":"There is no way of knowing what kind of method will be used to assassinate you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_7","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_7","text":"Don't let yourself get complacent and careless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_8","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_8","text":"The slightest lapse in vigilance creates a window of opportunity for an assassin like me.","jump":"d_counseling_d_19_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_9","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_9","text":"... Sloppy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_10","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_10","text":"Why would you be that careless? You never know what could happen or how things might unfold when you're being targeted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_11","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_11","text":"Don't ever forget that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_12","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_12","text":"The slightest lapse in vigilance creates a window of opportunity for an assassin like me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_13","type":"Speech","speaker":"d","key":"Locale_Counseling:d_counseling_d_19_13","text":"Always be on your guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_d_19_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_d_19_14","text":"I have a conversation with D about having a healthy wariness of strangers.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}