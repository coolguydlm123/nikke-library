{"id":"d_main_04af_02","cat":"main","group":{"id":"ch4","label":"Chapter 4 · Bouquet"},"label":"Imitate Mankind","stage":null,"prev":"d_main_04af_01","next":"d_main_04af_03","speakers":{"anis":"Anis","syuen":"Syuen","rapi":"Rapi","Narration":"Narration","neon":"Neon"},"icons":{"anis":"si_c012_00_s","syuen":"si_c901_00_s","rapi":"si_c010_00_s","Narration":"si_c999_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_04af_02_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_02_1","text":"I oughta kill you!","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":"bgm_story_kneeldownfools","movie":null,"shown":["rapi","anis","neon","syuen"],"affinity":null},{"id":"d_main_04af_02_2","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_04af_02_2","text":"Hey now, watch your mouth!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_02_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_02_3","text":"And if I don't? What are you gonna do about it?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_02_4","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_04af_02_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_02_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_02_5","text":"Why didn't you say anything back there? Why didn't you tell them you ordered us to do all that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_02_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_04af_02_6","text":"You're a CEO. You'd be abl