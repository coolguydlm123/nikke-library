{"id":"msg_m_ex_moran_02","cat":"messenger","group":{"id":"room_moran","label":"Moran · Nikke"},"label":"2. Hey,","stage":null,"prev":"msg_m_ex_moran_01","next":"msg_m_ex_moran_03","speakers":{"moran":"Moran"},"icons":{"moran":"si_c281_00_s"},"lines":[{"id":"m_ex_moran_02_1","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_1","text":"Hey,","jump":null},{"id":"m_ex_moran_02_2","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_2","text":"Cadet!","jump":null},{"id":"m_ex_moran_02_3","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_3","text":"Are my messages coming through?","jump":null},{"id":"m_ex_moran_02_4","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_4","text":"Are you getting them?","jump":null},{"id":"m_ex_moran_02_5","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_5","text":"Darn, are they not sending again?","jump":null},{"id":"m_ex_moran_02_6","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_6","text":"Come on, send...","jump":null},{"id":"m_ex_moran_02_7","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_7","text":"SEND!","jump":null},{"id":"m_ex_moran_02_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_8","text":"I'm getting them.","jump":null},{"id":"m_ex_moran_02_9","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_9","text":"Oh,","jump":null},{"id":"m_ex_moran_02_10","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_10","text":"good!","jump":null},{"id":"m_ex_moran_02_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_11","text":"Is there an emergency?","jump":null},{"id":"m_ex_moran_02_12","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_12","text":"No, nothing like that.","jump":null},{"id":"m_ex_moran_02_13","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_13","text":"I messaged you a while back and never got a response,","jump":null},{"id":"m_ex_moran_02_14","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_14","text":"so I thought you were busy.","jump":null},{"id":"m_ex_moran_02_15","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_15","text":"When I checked again later,","jump":null},{"id":"m_ex_moran_02_16","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_16","text":"I got a notification saying my message had failed to send.","jump":null},{"id":"m_ex_moran_02_17","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_17","text":"So I kept sending more,","jump":null},{"id":"m_ex_moran_02_18","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_18","text":"and now it seems like they all came through at once.","jump":null},{"id":"m_ex_moran_02_19","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_19","text":"Ugh, these hiccups with technology are so annoying.","jump":null},{"id":"m_ex_moran_02_20","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_20","text":"If you ask me,","jump":null},{"id":"m_ex_moran_02_21","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_21","text":"meeting in person is much easier.","jump":null},{"id":"m_ex_moran_02_22","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_22","text":"Don't you think so?","jump":null},{"id":"m_ex_moran_02_23","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_23","text":"Actually, I find messaging more convenient.","jump":"m_ex_moran_02_25"},{"id":"m_ex_moran_02_24","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_24","text":"I agree, meeting in person is much simpler.","jump":"m_ex_moran_02_32"},{"id":"m_ex_moran_02_25","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_25","text":"Really?","jump":null},{"id":"m_ex_moran_02_26","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_26","text":"How come?","jump":null},{"id":"m_ex_moran_02_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_27","text":"Because I can contact someone no matter where they are.","jump":null},{"id":"m_ex_moran_02_28","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_28","text":"Hmm... I guess you've got a point.","jump":null},{"id":"m_ex_moran_02_29","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_29","text":"Even if you're, say... indisposed, I could still get in touch with you.","jump":null},{"id":"m_ex_moran_02_30","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_30","text":"Like if you're using the toilet,","jump":null},{"id":"m_ex_moran_02_31","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_31","text":"or when in the shower.","jump":"m_ex_moran_02_44"},{"id":"m_ex_moran_02_32","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_32","text":"You think so?","jump":null},{"id":"m_ex_moran_02_33","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_33","text":"I knew you and I would agree on this!","jump":null},{"id":"m_ex_moran_02_34","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_34","text":"Nothing beats","jump":null},{"id":"m_ex_moran_02_35","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_35","text":"face-to-face communication.","jump":null},{"id":"m_ex_moran_02_36","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_36","text":"You can really connect with someone instead of sending fragmented, piecemeal messages.","jump":null},{"id":"m_ex_moran_02_37","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_37","text":"It's especially annoying","jump":null},{"id":"m_ex_moran_02_38","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_38","text":"when whoever you're talking to suddenly goes incommunicado.","jump":null},{"id":"m_ex_moran_02_39","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_39","text":"Half the time it feels like I'm talking to a wall.","jump":null},{"id":"m_ex_moran_02_40","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_40","text":"So,","jump":null},{"id":"m_ex_moran_02_41","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_41","text":"even if it might take a while 'cause they're far away,","jump":null},{"id":"m_ex_moran_02_42","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_42","text":"or even up on the surface,","jump":null},{"id":"m_ex_moran_02_43","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_43","text":"I prefer meeting someone in person.","jump":"m_ex_moran_02_44"},{"id":"m_ex_moran_02_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_44","text":"Right.","jump":null},{"id":"m_ex_moran_02_45","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_45","text":"Even though I feel Moran's example is a tad extreme, I don't say anything.","jump":null},{"id":"m_ex_moran_02_46","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_46","text":"Oh, and one more thing.","jump":null},{"id":"m_ex_moran_02_47","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_47","text":"For a while, there are no further messages from Moran.","jump":null},{"id":"m_ex_moran_02_48","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_48","text":"Cadet!","jump":null},{"id":"m_ex_moran_02_49","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_49","text":"Cadet!!!","jump":null},{"id":"m_ex_moran_02_50","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_50","text":"Argh, what is wrong with this damn thing?! Not again!","jump":null},{"id":"m_ex_moran_02_51","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_51","text":"Sorry, but I'm heading over to you.","jump":null},{"id":"m_ex_moran_02_52","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_52","text":"I can't take this anymore.","jump":null},{"id":"m_ex_moran_02_53","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_moran_02_53","text":"Just hang on and wait for me.","jump":null},{"id":"m_ex_moran_02_54","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_moran_02_54","text":"All of the messages arrive simultaneously once Moran arrives.","jump":null}],"chat":true}