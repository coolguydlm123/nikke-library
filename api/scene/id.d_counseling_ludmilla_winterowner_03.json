{"id":"d_counseling_ludmilla_winterowner_03","cat":"counsel","group":{"id":"char5103","label":"Ludmilla: Winter Owner"},"label":"Advising Ludmilla: Winter Owner: 03","stage":null,"prev":"d_counseling_ludmilla_winterowner_02","next":"d_counseling_ludmilla_winterowner_04","speakers":{"ludmilla_w":"Ludmilla"},"icons":{"ludmilla_w":"si_c194_00_s"},"lines":[{"id":"d_counseling_ludmilla_winterowner_03_1","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_1","text":"It's good that we have so many guests at the hot spring now,","jump":null,"exit":false,"enter":null,"bg":"HotSpringInnIn_d","bgArt":"hotspringinnin_d","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ludmilla_w"],"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_2","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_2","text":"but I'm worried that many of them don't know proper bathing etiquette.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_3","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_3","text":"Do you know the rules of which I speak, Servant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_4","text":"When entering the hot spring, you should cover your body with a towel.","jump":"d_counseling_ludmilla_winterowner_03_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ludmilla_winterowner_03_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_5","text":"Before entering the hot spring, you should wash your body.","jump":"d_counseling_ludmilla_winterowner_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ludmilla_winterowner_03_6","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_6","text":"Not necessarily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_7","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_7","text":"Many TV shows depict people covering themselves with a towel before entering a bath,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_8","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_8","text":"and so lots of people mistakenly feel they must do the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_9","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_9","text":"In fact, entering with a towel on is considered impolite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_10","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_10","text":"What's shown on TV is just for show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_11","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_11","text":"Next time, I hope you can display proper bathing etiquette while enjoying the hot spring.","jump":"d_counseling_ludmilla_winterowner_03_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_12","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_12","text":"That's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_13","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_13","text":"Entering the bath without washing beforehand could negatively affect other customers' experiences.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_14","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_14","text":"If I were to see something dirty floating in the water...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_15","type":"Speech","speaker":"ludmilla_w","key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_15","text":"I don't even want to imagine how I'd feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ludmilla_winterowner_03_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ludmilla_winterowner_03_16","text":"I discuss bathing etiquette with Ludmilla.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm