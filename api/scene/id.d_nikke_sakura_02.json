r":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_75","text":"I think they're different.","jump":"d_nikke_sakura_02_77","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_76","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_76","text":"They're different, but also similar.","jump":"d_nikke_sakura_02_78","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_77","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_77","text":"So, you and I agree on that much.","jump":"d_nikke_sakura_02_80","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_78","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_78","text":"Is that what you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_79","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_79","text":"Unfortunately, our thoughts seem to diverge on this particular topic.","jump":"d_nikke_sakura_02_80","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_80","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_80","text":"Black is the color of evil. Immoral and heinous evil behind acts committed to ensuring the organization's survival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_81","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_81","text":"Dark blue is one step down from that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_82","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_82","text":"It's the color of what you could call lesser evil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_83","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_83","text":"For example, if you're cracking down on someone who has gone against the organization,","jump":null,"exit":false,"enter":null,"bg":"JunkMountain","bgArt":"junkmountain","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_84","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_84","text":"there's a world of difference between punishing the individual and punishing their entire family.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_85","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_85","text":"The same principle applies to how we conduct our business.","jump":null,"exit":false,"enter":null,"bg":"Backstreet","bgArt":"backstreet","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_86","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_86","text":"There's a difference between us committing simple blackmail versus say... abducting people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_87","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_87","text":"Then there are plenty of people who come to us voluntarily, wanting to work together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_88","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_88","text":"Even though this is something most people never have to consider,","jump":null,"exit":false,"enter":null,"bg":"CherryBlossom","bgArt":"cherryblossom","image":null,"bgm":null,"movie":null,"shown":["sakura"],"affinity":null},{"id":"d_nikke_sakura_02_89","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_89","text":"as the Seimeikai leader, it's something I have to consider every hour of every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_90","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_90","text":"That was a promise I made to Mustang when I first became a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_91","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_91","text":"I've held fast to my principles all this time, and have refused to engage in anything that went against them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_92","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_92","text":"Unfortunately, most of the organization doesn't feel the same way as I do,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_93","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_93","text":"and this has given rise to some small, yet pernicious, problems.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_94","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_94","text":"It's a hassle, no doubt, but not something the military should be worried about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_95","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_95","text":"What was that Genzou said about you trying to dismantle what your parents had worked so hard for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_96","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_96","text":"For decades, we've been running clandestine activities which started with my forebears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_97","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_97","text":"activities of which Seimeikai has long been a part as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_98","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_98","text":"The kinds of things where the profits are built upon the spilled blood of countless people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_99","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_99","text":"It stands to reason that with more risk, comes greater reward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_100","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_100","text":"I'm sure you can imagine the amount of money they rake in thanks to these activities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_101","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_101","text":"And it looks like your members aren't willing to give that up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_102","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_102","text":"No, they're not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_103","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_103","text":"But what does it matter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_104","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_104","text":"If they refuse to accept my decision,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_105","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_105","text":"then I'll use force if I have to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_106","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_106","text":"Will you be okay, though?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_107","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_107","text":"In what sense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_108","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_108","text":"If you do that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_109","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_109","text":"you'll be turning your own people into your enemy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_110","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_110","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_111","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_111","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_112","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_112","text":"My parents would have listened to them and tried to negotiate, but","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_113","type":"Speech","speaker":"sakura","key":"Locale_NikkeEpisode:d_nikke_sakura_02_113","text":"that's not an option available to me.","jump":null,"exit":false,"enter":null,"bg":nul