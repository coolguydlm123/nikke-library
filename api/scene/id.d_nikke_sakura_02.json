,"shown":null,"affinity":null},{"id":"d_nikke_sakura_02_121","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sakura_02_121","text":"I know how to help you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}