{"id":"d_counseling_mary_03","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 03","stage":null,"prev":"d_counseling_mary_02","next":"d_counseling_mary_04","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_03_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_1","text":"Commander, do you always try to hold onto all of your memories?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_03_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_2","text":"Even the bad ones?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_03_3","text":"Yes.","jump":"d_counseling_mary_03_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_03_4","text":"No.","jump":"d_counseling_mary_03_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_03_5","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_5","text":"You do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_6","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_6","text":"For a Commander in this day and age,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_7","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_7","text":"it would be far better to have a poor memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_8","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_8","text":"If you ever have a bad memory that just won't go away,\ncome and find me. Okay?","jump":"d_counseling_mary_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_9","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_9","text":"I'm glad to hear that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_10","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_10","text":"It's probably ideal for a Commander to not linger on their memories too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_11","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_03_11","text":"Sometimes war can give us positive memories, but most of them are traumatic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_03_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_03_12","text":"I spend some meaningful time with Mary.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}