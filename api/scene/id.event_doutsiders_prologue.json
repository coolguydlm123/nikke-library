{"id":"event_doutsiders_prologue","cat":"event","group":{"id":"ev40006","label":"D-OUTSIDERS"},"label":"Light Is Our Right","stage":null,"prev":null,"next":"event_doutsiders_01_s","speakers":{"anonymous":"Anonymous","Narration":"Narration"},"icons":{"anonymous":"si_c999_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"event_doutsiders_prologue_1","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_1","text":"All humans are equal under the light.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_2","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_2","text":"The DNA that makes up our bodies pays no mind to our class.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_3","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_3","text":"There is no reason for Outlaws to be treated any lesser than a Quotidian, or for a Quotidian to be considered inferior to a Sovereign.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_4","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_4","text":"Why is it then that we Outlaws have been condemned to suffer?","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_5","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_5","text":"Why is that we all live underground,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_6","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_6","text":"yet only we are forced to destroy ourselves from the inside while we toil in darkness?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_7","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_7","text":"Neither the Central Government, nor the Ark's citizens,","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_8","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_8","text":"have ever offered a single word of explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_9","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_9","text":"We at Heavenly Ascension must cast off these subservient attitudes that have kept us subjugated until now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_10","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_10","text":"We must take action and take what is rightfully ours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_11","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_11","text":"Once we do that, we will finally be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_12","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_prologue_12","text":"*blink blink*","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_13","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_doutsiders_prologue_13","text":"*click*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_14","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_14","text":"We have decided to turn off all the lights in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_15","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_15","text":"For in the darkness, everyone is equal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_doutsiders_prologue_16","type":"Speech","speaker":"anonymous","key":"Locale_SubScenario:event_doutsiders_prologue_16","text":"Light is our right. Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}