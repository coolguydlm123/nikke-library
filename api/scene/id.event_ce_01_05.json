":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_05_27","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_05_27","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_05_28","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_05_28","text":"It's not just projectiles. It can repel anything physical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_05_29","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_05_29","text":"Could it be some kind of magnetic field? \nEven if it is, I've never seen one this powerful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_05_30","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_05_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_05_31","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_05_31","text":"Commander, I suggest we pull back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_05_32","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_05_32","text":"Is there anything else we can try?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_05_33","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_05_33","text":"No, we'd only be putting ourselves in greater danger.","jump":null,"exit":false,"enter":null