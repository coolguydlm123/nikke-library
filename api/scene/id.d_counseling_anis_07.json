{"id":"d_counseling_anis_07","cat":"counsel","group":{"id":"char3005","label":"Anis"},"label":"Advising Anis: 07","stage":null,"prev":"d_counseling_anis_06","next":"d_counseling_anis_08","speakers":{"anis":"Anis"},"icons":{"anis":"si_c012_00_s"},"lines":[{"id":"d_counseling_anis_07_1","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_1","text":"Rapi is amazing.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis"],"affinity":"_0"},{"id":"d_counseling_anis_07_2","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_2","text":"She has suffered so much, but she's still so determined.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_3","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_3","text":"She's so different from me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_4","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_4","text":"Sometimes I just can't figure out why we were put in the same squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_07_5","text":"Your differences are what make you work well together.","jump":"d_counseling_anis_07_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_anis_07_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_07_6","text":"You have many strengths as well.","jump":"d_counseling_anis_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anis_07_7","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_7","text":"Huh! So, it because we complement each other?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_8","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_8","text":"That's good to hear!\nThanks! You've really cheered me up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_9","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_9","text":"... After all, I don't want Rapi to hate me or anything.","jump":"d_counseling_anis_07_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_10","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_10","text":"Me? That's impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_11","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_11","text":"How to put this?\nI just live my life aimlessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_12","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_07_12","text":"I have nothing to live for, but I don't want to die, either.\nI'm like some kind of zombie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_07_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_anis_07_13","text":"I listen to Anis praising Rapi in a thousand different ways.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}