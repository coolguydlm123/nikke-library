{"id":"event_coinrushshowdown1_05_s","cat":"event","group":{"id":"ev40121","label":"COIN RUSH SHOWDOWN · Part 1"},"label":"Framing the Villain: A","stage":null,"prev":"event_coinrushshowdown1_04_e","next":"event_coinrushshowdown1_05_e","speakers":{"sugar_b":"Sugar"},"icons":{"sugar_b":"si_c140_03_s"},"lines":[{"id":"event_coinrushshowdown1_05_s_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_1","text":"... I head toward the expo booths without a backward glance at the restaurant.","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall_expo","bgArt":"coinrushmainhall_expo","image":null,"bgm":"event_bgm_btg_mini_1","movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_2","text":"The latest technologies from each company are being showcased on impressive displays.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_3","text":"Still, there are fewer visitors than I thought. Coin Rush Showdown must've stolen all the spotlight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_4","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_4","text":"Well, I guess it's nice with fewer people around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_5","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_5","text":"I slowly walk around the booths.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_6","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_6","text":"Just as I expected, Elysion's booth features the latest military materials and weaponry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_7","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_7","text":"... I even see an ultra-precision missile that was equipped on the Ingrid doll.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_8","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_8","text":"The rations exhibit is also fairly noteworthy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_9","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_9","text":"Despite its small size, it's marketed as providing plenty of calories without sacrificing taste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_10","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_10","text":"One of the booth staff offers me a small sample cookie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_11","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_11","text":"The moment I take a bite, the taste of chicken fills my mouth, followed by an incredible sense of fullness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_12","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_12","text":"It's clearly suitable for consumption during surface missions, in more ways than one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_13","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_13","text":"Next, I head over to Tetra's booth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_14","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_14","text":"A wide range of apparel are on display.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_15","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_15","text":"There are jackets that look like ordinary clothing but glow brightly enough to illuminate your surroundings in the dark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_16","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_16","text":"There's a protective fabric that's waterproof, stain-resistant, and even tough enough to stop a knife.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_17","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_17","text":"There's also a pair of shoes that claims to withstand five minutes on boiling lava.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_18","text":"... I wonder where they even found boiling lava.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_19","text":"Most impressive of all is the edible clothing. Once exposed to heat for a set period of time, its properties change, making it safe to eat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_20","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_20","text":"As for the taste... it's edible at best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_21","text":"All of these may look like flashy fashion items at first, but a closer look reveals they're clothes designed for survival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_22","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_22","text":"Finally, I walk over to Missilis's booth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_23","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_23","text":"Their wearable tech products are the main focus of the booth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_24","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_24","text":"Among them are pieces that enhances physical abilities when worn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_25","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_25","text":"People who appear to be staff members, dressed in wearable tech, demonstrate a series of jaw-dropping physical feats.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_26","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_26","text":"... Did that person just bend a steel plate with their bare hands?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_27","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_27","text":"While some of the wearable tech simply boosts physical strength, others appear to enhance vision or reflexes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_28","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_28","text":"Looks like Missilis is reinforcing its identity as a manufacturer dedicated to creating superhumans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_30","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_30","text":"I've pretty much seen everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_31","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_31","text":"I always seem to get through an expo faster than expected when I'm here alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_32","text":"Just as I'm about to make my way back to the restaurant, hoping things have calmed down by now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_33","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_33","text":"I spot a group of people acting out of the ordinary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_34","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_34","text":"They're Coin Rush security guards...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_35","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_35","text":"And they're communicating with their earpieces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_36","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_36","text":"I figure it's just a routine check-in, but something feels off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_37","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_37","text":"They're standing in one place, and their conversation is going on for far too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_38","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_38","text":"The guards stationed near the Elysion, Missilis, and Tetra booths have been conferring for a while now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_39","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_39","text":"This usually means that something's gone wrong...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_40","text":"*Click*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_41","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_41","text":"I hear a familiar metallic click, followed by something hard pressing against my waist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_42","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_42","text":"I slowly put my hands up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_43","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_43","text":"You look suspiciously good-looking. State your affiliation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_menu_realkindness","movie":null,"shown":["sugar_b"],"affinity":null},{"id":"event_coinrushshowdown1_05_s_44","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_44","text":"I'm a Scavenger with Cafe Sweety.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_45","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_45","text":"One of us, huh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_46","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_46","text":"But I'm not convinced. What's the password?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_47","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_47","text":"Sugar coffee is the best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_48","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_48","text":"What's the sugar-to-coffee ratio?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_49","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_49","text":"Seven parts sugar to three parts coffee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_50","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_50","text":"Perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_51","text":"She removes the hard object that was pressing against my waist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_52","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_52","text":"You look like you have a lot of free time on your hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_53","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_53","text":"Yup. I do. Plus, I'm really bored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_54","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_54","text":"With the competition on hold, there's nothing for me to do. So here I am, roaming around and messing with people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_55","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_55","text":"How'd you find the competition? Did you enjoy it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_56","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_56","text":"There are bunny girls everywhere. Bet you're enjoying yourself, huh, Partner?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_57","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_57","text":"I mean... I won't deny it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_58","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown1_05_s_58","text":"Seems like your team isn't exactly well-liked, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown1_05_s_59","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown1_05_s_59","text":"Can't deny that, too.","jump":null,"exit":false,"