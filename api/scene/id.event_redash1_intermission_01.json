event_redash1_intermission_01_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_redash1_intermission_01_23","text":"Everyone stands in stunned silence.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_redash1_intermission_01_24","text":"Before them lies a grotesque aberration that looks like a hodgepodge of a Rapture and Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_trauma","movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_25","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_intermission_01_25","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_26","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash1_intermission_01_26","text":"Whatever it is, it's enough to make one's blood run cold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_27","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash1_intermission_01_27","text":"My God...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_28","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_28","text":"Did they implant a Nikke with Rapture parts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_29","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_29","text":"Look here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_30","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_31","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_31","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_32","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_32","text":"They've been... fused together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_33","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_33","text":"Is she still alive?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_34","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_intermission_01_34","text":"No. She's dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_35","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_intermission_01_35","text":"No signs of trauma. She must have died of shock.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_36","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_intermission_01_36","text":"The only thing is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_37","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_redash1_intermission_01_37","text":"*Thud*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_redash1_intermission_01_38","text":"Liliweiss places her hand on the aberration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_39","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_redash1_intermission_01_39","text":"*Zing*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_redash1_intermission_01_40","text":"The Rapture's core moves frenetically as if scanning the area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_41","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_41","text":"... It's still alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_42","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_42","text":"Only the Rapture portions, to be precise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_43","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_43","text":"That means...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_44","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_intermission_01_44","text":"Yes. We're not sure as to how or when, but at some point, experiments were carried out where a Rapture and Nikke were fused together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_45","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_intermission_01_45","text":"I believe the shock brought along by the fusion process is what killed the Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_46","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_redash1_intermission_01_46","text":"I think it's safe to say that this process was initiated by the Rapture side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_47","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash1_intermission_01_47","text":"The Raptures are up to no good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_48","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash1_intermission_01_48","text":"First the corruption phenomenon, and now this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_49","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_49","text":"I'll report this to V.T.C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_50","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash1_intermission_01_50","text":"I'll also notify my superior.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_51","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_intermission_01_51","text":"Are we going to leave it like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_52","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash1_intermission_01_52","text":"Yes. It's noteworthy that the Rapture portion is still alive and operational.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_53","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash1_intermission_01_53","text":"It will help with the research.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_54","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_redash1_intermission_01_54","text":"We'll stay here and safeguard it until the higher-ups come to retrieve 