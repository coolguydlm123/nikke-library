false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_68","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_68","text":"The recent behavior of Raptures. Strange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_69","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_69","text":"You feel that way too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_70","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_70","text":"Don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_71","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_71","text":"Yes. First the corruption, now this ungodly fusion process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_72","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_72","text":"As far as I can see, there's no reason why a Rapture would want, or need, to do something like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_73","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_73","text":"If we're being brutally honest, the Raptures are superior beings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_74","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_74","text":"They can afford not to change anything. \nSimply focus on attacking us and soon, they'll enjoy an easy victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_75","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_75","text":"So why would they bother with all this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_76","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_76","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_77","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_77","text":"Tell me what you're thinking, Rapunzel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_78","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_78","text":"They're playing with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_79","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_80","type":"Speech","speaker":"rapunzel_o","key":"Locale_MainScenario:event_redash1_intermission_01_80","text":"It's like a cat toying with a mouse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_81","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_redash1_intermission_01_81","text":"Agreed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_82","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash1_intermission_01_82","text":"In their eyes, we're not even worthy of their full attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_83","type":"Speech","speaker":"hongryeon_o","key":"Locale_MainScenario:event_redash1_intermission_01_83","text":"In matters of war, such hubris usually leads to one's downfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_84","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_intermission_01_84","text":"Well, I say let's be the ones to initiate that downfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_85","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash1_intermission_01_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_86","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_intermission_01_86","text":"Kid. What are you working on over there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_87","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash1_intermission_01_87","text":"Oh, this? To prepare for us being isolated like before, I made some simulations to pass the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_88","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_intermission_01_88","text":"Like a video game?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_89","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_intermission_01_89","text":"You made an entire game that quickly? Let me play one round.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_90","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash1_intermission_01_90","text":"It's a simulation, not a game.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_91","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_redash1_intermission_01_91","text":"Any chance you could put some of my music in as background music?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_redash1_intermission_01_92","type":"Speech","speaker":"snowwhite_o","key":"Locale_MainScenario:event_redash1_intermission_01_92","tex