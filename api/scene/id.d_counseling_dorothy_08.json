{"id":"d_counseling_dorothy_08","cat":"counsel","group":{"id":"char5061","label":"Dorothy"},"label":"Advising Dorothy: 08","stage":null,"prev":"d_counseling_dorothy_07","next":"d_counseling_dorothy_09","speakers":{"dorothy":"Dorothy"},"icons":{"dorothy":"si_c233_00_s"},"lines":[{"id":"d_counseling_dorothy_08_1","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_1","text":"I heard you're known as Mankind's Hope in the Ark.","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"bgm_story_edenin","movie":null,"shown":["dorothy"],"affinity":"_0"},{"id":"d_counseling_dorothy_08_2","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_2","text":"How does it feel to carry the hopes of everyone in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_08_3","text":"It feels like a heavy burden.","jump":"d_counseling_dorothy_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_dorothy_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_08_4","text":"It's motivating.","jump":"d_counseling_dorothy_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_dorothy_08_5","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_5","text":"I can imagine it weighs heavily on you. And yet, you're persevering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_08_6","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_6","text":"But remember, with the weight of hope comes the burden of revenge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_08_7","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_7","text":"If someone betrays you, you must repay the same weight of betrayal.","jump":"d_counseling_dorothy_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_08_8","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_8","text":"I see, your optimism is just... admirable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_08_9","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_9","text":"But don't let it get to your head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_08_10","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_08_10","text":"Remember, the opposite of hope is betrayal.","jump":"d_counseling_dorothy_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_08_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_08_11","text":"I have a sincere conversation with Dorothy.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}