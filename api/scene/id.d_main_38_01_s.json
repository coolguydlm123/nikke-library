{"id":"d_main_38_01_s","cat":"main","group":{"id":"ch38","label":"Chapter 38 · Gluttony"},"label":"Faith and Glory: A","stage":"38-3 STAGE · Start","prev":null,"next":"d_main_38_01_e","speakers":{"helm":"Helm","maxwell":"Maxwell","rapi_red":"Rapi","anchor":"Anchor","mast":"Mast","laplace_op":"Laplace","drake_op":"Drake"},"icons":{"helm":"si_c352_00_s","maxwell":"si_c102_00_s","rapi_red":"si_c016_00_s","anchor":"si_c351_00_s","mast":"si_c350_00_s","laplace_op":"si_c100_00_s","drake_op":"si_c101_00_s"},"lines":[{"id":"d_main_38_01_s_1","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_1","text":"While it admittedly wasn't the most detailed examination, the results don't show any abnormalities.","jump":null,"exit":false,"enter":null,"bg":"EzsUp","bgArt":"ezsup","image":null,"bgm":"bgm_chapter38_field_goldentree","movie":null,"shown":["maxwell","rapi_red","helm","mast","anchor"],"affinity":null},{"id":"d_main_38_01_s_2","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_2","text":"Not even so much as a scar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_38_01_s_3","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_4","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_4","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_5","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_5","text":"At the start of the examination, there was a subtly visible wound from where Leviathan stabbed you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_6","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_6","text":"but it disappeared entirely by the time we were finished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_7","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_7","text":"If it weren't for the hole in your clothes, there'd be virtually no way of knowing you'd ever been attacked in the first place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_8","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_8","text":"... What's going on here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_9","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_9","text":"It's as if you've become something other than human, Cutey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_38_01_s_10","text":"I'm just as baffled as you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_11","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_11","text":"When did you start noticing this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_12","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_12","text":"I always thought your wounds healed unusually fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_13","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_13","text":"Even when you broke a bone, it would mend in no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_14","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_14","text":"Not only that, you were able to lift a fully-equipped combat Nikke without any help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_15","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_15","text":"And lest we forget that time when you fired an anti-ship rifle on your own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_16","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_16","text":"And what's your takeaway from all that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_17","text":"That's totally amazing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_18","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_19","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_19","text":"Especially when I got a peek at his abs while checking out his wound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_20","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_20","text":"*Sigh*... So nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_38_01_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_22","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_22","text":"But this is the first time I've seen wounds heal right in front of my eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_23","text":"There are no recorded cases of humans ever being capable of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_24","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_24","text":"Well, in our case, it's certainly helpful that he can heal so quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_25","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_25","text":"Cutey, you and I can talk more about it once we're finished with the mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_38_01_s_26","text":"You don't want to talk. All you want to do is conduct more experiments on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_27","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_27","text":"Oh, come now, aren't they one and the same?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_28","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_38_01_s_28","text":"You're like a sea cucumber, Captain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_29","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_38_01_s_29","text":"Sea cucumbers heal super fast too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_30","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_38_01_s_30","text":"Have you been drinking a lot of rum lately?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_31","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_38_01_s_31","text":"Rum can be great for healing wounds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_32","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_32","text":"Don't be ridiculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_33","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_38_01_s_33","text":"I'm serious! In movies, people are always pouring rum on their wounds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_34","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_38_01_s_34","text":"That must mean it's effective for treating wounds instantly, ergo, raising the rum content in your body would improve your healing abilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_35","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_38_01_s_35","text":"To put it simply, rum is good for recovery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_36","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_38_01_s_36","text":"Seems like sound logic to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_37","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_37","text":"You've got a real warped sense of logic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_39","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_39","text":"This ability is definitely advantageous, but like most things, it must come at a cost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_40","text":"I still think it would be best to avoid any injuries as much as possible, especially those involving blood loss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_41","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_41","text":"That may be easier said than done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_42","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_42","text":"Leviathan seems significantly weakened, but we can't say the same for that Ziz character.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_43","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_43","text":"She can fly, and pretty well at that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_44","text":"Not just well. She's a master of the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_45","text":"She was able to scoop us all up and soar to high altitudes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_46","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_46","text":"Unfortunately, the Admire's anti-aircraft guns aren't enough to take her down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_47","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_47","text":"She's just too small and fast a target.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_48","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_48","text":"But she wasn't completely immune to damage either. We can still give her a hard time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_49","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_49","text":"The moment Ziz is airborne, we can launch a barrage. Even if all we can do is hinder her movements, it'll still be a big help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_50","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_50","text":"Okay. Leave it to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_51","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_51","text":"The real problem is that Behemoth egg or whatever the heck it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_52","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_52","text":"Hold on... Everyone, wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_53","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_53","text":"Laplace. Drake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_54","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_54","text":"Hero Laplace, reading you loud and clear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["laplace_op"],"affinity":null},{"id":"d_main_38_01_s_55","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_55","text":"And Drake?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_56","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_56","text":"She's here as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_57","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_58","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_58","text":"How come she didn't answer herself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_59","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_59","text":"Er... That's a secret, I'm afraid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_60","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_60","text":"What is she doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_61","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_62","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_62","text":"If you don't answer, you can kiss your power upgrade goodbye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_63","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_63","text":"... She's using the electricity to grill some Nutrium.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_64","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_65","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_65","text":"And she's taking her time with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_66","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_66","text":"... Whatever. Do as you wish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_67","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_67","text":"Anything to report?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_68","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_68","text":"Drake's pretty upset because she forgot to bring seasoning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_69","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_69","text":"I'm talking about the egg!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_70","type":"Speech","speaker":"laplace_op","key":"Locale_MainScenario:d_main_38_01_s_70","text":"Oh, right. No, nothing unusual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_71","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_71","text":"... Okay. Enjoy your meat, I suppose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_72","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_72","text":"If I don't check in on them once in a while, there's no telling what they'll get up to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_73","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_73","text":"They're a real handful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_74","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_74","text":"Anyway, back to the topic at hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_75","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_75","text":"About Behemoth's egg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_76","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_76","text":"I think we need to open it up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_77","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_77","text":"Right now, we've got a Heretic inside that thing which is regenerating, i.e. being manufactured before our very eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_78","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_78","text":"If we bust that egg open, won't we be able to uncover the secrets behind how Heretics are created?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_79","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_79","text":"Our primary goal is still to try and negotiate with the Four Beasts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_80","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_80","text":"That egg is our only bargaining chip. We can't afford to destroy it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_81","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_81","text":"They don't seem terribly interested in talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_82","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_82","text":"Perhaps, but if we open up that egg, we'll destroy any potential chance we had of negotiating with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_83","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_83","text":"Instead of talking, they'll fight us to the death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_84","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_84","text":"How do you plan on negotiating with them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_85","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_85","text":"We'll have to get rough with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_86","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_86","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_87","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_87","text":"If using force is what it'll take to get them to come to the negotiation table, then so be it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_88","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_88","text":"Since when did you become so extreme with your methods?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_89","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_89","text":"I was holding myself back before. Not anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_90","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_90","text":"I don't necessarily have any objections,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_91","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_91","text":"but you do need to think carefully about this, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_92","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_92","text":"This isn't like it was with Marian. The Four Beasts are hostile Heretics, something which we don't know much about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_93","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_93","text":"Capturing them could be of great benefit to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_94","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_94","text":"For Missilis, you mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_95","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_95","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_96","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_96","text":"Or, to be more accurate, Syuen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_97","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_97","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_98","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_98","text":"Maxwell. I understand that you care about Syuen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_99","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_99","text":"But if we can strike a deal with the Four Beasts, or even potentially form some sort of alliance with them,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_100","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_100","text":"we stand to gain so much more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_101","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_101","text":"How can we be certain they'll be willing to do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_102","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_102","text":"Even if Syuen mends her reputation, that doesn't guarantee that she'll return to normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_103","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_103","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_104","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_104","text":"*Sigh*... You always do make valid points that are hard to refute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_105","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_105","text":"You're right. I wanted to give Syuen an opportunity to make a name for herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_106","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_106","text":"I felt the right thing to do was to seize any opportunity that came by, even if it meant going over the line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_107","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_107","text":"May I say something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_108","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_108","text":"... Go ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_109","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_109","text":"I personally think you shouldn't chase after approval from others recklessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_110","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_110","text":"If you want to talk about tarnished reputations, the Aegis Squad is in dire need of help, more than anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_111","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_111","text":"But despite that, we've never gone over the line, no matter how much humiliation we've endured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_112","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_112","text":"There are many ways in which we could take things further,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_113","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_113","text":"but Miss Ingrid, Deputy Commander Burningum, and even I all felt we would lose something if we did that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_114","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_114","text":"Our pride. Our conviction. The things that make us who we are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_115","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_115","text":"Things that, once lost, could never be regained.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_116","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_116","text":"We've been able to hone ourselves without losing any of those things. Whenever an opportunity comes our way, we'll be ready for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_117","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_117","text":"I truly do believe this is the best choice, the only choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_118","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_118","text":"The Maxwell I know is one of the most rational and level-headed Nikkes out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_119","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_119","text":"So I hope you don't choose a path that compromises your values.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_120","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_120","text":"Instead, rely on your unparalleled strength, as you always have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_121","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_38_01_s_121","text":"Succeed in a way that's worth the Matis name.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_122","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_38_01_s_122","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_123","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_123","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_124","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_124","text":"Sorry. I misspoke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_125","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_125","text":"You're right. We will do it our way. The right way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_126","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_126","text":"I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_127","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_38_01_s_127","text":"Ahh, the surface is fantastic! Brimming with passion and adventure!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_128","type":"Speech","speaker":"drake_op","key":"Locale_MainScenario:d_main_38_01_s_128","text":"We've got a problem!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["drake_op"],"affinity":null},{"id":"d_main_38_01_s_129","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_129","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_130","type":"Speech","speaker":"drake_op","key":"Locale_MainScenario:d_main_38_01_s_130","text":"I burned all the Nutrium! That stuff wasn't cheap, either!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_01_s_131","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_38_01_s_131","text":"If you're so intent on grilling something, there should be plenty of wood lying around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}