"key":"Locale_SubScenario:event_ce003_1_03_s_74","text":"Ram, Emilia, and Rem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_75","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce003_1_03_s_75","text":"We trust that you'll win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_76","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_03_s_76","text":"The application has been submitted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_77","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce003_1_03_s_77","text":"Now we just have to wait until the day of the competition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_78","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_03_s_78","text":"May I ask where the kitchen is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_79","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_03_s_79","text":"It's inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_80","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_03_s_80","text":"May I use it for a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_81","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_03_s_81","text":"You've done so much to help us, and so I want to make you something to thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_82","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_03_s_82","text":"I also want to do some practice before the competition, so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_83","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_03_s_83","text":"You don't have to do all that for us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_84","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce003_1_03_s_84","text":"Oooh! Extraterrestrial cuisine!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_85","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_ce003_1_03_s_85","text":"This is a one-of-a-kind opportunity, Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_86","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce003_1_03_s_86","text":"We barely use the kitchen anyway, so we might as well let them borrow it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_87","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce003_1_03_s_87","text":"It won't hurt anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_88","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_03_s_88","text":"It's a bit unusual to have your guests serving you food, but okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_89","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_03_s_89","text":"The kitchen is all yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_90","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_03_s_90","text":"Thanks, I'll see what I can whip up. My food is gonna be so good, it'll make you see stars.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_91","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_03_s_91","text":"You stay right here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_92","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_03_s_92","text":"Emilia scoots off into the kitchen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_93","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_03_s_93","text":"Go knock 'em dead, Rem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_94","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_03_s_94","text":"Okay. Ram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_95","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_03_s_95","text":"I'm going to help Miss Emilia then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_03_s_96","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_03_s_96","text":"Rem follows after Emilia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}