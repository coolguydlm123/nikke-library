rfectly fine and intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_02_28","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_02_28","text":"Tell me Pascal, what exactly are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_02_29","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_02_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_02_30","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_02_30","text":"The moment I woke up in this place, I felt an unnerving sense of disharmony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_02_31","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_02_31","text":"Now, after speaking with you, I am sure of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_02_32","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_02_32","text":"I am no longer in the world I used to inhabit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_02_33","type":"Speech","speaker":"ce_02_03","key":"Locale_NikkeEpisode:d_nikke_ce_02_03_02_33","text":"This is a completely different world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce_02_03_02_34","type":"Speech","spe