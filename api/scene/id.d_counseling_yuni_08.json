{"id":"d_counseling_yuni_08","cat":"counsel","group":{"id":"char5006","label":"Yuni"},"label":"Advising Yuni: 08","stage":null,"prev":"d_counseling_yuni_07","next":"d_counseling_yuni_09","speakers":{"yuni":"Yuni"},"icons":{"yuni":"si_c160_00_s"},"lines":[{"id":"d_counseling_yuni_08_1","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_08_1","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["yuni"],"affinity":"_0"},{"id":"d_counseling_yuni_08_2","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_08_2","text":"How would you feel if someone suddenly hit you, out of the blue?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_08_3","text":"One-sided violence is never good.","jump":"d_counseling_yuni_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_yuni_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_08_4","text":"I would want to retaliate.","jump":"d_counseling_yuni_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_yuni_08_5","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_08_5","text":"Yes, I feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_08_6","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_08_6","text":"There needs to be mutual consent when it comes to these things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_08_7","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_08_7","text":"Speaking of, would you... consent to that kind of arrangement?","jump":"d_counseling_yuni_08_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_08_8","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_08_8","text":"Ha ha! I see you're the type who doesn't like to lose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_08_9","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_08_9","text":"But, surely there's a better option than just retaliation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_08_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_08_10","text":"Yuni and I explore the philosophy behind hitting others.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}