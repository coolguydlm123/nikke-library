hem, you can forget it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_5_e_80","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:d_main_26_5_e_80","text":"I'm not the person I used to be. I'm just someone brought back to the present.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_5_e_81","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_5_e_81","text":"That's your prerogative too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_5_e_82","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_5_e_82","text":"You can choose what type of person you want to be: someone who remains a remnant of the past, or someone who lives on in the present.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_5_e_83","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:d_main_26_5_e_83","text":"Then I would choose to remain in the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_5_e_84","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_26_5_e_84","text":"Don't be too hasty in making a decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_5_e_85","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:d_main_26_5_e_85","text":"Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26_5_e_86","type":"Speech","speaker":"re