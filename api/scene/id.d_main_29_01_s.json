{"id":"d_main_29_01_s","cat":"main","group":{"id":"ch29","label":"Chapter 29 · Rescue"},"label":"Companions Left Behind: A","stage":"29-3 STAGE · Start","prev":null,"next":"d_main_29_01_e","speakers":{"rapi":"Rapi","anis":"Anis","neon":"Neon","drilley":"Drilley","fragile":"Fragile","trony_op_r":"Trony","shifty":"Shifty"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","drilley":"si_c491_00_s","fragile":"si_c481_00_s","trony_op_r":"si_c501_00_s","shifty":"si_c907_00_s"},"lines":[{"id":"d_main_29_01_s_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_s_1","text":"Descent completed.","jump":null,"exit":false,"enter":null,"bg":"Drain","bgArt":"drain","image":null,"bgm":"bgm_chapter29_field_drifting","movie":null,"shown":["rapi","neon","anis","drilley","fragile"],"affinity":null},{"id":"d_main_29_01_s_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_s_2","text":"Is everyone okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_3","text":"Not a scratch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_4","text":"A few singed hairs, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_5","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_5","text":"All good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_6","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_s_6","text":"I'm a bit sore from the impact,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_7","type":"Speech","speaker":"fragile","key":"Locale_MainScenario:d_main_29_01_s_7","text":"and my clothes are torn in a couple of places, but no physical damage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_8","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_29_01_s_8","text":"I'm also unharmed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["trony_op_r","shifty"],"affinity":null},{"id":"d_main_29_01_s_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_9","text":"Well duh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_10","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_10","text":"Good news. From here on out, it's a straight corridor with a slight slope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_11","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_11","text":"Just continue straight ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_12","text":"So we're just gonna abseil straight down this thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_13","text":"Good grief... I never thought we'd be resorting to such foolhardy methods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_14","text":"... Having said that, it worked out quite nicely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_s_15","text":"It shouldn't be a problem for us Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_16","text":"But Master is human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_17","text":"That's why Rapi's been grasping onto the Commander like grim death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_s_18","text":"No, she hasn't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_s_19","text":"But you have been grabbing onto me rather tightly, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_s_21","text":"Anyways, how far do we have to walk along this path?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["trony_op_r","shifty"],"affinity":null},{"id":"d_main_29_01_s_22","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_22","text":"Hard to say. It's difficult to confirm much of anything with these scans I'm getting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_23","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_29_01_s_23","text":"How do these scans you're doing work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_24","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_24","text":"The Commander's operation device has a display which converts into a 3D map.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_25","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_25","text":"Once you use AI to make some corrections, the accuracy is remarkable for the terrain and large objects like buildings, but it somewhat lacking when it comes to smaller objects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_26","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_26","text":"Also, no matter how accurate the scans are, we won't be able to predict any unanticipated events that may occur.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_27","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_29_01_s_27","text":"The camera on that operation device must be top-notch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_28","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_28","text":"Yes. The equipment we use at Elysion is quite high-end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_29","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_29_01_s_29","text":"I see. I'll make a note of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_30","type":"Speech","speaker":"trony_op_r","key":"Locale_MainScenario:d_main_29_01_s_30","text":"It must be rather costly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_31","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_31","text":"That it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_32","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_32","text":"In fact, we have a saying around the office that the operation device is worth more than the Comm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_33","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_33","text":"Um... never mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_29_01_s_34","text":"I'll try my best to make myself more valuable than the operation device.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_35","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_29_01_s_35","text":"N-no, that's not what I was going to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_36","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_36","text":"Let's just hurry and get a move on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_37","text":"Have you got ants in your pants or something? We're already on the move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_38","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_38","text":"I'm simply saying that we should do less talking and more walking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_39","text":"That's literally exactly what we're doing. Walking and talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_40","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_40","text":"If we cut the chatter, we can walk faster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_41","text":"You make it sound like you're the only one putting in effort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_42","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_42","text":"What did you just say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_43","text":"You're not the only one breaking a sweat here. We're also going as fast as we can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_44","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_44","text":"I hardly think you put your best foot forward when half your team didn't manage to make it back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_45","text":"It's not like we abandoned them on purpose,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_46","text":"you dolt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_47","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_47","text":"Are you sure about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_48","text":"The way you talk, you'd have us jump headfirst into that elevator without any equipment on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_49","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_49","text":"If you really cared about your colleagues, you would have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_50","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_50","text":"Fine then, you do it. Go ahead and dive headlong into that shaft. I'm sure you'll be able to save them all by yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_51","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_51","text":"While you all are sitting here talking and preparing, something could go terribly wrong for your friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_52","text":"That's why we're being as quick as we can and moving out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_53","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_53","text":"Something even worse could happen if we're caught off guard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_54","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_54","text":"So get off our backs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_55","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_55","text":"We're caught between a rock and a hard place here, and the last thing we need is you on our case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_56","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_57","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_57","text":"If it were me, I would have jumped down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_58","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_58","text":"Fine. Good to know. Next time this happens, you're more than welcome to go first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_59","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_29_01_s_59","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_60","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_60","text":"What? This chick is grinding my gears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_61","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_61","text":"She needs to take a chill pill. She's paranoid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_62","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_62","text":"I'm not paranoid. I'm merely stating facts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_63","text":"What the hell are you insinuating?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_64","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_64","text":"You can't deny it doesn't add up. The three newcomers go missing, and meanwhile you all show up unscathed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_65","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_29_01_s_65","text":"What, you want a murder confession? Fine! We're all a bunch of killers who lured three legendary Nikkes to their deaths! Are you satisfied?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_66","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_66","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_67","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_67","text":"Drilley... hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_68","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_68","text":"What in the world are you laughing at?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_69","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_69","text":"Oh, sorry. It's just... your name is so... and then your squadmate is Hammering... hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_70","type":"Speech","speaker":"drilley","key":"Locale_MainScenario:d_main_29_01_s_70","text":"Are you kidding me? You're choosing now, of all times, to poke fun at my name?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_71","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_71","text":"Sorry. Anyways...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_72","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_72","text":"Hammering saved us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_29_01_s_73","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_29_01_s_73","text":"She noticed the giant crystal was 