cenario:d_main_27_05_13","text":"My \"motivation\" consists of avoiding the worst-case scenario, so I'd say it's closer to desperation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_14","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_05_14","text":"Elegg, on the other hand, is driven by the pursuit of knowledge, so it's a bit different for her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_05_15","text":"Personally, I don't think desperation is necessarily a bad thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_16","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_05_16","text":"True. When you're between a rock and a hard place, you tend to push yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_27_05_17","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_05_18","text":"That's why we're coming along. To make sure no one stretches themselves too thin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_19","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_05_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_20","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_05_20","text":"You're all far too kind to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_05_21","text":"There's a time and a place for self-deprecation, and I don't think this is one of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_22","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_05_22","text":"Hehe, I've been that way my entire life. It's the only way I know how to communicate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_23","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_05_23","text":"Were you like that when you were human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_24","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_05_24","text":"I don't remember, but most likely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_25","type":"Speech","speaker":"liveryn","key":"Locale_MainScenario:d_main_27_05_25","text":"People don't change. Not really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_05_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_27_05_26","text":"If you really feel that way, I guess I won't be able to change your mind...","jump":null,"exit":fal