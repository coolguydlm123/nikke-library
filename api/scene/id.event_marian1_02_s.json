-102","key":"Locale_MainScenario:event_marian1_02_s_32","text":"Saying that to myself makes it much easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_33","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_33","text":"So right now... I kind of think...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_34","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_34","text":"dying isn't so bad, actually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_35","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_35","text":"Maria...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_36","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_36","text":"... Come on, Doctor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_37","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_37","text":"Use me for the purpose I was made for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_38","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_38","text":"Otherwise, we won't make any progress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_39","type":"Speech","speake