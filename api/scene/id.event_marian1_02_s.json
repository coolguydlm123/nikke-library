{"id":"event_marian1_02_s","cat":"event","group":{"id":"ev40124","label":"MARIA-n · Part 1"},"label":"Expendable: A","stage":null,"prev":"event_marian1_01_e","next":"event_marian1_02_e","speakers":{"maria-102":"Maria-102","doctormaria_op_l":"Doctor Maria","maria-105":"Maria-105","maria-113":"Maria-113","maria-202":"Maria-202"},"icons":{"maria-102":"si_c013_00_s","doctormaria_op_l":"si_c9041_00_s","maria-105":"si_c013_00_s","maria-113":"si_c013_00_s","maria-202":"si_c013_00_s"},"lines":[{"id":"event_marian1_02_s_1","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_1","text":"... Lord-class spotted.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":"event_bgm_maria-n_102-202","movie":null,"shown":["maria-102","doctormaria_op_l"],"affinity":null},{"id":"event_marian1_02_s_2","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_2","text":"It doesn't seem to ever leave this area. Ever since 73, I keep seeing it here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_3","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_3","text":"You keep having to take the long way around because of that thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_4","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_5","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_5","text":"... 102, don't get any ideas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":nul