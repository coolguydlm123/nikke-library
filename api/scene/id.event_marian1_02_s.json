"speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_12","text":"Repeat that enough times,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_13","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_13","text":"and we'll eventually win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_14","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_15","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_15","text":"You're treating your life as if it's expendable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_16","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_16","text":"Is there any reason why I shouldn't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_17","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_17","text":"Even if I die, I'll just be rebuilt with all my memories intact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_18","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_18","text":"Death carries no risk at all for—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_19","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_19","text":"You still feel the pain of dying!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_20","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_02_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_21","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_21","text":"You... you were built unable to shut off your pain sensors! All so we could collect data!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_22","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_22","text":"When a Rapture crushes your torso, or a bullet goes through your head...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_23","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_23","text":"When you're caught in a blast, or you burn in flames, or you're seared by electricity...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_24","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_02_s_24","text":"I'm sure you feel every last bit of it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_02_s_25","type":"Speech","speaker":"maria-102","key":"Locale_MainScenario:event_marian1_