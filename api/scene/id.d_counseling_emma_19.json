{"id":"d_counseling_emma_19","cat":"counsel","group":{"id":"char5005","label":"Emma"},"label":"Advising Emma: 19","stage":null,"prev":"d_counseling_emma_18","next":"d_counseling_emma_20","speakers":{"emma":"Emma"},"icons":{"emma":"si_c090_00_s"},"lines":[{"id":"d_counseling_emma_19_1","type":"Speech","speaker":"emma","key":"Locale_Counseling:d_counseling_emma_19_1","text":"Not to brag, but I'm really good at reading people.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["emma"],"affinity":"_0"},{"id":"d_counseling_emma_19_2","type":"Speech","speaker":"emma","key":"Locale_Counseling:d_counseling_emma_19_2","text":"I can tell how someone is feeling just by observing their facial expressions, their body movements, and even their breathing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_emma_19_3","type":"Speech","speaker":"emma","key":"Locale_Counseling:d_counseling_emma_19_3","text":"However, that means there are times I pick up on things I'd rather not know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_emma_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_emma_19_4","text":"That's a good skill to have.","jump":"d_counseling_emma_19_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_emma_19_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_emma_19_5","text":"Just close your eyes and ignore it when that happens.","jump":"d_counseling_emma_19_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_emma_19_6","type":"Speech","speaker":"emma","key":"