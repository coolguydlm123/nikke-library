{"id":"d_main_22_07","cat":"main","group":{"id":"ch22","label":"Chapter 22 · Invasion"},"label":"Sakura's Task","stage":"22-21 STAGE · Start","prev":"d_main_22_06","next":"d_main_22_08","speakers":{"dolla":"Dolla","sakura":"Sakura"},"icons":{"dolla":"si_c202_00_s","sakura":"si_c282_00_s"},"lines":[{"id":"d_main_22_07_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_07_1","text":"3 hours prior to the incident. Seimeikai drawing room.","jump":null,"exit":false,"enter":null,"bg":"TatamiRoom","bgArt":"tatamiroom","image":null,"bgm":"bgm_mystery","movie":null,"shown":["sakura","dolla"],"affinity":null},{"id":"d_main_22_07_2","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_2","text":"We've noticed a large number of previously unregistered firearms and bullets being sold through the Dark Net.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_3","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_3","text":"How many?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_4","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_4","text":"About 200 rifles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_5","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_5","text":"That many? That is peculiar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_6","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_6","text":"You know what's even more strange?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_7","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_7","text":"All the guns sold are meant for Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_8","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_8","text":"For Nikkes...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_9","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_9","text":"They have lighter recoil and increased durability.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_10","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_10","text":"While a human could technically use it if they wanted to, it'd be far from comfortable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_11","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_11","text":"In other words, not the kind of weapons that would be used for a terrorist attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_12","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_12","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_13","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_13","text":"Can we find out who purchased them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_14","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_14","text":"I'm afraid not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_15","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_15","text":"As for the jewels of the necklace you said they would be selling,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_16","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_16","text":"it's simply too wide a net to cast. They're impossible to track down. The Dark Net is just too vast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_17","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_17","text":"If I were to guess, I'd say that it likely found its way into Heavenly Ascension's hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_18","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_18","text":"It's very probable, but I can't say for certain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_19","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_19","text":"Anything else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_20","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_20","text":"There is one more thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_21","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_21","text":"A massive bomb that didn't have any buyers for the longest time recently got sold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_22","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_22","text":"The purchase date coincides with when the Nikke firearms were sold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_23","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_23","text":"You said it's a heavy-duty explosive?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_24","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_24","text":"Yes, but what's particularly interesting is what it's designed for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_25","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_25","text":"It's an excavation bomb.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_26","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_26","text":"The Ark is already completed, and with the construction of the Outpost on pause, this bomb is virtually useless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_27","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_27","text":"You can't even use it against Raptures, since its explosive output is concentrated on what is directly underneath it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_28","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_28","text":"I can't imagine what they'd possibly want it for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_29","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_29","text":"You really can find everything on the Dark Net.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_30","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_30","text":"Just about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_31","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_31","text":"If you've got the money, you can find whatever you're looking for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_32","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_32","text":"None of the sellers have any compunction about selling to terrorists or anyone else intent on using the merchandise for shady purposes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_33","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_33","text":"This probably sounds strange coming from me, but that really sounds like a cesspool of bad eggs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_34","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_34","text":"That's what makes it so fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_35","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_35","text":"I doubt excavation bombs could be used for a terror attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_36","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_36","text":"You'd think so, but it looks like Heavenly Ascension bought it anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_37","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_37","text":"There must have been a reason...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_38","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_38","text":"I do have one question, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_39","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_39","text":"I understand that you're associated with the merchant squad, but how do you know so much about how the Dark Net works?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_40","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_40","text":"It's a hobby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_41","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_41","text":"... A hobby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_42","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_42","text":"Sure. I get a lot of enjoyment out of monitoring dangerous items.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_43","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_43","text":"Safety first, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_44","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_44","text":"A smart person only takes risks when they have a way out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_45","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_45","text":"So please, don't for a minute think that we're on the same side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_46","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_46","text":"Hehe. I see you're a rather extraordinary individual. My apologies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_47","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_47","text":"Thanks for the info. This is typically something we'd handle in-house,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_48","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_48","text":"but apparently we don't measure up to someone who engages in this recreationally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_49","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_49","text":"Thank you for the compliment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_50","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_50","text":"Of course, it benefits me to have Seimeikai in my debt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_51","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_51","text":"I won't forget about today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_52","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_52","text":"Remember, you're always welcome to our help if you need any.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_53","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_53","text":"Oh trust me, I won't forget.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_54","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_54","text":"My employees will show you out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_55","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_55","text":"I look forward to our next meeting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_56","type":"Speech","speaker":"dolla","key":"Locale_MainScenario:d_main_22_07_56","text":"See you around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_07_57","text":"Several Seimeikai employees see Dolla out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_58","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_59","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_59","text":"None of the items they purchased are suited for a terrorist attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_60","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_60","text":"Could they be planning an attack using Nikkes?... No, that's impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_61","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_61","text":"For one thing, over 90% of Nikkes are incapable of even laying a finger on a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_62","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_62","text":"Such a plan is beyond absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_63","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_64","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_64","text":"Their primary weapon...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_65","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_65","text":"Is something not meant to be used offensively.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_07_66","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_07_66","text":"Almost as if...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}