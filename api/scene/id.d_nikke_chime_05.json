y to me.","jump":"d_nikke_chime_05_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_22","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_05_22","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_23","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_05_23","text":"Chime looks up at the sky in silence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_24","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_05_24","text":"... It seems thou dost miss her sorely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_05_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_26","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_05_26","text":"Is there some reason keeping thee from meeting her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_05_27","text":"... Chime, you're surprisingly calm right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_05_28","text":"I have to admit, I'm a bit impressed.","jump":null,"exit":false,"en