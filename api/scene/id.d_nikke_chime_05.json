Locale_NikkeEpisode:d_nikke_chime_05_7","text":"I know not what Her Highness thinks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_8","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_05_8","text":"Yet as for me, such is how I see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_9","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_05_9","text":"... Did I not tell thee? Those dear to thee surely hold thee dear as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_10","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_05_10","text":"To them, it would seem as though some precious thing hath been taken away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_05_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_chime_05_12","text":"Have you told Crown what we talked about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_13","type":"Speech","speaker":"chime","key":"Locale_NikkeEpisode:d_nikke_chime_05_13","text":"... Mere trifles, I assure thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_chime_05_14","type":"Speech","speaker