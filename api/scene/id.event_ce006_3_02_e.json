:null,"affinity":null},{"id":"event_ce006_3_02_e_20","type":"Speech","speaker":"bunkerchild","key":"Locale_MainScenario:event_ce006_3_02_e_20","text":"Then why don't you pull them out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_21","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_21","text":"We don't have the necessary equipment to do so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_22","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_22","text":"We must retrieve it from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_23","type":"Speech","speaker":"bunkerchild","key":"Locale_MainScenario:event_ce006_3_02_e_23","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_24","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_24","text":"Lying is not a capability which I possess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_25","type":"Speech","speaker":"bunkerchild","key":"Locale_MainScenario:event_ce006_3_02_e_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_26","type":"Speech","speaker":"bunkerchild","key":"Locale_MainScenario:event_ce006_3_02_e_26","text":"Then let's go to the Ark! Hurry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_27","type":"Speech","speaker":"bunkerchild","key":"Locale_MainScenario:event_ce006_3_02_e_27","text":"Dad is all alone inside the bunker, and we need to save the Nikkes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_28","type":"Speech","speaker":"bunkerchild","key":"Locale_MainScenario:event_ce006_3_02_e_28","text":"They must be so lonely...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_29","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_29","text":"Right. We shall go and then return. Let us be quick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_30","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_30","text":"-----","jump":null,"exit":false,"enter":null,"bg":"Desert_03","bgArt":"desert_03","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_31","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_31","text":"Three Nikkes. One combat support robot. Nine civilians, including a child.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_32","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_32","text":"The journey to the Ark is a long and arduous one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_33","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_33","text":"The situation is quickly becoming hopeless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_34","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_34","text":"Still, we must go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_35","type":"Speech","speaker":"com","key":"Locale_MainScenario:event_ce006_3_02_e_35","text":"Everyone must live.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_ce006_3_02_e_36","text":"*Bzzt bzzt*","jump":null,"exit":false,"enter":null,"bg":"Desert_02_n","bgArt":"desert_02_n","image":null,"bgm":"none","movie":null,"shown":["snowwhite","hongryeon","rapunzel"],"affinity":null},{"id":"event_ce006_3_02_e_37","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_3_02_e_37","text":"The insects are already performing their song.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_38","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_ce006_3_02_e_38","text":"Any chance you could catch a few?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_39","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_3_02_e_39","text":"Do not be so hasty. We have brought sufficient victuals with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_40","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_3_02_e_40","text":"We also don't have time for bug hunts. We have to keep after that mystery woman.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_41","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_3_02_e_41","text":"Her swordsmanship was most admirable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_42","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_3_02_e_42","text":"She did not seem like a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_43","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_3_02_e_43","text":"No, she didn't. Perhaps she's one of those people from that city.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_44","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_3_02_e_44","text":"Hmm... what should we call them? Outsiders?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_45","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_3_02_e_45","text":"I think 'tis a most befitting appellation for them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_46","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_3_02_e_46","text":"She might be one of those Outsiders from the city.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_47","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_3_02_e_47","text":"She seemed different from them, however. Sharper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_48","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_ce006_3_02_e_48","text":"Well, one thing is for certain; she's liable to get in the way of us procuring Com.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_49","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_3_02_e_49","text":"You're right. Whoever she is, or whatever she's up to, she's a problem which needs to be addressed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_50","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_ce006_3_02_e_50","text":"What dost thou all surmise Com's goal is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_51","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_3_02_e_51","text":"It seems to have a serious axe to grind with the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_52","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_ce006_3_02_e_52","text":"Perhaps it's after revenge... although in what form I can't say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_3_02_e_53","type":"Speech","speaker":"snowwhite","key":