{"id":"d_counseling_nihilister_10","cat":"counsel","group":{"id":"char5056","label":"Nihilister"},"label":"Advising Nihilister: 10","stage":null,"prev":"d_counseling_nihilister_09","next":"d_counseling_nihilister_11","speakers":{"nihilister":"Nihilister"},"icons":{"nihilister":"si_c261_00_s"},"lines":[{"id":"d_counseling_nihilister_10_1","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_10_1","text":"What do you think it'd be like if Vapaus was easy to obtain?","jump":null,"exit":false,"enter":null,"bg":"Volcano_03","bgArt":"volcano_03","image":null,"bgm":"bgm_volcanicnest","movie":null,"shown":["nihilister"],"affinity":"_0"},{"id":"d_counseling_nihilister_10_2","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_10_2","text":"Either I wouldn't be here, or you wouldn't be here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_10_3","type":"Speech","speaker":"nihilister","key":"Locale_Counseling:d_counseling_nihilister_10_3","text":"Either of the two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nihilister_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_10_4","text":"Maybe both of us would be here.","jump":"d_counseling_nihilister_10_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nihilister_10_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nihilister_10_5","text":"Or maybe neither of us would be here.","jump":"d_counseling_nihilister_10_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nihilister_10_6","type":"Speech","speaker":"nihilister","key":"Lo