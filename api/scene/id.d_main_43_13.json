":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_35","type":"Speech","speaker":"priestess","key":"Locale_MainScenario:d_main_43_13_35","text":"If you had been captured by the Central Government and forced to divulge information, it would've greatly interfered with my plans for V.T.C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_36","type":"Speech","speaker":"priestess","key":"Locale_MainScenario:d_main_43_13_36","text":"Thus, I was compelled to commit this discourtesy. I hope you'll forgive me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_37","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_37","text":"You've been... played...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_38","type":"Speech","speaker":"priestess","key":"Locale_MainScenario:d_main_43_13_38","text":"No, not at all. I'm not so naive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_39","type":"Speech","speaker":"priestess","key":"Locale_MainScenario:d_main_43_13_39","text":"Now, Your Holiness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_40","type":"Speech","speaker":"priestess","key":"Locale_MainScenario:d_main_43_13_40","text":"I shall take my leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_41","text":"The priestess runs forward, unable to contain her joy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_42","text":"The necklace in her hand shimmers with a golden light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_43","text":"The priestess stops in her tracks and looks down at the necklace in her hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_44","text":"*Boom*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_45","text":"Golden light bursts outward, and the priestess vanishes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_46","text":"All that remains are the priestess's robes, fluttering where she once stood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_47","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_47","text":"Princess laughs after watching the whole thing unfold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_48","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_48","text":"Heheh. Serves her right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_49","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_49","text":"Doesn't it, Third...? Hey...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_50","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_50","text":"She turns to Stall III, who is lying beside her.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_1","bgArt":"eventscene_chap_43_02_1","image":null,"bgm":"bgm_story_monochrome","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_51","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_51","text":"Her eyes are slightly open but unfocused.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_52","text":"Red foam leaks from her mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_53","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_54","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_54","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_2","bgArt":"eventscene_chap_43_02_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_55","type":"Speech","speaker":"princess","key":"Locale_MainSc