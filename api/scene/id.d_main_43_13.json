s","key":"Locale_MainScenario:d_main_43_13_62","text":"It's a fitting death for such a miserable life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_63","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_63","text":"*Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_64","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_64","text":"Princess suddenly coughs up blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_65","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_65","text":"*Cough, cough...!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_66","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_66","text":"*Huff... huff...!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_67","type":"Speech","speaker":"CGspecial","key":"Locale_MainScenario:d_main_43_13_67","text":"I repeat. A female in her early teens, with red glasses and white hair.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_1","bgArt":"eventscene_chap_43_02_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_68","type":"Speech","speaker":"CGspecial","key":"Locale_MainScenario:d_main_43_13_68","text":"She is a high-priority target. Secure her at all costs. She must be taken alive!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_69","type":"Speech","speaker":"CGspecial","key":"Locale_MainScenario:d_main_43_13_69","text":"I repeat. A female in her early teens, with red glasses and white hair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_70","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_70","text":"*Cough, cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_71","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_71","text":"Is this really how you want to die?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_72","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_72","text":"Are you okay with the life you've lived?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_73","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_73","text":"Yeah. You'd probably say you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_74","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_74","text":"I always...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_75","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_75","text":"I always wondered why you treated me so kindly, when we'd never even met before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_76","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_76","text":"I thought about asking you hundreds of times, but I never did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_77","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_77","text":"Because after living with you, I figured it out on my own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_78","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_78","text":"That's just who you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_79","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_79","text":"You would struggle all your life to survive in a lightless sewer,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_80","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_80","text":"only to die for someone else. You're that kind of a fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_81","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_81","text":"Ugh...! *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_82","type":"Speech","speaker":"CGspecial","key":"Locale_MainScenario:d_main_43_13_82","text":"I repeat. A female in her early teens, with red glasses and white hair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_83","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_83","text":"You poor thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_84","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_84","text":"You've never seen the Ark, have you?","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_2","bgArt":"eventscene_chap_43_02_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_85","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_85","text":"Or even tasted good food?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_86","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_86","text":"You've never seen what a bright place looks like, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_87","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_87","text":"Or worn clean clothes, or bathed in warm water?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_88","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_89","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_89","text":"I've done all of that... for far too long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_90","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_90","text":"Princess uses the last of her strength to move her hands.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_3","bgArt":"eventscene_chap_43_02_3","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_91","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_91","text":"She removes her glasses,","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_5","bgArt":"eventscene_chap_43_02_5","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_92","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_13_92","text":"and places them on Stall III's face.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_4","bgArt":"eventscene_chap_43_02_4","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_93","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_93","text":"I hope you get to live that life,","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_43_02_6","bgArt":"eventscene_chap_43_02_6","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_94","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_94","text":"to see the light with those eyes, to go wherever you want,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_95","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_95","text":"to live happily and joyfully...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_13_96","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_13_96","text":"And also to never have to deal with that wretched cough again.","ju