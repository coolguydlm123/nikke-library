{"id":"msg_m_ex_mihara_02","cat":"messenger","group":{"id":"room_mihara","label":"Mihara · Nikke"},"label":"2. Commander,","stage":null,"prev":"msg_m_ex_mihara_01","next":"msg_m_ex_mihara_03","speakers":{"mihara":"Mihara"},"icons":{"mihara":"si_c161_00_s"},"lines":[{"id":"m_ex_mihara_02_1","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_1","text":"Commander,","jump":null},{"id":"m_ex_mihara_02_2","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_2","text":"what are you up to? Are you busy?","jump":null},{"id":"m_ex_mihara_02_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mihara_02_3","text":"I was resting.","jump":null},{"id":"m_ex_mihara_02_4","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_4","text":"Hope I didn't disturb you.","jump":null},{"id":"m_ex_mihara_02_5","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_5","text":"I was just reaching out because I'm bored.","jump":null},{"id":"m_ex_mihara_02_6","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_6","text":"Yuni left a moment ago.","jump":null},{"id":"m_ex_mihara_02_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mihara_02_7","text":"I see.","jump":null},{"id":"m_ex_mihara_02_8","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_8","text":"Yep, yep.","jump":null},{"id":"m_ex_mihara_02_9","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_9","text":"Um... Commander...","jump":null},{"id":"m_ex_mihara_02_10","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_10","text":"Thank you.","jump":null},{"id":"m_ex_mihara_02_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mihara_02_11","text":"Where'd that come from?","jump":null},{"id":"m_ex_mihara_02_12","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_12","text":"I've always wanted to say that to you.","jump":null},{"id":"m_ex_mihara_02_13","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_13","text":"Ever since Yuni met you, she's just lit up.","jump":null},{"id":"m_ex_mihara_02_14","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_14","text":"I'm really all that Yuni has.","jump":null},{"id":"m_ex_mihara_02_15","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_15","text":"She lives a sheltered life","jump":null},{"id":"m_ex_mihara_02_16","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_16","text":"and knowing even one new person","jump":null},{"id":"m_ex_mihara_02_17","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_17","text":"means the world to her.","jump":null},{"id":"m_ex_mihara_02_18","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_18","text":"So I wanted to thank you.","jump":null},{"id":"m_ex_mihara_02_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mihara_02_19","text":"What about you, Mihara?","jump":null},{"id":"m_ex_mihara_02_20","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_20","text":"Huh? Me?","jump":null},{"id":"m_ex_mihara_02_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mihara_02_21","text":"I know it's good for Yuni, but what about you?","jump":null},{"id":"m_ex_mihara_02_22","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_22","text":"Aww, are you concerned about me?","jump":null},{"id":"m_ex_mihara_02_23","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_23","text":"You're sweet.","jump":null},{"id":"m_ex_mihara_02_24","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_24","text":"Knowing you have brought me happiness as well.","jump":null},{"id":"m_ex_mihara_02_25","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_25","text":"Someone who takes you for who you are","jump":null},{"id":"m_ex_mihara_02_26","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_26","text":"is hard to come by.","jump":null},{"id":"m_ex_mihara_02_27","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_27","text":"Commander, our relationship is one","jump":null},{"id":"m_ex_mihara_02_28","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_28","text":"that cannot be explained in mere words.","jump":null},{"id":"m_ex_mihara_02_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mihara_02_29","text":"Thank you for the compliment.","jump":null},{"id":"m_ex_mihara_02_30","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_30","text":"My pleasure.","jump":null},{"id":"m_ex_mihara_02_31","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_31","text":"I should go and meet up with Yuni.","jump":null},{"id":"m_ex_mihara_02_32","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_32","text":"Thanks for your time.","jump":null},{"id":"m_ex_mihara_02_33","type":"Speech","speaker":"mihara","key":"Locale_SuddenMessage:m_ex_mihara_02_33","text":"Let's hang out with Yuni next time.","jump":null}],"chat":true}