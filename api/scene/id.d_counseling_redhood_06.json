{"id":"d_counseling_redhood_06","cat":"counsel","group":{"id":"char5101","label":"Red Hood"},"label":"Advising Red Hood: 06","stage":null,"prev":"d_counseling_redhood_05","next":"d_counseling_redhood_07","speakers":{"redhood":"Red Hood"},"icons":{"redhood":"si_c470_00_s"},"lines":[{"id":"d_counseling_redhood_06_1","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_1","text":"Sometimes, I have this nagging feeling...","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":["redhood"],"affinity":"_0"},{"id":"d_counseling_redhood_06_2","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_06_2","text":"What kind of feeling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_3","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_3","text":"My time has already come and gone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_4","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_4","text":"and yet, I still exist in this world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_5","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_5","text":"It's a strange thought, and whenever it pops up in my mind, I'm a bit unsettled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_06_6","text":"I think that's a perfectly normal reaction.","jump":"d_counseling_redhood_06_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_redhood_06_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_06_7","text":"Shouldn't you be excited at having a new lease on life?","jump":"d_counseling_redhood_06_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_redhood_06_8","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_8","text":"Yeah? I thought you'd be weirded out by it as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_9","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_9","text":"Thanks for understanding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_10","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_10","text":"Nevertheless, I still intend to give this body back to Rapi ASAP, so don't worry about that.","jump":"d_counseling_redhood_06_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_11","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_11","text":"Hey, how could you say that? Rapi wouldn't be too happy hearing that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_12","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_12","text":"And it was you who told me to get your oh-so-precious Rapi back to you as soon as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_13","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_06_13","text":"There's a time for joking around, and there's a time to be serious.","jump":"d_counseling_redhood_06_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_06_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_06_14","text":"Red Hood and I continue to discuss the intricacies of emotions for a while.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}