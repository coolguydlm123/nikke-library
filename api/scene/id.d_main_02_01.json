eech","speaker":"anis","key":"Locale_MainScenario:d_main_02_01_27","text":"What about the humans who are still in the city?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_01_28","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_01_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_01_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_02_01_29","text":"Well, considering we don't know what we'll run into, it's best they stay inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_01_30","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_01_30","text":"Our first order of business is cutting off power to the line. Is there any way we can do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_01_31","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_02_01_31","text":"Yes, I will mark the location of the control room on the map.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_01_32","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_02_01_32","text":"Commander, I'm ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_01_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_02_01_33","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_02_01_34","type":"Speech","sp