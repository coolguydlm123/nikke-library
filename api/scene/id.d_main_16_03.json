"affinity":null},{"id":"d_main_16_03_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_03_29","text":"I feel like this is some form of karma.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_03_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_03_30","text":"There was a time when I lived as a human, enjoying a peaceful life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_03_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_03_31","text":"Back then, whenever a Nikke was sent up to the surface while I stayed underground,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_03_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_03_32","text":"I never gave it a second thought. I never cared about them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_03_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_03_33","text":"So this is my punishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}