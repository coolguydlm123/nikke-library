{"id":"d_ex_redash_05_2","cat":"event","group":{"id":"ev80800","label":"RED ASH"},"label":"The Flower, Liliweiss II","stage":null,"prev":"d_ex_redash_05_1","next":"d_ex_redash_06_1","speakers":{"Narration":"Narration","liliweiss":"Liliweiss","commander":"Commander"},"icons":{"Narration":"si_c999_00_s","liliweiss":"si_c943_00_s","commander":"si_c942_00_s"},"lines":[{"id":"d_ex_redash_05_2_1","type":"Narration","speaker":"Narration","key":"Locale_SuddenStory:d_ex_redash_05_2_1","text":"Record #005-2 playback.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":"none","movie":null,"shown":["liliweiss","commander"],"affinity":null},{"id":"d_ex_redash_05_2_2","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_2","text":"Commander, I'm going out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_3","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_4","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_4","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_5","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_5","text":"I'll be back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_6","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_6","text":"Today, I'm coming with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_7","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_7","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_8","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_8","text":"Is that forbidden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_9","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_9","text":"That's not it, it's just...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_10","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_10","text":"Then let's go. You'll be my escort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_11","type":"Narration","speaker":"Narration","key":"Locale_SuddenStory:d_ex_redash_05_2_11","text":"A nameless flower field.","jump":null,"exit":false,"enter":null,"bg":"Grassland","bgArt":"grassland","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_12","type":"Narration","speaker":"Narration","key":"Locale_SuddenStory:d_ex_redash_05_2_12","text":"Liliweiss and the Commander stare into the sky without saying a word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_redash_dearsnowwhite","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_13","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_13","text":"You know... I usually talk to myself when I'm here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_14","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_14","text":"But I don't think I can do it with you around. Could you go somewhere else for a bit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_15","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_15","text":"No. What if something happens to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_16","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_16","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_17","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_17","text":"Why are you even here, Commander? It's not like you've contributed anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_18","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_18","text":"I'm going to burn this place down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_19","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_19","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_20","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_20","text":"You're always in a funk whenever you come back from this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_21","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_21","text":"That's no way for a squad leader to act.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_22","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_22","text":"So I'm not allowed to feel sadness, is that it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_23","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_23","text":"You have to endure it. If you can't, then you shouldn't come here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_24","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_24","text":"Yet you come here constantly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_25","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_25","text":"Let me ask you something. Why do you come here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_26","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_26","text":"If you come here and speak into the void, do those you have lost talk back to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_27","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_27","text":"Don't call her that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_28","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_28","text":"That's what she is. She's dead. Out of commission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_29","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_29","text":"Don't treat her death so flippantly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_30","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_30","text":"You haven't answered my question. Why do you come here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_31","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_31","text":"The fact that she's dead is due to no fault of your own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_32","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_32","text":"... Part of it is my fault.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_33","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_33","text":"The first Grimms model was created based on a prototype,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_34","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_34","text":"which was you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_35","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_35","text":"The proper adjustments weren't made during her creation, and she couldn't handle the physical strain, leading to her death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_36","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_36","text":"The lessons learned from that mistake mean that all subsequent models did not have this defect, and thus were safe from harm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_37","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_37","text":"Where in that equation are you remotely at fault?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_38","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_39","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_39","text":"Besides, this is not even her final resting place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_40","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_40","text":"She was scattered all over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_41","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_41","text":"This is the last place where we talked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_42","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_42","text":"And...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_43","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_43","text":"The Liliweiss flower blooms here as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_44","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_45","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_45","text":"Even now, only one lone flower has bloomed. I felt there was somehow a significance to that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_46","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_46","text":"There's no greater meaning behind it whatsoever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_47","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_47","text":"Under the right conditions, the flowers can bloom just about anywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_48","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_48","text":"Don't go trying to attach meaning to something when there's none.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_49","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_49","text":"I see you have no intention of comforting me, then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_50","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_50","text":"Glad you got the hint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_51","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_51","text":"You head back first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_52","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_52","text":"I'll follow you once I burn this place down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_53","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_54","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_54","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_55","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_55","text":"I'll admit that I've been weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_56","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_56","text":"She was someone very close to me, and I was too attached, so I haven't gotten over it just yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_57","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_57","text":"I will not come back here. Truth be told, I knew from the start that this place wouldn't assuage my sorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_58","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_58","text":"I'll simply keep her here, in my mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_59","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_59","text":"Good. Then let's burn it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_60","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_60","text":"No, don't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_61","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_61","text":"Why not? You'll only come back again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_62","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_62","text":"I won't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_63","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_63","text":"Can you promise me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_64","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_64","text":"Yes. I promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_65","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_65","text":"But you have to promise me something in return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_redash_freesia","movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_66","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_66","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_67","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_67","text":"When we die,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_68","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_68","text":"please don't do what I did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_69","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_69","text":"If you all die, I'll more than likely have perished along with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_70","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_70","text":"But if you don't, promise me that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_71","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_71","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_72","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_72","text":"When you die, I'll visit your graves every year,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_73","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_05_2_73","text":"and I'll cry my eyes out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_74","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_05_2_74","text":"... Please don't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_05_2_75","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_0