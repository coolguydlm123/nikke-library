null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_58","type":"Speech","speaker":"doban","key":"Locale_MainScenario:event_boomtheghost2_epilogue_58","text":"She couldn't have come here just to broadcast that gibberish show of hers!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_59","type":"Speech","speaker":"dobanteamnikke","key":"Locale_MainScenario:event_boomtheghost2_epilogue_59","text":"H-her movements are somewhat limited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_60","type":"Speech","speaker":"dobanteamnikke","key":"Locale_MainScenario:event_boomtheghost2_epilogue_60","text":"Other than periodic meetings with Deputy Chief Burningum, she hasn't been to many places.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_61","type":"Speech","speaker":"doban","key":"Locale_MainScenario:event_boomtheghost2_epilogue_61","text":"What did she talk about with him?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_62","type":"Speech","speaker":"dobanteamnikke","key":"Locale_MainScenario:event_boomtheghost2_epilogue_62","text":"We... We were unable to find out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_63","type":"Speech","speaker":"doban","key":"Locale_MainScenario:event_boomtheghost2_epilogue_63","text":"Are you kidding?! Why didn't you bug their offices?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_64","type":"Speech","speaker":"dobanteamnikke","key":"Locale_MainScenario:event_boomtheghost2_epilogue_64","text":"That was impossible. The Deputy Chief's offices are—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_65","type":"Speech","speaker":"doban","key":"Locale_MainScenario:event_boomtheghost2_epilogue_65","text":"Bah! I know, I know! It's impervious to any bugging equipment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_66","type":"Speech","speaker":"doban","key":"Locale_MainScenario:event_boomtheghost2_epilogue_66","text":"Enikk is also covering for her, so we're screwed in that department.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_67","type":"Speech","speaker":"dobanteamnikke","key":"Locale_MainScenario:event_boomtheghost2_epilogue_67","text":"It... It's the same with your office. All of the Deputy Chiefs' offices are...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_68","type":"Speech","speaker":"doban","key":"Locale_MainScenario:event_boomtheghost2_epilogue_68","text":"I know that! Don't try and lecture me!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost2_epilogue_69","type":"Speech","speaker":"dobanteamnikke","key":"Locale_MainScenario:event_boomtheghost2_epilogue_69","text":"S-sorry, Deputy Chief! I didn't mean to cause offense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":