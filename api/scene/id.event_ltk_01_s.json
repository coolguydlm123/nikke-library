Scenario:event_ltk_01_s_21","text":"The three of us sit at the table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_22","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_22","text":"The target is the president of C.O.L.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["d","k"],"affinity":null},{"id":"event_ltk_01_s_23","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_23","text":"C.O.L. stands for \"Cycle of Life\". It's a company that buys used electronics, repairs them, then resells them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_24","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_24","text":"Their expansion has been remarkable, in fact, so much that only the Big Three are valued higher.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_25","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_25","text":"In fact, some reports indicate that they are actually outperforming the Big Three in terms of purchasing and sales.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_26","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_26","text":"In other words, they're raking in the cash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_27","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_27","text":"The money isn't what's important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_28","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_28","text":"I know. I'm just saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_29","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_29","text":"Anyway, this guy used to be a real bigwig in the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_30","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_30","text":"Until one day he retired and started this electronics business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_31","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_31","text":"Then it blew up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_32","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_32","text":"All of this is superfluous information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_33","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_33","text":"Fine, then you tell it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_34","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_35","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_35","text":"This so-called \"president\" is making large donations to the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_36","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_36","text":"He's also been investing in the medical industry, and making some hefty donations as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_37","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_37","text":"It sounds like he's a real standup guy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_38","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_38","text":"But he's been targeted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_39","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_39","text":"Why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_40","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_40","text":"He's making waaaaay too much moolah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_41","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_01_s_41","text":"What kind of a reason is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_42","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_42","text":"His income can't come just from trading electronics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_43","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_43","text":"The Judges feel there must be something else going on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_44","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_44","text":"It's up to us to figure out what exactly that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_45","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_45","text":"Once we have, we'll make our decision and carry it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_46","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_01_s_46","text":"What exactly do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_47","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_47","text":"Isn't it obvious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_01_s_48","type":"Speech","speaker":"k","key":"Locale_SubScenario:event_ltk_01_s_48","text":"Whether or not we kill this guy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}