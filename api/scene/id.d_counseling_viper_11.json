{"id":"d_counseling_viper_11","cat":"counsel","group":{"id":"char1022","label":"Viper"},"label":"Advising Viper: 11","stage":null,"prev":"d_counseling_viper_10","next":"d_counseling_viper_12","speakers":{"viper":"Viper"},"icons":{"viper":"si_c112_00_s"},"lines":[{"id":"d_counseling_viper_11_1","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_11_1","text":"Honey! One of our squadmates sold out to the Ark in exchange for a place to live there.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["viper"],"affinity":"_0"},{"id":"d_counseling_viper_11_2","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_11_2","text":"They've been feeding them information on what the Boss, Jackal, and I have been up to the past few days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_11_3","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_11_3","text":"They've been on us like white on rice, asking us all sorts of questions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_11_4","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_11_4","text":"It's enough to make your blood boil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_11_5","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_11_5","text":"I managed to catch them in the act yesterday.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_11_6","type":"Speech","speaker":"viper","key":"Loc