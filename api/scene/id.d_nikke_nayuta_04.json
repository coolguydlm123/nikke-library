"affinity":null},{"id":"d_nikke_nayuta_04_14","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_14","text":"Aye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_15","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_15","text":"Verily, I have beheld thee also.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_04_16","text":"You saw me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_17","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_17","text":"'Tis one of Persinette's licentious paintings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_18","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_18","text":"So wondrously lifelike the portrayal, that mine heart was ensnared unwittingly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_19","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_04_19","text":"Can we please stop talking about the paintings?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_20","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_20","text":"Hahaha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_21","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_04_21","text":"Nayuta leans down to examine the vegetables growing in the garden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_22","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_22","text":"Apart from the tale that thou and Scarlet did partake of compost,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_23","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_23","text":"I have verily heard many a tale of thee from the Forerunners.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_24","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_04_24","text":"... What'd they say about me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_25","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_25","text":"Hmmm... how should I utter it... Ah, verily!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_26","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_04_26","text":"Nayuta averts her eyes from the vegetables and straightens up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_27","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_27","text":"The Forerunners spake thus:","jump":null,"exi