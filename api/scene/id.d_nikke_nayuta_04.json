{"id":"d_nikke_nayuta_04","cat":"bond","group":{"id":"char5155","label":"Nayuta"},"label":"Q&A: Crossroads","stage":null,"prev":"d_nikke_nayuta_03","next":"d_nikke_nayuta_05","speakers":{"nayuta_n":"Nayuta"},"icons":{"nayuta_n":"si_c9008_00_s"},"lines":[{"id":"d_nikke_nayuta_04_1","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_1","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":"RaptilionFarm","bgArt":"raptilionfarm","image":null,"bgm":"bgm_story_impression","movie":null,"shown":["nayuta_n"],"affinity":null},{"id":"d_nikke_nayuta_04_2","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_2","text":"By yielding myself unto the course of nature, I find myself returned hither.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_3","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_3","text":"Is it not most wondrous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_4","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_04_4","text":"Well, that's because we went back the way we came...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_5","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_5","text":"Surely not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_04_6","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_04_6","text":"This time, I had hoped to journey to a place mine eyes ne'er yet beheld.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"mo