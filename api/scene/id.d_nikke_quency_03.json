{"id":"d_nikke_quency_03","cat":"bond","group":{"id":"char5078","label":"Quency"},"label":"Swallow it if sweet and spit it out if bitter","stage":null,"prev":"d_nikke_quency_02","next":"d_nikke_quency_04","speakers":{"quency":"Quency","dealprisoner":"Hustler Prisoner","happyprisoner":"Delighted Prisoner","leaderprisoner":"Prisoner Leader","timidprisone":"Cautious Prisoner","poorprisoner":"Destitute Prisoner","drunkprisoner":"Drunken Prisoner"},"icons":{"quency":"si_c402_00_s","dealprisoner":"si_c999_00_s","happyprisoner":"si_c999_00_s","leaderprisoner":"si_c999_00_s","timidprisone":"si_c999_00_s","poorprisoner":"si_c999_00_s","drunkprisoner":"si_c999_00_s"},"lines":[{"id":"d_nikke_quency_03_1","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_1","text":"Let's see... Should I head out now?","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":["quency"],"affinity":null},{"id":"d_nikke_quency_03_2","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_2","text":"Where do you think you're going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_3","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_3","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_4","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_4","text":"What are you doing here? We didn't have a consultation scheduled today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_5","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_5","text":"I came by just in case you tried to escape again.","jump":"d_nikke_quency_03_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_6","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_6","text":"I came to make up for the last appointment we missed.","jump":"d_nikke_quency_03_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_7","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_7","text":"Come on, Counselor, what's wrong with going out and stretching my legs a little?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_8","text":"We call that an escape attempt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_9","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_9","text":"Eh, same difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_10","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_10","text":"If you thought about it that way, you'd think I was always trying to escape!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_11","text":"... Aren't you?","jump":"d_nikke_quency_03_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_12","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_12","text":"Well, we DID meet that day, and we DID end up talking, so whaddya say we count it as a consultation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_13","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_13","text":"Sorry, no can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_14","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_14","text":"You're a real stickler, you know that?","jump":"d_nikke_quency_03_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_15","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_15","text":"Oh, right! There's something I've been wondering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_16","text":"What's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_17","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_17","text":"Me escaping. Why didn't you tell anyone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_18","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_18","text":"When you found my secret passage, I thought my goose was cooked, but nothing happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_19","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_19","text":"I thought for sure you'd go running back to the guards and squeal on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_20","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_20","text":"I look after those I'm close to.","jump":"d_nikke_quency_03_22","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_21","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_21","text":"I want you to get better.","jump":"d_nikke_quency_03_23","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_22","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_22","text":"How very kind of you...","jump":"d_nikke_quency_03_24","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_23","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_23","text":"You're taking this more seriously than I thought.","jump":"d_nikke_quency_03_24","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_24","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_24","text":"I have to say, I see you in a new light now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_25","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_25","text":"I want to know what you're up to when you're out and about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_26","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_26","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_27","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_27","text":"So that I can help you.","jump":"d_nikke_quency_03_29","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_28","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_28","text":"Because I want to get to know you better.","jump":"d_nikke_quency_03_30","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_29","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_29","text":"You don't need to help me...","jump":"d_nikke_quency_03_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_30","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_30","text":"This is the first time a counselor has taken any interest in me.","jump":"d_nikke_quency_03_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_31","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_31","text":"Well, fine. \nFollow me, and I'll show you what kind of person I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_32","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_32","text":"Even though you seem to know me already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_33","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_33","text":"But before that, your shoelace...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_34","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_34","text":"Is gone? Hehe, well played.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_35","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_35","text":"All right, let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_36","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_36","text":"Quency's escape route was far more intricate than I had imagined.\nThe tunnel diverged into several different paths and was riddled with booby traps throughout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_37","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_37","text":"After making our way through the labyrinth, we ended up in a dilapidated warehouse where several prisoners had gathered.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_38","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_38","text":"Are you planning on selling this today? It's good stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_39","type":"Speech","speaker":"dealprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_39","text":"Yeah, I'm finished with it, so I'm gonna sell it to someone who needs it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_40","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_40","text":"Hi! What were you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_41","type":"Speech","speaker":"happyprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_41","text":"Quency! Come here and have some coffee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_42","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_42","text":"Quency went and casually greeted the people who had called her over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_43","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_43","text":"This was some kind of safe zone for people to trade products and speak freely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_44","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_44","text":"What is this place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_45","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_45","text":"We call it the hideout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_46","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_46","text":"We gather here every day in secret to buy and sell whatever we have on hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_47","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_47","text":"I'm not sure if you're aware, but anything and everything related to the Ark is strictly forbidden in the Rehabilitation Center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_48","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_48","text":"So all that stuff you said during the consultation...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_49","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_49","text":"Made it all up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_50","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_50","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_51","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_51","text":"We use bottle caps as currency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_52","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_52","text":"People come here to sell all sorts of products and gather these bottle caps. They can also be used as payment for helping out fellow prisoners.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_53","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_53","text":"Quency, is that you? What took you so long today?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_54","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_54","text":"I had to wait until the guards fell asleep. Speaking of which, I need to get back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_55","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_55","text":"Who's that with you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_56","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_56","text":"My counselor. Say hi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_57","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_57","text":"What?! What are you doing bringing someone like that here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_58","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_58","text":"It's fine. This is one counselor that's actually worth trusting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_59","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_59","text":"Besides, if word gets out about any of this, you know who to go after. Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_60","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_60","text":"... Nice to meet you.","jump":"d_nikke_quency_03_62","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_61","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_61","text":"... I won't say anything.","jump":"d_nikke_quency_03_62","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_62","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_62","text":"You're not scared, are you? You all, come on! Be nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_63","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_63","text":"Let's get this show on the road. I brought everything you guys asked for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_64","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_64","text":"I knew we could count on you. What about me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_65","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_65","text":"One adult magazine, as requested. You know, you really should cut back on this stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_66","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_66","text":"This is my only friend here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_67","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_67","text":"An adult magazine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_68","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_68","text":"How much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_69","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_69","text":"20 caps.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_70","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_70","text":"Here. Pleasure doing business with ya! What would we do without you, Quency?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_71","type":"Speech","speaker":"timidprisone","key":"Locale_NikkeEpisode:d_nikke_quency_03_71","text":"What about the Splendamin I asked for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_72","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_72","text":"Powder, jelly, liquid... I got several kinds. I heard you're getting out soon? Congrats.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_73","type":"Speech","speaker":"timidprisone","key":"Locale_NikkeEpisode:d_nikke_quency_03_73","text":"It's all thanks to you. I don't know how I can repay you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_74","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_74","text":"We're friends. There's nothing to repay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_75","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_75","text":"You're too forgiving, Quency. You're gonna end up bankrupt one of these days, being that nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_76","type":"Speech","speaker":"timidprisone","key":"Locale_NikkeEpisode:d_nikke_quency_03_76","text":"How many caps are you asking for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_77","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_77","text":"50 should do the trick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_78","type":"Speech","speaker":"poorprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_78","text":"Um, Quency... Sorry, but could I borrow 30 caps?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_79","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_79","text":"Sure, but I'll be charging interest. One cap per day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_80","type":"Speech","speaker":"poorprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_80","text":"No problem. I'll pay you back, promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_81","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_81","text":"All right then, 30 caps coming right up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_82","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_82","text":"Quency continued wheeling and dealing for some time. This place was like its own enclosed society.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_83","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_83","text":"What do you think about our hideout? Not bad, eh? It's all Quency's doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_84","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_84","text":"You looking to buy anything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_85","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_85","text":"Thanks to Quency, I can earn some scratch to spend on my hobbies. It at least allows me to retain a semblance of the life I had back in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_86","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_86","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_87","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_87","text":"I mean, who else would think of using bottle caps as currency? It's genius!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_88","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_88","text":"Sounds like she's a big deal around here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_89","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_89","text":"Oh yeah. Quency has got a tight grip on the local economy. None of us would dream of going against her, I included.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_90","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_9