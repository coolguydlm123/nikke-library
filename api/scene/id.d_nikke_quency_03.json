risoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_97","text":"If you ask me, 30 is more reasonable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_98","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_98","text":"Excuse me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_99","type":"Speech","speaker":"drunkprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_99","text":"Too expensive... *Hicc*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_100","type":"Speech","speaker":"drunkprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_100","text":"C'mon, be a pal. Just a little cheaper...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_101","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_101","text":"All right, no deal then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_102","type":"Speech","speaker":"drunkprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_102","text":"What?! C'mon, don't be like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_103","type":"Speech","speaker":"drunkprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_103","text":"You overcharged me last time! You don't think I remember?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_0