":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_118","type":"Speech","speaker":"poorprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_118","text":"How dare you talk that way about Quency?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_119","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_119","text":"You don't think I asked for too many bottle caps, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_120","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_120","text":"No! Never! We don't think that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_121","type":"Speech","speaker":"poorprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_121","text":"Right, right! He's the only one that thinks that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_122","type":"Speech","speaker":"drunkprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_122","text":"Every one of you said the same thing to me before...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_123","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_123","text":"You're banished! Don't ever come back to the hideout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_124","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_124","text":"Do you have any idea how hard Quency works to gather these items?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_125","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_125","text":"I... I need to lie down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_126","type":"Speech","speaker":"leaderprisoner","key":"Locale_NikkeEpisode:d_nikke_quency_03_126","text":"Sure thing, Quency. Thanks for everything. We'll take care of that drunkard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_127","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_127","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_128","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_128","text":"Are you okay?","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_129","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_129","text":"Ugh, so annoying!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_breakaway","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_130","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_130","text":"I knew he'd be trouble the moment he started drinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_131","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_131","text":"... Quency?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_132","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_132","text":"Hehe, how'd you like my acting?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_133","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_133","text":"I think I really pulled it off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_134","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_134","text":"That wino had been getting on my nerves for a while. Everything worked out quite nicely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_135","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_135","text":"Are you sure nothing that guy said affected you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_136","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_136","text":"Oh please, how could it have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_137","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_137","text":"He was telling the truth, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_138","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_138","text":"You've seen it for yourself. This place is like a haven for me. I have to pull here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_139","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_139","text":"To be honest, escaping is the only real skill I have. I doubt I could make it in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_140","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_140","text":"Then why did you say you wanted to be rehabilitated during our consultation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_141","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_141","text":"I was just telling you what you wanted to hear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_142","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_142","text":"I'm perfectly happy going to and from the Ark as I please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_143","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_143","text":"I have no intention of being rehabilitated, Counselor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_144","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_144","text":"So you might as well give up now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_145","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_145","text":"I can't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_146","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_146","text":"Are you going to look after me if I end up going to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_147","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_147","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_148","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_148","text":"That's what I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_149","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_149","text":"Yes, I will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_150","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_03_150","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_03_151","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_03_151","text":"You will be my responsibility. I'll help you adjust to life in the Ark.","jump":null,"exi