{"id":"d_counseling_poli_01","cat":"counsel","group":{"id":"char5016","label":"Poli"},"label":"Advising Poli: 01","stage":null,"prev":null,"next":"d_counseling_poli_02","speakers":{"poli":"Poli"},"icons":{"poli":"si_c030_00_s"},"lines":[{"id":"d_counseling_poli_01_1","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_1","text":"As a police officer, I see a lot of drunks on the streets.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["poli"],"affinity":"_0"},{"id":"d_counseling_poli_01_2","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_2","text":"Some of them even threaten us, asking why lowly police dare to arrest them. Grr...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_3","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_3","text":"What should I do when I run into this kind of person?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_01_4","text":"Show them who's boss.","jump":"d_counseling_poli_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_poli_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_01_5","text":"Let it slide. The police are only here to protect and serve.","jump":"d_counseling_poli_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_poli_01_6","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_6","text":"Good idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_7","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_7","text":"The iron fist of the law must keep a tight grip!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_8","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_8","text":"It's like you read my mind or something!","jump":"d_counseling_poli_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_9","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_9","text":"Uh... I didn't know you were going to give such an earnest answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_10","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_10","text":"I guess I have no choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_11","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_01_11","text":"Fine. I'll be more patient with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_01_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_poli_01_12","text":"I listen to Poli talk about the challenges of being a police officer.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}