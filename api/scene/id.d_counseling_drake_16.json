{"id":"d_counseling_drake_16","cat":"counsel","group":{"id":"char5024","label":"Drake"},"label":"Advising Drake: 16","stage":null,"prev":"d_counseling_drake_15","next":"d_counseling_drake_17","speakers":{"drake":"Drake"},"icons":{"drake":"si_c101_00_s"},"lines":[{"id":"d_counseling_drake_16_1","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_16_1","text":"I didn't want any sauce with my fried chicken today, but they gave me some anyway.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["drake"],"affinity":"_0"},{"id":"d_counseling_drake_16_2","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_16_2","text":"One of the employees must have screwed up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_16_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_16_3","text":"File a complaint and send that employee packing!","jump":"d_counseling_drake_16_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_drake_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_16_4","text":"Fried chicken is great even with the sauce.","jump":"d_counseling_drake_16_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_drake_16_5","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_16_5","text":"Jeez, have a heart!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_16_6","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_16_6","text":"It was just one little mistake... nothing worth firing someone over.","jump":"d_counseling_drake_16_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_16_7","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_16_7","text":"You're right about that, nothing beats a good piece of fried chicken!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_16_8","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_16_8","text":"I polished off those drumsticks in no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_16_9","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_16_9","text":"Tomorrow I'll order half with sauce and half without. That way, the employee won't get confused.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_16_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_drake_16_10","text":"Drake and I continue to talk about chicken.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}