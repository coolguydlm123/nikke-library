{"id":"event_goddessfall1_02_s","cat":"event","group":{"id":"ev40093","label":"GODDESS FALL · Part 1"},"label":"Headless Goddess: A","stage":null,"prev":"event_goddessfall1_01_e","next":"event_goddessfall1_02_e","speakers":{"nayuta":"Nayuta","nihilister_a":"Nihilister","cecil":"Cecil","nihilister_m":"Nihilister","nayuta_m":"Nayuta","johan_op_l":"Johan","snowwhite":"Snow White","harran":"Harran","nihilister":"Nihilister"},"icons":{"nayuta":"si_c223_00_s","nihilister_a":"si_c261_00_s","cecil":"si_c929_00_s","nihilister_m":"si_c9009_00_s","nayuta_m":"si_c223_00_s","johan_op_l":"si_c925_00_s","snowwhite":"si_c220_00_s","harran":"si_c230_00_s","nihilister":"si_c261_00_s"},"lines":[{"id":"event_goddessfall1_02_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_1","text":"*Swoosh*","jump":null,"exit":false,"enter":null,"bg":"AtlasCage_02","bgArt":"atlascage_02","image":null,"bgm":"none","movie":null,"shown":["nayuta","nihilister_a","cecil"],"affinity":null},{"id":"event_goddessfall1_02_s_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_2","text":"The gate to the Atlas Cage opens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_3","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_3","text":"Thou art liberated, Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_drifter","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_4","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:event_goddessfall1_02_s_4","text":"The Queen...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_5","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_5","text":"She doth reside at an altitude of... Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_6","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_6","text":"Like I said, it's 48 kilometers. Your sense of distance is appalling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_7","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_7","text":"She hath taken position at an altitude of 48 kilometers, and assailed Eden. Eden hath suffered much destruction as a result.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_8","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:event_goddessfall1_02_s_8","text":"No other movements since then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_9","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_9","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_10","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:event_goddessfall1_02_s_10","text":"... Good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_11","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:event_goddessfall1_02_s_11","text":"I'll guide you. Phony Monk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_12","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:event_goddessfall1_02_s_12","text":"I'll take you to where Lilith's body is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_13","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_13","text":"It's best if you put this on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_14","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:event_goddessfall1_02_s_14","text":"What is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_15","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_15","text":"It's a cloak made of signal-blocking material from the Atlas Cage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_16","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_16","text":"If you wear this, the other Heretics won't be able to detect you, and you won't be able to detect them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_17","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_17","text":"It's not a sure thing though, since we don't know precisely how you Heretics share your location data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_18","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:event_goddessfall1_02_s_18","text":"... Give it to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_19","text":"*Flutter*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_20","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nihilister_m"],"affinity":null},{"id":"event_goddessfall1_02_s_21","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_21","text":"Ah, thou dost bear the semblance of a vagrant. Most apt indeed for thee, Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_22","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_22","text":"Shut up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_23","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_23","text":"How about taking a step outside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_24","text":"Nihilister sets one foot outside of the Atlas Cage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_25","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_25","text":"Well, what do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_26","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_26","text":"... I don't sense the others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_27","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_27","text":"Although I can't know if the others can sense me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_28","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_28","text":"At least we know for certain it's half working.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_29","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_29","text":"We possess not the luxury of time to test it, thus let us proceed forthwith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_30","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_30","text":"Do you have transportation? \nIt takes two weeks on foot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_31","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:event_goddessfall1_02_s_31","text":"Launching an aircraft right now would be suicide with the Raptures swarming in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_32","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_32","text":"Do not distress thyself, for I have a plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_33","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_33","text":"Now, let us depart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_34","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_34","text":"... All right. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_35","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_35","text":"What is this?","jump":null,"exit":false,"enter":null,"bg":"BrokenEden","bgArt":"brokeneden","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_36","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_02_s_36","text":"This is Mantra. A cherished companion who serves as my very feet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nayuta_m"],"affinity":null},{"id":"event_goddessfall1_02_s_37","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_37","text":"That's a camel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_38","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_02_s_38","text":"Is there aught wrong with it being a camel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_39","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_39","text":"It'll take ages on such a slow animal. By the time we're back, the Queen might have already conquered the entire world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_40","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_02_s_40","text":"'Tis a folly to judge by mere appearances. Take a seat upon it, then speak thy mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_41","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_41","text":"You sit in front.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_42","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_02_s_42","text":"Do not jest. Shouldst thou embark upon any mischief, I shall be compelled to snap thy neck. Thus, doth it not stand to reason that I ride behind thee, Fire Dragon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_43","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_s_43","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_44","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:event_goddessfall1_02_s_44","text":"The Raptures will be within range in 10 minutes. Everyone, get ready.","jump":null,"exit":false,"enter":null,"bg":"BrokenEdenLandingStrip","bgArt":"brokenedenlandingstrip","image":null,"bgm":null,"movie":null,"shown":["johan_op_l","snowwhite"],"affinity":null},{"id":"event_goddessfall1_02_s_45","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_45","text":"Got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_46","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:event_goddessfall1_02_s_46","text":"Also, the Monk is leaving Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_47","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_47","text":"Nayuta? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_48","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:event_goddessfall1_02_s_48","text":"She's going to secure a secret weapon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_49","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_49","text":"Okay. I'll provide cover.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_50","type":"Speech","speaker":"johan_op_l","key":"Locale_MainScenario:event_goddessfall1_02_s_50","text":"She's leaving through the north corridor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_51","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_51","text":"Roger that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_52","text":"Snow White turns her rifle northward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_53","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_53","text":"From her high vantage point, Snow White looks down across the vast plains.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_54","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_54","text":"It seems like the approaching Raptures are converging into a single point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_55","text":"Snow White places her finger on the trigger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_56","text":"At that moment, a black silhouette shoots out of Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_57","text":"Snow White's reflexes nearly cause her to fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_58","text":"But soon, she realizes it's Nayuta riding a camel, with someone in a hood sitting in front of her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_59","text":"Mantra carries Nayuta and Nihilister at breakneck speed, almost too fast to follow with the naked eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_60","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_60","text":"What is that thing...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["harran"],"affinity":null},{"id":"event_goddessfall1_02_s_61","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_61","text":"Are they taking Mantra? Then there's no need to provide cover.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_62","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_62","text":"It's too fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_63","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_63","text":"Isn't it a camel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_64","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_64","text":"It's an incredibly fast camel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_65","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_65","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_66","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_66","text":"Who's that riding in front of Nayuta?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_67","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_67","text":"That's Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_68","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_68","text":"What...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_69","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_69","text":"She has agreed to help us take down the Queen.","jump":null,"exit":false,"enter":null,"bg":n