cale_MainScenario:event_goddessfall1_02_s_76","text":"Then the Ark is one massive Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_77","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_77","text":"Are you guys sacrificing yourselves for the Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_78","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_78","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_79","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_79","text":"Hehe. Sorry for being petty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_80","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_80","text":"But it might be a good idea to remember who we're up against, Snow White.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_81","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_81","text":"This isn't the time to make such distinctions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_82","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_82","text":"... They're in range.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_83","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall1_02_s_83","text":"Let's engage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_84","type":"Speech","speaker":"harran","key":"Locale_MainScenario:event_goddessfall1_02_s_84","text":"Right. Let's wipe them out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_85","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_85","text":"Nayuta and Nihilister race across the wilderness on the back of Mantra.","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_02","bgArt":"eventscene_goddessfall_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_86","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_86","text":"Head in the 3 o'clock direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_87","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_87","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_88","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_s_88","text":"Mantra veers in that direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_89","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_89","text":"It doth appear the beginning is upon us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_90","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_90","text":"Probably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_91","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_91","text":"The sound of battle will keep drawing in more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_92","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_92","text":"That's why you, human imposters, won't ever reclaim the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_93","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_93","text":"Your only recourse is defense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_94","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_94","text":"Since you are finite while we are infinite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_95","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_95","text":"I thank thee for thy words of encouragement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_96","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_96","text":"How much further?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_97","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_97","text":"At this speed, we will arrive by tomorrow morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_98","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_98","text":"This is one hell of a camel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_99","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_99","text":"Why dost thou seek to dispatch the Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_100","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_100","text":"She is, in essence, thine own mother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_101","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_101","text":"I'm not traveling with you in order to gossip, so just pay attention to the road.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_102","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_102","text":"What difference doth it make? Verily, 'tis better than naught but the sound of breath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_103","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_103","text":"Besides.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_104","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_104","text":"I find myself still unable to place mine trust in thee, Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_105","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_105","text":"I would be deeply grateful for any cause, however small, to place mine trust in thee, even were it but mere words.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_106","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_106","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_107","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_107","text":"Because I don't like her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_108","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_108","text":"I don't like the fact that she gets to be above me just because she's the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_109","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_109","text":"I've never fought with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_110","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_110","text":"But I'm sure I'm stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_111","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_111","text":"There is much room for rebuttal, but I shall refrain. Pray, continue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_112","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_112","text":"I despise having to bow my head to someone who's weaker than me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_113","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_113","text":"just because I happened to be born one way, and she another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_114","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_114","text":"That's the reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_115","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_115","text":"Pray tell, why didst thou not endeavor to challenge her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_116","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_116","text":"How do I challenge someone who's off in space?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_117","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_117","text":"Anyway...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_118","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_118","text":"Even if she were right in front of me, I probably wouldn't be able to start a fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_119","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_119","text":"Is it because thou wert thus born...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_120","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_120","text":"Right. I know even without trying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_121","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_121","text":"I can't challenge the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_122","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_122","text":"I'll just blindly follow her orders like a fool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_123","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_123","text":"That's the power of the Queen's control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_124","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_124","text":"Ah, thou hast thus veered thy way through such nefarious schemes as poison.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_125","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_125","text":"Haha, right. I do whatever it takes to win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_126","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_126","text":"Yet, thou art truly formidable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_127","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_127","text":"The fact that thou hast conceived such a mind, and brought it to execution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_128","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_128","text":"Art thou not denying thy born disposition?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_129","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_129","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_130","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_130","text":"Through such favor, even we may glean the scraps, and for that I find it pleasing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_131","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_131","text":"Stop talking so much and steer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_132","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_s_132","text":"Art thou not curious about mine own tale?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_s_133","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall1_02_s_133","text":"No, I'm not. Just focus on steering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}