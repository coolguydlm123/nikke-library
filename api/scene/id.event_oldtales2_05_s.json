":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_46","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_05_s_46","text":"Every story has an intermission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_47","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_05_s_47","text":"I don't like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_48","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_05_s_48","text":"It's not beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_49","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_05_s_49","text":"It's easy enough to say you don't like something, but not so easy to come up with alternatives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_50","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_05_s_50","text":"For better or worse, I've become stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_51","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_05_s_51","text":"My current strength is incomparable to before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_52","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_05_s_52","text"