{"id":"event_oldtales2_05_s","cat":"event","group":{"id":"ev40062","label":"OLD TALES · Part 2"},"label":"The Most Beautiful Victory: A","stage":null,"prev":"event_oldtales2_04_e","next":"event_oldtales2_05_e","speakers":{"cinderella":"Cinderella","abe":"Abe","oswald":"Oswald"},"icons":{"cinderella":"si_c511_00_s","abe":"si_c979_00_s","oswald":"si_c911_00_s"},"lines":[{"id":"event_oldtales2_05_s_1","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_05_s_1","text":"I didn't expect this kind of talk to come from you.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"event_bgm_oldtales_firstpage","movie":null,"shown":["cinderella","abe"],"affinity":null},{"id":"event_oldtales2_05_s_2","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_05_s_2","text":"Not a word of this to anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_3","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_05_s_3","text":"Having to suffer through this once for my child is difficult enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_4","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales2_05_s_4","text":"Did you say... child?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_5","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales2_05_s_5","text":"Why are you making that weird face?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales2_05_s_6","type":"Speech","speaker":"cinderella","key":"Locale_MainScena