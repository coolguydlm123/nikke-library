{"id":"d_main_39_03","cat":"main","group":{"id":"ch39","label":"Chapter 39 · Gene"},"label":"Heading for the Whale","stage":"39-10 STAGE · Start","prev":"d_main_39_02","next":"d_main_39_04","speakers":{"maxwell_p":"Maxwell","rapi_red":"Rapi"},"icons":{"maxwell_p":"si_c105_00_s","rapi_red":"si_c016_00_s"},"lines":[{"id":"d_main_39_03_1","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_1","text":"Starting countdown.","jump":null,"exit":false,"enter":null,"bg":"EzsUp","bgArt":"ezsup","image":null,"bgm":"bgm_chapter39_field_gliding_a","movie":null,"shown":["maxwell_p","rapi_red"],"affinity":null},{"id":"d_main_39_03_2","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_2","text":"3... 2...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_3","text":"Hang on, give me a sec to prepare myself!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_4","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_4","text":"Cutey, do you know how many times you've been mentally preparing yourself by now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_5","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_5","text":"At this rate, we're gonna lose Mother Whale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_6","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_6","text":"Don't worry. Even if it goes wrong, it's only a fall from a few kilometers up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_7","text":"What about the impact when we launch? I don't think a human body could really handle that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_8","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_8","text":"That's precisely why we packed the interior with shock-absorbent material. There won't be any issues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_9","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_9","text":"Besides, acceleration doesn't happen all at once. It's a gradual increase.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_10","text":"But what about G-forces and stuff like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_11","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_11","text":"I'm sure a tough guy like you can handle that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_12","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_12","text":"You good now? Then let's go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_13","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_13","text":"3... 2...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_14","text":"W-wait!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_15","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_16","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_16","text":"1...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_17","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_17","text":"Launch!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_18","text":"Gaaaaaaaah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_19","text":"In this cramped space, a terrible pressure presses down on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_20","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_20","text":"It feels like the air is crushing my entire body.","jump":null,"exit":false,"enter":null,"bg":"Sky2","bgArt":"sky2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_21","text":"Then, suddenly, I feel like I'm floating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_22","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_22","text":"Urgh... this is definitely rough...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_23","text":"Commander, are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_24","text":"No, I feel like I'm dying...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_25","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_26","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_26","text":"Well, now that we've launched, there's not much we can do, so you'll just have to bear with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_27","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_27","text":"After our run-in with Gluttony, we detect no sign of it nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_28","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_28","text":"Then Whaley appears and swallows Leviathan and Ziz.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_29","text":"I quickly send a message to Raptilion, but there's no reply.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_30","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_30","text":"Whaley is still airborne, and we have to get close to it somehow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_31","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_31","text":"... Even if that means turning ourselves into human projectiles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_32","text":"We calculate Whaley's speed, direction, and altitude, strap ourselves into a rocket, and launch it using the Admire's catapult.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_33","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_33","text":"The rocket was originally meant for long-range supply drops, so we remove the cargo and rig some makeshift seats.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_34","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_03_34","text":"Everyone except me agrees to this ridiculous plan. And now, because I'm outvoted, I'm flying through the sky in a rocket. Yeah, a bonafide rocketman.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_35","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_35","text":"Hold on, how are we supposed to land this thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_36","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_36","text":"It's equipped with a retro-thruster system. If we activate it just before landing on Mother Whale, that should do the trick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_37","text":"What do you mean \"that should do the trick\"? Talk about irresponsible... Gaaahhhh!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_38","text":"At least you're stuck in this cramped space with two ravishing beauties like us. That alone should make it worth your while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_39","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_39","text":"Exactly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_40","text":"Come to think of it, I wonder how Laplace and Drake are doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_41","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_41","text":"I wouldn't worry about them. Those two always find a way to manage somehow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_42","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_42","text":"I would have loved to tag along and keep an eye on them, but the weight limit made that impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_43","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_43","text":"I think splitting up the team was still the right move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_44","text":"Just imagine how noisy it would be with those two crammed in here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_45","text":"Gaahh! Arghhh!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_46","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_46","text":"Heh. As if it's any quieter here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_47","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_47","text":"I don't mind. The Commander has a lovely voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_48","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_48","text":"Oh, I think we'll be landing soon. I can see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_49","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_49","text":"Wow, Mother Whale looks even bigger up close.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_50","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_50","text":"Commander, look out the window. You can see Whaley.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_03_51","text":"Gaaaah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_52","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_03_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_03_53","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_03_53","text":"All right, time to land this bad boy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}