{"id":"d_counseling_quency_20","cat":"counsel","group":{"id":"char5078","label":"Quency"},"label":"Advising Quency: 20","stage":null,"prev":"d_counseling_quency_19","next":null,"speakers":{"quency":"Quency"},"icons":{"quency":"si_c402_00_s"},"lines":[{"id":"d_counseling_quency_20_1","type":"Speech","speaker":"quency","key":"Locale_Counseling:d_counseling_quency_20_1","text":"If the day comes when you start living up on the surface,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["quency"],"affinity":"_0"},{"id":"d_counseling_quency_20_2","type":"Speech","speaker":"quency","key":"Locale_Counseling:d_counseling_quency_20_2","text":"what will become of me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quency_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_quency_20_3","text":"You'd be in a Rehabilitation Center up on the surface.","jump":"d_counseling_quency_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_quency_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_quency_20_4","text":"You'd be right there with me, roaming freely up on the surface.","jump":"d_counseling_quency_20_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_quency_20_5","type":"Speech","speaker":"quency","key":"Locale_Counseling:d_counseling_quency_20_5","text":"*Gasp* You're not serious, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quency_20_6","type":"Speech","speaker":"quency","key":"Locale_Counseling:d_counseling_quency_20_6","text":"If that's a joke, it's not funny.","jump":"d_counseling_quency_20_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quency_20_7","type":"Speech","speaker":"quency","key":"Locale_Counseling:d_counseling_quency_20_7","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quency_20_8","type":"Speech","speaker":"quency","key":"Locale_Counseling:d_counseling_quency_20_8","text":"I wonder what it would feel like living up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quency_20_9","type":"Speech","speaker":"quency","key":"Locale_Counseling:d_counseling_quency_20_9","text":"Whatever it would be like, I hope I get to experience it soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quency_20_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_quency_20_10","text":"Quency and I have another pleasant session.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}