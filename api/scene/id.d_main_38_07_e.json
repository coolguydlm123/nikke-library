null},{"id":"d_main_38_07_e_77","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_38_07_e_77","text":"We can't go with you either. Overseer would need a reason before visiting the Outer Rim, given that we're an inspection unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_07_e_78","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_38_07_e_78","text":"If we went in without one, people would probably suspect us of being corrupt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_07_e_79","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_07_e_79","text":"It's okay. I've got a lot of close connections out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_07_e_80","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_38_07_e_80","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_07_e_81","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_07_e_81","text":"Tell me the location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_07_e_82","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_07_e_82","text":"I'll save her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}