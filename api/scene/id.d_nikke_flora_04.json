ey":"Locale_NikkeEpisode:d_nikke_flora_04_62","text":"I've encountered many hardships with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_63","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_63","text":"Like most of the children, it's simply a matter of finding a way for them to thrive comfortably in my garden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_64","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_64","text":"This place doesn't have natural sunlight, nor the changing of seasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_65","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_65","text":"That's a good point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_66","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_66","text":"Come to think of it, how are you able to grow flowers here in the first place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_67","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_67","text":"This is no ordinary garden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_68","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_68","text":"Artificial lighting has been installed throughout the premises.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_69","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_69","text":"The area is divided into zones based on temperature, and each can be individually managed without affecting the other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_70","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_70","text":"It hasn't been easy for them to adapt to this environment, especially after living up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_71","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_71","text":"The lighting, temperature, and humidity conditions are all different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_72","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_72","text":"Well, it's been a painless process raising mine,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_73","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_73","text":"and that's all thanks to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_74","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_74","text":"Haha, you're too kind. I should be the one thanking you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_75","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_75","text":"I brought you here so abruptly, and then thrust the task of caring for a plant upon you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_76","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_76","text":"Not only did you not refuse, but you're giving it your all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_77","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_77","text":"I'm so grateful to you for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_78","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_78","text":"We've come this far, so I hope you'll be able to make this plant bloom with your own hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_79","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_79","text":"I intend to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_80","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_04_80","text":"I speak to the potted plant again, this time with confidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_81","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_81","text":"Hey there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_82","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_82","text":"We're going to be moving you somewhere warmer today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_83","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_83","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_84","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_84","text":"Haha, you don't need to force yourself to say something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_85","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_85","text":"Even without words, the little ones can feel what you're feeling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_86","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_04_86","text":"Yeah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_87","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_88","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_88","text":"Today could have been a sad day,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_89","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_89","text":"but thanks to you, I feel quite happy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_90","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_90","text":"I'm so glad I decided to gift you that little one, haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}