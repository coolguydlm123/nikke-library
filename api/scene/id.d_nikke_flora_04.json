ull,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_42","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_42","text":"The sadness of the little ones, echoing mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_43","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_43","text":"They are closely attuned to my emotions, so it is to be expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_44","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_44","text":"But I'm okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_45","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_45","text":"And the others will be okay too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_46","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_46","text":"You felt for yourself how extraordinary the vitality of even one small flower is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_47","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_47","text":"We may bend, but we do not break.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_04_48","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_04_48","text":"I am going to plant more, and have another go at raising them.","jump":null,"exit":false,"e