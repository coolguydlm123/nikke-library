cale_NikkeEpisode:d_nikke_emma_02_13","text":"Rather than completing the battle, prioritize survival.","jump":"d_nikke_emma_02_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_14","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_02_14","text":"Escape with all your strength.","jump":"d_nikke_emma_02_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_15","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_emma_02_15","text":"Roger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_16","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_emma_02_16","text":"See you all—alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_17","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_emma_02_17","text":"Even if someone dies here, I'll strike the Missilis head office myself with a bomb in my hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_18","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_emma_02_18","text":"That's so cool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_19","type":"Speech","speaker":"shifty","key":"Locale_NikkeEpisode:d_nikke_emma_02_19","text":"The enemy is coming!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_nikke_emma_02_20","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_emma_02_20","text":"Encounter-","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_21","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_02_21","text":"... Soon after, at the Repair Center.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_22","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_22","text":"... The damage rates are 75% and 90% respectively.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mary"],"affinity":null},{"id":"d_nikke_emma_02_23","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_23","text":"Except for the brain, almost everywhere else is severely damaged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_24","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_24","text":"Fortunately, the brains of both people are not damaged, so they can be saved. But it will take a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_25","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_25","text":"Our center doesn't have stock for some parts. We have to start ordering them from the factory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_26","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_26","text":"Before that, the pain sensor... No, the consciousness itself needs to be taken out for three or four days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_27","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_27","text":"How about going on a vacation during that period?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_28","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_28","text":"Commander, you look terrible... I even want you to live with them at the hospital for a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_29","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_02_29","text":"I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_30","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_30","text":"So, upon expert appraisal, you don't look fine at all...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_31","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_02_31","text":"I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_32","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_32","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_02_33","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_emma_02_33","text":"If you say so. There's nothing I can do.","jump":null,"exit