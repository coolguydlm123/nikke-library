{"id":"msg_m_ex_miranda_01","cat":"messenger","group":{"id":"room_miranda","label":"Miranda · Nikke"},"label":"1. Hello, Commander!!!","stage":null,"prev":null,"next":"msg_m_ex_miranda_02","speakers":{"miranda":"Miranda"},"icons":{"miranda":"si_c032_00_s"},"lines":[{"id":"m_ex_miranda_01_1","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_1","text":"Hello, Commander!!!","jump":null},{"id":"m_ex_miranda_01_2","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_2","text":"I received an order","jump":null},{"id":"m_ex_miranda_01_3","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_3","text":"to work with you from now on!!!","jump":null},{"id":"m_ex_miranda_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_4","text":"I think you're being too excited about it.","jump":null},{"id":"m_ex_miranda_01_5","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_5","text":"Ah, really?","jump":null},{"id":"m_ex_miranda_01_6","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_6","text":"How relaxed should I be?","jump":null},{"id":"m_ex_miranda_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_7","text":"It'll be much better if you take out two exclamation marks.","jump":null},{"id":"m_ex_miranda_01_8","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_8","text":"Is that so?","jump":null},{"id":"m_ex_miranda_01_9","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_9","text":"Understood!","jump":null},{"id":"m_ex_miranda_01_10","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_10","text":"From now on, I will use only one exclamation mark to show my passion when working with you.","jump":null},{"id":"m_ex_miranda_01_11","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_11","text":"Understood!","jump":"m_ex_miranda_01_13"},{"id":"m_ex_miranda_01_12","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_12","text":"Understood-","jump":"m_ex_miranda_01_15"},{"id":"m_ex_miranda_01_13","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_13","text":"Commander, do you also use one exclamation mark to show your passion?","jump":null},{"id":"m_ex_miranda_01_14","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_14","text":"That's awesome!","jump":"m_ex_miranda_01_19"},{"id":"m_ex_miranda_01_15","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_15","text":"The \"-\" symbol...","jump":null},{"id":"m_ex_miranda_01_16","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_16","text":"Are you telling me we need to express our passion normally?","jump":null},{"id":"m_ex_miranda_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_17","text":"Yes, just keep it cool.","jump":null},{"id":"m_ex_miranda_01_18","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_18","text":"The normal level of passion is also very cool!","jump":"m_ex_miranda_01_19"},{"id":"m_ex_miranda_01_19","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_19","text":"So!","jump":null},{"id":"m_ex_miranda_01_20","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_20","text":"I have a few questions for you!","jump":null},{"id":"m_ex_miranda_01_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_21","text":"Say it.","jump":null},{"id":"m_ex_miranda_01_22","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_22","text":"What should I prepare for a mission?","jump":null},{"id":"m_ex_miranda_01_23","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_23","text":"Reflective vest!","jump":null},{"id":"m_ex_miranda_01_24","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_24","text":"LED tripods!","jump":null},{"id":"m_ex_miranda_01_25","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_25","text":"Traffic baton!","jump":null},{"id":"m_ex_miranda_01_26","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_26","text":"Please tell me!","jump":null},{"id":"m_ex_miranda_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_27","text":"Aren't those things for traffic management?","jump":null},{"id":"m_ex_miranda_01_28","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_28","text":"Yes!","jump":null},{"id":"m_ex_miranda_01_29","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_29","text":"They are my trusty friends that I can't go without!","jump":null},{"id":"m_ex_miranda_01_30","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_30","text":"Ah, I almost forgot another thing.","jump":null},{"id":"m_ex_miranda_01_31","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_31","text":"A traffic sign!","jump":null},{"id":"m_ex_miranda_01_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_32","text":"Why do you have a traffic sign?","jump":null},{"id":"m_ex_miranda_01_33","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_33","text":"Oh, that's because","jump":null},{"id":"m_ex_miranda_01_34","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_34","text":"when I was guiding citizens across the street the last time,","jump":null},{"id":"m_ex_miranda_01_35","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_35","text":"I noticed that they didn't follow the signs and just passed by!","jump":null},{"id":"m_ex_miranda_01_36","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_36","text":"So I held one traffic sign in my hand to attract their attention!","jump":null},{"id":"m_ex_miranda_01_37","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_37","text":"Then Poli told me to just keep the sign","jump":null},{"id":"m_ex_miranda_01_38","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_38","text":"as I've already taken it!","jump":null},{"id":"m_ex_miranda_01_39","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_39","text":"So since then, that sign has been mine!","jump":null},{"id":"m_ex_miranda_01_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_40","text":"I see.","jump":null},{"id":"m_ex_miranda_01_41","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_41","text":"That's it!","jump":null},{"id":"m_ex_miranda_01_42","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_42","text":"So which one should I take with me?","jump":null},{"id":"m_ex_miranda_01_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_43","text":"None of them.","jump":null},{"id":"m_ex_miranda_01_44","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_44","text":"What?","jump":null},{"id":"m_ex_miranda_01_45","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_45","text":"But... Why???","jump":null},{"id":"m_ex_miranda_01_46","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_46","text":"Because most of our missions are carried out on the surface.","jump":null},{"id":"m_ex_miranda_01_47","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_47","text":"Oh, right.","jump":null},{"id":"m_ex_miranda_01_48","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_48","text":"The surface.","jump":null},{"id":"m_ex_miranda_01_49","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_49","text":"I almost forgot most of the missions are done on the surface.","jump":null},{"id":"m_ex_miranda_01_50","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_50","text":"So, there's really no need for traffic management.","jump":null},{"id":"m_ex_miranda_01_51","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_51","text":"Well, if that's the case, there's nothing I can prepare for.","jump":null},{"id":"m_ex_miranda_01_52","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_52","text":"I'm such a fool.","jump":null},{"id":"m_ex_miranda_01_53","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_53","text":"But you have to bring your gun.","jump":null},{"id":"m_ex_miranda_01_54","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_54","text":"!!!","jump":null},{"id":"m_ex_miranda_01_55","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_55","text":"Right, I need to bring my gun!","jump":null},{"id":"m_ex_miranda_01_56","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_56","text":"I'll take the gun with me!","jump":null},{"id":"m_ex_miranda_01_57","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_57","text":"Thank you for your advice, Commander!","jump":null},{"id":"m_ex_miranda_01_58","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_miranda_01_58","text":"I'll not forget to bring my gun!","jump":null},{"id":"m_ex_miranda_01_59","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_miranda_01_59","text":"Okay.","jump":null}],"chat":true}