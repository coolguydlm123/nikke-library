tmaid_01_38","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anchor_innocentmaid_01_38","text":"Yes, I had something to discuss with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_innocentmaid_01_39","type":"Speech","speaker":"anchor_m","key":"Locale_NikkeEpisode:d_nikke_anchor_innocentmaid_01_39","text":"Is it about the sea?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_innocentmaid_01_40","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anchor_innocentmaid_01_40","text":"Actually... yes, surprisingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_innocentmaid_01_41","type":"Speech","speaker":"cocoa","key":"Locale_NikkeEpisode:d_nikke_anchor_innocentmaid_01_41","text":"Are you going out to sea?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_innocentmaid_01_42","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anchor_innocentmaid_01_42","text":"You know how I temporarily stepped in and managed a maid cafe branch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_innocentmaid_01_43","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anchor_innocentmaid_01_43","text":"I had planned on arranging an after-party out at sea with everyone I worked with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_innocentmaid_01_44","type":"Speech","speaker":"soda","key":"Locale_NikkeEpisode:d_nikke_anchor_innocen