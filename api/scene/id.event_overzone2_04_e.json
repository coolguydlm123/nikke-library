rzone2_04_e_5","type":"Speech","speaker":"pinne","key":"Locale_MainScenario:event_overzone2_04_e_5","text":"Grab the front legs and put them over your shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_e_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_e_6","text":"That's what Pinne says to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_e_7","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_e_7","text":"Uh... sorry, I didn't catch that. One more time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_e_8","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_e_8","text":"Pinne said to take the front legs and sling them over your shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_e_9","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_e_9","text":"Take the front legs... over the shoulder... put my back into it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_e_10","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_e_10","text":"Ooof!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_e_11","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_e_11","text":"Hey, I did it! I'm carrying it!","jump":null,"exit":false,"enter":null,"bg":null