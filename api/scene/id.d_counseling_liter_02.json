{"id":"d_counseling_liter_02","cat":"counsel","group":{"id":"char5011","label":"Liter"},"label":"Advising Liter: 02","stage":null,"prev":"d_counseling_liter_01","next":"d_counseling_liter_03","speakers":{"liter":"Liter"},"icons":{"liter":"si_c082_00_s"},"lines":[{"id":"d_counseling_liter_02_1","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_1","text":"Greenhorn, imagine you had a dog.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["liter"],"affinity":"_0"},{"id":"d_counseling_liter_02_2","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_2","text":"Now, imagine that dog was doing its business in a place where people don't usually go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_02_3","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_3","text":"Would you clean it up, or just leave it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_02_4","text":"It wouldn't be so bad to leave it, right? Just once?","jump":"d_counseling_liter_02_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_liter_02_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_02_5","text":"I would still clean it up.","jump":"d_counseling_liter_02_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_liter_02_6","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_6","text":"You rapscallion!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_02_7","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_7","text":"You don't deserve to be a dog owner!","jump":"d_counseling_liter_02_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_02_8","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_8","text":"That's right! Of course you have to clean it up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_02_9","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_9","text":"You can't just leave it even if nobody's around. You're going to make all of us dog owners look bad!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_02_10","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_02_10","text":"Hey, you're a pretty good dog owner, Greenhorn!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_02_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_liter_02_11","text":"... I don't have the heart to tell Liter I don't actually have a dog.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}