13","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_13","text":"I didn't go through hell! And suffer like a dog! Just for this to happen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_14","text":"*Thud thud thud*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_15","text":"His military boots leave black skid marks on the white wall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_16","text":"After some time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_17","text":"the Commander drops to his knees, gasping for breath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_18","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_18","text":"*Gasp gasp*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_19","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_19","text":"Are you finished?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_20","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_20","text":"Hah... Yeah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_21","text":"*Crash*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_22","text":"Liliweiss slams her fist into the wall,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_23","text":"sending debris flying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_24","text":"Behind where the wall once stood, bewildered Central Government soldiers come into view.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_25","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_26","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_26","text":"Argh... what should I do? I can't shake off my anger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_27","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_27","text":"Hold it in. If you keep at it, you'll get arrested.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_28","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_28","text":"Ah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_29","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_29","text":"Damn it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_30","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_30","text":"I can't believe this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_31","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_31","text":"What the... What's going on here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["CGplatoonleader"],"affinity":null},{"id":"event_arkguardian1_02_e_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_32","text":"The soldiers rush forward, staring wide-eyed at the hole in the wall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_33","text":"At first, some glare with hostility, but when they see the Commander and Liliweiss standing before them, their expressions change.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_34","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_34","text":"G-Goddess...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_02_e_35","text":"The platoon leader and his soldiers stand at attention and salute in perfect unison.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_36","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_36","text":"Huh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_37","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_37","text":"At ease, gentlemen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_38","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_38","text":"T-to meet a Goddess herself in person...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_39","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_39","text":"Wh-what an incredible honor! T-truly a great honor indeed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_40","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_40","text":"What's all this nonsense about honor? What are we, a cult?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_41","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_41","text":"My apologies, sir! It's just such an honor to meet the people I've always admired that I'm all tongue-tied! I shall sever this worthless tongue at once!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_42","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_42","text":"Ugh... These fanatics are the worst. I can't stand them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_43","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_43","text":"Same here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_44","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_44","text":"It's truly an honor to meet the likes of you two, who have always fought on behalf of all humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_45","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_45","text":"Well, it's not like we're the only ones fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_46","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_46","text":"Judging by that insignia, you're a platoon leader. You're doing your part too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_47","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_47","text":"Oh no! Compared to the great work you two are doing, my contributions are utterly insignificant! I'm pathetic! Worthless! Human garbage!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_48","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_48","text":"This is exhausting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_49","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_49","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_50","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_50","text":"If I may, could I inquire as to what caused this hole in the wall?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_51","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_51","text":"If there's been any inconvenience at all, please tell me, and I'll fix it! No matter what it takes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_52","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_52","text":"Oh, that hole?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_53","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_53","text":"This big honkin' Mecha Destructor came out of nowhere and smashed a hole in the waaallllll—Owww!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_54","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_54","text":"Hey. Stop pinching me! Don't you realize how strong you are? That's more like a vice than a pinch!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_55","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_55","text":"Well, I can't exactly hit you, can I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_56","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_56","text":"True...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_57","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_57","text":"A... Mecha Destructor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_58","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_58","text":"Er... isn't that Major Liliweiss's nickname...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_59","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_59","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_60","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_61","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_02_e_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_62","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_62","text":"M-my apologies, sir! My lips are sealed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_63","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_02_e_63","text":"Excuse me, but who told you that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_02_e_64","type":"Speech","speaker":"CGplatoonleader","key":"Locale_MainScenario:event_arkguardian1_02_e_64","text":"No one told me per se, but an ano