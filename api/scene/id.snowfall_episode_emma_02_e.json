emma_02_e_6","type":"Self","speaker":"Self","key":"Locale_SubScenario:snowfall_episode_emma_02_e_9","text":"Are you going to walk into the waterfall?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_emma_02_e_7","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_episode_emma_02_e_10","text":"You bet I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_emma_02_e_8","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_episode_emma_02_e_11","text":"The water is too shallow here. It'll probably be easier to catch fish where it's deeper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_emma_02_e_9","type":"Self","speaker":"Self","key":"Locale_SubScenario:snowfall_episode_emma_02_e_12","text":"Let me do it then. The water is freezing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_emma_02_e_10","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_episode_emma_02_e_13","text":"But if you go in, you're liable to get a cold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_emma_02_e_11","type":"Speech","speaker":"emma","key":"Locale_SubScenario:snowfall_episode_emma_02_e_14","text":"I'll be in and out in no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_episode_emma_02_e_12","type":"Self","speaker":"Self","key":"Locale_SubScenario:snowfall_episode_emma_02_e_15","text":"Please, I insist. Let me do it.","jump":null