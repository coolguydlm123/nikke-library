{"id":"d_main_40_06","cat":"main","group":{"id":"ch40","label":"Chapter 40 · Choice"},"label":"Quiet Shade","stage":"40-22 STAGE · Start","prev":"d_main_40_05","next":"d_main_40_07","speakers":{"nayuta_n":"Nayuta","rapi_red":"Rapi","liberalio":"Liberalio"},"icons":{"nayuta_n":"si_c9008_00_s","rapi_red":"si_c016_00_s","liberalio":"si_c262_00_s"},"lines":[{"id":"d_main_40_06_1","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_06_1","text":"Here, Great Hero. Take this.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_chapter40_field_turningpoint_b","movie":null,"shown":["nayuta_n"],"affinity":null},{"id":"d_main_40_06_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_06_2","text":"Nayuta hands me something that looks like a small clockwork gear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_3","text":"Is this one of Pinocchio's parts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_4","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_06_4","text":"'Tis so. It is crafted with technology unknown even to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_5","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_06_5","text":"Well, 'tis unknown whether she was crafted, or perhaps...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_6","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_06_6","text":"In any case, mine understanding of this craft is long outdated. Were we in the Ark, perchance we could uncover its secrets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_7","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_06_7","text":"Thus, I shall entrust this unto thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_8","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_8","text":"All right. I'll make sure it gets there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_9","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_06_9","text":"We start heading in the direction Leviathan and Ziz went.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi_red"],"affinity":null},{"id":"d_main_40_06_10","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_06_10","text":"Fortunately, we're soon in the shade, which makes the journey easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_11","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_11","text":"Commander. What are you planning on doing when we meet with Leviathan and Ziz?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_12","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_12","text":"It's highly likely that the Four Beasts have successfully completed a Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_13","text":"I'll request a meeting with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_14","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_14","text":"Do you think that's possible? We haven't even been able to have a civil conversation with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_15","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_15","text":"This might sound strange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_16","text":"But Leviathan and Ziz won't be able to hold out for much longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_17","text":"What do you mean? Are you saying they don't have long to live?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_18","text":"No, it's not that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_19","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_19","text":"I mean, it won't be much longer before they cross over to our side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_20","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_20","text":"From what I can tell, they don't seem to have changed at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_21","text":"If they were still as intransigent as before, they wouldn't be hanging around Raptilion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_22","text":"We all know how affable Raptilion is, but even that shouldn't have been enough to get past Leviathan's wariness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_23","text":"And yet, they traveled together. That tells me they've at least learned how to converse with others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_24","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_24","text":"So, you're saying our persistent persuasion has begun to chip away at the emotional walls they've built up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_25","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_25","text":"That seems to be true. If it were the old Leviathan, the moment she thought Raptilion had betrayed her...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_26","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_26","text":"She would have dealt a fatal blow and run off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_27","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_27","text":"Would Leviathan really think Raptilion has betrayed her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_28","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_29","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_29","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_30","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_30","text":"I think she ran away because she felt self-conscious about facing us again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_31","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_31","text":"Yeah. I think so too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_32","text":"If she'd truly intended to run away, Ziz could have flown them out of there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_33","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_33","text":"... So you're saying they're waiting for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_34","text":"Most likely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_35","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_35","text":"You really do know how to read women, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_36","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_36","text":"But isn't Leviathan a bit dangerous? There's more to her situation than simple emotional defenses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_38","text":"Anyway, if she ends up coming over to our side, and we go meet the Four Beasts' Queen...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_39","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_39","text":"What will be your next move?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_40","text":"Not sure. We'll just have to play it by ear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_41","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_41","text":"Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_42","text":"I know this sounds crazy, but I really don't feel that we're in any danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_43","text":"I can't explain why, but... I feel like things are going to work out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_44","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_45","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_45","text":"That's a pretty convincing way of saying you have no plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_46","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_46","text":"... Guilty as charged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_47","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_47","text":"... Understood. Nevertheless, I have faith in your judgment, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_48","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_06_48","text":"I hope this all works out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_06_49","text":"Suddenly, the shade that had been sheltering us began to recede quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_06_50","text":"Oh, the shade is gone. It's gonna get hot...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_06_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_06_52","text":"As I watch the receding shade, something dawns on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_quietterror","movie":null,"shown":null,"affinity":null},{"id":"d_main_40_06_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_40_06_53","text":"We're on the back of Whaley, flying through mid-air, so there shouldn't be anything to shade us from the sun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":nu