affinity":null},{"id":"d_nikke_viper_05_76","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_76","text":"After all the trouble I went through to pull this off, don't you have anything nice to say to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_77","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_77","text":"Then again, it's not like l care what you say about me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_78","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_78","text":"Do you really think what you've done here is praiseworthy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_79","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_79","text":"Why not? I know things may not have gone exactly according to plan, but it all worked out in the end, didn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_80","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_80","text":"On top of that, Honey-buns is in our debt now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_81","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_81","text":"If you ask me, that's much more valuable than extracting random information from some low-level thug.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_82","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_82","text":"That's not the point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_83","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_83","text":"It isn't? What is the point then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_84","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_84","text":"... Hah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_crawlinganxiety","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_85","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_85","text":"You're no different from that \"low-level thug.\" You're both slaves to your most base desires.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_86","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_86","text":"What?! Are you trying to start something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_87","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_87","text":"In fact, you're probably worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_88","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_88","text":"You're far more conniving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_89","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_90","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_90","text":"Captain, I didn't realize you took such an interest in what I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_91","type":"Speech","speaker":"viper","key":"Locale_NikkeEpisode:d_nikke_viper_05_91","text":"Considering how nosy you're being, you must really disapprove of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_92","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_92","text":"You say I'm nosy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_93","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_93","text":"Just remember that the only reason I haven't put a stop to your bumbling yet is that you're still of some use to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_94","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_94","text":"The Commander's beliefs are poisoning your mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_viper_05_95","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_viper_05_95","text":"You might think that you're in control,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt"