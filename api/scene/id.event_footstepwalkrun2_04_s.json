{"id":"event_footstepwalkrun2_04_s","cat":"event","group":{"id":"ev40066","label":"FOOTSTEP, WALK, RUN · Part 1"},"label":"Like a Miracle: A","stage":null,"prev":"event_footstepwalkrun2_intermission_01","next":"event_footstepwalkrun2_04_e","speakers":{"redhood":"Red Hood","rapi_m":"Rapi"},"icons":{"redhood":"si_c470_00_s","rapi_m":"si_c994_00_s"},"lines":[{"id":"event_footstepwalkrun2_04_s_1","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_s_1","text":"Hmm. Too slow.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_03","bgArt":"wasteland_03","image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":["rapi_m","redhood"],"affinity":null},{"id":"event_footstepwalkrun2_04_s_2","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_s_2","text":"If I speed up, my shooting will become too unstable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_s_3","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_s_3","text":"Then keep practicing until your shooting is stable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_s_4","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun2_04_s_4","text":"It feels inefficient to shoot while moving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_s_5","type":"Speech","speaker":"redhood","key":"Locale_MainScenario:event_footstepwalkrun2_04_s_5","text":"Then don't do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_04_s_6","type":"Speech","