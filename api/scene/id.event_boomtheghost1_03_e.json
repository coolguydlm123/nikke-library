,{"id":"event_boomtheghost1_03_e_91","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_03_e_91","text":"Are you implying that there's some unscientific explanation? That some supernatural entity did this? Like... a ghost?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_03_e_92","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_03_e_92","text":"Haha. Y-you're so silly, Commander. There is no such thing. At least, there shouldn't be. I hope there's not...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_03_e_93","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_03_e_93","text":"Rapi, snap out of it. You're losing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_03_e_94","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_03_e_94","text":"Far from it. I'm the calmest, most rational one amongst us right now. You're the one who's lost all sense of reason...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_03_e_95","type":"Speech","speaker":"unknown_ghost","key":"Locale_MainScenario:event_boomtheghost1_03_e_95","text":"Farewell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["unknown_ghost"],"affinity":null},{"id":"event_boomtheghost1_03_e_96","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_03_e_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity"