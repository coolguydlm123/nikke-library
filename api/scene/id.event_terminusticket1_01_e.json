,"affinity":null},{"id":"event_terminusticket1_01_e_52","type":"Speech","speaker":"soline_w","key":"Locale_MainScenario:event_terminusticket1_01_e_52","text":"Honestly, it is a risk. There's no denying that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_e_53","type":"Speech","speaker":"soline_w","key":"Locale_MainScenario:event_terminusticket1_01_e_53","text":"Are you really okay with this, Nora?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_e_54","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_e_54","text":"I told you, didn't I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_e_55","type":"Speech","speaker":"nora","key":"Locale_MainScenario:event_terminusticket1_01_e_55","text":"My dream is to close my eyes for the last time on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_e_56","type":"Speech","speaker":"soline_w","key":"Locale_MainScenario:event_terminusticket1_01_e_56","text":"Okay, okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_e_57","type":"Speech","speaker":"soline_w","key":"Locale_MainScenario:event_terminusticket1_01_e_57","text":"You know, the higher-ups are really grateful to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_terminusticket1_01_e_58","type":"Speech","speaker":"soline_w","key":"Locale_MainScenario:event_terminusticket1_01_e_58","