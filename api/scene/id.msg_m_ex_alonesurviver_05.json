{"id":"msg_m_ex_alonesurviver_05","cat":"messenger","group":{"id":"room_alonesurviver","label":"Snow Mountain Rescue Team · Group"},"label":"4. Survivalist! Neve!","stage":null,"prev":"msg_m_ex_alonesurviver_03","next":null,"speakers":{"tove":"Tove","neve":"Neve","alice":"Alice"},"icons":{"tove":"si_c192_00_s","neve":"si_c193_00_s","alice":"si_c191_00_s"},"lines":[{"id":"msg_m_ex_alonesurviver_05_unlock","type":"Narration","speaker":null,"text":"Unlocks: Clear event stage 103320112 · After Survival Expert? chat 1. Um...","key":null},{"id":"m_ex_alonesurviver_05_1","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_1","text":"Survivalist! Neve!","jump":null},{"id":"m_ex_alonesurviver_05_2","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_2","text":"Have you arrived at the Outpost?","jump":null},{"id":"m_ex_alonesurviver_05_3","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_3","text":"Yep!","jump":null},{"id":"m_ex_alonesurviver_05_4","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_4","text":"I successfully escorted him to the elevator leading to the Outpost.","jump":null},{"id":"m_ex_alonesurviver_05_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_5","text":"I arrived safe and sound, thanks to Neve.","jump":null},{"id":"m_ex_alonesurviver_05_6","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_6","text":"Excellent.","jump":null},{"id":"m_ex_alonesurviver_05_7","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_7","text":"It's too bad","jump":null},{"id":"m_ex_alonesurviver_05_8","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_8","text":"I couldn't accompany you :(","jump":null},{"id":"m_ex_alonesurviver_05_9","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_9","text":"No no, this won't do.","jump":null},{"id":"m_ex_alonesurviver_05_10","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_10","text":"Pigeon, you ought to go running with Princess!","jump":null},{"id":"m_ex_alonesurviver_05_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_11","text":"She can run already?","jump":null},{"id":"m_ex_alonesurviver_05_12","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_12","text":"Sure she can!","jump":null},{"id":"m_ex_alonesurviver_05_13","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_13","text":"Survivalist,","jump":null},{"id":"m_ex_alonesurviver_05_14","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_14","text":"The Nikke we rescued","jump":null},{"id":"m_ex_alonesurviver_05_15","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_15","text":"recovered much more quickly","jump":null},{"id":"m_ex_alonesurviver_05_16","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_16","text":"than we anticipated.","jump":null},{"id":"m_ex_alonesurviver_05_17","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_17","text":"Once she trains with us a little more,","jump":null},{"id":"m_ex_alonesurviver_05_18","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_18","text":"she'll be able to return back to the Ark.","jump":null},{"id":"m_ex_alonesurviver_05_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_19","text":"That's good news.","jump":null},{"id":"m_ex_alonesurviver_05_20","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_20","text":"Definitely!","jump":null},{"id":"m_ex_alonesurviver_05_21","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_21","text":"You should have seen Pigeon, Rabbity.","jump":null},{"id":"m_ex_alonesurviver_05_22","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_22","text":"She was bawling her eyes out.","jump":null},{"id":"m_ex_alonesurviver_05_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_23","text":"She was crying again?","jump":null},{"id":"m_ex_alonesurviver_05_24","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_24","text":"Yeah, but they were tears of joy :3","jump":null},{"id":"m_ex_alonesurviver_05_25","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_25","text":"She was so happy that Princess could run.","jump":null},{"id":"m_ex_alonesurviver_05_26","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_26","text":"Alice!","jump":null},{"id":"m_ex_alonesurviver_05_27","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_27","text":"That was supposed to be a secret between you and me!","jump":null},{"id":"m_ex_alonesurviver_05_28","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_28","text":"Oh, right!","jump":null},{"id":"m_ex_alonesurviver_05_29","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_29","text":"I thought that didn't include Rabbity.","jump":null},{"id":"m_ex_alonesurviver_05_30","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_30","text":"Sorry :/","jump":null},{"id":"m_ex_alonesurviver_05_31","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_31","text":"It's okay,","jump":null},{"id":"m_ex_alonesurviver_05_32","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_32","text":"Survivalist has already seen many sides of me.","jump":null},{"id":"m_ex_alonesurviver_05_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_33","text":"It's okay. It's perfectly normal to cry.","jump":null},{"id":"m_ex_alonesurviver_05_34","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_34","text":":'(","jump":null},{"id":"m_ex_alonesurviver_05_35","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_35","text":"Speaking of which, Neve.","jump":null},{"id":"m_ex_alonesurviver_05_36","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_36","text":"Ludmilla has been asking when you'll be back.","jump":null},{"id":"m_ex_alonesurviver_05_37","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_37","text":"Me?","jump":null},{"id":"m_ex_alonesurviver_05_38","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_38","text":"Hard to say.","jump":null},{"id":"m_ex_alonesurviver_05_39","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_39","text":"Actually, I'm feeling pretty sleepy,","jump":null},{"id":"m_ex_alonesurviver_05_40","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_40","text":"so I'm on the hunt for a warm place to huddle down for the night.","jump":null},{"id":"m_ex_alonesurviver_05_41","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_41","text":"I noticed that the road near the Northern Base is now cleared.","jump":null},{"id":"m_ex_alonesurviver_05_42","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_42","text":"Something tells me there will be plenty of good spots there,","jump":null},{"id":"m_ex_alonesurviver_05_43","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_43","text":"I can just feel it.","jump":null},{"id":"m_ex_alonesurviver_05_44","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_44","text":"I'm gonna go check it out.","jump":null},{"id":"m_ex_alonesurviver_05_45","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_45","text":"You're going alone?","jump":null},{"id":"m_ex_alonesurviver_05_46","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_46","text":"Isn't that dangerous?","jump":null},{"id":"m_ex_alonesurviver_05_47","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_47","text":"I'm exhausted!","jump":null},{"id":"m_ex_alonesurviver_05_48","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_48","text":"I don't think I can hold on and wait for anyone.","jump":null},{"id":"m_ex_alonesurviver_05_49","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_49","text":"Wouldn't it be better to sleep at the base?","jump":null},{"id":"m_ex_alonesurviver_05_50","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_50","text":"But I want to sleep right now.","jump":null},{"id":"m_ex_alonesurviver_05_51","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_51","text":"Just hold on until you get there, then you can have a nice, long sleep.","jump":null},{"id":"m_ex_alonesurviver_05_52","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_52","text":"!!","jump":null},{"id":"m_ex_alonesurviver_05_53","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_53","text":"Yeah!","jump":null},{"id":"m_ex_alonesurviver_05_54","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_54","text":"You've got a point.","jump":null},{"id":"m_ex_alonesurviver_05_55","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_55","text":"I'll think about it.","jump":null},{"id":"m_ex_alonesurviver_05_56","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_alonesurviver_05_56","text":"Okay, just be careful.","jump":null},{"id":"m_ex_alonesurviver_05_57","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_57","text":"I will.","jump":null},{"id":"m_ex_alonesurviver_05_58","type":"Speech","speaker":"tove","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_58","text":"Take care, Neve!","jump":null},{"id":"m_ex_alonesurviver_05_59","type":"Speech","speaker":"alice","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_59","text":"Nanook, we'll be waiting for you <3","jump":null},{"id":"m_ex_alonesurviver_05_60","type":"Speech","speaker":"neve","key":"Locale_SuddenMessage:m_ex_alonesurviver_05_60","text":"I'll see you all soon.","jump":null}],"chat":true}