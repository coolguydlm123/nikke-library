ch","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_12","text":"Yeah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_13","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_13","text":"But I don't want to do it alone.\nLet's take them together.","jump":"d_counseling_arcanafortunemate_15_20","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_14","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_14","text":"They say people who take landscapes\nwant to cherish the memory of specific moments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_15","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_15","text":"Memories are nice and all,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_16","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_16","text":"but if you lose your memory, they're gone for good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_17","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_arcanafortunemate_15_17","text":"The most precious memories stay with you forever, no matter what.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_18","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_18","text":"That would sound cheesy coming from anyone else...\nI wonder why it sounds so cool when you say it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_19","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_19","text":"Did you learn public speaking in school or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_20","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_arcanafortunemate_15_20","text":"I talk with Arcana about the meaning of pictures.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}