{"id":"d_counseling_arcanafortunemate_15","cat":"counsel","group":{"id":"char5167","label":"Arcana: Fortune Mate"},"label":"Advising Arcana: Fortune Mate 15","stage":null,"prev":"d_counseling_arcanafortunemate_14","next":"d_counseling_arcanafortunemate_16","speakers":{"arcana_s":"Arcana"},"icons":{"arcana_s":"si_c583_00_s"},"lines":[{"id":"d_counseling_arcanafortunemate_15_01","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_01","text":"There are different types of photographers.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["arcana_s"],"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_02","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_02","text":"Some only take portraits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_03","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_03","text":"Others only take scenic photos.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_04","type":"Speech","speaker":"arcana_s","key":"Locale_Counseling:d_counseling_arcanafortunemate_15_04","text":"Which do you like more?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcanafortunemate_15_05","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arcanafortunemate_15_05","text":"Portraits.","jump":"d_counseling_arcanafortunemate_15_07","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_arcanafortunemate_