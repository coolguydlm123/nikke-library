inScenario:event_beautyfullshot2_04_s_5","text":"You're just stupidly strong! Do you realize how heavy this helm is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_6","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_6","text":"It's no heavier than a firearm. You just don't know how to use your body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_7","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_7","text":"Honey, is that true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_8","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_8","text":"You of all people should know whether I know how to use my body or not♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_9","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_9","text":"Keep Mister out of this and grab hold of the helm. We don't have all day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_10","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_10","text":"Rosanna and Viper are keeping themselves busy with steering the boat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_11","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_11","text":"... When can I take photos?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_12","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_12","text":"I meet Sakura's eyes, who is walking alone in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["sakura_s","anis_s","neon_s","rapi_s","mary_s"],"affinity":null},{"id":"event_beautyfullshot2_04_s_13","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_13","text":"She flashes me a beaming smile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_14","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_15","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_15","text":"Master, you better close your mouth before a mosquito flies into it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_16","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_16","text":"You're drooling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_17","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_17","text":"We've completed our exploration of the island.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_18","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_18","text":"O-oh, you have? Well done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_19","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_19","text":"How did it go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_20","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_20","text":"We checked to see whether it met all the conditions that Mustang stipulated,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_21","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_21","text":"and our conclusion is that this place will be suitable for human habitation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_22","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_22","text":"Of course, this is all still speculative in nature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_23","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_23","text":"We didn't detect any venomous flora or fauna, and all the fruit seems to be edible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_24","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_24","text":"... With the notable exception of Rafflesia, that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_25","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_25","text":"The island will never be completely submerged, even during high tide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_26","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_26","text":"While some freak weather could potentially change that, overall, it's a safe place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_27","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_27","text":"According to Maiden and Guilty, none of the marine life here poses a threat to humans either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_28","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_28","text":"Even the jellyfish aren't fatal. As long as you steer clear of the pufferfish, it's not very dangerous at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_29","type":"Speech","speaker":"mary_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_29","text":"There are also quite a few plants here that could be used for treatment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_30","type":"Speech","speaker":"anis_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_30","text":"Since it's an island, it's relatively isolated and safe from Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_31","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_31","text":"Plus there are numerous other islands in this archipelago that most likely have similar environments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_32","type":"Speech","speaker":"neon_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_32","text":"If we were to expand the settlement to other islands, we'd have quite a lot of space to work with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_33","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_33","text":"It's not perfect, but it's absolutely capable of sustaining human life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_34","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_34","text":"The population would have to be kept under 200 people, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_35","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_35","text":"That's a bit disappointing about the population cap, but still, this is quite impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_36","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_36","text":"Yes. If we continue to find places like this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_37","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_37","text":"we can still have hope, even in a worst-case scenario where the Ark is destroyed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_38","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_38","text":"... Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_39","type":"Speech","speaker":"rapi_s","key":"Locale_MainScenario:event_beautyfullshot2_04_s_39","text":"That concludes our exploration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_40","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_40","text":"Nicely done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_04_s_41","type":"Self","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_04_s_41","text":"Now, it's time to rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfu