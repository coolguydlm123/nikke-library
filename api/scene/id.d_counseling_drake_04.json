{"id":"d_counseling_drake_04","cat":"counsel","group":{"id":"char5024","label":"Drake"},"label":"Advising Drake: 04","stage":null,"prev":"d_counseling_drake_03","next":"d_counseling_drake_05","speakers":{"drake":"Drake"},"icons":{"drake":"si_c101_00_s"},"lines":[{"id":"d_counseling_drake_04_1","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_04_1","text":"I saw an old man fall down on the street today!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["drake"],"affinity":"_0"},{"id":"d_counseling_drake_04_2","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_04_2","text":"I can't believe no one went to help him!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_04_3","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_04_3","text":"So, I used my own strength!\nI picked him right up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_drake_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_04_4","text":"You should've let him get up on his own.","jump":"d_counseling_drake_04_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_drake_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_drake_04_5","text":"How admirable of you.","jump":"d_counseling_drake_04_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_drake_04_6","type":"Speech","speaker":"drake","key":"Locale_Counseling:d_counseling_drake_04_6","text":"Moron! How stupid!\nHow could I treat a poor old man like