{"id":"d_counseling_yuni_03","cat":"counsel","group":{"id":"char5006","label":"Yuni"},"label":"Advising Yuni: 03","stage":null,"prev":"d_counseling_yuni_02","next":"d_counseling_yuni_04","speakers":{"yuni":"Yuni"},"icons":{"yuni":"si_c160_00_s"},"lines":[{"id":"d_counseling_yuni_03_1","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_1","text":"Capturing Raptures is my job, but I'm no good at it.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["yuni"],"affinity":"_0"},{"id":"d_counseling_yuni_03_2","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_2","text":"Commander, do you know what happens to a Rapture once it's captured?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_03_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_03_3","text":"They're studied and then returned to their home.","jump":"d_counseling_yuni_03_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_yuni_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_03_4","text":"... They probably get disposed of.","jump":"d_counseling_yuni_03_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_yuni_03_5","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_5","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_03_6","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_6","text":"I'm not a child, you know.\nYou don't have to lie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_03_7","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_7","text":"Nevertheless, thank you for being so considerate.","jump":"d_counseling_yuni_03_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_03_8","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_8","text":"... That's what I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_03_9","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_9","text":"Everyone else lies to me when I ask them that question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_03_10","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_03_10","text":"But not you, Commander. You're a good person.","jump":"d_counseling_yuni_03_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_03_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_03_11","text":"I have a light-hearted conversation with Yuni about the Raptures.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}