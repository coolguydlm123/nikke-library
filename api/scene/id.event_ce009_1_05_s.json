l,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_55","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_1_05_s_55","text":"Maybe the D-Waves changed them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_56","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_56","text":"That's definitely possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_57","type":"Speech","speaker":"quency_e","key":"Locale_SubScenario:event_ce009_1_05_s_57","text":"Then why don't we call them D-Shadows to differentiate them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_58","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_05_s_58","text":"Good point. If they're different from the Shadows we know, we should probably call them something else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_59","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_05_s_59","text":"But if they're still Shadows, only Personas can defeat them. We may have to be on the front lines...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_60","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_60","text":"If the D-Waves have changed them, that might not be true anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_61","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_61","text":"We'll have to fight them first, analyze the battle data, and come up with a strategy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_62","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_05_s_62","text":"That sounds good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_63","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_63","text":"Can we pause for a second?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_64","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_64","text":"While we're talking, Queen absentmindedly lines up four sugar cubes in a row.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_65","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_65","text":"Before we go looking for the Gatekeeper, it feels like there are too many issues tangled together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_66","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_66","text":"Let me sort out exactly what's happening first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_67","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_67","text":"Be my guest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_68","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_68","text":"First, the five of us were summoned here to the Ark three days ago. Five days before that, someone else was summoned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_69","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_69","text":"That brings the total number of people summoned to the Ark to six. Since that person isn't any of us... they're most likely the remaining phantom thief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_70","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_70","text":"Then there's the mass loss of consciousness, and the D-Shadows, which are different from the Shadows we know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_71","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_71","text":"Altogether, that's four incidents that have occurred since the D-Waves began,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_72","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_72","text":"with the D-Shadows being the most recent...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_73","type":"Speech","speaker":"ce009_04","key":"Locale_SubScenario:event_ce009_1_05_s_73","text":"Ooh! That's beary easy to understand!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_74","type":"Speech","speaker":"miranda_c","key":"Locale_SubScenario:event_ce009_1_05_s_74","text":"That's right! You're very smart!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_75","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_05_s_75","text":"Naturally, Queen's the strategist of the Phantom Thieves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_76","type":"Speech","speaker":"phantom","key":"Locale_SubScenario:event_ce009_1_05_s_76","text":"Strategist...? I ought to consider recruiting one for the Thieves of Justice as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_77","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_77","text":"Aigis, who has been listening to the discussion, speaks up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_78","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_1_05_s_78","text":"From my perspective, the third and fourth incidents,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_79","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_1_05_s_79","text":"the loss of consciousness cases and the D-Shadows, are highly likely to be connected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_80","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_80","text":"Aigis places the third sugar cube on top of the fourth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_81","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_1_05_s_81","text":"The Shadows I've fought attacked people, and those they attacked became completely listless...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_82","type":"Speech","speaker":"ce009_03","key":"Locale_SubScenario:event_ce009_1_05_s_82","text":"The loss of consciousness cases are very similar. That leads me to believe the people who lost consciousness may have been attacked by D-Shadows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_83","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_83","text":"Yukiko points to the first sugar cube.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_84","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_05_s_84","text":"I can't stop thinking about the first person who was summoned here. They could be one of us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_85","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_05_s_85","text":"But I also wonder if they might be connected to the D-Shadows, or even be another phantom thief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_86","type":"Speech","speaker":"ce009_02","key":"Locale_SubScenario:event_ce009_1_05_s_86","text":"It might be worth looking for them while we take down the D-Shadows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_87","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_87","text":"Yeah. If it's a Persona-user you know, they'll probably want to join us as soon as they can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_88","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_88","text":"I think we've got everything sorted out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_89","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_89","text":"I finish my now-cold coffee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_90","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_90","text":"To protect the Ark, I need to find the source of the D-Waves and defeat the Gatekeeper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_91","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_91","text":"It might be hard to believe... but that's the only way for you to get back to your own world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_92","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_05_s_92","text":"I trust you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_93","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_05_s_93","text":"If we're both trying to take down the Gatekeeper, there's no reason we can't work together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_94","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_94","text":"Mona takes my outstretched hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_95","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_95","text":"Looking forward to working with you, Mona, Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_96","type":"Speech","speaker":"ce009_05_1","key":"Locale_SubScenario:event_ce009_1_05_s_96","text":"Hehehe! You've got a deal!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_97","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_97","text":"Likewise. We still have a lot to learn about this world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_98","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_98","text":"I shake hands with Queen too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_99","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_99","text":"So, where should we start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_100","type":"Speech","speaker":"ce009_01_1","key":"Locale_SubScenario:event_ce009_1_05_s_100","text":"Like I said, we're not familiar with this world, so we'd like you to take the lead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_101","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_101","text":"Just like when we were looking for you guys...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_102","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_102","text":"I pull out the tablet Andersen gave me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce009_1_05_s_103","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce009_1_05_s_103","text":"Let's start by asking around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}