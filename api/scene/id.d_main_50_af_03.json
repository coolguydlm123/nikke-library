nity":null},{"id":"d_main_50_af_03_47","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_47","text":"Everything is so stark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_48","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_48","text":"I look around me again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_49","text":"Lots of people are standing or sitting outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_50","text":"The noisy, bustling atmosphere is gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_51","text":"Everyone is quietly feeling the light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_52","text":"With an odd feeling, I keep walking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_53","text":"Suddenly, a delicious aroma washes over me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_