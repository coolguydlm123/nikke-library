{"id":"d_main_50_af_03","cat":"main","group":{"id":"ch50","label":"Chapter 50 · Ascension"},"label":"The Land Beyond the Partition","stage":null,"prev":"d_main_50_af_02","next":"d_main_50_af_04","speakers":{"poli":"Poli","jackal":"Jackal","viper":"Viper","eh_n":"E.H.","rosanna":"Rosanna","moran":"Moran","sakura":"Sakura"},"icons":{"poli":"si_c030_00_s","jackal":"si_c111_00_s","viper":"si_c112_00_s","eh_n":"si_c113_00_s","rosanna":"si_c280_00_s","moran":"si_c281_00_s","sakura":"si_c282_00_s"},"lines":[{"id":"d_main_50_af_03_1","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_1","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":"OuterrimWall","bgArt":"outerrimwall","image":null,"bgm":"none","movie":null,"shown":["poli"],"affinity":null},{"id":"d_main_50_af_03_2","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_2","text":"You're awake! Thank you so much for your service!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_3","text":"What are you doing here? And why are there so many Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_4","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_4","text":"*Sigh* Don't get me started.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_5","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_5","text":"After we came to the surface, we had to station guards all along the partition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_6","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_6","text":"People just won't stop crossing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_7","text":"Oh... They're trying to come into the Ark from the Outer Rim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_8","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_8","text":"Poli looks behind her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soldiereg","soldierfa","product08","idollflower","soldierow"],"affinity":null},{"id":"d_main_50_af_03_9","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_9","text":"She observes the line of mass-produced Nikkes standing along the partition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_10","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_10","text":"No, just the opposite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_11","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_12","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_12","text":"The people inside the partition want to go stand out on the surface, so they keep sneaking out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_13","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_13","text":"Some people have gone missing, others have been attacked by wild animals... We've had a lot of incidents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_14","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_14","text":"That's why we've stationed so many Nikkes here, to stop them from leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_15","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_16","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_16","text":"Don't get me wrong. It's not that I don't understand. There's literally a new world for us out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_17","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_17","text":"Eventually, we will expand to outside the Ark, but people need to resist the urge to leave for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_18","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_18","text":"It's too dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_19","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_19","text":"Has anyone been attacked by Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_20","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_20","text":"No, there hasn't been a single attack. Or even a sighting, for that matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_21","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_21","text":"Fortunately, that means none of the incidents have been too serious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_23","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_23","text":"What brings you here, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_24","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_24","text":"You must have a lot on your plate right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_25","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_25","text":"Oh, I'm going to the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_26","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_26","text":"Ah... You're going to pay everyone a visit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_27","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_27","text":"Then just head out and go straight. You'll have to pass through the Outer Rim, but that shouldn't be an issue for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_28","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_28","text":"Here, I'll give you a pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_29","text":"Poli pulls out a plastic card.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_30","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_30","text":"Please be careful not to lose it, though I'm sure that won't be a problem for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_31","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_31","text":"With how things are right now, you just never know when someone might try to steal it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_32","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_32","text":"I apologize for the inconvenience. Our electronic systems are pretty unstable at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_33","text":"That's okay. Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_34","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_34","text":"I'll open the door for you. Have a safe trip.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_35","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_03_35","text":"I appreciate it, Poli.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_36","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_36","text":"Don't mention it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_37","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_37","text":"Oh, um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_38","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_38","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_39","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_50_af_03_39","text":"Thank you for protecting the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_03_40","type":"Mono