{"id":"msg_m_ex_rapi_01","cat":"messenger","group":{"id":"room_rapi","label":"Rapi · Nikke"},"label":"1. Commander.","stage":null,"prev":null,"next":"msg_m_ex_rapi_02","speakers":{"rapi":"Rapi"},"icons":{"rapi":"si_c010_00_s"},"lines":[{"id":"m_ex_rapi_01_1","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_1","text":"Commander.","jump":null},{"id":"m_ex_rapi_01_2","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_2","text":"May I have some of your time?","jump":null},{"id":"m_ex_rapi_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_3","text":"Sure.","jump":null},{"id":"m_ex_rapi_01_4","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_4","text":"I just came to this realization and it seems like I haven't officially introduced myself to you yet.","jump":null},{"id":"m_ex_rapi_01_5","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_5","text":"My name is Rapi.","jump":null},{"id":"m_ex_rapi_01_6","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_6","text":"I look forward to working with you.","jump":null},{"id":"m_ex_rapi_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_7","text":"Likewise.","jump":null},{"id":"m_ex_rapi_01_8","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_8","text":"Okay.","jump":null},{"id":"m_ex_rapi_01_9","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_9","text":"Excuse me, may I ask you a question?","jump":null},{"id":"m_ex_rapi_01_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_10","text":"Sure, go ahead.","jump":null},{"id":"m_ex_rapi_01_11","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_11","text":"Why did you hesitate","jump":null},{"id":"m_ex_rapi_01_12","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_12","text":"when you disposed of Marian?","jump":null},{"id":"m_ex_rapi_01_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_13","text":"Anyone who's in that situation will hesitate as well.","jump":null},{"id":"m_ex_rapi_01_14","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_14","text":"That situation?","jump":null},{"id":"m_ex_rapi_01_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_15","text":"A situation where someone is going to lose their life.","jump":null},{"id":"m_ex_rapi_01_16","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_16","text":"Usually, people don't hesitate.","jump":null},{"id":"m_ex_rapi_01_17","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_17","text":"It's quite usual for a Nikke to lose her life.","jump":null},{"id":"m_ex_rapi_01_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_18","text":"Well, it's not usual for me.","jump":null},{"id":"m_ex_rapi_01_19","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_19","text":"Really?","jump":null},{"id":"m_ex_rapi_01_20","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_20","text":"I see.","jump":null},{"id":"m_ex_rapi_01_21","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_21","text":"Sorry for bringing up such an offensive question.","jump":null},{"id":"m_ex_rapi_01_22","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_22","text":"I'll go be on standby then.","jump":null},{"id":"m_ex_rapi_01_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_23","text":"How about you?","jump":null},{"id":"m_ex_rapi_01_24","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_24","text":"What?","jump":null},{"id":"m_ex_rapi_01_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_25","text":"What was going through your mind when you were looking at Marian?","jump":null},{"id":"m_ex_rapi_01_26","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_26","text":"Nothing in particular.","jump":null},{"id":"m_ex_rapi_01_27","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_27","text":"No, I mean... Sorry.","jump":null},{"id":"m_ex_rapi_01_28","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_28","text":"I felt a bit sad.","jump":null},{"id":"m_ex_rapi_01_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rapi_01_29","text":"Did you?","jump":null},{"id":"m_ex_rapi_01_30","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_30","text":"Yes.","jump":null},{"id":"m_ex_rapi_01_31","type":"Speech","speaker":"rapi","key":"Locale_SuddenMessage:m_ex_rapi_01_31","text":"I'll go back to being on standby then.","jump":null}],"chat":true}