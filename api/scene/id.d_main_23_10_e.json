null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_48","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_23_10_e_48","text":"Gasp...! Ugh...! What... is this?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_49","type":"Speech","speaker":"guillotine","key":"Locale_MainScenario:d_main_23_10_e_49","text":"Within my eye, dwells tremendous and cursed power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_50","type":"Speech","speaker":"guillotine","key":"Locale_MainScenario:d_main_23_10_e_50","text":"The power to control all the energy I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_51","type":"Speech","speaker":"guillotine","key":"Locale_MainScenario:d_main_23_10_e_51","text":"At this very moment, I am scattering the energy in your core into the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_52","type":"Speech","speaker":"guillotine","key":"Locale_MainScenario:d_main_23_10_e_52","text":"For us Nikkes, our cores are much like the heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_53","type":"Speech","speaker":"guillotine","key":"Locale_MainScenario:d_main_23_10_e_53","text":"Right now, your heart has stopped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_54","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_23_10_e_54","text":"Ugh...! Ca-Captai