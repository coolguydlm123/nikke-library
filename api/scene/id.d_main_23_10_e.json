{"id":"d_main_23_10_e","cat":"main","group":{"id":"ch23","label":"Chapter 23 · Prison"},"label":"Lethal Eye: B","stage":"23-31 STAGE · End","prev":"d_main_23_10_s","next":"d_main_23_11_s","speakers":{"anis":"Anis","rapi":"Rapi","neon":"Neon","guillotine":"Guillotine","jackal":"Jackal","maiden":"Maiden"},"icons":{"anis":"si_c012_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","guillotine":"si_c180_00_s","jackal":"si_c111_00_s","maiden":"si_c181_00_s"},"lines":[{"id":"d_main_23_10_e_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_10_e_1","text":"It's complete pandemonium. Gunshots and screams continue to fill the air.","jump":null,"exit":false,"enter":null,"bg":"BurningCity","bgArt":"burningcity","image":null,"bgm":"bgm_emergency","movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_10_e_2","text":"The ground is littered with the corpses of slaughtered humans and Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_23_10_e_3","text":"It's appalling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_23_10_e_4","text":"Commander! Are you okay?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis","rapi","neon"],"affinity":null},{"id":"d_main_23_10_e_5","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_23_10_e_5","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23_10_e_6","type":"Speech","speaker":"neon","key":"Locale_MainScenari