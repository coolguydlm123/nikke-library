{"id":"d_main_30_03_e","cat":"main","group":{"id":"ch30","label":"Chapter 30 · Treasure"},"label":"Emptiness: B","stage":"30-12 STAGE · End","prev":"d_main_30_03_s","next":"d_main_30_04","speakers":{"shifty_c":"Shifty"},"icons":{"shifty_c":"si_c907_00_s"},"lines":[{"id":"d_main_30_03_e_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_03_e_1","text":"Shifty, what's the latest on that request I put in?","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":"bgm_chapter30_field_whitecity","movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_2","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_2","text":"It's ready for your perusal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty_c"],"affinity":null},{"id":"d_main_30_03_e_3","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_3","text":"Just a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_4","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_4","text":"Let's see...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_5","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_5","text":"First, it seems that what Liveryn said is true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_6","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_6","text":"Since the Pathfinder was formed, Liveryn and Fragile have always been on the same missions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_7","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_7","text":"However, the number of missions assigned to them suddenly took a significant drop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_8","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_8","text":"This occurred immediately after it was announced the Ark had halted its expansion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_9","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_9","text":"After that, there's hardly any work records, save for the occasional assignment thrown their way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_10","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_10","text":"They obtained permission from Ingrid to engage in additional work,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_11","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_11","text":"after which they primarily focused on acting as couriers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_12","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_03_e_12","text":"Did Ingrid do anything to assist them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_13","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_13","text":"There appear to have been some attempts on her end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_14","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_14","text":"She tried to get them assigned to Infinity Rail and looked into getting them to partner up with The Scouts,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_15","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_15","text":"but this was overturned due to opposition from the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_16","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_16","text":"There is a restriction on how many members any given squad can have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_17","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_03_e_17","text":"Why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_18","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_18","text":"A preventative measure","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_19","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_19","text":"to ensure no single squad gets too large.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_03_e_20","text":"Sounds to me like they're excessive worrywarts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_21","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_21","text":"It might sound petty, but there is indeed a viable reason for their concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_22","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_22","text":"The Goddess Fall incident with Model ZX was a major inciting factor.","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_23","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_23","text":"In the aftermath of that tragedy, the Central Government reached the conclusion that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_24","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_24","text":"when too many Nikkes operate together with a common goal, they become uncontrollable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_25","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_03_e_25","text":"And that's why they decided to limit the number of permissible members per squad?","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_26","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_26","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty_c"],"affinity":null},{"id":"d_main_30_03_e_27","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_27","text":"It is for this reason that squads are typically composed of three members or fewer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_28","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_28","text":"Of course, there are exceptions, but there must be a valid reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_29","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_29","text":"However, the Pathfinder's predicament was not considered a compelling enough reason to admit additional members.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_30","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_30_03_e_30","text":"They were left without a place to go practically overnight, and that's not considered a valid reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_31","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_31","text":"As far as the Central Government is concerned, Nikkes don't need to eat or sleep to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_30_03_e_32","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_30_03_e_32","te