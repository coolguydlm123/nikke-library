{"id":"d_main_37_02_e","cat":"main","group":{"id":"ch37","label":"Chapter 37 · Struggle"},"label":"The Admire: B","stage":"37-7 STAGE · End","prev":"d_main_37_02_s","next":"d_main_37_03","speakers":{"helm":"Helm","mast":"Mast","anchor":"Anchor","maxwell":"Maxwell","laplace":"Laplace","drake":"Drake","rapi_red":"Rapi"},"icons":{"helm":"si_c352_00_s","mast":"si_c350_00_s","anchor":"si_c351_00_s","maxwell":"si_c102_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s","rapi_red":"si_c016_00_s"},"lines":[{"id":"d_main_37_02_e_1","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_1","text":"Long time no see, everyone.","jump":null,"exit":false,"enter":null,"bg":"EzsUp","bgArt":"ezsup","image":null,"bgm":"bgm_chapter37_field_swarmnest","movie":null,"shown":["rapi_red","maxwell","helm","mast","anchor","drake","laplace"],"affinity":null},{"id":"d_main_37_02_e_2","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_2","text":"It's been a while!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_3","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_02_e_3","text":"Howdy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_4","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_4","text":"Wow, it's kind of strange seeing the Admire up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_5","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_e_5","text":"Your timing was impeccable, all of you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_6","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_e_6","text":"A mobile base like this is precisely what a hero like me needs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_7","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_e_7","text":"Bah, I was just about to make my move. You all stole my thunder!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_8","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_02_e_8","text":"Oh... sorry. We didn't mean to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_9","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_e_9","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_10","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_02_e_10","text":"We'll make sure to time it better next time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_11","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_e_11","text":"Oh, er... sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_12","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_e_12","text":"... If I just respond to Drake's nonsense as if it were normal, does that disarm her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_e_13","text":"I'm surprised, Helm. This isn't like you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_14","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_14","text":"Why do you say that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_15","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_e_15","text":"Knowing you, I thought for sure you'd contact me as soon as you got approval to join our operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_e_16","text":"Not only that, you'd then explain the bombardment plan in excruciating detail beforehand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_17","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_17","text":"Oh... that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_18","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_e_18","text":"Is your presence here classified? Secrecy isn't exactly possible when there's a hulking ship like the Admire involved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_19","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_19","text":"Not exactly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_20","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_20","text":"She was acting on advice from me, the great pirate Mast!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_21","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_21","text":"Following you in secret, only to step in at the critical moment, and saving the day all with minimal dialogue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_22","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_22","text":"Now that, my friends, is how a true pirate does it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_23","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_23","text":"Believe it or not, what she's saying is true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_24","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_24","text":"I even managed to convince the Boss!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_25","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_25","text":"That means everyone is embracing the buccaneer way of life!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_26","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_02_e_26","text":"It's incredible when you think about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_e_27","text":"I'm not sure about that. I doubt Commander cares all that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_28","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_28","text":"At any rate, we're joining this operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_29","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_29","text":"Looking forward to working with you again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_30","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_30","text":"Hmm... I do find something rather strange, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_31","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_31","text":"I figured you'd have questions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_32","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_32","text":"Ask away, and I'll answer as best I can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_33","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_33","text":"Okay, first question: How is the Admire even afloat right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_34","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_34","text":"We're not in the open ocean, after all. It may look like water, but this is all liquid metal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_35","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_35","text":"We deployed a wave disruptor that breaks down the makeup of nanomachines.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_36","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_36","text":"It's something that Elysion has been developing for a long time. Something intended to go up against Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_37","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_37","text":"This black liquid, what we officially call Dark Matter, is a substance made of nanomachines, and so the theory was that this disruptor would prove effective.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_38","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_38","text":"And it has indeed proven to be a resounding success. Now, even though we've broken down the structural integrity of the Dark Matter, it still remains as liquid metal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_39","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_39","text":"While this greatly reduces the Admire's mobility, the fact that it can move at all is what's important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_e_40","text":"So for this operation, the Admire will be primarily acting as a mobile base and providing bombardment support?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_41","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_41","text":"Aye. That's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_42","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_42","text":"It's unfortunate that I won't be able to show off my superior navigation skills, but since our movement is so limited, there's not much we can do about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_43","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_43","text":"Right now, we're essentially a stationary turret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_44","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_02_e_44","text":"But given the Admire's gargantuan size, you guys could also use it as a bridge to cross dangerous terrain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_45","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_02_e_45","text":"Like right now, for example.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_46","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_46","text":"Good point. We'll be able to use it to bypass some of the black liquid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_47","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_47","text":"All right, second question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_48","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_48","text":"How did you get here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_49","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_49","text":"We're not even remotely close to open water.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_50","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_50","text":"The Admire is amphibious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_51","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_51","text":"What?! Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_52","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_52","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_53","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_53","text":"That's absurd!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_54","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_54","text":"Why would a company invest so much money and technology into preparing for a war on the surface which they have no idea when it will commence?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_55","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_55","text":"Hard to say. Perhaps it's merely a difference in corporate ideology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_56","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_56","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_57","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_57","text":"Elysion's enemies are always up on the surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_58","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_58","text":"and so Elysion's future also rests on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_59","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_60","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_60","text":"I suppose that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_61","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_e_61","text":"It's different with Missilis in that our enemies, and therefore our future, lie with the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_62","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_e_62","text":"Is it all right if I ask a question?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_63","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_63","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_64","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_e_64","text":"Of all squads, why is it Aegis that got sent here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_65","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_66","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_66","text":"Aren't you being a bit harsh, Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_67","type":"Speech","speaker":"anchor","key":"Locale_MainScenario:d_main_37_02_e_67","text":"I'm hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_68","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_e_68","text":"In a way, understanding the true meaning hidden in what may seem to be a rude question, and then giving an appropriate answer, is what any true adventurer would do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_69","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_69","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_70","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_70","text":"Very sharp, Rapi. I expect no less from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_71","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_71","text":"You're right. It would make much more sense for Absolute or Mighty Tools to be here rather than us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_72","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_72","text":"However, the reason that the Aegis Squad came here is that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_73","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_73","text":"there's something only the Admire can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_74","type":"Speech","speaker":"helm","key":"Locale_MainScenario:d_main_37_02_e_74","text":"Everyone, will you follow me? I have something to show you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_75","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_e_75","text":"Helm begins heading below deck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_76","type":"Speech","speaker":"mast","key":"Locale_MainScenario:d_main_37_02_e_76","text":"Wow, she looks so cool doing that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_e_77","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_e_77","text":"... So cool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}