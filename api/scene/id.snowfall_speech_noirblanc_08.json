ull},{"id":"snowfall_speech_noirblanc_08_6","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_noirblanc_08_6","text":"I still have a lot of things left to do, so I decide to leave the dormitory.","jump":null,"exit":true,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_7","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_7","text":"Hi, Pit Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_8","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_8","text":"Nice to see you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_9","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_noirblanc_08_9","text":"You aren't feeling well, so don't force yourselves to get up on my account.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_10","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_noirblanc_08_10","text":"Both Noir and Blanc attempt to sit up, but I gently make them lie back down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_11","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_11","text":"Okay...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_12","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_12","text":"You're so thoughtful, Pit Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_13","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_noirblanc_08_13","text":"Are you still not feeling well?","jump":"snowfall_speech_noirblanc_08_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_14","type":"Choice","speaker":null,"key":"Locale_SubScenario:snowfall_speech_noirblanc_08_14","text":"Are you getting any better?","jump":"snowfall_speech_noirblanc_08_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_15","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_15","text":"I'm a little better now, but Noir still seems pretty drained.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_16","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_16","text":"What are you talking about?","jump":"snowfall_speech_noirblanc_08_21","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_17","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_17","text":"You bet! We're practically back to normal at this point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_18","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_18","text":"Look at me, I'm bursting with energy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_19","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_19","text":"You shouldn't push yourself, Blanc.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_20","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_20","text":"I'm not! Honestly.","jump":"snowfall_speech_noirblanc_08_21","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_21","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_21","text":"Don't listen to her, Pit Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_22","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_22","text":"Blanc is acting like she's okay, but she's pushing herself to the limit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_23","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_23","text":"Even with the condition she's in, she's still looking into the legend of the hot spring every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_24","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_24","text":"That's because we need to get to the bottom of this straight away so that you and I can recover.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_25","type":"Speech","speaker":"blanc_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_25","text":"Once we do, we'll be able to enjoy what time we have left here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_26","type":"Speech","speaker":"noir_c","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_26","text":"Blanc...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_27","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_noirblanc_08_27","text":"Don't push yourself too hard. That goes for both of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_28","type":"Self","speaker":null,"key":"Locale_SubScenario:snowfall_speech_noirblanc_08_28","text":"I'll help you out in any way I can, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_29","type":"Speech","speaker":"blanc_noir","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_29","text":"Thank you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblanc_08_30","type":"Speech","speaker":"blanc_noir","key":"Locale_SubScenario:snowfall_speech_noirblanc_08_30","text":"Pit Boss!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_noirblan