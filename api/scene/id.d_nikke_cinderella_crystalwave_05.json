":"d_nikke_cinderella_crystalwave_05_18","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_18","text":"To tell you the truth, I was reading a magazine","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_19","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_19","text":"and came across an article called \"7 Ways to Capture a Prince.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_20","text":"So you read the latest Amor Tetra?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_21","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_21","text":"How did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_22","text":"I was the one who brought it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_23","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_23","text":"so of course I've already read it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_24","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_24","text":"Well, that makes this easier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_25","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_25","text":"I tried the method from the magazine on you, Prince.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_26","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_26","text":"I followed the steps one by one, and when I got to the very end, I found a note written at the bottom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_27","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_27","text":"\"Step 7: Close the magazine.\"","jump":null,"exit":false,"enter":null,"bg":"JungleIsland_Out_s","bgArt":"jungleisland_out_s","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_28","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_28","text":"\"Everything you've learned so far has simply been a small step toward bringing the two of you closer together.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_29","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_29","text":"\"When it comes to the feelings you truly want to share, no words or techniques can express them for you.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_30","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_30","text":"\"So now, look the person in front of you in the eye and tell them how you feel.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_31","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_31","text":"After guiding me every step of the way, the writer's telling me I have to handle the most important part myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_32","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_32","text":"That's a rather irresponsible piece of advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_33","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_33","text":"... But I like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_34","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEpisode:d_nikke_cinderella_crystalwave_05_34","text":"Come to think of it, Prince, we've never even properly held hands.","jump":null,"exit":false,"enter":null,"bg":"JungleIsland_Out_n","bgArt":"jungleisland_out_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_crystalwave_05_35","type":"Speech","speaker":"cinderella_s","key":"Locale_NikkeEp