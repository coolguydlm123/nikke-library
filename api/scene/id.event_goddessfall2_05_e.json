g":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_51","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_51","text":"Verily, the matter at hand doth bode ill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_52","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_05_e_52","text":"...","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_25_1","bgArt":"eventscene_goddessfall_25_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_53","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_goddessfall2_05_e_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_54","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall2_05_e_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_55","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_05_e_55","text":"Where are Nayuta's clones?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_56","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_goddessfall2_05_e_56","text":"... They're all gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_57","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_goddessfall2_05_e_57","text":"... I see.","jump":null,"exit":false,"