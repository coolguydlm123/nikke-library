affinity":null},{"id":"event_goddessfall2_05_e_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_5","text":"blend with the hideous sounds of something snapping, tearing, and spilling that echo all around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_6","text":"And among them, the sound that stands out most is","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_7","text":"Nihilister's ragged breathing","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_8","text":"and the frantic, ravenous noise of devouring.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_9","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_9","text":"Go forth, now. Worry thou not for what shall follow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["kilo_op_l"],"affinity":null},{"id":"event_goddessfall2_05_e_10","type":"Speech","speaker":"kilo_op_l","key":"Locale_MainScenario:event_goddessfall2_05_e_10","text":"B-but what about Nihilister...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_11","type":"Speech","speaker":"chime","key":"Locale_MainScenario:event_goddessfall2_05_e_11","text":"Th-there's no way we can win if she attacks...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_12","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_12","text":"All shall be well. So place thy trust in me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_13","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_13","text":"T.A.L.O.S., I entreat thee to perform thy calculation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_14","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall2_05_e_14","text":"Calculating...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_15","type":"Speech","speaker":"talos","key":"Locale_MainScenario:event_goddessfall2_05_e_15","text":"Acknowledged. Initiating retreat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_16","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_16","text":"T.A.L.O.S. retreats, carrying Chime in both hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nihilister_m"],"affinity":null},{"id":"event_goddessfall2_05_e_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_17","text":"Meanwhile, Nayuta remains behind, silently observing Nihilister's grotesque feast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_18","text":"A final, resounding gulp echoes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_19","text":"and then everything goes silent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_20","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_20","text":"... Was the repast to thy liking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_21","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall2_05_e_21","text":"Damn, that's disgusting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_22","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_22","text":"For that, thou seemest in good health.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_23","text":"Nihilister removes her cloak and hurls it aside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_24","text":"*Craaaack!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nihilister"],"affinity":null},{"id":"event_goddessfall2_05_e_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_25","text":"Weapons sprout from Nihilister's back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_26","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_26","text":"Whew... That's more like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_27","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_27","text":"Verily, thou hast undone the Queen's dominion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_28","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_28","text":"Damn it, she's really getting on my nerves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall2_05_e_29","text":"Nihilister glares at the ground in annoyance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_30","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_30","text":"And now she's gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_31","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_31","text":"To rend asunder the fate thou wert born unto by thine own might alone... verily, most wondrous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_32","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_32","text":"... Pray, how didst thou accomplish such a feat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_33","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_33","text":"No idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_34","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_35","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_35","text":"... The sole elucidation that cometh to mine mind is that... a sudden surge of fervent emotion hath loosed the reins of control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_36","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_36","text":"Methinks that control is more feeble than I had erewhile surmised.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_37","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_37","text":"Weak? No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_38","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_38","text":"I'm the one who's strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_39","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_39","text":"So it is, that I do grant thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_40","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_40","text":"Pray, what wilt thou do henceforth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_41","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_41","text":"I'm going to kill the Queen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_42","type":"Speech","speaker":"nihilister","key":"Locale_MainScenario:event_goddessfall2_05_e_42","text":"duh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e_43","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall2_05_e_43","text":"Oh, 'tis a relief. I did fear that thou mightst have harbored a change of heart upon regaining thy strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall2_05_e