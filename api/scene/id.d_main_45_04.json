{"id":"d_main_45_04","cat":"main","group":{"id":"ch45","label":"Chapter 45 · The Price of Sin"},"label":"Underfoot","stage":"45-11 STAGE · End","prev":"d_main_45_03","next":"d_main_45_05","speakers":{"elegg":"Elegg","trony":"Trony"},"icons":{"elegg":"si_c500_00_s","trony":"si_c501_00_s"},"lines":[{"id":"d_main_45_04_1","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"black","bgArt":"black","image":null,"bgm":"bgm_inark","movie":null,"shown":["trony","elegg"],"affinity":null},{"id":"d_main_45_04_2","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_3","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_3","text":"Are you really going to be all right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_4","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_4","text":"I honestly don't think you need to carry this out personally, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_5","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_5","text":"Exactly. All you really need to do is give us the order and wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_6","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_6","text":"You don't really need to be that involved yourself, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_7","text":"I do. I have to see it get done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_8","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_8","text":"... I can tell neither of you is all that comfortable with this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_9","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_9","text":"I may not be able to help on the technical side of things, but I can at least take some of the weight off your shoulders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_10","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_10","text":"B-but Mr. Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_11","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_11","text":"Once you see what happens, you won't be able to unsee it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_12","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_12","text":"You're human... You can't get a memory wipe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_13","text":"It's fine. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_14","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_15","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_16","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_16","text":"Okay. Just take the ladder straight down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_17","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_17","text":"The floor kinda appears out of nowhere, so be careful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_18","text":"I look down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_19","text":"The only thing I see is darkness, with no bottom in sight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_20","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_20","text":"Oh, I wouldn't recommend looking down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_21","text":"Yeah, that's probably good advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_22","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_22","text":"When I told the Electric Shock Squad about shutting down the Ark's power source, their faces froze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_23","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_23","text":"I could tell that what frightened them wasn't the idea of shutting down the Ark, but rather having to go to the power source itself, so I decided to accompany them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_24","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_24","text":"Of course, I did genuinely want to help relieve their stress,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_25","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_25","text":"but I also felt like I needed to see it, that I needed to understand what exactly rested beneath our feet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_26","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_26","text":"After passing several unmanned facilities that were, according to Elegg and Trony, not meant to be so easy to get through,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_27","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_27","text":"we eventually made it to at a vertical shaft that seemingly stretches down forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_28","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_28","text":"We descend, relying only on a faint red glow for guidance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_29","text":"At some point, my feet finally touch solid ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_30","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_30","text":"... A damp heat washes over my body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_31","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_31","text":"It feels like... someone's body heat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_32","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_32","text":"... We're here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_33","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_33","text":"Keep going straight ahead, and you'll see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_34","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_34","text":"... Y-you know, it's not too late to turn back...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_35","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_35","text":"We just have to head to where the red light is, right? Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_36","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_36","text":"I walk toward what seems to be the source of the crimson glow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_37","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_37","text":"The brighter it gets, the hotter the air becomes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_38","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_38","text":"After walking for quite a while, I finally see it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_39","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_39","text":"... a giant Rapture core encased in some device.","jump":null,"exit":false,"enter":null,"bg":"ArkCore_On","bgArt":"arkcore_on","image":null,"bgm":"bgm_story_trauma","movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_41","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_41","text":"... This is the Ark's power source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["trony","elegg"],"affinity":null},{"id":"d_main_45_04_42","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_42","text":"A gigantic core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_43","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_43","text":"Ngh... Ugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_44","text":"... Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_45","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_45","text":"I-I'm fine. I'm just... still not used to the sight of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_46","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_46","text":"The energy generated from this core passes through substations and is distributed throughout the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_47","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_47","text":"It can handle all of the Ark's electricity by itself. In fact, sometimes it generates surplus energy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_48","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_48","text":"It's literally a monster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_49","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_49","text":"If we shut it down, the entire Ark will go dark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_50","text":"... What are those pipes connected to it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_51","text":"It looks like something's being injected into the core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_52","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_53","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_53","text":"Are you sure you want to know, Mr. Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_54","text":"... Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_55","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_55","text":"Elegg silently points at one of the pipes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_56","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_56","text":"She then turns and points toward the wall it's connected to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_57","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_57","text":"A storage space is built into the wall that holds numerous containers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_58","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_58","text":"See those containers?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_59","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_59","text":"They contain food for the gigantic core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_60","text":"Food...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_61","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_61","text":"It's a first-generation core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_62","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_62","text":"It doesn't operate on perpetual energy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_63","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_63","text":"... It sustains its power output using biological materials as fuel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_64","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_65","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_65","text":"Bodies don't get buried in the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_66","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_66","text":"and to make a Nikke, you only need a human brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_67","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_67","text":"Birth rates in the Ark are nearly five times higher than they were on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_68","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_68","text":"Contraceptives don't exist in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_69","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_69","text":"Yet the Ark's population has been essentially the same since its inception.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_70","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_71","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_71","text":"Urgh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_72","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_72","text":"I gently pat Trony's back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_73","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_73","text":"Shutting the core down is simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_74","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_74","text":"Lock those pipes, then forcibly ramp up the converter's output.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_75","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_75","text":"The core will consume a massive amount of energy at once, and with no more fuel available, it'll be forced to shut down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_76","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_76","text":"But if it stays that way for too long, it'll break completely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_77","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_77","text":"How long before there's permanent damage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_78","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_78","text":"We'd estimate about half a day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_79","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_79","text":"Okay. That's more than enough time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_80","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_80","text":"Can you set it to shut down two days from now at two in the afternoon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_81","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_81","text":"Have it remain offline for an hour, then bring it back online.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_82","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_82","text":"In two days? You're cutting it pretty close. Locking the pipes is easy, but the converter takes work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_83","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_83","text":"Are you sure this is absolutely necessary?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_84","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_84","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_85","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_85","text":"Hehe, okay. No problem. Making schedules work is kinda my specialty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_86","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_86","text":"You still haven't told us why we're doing this, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_87","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_87","text":"... Sorry. That's classified.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_88","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_88","text":"This isn't illegal, is it? You didn't suddenly decide to destroy the Ark or anything, right...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_89","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_89","text":"This is all being done with Enikk's approval.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_90","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_90","text":"Oh... So this really is a big deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_91","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_91","text":"Also, I'm sorry to say this too, but please avoid contacting anyone else starting from right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_92","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_92","text":"This operation has to remain confidential. I hope you understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_93","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_93","text":"... If possible, I'd like you to stay here until everything's done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_94","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_94","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_95","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_95","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_96","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_96","text":"Elegg and Trony stare at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_97","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_97","text":"Hehe. You risk your life for Nikkes, so if you're asking this much of us, whatever this is must be really important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_98","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_98","text":"Are you okay with all of that, Ms. Trony?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_99","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_99","text":"I'm... fine. I'll get used to it. What about you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_100","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_100","text":"As long as you're here, I'll be okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_101","type":"Speech","speaker":"trony","key":"Locale_MainScenario:d_main_45_04_101","text":"Yeah... Me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_102","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_102","text":"... I'm sorry. Really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_103","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_103","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_104","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_104","text":"Come on, the mood's gotten a bit too serious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_105","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_105","text":"We should be celebrating the fact that you're now privy to one of the Ark's biggest secrets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_106","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_106","text":"So, how does it feel, Mr. Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_107","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_45_04_107","text":"Does it make you never want to set foot in the Ark again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_108","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_108","text":"I look at the numerous containers lining the walls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_109","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_109","text":"One of them that is significantly larger than the rest catches my eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_110","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_110","text":"I wonder what's inside, but I decide not to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_111","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_45_04_111","text":"Right now, I focus on telling them how it actually makes me feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_112","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_112","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_45_04_113","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_45_04_113","text":"It makes me want to reclaim the surface as soon as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}