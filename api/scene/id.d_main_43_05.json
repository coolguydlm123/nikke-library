ull,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_42","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_05_42","text":"*Sigh* Third...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_43","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_05_43","text":"Fine, I'll admit there are things about her that are a bit... off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_44","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_05_44","text":"But there aren't exactly many sane people around here, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_45","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_05_45","text":"All right... Fair point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_46","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_05_46","text":"Just give her a chance. If it really doesn't work out, you can take it up with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_47","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_05_47","text":"*Sigh* This is driving me nuts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_48","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_05_48","text":"Princess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":n