h...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_56","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_05_56","text":"You. Come with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_57","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_05_57","text":"Hm...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_58","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_05_58","text":"Are you not coming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_59","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_05_59","text":"No. I only handle the cleaning. They're the computer people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_60","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_05_60","text":"See you at home tonight. *Cough, cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_61","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_05_61","text":"Huh? Hey... wait!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_05_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_05_62","text":"Stall III walks off in the opposite direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie"