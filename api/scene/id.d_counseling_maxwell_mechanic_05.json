":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maxwell_mechanic_05_6","type":"Speech","speaker":"maxwell_p","key":"Locale_Counseling:d_counseling_maxwell_mechanic_05_6","text":"I guess short and sweet really is the way to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maxwell_mechanic_05_7","type":"Speech","speaker":"maxwell_p","key":"Locale_Counseling:d_counseling_maxwell_mechanic_05_7","text":"Heh, I'm glad I asked you, Cutey. Thanks!","jump":"d_counseling_maxwell_mechanic_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maxwell_mechanic_05_8","type":"Speech","speaker":"maxwell_p","key":"Locale_Counseling:d_counseling_maxwell_mechanic_05_8","text":"Hehe, you're always so objective.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maxwell_mechanic_05_9","type":"Speech","speaker":"maxwell_p","key":"Locale_Counseling:d_counseling_maxwell_mechanic_05_9","text":"But to me, My Heavenly Cutey is the most lovable thing ever!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maxwell_mechanic_05_10","type":"Speech","speaker":"maxwell_p","key":"Locale_Counseling:d_counseling_maxwell_mechanic_05_10","text":"I'm hurt that you can't see just how lovable My Heavenly Cutey is.","jump":"d_counseling_maxwell_mechanic_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_maxwell_mechanic_05_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_maxwell_mechanic_05_11","text":"Maxwell and I look at My Heavenly Cutey, trying to come up with a name for it.","jump"