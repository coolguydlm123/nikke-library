therock_04_s_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_53","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_skyontherock_04_s_53","text":"Pepper gives Sky, who still looks downcast, a bittersweet smile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_54","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_54","text":"I'll leave the rest to you two, then. See you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_55","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_skyontherock_04_s_55","text":"She then leaves the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_56","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_56","text":"Captain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_57","type":"Self","speaker":null,"key":"Locale_SubScenario:event_skyontherock_04_s_57","text":"Yeah?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_marrybad","movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_58","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_58","text":"Truth be told... I always thought Sephie was just throwing a tantrum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_59","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_59","text":"I thought she was too young to know any better, that she was just being childish and unreasonable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_60","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_60","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_61","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_61","text":"She was just a little girl with so little time left,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_62","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_62","text":"desperately wishing for a chance to ride in a hot air balloon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_63","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_63","text":"And all I ever did was tell her to wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_64","type":"Self","speaker":null,"key":"Locale_SubScenario:event_skyontherock_04_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_65","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_65","text":"When Sephie called me a coward in front of the balloon...","jump":null,"exit":false,"enter":null,"bg":null,"