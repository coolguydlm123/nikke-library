wn":null,"affinity":null},{"id":"event_skyontherock_04_s_7","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_7","text":"She'll be okay, won't she?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_8","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_8","text":"There's nothing wrong with her sleeping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_9","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_9","text":"She's just resting right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_10","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_10","text":"She's so exhausted that she's fallen into a deep sleep, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_11","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_11","text":"Thank goodness...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_12","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_12","text":"We expect her to wake up sometime today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_13","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_13","text":"But there's another problem...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_14","type":"Self","speaker":null,"key":"Locale_SubScenario:event_skyontherock_04_s_14","text":"Did her test results come in?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_15","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_15","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_16","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_16","text":"Sephie's always been prone to getting sick,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_17","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_17","text":"but this time, all of her test results are abnormal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_18","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_18","text":"That's why I'm more concerned about this fever than usual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_19","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_19","text":"Maybe she picked up something outside the hospital,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_20","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_20","text":"but her fever isn't coming down as quickly as I'd expect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_21","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_21","text":"Would it be possible for her to go out for just a day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_22","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_22","text":"It really shouldn't take that long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_23","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_23","text":"I'd say about an hour, tops...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_24","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_24","text":"I wish I could say otherwise, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_25","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_25","text":"I'm afraid Sephie isn't well enough to go out right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_26","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_26","text":"If she were showing signs of improvement, getting out for a bit might actually do her some good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_27","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_27","text":"But since she isn't, I can't help worrying that she might pick up something even worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_28","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_28","text":"I hope you understand that I have to be especially careful when it comes to her immune system.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_29","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_29","text":"It's just that, given the nature of her illness...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_30","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_30","text":"B-but at least we'd be giving Sephie a chance to fulfill her wish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_31","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_31","text":"Maybe she'd agree to the surgery once her wish comes true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_32","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_32","text":"When you look at it that way, isn't it worth a try?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_33","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_33","text":"I wish I could tell you to go ahead,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_34","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_34","text":"but as her doctor, I can't,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_35","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_35","text":"especially when her life could be at stake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_36","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_36","text":"The safest thing to do would be to have the surgery first and ride in the balloon once she's recovered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_37","type":"Self","speaker":null,"key":"Locale_SubScenario:event_skyontherock_04_s_37","text":"So when do you think she should have the surgery?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_38","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_38","text":"We're already running out of time, so we need to operate as soon as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_39","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_39","text":"We need to convince her to agree to the surgery by the end of today, get everything ready tomorrow,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_40","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_40","text":"and operate the day after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_41","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_04_s_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_42","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_42","text":"If she agrees to the surgery,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_43","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_43","text":"I'll do whatever it takes to cure her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_44","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_44","text":"So please don't look so down, you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_04_s_45","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_skyontherock_04_s_45","text":"If Sephie wakes up and sees both of you looking so sad,","jump":null,"exit":false,"enter":null,"bg":null,"b