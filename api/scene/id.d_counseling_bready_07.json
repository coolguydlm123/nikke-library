{"id":"d_counseling_bready_07","cat":"counsel","group":{"id":"char5135","label":"Bready"},"label":"Advising Bready: 07","stage":null,"prev":"d_counseling_bready_06","next":"d_counseling_bready_08","speakers":{"bready":"Bready"},"icons":{"bready":"si_c520_00_s"},"lines":[{"id":"d_counseling_bready_07_1","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_1","text":"Ugh. Sometimes, even at night, I get a craving for you, Bonne Bouche.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["bready"],"affinity":"_0"},{"id":"d_counseling_bready_07_2","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_2","text":"Like how some crave a late-night snack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_07_3","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_3","text":"What should I do when that happens?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_07_4","text":"I'd say that you can come over anytime, but I really do need my sleep...","jump":"d_counseling_bready_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_bready_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_07_5","text":"If I'm still awake, you can come over.","jump":"d_counseling_bready_07_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_bready_07_6","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_6","text":"Oh, okay. If my coming over would disturb your sleep routine, then never mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_07_7","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_7","text":"I can restrain myself...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_07_8","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_8","text":"I think... *slurp*...","jump":"d_counseling_bready_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_07_9","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_9","text":"Oh, really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_07_10","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_07_10","text":"You're very kind, but I don't want to bother you while you're resting. I'll only reach out if it's really urgent.","jump":"d_counseling_bready_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_07_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_bready_07_11","text":"Bready and I talk about what to do when late-night cravings come calling.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}