{"id":"d_nikke_crow_04","cat":"bond","group":{"id":"char5025","label":"Crow"},"label":"D-Day","stage":null,"prev":"d_nikke_crow_03","next":"d_nikke_crow_05","speakers":{"Narration":"Narration","crow":"Crow","Self":"Commander","Monologue":"Monologue","youngwoman":"Young Woman"},"icons":{"Narration":"si_c999_00_s","crow":"si_c110_00_s","youngwoman":"si_c912_00_s"},"lines":[{"id":"d_nikke_crow_04_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_crow_04_1","text":"D-Day, in the interrogation room at the Rehabilitation Center...","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_2","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_2","text":"... {AccountData.NickName}...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_04_3","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_3","text":"... Hey, you listening?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_4","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_4","text":"You're completely out of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_5","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_5","text":"What the hell did you get yourself into this time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_6","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_6","text":"I've been searching for Jack's daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_7","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_8","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_8","text":"I thought we were done with that yesterday.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_9","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_9","text":"I went to the A.C.P.U. yesterday, but they couldn't tell me where she was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_10","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_10","text":"So, I started searching all over the Rehabilitation Center first thing this morning...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_11","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_11","text":"Okay, that's enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_12","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_12","text":"I don't need to hear the rest. The dark circles under your eyes tell me all I need to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_13","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_13","text":"... You foolish human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_14","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_14","text":"Why go to all that trouble asking around about something so obvious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_15","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_15","text":"... Obvious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_16","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_16","text":"Think about that girl's situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_17","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_17","text":"She's the child of some nobodies who's spent their whole life at the bottom of society.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_18","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_18","text":"If she were to suddenly disappear one day, no one would give a damn,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_19","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_19","text":"and most importantly, she's a girl, isn't she?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_20","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_20","text":"So what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_21","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_21","text":"Low investment, high return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_22","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_22","text":"That's what the Ark is built on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_23","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_23","text":"And as it happens, I've got a pretty good way to get that kind of return out of Jack's daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_24","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_24","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_25","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_25","text":"Seriously... I can't tell if you're stupid or just too good-natured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_26","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_26","text":"I don't know if you're stupid, or just naïve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_27","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_27","text":"The answer is standing right in front of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_28","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_28","text":"If you still can't figure it out after I practically spelled it out for you, then you're just plain stupid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_29","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_29","text":"... You mean she became a Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_30","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_30","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_31","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crow_04_31","text":"How can you be so sure?","jump":"d_nikke_crow_04_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_32","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crow_04_32","text":"I can't believe it.","jump":"d_nikke_crow_04_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_33","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_33","text":"If you find it so hard to believe, why don't you ask the Big Three yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_34","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_34","text":"Ingrid, Syuen, Mustang.","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":null,"movie":null,"shown":["ingrid","syuen","mustang"],"affinity":null},{"id":"d_nikke_crow_04_35","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_35","text":"At least one of them should have a file on the daughter","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_36","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_36","text":"of an outlaw named Jack sitting on their desk by now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_37","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_37","text":"I'll ask them.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_38","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_crow_04_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_39","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_crow_04_39","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_40","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_40","text":"So who's the lucky winner?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_04_41","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_41","text":"... Ingrid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_42","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_42","text":"Figures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_43","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_43","text":"The Ark has been built to work this way from the very beginning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_44","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_44","text":"Outlaws, orphans, criminals, and all the other outcasts who can't fit into society...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_45","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_45","text":"The Outer Rim is where all that garbage eventually ends up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_46","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_47","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_47","text":"Since we're on the subject, let me ask you something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_48","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_48","text":"Nikke, Goddesses of Victory, humanity's last bastion of hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_49","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_49","text":"Those were the names they were once called,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_50","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_50","text":"so why do you think they ended up rotting at the bottom of the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_51","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crow_04_51","text":"I don't know.","jump":"d_nikke_crow_04_55","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_52","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_crow_04_52","text":"Because of the military's needs.","jump":"d_nikke_crow_04_53","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_53","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_53","text":"You're only half right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_54","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_54","text":"... The other half is dead wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_55","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_55","text":"... The thing is, Nikkes weren't always at the bottom of society.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_56","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_56","text":"Back when the first-generation Nikkes were around, people were grateful to them.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_title_godnessfall","movie":null,"shown":["snowwhite"],"affinity":null},{"id":"d_nikke_crow_04_57","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_57","text":"More than that, they sometimes even worshiped them as goddesses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapunzel"],"affinity":null},{"id":"d_nikke_crow_04_58","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_58","text":"Nikkes could have become the basis of a new faith in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_crow_04_59","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_59","text":"But as the war against the Raptures intensified,","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_60","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_60","text":"the military began looking for ways to treat these powerful mechanical soldiers more and more inhumanely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["product08"],"affinity":null},{"id":"d_nikke_crow_04_61","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_61","text":"Little by little. Step by step. They stripped away their civil rights, their human rights...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_62","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_62","text":"Until, in the end, they even took away their rights over their own bodies and minds.","jump":null,"exit":false,"enter":null,"bg":"black","bgArt":"black","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_63","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_63","text":"Those girls had mechanical bodies, but they were perfectly ordinary human beings inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_64","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_64","text":"And yet, they began teaching the public to see them as something less than human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_65","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_65","text":"Were there any Nikkes who resisted?","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_04_66","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_66","text":"Of course there were,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_67","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_67","text":"but there weren't nearly enough of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_68","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_68","text":"The military's power was overwhelming back then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_69","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_69","text":"If that power were ever going to be broken, the citizens would have to stand together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_70","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_70","text":"But the people back then... how should I put it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_71","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_71","text":"They did absolutely nothing. It was almost fascinating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_72","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_72","text":"It was as if they'd collectively forgotten who made it possible for them to go to school safely, go to work,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_73","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_73","text":"and live their ordinary lives,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_74","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_74","text":"laughing and carrying on without a care in the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_75","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_75","text":"Even as they forgot, the Nikkes kept fighting for them, putting their lives on the line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_76","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_76","text":"And they died for nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_77","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_77","text":"... So, let me ask you this again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_78","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_78","text":"Can we really call these citizens innocent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_79","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_79","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_80","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_80","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_81","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_81","text":"They could've prevented the Nikkes from suffering, but they just stood by and did nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_82","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_82","text":"... I think so, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_83","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_83","text":"That's why I came here of my own accord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_risk","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_84","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_84","text":"If I committed the same crime and just walked away...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_85","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_85","text":"What right would I have to condemn them later?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_86","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_86","text":"... Actually, I went to A.C.P.U. yesterday to turn myself in.","jump":null,"exit":false,"enter":null,"bg":"Police","bgArt":"police","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_87","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_87","text":"I told them I was the one behind the terrorist attack on the Daily Ark office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_88","type":"Speech","speaker":"youngwoman","key":"Locale_NikkeEpisode:d_nikke_crow_04_88","text":"I can't believe this...!","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_04_89","type":"Speech","speaker":"youngwoman","key":"Locale_NikkeEpisode:d_nikke_crow_04_89","text":"Someone was gunned down right in front of her, and she didn't even flinch!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_90","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_90","text":"But the people back then... how should I put it?","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_91","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_91","text":"They did absolutely nothing. It was almost fascinating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_92","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_crow_04_92","text":"They stood by and did nothing.","jump":null,"exit":false,"enter":null,"bg":"White","bgArt":"white","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_93","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_crow_04_93","text":"For that... they are guilty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_94","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_04_94","text":"... So that‘s what happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_95","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_crow_04_95","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_04_96","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_96","text":"... Well, looks like it's time already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_97","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_97","text":"Enikk's verdict will begin shortly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_98","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_98","text":"After all, she's an A.I. that speaks for the will of humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_99","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_99","text":"You could say her judgment is the judgment of society itself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_04_100","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_04_100","text":"Well then, let's go hear what sentence society has in store for me, shall we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}