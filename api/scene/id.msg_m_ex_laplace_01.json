{"id":"msg_m_ex_laplace_01","cat":"messenger","group":{"id":"room_laplace","label":"Laplace · Nikke"},"label":"1. The hero!","stage":null,"prev":null,"next":"msg_m_ex_laplace_02","speakers":{"laplace":"Laplace"},"icons":{"laplace":"si_c100_00_s"},"lines":[{"id":"m_ex_laplace_01_1","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_1","text":"The hero!","jump":null},{"id":"m_ex_laplace_01_2","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_2","text":"Laplace!","jump":null},{"id":"m_ex_laplace_01_3","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_3","text":"Has!","jump":null},{"id":"m_ex_laplace_01_4","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_4","text":"Arrived!","jump":null},{"id":"m_ex_laplace_01_5","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_5","text":"Looks like we're working together from now on.","jump":null},{"id":"m_ex_laplace_01_6","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_6","text":"I'm looking forward to it!","jump":null},{"id":"m_ex_laplace_01_7","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_7","text":"I can't remember the last time I was paired up with an ordinary human.","jump":null},{"id":"m_ex_laplace_01_8","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_8","text":"Don't worry, though.","jump":null},{"id":"m_ex_laplace_01_9","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_9","text":"You can leave everything to me!","jump":null},{"id":"m_ex_laplace_01_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_laplace_01_10","text":"I'd rather we work together to solve problems.","jump":null},{"id":"m_ex_laplace_01_11","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_11","text":"??","jump":null},{"id":"m_ex_laplace_01_12","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_12","text":"A heroic Nikke, like me, teaming up with a human?","jump":null},{"id":"m_ex_laplace_01_13","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_13","text":"Is that what you're telling me?","jump":null},{"id":"m_ex_laplace_01_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_laplace_01_14","text":"That's right.","jump":null},{"id":"m_ex_laplace_01_15","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_15","text":"Hahahaha!","jump":null},{"id":"m_ex_laplace_01_16","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_16","text":"That's impossible!","jump":null},{"id":"m_ex_laplace_01_17","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_17","text":"There's a world of difference between humans and even the most ordinary of Nikkes.","jump":null},{"id":"m_ex_laplace_01_18","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_18","text":"And I assure you that I'm no ordinary Nikke.","jump":null},{"id":"m_ex_laplace_01_19","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_19","text":"What can you possibly contribute?","jump":null},{"id":"m_ex_laplace_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_laplace_01_20","text":"We're comrades.","jump":null},{"id":"m_ex_laplace_01_21","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_21","text":"Say what?","jump":null},{"id":"m_ex_laplace_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_laplace_01_22","text":"If we work towards the same goal, that makes us comrades.","jump":null},{"id":"m_ex_laplace_01_23","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_23","text":"!!","jump":null},{"id":"m_ex_laplace_01_24","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_24","text":"Can't argue with you there.","jump":null},{"id":"m_ex_laplace_01_25","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_25","text":"All right, then. You'll be my new sidekick.","jump":null},{"id":"m_ex_laplace_01_26","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_26","text":"Your call sign will be...","jump":null},{"id":"m_ex_laplace_01_27","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_27","text":"Birdie!","jump":null},{"id":"m_ex_laplace_01_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_laplace_01_28","text":"Why Birdie?","jump":null},{"id":"m_ex_laplace_01_29","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_29","text":"That's the name of the sidekick in my favorite movie!","jump":null},{"id":"m_ex_laplace_01_30","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_30","text":"All right, then!","jump":null},{"id":"m_ex_laplace_01_31","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_31","text":"Onward we go! As heroes!","jump":null},{"id":"m_ex_laplace_01_32","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_laplace_01_32","text":"Looking forward to it.","jump":"m_ex_laplace_01_34"},{"id":"m_ex_laplace_01_33","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_laplace_01_33","text":"Let's go!","jump":"m_ex_laplace_01_34"},{"id":"m_ex_laplace_01_34","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_laplace_01_34","text":"That's the spirit, Birdie!","jump":null}],"chat":true}