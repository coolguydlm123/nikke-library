:null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_76","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_76","text":"The audience inevitably starts to wonder:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_77","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_77","text":"If this girl is a nobody, how come she's so talented?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_78","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_78","text":"She has a natural gift. I don't understand why she's in such despair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_79","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_79","text":"Rather than understanding the conflict inside Sophia,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_80","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_80","text":"they're just waiting for the outside world to come around and recognize her talents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_81","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_81","text":"Do you understand what I'm saying, Maestro?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_82","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_aria_01_82","text":"Are you saying your super