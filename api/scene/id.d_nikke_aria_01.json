ech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_89","text":"I'm still better than a career-best performance from most singers.","jump":"d_nikke_aria_01_93","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_90","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_90","text":"Yes. Simply put, I've never experienced being a nobody.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_91","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_91","text":"I realize this sounds conceited, but I don't understand what it's like to have no talent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_92","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_92","text":"I don't know how to make the song anything but perfect.","jump":"d_nikke_aria_01_93","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_93","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_94","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_94","text":"Perhaps it'd be best if the director found someone with less talent,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_aria_01_95","type":"Speech","speaker":"aria","key":"Locale_NikkeEpisode:d_nikke_aria_01_95","text":"someone unknown, and gave the role to her.","jump":null,"exit":false,"enter":null,"bg