{"id":"d_counseling_harran_12","cat":"counsel","group":{"id":"char5042","label":"Harran"},"label":"Advising Harran: 12","stage":null,"prev":"d_counseling_harran_11","next":"d_counseling_harran_13","speakers":{"harran":"Harran"},"icons":{"harran":"si_c230_00_s"},"lines":[{"id":"d_counseling_harran_12_1","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_1","text":"Why do humans constantly lie","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["harran"],"affinity":"_0"},{"id":"d_counseling_harran_12_2","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_2","text":"and betray one another?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_12_3","text":"Not everyone is that way.","jump":"d_counseling_harran_12_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_harran_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_harran_12_4","text":"I don't know what to say.","jump":"d_counseling_harran_12_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_harran_12_5","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_5","text":"I realize that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_6","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_6","text":"And I know you represent one of those humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_7","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_7","text":"So you don't need to worry.","jump":"d_counseling_harran_12_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_8","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_8","text":"You don't have to say anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_9","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_9","text":"Do you think I don't know there are plenty of humans who don't act like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_10","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_10","text":"I am well aware of the type of human you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_11","type":"Speech","speaker":"harran","key":"Locale_Counseling:d_counseling_harran_12_11","text":"So do not be foolish and feel ashamed when you have nothing to be ashamed about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_harran_12_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_harran_12_12","text":"Harran and I have a conversation about humans and their penchant for lying.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}