kke_nihilister_05_6","text":"It wasn't fun being on the receiving end of Dragon Breath attack, but in this situation, I'd say it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_05_7","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_nihilister_05_7","text":"Was worth it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_05_8","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_nihilister_05_8","text":"Yeah. It was worth it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_05_9","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_nihilister_05_9","text":"It feels like we've been introduced to this entirely new world of offensive capabilities after muddling along with so little for so long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_05_10","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nihilister_05_10","text":"Nihilister, still airborne, descends and transforms back into her Nikke form,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nihilister_05_11","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nihilister_05_11","text":"landing directly in front of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nihilister"],"affinity":null},{"id":"d_nikke_nihilister_05_12","type":"Speech","speaker":"nihilister","key":"Locale_NikkeEpisode:d_nikke_nihilister_05_12","text":"Yeah, baby!","jump":null,"exit":fa