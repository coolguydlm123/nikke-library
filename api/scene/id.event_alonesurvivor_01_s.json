Locale_SubScenario:event_alonesurvivor_01_s_6","text":"I've been waiting for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_7","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_7","text":"Alice and Neve went to call on you quite some time ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neve"],"affinity":null},{"id":"event_alonesurvivor_01_s_8","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_8","text":"You came later than I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_9","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_9","text":"Did something happen on your way here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_10","type":"Speech","speaker":"alice","key":"Locale_SubScenario:event_alonesurvivor_01_s_10","text":"We had to wait forever and a day for the polar bears to fall asleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_11","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_11","text":"*Yawwn* It could be because it's winter,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_12","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_12","text":"but we were spoiled for choice when it came to ice caves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_13","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_13","text":"We figured there might be a polar bear inside one of them, so we burrowed our way in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_14","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_14","text":"We didn't find anything, so I ended up falling asleep hugging Burly Bear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_15","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_15","text":"... Well,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_16","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_16","text":"as long as no one was hurt, I suppose it's fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_17","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_17","text":"Sorry to make you come out all this way, Servant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_18","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_18","text":"Come here and sit by the fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_19","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_alonesurvivor_01_s_19","text":"I sit by the stove and thaw off my frozen hands and feet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_20","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_alonesurvivor_01_s_20","text":"What's the mission this time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_21","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_21","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_22","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_22","text":"Did you not receive instructions from the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_23","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_alonesurvivor_01_s_23","text":"All they told me was that I'd find out once I got to the North.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_24","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_24","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_25","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_26","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_26","text":"Then I'll try explain quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_27","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_27","text":"Sometime ago, we received an extraction request from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_28","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_28","text":"A detachment of mass-produced Nikkes were sent out to conduct a search.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_29","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_29","text":"It's now been 28 days since they went MIA.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_30","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_30","text":"Despite the extremely low concentration of Alva Particles in the north,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_31","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_31","text":"we've been unable to establish contact with them, and haven't received any reports.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_32","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_32","text":"Their last known coordinates place them near the mountains in the north,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_33","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_33","text":"and just near Glitter Mountain which is 3000 meters of elevation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_34","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_34","text":"It was there that their signal was cut off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_35","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_35","text":"Glitter Mountain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_36","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_36","text":"That's not good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_37","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_37","text":"Even I try to avoid that place if at all possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_38","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_alonesurvivor_01_s_38","text":"What's so bad about that place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_39","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_39","text":"It's super duper dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_40","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_40","text":"It's an incredibly hostile environment up there,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_41","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_41","text":"and it's swarming with Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_42","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_42","text":"If you falter there for even a second, you're likely to freeze to death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_43","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_43","text":"And it only gets worse the higher you go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_44","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_44","text":"Nikkes are more resistant to the cold than humans,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_45","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_45","text":"but if they're exposed to extreme conditions for prolonged periods of time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_46","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_46","text":"their bodies and minds will be pushed to their limits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_47","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_47","text":"If they exist in that state for too long...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_48","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_alonesurvivor_01_s_48","text":"They'll have a mental breakdown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_49","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_49","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_50","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_50","text":"That's where you come in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_51","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_51","text":"I believe in your ability to look after your mental well-being.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_52","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_52","text":"And... there may be certain situations that dictate that you make a judgment call.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_53","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_alonesurvivor_01_s_53","text":"... Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_54","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_54","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_55","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_55","text":"Are we even sure","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_56","type":"Speech","speaker":"neve","key":"Locale_SubScenario:event_alonesurvivor_01_s_56","text":"if a human can withstand the cold up there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_57","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor_01_s_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_alonesurvivor_01_s_58","type":"Speech","speaker":"ludmilla","key":"Locale_SubScenario:event_alonesurvivor