null},{"id":"d_nikke_noah_05_42","type":"Speech","speaker":"littlenoah","key":"Locale_NikkeEpisode:d_nikke_noah_05_42","text":"Too... too many Raptures...","jump":null,"exit":false,"enter":null,"bg":"WasteLand_03","bgArt":"wasteland_03","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_43","type":"Speech","speaker":"littlenoah","key":"Locale_NikkeEpisode:d_nikke_noah_05_43","text":"Where was our backup?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_44","type":"Speech","speaker":"littlenoah","key":"Locale_NikkeEpisode:d_nikke_noah_05_44","text":"Master researcher, where are the other Nikkes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_45","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_05_45","text":"Right before I was supposed to die, master Noah, you came.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_impression","movie":null,"shown":["noah","littlenikke"],"affinity":null},{"id":"d_nikke_noah_05_46","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_05_46","text":"... Although you were not welcoming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_47","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_05_47","text":"I just happened to be there. You're lucky you survived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_48","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_05_48","text":"Do you mean, I struggled just long enough...","jump":n