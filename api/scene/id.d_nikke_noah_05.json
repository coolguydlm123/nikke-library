_nikke_noah_05_90","text":"But when I was protecting you two, I really felt like I grew stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_91","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_05_91","text":"The people you want to protect make you strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_92","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_92","text":"Well... if that's the case, then tell me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_93","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_93","text":"Who should I put behind my shields?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_94","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_94","text":"If I always have someone to fight for...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_95","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_95","text":"I'll always be getting stronger and stronger, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_96","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_05_96","text":"What about the people in Eden?","jump":"d_nikke_noah_05_98","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_97","type":"Choice","