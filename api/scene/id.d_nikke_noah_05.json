,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_77","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_05_77","text":"You forgot to tell her to become stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_78","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_78","text":"... Eh. Well, if she gets into trouble again, I'll just save her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_79","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_79","text":"That's the benefit of being strong. It's no big deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_80","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_05_80","text":"You have done well.","jump":"d_nikke_noah_05_82","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_81","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_noah_05_81","text":"She looks sad.","jump":"d_nikke_noah_05_83","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_82","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_82","text":"Done... well... Yeah.","jump":"d_nikke_noah_05_84","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_05_83","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_05_83","text":"... What are you talking about? I shouldn'