ays of ensuring you won't be able to harm yourself.\nYou won't be able to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_08_s_14","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_08_s_14","text":"You don't know how I plan to blow myself up, so that's an empty threat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_08_s_15","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_08_s_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_08_s_16","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_08_s_16","text":"Chatterbox stops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_08_s_17","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_08_s_17","text":"... Fine.\nOne question, and one question only.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_08_s_18","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_08_s_18","text":"Two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_08_s_19","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_06_08_s_19","text":"... Fine, okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_08_s_20","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_08_s_20","text":"You suddenly feel a sense of elation.","jump":nul