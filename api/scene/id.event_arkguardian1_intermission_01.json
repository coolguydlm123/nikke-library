null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_intermission_01_90","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_intermission_01_90","text":"However,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_intermission_01_91","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_intermission_01_91","text":"think through what you want to say before you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_intermission_01_92","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_intermission_01_92","text":"If you intend to come to me simply to whine, don't bother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_intermission_01_93","type":"Speech","speaker":"commander","key":"Locale_MainScenario:event_arkguardian1_intermission_01_93","text":"Let's go, Lilith.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_intermission_01_94","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_intermission_01_94","text":"... Yes, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_intermission_01_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkguardian1_intermission_01_95","text":"The Commander and Liliweiss leave the meeting room,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affin