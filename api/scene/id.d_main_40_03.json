{"id":"d_main_40_03","cat":"main","group":{"id":"ch40","label":"Chapter 40 · Choice"},"label":"The Splinter in the Depths","stage":"40-9 STAGE · Start","prev":"d_main_40_02","next":"d_main_40_04","speakers":{"nayuta_n":"Nayuta","maxwell_p":"Maxwell","rapi_red":"Rapi"},"icons":{"nayuta_n":"si_c9008_00_s","maxwell_p":"si_c105_00_s","rapi_red":"si_c016_00_s"},"lines":[{"id":"d_main_40_03_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_03_1","text":"Nayuta.","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta_n"],"affinity":null},{"id":"d_main_40_03_2","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_2","text":"Dost thou wonder how I come by such knowledge?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_03_3","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_4","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_5","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_5","text":"In times past, I held fellowship with a certain group.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_6","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_6","text":"Having reached the zenith of our craft, we thereby hath grown prideful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_7","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_7","text":"That hubris turned poisonous and did sow division amongst our ranks. I am but a splinter torn from that strife.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_8","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_8","text":"We were a fellowship that hath done and achieved much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_9","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_9","text":"Thus, with humble heart, I confess to possessing knowledge beyond that of others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_10","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_10","text":"That is the sum of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_03_11","text":"So you're saying you were a member of D.E.E.P.?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_12","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_12","text":"Great Hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_13","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_13","text":"Concern thyself not with matters of the Profound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_14","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_14","text":"They are a fellowship of naught but evil, an abyss of the Ark... nay, of the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_15","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_15","text":"'Tis my desire that thou cast this matter from thy mind—as shall I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_16","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_03_16","text":"I feel like we're inevitably going to get involved at some point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_17","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_18","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_18","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_19","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_19","text":"Indeed. So shall it come to pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_20","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_20","text":"Thou wast born unto such a fate, Great Hero. 'Tis inexorable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_21","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_21","text":"Mark but one thing well, I beseech thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_22","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_22","text":"The Great Hero is what thou art, that is the truth indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_03_23","text":"I understand. I'll remain loyal to my mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_24","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_24","text":"Verily, thou art a fine specimen worthy of the Forerunner's keen gaze. A glance doth reveal all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_25","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_25","text":"Behold, dost thou see yonder ahead?","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":null,"movie":null,"shown":["maxwell_p","rapi_red"],"affinity":null},{"id":"d_main_40_03_26","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_03_26","text":"Is that... a house?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_03_27","text":"Is that where Raptilion lives?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_28","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_28","text":"Aye, 'tis the dwelling where Harmonizer doth eat and rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_29","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_29","text":"There is likewise a high chance that he hath brought the members of the Maleficent Beast Quartet thither as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_30","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_30","text":"It seemeth they have not yet arrived. Perchance, we should wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_31","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_31","text":"There is also another whom I wish to introduce unto thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_32","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_03_32","text":"An introduction?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_33","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_33","text":"Haha. Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_34","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_34","text":"Now, then, I shall guide thee. Follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_35","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_03_35","text":"... I think it'd be best if we lead, and you follow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_36","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_03_36","text":"I'll take point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_37","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_37","text":"Nay, how couldst thou lead the way? 'Tis thy first time here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_38","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_03_38","text":"'Tis not an easy path to follow. One misstep, and thou art likely to lose thy way...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_03_39","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_03_39","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}