{"id":"d_main_46_05","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"Rebirth","stage":"46-17 STAGE · Start","prev":"d_main_46_04","next":"d_main_46_06","speakers":{"mirror_r":"Mirror","nayuta":"Nayuta","snowwhite_h":"Snow White"},"icons":{"mirror_r":"si_c982_00_s","nayuta":"si_c223_00_s","snowwhite_h":"si_c471_00_s"},"lines":[{"id":"d_main_46_05_1","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_1","text":"After the battle at Eden, the first thing the Queen did","jump":null,"exit":false,"enter":null,"bg":"SpaceStationRoad","bgArt":"spacestationroad","image":null,"bgm":"event_bgm_goddessfall_anothermirror","movie":null,"shown":["snowwhite_h","nayuta","mirror_r","janghwa_n"],"affinity":null},{"id":"d_main_46_05_2","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_2","text":"was roam around, surveying the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_3","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_3","text":"She looked like some legendary hero wandering the surface, riding atop Storm Bringer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_4","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_4","text":"I watched to see how long she would continue in this vein,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_5","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_5","text":"when she settled at the Lift without warning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_6","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_6","text":"She began overhauling the derelict equipment within,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_7","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_7","text":"turning it into Rapture production facilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_8","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_8","text":"You would have me believe she hath built a factory?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_9","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_9","text":"Yes, she converted everything in one go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_10","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_10","text":"Humanity's finest technology was already concentrated there, so there was plenty to work with and the overhaul wasn't challenging.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_11","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_11","text":"She tinkered away at it, then began to produce Raptures like it was nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_12","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_12","text":"Whence came the materials?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_13","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_13","text":"Even the Queen cannot conjure something from naught...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_14","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_15","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_15","text":"Seems like you've figured something out. Let's hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_16","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_16","text":"... Doth the Queen tear it all asunder?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_17","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_17","text":"You've got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_18","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_18","text":"The Queen was deeply dissatisfied with the current state of the surface after surveying it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_19","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_19","text":"So she made a decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_20","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_20","text":"She would wipe the slate clean,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_21","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_21","text":"since the surface wasn't one she envisioned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_22","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_22","text":"And just like that, she started producing Raptures at the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_23","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_23","text":"I see. She hath created Raptures that are unlike any known to us now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_24","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_24","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_25","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_25","text":"She used existing Raptures as raw material,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_26","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_26","text":"and created entirely new ones.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_27","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_27","text":"Hehe. These... newborns, shall we call them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_28","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_28","text":"They're not drastically different from their predecessors performance-wise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_29","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_29","text":"But their appearance... now that's where things get interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_30","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_30","text":"... They seemed to be imitating human body parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_31","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_31","text":"They're imitating Nikke body parts, to be precise. But visually, there isn't much difference between the two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_32","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_32","text":"I believe the battle at Eden brought about a significant shift in the Queen's thinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_33","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_33","text":"She gathered Raptures and even Heretics as a show of strength, to celebrate her descent to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_34","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_34","text":"But the bulk of her forces fell, and you all managed to pull through largely unscathed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_35","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_35","text":"Although things ended with her seizing the body of the strongest Nikke, Liliweiss,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_36","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_36","text":"I'm sure that's far from a satisfying result to the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_37","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_37","text":"She must have concluded that the current Raptures simply weren't powerful enough,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_38","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_38","text":"and felt a generational shift was needed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_39","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_39","text":"Otherwise, she wouldn't have gone out of her way to create newborn Raptures modeled after you Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_40","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_41","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_41","text":"How repulsive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_42","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_42","text":"No core could be discerned in these newly born Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_43","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_43","text":"Then whence do they draw their power?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_44","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_44","text":"From Dark Matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_45","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_45","text":"Caliginous Material...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_46","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_46","text":"They use highly condensed Dark Matter as a power source. It's a versatile substance, so using it that way is certainly feasible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_47","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_47","text":"I don't know much beyond that. But since Dark Matter is the Queen's to begin with, she is another matter entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_48","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_49","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_49","text":"So, in short, after fighting us, the Queen became jealous of us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_50","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_50","text":"Which led to her creating new Raptures in our image.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_51","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_51","text":"That about sums it up, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_52","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_52","text":"Yet the manner of their imitation is most suspect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_53","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_53","text":"If the Queen deemed Nikkes powerful, one would expect their forms to be imitated in every particular.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_54","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_54","text":"And yet the manner of imitation here is most peculiar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_55","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_55","text":"Only hands, feet, viscera and the like doth she see fit to replicate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_56","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_56","text":"Hmm, well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_57","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_57","text":"They're experiments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_58","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_58","text":"She attaches Nikke parts to low-level Raptures to see if they function properly,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_59","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_59","text":"and to assess the potential of those parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_60","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_60","text":"If this be true, the Queen's final intent is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_61","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_61","text":"That's right. To create a new Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_62","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_62","text":"The Queen's so-called elites proved rather lackluster in the battle at Eden, wouldn't you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_63","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_63","text":"She wants to create a true elite. One worthy of the Queen she is today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_64","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_64","text":"... Altruia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_65","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_66","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_66","text":"How do you know about her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_67","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_67","text":"We've met. She even transformed during our fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_68","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_68","text":"My goodness... she really does whatever she pleases.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_69","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_69","text":"She was mimicking Rapunzel and Noah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_70","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_70","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_71","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_71","text":"The Queen picked the ones who stood out most to her during the battle at Eden and modeled her Heretics after them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_72","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_72","text":"Two have been created, and one is still in the making.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_73","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_73","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_74","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_74","text":"You know a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_75","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_75","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_76","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_76","text":"Who are you, really? What's your angle?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_77","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_77","text":"I want a new Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_78","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_78","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_05_79","text":"Mirror looks at the Lift.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_80","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_80","text":"Because I don't like the current Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_81","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_81","text":"You're hardly the trustworthy type.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_82","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_82","text":"That stings, especially after I shared such valuable intel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_83","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_83","text":"You must trust me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_84","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_84","text":"I've been doing all kinds of dirty work at the Queen's side to obtain this precious information, and I'm giving it to you with no strings attached.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_85","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_85","text":"Yes, that's been bothering me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_86","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_86","text":"What is your relationship with the Queen? How do you know all of this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_87","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_87","text":"I've had a hand in the overhaul of the Lift, the design of the newborn Raptures, and in the creation of the new Heretics of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":nu