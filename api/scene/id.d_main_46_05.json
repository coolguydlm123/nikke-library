 have?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_95","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_05_95","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_96","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_96","text":"Believe me or don't. That's entirely up to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_97","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_97","text":"Frankly, I couldn't care less whether you win or lose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_98","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_98","text":"I'll simply side with whoever wins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_99","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_05_99","text":"How enviable, to hold such clear convictions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_100","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_100","text":"Now, let's get moving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_05_101","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:d_main_46_05_101","text":"This isn't a place you can visit often, so take in as much as you can.","jump":nul