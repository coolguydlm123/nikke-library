01_33","text":"From a 4 km height, the elevator dropped and headed directly towards the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_34","type":"Speech","speaker":"neon","key":"Locale_SuddenStory:d_ex_elevator_01_34","text":"If the elevator hit, it would have spelled disaster to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_35","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_36","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_36","text":"The 200 Nikkes in the elevator decided to self-destruct","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_37","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_37","text":"to protect the Ark from the deadly smash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_38","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_38","text":"The elevator just exploded in mid-air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_39","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_39","text":"The Ark only suffered minor damage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_40","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_40","text":"... But those Nikkes, who wanted to go to the surface to run away from human oppression,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_41","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_41","text":"were sentenced to their deaths.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_42","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_42","text":"Even in their final moments, they did all they could to protect people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_43","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_43","text":"I think that is the noblest thing in the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_44","type":"Speech","speaker":"neon","key":"Locale_SuddenStory:d_ex_elevator_01_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_45","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_45","text":"The incident was later referred to as the \"Goddess Fall\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_46","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_46","text":"Enforcement of Nikke rights in the Ark began improving after that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":nu