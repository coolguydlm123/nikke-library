ie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_13","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_13","text":"Ah, that accident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_14","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_14","text":"... Don't remind me. Every time I think of that, it makes me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_15","type":"Speech","speaker":"neon","key":"Locale_SuddenStory:d_ex_elevator_01_15","text":"Makes you what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_16","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_17","type":"Speech","speaker":"neon","key":"Locale_SuddenStory:d_ex_elevator_01_17","text":"It makes you blue?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_18","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_18","text":"Not really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_19","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_19","text":"Just a little... sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_20","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_20","text":"... Me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_21","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_elevator_01_21","text":"What happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_22","type":"Speech","speaker":"anis","key":"Locale_SuddenStory:d_ex_elevator_01_22","text":"Eh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_23","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_23","text":"70 years ago, more than 200 Nikkes took the elevator and went to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_title_godnessfall","movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_24","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_24","text":"At that time, the Ark was struggling because of the ongoing war against the Raptures. The situation got worse and worse each day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_25","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_25","text":"Then, people of the Ark blamed the Nikkes because they couldn't defeat the Raptures in battle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_elevator_01_26","type":"Speech","speaker":"rapi","key":"Locale_SuddenStory:d_ex_elevator_01_26","text":"Nikkes were treated like trash in the Ark and were given almost no rights to anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i