{"id":"d_main_40_02","cat":"main","group":{"id":"ch40","label":"Chapter 40 · Choice"},"label":"The Queen's Qualifications","stage":"40-6 STAGE · Start","prev":"d_main_40_01","next":"d_main_40_03","speakers":{"nayuta_n":"Nayuta","rapi_red":"Rapi","maxwell_p":"Maxwell"},"icons":{"nayuta_n":"si_c9008_00_s","rapi_red":"si_c016_00_s","maxwell_p":"si_c105_00_s"},"lines":[{"id":"d_main_40_02_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_1","text":"A gene?","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["rapi_red","nayuta_n","maxwell_p"],"affinity":null},{"id":"d_main_40_02_2","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_2","text":"Verily, thy body is imbued with latent abilities, fashioned for a singular purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_3","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_3","text":"Thou hast been granted two main powers, one of which doth course through thy blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_4","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_4","text":"It beareth the name Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_5","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_5","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_6","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_6","text":"Vapaus ought to be an ability bestowed by birth, awakening without need of conditions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_7","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_7","text":"Yet the art to infuse Vapaus into the blood was long since established, so it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_8","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_8","text":"As for thy other ability...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_9","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_9","text":"... It's the power to regenerate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_10","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_10","text":"So it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_11","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_11","text":"This ability doth awaken only in later days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_12","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_12","text":"Hast thou perchance perceived that it doth grow ever stronger as the sands of time do pass?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_13","text":"Yeah... it has.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_14","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_14","text":"That surely implies...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_15","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_16","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_16","text":"There exists a thing called","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_17","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_17","text":"the Queen Gene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_18","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_18","text":"Simply put, it may be regarded as the qualification one must bear to become the Rapture Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_19","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_19","text":"At present, the Queen Gene findeth no resting place; it abideth not where it ought to dwell,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_20","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_20","text":"and such a state hath endured for many a long year.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_21","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_21","text":"Yet verily, the Raptures are in need of a Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_22","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_22","text":"In some among the mighty Raptures and Heretics, the Queen Gene doth awaken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_23","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_23","text":"It is as though the Raptures, bound in a colony, cannot endure the Queen's absence, and thus strive to bring forth a new sovereign.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_24","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_24","text":"Great Hero, thy regenerative power","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_25","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_25","text":"is bound in tandem with the Queen Gene; when one awakens, so too doth the other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_26","text":"So you're saying the Queen Gene's been activated somewhere?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_27","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_27","text":"Indeed, to view it thus is most reasonable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_28","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_28","text":"But why does the Commander have this ability?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_29","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_29","text":"And why does it respond to the Queen Gene like it does?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_30","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_30","text":"That, I know not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_31","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_31","text":"My best conjecture is that this power was bestowed upon him for a purpose yet to be fulfilled alongside the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_32","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_32","text":"Elsewise, why set such a burdensome condition for its awakening?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_33","text":"The Queen... and I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_35","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_35","text":"Nayuta, am I human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_36","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_36","text":"This humble one knows not whether thou art human, or some being beyond.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_37","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_37","text":"Is that of import?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_38","text":"Of course... it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_39","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_39","text":"How so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_40","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_40","text":"Whether thou art a Rapture, a Nikke, a human, a Heretic, or aught else, thou art still thyself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_41","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_41","text":"That changeth not the deeds thou hast done, the purpose thou pursuest, nor the tasks thou must fulfill.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_42","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_42","text":"Is it then of great import to thee how others see thee in this regard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_44","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_44","text":"To ponder existence is noble, but do not become so entangled in it that thou forget what must be done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_45","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_45","text":"For few things are so apt at squandering time as that, I say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_46","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_46","text":"That's similar to what you once told me, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_47","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_47","text":"Just as I am me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_48","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_48","text":"you are you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_49","text":"... Got it. At any rate, there's no point in me worrying about it now. Let's focus on the task at hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_50","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_50","text":"Understood. I believe in you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_51","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_51","text":"So the reason why Cutey's body is acting so strange is that somewhere,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_52","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_52","text":"the Queen Gene has activated, which has also caused the gene that Cutey carries to activate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_53","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_53","text":"... Doesn't this ring a bell?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_54","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_55","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_55","text":"The Four Beasts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_56","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_56","text":"That's right. They're making—or at least trying to make—a Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_57","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_57","text":"But what if it's all a lie?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_58","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_58","text":"If the Four Beasts have already succeeded in creating a Queen, and it's her genes which are activating these changes in Cutey...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_59","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_59","text":"Then that would make the most sense to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_60","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_60","text":"That adds up. You may be onto something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_61","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_61","text":"Then if the Four Beasts' Queen and I were to meet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_62","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_62","text":"There's a chance something could happen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_63","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_63","text":"Most likely, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_64","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_64","text":"Nayuta, there's no way to predict what would happen, is there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_65","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_65","text":"Indeed. I know not a way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_66","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_66","text":"Yet, I hold the sense that this will not result in calamity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_67","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_67","text":"The power of thy regeneration, Great Hero, is known to all as a gift that wardeth off death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_68","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_68","text":"There is great intent to safeguard thy life and bring thee unto the Queen's presence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_69","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_69","text":"Therefore...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_70","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_70","text":"Indeed, this is a reckless notion. Nevertheless, it may be worthwhile to meet and see for oneself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_71","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_71","text":"I guess it's better than something happening without knowing why.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_72","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_72","text":"At least we'll know that something will happen, and we can prepare accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_73","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_73","text":"But verily, there is one thing which weighs upon my mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_74","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_74","text":"Among the Heretics, there is one known by the name Gene Reaper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_75","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_75","text":"This one doth eliminate those upon whom the Queen Gene is awakened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_76","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_76","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_77","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_77","text":"As the might of the Queen Gene increaseth, it doth extend its sway both o'er the Rapture and even unto the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_78","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_78","text":"The nature of that influence is absolute submission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_79","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_79","text":"All Rapture and Heretics shall fall under complete subjugation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_80","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_80","text":"However, one among the Heretics found and slew the vessel of the activated Queen Gene before their power came into full being.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_81","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_81","text":"Though the cause eludes me, the instances known to mine own self number in the dozens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_82","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_82","text":"Be it by ill fate or fortune's grace, the Queen hath not yet shown herself upon the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_83","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_83","text":"Such dogged persistence amounting to blind obsession, the Heretics would scarce have overlooked the manifestation of the Queen Gene...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_84","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_84","text":"... Dark Matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_85","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_85","text":"The Four Beasts said that the Dark Matter they shroud their bodies in prevents the Heretics from detecting them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_86","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_86","text":"If the way Heretics sense each other works the same as how they detect the Queen Gene...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_87","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_87","text":"If the Queen created by the Four Beasts were likewise enveloped in Dark Matter, the Heretic known as the Gene Reaper would not be able to find her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_88","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_88","text":"Is Caliginous Material indeed capable of such a function?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_89","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_89","text":"If so... then all the pieces do fall into place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_90","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_90","text":"The Maleficent Beast Quartet's Queen hath been wrought, and the Queen Gene hath awakened within her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_91","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_91","text":"In response, the Great Hero's regenerative power hath been stirred, and the Gene Reaper findeth not the Queen of the Maleficent Beast Quartet, by reason of the Caliginous Material.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_92","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_40_02_92","text":"Such is the summation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_93","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_93","text":"So we stick to our original goal and find Leviathan and Ziz.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_94","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_02_94","text":"Then we figure out the location of the Queen and either capture her or have Cutey make contact, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_95","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_02_95","text":"Sounds about right to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_02_96","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_02_96","text":"Then, let's press on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}