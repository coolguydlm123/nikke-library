_7","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_7","text":"It simply did not shine, non?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_8","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_05_8","text":"There's no star to be found here, Mustang, and you know it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_9","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_9","text":"Is that what you believe, vraiment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_10","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_05_10","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_11","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_11","text":"It's not good to lie, Mrs. Miss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_12","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_12","text":"I know you never abandonné your search.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_13","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_13","text":"That desperate search landed you in the Rehabilitation Center, and then led you all the way out to the Outer Rim, n'est-ce pas?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_14","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_05_14","text":"If you knew this all along, why did you keep hiding it from me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_15","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_15","text":"You already know la réponse to that question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_16","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_16","text":"You're the one who creates les monstres in the entertainment industry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_17","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_17","text":"Je suppose you could call yourself un Monster Maker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_18","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_05_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_19","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_40_af_05_19","text":"Are you planning to help ma chérie Anis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_05_20","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_05_20","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm