{"id":"d_main_23af_01","cat":"main","group":{"id":"ch23","label":"Chapter 23 · Prison"},"label":"The Forgotten Name","stage":null,"prev":"d_main_23_11_e","next":"d_main_23af_02","speakers":{"poli":"Poli","dorothy":"Dorothy","miranda":"Miranda"},"icons":{"poli":"si_c030_00_s","dorothy":"si_c233_00_s","miranda":"si_c032_00_s"},"lines":[{"id":"d_main_23af_01_1","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_1","text":"This is the first time a Pilgrim has ever been inside the Ark.","jump":null,"exit":false,"enter":null,"bg":"GoddessOfVictory","bgArt":"goddessofvictory","image":null,"bgm":"bgm_inark","movie":null,"shown":["miranda","dorothy","poli"],"affinity":null},{"id":"d_main_23af_01_2","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_2","text":"That's right. Breaking new ground, here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_3","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_3","text":"How do you find it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_4","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_5","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_5","text":"Not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_6","text":"I always wanted to come to this place, but now that I'm here,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_7","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_7","text":"I have to say, I don't have any strong feelings about it one way or the other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_8","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_8","text":"To be honest, it's not much different than the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_9","text":"It's spacious, and it's teeming with Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_10","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23af_01_10","text":"That's only because we've cleared the streets due to the Rapture invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_11","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23af_01_11","text":"Normally, this place is packed with people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_12","text":"Is that right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_13","text":"I wonder how I'd feel,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_14","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_14","text":"seeing a sight like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_15","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_15","text":"You chose a heck of a time to show up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_16","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_16","text":"That Heretic really caught us with our pants down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_17","text":"Did it, now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_18","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23af_01_18","text":"It sure did. You couldn't have shown up at a better time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_19","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23af_01_19","text":"The timing was perfect, really. It's almost as if it had been planned!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_20","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"ima