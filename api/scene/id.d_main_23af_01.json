"shown":null,"affinity":null},{"id":"d_main_23af_01_28","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_28","text":"What is that statue over there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_29","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_29","text":"Oh, that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_30","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_30","text":"It's called the Goddess of Victory. It was made to commemorate the Goddess squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_31","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_32","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23af_01_32","text":"You'll find these all over the Ark, and they're well taken care of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_33","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23af_01_33","text":"In fact, every time I get in trouble, I'm assigned to clean all the Goddess of Victory statues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_34","type":"Speech","speaker":"miranda","key":"Locale_MainScenario:d_main_23af_01_34","text":"I'm not done until they're practically shimmering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_35","text":"Why have they erected these statues?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_36","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_36","text":"Huh? Well, because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_37","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_37","text":"they're the saviors of humankind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_23af_01_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_39","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_39","text":"They're a legend around these parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_40","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_40","text":"They were the best Nikke squad there ever was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_41","type":"Speech","speaker":"poli","key":"Locale_MainScenario:d_main_23af_01_41","text":"And...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_23af_01_42","typ