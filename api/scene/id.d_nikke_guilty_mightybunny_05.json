{"id":"d_nikke_guilty_mightybunny_05","cat":"bond","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Innocent Bunny","stage":null,"prev":"d_nikke_guilty_mightybunny_04","next":null,"speakers":{"guilty_b":"Guilty"},"icons":{"guilty_b":"si_c404_00_s"},"lines":[{"id":"d_nikke_guilty_mightybunny_05_1","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_1","text":"When I'm finally rehabilitated... When that happens, are you going to leave me, Counselor...?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"none","movie":null,"shown":["guilty_b"],"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_2","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_2","text":"Uncertainty flickers in Guilty's eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_3","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_3","text":"I immediately reach out and take her hands in mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_confetti","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_4","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_4","text":"Counselor...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_5","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_5","text":"Guilty, there's something I've been wanting to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_6","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_6","text":"Wh-what is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_7","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_7","text":"You're not the only one who's changed through your rehabilitation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_8","text":"I've learned a lot from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_9","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_9","text":"You felt lonely when you got caught up in all those rumors at the Rehabilitation Center, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_10","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_10","text":"Yeah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_11","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_11","text":"A lot happened in my past...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_12","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_12","text":"Once I'd been branded with that label... it was so hard to move forward...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_13","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_13","text":"No one would listen to me... or believe me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_14","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_14","text":"They just... feared my strength...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_15","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_15","text":"But there's something even more powerful than the strength to break bones. It's the strength to change yourself for someone you care about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_16","text":"That's what you taught me, Guilty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_17","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_17","text":"Thank you for doing what I asked. And... thank you for not using your strength to test people's trust in you anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_18","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_18","text":"C-Counselor, I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_19","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_19","text":"I didn't know you noticed how hard I've been trying...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_20","text":"I'm not going anywhere, Guilty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_21","text":"Even after you're fully rehabilitated, we'll still keep learning from each other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_22","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_22","text":"O-okay! Even if I'm rehabilitated... even if I change... we'll still be... together...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_23","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_23","text":"Hehe... hehehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_24","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_24","text":"I've never... been so happy that I actually laughed before...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_25","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_25","text":"... Hey, Counselor... there's just one last thing... I want you to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_26","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_26","text":"It was... really hard for me to change clothes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_27","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_28","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_28","text":"Getting changed into this was... really hard...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_29","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_29","text":"So... it'd really make me happy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_30","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_30","text":"If you could say \"thank you\" one more time...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_31","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_31","text":"Guilty steals a glance at the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_32","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_32","text":"... Thanks for dressing up as a bunny girl, Guilty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_33","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_33","text":"Hehe... any time...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_34","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_34","text":"At first... I wasn't used to this outfit, so it was hard to move around...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_35","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_35","text":"But I think I get it now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_36","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_36","text":"How a bunny girl walks... how she sits...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_37","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_37","text":"How I should come up to you... when I'm your bunny girl...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_38","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_38","text":"How I should hug you... Yeah, I think I really get it now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_39","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_39","text":"Guilty wraps her arms around me from behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_40","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_40","text":"You...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_41","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_41","text":"Her hold is incredibly gentle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_42","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_42","text":"Counselor... am I holding you too tightly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_43","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_43","text":"I'm... trying to keep my strength under control...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_44","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_44","text":"Guilty steps in front of me and pulls me into a gentle but firm embrace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_45","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_45","text":"How does it feel, Counselor...? Hmm...? Is this how you like it...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_46","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_46","text":"Or... maybe a little more... like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_47","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_47","text":"If I'm squeezing too tight or you can't breathe... tell me, okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_48","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_48","text":"I want to get to know you better, Counselor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_49","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_49","text":"Guilty looks up at me anxiously, searching my face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_50","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_50","text":"She gauges my reaction from my expression and adjusts the strength of her grip accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_51","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_51","text":"This feels... seriously wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_52","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_52","text":"C'mon, it's nothing like that... I'm innocent, hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_53","type":"Speech","speaker":"guilty_b","key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_53","text":"Mmm, Counselor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_54","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_54","text":"Guilty nestles into my arms like a child.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_guilty_mightybunny_05_55","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_guilty_mightybunny_05_55","text":"I can't match your strength, but...","jump":null,"exit":false,"enter":null,"