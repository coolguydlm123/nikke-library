{"id":"d_counseling_marciana_11","cat":"counsel","group":{"id":"char5048","label":"Marciana"},"label":"Advising Marciana: 11","stage":null,"prev":"d_counseling_marciana_10","next":"d_counseling_marciana_12","speakers":{"marciana":"Marciana"},"icons":{"marciana":"si_c321_00_s"},"lines":[{"id":"d_counseling_marciana_11_1","type":"Speech","speaker":"marciana","key":"Locale_Counseling:d_counseling_marciana_11_1","text":"Drones are all the rage with the student body.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["marciana"],"affinity":"_0"},{"id":"d_counseling_marciana_11_2","type":"Speech","speaker":"marciana","key":"Locale_Counseling:d_counseling_marciana_11_2","text":"I can't tell you how many classroom windows have gotten shattered because of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marciana_11_3","type":"Speech","speaker":"marciana","key":"Locale_Counseling:d_counseling_marciana_11_3","text":"I'm trying to think about how I should handle this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_marciana_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marciana_11_4","text":"Is there any way to encourage them to fly their drones outside?","jump":"d_counseling_marciana_11_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_marciana_11_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_marciana_11_5","text":"You should forbid them from flying drones inside the classroom.","jump":"d_counseling_marciana_11_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"i