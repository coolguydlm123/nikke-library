peaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_03_63","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_64","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_03_64","text":"As I quietly gaze at the planter, I'm overcome with an indescribable feeling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_65","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_65","text":"The sprout emerging is just the beginning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_66","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_66","text":"It will grow faster from now on, and it will need more nutrients than before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_67","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_03_67","text":"Should I give it more water?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_68","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_68","text":"No. If you give it too much water too quickly, you will do more harm than good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_69","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_69","text":"Instead, talk to it and keep it in your thoughts more often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_70","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_03_70","text":"Huh? That's it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_71","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_71","text":"Yes. That will be more than enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_72","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_03_72","text":"Sounds pretty simple. I thought this would be more difficult.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_73","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_73","text":"Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_74","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_74","text":"It might seem simple to you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_75","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_75","text":"but most people simply water their plants and call it a day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_76","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_76","text":"Spending actual time with them and connecting with them is something people find difficult.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_77","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_77","text":"Both I, and the little one, feel it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_78","type":"Speech","speaker":"flora","key":"Locale_NikkeEpisode:d_nikke_flora_03_78","text":"We can sense what a kind person you are, Tulip.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_79","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_03_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_80","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_03_80","text":"Thank you for making an appearance, Sprout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_81","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_flora_03_81","text":"Hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_82","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_03_82","text":"I'm still not exactly used to the notion of conversing with a plant,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_83","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_03_83","text":"but the fact that I've given life to something","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_flora_03_84","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_flora_03_84","text":"does excite me in many ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}