r location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_19","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_intermission_01_19","text":"We won't be working out in the gym today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_20","type":"Speech","speaker":"folkwang","key":"Locale_SubScenario:event_lifeagain_intermission_01_20","text":"Um... just a minute, I think I left my supplements back in the dormitory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_21","type":"Speech","speaker":"epinel","key":"Locale_SubScenario:event_lifeagain_intermission_01_21","text":"Oh, right! I forgot that I had plans this morning. I'll be right back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_22","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_lifeagain_intermission_01_22","text":"I just had a killer migraine flare-up...","jump":"event_lifeagain_intermission_01_24","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_23","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_lifeagain_intermission_01_23","text":"I just had a bad stomachache flare-up...","jump":"event_lifeagain_intermission_01_24","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_24","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_intermission_01_24","text":