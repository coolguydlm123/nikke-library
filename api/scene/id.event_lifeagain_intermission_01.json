r":"folkwang","key":"Locale_SubScenario:event_lifeagain_intermission_01_30","text":"... Although I could stand for it to be a little colder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_31","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_intermission_01_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_32","type":"Speech","speaker":"epinel","key":"Locale_SubScenario:event_lifeagain_intermission_01_32","text":"I also occasionally practice skateboarding here whenever I can't outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_33","type":"Speech","speaker":"epinel","key":"Locale_SubScenario:event_lifeagain_intermission_01_33","text":"In here, I can more accurately simulate the tricks that I envision in my head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_34","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_intermission_01_34","text":"I didn't know this place existed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_35","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_intermission_01_35","text":"This is where we'll begin Nadia's therapy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_36","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_intermission_01_36","text":"I called Folkwang and Epinel over so they could lend us some assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_37","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_intermission_01_37","text":"Allow me to briefly explain Nadia's condition:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_38","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_intermission_01_38","text":"Currently, there are no issues with her muscle or nerve tissue. Her current inability to walk is psychosomatic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_39","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_lifeagain_intermission_01_39","text":"Rumani explains Nadia's condition to Folkwang and Epinel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_40","type":"Speech","speaker":"epinel","key":"Locale_SubScenario:event_lifeagain_intermission_01_40","text":"So it has to do with her past trauma?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_41","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_intermission_01_41","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_intermission_01_42","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_life