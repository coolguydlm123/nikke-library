{"id":"event_ce_01_04","cat":"event","group":{"id":"ev40008","label":"Collab 01 · Part 1"},"label":"Going on Strike","stage":null,"prev":"event_ce_01_03_e","next":"event_ce_01_05","speakers":{"c_2":"Power","c_3":"Himeno","c_npc_2":"Aki Hayakawa","c_npc_1":"Denji","Self":"Commander","anis":"Anis","rapi":"Rapi"},"icons":{"c_2":"si_c801_00_s","c_3":"si_c802_00_s","c_npc_2":"si_c804_00_s","c_npc_1":"si_c803_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"event_ce_01_04_1","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_1","text":"I'm declaring a strike.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_tuffguys","movie":null,"shown":["neon","rapi","anis","c_2","c_3","c_npc_1","c_npc_2"],"affinity":null},{"id":"event_ce_01_04_2","type":"Speech","speaker":"c_3","key":"Locale_SubScenario:event_ce_01_04_2","text":"What? Where'd that come from?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_3","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_3","text":"I meant what I said. I refuse to fight any further.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_4","type":"Speech","speaker":"c_3","key":"Locale_SubScenario:event_ce_01_04_4","text":"Okay, but why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_5","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_5","text":"I'm doing all the heavy lifting in these fights.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_6","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_6","text":"Meanwhile, you two are behind slacking!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_7","type":"Speech","speaker":"c_npc_2","key":"Locale_SubScenario:event_ce_01_04_7","text":"We're your backup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_8","type":"Speech","speaker":"c_npc_1","key":"Locale_SubScenario:event_ce_01_04_8","text":"Yeah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_9","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_9","text":"I don't need backup. That means you're of no use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_10","type":"Speech","speaker":"c_npc_2","key":"Locale_SubScenario:event_ce_01_04_10","text":"What does any of this have to do with you refusing to fight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_11","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_11","text":"While I'm fighting, you're doing nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_12","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_12","text":"I don't like it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_13","type":"Speech","speaker":"c_npc_1","key":"Locale_SubScenario:event_ce_01_04_13","text":"All right then, do you have any bright ideas?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_14","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_14","text":"It's simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_15","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_15","text":"You will become my slaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_16","type":"Speech","speaker":"c_npc_1","key":"Locale_SubScenario:event_ce_01_04_16","text":"Your slaves?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_17","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_17","text":"If neither of you are going to fight, the least you can do is make someone who IS fighting, like me, comfortable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_18","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_18","text":"We all know I'm the best fighter among us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_19","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_19","text":"It's only natural that you two should serve me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_20","type":"Speech","speaker":"c_npc_1","key":"Locale_SubScenario:event_ce_01_04_20","text":"This is ridiculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_21","type":"Speech","speaker":"c_npc_2","key":"Locale_SubScenario:event_ce_01_04_21","text":"I refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_22","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_22","text":"Very well, then promise to grant me one wish, and I'll consider fighting again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_23","type":"Speech","speaker":"c_npc_1","key":"Locale_SubScenario:event_ce_01_04_23","text":"It's almost impressive how much nonsense you're spouting right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_24","type":"Speech","speaker":"c_npc_2","key":"Locale_SubScenario:event_ce_01_04_24","text":"I'm not buying that either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_25","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_26","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_26","text":"Then I'm not fighting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_27","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_04_27","text":"This conversation is starting to go in circles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":nu