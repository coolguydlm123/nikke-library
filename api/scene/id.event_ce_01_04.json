ull,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_35","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_04_35","text":"We'll be resting in a little while. You can have something to eat then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_36","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_36","text":"If you don't give me their share as well, I won't fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_37","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_04_37","text":"We can't deprive Aki and Denji of their portions. They still need the energy to keep up with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_38","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_ce_01_04_38","text":"How about I give you a slightly bigger portion? Would that work?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_39","type":"Speech","speaker":"c_2","key":"Locale_SubScenario:event_ce_01_04_39","text":"Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_40","type":"Speech","speaker":"c_npc_2","key":"Locale_SubScenario:event_ce_01_04_40","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_04_41","type":"Speech","speaker":"c_npc_1","key":"Locale_SubScenario:event_ce_01_04_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":nu