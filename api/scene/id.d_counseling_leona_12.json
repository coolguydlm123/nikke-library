{"id":"d_counseling_leona_12","cat":"counsel","group":{"id":"char5092","label":"Leona"},"label":"Advising Leona: 12","stage":null,"prev":"d_counseling_leona_11","next":"d_counseling_leona_13","speakers":{"leona":"Leona"},"icons":{"leona":"si_c382_00_s"},"lines":[{"id":"d_counseling_leona_12_1","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_1","text":"Have you heard of the saying, \"The bigger they are, the cuter they are.\"?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["leona"],"affinity":"_0"},{"id":"d_counseling_leona_12_2","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_2","text":"Some students came to volunteer at the shelter, and I overheard one of them say that about Timi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_12_3","text":"I think that saying could apply to you as well, Leona.","jump":"d_counseling_leona_12_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_leona_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_12_4","text":"So by that rationale, the smaller something is, the less cute it is?","jump":"d_counseling_leona_12_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_leona_12_5","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_5","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_6","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_6","text":"So I'm big in what sense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_7","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_7","text":"As in my height? Or...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_8","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_8","text":"Anyway, I'll take it as a compliment. Thank you, Zoo Keeper.","jump":"d_counseling_leona_12_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_9","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_9","text":"Oh, I didn't mean it like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_10","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_10","text":"You would be unpopular if you spoke in this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_11","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_11","text":"Haha, there's no need to sulk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_12","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_12_12","text":"In my eyes, you're as cute as can be.","jump":"d_counseling_leona_12_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_12_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_leona_12_13","text":"Leona and I have an enjoyable time.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}