{"id":"event_ce006_2_02_s","cat":"event","group":{"id":"ev40080","label":"MEMORIES TELLER · Part 2"},"label":"Art's Sepulcher: A","stage":null,"prev":"event_ce006_2_01_e","next":"event_ce006_2_02_e","speakers":{"hermin":"Hermin","machinesound":"Mechanical voice","elegg":"Elegg","rapi":"Rapi","neon":"Neon","anis":"Anis"},"icons":{"hermin":"si_c998_00_s","machinesound":"si_c999_00_s","elegg":"si_c500_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s"},"lines":[{"id":"event_ce006_2_02_s_1","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_1","text":"I'm sorry if I startled you.","jump":null,"exit":false,"enter":null,"bg":"bunkerofartist","bgArt":"bunkerofartist","image":null,"bgm":"collab_bgm_sb_hallofrecords","movie":null,"shown":["neon","anis","elegg","rapi","hermin"],"affinity":null},{"id":"event_ce006_2_02_s_2","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_2","text":"It's been so long since I've seen any other beings, human or Nikke,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_3","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_3","text":"that I forgot how shocking my appearance might be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_4","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_02_s_4","text":"It's all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_5","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_02_s_5","text":"Are you okay, though? You don't seem well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_6","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_6","text":"Hehe, this body of mine is on its last legs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_7","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_7","text":"I might be nearing the end of the line, but I can still speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_8","type":"Speech","speaker":"machinesound","key":"Locale_MainScenario:event_ce006_2_02_s_8","text":"Time for fluid intake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_9","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_9","text":"Oh, excuse me for one moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_10","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_ce006_2_02_s_10","text":"Hermin takes a drink of water from a cup outfitted on the handle of his wheelchair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_11","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_02_s_11","text":"A medical assistance wheelchair. It's rather old, but the craftsmanship is impressive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_12","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:event_ce006_2_02_s_12","text":"It seems like an early prototype for the modern ones we use in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_13","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_13","text":"*Cough cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_14","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_14","text":"I'm sor... *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_15","type":"Self","speaker":null,"key":"Locale_MainScenario:event_ce006_2_02_s_15","text":"Take your time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_16","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_16","text":"Whew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_17","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_18","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_18","text":"Well... I don't exactly know where to start, so if you have any questions, feel free to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_02_s_19","text":"Are you a human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_20","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_20","text":"Yes, I'm a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_21","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_21","text":"You of all people should know that there's no such thing as male Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_22","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_02_s_22","text":"Uh... may I ask how old you are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_23","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_23","text":"I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_24","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_24","text":"If I had to guess... around 145?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_s_25","text":"Wow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_26","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_26","text":"Hehe, it sounds funny saying it out loud like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_02_s_27","text":"You're like... uber old.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_s_28","text":"For goodness sake, Neon. Watch what you say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_29","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_29","text":"Hehe, it's all right. I suppose I have aged quite a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_30","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_02_s_30","text":"Have you ever taken Evergreen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_31","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_31","text":"Yes, I was lucky enough to receive it multiple times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_32","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_32","text":"But when I stopped taking it, my aging resumed, as you can tell by my current state.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_s_33","text":"When did you first arrive in this place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_34","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_34","text":"I came in here when I was in my 40s,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_35","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_35","text":"so I suppose it's been over 100 years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_s_36","text":"And you've been here that entire time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_37","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_37","text":"Pretty much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_38","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_38","text":"I came here not long","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_39","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_39","text":"after the Rapture invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_ce006_2_02_s_40","text":"No way... how is that even possible?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_41","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_41","text":"This place was built to last.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_42","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_42","text":"It's an incredibly sturdy construction, so that's why I've been able to survive here for as long as I have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_43","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_02_s_43","text":"But why did you stay here the entire time? Why not leave and go somewhere else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_44","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_44","text":"The entrance was blocked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_45","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_45","text":"I couldn't get out even if I wanted to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_46","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_46","text":"Thanks to you all, however, I was finally able to feel the sunlight again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_47","type":"Speech","speaker":"neon","key":"Locale_MainScenario:event_ce006_2_02_s_47","text":"Did you come here to stay hidden from the Raptures? This place feels like a bunker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_48","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_48","text":"You're right, it is a bunker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_49","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_02_s_49","text":"For a bunker, the facilities are a bit meager. There's only the bare minimum needed here to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_50","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_50","text":"That's because it was built for a special purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_51","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_ce006_2_02_s_51","text":"And what is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_52","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce006_2_02_s_53","type":"Speech","speaker":"hermin","key":"Locale_MainScenario:event_ce006_2_02_s_53","text":"The purpose was...","jump":null,"exit":false,"enter":nu