{"id":"event_ce_01_06_s","cat":"event","group":{"id":"ev40009","label":"Collab 01 · Part 2"},"label":"Blast from the Past: A","stage":null,"prev":null,"next":"event_ce_01_06_e","speakers":{"Narration":"Narration","andersen":"Andersen","rapi":"Rapi","Self":"Commander","Monologue":"Monologue","andersen_op_c":"Andersen"},"icons":{"Narration":"si_c999_00_s","andersen":"si_c903_00_s","rapi":"si_c010_00_s","andersen_op_c":"si_c903_00_s"},"lines":[{"id":"event_ce_01_06_s_1","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_ce_01_06_s_1","text":"One week later.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_2","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_06_s_2","text":"I'm afraid I have bad news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["andersen"],"affinity":null},{"id":"event_ce_01_06_s_3","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_06_s_3","text":"The research team that was investigating the Gatekeeper was wiped out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_4","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_06_s_4","text":"They were ambushed by a swarm of Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_5","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_06_s_5","text":"We were only able to retrieve some of the data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_6","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_06_s_6","text":"To get the rest of it, we'll have to send someone back to the surface to retrieve it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_7","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_06_s_7","text":"That someone will be yourselves and the Devil Hunters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_8","type":"Speech","speaker":"andersen","key":"Locale_SubScenario:event_ce_01_06_s_8","text":"Your vacation was rather short-lived, but I hope you had fun either way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_9","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_06_s_9","text":"Commander, preparations to go to the surface are complete.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"none","movie":null,"shown":["rapi"],"affinity":null},{"id":"event_ce_01_06_s_10","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_06_s_10","text":"Okay, I'll be there soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_11","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_06_s_11","text":"How are the Devil Hunters taking it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_12","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_06_s_12","text":"Hard to say. They seemed relieved that things are back underway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_13","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_06_s_13","text":"Okay. Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_14","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_06_s_14","text":"My pleasure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_15","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_ce_01_06_s_15","text":"Rapi gives me a short salute and takes her leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_16","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ce_01_06_s_16","text":"I should get ready and head down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_17","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_17","text":"Sorry to interrupt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_enemyclose","movie":null,"shown":["andersen_op_c"],"affinity":null},{"id":"event_ce_01_06_s_18","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_18","text":"There's one more thing I needed to mention to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_19","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_06_s_19","text":"Don't worry. What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_20","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_20","text":"The shield that surrounds the Gatekeeper distorts the space around it, blocking all physical attempts at intrusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_21","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_21","text":"Anything with any kind of mass is incapable of approaching the Gatekeeper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_22","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_06_s_22","text":"Sounds really high-tech.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_23","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_23","text":"Very much so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_24","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_24","text":"What's interesting though, is that we found forces with little or no mass could approach it easily, such as electricity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_25","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_25","text":"This allowed our technicians to find out a lot about the Gatekeeper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_26","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_26","text":"Such information would be invaluable once added to our database, but our only way of retrieving it is by heading back up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_27","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_27","text":"I'll brief you on what we did manage to uncover.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_28","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_28","text":"The D-Wave emanating from the Gatekeeper has the same wavelength as a living creature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_29","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_29","text":"That means the Gatekeeper is using the shield to protect itself while sleeping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_30","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_30","text":"That same wavelength was also found in the bodies of the Devil Hunters when they were awake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_31","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_31","text":"Find out the relationship between them and determine whether the Gatekeeper can be awakened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_32","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_32","text":"As for what will happen when it awakens, it's hard to say,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_33","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_33","text":"but the answers lie in those research materials left by the investigating team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_34","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_06_s_34","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_35","type":"Speech","speaker":"andersen_op_c","key":"Locale_SubScenario:event_ce_01_06_s_35","text":"Best of luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_36","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_06_s_36","text":"Raptures detected en masse.","jump":null,"exit":false,"enter":null,"bg":"CityForest_001","bgArt":"cityforest_001","image":null,"bgm":"bgm_distress","movie":null,"shown":["rapi","neon","anis"],"affinity":null},{"id":"event_ce_01_06_s_37","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_06_s_37","text":"No escape routes. Commander, permission to engage?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_06_s_38","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ce_01_06_s_38","text":"Do it.","jump":null,"exit":false,"enter":null,"b