n":null,"affinity":null},{"id":"event_projectmatis1_03_s_64","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_64","text":"It's already past 11. Hey, Syuen. Aren't you tired?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_65","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_65","text":"Not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_66","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_66","text":"It's well past a kid's bedtime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_67","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_67","text":"I'm not a kid!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_68","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_68","text":"How are you tired already? Are you that out of shape?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_69","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_69","text":"You cheeky little brat!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_70","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_70","text":"You've only got this one thing to do, but we grown-ups have a whole lot more on our plates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_71","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_71","text":"I've got my own end-of-month report to prepare on top of all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_72","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_72","text":"If you're having such a hard time, why don't you just become a Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_73","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_73","text":"What did you just say, brat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_74","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_74","text":"I've heard other researchers even volunteer to become Nikkes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_75","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_75","text":"so why haven't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_76","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_76","text":"Because then I wouldn't be me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_theruinedcity","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_77","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_77","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_78","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_78","text":"Personally, I don't think a Nikke version of me can really be considered the same person as I am right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_79","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_79","text":"From my body composition, down to the very principle behind how I generate energy, every last bit of it is different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_80","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_80","text":"How could I even be considered the same individual?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_81","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_81","text":"Of course, if you believe memories define an individual,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_82","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_82","text":"then a Nikke made from me would still carry the same memories and thought process as I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_83","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_83","text":"So you could argue I would still be myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_84","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_84","text":"But there's always the chance that even the tiniest detail could be different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_85","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_85","text":"Well... I guess so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_86","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_86","text":"And even that slight margin of error is enough that I could never accept that thing as truly me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_87","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_87","text":"I'll admit, maybe I'm a bit hung up about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_88","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_88","text":"But anyway, most of those researchers choose to become Nikkes because they wanted to keep researching for ages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_89","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_89","text":"But if you never intend on venturing outside the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_90","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_90","text":"Evergreen takes care of the lifespan issue easily enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_91","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_91","text":"So there's no real reason to become a Nikke just to extend your lifespan in order to complete your research.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_92","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_92","text":"You really hate the idea that much...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_93","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_93","text":"Well, I guess it can't be helped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_94","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_94","text":"Keep on feeling tired then. Not me, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":n