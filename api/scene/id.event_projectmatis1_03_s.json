projectmatis1_03_s_45","text":"Go ahead and make whatever you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_46","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_46","text":"I'll be right here to help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_47","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_47","text":"... Got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_03_s_48","text":"From that day on, in order to create a new Nikke blueprint,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_49","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_projectmatis1_03_s_49","text":"the two of them spend night and day working in Maxwell's lab.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_50","type":"Speech","speaker":"syuen_young","key":"Locale_MainScenario:event_projectmatis1_03_s_50","text":"I... don't really get this part. Can you help?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_milkyway","movie":null,"shown":null,"affinity":null},{"id":"event_projectmatis1_03_s_51","type":"Speech","speaker":"maxwell_h","key":"Locale_MainScenario:event_projectmatis1_03_s_51","text":"At your age, it'd be more strange if you even knew any of this.","jump":null,"exit":false,"enter":null,"bg"