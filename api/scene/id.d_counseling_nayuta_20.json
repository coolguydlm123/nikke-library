{"id":"d_counseling_nayuta_20","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 20","stage":null,"prev":"d_counseling_nayuta_19","next":null,"speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_20_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_1","text":"Life is finite, and well I wot it must needs fade in time.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_20_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_2","text":"Yet... though I know it, I am not yet minded to depart this world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_20_3","text":"Same here.","jump":"d_counseling_nayuta_20_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_20_4","text":"Don't worry, we're not just gonna disappear.","jump":"d_counseling_nayuta_20_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_20_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_5","text":"So thy sentiments mirror mine own?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_6","text":"Ha! To hear thy words doth lighten mine heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_7","text":"That one should wish we vanish not together—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_8","text":"'tis most heartening indeed.","jump":"d_counseling_nayuta_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_9","text":"Ha, a truth well spoken. We shall not vanish into thin air without so much as a warning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_10","text":"Yet none may divine what the future hath in store.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_11","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_20_11","text":"I beseech thee, Great Hero, take it not with undue levity.","jump":"d_counseling_nayuta_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_20_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_20_12","text":"Nayuta and I talk about life.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}