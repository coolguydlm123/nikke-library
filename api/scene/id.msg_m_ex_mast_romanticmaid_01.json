aker":"mast_m","key":"Locale_SuddenMessage:m_ex_mast_romanticmaid_01_43","text":"But, er...","jump":null},{"id":"m_ex_mast_romanticmaid_01_44","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_mast_romanticmaid_01_44","text":"I'm still too embarrassed to send that photo.","jump":null},{"id":"m_ex_mast_romanticmaid_01_45","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_mast_romanticmaid_01_45","text":"Why don't you come on over and see it for yourself, instead?","jump":null},{"id":"m_ex_mast_romanticmaid_01_46","type":"Speech","speaker":"mast_m","key":"Locale_SuddenMessage:m_ex_mast_romanticmaid_01_46","text":"I'd be down for that anytime!","jump":null},{"id":"m_ex_mast_romanticmaid_01_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mast_romanticmaid_01_47","text":"Ha, all right.","jump":null}],"chat":true}