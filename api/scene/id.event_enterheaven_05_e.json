beled a traitor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_45","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_45","text":"The resentment of being treated like garbage for so long,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_46","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_46","text":"the betrayal from being deceived into approaching the negotiation table,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_47","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_47","text":"the desire for revenge on behalf of all the comrades we'd lost...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_48","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_48","text":"You take all those negative emotions,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_49","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_49","text":"and combine them with the precedent that Crow had set,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_50","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_50","text":"and people began committing terrorist attacks all across the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_51","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_51","text":"After that... there was nothing I could do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_52","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_52","text":"I know it all started with me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_53","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_53","text":"that I'm the one who pulled the trigger when I said we'd lead the Outer Rim toward the light,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_54","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_54","text":"but once that bullet was fired, it flew out of my control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_55","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_55","text":"Regardless of what I'd wanted, I was suddenly the leader of a terrorist organization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_56","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_56","text":"A leader who survived by hiding behind the bodies of her comrades...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_5