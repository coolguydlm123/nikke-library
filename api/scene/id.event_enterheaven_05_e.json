aker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_25","text":"A trap laid by my mother...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_26","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_05_e_26","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_27","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_27","text":"When we made it to the conference room,","jump":null,"exit":false,"enter":null,"bg":"Stage","bgArt":"stage","image":null,"bgm":null,"movie":null,"shown":["elysionharper"],"affinity":null},{"id":"event_enterheaven_05_e_28","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_28","text":"it wasn't people in there who were waiting there for us...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_29","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_29","text":"It was mass-produced Nikkes, armed with Elysion's latest weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soldiereg","soldierfa","soldierow"],"affinity":null},{"id":"event_enterheaven_05_e_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_05_e_30","text":"You're kidding...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_31","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_31","text":"The moment the meeting room door opened,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_32","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_32","text":"they started firing, before we even had a chance to react.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_33","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_33","text":"In that storm of bullets,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_34","type":"Speech","speaker":"eh_n","key":"Locale_SubScenario:event_enterheaven_05_e_34","text":"I watched as my comrades threw themselves in front of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_35","type":"Speech","speaker":"elysionharper","key":"Locale_SubScenario:event_enterheaven_05_e_35","text":"Stop! Let me go! I should be in there... I should be dying with them...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_36","type":"Speech","speaker":"enterheavenman","key":"Locale_SubScenario:event_enterheaven_05_e_36","text":"Get it together, Boss!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_37","type":"Speech","speaker":"enterheavenman","key":"Locale_SubScenario:event_enterheaven_05_e_37","text":"You have to live. That's the only way their deaths will mean anything!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_05_e_38","type":"Speech","speaker":"eh_n","key":"L