":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_01_s_59","type":"Speech","speaker":"marciana","key":"Locale_MainScenario:event_wavetoyou2_01_s_59","text":"That's not what a teacher is,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_01_s_60","type":"Speech","speaker":"marciana","key":"Locale_MainScenario:event_wavetoyou2_01_s_60","text":"at least not to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_01_s_61","type":"Speech","speaker":"marciana","key":"Locale_MainScenario:event_wavetoyou2_01_s_61","text":"A teacher's responsibility is nothing so noncommittal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_01_s_62","type":"Speech","speaker":"marciana","key":"Locale_MainScenario:event_wavetoyou2_01_s_62","text":"I may not be able to personally protect every single student,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_01_s_63","type":"Speech","speaker":"marciana","key":"Locale_MainScenario:event_wavetoyou2_01_s_63","text":"but I will most definitely protect all who are within my reach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_01_s_64","type":"Speech","speaker":"marciana","key":"Locale_MainScenario:event_wavetoyou2_01_s_64","text":"That is what I've decided my role is as a teacher.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_01_s_65","type":"Speech","speaker":"marciana_s","key":"Locale_MainScenario:event_wav