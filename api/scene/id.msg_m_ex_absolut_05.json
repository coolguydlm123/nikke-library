{"id":"msg_m_ex_absolut_05","cat":"messenger","group":{"id":"room_absolut","label":"Absolute · Group"},"label":"8. Commander,","stage":null,"prev":"msg_m_ex_absolut_04","next":"msg_m_ex_absolut_06","speakers":{"emma":"Emma","vesti":"Vesti","eunhwa":"Eunhwa"},"icons":{"emma":"si_c090_00_s","vesti":"si_c091_00_s","eunhwa":"si_c092_00_s"},"lines":[{"id":"m_ex_absolut_05_1","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_1","text":"Commander,","jump":null},{"id":"m_ex_absolut_05_2","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_2","text":"are you free right now?","jump":null},{"id":"m_ex_absolut_05_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_3","text":"Sure. What's going on?","jump":null},{"id":"m_ex_absolut_05_4","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_4","text":"I wanted to consult with you","jump":null},{"id":"m_ex_absolut_05_5","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_5","text":"about something related to Eunhwa and Vesti.","jump":null},{"id":"m_ex_absolut_05_6","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_6","text":"Emma.","jump":null},{"id":"m_ex_absolut_05_7","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_7","text":"This is the group chat.","jump":null},{"id":"m_ex_absolut_05_8","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_8","text":"Eunhwa and I can see your messages.","jump":null},{"id":"m_ex_absolut_05_9","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_9","text":"I know.","jump":null},{"id":"m_ex_absolut_05_10","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_10","text":"...","jump":null},{"id":"m_ex_absolut_05_11","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_11","text":"You're talking about us behind our backs... in front of us?","jump":null},{"id":"m_ex_absolut_05_12","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_12","text":"What's gotten into you?","jump":null},{"id":"m_ex_absolut_05_13","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_13","text":"Hehe.","jump":null},{"id":"m_ex_absolut_05_14","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_14","text":"Well, it's not so much me asking for advice, but giving a warning.","jump":null},{"id":"m_ex_absolut_05_15","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_15","text":"A warning?","jump":null},{"id":"m_ex_absolut_05_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_16","text":"What is going on?","jump":null},{"id":"m_ex_absolut_05_17","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_17","text":"Commander, listen to this.","jump":null},{"id":"m_ex_absolut_05_18","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_18","text":"Eunhwa and Vesti both are","jump":null},{"id":"m_ex_absolut_05_19","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_19","text":"only eating MRE meals!","jump":null},{"id":"m_ex_absolut_05_20","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_20","text":"I understand that we often don't have a choice during missions,","jump":null},{"id":"m_ex_absolut_05_21","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_21","text":"but eating them all the time can't be good for you,","jump":null},{"id":"m_ex_absolut_05_22","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_22","text":"can it?","jump":null},{"id":"m_ex_absolut_05_23","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_23","text":"!!","jump":null},{"id":"m_ex_absolut_05_24","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_24","text":"...","jump":null},{"id":"m_ex_absolut_05_25","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_25","text":"But...","jump":null},{"id":"m_ex_absolut_05_26","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_26","text":"all you've got to do is microwave them for a few minutes,","jump":null},{"id":"m_ex_absolut_05_27","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_27","text":"and you've got a delicious meal ready to go.","jump":null},{"id":"m_ex_absolut_05_28","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_28","text":"Exactly.","jump":null},{"id":"m_ex_absolut_05_29","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_29","text":"It's convenient and delicious, so what's the problem?","jump":null},{"id":"m_ex_absolut_05_30","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_30","text":"I've heard that","jump":null},{"id":"m_ex_absolut_05_31","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_31","text":"eating too many of them can lead to a nutritional imbalance.","jump":null},{"id":"m_ex_absolut_05_32","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_32","text":"Keeping our bodies in tip-top shape is part of our duty as well,","jump":null},{"id":"m_ex_absolut_05_33","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_33","text":"don't you remember?","jump":null},{"id":"m_ex_absolut_05_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_34","text":"I think Emma is right.","jump":null},{"id":"m_ex_absolut_05_35","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_35","text":"Weakling!","jump":null},{"id":"m_ex_absolut_05_36","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_36","text":"Commander!!","jump":null},{"id":"m_ex_absolut_05_37","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_37","text":"Hehe.","jump":null},{"id":"m_ex_absolut_05_38","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_38","text":"I knew you'd understand,","jump":null},{"id":"m_ex_absolut_05_39","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_39","text":"Commander.","jump":null},{"id":"m_ex_absolut_05_40","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_40","text":"With that being said,","jump":null},{"id":"m_ex_absolut_05_41","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_41","text":"to help our team recover physically,","jump":null},{"id":"m_ex_absolut_05_42","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_42","text":"I'm whipping up a nice, nutritious meal","jump":null},{"id":"m_ex_absolut_05_43","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_43","text":"for you all!","jump":null},{"id":"m_ex_absolut_05_44","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_44","text":"You're the best, Emma.","jump":"m_ex_absolut_05_46"},{"id":"m_ex_absolut_05_45","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_45","text":"... Good luck, you two.","jump":"m_ex_absolut_05_46"},{"id":"m_ex_absolut_05_46","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_46","text":"What the...?!","jump":null},{"id":"m_ex_absolut_05_47","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_47","text":"Weakling!","jump":null},{"id":"m_ex_absolut_05_48","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_48","text":":'(","jump":null},{"id":"m_ex_absolut_05_49","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_49","text":"Commander...","jump":null},{"id":"m_ex_absolut_05_50","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_50","text":"All right then,","jump":null},{"id":"m_ex_absolut_05_51","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_51","text":"when would you all like to eat?","jump":null},{"id":"m_ex_absolut_05_52","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_52","text":"Hold on.","jump":null},{"id":"m_ex_absolut_05_53","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_53","text":"Come to think of it,","jump":null},{"id":"m_ex_absolut_05_54","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_54","text":"haven't you been working an awful lot lately, Weakling?","jump":null},{"id":"m_ex_absolut_05_55","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_55","text":"!!","jump":null},{"id":"m_ex_absolut_05_56","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_56","text":"In fact, you've been so busy that you often haven't had time to eat.","jump":null},{"id":"m_ex_absolut_05_57","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_57","text":"That one Nikke who is obsessed with soda was worried about you.","jump":null},{"id":"m_ex_absolut_05_58","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_58","text":"Are you sure you've been eating a balanced diet?","jump":null},{"id":"m_ex_absolut_05_59","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_59","text":"Oh my goodness, is this true?","jump":null},{"id":"m_ex_absolut_05_60","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_60","text":"Yeah, I heard about that as well.","jump":null},{"id":"m_ex_absolut_05_61","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_61","text":"Vesti, how could you?","jump":null},{"id":"m_ex_absolut_05_62","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_62","text":"Emma.","jump":null},{"id":"m_ex_absolut_05_63","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_63","text":"Rather than us,","jump":null},{"id":"m_ex_absolut_05_64","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_64","text":"I think he's the one you should be worried about.","jump":null},{"id":"m_ex_absolut_05_65","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_65","text":"I think you're right.","jump":null},{"id":"m_ex_absolut_05_66","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_66","text":"I'm sorry, Commander.","jump":null},{"id":"m_ex_absolut_05_67","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_67","text":"It was thoughtless of me to ignore you.","jump":null},{"id":"m_ex_absolut_05_68","type":"Speech","speaker":"emma","key":"Locale_SuddenMessage:m_ex_absolut_05_68","text":"I'll make something for you straight away.","jump":null},{"id":"m_ex_absolut_05_69","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_69","text":"No, I'm okay, really!","jump":null},{"id":"m_ex_absolut_05_70","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_70","text":"She's headed off to the Commander's Room with a hodgepodge of ingredients.","jump":null},{"id":"m_ex_absolut_05_71","type":"Speech","speaker":"eunhwa","key":"Locale_SuddenMessage:m_ex_absolut_05_71","text":"Be sure to eat every last bite.","jump":null},{"id":"m_ex_absolut_05_72","type":"Speech","speaker":"vesti","key":"Locale_SuddenMessage:m_ex_absolut_05_72","text":"Sorry, Commander...","jump":null},{"id":"m_ex_absolut_05_73","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_absolut_05_73","text":"I've got to get out of here, fast.","jump":null}],"chat":true}