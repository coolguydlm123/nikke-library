{"id":"msg_m_ex_noise_01","cat":"messenger","group":{"id":"room_noise","label":"Noise · Nikke"},"label":"1. Hello.","stage":null,"prev":null,"next":"msg_m_ex_noise_02","speakers":{"noise":"Noise"},"icons":{"noise":"si_c430_00_s"},"lines":[{"id":"m_ex_noise_01_1","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_1","text":"Hello.","jump":null},{"id":"m_ex_noise_01_2","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_2","text":"I'm sure we'll get along just fine.","jump":null},{"id":"m_ex_noise_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_3","text":"I'm sure we will.","jump":null},{"id":"m_ex_noise_01_4","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_4","text":"There's no answer.","jump":null},{"id":"m_ex_noise_01_5","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_5","text":"Sorry.","jump":null},{"id":"m_ex_noise_01_6","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_6","text":"I was busy getting ready for a performance.","jump":null},{"id":"m_ex_noise_01_7","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_7","text":"I'm the opening act,","jump":null},{"id":"m_ex_noise_01_8","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_8","text":"so I had a lot to prepare. I'm really sorry.","jump":null},{"id":"m_ex_noise_01_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_9","text":"It's okay.","jump":null},{"id":"m_ex_noise_01_10","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_10","text":"Are you close to a TV by any chance?","jump":null},{"id":"m_ex_noise_01_11","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_11","text":"Tetra Connect is gonna be broadcasting the performance live.","jump":null},{"id":"m_ex_noise_01_12","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_12","text":"You can check it out if you like.","jump":null},{"id":"m_ex_noise_01_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_13","text":"Are you a singer?","jump":null},{"id":"m_ex_noise_01_14","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_14","text":"You mean you don't know?","jump":null},{"id":"m_ex_noise_01_15","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_15","text":"Here I was thinking I was pretty famous.","jump":null},{"id":"m_ex_noise_01_16","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_16","text":"Have you heard the song \"Diva\"?","jump":null},{"id":"m_ex_noise_01_17","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_17","text":"I think I've heard of it.","jump":"m_ex_noise_01_19"},{"id":"m_ex_noise_01_18","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_18","text":"I'm not sure.","jump":"m_ex_noise_01_23"},{"id":"m_ex_noise_01_19","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_19","text":"I'm not surprised.","jump":null},{"id":"m_ex_noise_01_20","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_20","text":"You can't take two steps in the Ark without hearing it.","jump":null},{"id":"m_ex_noise_01_21","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_21","text":"That's my song.","jump":null},{"id":"m_ex_noise_01_22","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_22","text":"Not only do I sing in it, but I've also written the lyrics and the music.","jump":"m_ex_noise_01_27"},{"id":"m_ex_noise_01_23","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_23","text":"You're kidding!","jump":null},{"id":"m_ex_noise_01_24","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_24","text":"Do you not have any interest at all in music?","jump":null},{"id":"m_ex_noise_01_25","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_25","text":"You should give it a listen whenever you have time.","jump":null},{"id":"m_ex_noise_01_26","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_26","text":"The lyrics, the music, the singing...I did it all.","jump":null},{"id":"m_ex_noise_01_27","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_27","text":"To be fair though,","jump":null},{"id":"m_ex_noise_01_28","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_28","text":"it is my only song...","jump":null},{"id":"m_ex_noise_01_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_29","text":"Why is that?","jump":null},{"id":"m_ex_noise_01_30","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_30","text":"The show is going to start soon.","jump":null},{"id":"m_ex_noise_01_31","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_31","text":"Anyway, I look forward to working with you.","jump":null},{"id":"m_ex_noise_01_32","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_32","text":"Mustang has told me a lot about you.","jump":null},{"id":"m_ex_noise_01_33","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_33","text":"I'd like to get to know you better.","jump":null},{"id":"m_ex_noise_01_34","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_34","text":"I'll come to visit you soon.","jump":null},{"id":"m_ex_noise_01_35","type":"Speech","speaker":"noise","key":"Locale_SuddenMessage:m_ex_noise_01_35","text":"See you then, Producer.","jump":null},{"id":"m_ex_noise_01_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_36","text":"Producer?","jump":null},{"id":"m_ex_noise_01_37","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_noise_01_37","text":"... No answer.","jump":null}],"chat":true}