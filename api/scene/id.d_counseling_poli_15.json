{"id":"d_counseling_poli_15","cat":"counsel","group":{"id":"char5016","label":"Poli"},"label":"Advising Poli: 15","stage":null,"prev":"d_counseling_poli_14","next":"d_counseling_poli_16","speakers":{"poli":"Poli"},"icons":{"poli":"si_c030_00_s"},"lines":[{"id":"d_counseling_poli_15_1","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_15_1","text":"Commander, is there any other career you'd like to try out other than what you're doing now?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["poli"],"affinity":"_0"},{"id":"d_counseling_poli_15_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_15_2","text":"I'd like to give being a police officer a shot, like you.","jump":"d_counseling_poli_15_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_poli_15_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_15_3","text":"I'd want to be a dog sitter.","jump":"d_counseling_poli_15_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_poli_15_4","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_15_4","text":"It's good you want to be a police officer, but if you want to get to my level,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_15_5","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_15_5","text":"it won't be easy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_15_6","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_15_6","text":"However, if