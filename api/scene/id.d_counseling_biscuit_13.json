{"id":"d_counseling_biscuit_13","cat":"counsel","group":{"id":"char5054","label":"Biscuit"},"label":"Advising Biscuit: 13","stage":null,"prev":"d_counseling_biscuit_12","next":"d_counseling_biscuit_14","speakers":{"biscuit":"Biscuit"},"icons":{"biscuit":"si_c381_00_s"},"lines":[{"id":"d_counseling_biscuit_13_1","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_1","text":"Someone said that...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["biscuit"],"affinity":"_0"},{"id":"d_counseling_biscuit_13_2","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_2","text":"they want to understand what dogs are saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_3","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_3","text":"How about you, Trainer? Do you also want to understand them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_biscuit_13_4","text":"I can already understand what you're saying.","jump":"d_counseling_biscuit_13_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_biscuit_13_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_biscuit_13_5","text":"I do wish I can do that when they're sick.","jump":"d_counseling_biscuit_13_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_biscuit_13_6","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_6","text":"Huh? Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_7","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_7","text":"Of course you can understand me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_8","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_8","text":"Ooh... I can communicate with dogs and pass you their message.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_9","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_9","text":"So I'm the interpreter. I can help you understand them...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_10","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_10","text":"That's right...","jump":"d_counseling_biscuit_13_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_11","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_11","text":"Yes! Everyone says that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_12","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_12","text":"they don't know what's wrong with dogs when they're ill,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_13","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_13","text":"so they want to be able to understand what their dogs are saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_14","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_14","text":"Hehe. But as long as you have me, I can tell you what the dogs are saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_15","type":"Speech","speaker":"biscuit","key":"Locale_Counseling:d_counseling_biscuit_13_15","text":"What's ailing them, what they want to do... If you want to find out, feel free to ask me anytime!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_biscuit_13_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_biscuit_13_16","text":"I listen to Biscuit talk about the language and behavior of dogs.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}