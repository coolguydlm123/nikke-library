ou quite certain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_84","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_03_84","text":"... I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_85","type":"Speech","speaker":"parasolwoman","key":"Locale_SideStory:s006_03_85","text":"Is that so? Very well, if you insist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_86","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_03_86","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_87","type":"Speech","speaker":"parasolwoman","key":"Locale_SideStory:s006_03_87","text":"Indeed, I am a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_88","type":"Speech","speaker":"parasolwoman","key":"Locale_SideStory:s006_03_88","text":"But not the sort you need fear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_89","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_03_89","text":"Not the sort we need fear?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_90","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_03_90","text":"My name is Bernoullia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["bernoullia"],"affinity":null},{"id":"s006_03_91","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_03_91","text":"I am the owner of this house you've come to visit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_92","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_03_92","text":"Since you're the rather boisterous guests of my two slaves, I'll make an exception and invite you inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_93","type":"Speech","speaker":"grave_p","key":"Locale_SideStory:s006_03_93","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_94","type":"Speech","speaker":"mori","key":"Locale_SideStory:s006_03_94","text":"Slaves...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_95","type":"Speech","speaker":"littlemermaid","key":"Locale_SideStory:s006_03_95","text":"... So you're still calling them that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_96","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_03_96","text":"Siren was right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_97","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_03_97","text":"You really do treat them as your slaves...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_98","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_03_98","text":"It's hot enough outside as it is. Why work yourself up over a mere word?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_99","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_03_99","text":"It would hardly be proper to leave our guests standing outside. We shall discuss the details inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_100","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_03_100","text":"Bring them inside, you little hellions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_101","type":"Speech","speaker":"hansel","key":"Locale_SideStory:s006_03_101","text":"Okay, follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_102","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_03_102","text":"Hansel!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_103","type":"Narration","speaker":null,"key":"Locale_SideStory:s006_03_103","text":"Bernoullia limps back into the house.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_104","type":"Speech","speaker":"grave_p","key":"Locale_SideStory:s006_03_104","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_105","type":"Speech","speaker":"grave_p","key":"Locale_SideStory:s006_03_105","text":"Why...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_106","type":"Speech","speaker":"hansel","key":"Locale_SideStory:s006_03_106","text":"Come in, Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_107","type":"Speech","speaker":"hansel","key":"Locale_SideStory:s006_03_107","text":"Let's talk inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_108","type":"Speech","speaker":"grave_p","key":"Locale_SideStory:s006_03_108","text":"Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_03_109","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_03_109","text":"... Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}