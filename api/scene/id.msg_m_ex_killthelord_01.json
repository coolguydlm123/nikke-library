"Locale_SuddenMessage:m_ex_killthelord_01_35","text":"Got it?","jump":null},{"id":"m_ex_killthelord_01_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_killthelord_01_36","text":"Yeah.","jump":null},{"id":"m_ex_killthelord_01_37","type":"Speech","speaker":"rose","key":"Locale_SuddenMessage:m_ex_killthelord_01_37","text":"Also,","jump":null},{"id":"m_ex_killthelord_01_38","type":"Speech","speaker":"rose","key":"Locale_SuddenMessage:m_ex_killthelord_01_38","text":"I can tell that girl as dull as dishwater at first glance.","jump":null},{"id":"m_ex_killthelord_01_39","type":"Speech","speaker":"rose","key":"Locale_SuddenMessage:m_ex_killthelord_01_39","text":"If you ever find yourself bored at night, swing by my place.","jump":null},{"id":"m_ex_killthelord_01_40","type":"Speech","speaker":"rose","key":"Locale_SuddenMessage:m_ex_killthelord_01_40","text":"I promise you'll find me much more entertaining.","jump":null},{"id":"m_ex_killthelord_01_41","type":"Speech","speaker":"rose","key":"Locale_SuddenMessage:m_ex_killthelord_01_41","text":"^_^","jump":null},{"id":"m_ex_killthelord_01_42","type":"Speech","speaker":"rose","key":"Locale_SuddenMessage:m_ex_killthelord_01_42","text":"Looking forward to your next message, Mister.","jump":null}],"chat":true}