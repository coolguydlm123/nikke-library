{"id":"msg_m_ex_rouge_01","cat":"messenger","group":{"id":"room_rouge","label":"Rouge · Nikke"},"label":"1. Hello, Highroller.","stage":null,"prev":null,"next":"msg_m_ex_rouge_02","speakers":{"rouge":"Rouge"},"icons":{"rouge":"si_c272_00_s"},"lines":[{"id":"m_ex_rouge_01_1","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_1","text":"Hello, Highroller.","jump":null},{"id":"m_ex_rouge_01_2","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_2","text":"This is Rouge,","jump":null},{"id":"m_ex_rouge_01_3","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_3","text":"777 Squad's leader.","jump":null},{"id":"m_ex_rouge_01_4","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_4","text":"I wanted to send you a message to say hello,","jump":null},{"id":"m_ex_rouge_01_5","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_5","text":"and that I'm looking forward to working with you.","jump":null},{"id":"m_ex_rouge_01_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rouge_01_6","text":"As am I.","jump":null},{"id":"m_ex_rouge_01_7","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_7","text":"There is something I'd like to ask you, however.","jump":null},{"id":"m_ex_rouge_01_8","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_8","text":"Are you superstitious?","jump":null},{"id":"m_ex_rouge_01_9","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_9","text":"I, for example,","jump":null},{"id":"m_ex_rouge_01_10","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_10","text":"flip a coin every morning","jump":null},{"id":"m_ex_rouge_01_11","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_11","text":"to determine my fortune for the day.","jump":null},{"id":"m_ex_rouge_01_12","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rouge_01_12","text":"No, not really.","jump":"m_ex_rouge_01_14"},{"id":"m_ex_rouge_01_13","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rouge_01_13","text":"I tend to avoid certain numbers.","jump":"m_ex_rouge_01_17"},{"id":"m_ex_rouge_01_14","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_14","text":"Oh.","jump":null},{"id":"m_ex_rouge_01_15","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_15","text":"That's surprising.","jump":null},{"id":"m_ex_rouge_01_16","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_16","text":"Actually, now that I think about it, I suppose that makes sense for someone like you.","jump":"m_ex_rouge_01_24"},{"id":"m_ex_rouge_01_17","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_17","text":"Oh, I do that as well!","jump":null},{"id":"m_ex_rouge_01_18","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_18","text":"For me, though,","jump":null},{"id":"m_ex_rouge_01_19","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_19","text":"the number changes every month.","jump":null},{"id":"m_ex_rouge_01_20","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_20","text":"So at the beginning of each month,","jump":null},{"id":"m_ex_rouge_01_21","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_21","text":"I try to figure out","jump":null},{"id":"m_ex_rouge_01_22","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_22","text":"which number I should avoid.","jump":null},{"id":"m_ex_rouge_01_23","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_23","text":"Once I figure that out, I'm set for the whole month.","jump":"m_ex_rouge_01_24"},{"id":"m_ex_rouge_01_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rouge_01_24","text":"So, how's your luck today?","jump":null},{"id":"m_ex_rouge_01_25","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_25","text":"Oh,","jump":null},{"id":"m_ex_rouge_01_26","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_26","text":"do you mean the coin flip?","jump":null},{"id":"m_ex_rouge_01_27","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_27","text":"Why don't you take a guess?","jump":null},{"id":"m_ex_rouge_01_28","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rouge_01_28","text":"Heads.","jump":"m_ex_rouge_01_30"},{"id":"m_ex_rouge_01_29","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rouge_01_29","text":"Tails.","jump":"m_ex_rouge_01_35"},{"id":"m_ex_rouge_01_30","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_30","text":"Wow,","jump":null},{"id":"m_ex_rouge_01_31","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_31","text":"correct!","jump":null},{"id":"m_ex_rouge_01_32","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_32","text":"I didn't think","jump":null},{"id":"m_ex_rouge_01_33","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_33","text":"you'd actually get it right.","jump":null},{"id":"m_ex_rouge_01_34","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_34","text":"You must have good intuition.","jump":"m_ex_rouge_01_39"},{"id":"m_ex_rouge_01_35","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_35","text":"Unfortunately, that's wrong.","jump":null},{"id":"m_ex_rouge_01_36","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_36","text":"The coin landed heads side up today.","jump":null},{"id":"m_ex_rouge_01_37","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_37","text":"Thanks to that, I was able to start the day feeling refreshed.","jump":null},{"id":"m_ex_rouge_01_38","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_38","text":"I wish every day could be like today.","jump":"m_ex_rouge_01_39"},{"id":"m_ex_rouge_01_39","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_39","text":"Oh my,","jump":null},{"id":"m_ex_rouge_01_40","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_40","text":"would you look at the time?","jump":null},{"id":"m_ex_rouge_01_41","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_41","text":"I didn't realize we'd been texting for so long.","jump":null},{"id":"m_ex_rouge_01_42","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_42","text":"It was fun.","jump":null},{"id":"m_ex_rouge_01_43","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_43","text":"I'll be in touch again soon.","jump":null},{"id":"m_ex_rouge_01_44","type":"Speech","speaker":"rouge","key":"Locale_SuddenMessage:m_ex_rouge_01_44","text":"Wishing you a day filled with good fortune!","jump":null}],"chat":true}