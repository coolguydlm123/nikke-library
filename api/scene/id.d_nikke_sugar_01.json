n":null,"affinity":null},{"id":"d_nikke_sugar_01_111","type":"Speech","speaker":"sugar","key":"Locale_NikkeEpisode:d_nikke_sugar_01_111","text":"Why do you want to drink coffee all of a sudden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_112","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_112","text":"Isn't it Cafe Sweety policy not to question the client?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_113","type":"Speech","speaker":"sugar","key":"Locale_NikkeEpisode:d_nikke_sugar_01_113","text":"That's Cafe Sweety's policy, not mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_114","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_114","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_115","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_115","text":"Soon there is going to be a major civil war within the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_116","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_116","text":"I'll probably be in the front lines, used as cannon fodder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_117","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_117","text":"I will most likely die.","jump":