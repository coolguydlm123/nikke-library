,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_77","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_77","text":"We still possess a fair amount of strength, and have no need to eat or sleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_78","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_78","text":"Therefore we are best used on the front lines, directly in the line of fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_79","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_sugar_01_79","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_80","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_80","text":"Something wrong? This is a rather common practice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_81","type":"Speech","speaker":"massproduction01","key":"Locale_NikkeEpisode:d_nikke_sugar_01_81","text":"Who is this person beside you? A new member of Cafe Sweety?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_82","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_sugar_01_82","text":"I'm a comman...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sugar_01_83","type":"Speech","speaker":"sugar","key":"Locale_NikkeEpisode:d_nikke_sugar_01_83","text":"My Partner. They can be trusted,