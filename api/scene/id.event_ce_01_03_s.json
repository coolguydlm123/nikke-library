{"id":"event_ce_01_03_s","cat":"event","group":{"id":"ev40008","label":"Collab 01 · Part 1"},"label":"The Armory: A","stage":null,"prev":"event_ce_01_02","next":"event_ce_01_03_e","speakers":{"rapi":"Rapi","Narration":"Narration","c_npc_2":"Aki Hayakawa","c_3":"Himeno","c_2":"Power","c_npc_1":"Denji","Self":"Commander","anis":"Anis"},"icons":{"rapi":"si_c010_00_s","Narration":"si_c999_00_s","c_npc_2":"si_c804_00_s","c_3":"si_c802_00_s","c_2":"si_c801_00_s","c_npc_1":"si_c803_00_s","anis":"si_c012_00_s"},"lines":[{"id":"event_ce_01_03_s_1","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_03_s_1","text":"As soon we pick out our weapons, we'll head up to the surface.","jump":null,"exit":false,"enter":null,"bg":"Armory","bgArt":"armory","image":null,"bgm":"bgm_story_fairytalesend_a","movie":null,"shown":["neon","anis","rapi","c_npc_2","c_3","c_npc_1","c_2"],"affinity":null},{"id":"event_ce_01_03_s_2","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_03_s_2","text":"You've got your pick of the litter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_s_3","type":"Narration","speaker":"Narration","key":"Locale_SubScenario:event_ce_01_03_s_3","text":"There are different weapons laid out before them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_s_4","type":"Speech","speaker":"c_npc_2","key":"Locale_SubScenario:event_ce_01_03_s_4","text":"How exactly are we supposed to use these weapons?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce_01_03_s_5","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_ce_01_03_s_5","text":"These are weapons designed to work against Raptures. Our battlefield strategies are created with these we