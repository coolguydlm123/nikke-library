{"id":"msg_m_ex_jackal_01","cat":"messenger","group":{"id":"room_jackal","label":"Jackal · Nikke"},"label":"1. Hehehe","stage":null,"prev":null,"next":"msg_m_ex_jackal_02","speakers":{"jackal":"Jackal"},"icons":{"jackal":"si_c111_00_s"},"lines":[{"id":"m_ex_jackal_01_1","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_1","text":"Hehehe","jump":null},{"id":"m_ex_jackal_01_2","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_2","text":"Commander!!!11","jump":null},{"id":"m_ex_jackal_01_3","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_3","text":"I heard that you and I are going on an operation.","jump":null},{"id":"m_ex_jackal_01_4","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_4","text":"Any idea what the mission objective is?","jump":null},{"id":"m_ex_jackal_01_5","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_5","text":"Hopefully we'll get to do something fun.","jump":null},{"id":"m_ex_jackal_01_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_6","text":"Did you have anything particular in mind?","jump":null},{"id":"m_ex_jackal_01_7","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_7","text":"I...","jump":null},{"id":"m_ex_jackal_01_8","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_8","text":"I want to do something I'm good at.","jump":null},{"id":"m_ex_jackal_01_9","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_9","text":"I don't like doing things I'm bad at.","jump":null},{"id":"m_ex_jackal_01_10","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_10","text":"It's boooorrring.","jump":null},{"id":"m_ex_jackal_01_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_11","text":"Not many people enjoy doing things they're not good at.","jump":null},{"id":"m_ex_jackal_01_12","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_12","text":"Well, count me amongst them.","jump":null},{"id":"m_ex_jackal_01_13","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_13","text":"It's way nicer doing things that you're good at.","jump":null},{"id":"m_ex_jackal_01_14","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_14","text":"So what would that be for you?","jump":null},{"id":"m_ex_jackal_01_15","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_15","text":"Running!!","jump":null},{"id":"m_ex_jackal_01_16","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_16","text":"And biting!","jump":null},{"id":"m_ex_jackal_01_17","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_17","text":"I've got a great set of chompers.","jump":null},{"id":"m_ex_jackal_01_18","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_18","text":"And...","jump":null},{"id":"m_ex_jackal_01_19","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_19","text":"listening to the Captain.","jump":null},{"id":"m_ex_jackal_01_20","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_20","text":"And, and","jump":null},{"id":"m_ex_jackal_01_21","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_21","text":"Er...","jump":null},{"id":"m_ex_jackal_01_22","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_22","text":"Oh, right!","jump":null},{"id":"m_ex_jackal_01_23","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_23","text":"Outwitting the A.C.P.U.","jump":"m_ex_jackal_01_25"},{"id":"m_ex_jackal_01_24","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_24","text":"Shooting weapons.","jump":"m_ex_jackal_01_30"},{"id":"m_ex_jackal_01_25","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_25","text":"Yeah, that too.","jump":null},{"id":"m_ex_jackal_01_26","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_26","text":"I'm a good runner.","jump":null},{"id":"m_ex_jackal_01_27","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_27","text":"Every time they see me, they chase after me.","jump":null},{"id":"m_ex_jackal_01_28","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_28","text":"It's so annoying.","jump":null},{"id":"m_ex_jackal_01_29","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_29","text":"But I always outrun them, which is fun.","jump":"m_ex_jackal_01_33"},{"id":"m_ex_jackal_01_30","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_30","text":"Yeah, that too.","jump":null},{"id":"m_ex_jackal_01_31","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_31","text":"I'm a real crack shot.","jump":null},{"id":"m_ex_jackal_01_32","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_32","text":"I like how stuff explodes when you shoot it.","jump":null},{"id":"m_ex_jackal_01_33","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_33","text":"Is that what we're going to do?","jump":null},{"id":"m_ex_jackal_01_34","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_34","text":"Right now?","jump":null},{"id":"m_ex_jackal_01_35","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_35","text":"Let's go, then!","jump":null},{"id":"m_ex_jackal_01_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_36","text":"Right now?","jump":null},{"id":"m_ex_jackal_01_37","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_37","text":"Yes, right now!","jump":null},{"id":"m_ex_jackal_01_38","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_38","text":"Oh, wait.","jump":null},{"id":"m_ex_jackal_01_39","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_39","text":"Just a sec.","jump":null},{"id":"m_ex_jackal_01_40","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_40","text":"I'll go first.","jump":null},{"id":"m_ex_jackal_01_41","type":"Speech","speaker":"jackal","key":"Locale_SuddenMessage:m_ex_jackal_01_41","text":"You follow.","jump":null},{"id":"m_ex_jackal_01_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_42","text":"Wait a minute...","jump":null},{"id":"m_ex_jackal_01_43","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_jackal_01_43","text":"... Jackal doesn't reply.","jump":null}],"chat":true}