{"id":"d_main_05_10","cat":"main","group":{"id":"ch5","label":"Chapter 5 · Wonderland"},"label":"Research Institute","stage":"5-19 STAGE · Start","prev":"d_main_05_09","next":"d_main_05_11_s","speakers":{"ludmilla":"Ludmilla","rapi":"Rapi","neon":"Neon","anis":"Anis","Self":"Commander"},"icons":{"ludmilla":"si_c190_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s"},"lines":[{"id":"d_main_05_10_1","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_1","text":"See that building off in the distance?","jump":null,"exit":false,"enter":null,"bg":"IceLand_03","bgArt":"iceland_03","image":null,"bgm":"bgm_enemyclose","movie":null,"shown":["alice","ludmilla","rapi","anis","neon"],"affinity":null},{"id":"d_main_05_10_2","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_2","text":"That's the research base.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_3","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_3","text":"Looks more like a fortress to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_4","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_4","text":"That's because it was originally designed with its own self-defense system.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_5","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_5","text":"Until recently, it had never been invaded by the enemy due to how many armed guards they had protecting it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_6","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_6","text":"Now that it's fallen into enemy hands, all of that artillery is pointed straight at us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_7","text":"How did it happen? Do you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_8","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_8","text":"It all started with a glitch. This is a fairly old facility, and they didn't keep their equipment up to date.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_9","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_9","text":"Whenever there was a small fault in the system, they'd overlook it. But before you know it, things started to pile up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_10","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_10","text":"By the time people realized, most of the center had already fallen to the enemy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_11","text":"Was it hacked?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_12","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_12","text":"Most likely. There was no sign of any intrusion from the outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_05_10_13","text":"Do Raptures know about hacking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_10_14","text":"It wouldn't surprise me if they could. After all, they can apparently talk now, remember?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_15","text":"... Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_05_10_16","text":"... Whoopsie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_17","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_10_17","text":"It's okay. I'll just pretend I didn't hear that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_18","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_18","text":"... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_19","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_19","text":"... Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_20","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_05_10_20","text":"Rapi speaks softly into your ear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_21","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_21","text":"Anis is right. There are indeed unique individuals like Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_22","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_22","text":"However, hacking is a quintessentially human technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_23","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_23","text":"I can't imagine Raptures wrapping their minds around such a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_10_24","text":"So are you thinking there was a mole?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_25","text":"I'm positive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_26","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_26","text":"I believe they targeted the research base","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_27","text":"so that they could gather information on the Pilgrims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_28","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_10_28","text":"Agreed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_10_29","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_05_10_29","text":"Although the objective of this operation remains unchanged, this is something you should keep in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}