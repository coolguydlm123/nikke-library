{"id":"d_nikke_crow_03","cat":"bond","group":{"id":"char5025","label":"Crow"},"label":"D-1","stage":null,"prev":"d_nikke_crow_02","next":"d_nikke_crow_04","speakers":{"Narration":"Narration","crow":"Crow","Self":"Commander"},"icons":{"Narration":"si_c999_00_s","crow":"si_c110_00_s"},"lines":[{"id":"d_nikke_crow_03_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_crow_03_1","text":"Some time later, in the interrogation room at the Rehabilitation Center.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_2","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_2","text":"I thought we'd gotten pretty close over the past few days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_risk","movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_03_3","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_3","text":"Yet here you are, back in the interrogator's chair less than a day later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_4","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_4","text":"What happened last night?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_5","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_5","text":"Or did those anti-Nikke protesters get to you on your way home?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_6","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_6","text":"I have a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_7","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_7","text":"We haven't even exchanged pleasantries, and you're already getting down to business?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_8","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_8","text":"That's hardly polite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_9","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_9","text":"Have you ever had any contact with the shooter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_10","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_11","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_11","text":"What if I said I did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_12","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_12","text":"I'd like to know what you two talked about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_13","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_13","text":"What a pointless effort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_14","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_14","text":"You don't need to go through all this just to interrogate me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_15","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_15","text":"Every piece of evidence and every statement will be collected by Enikk's A.I.,","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":null,"movie":null,"shown":["enikk"],"affinity":null},{"id":"d_nikke_crow_03_16","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_16","text":"then \"rearranged\" to serve the continued existence of the Ark before being presented to the public.","jump":null,"exit":false,"enter":null,"bg":"Ark","bgArt":"ark","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_17","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_17","text":"So just think whatever you want about me based on whatever conclusion they come to.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_03_18","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_18","text":"No need to strain that pretty little head of yours over it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_19","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_19","text":"I don't agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_20","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_20","text":"... Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_21","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_21","text":"I'm your Commander, so I need to stand by you when necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_22","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_23","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_23","text":"To do that, I need to understand where you're coming from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_24","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_24","text":"... That's really your reason? You're serious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_25","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_25","text":"Yeah, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_26","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_26","text":"... This is ridiculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_27","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_27","text":"I'm honestly speechless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_28","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_28","text":"... Fine, you win.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_29","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_29","text":"So... you wanted to know what that outlaw and I talked about, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_30","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_30","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_31","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_31","text":"That outlaw... I think his name was Jack, Jackie, or something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_32","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_32","text":"For convenience's sake, let's just call him Jack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_33","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_33","text":"Anyway, Jack first came to me about a year ago.","jump":null,"exit":false,"enter":null,"bg":"Backstreet","bgArt":"backstreet","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_34","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_34","text":"See, Jackal, Viper, and I hold a rather unique position in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["viper"],"affinity":null},{"id":"d_nikke_crow_03_35","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_35","text":"People who found themselves in a bind, had something big coming up,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["jackal"],"affinity":null},{"id":"d_nikke_crow_03_36","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_36","text":"or were desperate for a miracle for one reason or another would come looking for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_03_37","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_37","text":"Jack's situation was particularly interesting.","jump":null,"exit":false,"enter":null,"bg":"Bar","bgArt":"bar","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_38","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_38","text":"He came up to me while I was having a drink at a bar and said,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_03_39","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_39","text":"\"I want to get my child citizenship.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_weare","movie":null,"shown":["outlaw"],"affinity":null},{"id":"d_nikke_crow_03_40","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_40","text":"So I told him,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_41","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_41","text":"\"Get lost.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_42","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_42","text":"\"If you want illegal citizenship, go find some professionals who can forge the necessary documents.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_43","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_43","text":"But the guy just stood there without moving and said,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_44","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_44","text":"\"No, I want her to have real citizenship, not an illegal one.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_45","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_45","text":"... By then, he was starting to get on my nerves, so I gave him a straight answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_46","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_46","text":"\"Oh, really? Then just kill the kid.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_47","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_47","text":"\"If she's lucky, she'll be born a citizen in her next life.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_48","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_48","text":"...","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_49","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_49","text":"He went on about how he didn't want much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_50","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_50","text":"He just wanted his daughter to eat real food instead of garbage scraps,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_51","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_51","text":"to learn how to read instead of how to rummage through body bags,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_52","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_52","text":"and to grow up and have an ordinary job instead of making a living killing people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_53","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_53","text":"He asked me what was so unreasonable about that, and whether wanting something like that was really so wrong. So I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_54","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_54","text":"told him to get a grip and smacked him upside the head.","jump":null,"exit":false,"enter":null,"bg":"Bar","bgArt":"bar","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_55","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_55","text":"“You and I have both been in this line of work long enough to know better.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["crow","outlaw"],"affinity":null},{"id":"d_nikke_crow_03_56","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_56","text":"\"So quit dreaming up pipe dreams and wake the hell up.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_57","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_57","text":"\"Still...\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_58","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_58","text":"\"If you really want to take that gamble,\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_59","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_59","text":"\"I suppose you could try getting your kid adopted by a suitable civilian.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_60","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_60","text":"After I told him that, he went home with a smile on his face, even with it all swollen up.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_61","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_61","text":"... After that, he'd come looking for me every so often, even though I'd never asked him to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_62","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_62","text":"\"I'm looking for an orphanage that'll take my daughter.\"","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_63","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_63","text":"\"I told them I'd give them everything I own, but a lot of them still refused. It's been a real struggle.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_64","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_64","text":"... He'd come and tell me things I hadn't even asked about.","jump":null,"exit":false,"enter":null,"bg":"Bar","bgArt":"bar","image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_03_65","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_65","text":"A few months later, I was out drinking with the squad when he showed up again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["outlaw"],"affinity":null},{"id":"d_nikke_crow_03_66","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_66","text":"\"I managed to get her into an orphanage in the Quotidians Residence.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_67","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_67","text":"\"A poor old couple came and adopted her.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_68","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_68","text":"\"I'm so grateful to them that I've been sending them money anonymously to repay them...\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_69","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_69","text":"Hearing all that, I figured he'd actually managed to get his kid a clean new identity.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_70","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_70","text":"... Where did things go wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_71","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_71","text":"... Isn't it obvious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_72","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_72","text":"Eventually, someone found out her citizenship had been falsified.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_73","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_73","text":"Some reporter obsessed with landing a scoop caught wind of it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_77","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_77","text":"Apparently, he set out to film some tearjerker about a poor old couple and their adopted daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_78","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_78","text":"But surprise, surprise. They were doing a lot better than he'd expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_79","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_79","text":"So he traced the source of their donations, and what do you know? They led straight back to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_80","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_80","text":"Just like that, the little story he'd put together turned into a full-blown scandal across the entire Ark.","jump":null,"exit":false,"enter":null,"bg":"Ark","bgArt":"ark","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_81","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_81","text":"Citizens were outraged by the shameless scam and took to the streets,","jump":null,"exit":false,"enter":null,"bg":"City","bgArt":"city","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_82","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_82","text":"demanding even harsher segregation policies against outlaws.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_83","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_83","text":"So naturally, it was only a matter of time before our outlaw Jack found himself on the run from the police.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["outlaw"],"affinity":null},{"id":"d_nikke_crow_03_84","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_84","text":"The child was taken somewhere no one knows where,","jump":null,"exit":false,"enter":null,"bg":"black","bgArt":"black","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_85","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_85","text":"and the elderly couple who'd adopted her collapsed from the shock of losing her.","jump":null,"exit":false,"enter":null,"bg":"red","bgArt":"red","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_86","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_86","text":"The Daily Ark was about the only one that profited from the whole mess, but...","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":["crow"],"affinity":null},{"id":"d_nikke_crow_03_87","type":"Speech","speaker":"crow","key":"Locale_NikkeEpisode:d_nikke_crow_03_87","text":"Look at them now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_crow_03_88","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_crow_03_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":nul