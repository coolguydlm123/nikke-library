{"id":"d_main_17_04","cat":"main","group":{"id":"ch17","label":"Chapter 17 · Purpose"},"label":"Longing","stage":"17-12 STAGE · Start","prev":"d_main_17_03_e","next":"d_main_17_05_s","speakers":{"rapunzel":"Rapunzel","anis":"Anis","neon":"Neon"},"icons":{"rapunzel":"si_c221_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_17_04_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_17_04_1","text":"Rapunzel looks at the group silently.","jump":null,"exit":false,"enter":null,"bg":"IceLand_01","bgArt":"iceland_01","image":null,"bgm":"bgm_blackgunsmoke_a","movie":null,"shown":["rapunzel","anis","neon"],"affinity":null},{"id":"d_main_17_04_2","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_04_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_04_3","text":"Rapunzel, why are you just staring at us?\nDo you have something to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_04_4","text":"Wow, you really are back to your old self.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_04_5","text":"The distrusting Anis we know and love.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_04_6","text":"Already picking fights with someone who's doing nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i