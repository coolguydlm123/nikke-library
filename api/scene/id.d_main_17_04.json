ll,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_04_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_22","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_04_22","text":"Looks like I'm being a bit of a downer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_23","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_04_23","text":"C'mon everybody, lighten up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_04_24","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_04_24","text":"We'll be there soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}