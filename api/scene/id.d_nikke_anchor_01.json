ity":null},{"id":"d_nikke_anchor_01_7","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anchor_01_7","text":"Not as much lately.","jump":"d_nikke_anchor_01_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_8","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_8","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_9","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_9","text":"Very well. I shall handle this myself...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_10","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_10","text":"Wait, what is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_11","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_12","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_12","text":"Actually...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_13","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_13","text":"I have a favor to ask of you.","jump":"d_nikke_anchor_01_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_14","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_14","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_15","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_15","text":"That's good to hear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_16","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_16","text":"In fact, I came here today to ask you for a favor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_17","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_17","text":"As the leader of the Aegis Squad, it shames me to show weakness before you like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_18","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_18","text":"Even now, I find myself wanting to cover my face in disgrace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_19","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_19","text":"But... I truly can't see any other way out of this situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_20","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_20","text":"What's going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_21","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_22","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_22","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_23","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_23","text":"would appreciate it if you could confiscate Anchor's marine life collection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_24","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_24","text":"Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_25","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_25","text":"Don't look at me like that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_26","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_26","text":"It's not because I think those things are disgusting,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_27","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_27","text":"or that I'm just being unreasonable for personal reasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_28","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_28","text":"Then what's the reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_29","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_29","text":"A few days ago, we received a warning from the Wildlife Agency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_30","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_30","text":"According to the law, all flora and fauna must be under the jurisdiction of the agency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_31","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_31","text":"That includes marine life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_32","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_32","text":"Anchor has been collecting them in her own time and has built up quite a private collection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_33","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_33","text":"Until now, they've turned a blind eye out of respect for Deputy Chief Burningum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_34","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_34","text":"However, at a recent party aboard the ship,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_35","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_35","text":"a high-ranking VIP happened to step on one of Anchor's starfish and took quite the fall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_36","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_37","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_37","text":"It's absurd, I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_38","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_38","text":"But a formal complaint was filed with the Wildlife Agency because of that incident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_39","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_39","text":"And now, they can no longer turn a blind eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_40","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anchor_01_40","text":"Why not come up with an excuse?","jump":"d_nikke_anchor_01_42","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_41","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_anchor_01_41","text":"Guess there's no way out of it this time around.","jump":"d_nikke_anchor_01_49","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_42","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_42","text":"I wanted to,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_43","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_43","text":"but the management bureau is already making an exception","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_44","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_44","text":"for that one living creature in our squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_45","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_45","text":"Ah, you mean Mast's parrot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_46","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_46","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_47","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_47","text":"With Morgan, we could at least argue that he might prove useful in actual operations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_48","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_48","text":"But when it comes to Anchor's marine creatures, not even that kind of excuse holds up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_49","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_50","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_50","text":"I explained the situation to Anchor yesterday","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_51","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_51","text":"and requested that she hand over her collection to the agency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_52","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_52","text":"Ever since then, she's been avoiding me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_53","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_53","text":"As you're aware,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_54","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_54","text":"Anchor's body is equipped with a high-performance radar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_55","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_55","text":"If she puts her mind to it, she can avoid someone indefinitely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_56","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_56","text":"And that's where I come into the picture, I assume.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_57","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_57","text":"Correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_58","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_58","text":"I tried to resolve the matter on my own, as any leader should. But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_59","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_59","text":"I'm truly sorry, Subordinate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_60","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_01_60","text":"I feel as if I'm shirking my responsibilities and passing them onto you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_01_61","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_01_61","text":"No, actually, it's good you came to see me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affi