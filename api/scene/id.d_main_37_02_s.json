{"id":"d_main_37_02_s","cat":"main","group":{"id":"ch37","label":"Chapter 37 · Struggle"},"label":"The Admire: A","stage":"37-7 STAGE · Start","prev":"d_main_37_01","next":"d_main_37_02_e","speakers":{"rapi_red":"Rapi","maxwell":"Maxwell","drake":"Drake","laplace":"Laplace","helm_op_l":"Helm","helm":"Helm","anchor":"Anchor","mast":"Mast"},"icons":{"rapi_red":"si_c016_00_s","maxwell":"si_c102_00_s","drake":"si_c101_00_s","laplace":"si_c100_00_s","helm_op_l":"si_c352_00_s","helm":"si_c352_00_s","anchor":"si_c351_00_s","mast":"si_c350_00_s"},"lines":[{"id":"d_main_37_02_s_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_1","text":"Is Leviathan going to want to talk to us?","jump":null,"exit":false,"enter":null,"bg":"Jungle2","bgArt":"jungle2","image":null,"bgm":"bgm_chapter37_field_swarmnest","movie":null,"shown":["drake","laplace","maxwell","rapi_red"],"affinity":null},{"id":"d_main_37_02_s_2","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_2","text":"If we subdue her like we did before, I'm sure she would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_3","text":"I don't think that's going to be an option for us any longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_4","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_4","text":"She's going to be more wary of us than ever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_5","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_5","text":"The more I think about this, the more frustrated I get.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_6","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_6","text":"That egg made the first move and tried to consume Laplace's weapon, and then when that didn't work, Leviathan was the one who used the crystals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_7","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_7","text":"We were only acting in self-defense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_8","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_8","text":"Those crystals cut through Laplace's parts like a hot knife through butter, and that's what caused the malfunction. It wasn't our fault.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_9","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_9","text":"We're the victims here, and yet she's acting like we're the ones who betrayed her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_10","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_10","text":"We'll have to try and get that point across to her when we talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_11","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_11","text":"Things escalated quickly, and it was hard to keep a cool head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_12","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_12","text":"The fact that we were enemies didn't help matters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_13","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_13","text":"It feels like we're getting the short end of the stick here, and I don't appreciate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_14","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_s_14","text":"Maxwell! Look at this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_15","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_s_15","text":"Hurry, hurry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_16","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_16","text":"What is it now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_17","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_s_17","text":"Come here and see for yourself!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_18","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_s_18","text":"Hurry, hurry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_19","text":"Maxwell grumbles as she walks forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_20","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_20","text":"This better be good, or I'm gonna be upse...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_21","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_21","text":"... Cutey, Rapi. Come look at this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_22","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_22","text":"Quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_23","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_23","text":"Rapi and I head toward where the members of Matis are standing.","jump":null,"exit":false,"enter":null,"bg":"BlackSeaJungle","bgArt":"blackseajungle","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_24","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_24","text":"A vast expanse of black liquid stretches out before us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_25","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_25","text":"Within it, a mass of writhing snake-like creatures can be seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_26","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_s_26","text":"Minions summoned by Leviathan, and quite a lot of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_27","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_s_27","text":"Using my hero vision, I detect at least 30.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_28","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_s_28","text":"Same goes for my villain vision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_29","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_s_29","text":"No worries, I'll deal with this vermin in a jiffy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_30","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_30","text":"You can do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_31","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_37_02_s_31","text":"... Actually, probably not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_32","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_32","text":"... I shouldn't even get mad at this point. I should expect these kinds of answers from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_33","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_37_02_s_33","text":"Looks like we have to go around. It'll be a long detour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_34","text":"It doesn't seem like we have much choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_35","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_35","text":"These things are Tyrant-class. They may not be all that strong on their own, but in a group...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_36","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_36","text":"Should I try flying us over one by one?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_37","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_37","text":"Of course, if I were to fall in, we'd end up as worm food... or snake food, rather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_38","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_38","text":"Still though, it may be worth a shot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_39","text":"Absolutely not. The risk is too high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_40","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_40","text":"Yeah, but wouldn't it be cool?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_41","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_41","text":"... All right, I'll admit that it would be cool, but still...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_42","type":"Speech","speaker":"helm_op_l","key":"Locale_MainScenario:d_main_37_02_s_42","text":"Subordinate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["helm_op_l"],"affinity":null},{"id":"d_main_37_02_s_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_43","text":"Helm? What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_44","type":"Speech","speaker":"helm_op_l","key":"Locale_MainScenario:d_main_37_02_s_44","text":"Do you have a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_45","text":"I'm kind of in the middle of something, but go ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_46","type":"Speech","speaker":"helm_op_l","key":"Locale_MainScenario:d_main_37_02_s_46","text":"Brace for impact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_47","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_48","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_48","text":"One side of our vision brightens.","jump":null,"exit":false,"enter":null,"bg":"White","bgArt":"white","image":null,"bgm":"event_bgm_ubsphere_aapiller","movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_49","text":"From a distance, a massive beam surges ahead in a straight line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_50","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_50","text":"*Baaaang*!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_51","text":"The black sea in front of us is engulfed in a blinding light","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_52","text":"that forces me to close my eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_53","text":"Once the light and heat begin to subdue, I slowly open my eyes.","jump":null,"exit":false,"enter":null,"bg":"Bog","bgArt":"bog","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_54","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_54","text":"The mass of snakes and the black sea are gone, replaced instead by a smoldering patch of scorched earth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_55","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_37_02_s_55","text":"This is...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["drake","laplace","maxwell","rapi_red"],"affinity":null},{"id":"d_main_37_02_s_56","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_s_56","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_57","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_37_02_s_57","text":"Do we have... a new hero?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_58","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_58","text":"I whip my head toward the direction the beam came from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_59","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_37_02_s_59","text":"Above the black sea, a massive white structure glows in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_02_s_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main