{"id":"event_oldtales1_01_s","cat":"event","group":{"id":"ev40061","label":"OLD TALES · Part 1"},"label":"A Long Wait: A","stage":null,"prev":"event_oldtales1_prologue","next":"event_oldtales1_01_e","speakers":{"abe":"Abe","redshoes":"Red Shoes","hansel":"Hansel","cinderella":"Cinderella","littlemermaid":"Little Mermaid"},"icons":{"abe":"si_c979_00_s","redshoes":"si_c982_00_s","hansel":"si_c980_00_s","cinderella":"si_c511_00_s","littlemermaid":"si_c513_00_s"},"lines":[{"id":"event_oldtales1_01_s_1","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_1","text":"Test results are all normal.","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":"event_bgm_oldtales_firstpage","movie":null,"shown":["cinderella","redshoes","abe","hansel","gretel","littlemermaid"],"affinity":null},{"id":"event_oldtales1_01_s_2","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_2","text":"You're good to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_3","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_3","text":"I have a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_4","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_4","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_5","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_5","text":"Are we going to be deployed in actual combat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_6","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_6","text":"Most likely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_7","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_7","text":"They've sunk a small fortune into all of you, and they're not liable to let that go to waste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_8","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_8","text":"When?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_9","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_9","text":"I don't know. Wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_10","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_10","text":"At this rate, the war will be over by the time we're given the go-ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_11","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_11","text":"Of course, when I say that, I mean that we'll lose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_12","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_13","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_13","text":"Gretel and I think that we should be deployed as soon as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_14","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_s_14","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_15","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_15","text":"As do I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_16","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_16","text":"We know that our joining won't guarantee our victory,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_17","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_17","text":"especially considering how those Raptures are seemingly infinite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_oldtales1_01_s_18","text":"Red Shoes points to one of the display monitors in the lab.","jump":null,"exit":false,"enter":null,"bg":"EventScene_oldtales_02_1","bgArt":"eventscene_oldtales_02_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_oldtales1_01_s_19","text":"On the screen are the words \"Rapture Count\". Next to it is the infinity symbol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_20","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_20","text":"Nothing in this world is infinite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_21","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_21","text":"The only reason that symbol is there is because the Raptures are being created at a rate faster than they're being killed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_22","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_22","text":"How do we know that for certain?","jump":null,"exit":false,"enter":null,"bg":"TechIndoor","bgArt":"techindoor","image":null,"bgm":null,"movie":null,"shown":["cinderella","redshoes","abe","hansel","gretel","littlemermaid"],"affinity":null},{"id":"event_oldtales1_01_s_23","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_23","text":"If I explained it to you, would you even understand? Do you really want me to get into the nitty-gritty of the algorithms?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_24","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_24","text":"Please, go right ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_25","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_25","text":"It's not like I'll be listening anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_26","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_26","text":"... You're making me upset again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_27","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_27","text":"Hehe, don't mind her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_28","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_28","text":"Anyway, it's a bit embarrassing for me to be the one saying this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_29","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_29","text":"but our specs exceed that of the original Grimms prototypes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_30","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_30","text":"We're next generation models, second generation Grimms models to be exact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_31","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_31","text":"The sooner we're deployed, the greater our chances of...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_32","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_32","text":"How many times do I have to tell you? We haven't received any orders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_33","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_33","text":"If we head out without prior authorization, we'll be considered deserters and scrapped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_34","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_34","text":"Who would be scrapping us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_35","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_35","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_36","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_36","text":"If anyone is thinking of scrapping me or Gretel,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_37","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_37","text":"I'd like to see them try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_38","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_38","text":"So you're not only a moron, but arrogant as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_39","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_39","text":"You think they haven't prepared for you to put up a fight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_40","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_40","text":"No, I don't think they would have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_41","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_42","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_s_42","text":"Abe. Tell us the truth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_43","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_s_43","text":"I presume it has to do with vested interests?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_44","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_44","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_45","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_45","text":"Yep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_46","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_46","text":"It's not like I haven't contacted the higher-ups.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_47","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_47","text":"I'm constantly pestering them, asking when we'll be deployed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_48","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_48","text":"Every time, I get the same answer: They haven't reached a decision yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_49","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_49","text":"What hasn't been decided? We either go out, or we don't. What's so complicated about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_50","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_50","text":"If it were that easy, we wouldn't be waiting for as long as we have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_51","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_51","text":"You all are the culmination of the finest technology the United Forces of Humanity and V.T.C. has to offer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_52","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_52","text":"Your power is supposed to surpass that of the Goddess Squad themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_53","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_s_53","text":"We can't possibly surpass them. No way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_54","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_54","text":"Again with that ridiculous fawning over the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_55","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_55","text":"An astronomical amount of money has been invested in all of you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_56","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_56","text":"so the question of who gets to claim propriety over you all is a pressing question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_57","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_57","text":"Do you belong to the United Forces of Humanity, or V.T.C.?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_58","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_58","text":"There's a whole, convoluted web of who contributed what technology, who footed the bill for what, etc.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_59","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_59","text":"We're not able to saddle up and ride out like a bunch of cowboys. It doesn't work like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_60","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_60","text":"Ugh, this is torture!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_61","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_61","text":"Do you think this is fun for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_62","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_62","text":"... So there's no telling when a decision will be made?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_63","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_63","text":"As I've told you a hundred times before, no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_64","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_01_s_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_65","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_s_65","text":"To squabble over personal interests when the fate of the world hangs in the balance...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_66","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:event_oldtales1_01_s_66","text":"This is far from beautiful behavior.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_67","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_67","text":"Enough of that nonsense about beauty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_68","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_68","text":"I've submitted all your results, so now we wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_69","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_01_s_69","text":"Who knows? Maybe this time we'll finally be approved for deployment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_70","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_01_s_70","text":"I doubt it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_01_s_71","type":"Speech","speaker":"