{"id":"d_counseling_quiry_16","cat":"counsel","group":{"id":"char5082","label":"Quiry"},"label":"Advising Quiry: 16","stage":null,"prev":"d_counseling_quiry_15","next":"d_counseling_quiry_17","speakers":{"quiry":"Quiry"},"icons":{"quiry":"si_c033_00_s"},"lines":[{"id":"d_counseling_quiry_16_1","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_1","text":"I had a lot of worries when I first came to the Outpost.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["quiry"],"affinity":"_0"},{"id":"d_counseling_quiry_16_2","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_2","text":"Now though, I realize this place is far more peaceful than I thought it'd be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_16_3","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_3","text":"In fact, it feels like there isn't much that I need to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_quiry_16_4","text":"That's because the A.C.P.U. upholds the law.","jump":"d_counseling_quiry_16_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_quiry_16_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_quiry_16_5","text":"So you should take a well-deserved break.","jump":"d_counseling_quiry_16_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_quiry_16_6","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_6","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_16_7","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_7","text":"Thank you for saying that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_16_8","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_8","text":"I was always proud to be part of the A.C.P.U., but now I'm super proud!","jump":"d_counseling_quiry_16_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_16_9","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_9","text":"No, I can't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_16_10","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_16_10","text":"If something were to happen while I was on vacation, I'd never forgive myself.","jump":"d_counseling_quiry_16_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_16_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_quiry_16_11","text":"I have a constructive time with Quiry.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}