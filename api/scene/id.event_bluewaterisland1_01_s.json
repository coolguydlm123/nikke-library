_bluewaterisland1_01_s_17","text":"The amount of money required to move it would be astronomical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_01_s_18","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_bluewaterisland1_01_s_18","text":"On top of that, the Admire is the only battleship in the entire Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_01_s_19","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_bluewaterisland1_01_s_19","text":"They wouldn't want to send something so valuable just to potentially provide backup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_01_s_20","type":"Speech","speaker":"neon","key":"Locale_SubScenario:event_bluewaterisland1_01_s_20","text":"They're so intent on 'saving' that ship, that it's just gonna go to waste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_01_s_21","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_bluewaterisland1_01_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_01_s_22","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_bluewaterisland1_01_s_22","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland1_01_s_23","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_bluewaterisland1_01_s_23","text":"There's one thing I still don't get, though.","jump":null,"e