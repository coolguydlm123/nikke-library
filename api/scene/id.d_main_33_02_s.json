{"id":"d_main_33_02_s","cat":"main","group":{"id":"ch33","label":"Chapter 33 · Clash"},"label":"Tête-à-Tête: A","stage":"33-8 STAGE · Start","prev":"d_main_33_01","next":"d_main_33_02_e","speakers":{"anis":"Anis","neon":"Neon","rapi":"Rapi","cinderella":"Cinderella"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s","cinderella":"si_c511_00_s"},"lines":[{"id":"d_main_33_02_s_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_1","text":"While we're on the move, Anis pulls me aside.","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":"bgm_chapter33_field_blackwave","movie":null,"shown":["anis","neon","rapi"],"affinity":null},{"id":"d_main_33_02_s_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_2","text":"Commander, could we talk to you privately for a moment, without Cinderella?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_3","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_4","text":"Your blood... does it contain Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_5","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_33_02_s_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_7","text":"Er...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_8","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_8","text":"I'll take that as a yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_9","text":"I saw Vapaus bullets when we were in Eden,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_10","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_10","text":"and when you had that hole in your stomach before, you yelled at us to stay away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_11","text":"Then, when you punched Behemoth and your hand was all bloody, she went crazy for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_12","text":"Considering how obvious these signs are, I'd have to be a real idiot not to figure that your blood contains Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_13","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_14","text":"I don't know... \"Idiot\" may be a bit harsh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_15","text":"... Anyway, why did you keep it a secret from us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_16","text":"You could have warned us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_17","text":"Told us that if we came into contact with your blood, our entire NIMPH would be wiped out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_18","text":"When you were injured before, what if we'd rushed over and tried to stop the bleeding?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_19","text":"Did you think we couldn't keep a secret? That'd we go around blabbing about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_20","text":"I knew better than anyone that you wouldn't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_22","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_22","text":"Vapaus is a rare commodity. That means a lot of people are after it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_23","text":"If I'd dragged you all into this, it'd only put you in danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_24","text":"And fighting Heretics is the definition of safety?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_25","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_25","text":"... I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_26","text":"I appreciate you wanting to protect us, but I'm pretty sure we can deal with any situations that come our way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_27","text":"Anything would be better than getting caught up in something when we don't know anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_28","text":"I can't stand it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_29","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_29","text":"I say we create a manual for what to do when Master is injured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_30","text":"Good idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_31","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_33_02_s_31","text":"My NIMPH is gone, so I'll be able to stop any bleeding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_32","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_32","text":"You won't be able to stop anything if you're unconscious like last time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_33","text":"Neon!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_34","text":"Oh. Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_33_02_s_35","text":"... I'll be as careful as I can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_36","text":"The best solution would be for the Commander to not get hurt in the first place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_37","text":"Given your previous track record, however, I think we all know how unlikely that is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_39","text":"Wouldn't it be better if Neon and I each took a small shot of Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_40","text":"That's too dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_41","text":"How so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_42","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_42","text":"Vapaus, for lack of better phrasing, makes you mortal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_43","text":"Remember what Exia told us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_44","text":"A Nikke's brain is practically immortal thanks to NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_45","text":"Without it, that's no longer the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_47","text":"I never planned on living that long anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_48","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_48","text":"With NIMPH, there's always the option of a memory wipe if you're seriously injured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_49","text":"Afterwards, you can have any necessary knowledge injected back into your brain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_50","text":"Corruption can be treated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_51","text":"If you're corrupted and you don't have NIMPH... you know what happens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_52","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_52","text":"... You're talking about Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_53","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_53","text":"Unless it's an absolute emergency, I want to avoid using Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_54","text":"So you can drop the idea of getting injected with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_55","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_55","text":"... Okay. Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_56","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_56","text":"But what should we do if Master gets hurt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_57","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_58","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_33_02_s_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_59","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_59","text":"All right, if the Commander gets seriously hurt, and Rapi isn't available,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_60","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_60","text":"I say we go ahead and treat him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_61","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_61","text":"Knowing full well we might be exposed to Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_62","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_62","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_63","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_63","text":"No, that's too dangerous...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_64","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_33_02_s_64","text":"It's preferable to standing there and watching you die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_65","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_65","text":"That's right. That's too horrible to even consider.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_66","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_66","text":"Good. Then it's decided.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_67","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_67","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_33_02_s_68","text":"If you don't want it to happen, don't get hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_69","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_69","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_70","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_70","text":"But Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_71","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_71","text":"We're going to go fight a Heretic, but didn't we use up all the Vapaus bullets?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_72","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_33_02_s_72","text":"I think we should replenish our inventory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_73","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_73","text":"Agreed. I've been trying to contact Cecil, but haven't been able to reach her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_74","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_33_02_s_74","text":"That, and the fact they haven't done anything regarding Dorothy, tells me something's happening in Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_75","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_33_02_s_75","text":"It might be a good idea to stop by if we have time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_33_02_s_76","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_33_02_s_76","text"