"id":"d_nikke_ce005_03_02_14","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_14","text":"Are you all right?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_15","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_15","text":"... She's unconscious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_16","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_16","text":"Commander, we need paramedics right away!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_17","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_17","text":"The hospital is nearby. It's quicker to take her there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_18","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_18","text":"Understood. Please show me the way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_19","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_19","text":"Hospital entrance.","jump":null,"exit":false,"enter":null,"bg":"NikkeCorridor","bgArt":"nikkecorridor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_20","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_20","text":"Hello, Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mary"],"affinity":null},{"id":"d_nikke_ce005_03_02_21","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_21","text":"Oh my.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_22","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_22","text":"... A patient, huh? Please gently lay her down here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_23","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_23","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_24","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_24","text":"She was staggering on the street and suddenly collapsed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_25","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_25","text":"Considering the initial symptoms I've noticed, it's likely a brain hemorrhage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_26","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_26","text":"We brought her here as quickly as possible, so with the right treatment, there shouldn't be any long-term effects.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_27","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_27","text":"That's an accurate diagnosis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_28","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_28","text":"Thank you. I'll get ready right away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_29","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_29","text":"Commander, I'm sorry. You've come all this way, but it seems like you'll have to wait for a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_30","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_30","text":"It's okay. A person's life is more important than anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_31","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_31","text":"Hehe, then please wait just a little longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_32","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_32","text":"Mary pushes the stretcher with the patient into the hospital room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_33","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_33","text":"Moments later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_34","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_34","text":"Sorry for keeping you waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_35","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_35","text":"Is this the Sakura you were talking about, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_36","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_36","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_37","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_37","text":"Nice to meet you. I'm Sakura Suzuhara.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_38","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_38","text":"Hello, I'm Mary. I'm a doctor from the Seraphim Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_39","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_39","text":"I heard you've been helping out a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_40","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_40","text":"I'd love to help in any way if I had the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_41","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_41","text":"It looks really busy here, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_42","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_42","text":"By the way, how is the patient from earlier?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_43","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_43","text":"Fortunately, you two found her and brought her here as soon as you could. Thanks to you two, she's fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_44","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_44","text":"But I was a bit surprised.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_45","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_45","text":"I heard from the Commander that you wanted to learn some medical knowledge, so I thought a rookie would be coming...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_46","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_46","text":"But what you did earlier was nothing short of masterful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_47","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_47","text":"I'm embarrassed to admit, but I was originally a medical officer... A medical officer who treated humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_48","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_48","text":"That's why I don't know anything about how to treat Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_49","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_49","text":"As a result, I'm not of much help on the front lines...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_50","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_50","text":"Don't say that, Sakura.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_51","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_51","text":"Becoming a doctor already takes unimaginable effort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_52","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_52","text":"You're so kind, Sakura.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_53","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_53","text":"Right now, you just don't know how to treat Nikkes yet, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_54","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_54","text":"But I'm sure you'll pick it up in no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_55","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_55","text":"Really...? Would you be willing to teach me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_56","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_56","text":"Hehe. You don't have to be so polite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_57","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_57","text":"Let's call it an exchange of information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_58","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_58","text":"How exactly should we do it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_59","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_59","text":"There are many human patients here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_60","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_60","text":"You'll teach me how to treat humans, and I'll show you how we treat Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_61","type":"Speech","speaker":"mary","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_61","text":"How does that sound?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_62","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_62","text":"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_63","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_63","text":"Deal!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_64","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_64","text":"Commander, is it okay if I study here for a while?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_65","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_65","text":"Of course, you can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_66","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_66","text":"Thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_ce005_03_02_67","type":"Speech","speaker":"ce005_03","key":"Locale_NikkeEpisode:d_nikke_ce005_03_02_67","text":"Then, Mary, I'm looking forward to working with y