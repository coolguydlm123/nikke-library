{"id":"d_counseling_eunhwa_07","cat":"counsel","group":{"id":"char5023","label":"Eunhwa"},"label":"Advising Eunhwa: 07","stage":null,"prev":"d_counseling_eunhwa_06","next":"d_counseling_eunhwa_08","speakers":{"eunhwa":"Eunhwa"},"icons":{"eunhwa":"si_c092_00_s"},"lines":[{"id":"d_counseling_eunhwa_07_1","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_1","text":"Absolute or Matis?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["eunhwa"],"affinity":"_0"},{"id":"d_counseling_eunhwa_07_2","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_2","text":"Which squad is the strongest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_07_3","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_3","text":"Everyone's been talking about it. Tell me, what are your thoughts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_07_4","text":"Absolute, of course.","jump":"d_counseling_eunhwa_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_eunhwa_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_07_5","text":"It's hard to beat Matis's technology.","jump":"d_counseling_eunhwa_07_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eunhwa_07_6","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_6","text":"Of course you would say that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_07_7","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_7","text":"But, you might actually not be as stupid as you look.","jump":"d_counseling_eunhwa_07_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_07_8","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_8","text":"Pssh, do you really think strength is determined by technology alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_07_9","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_9","text":"The important thing is how you use that technology.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_07_10","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_07_10","text":"When it comes to that, you all get a big fat zero. Goose egg. It's no wonder your perspective is so distorted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_07_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_07_11","text":"I talk with Eunhwa about the concept of strength.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}