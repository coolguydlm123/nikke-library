{"id":"s006_06","cat":"side","group":{"id":"side6","label":"GINGERBREAD HOUSE"},"label":"GINGERBREAD HOUSE: 6","stage":null,"prev":"s006_05","next":"s006_07","speakers":{"cinderella":"Cinderella","bernoullia":"Bernoullia"},"icons":{"cinderella":"si_c511_00_s","bernoullia":"si_c9042_00_s"},"lines":[{"id":"s006_06_1","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_1","text":"What's your objective?","jump":null,"exit":false,"enter":null,"bg":"WitchLaboratory","bgArt":"witchlaboratory","image":null,"bgm":"none","movie":null,"shown":["bernoullia","cinderella"],"affinity":null},{"id":"s006_06_2","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_2","text":"What an impatient little lady you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_3","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_3","text":"And quite insolent, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_chapter43_field_password","movie":null,"shown":null,"affinity":null},{"id":"s006_06_4","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_4","text":"Must I remind you that you're here to make amends for breaking my vase?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_5","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_6","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_6","text":"... Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_7","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_7","text":"Then, allow me to ask you one thing first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_8","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_8","text":"Go on, ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_9","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_9","text":"Your leg...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_10","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_10","text":"Why do you have a prosthetic leg?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_11","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_12","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_12","text":"A Heretic should have no trouble regenerating that leg.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_13","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_13","text":"It should be a simple matter of body restoration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_14","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_14","text":"Why haven't you done so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_15","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_15","text":"I won't deny that I could restore it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_16","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_16","text":"Naturally, I have my reasons for not doing so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_17","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_17","text":"Are you really a Heretic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_18","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_18","text":"In principle, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_19","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_19","text":"Why? Do I strike you as different somehow, despite being a Heretic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_20","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_20","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_21","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_21","text":"I suppose you were bound to be different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_22","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_22","text":"My little hellions told me","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_23","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_23","text":"how you came to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_24","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_24","text":"You heard that from Hansel and Gretel?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_25","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_25","text":"Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_26","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_26","text":"The little hellions told me they had a friend","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_27","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_27","text":"who'd been corrupted by something wicked and turned into a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_28","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_28","text":"That would be you, would it not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_29","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_29","text":"... That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_30","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_30","text":"I was made rather differently from you, you see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_31","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_31","text":"I was never corrupted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_32","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_32","text":"I chose to turn my own body into that of a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_33","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_33","text":"What... did you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_34","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_34","text":"What exactly do you think makes one a Heretic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_35","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_35","text":"A Nikke brainwashed into serving the Rapture Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_36","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_36","text":"Or one brainwashed into fighting for the Raptures instead of humanity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_37","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_37","text":"I thought it was both.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_38","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_38","text":"Hmm, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_39","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_39","text":"Even after all this time, they still believe that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_40","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_40","text":"Heh, the bastards over there must have done a rather fine job of controlling the information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_41","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_41","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_42","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_42","text":"Are you suggesting \"Heretic\" means something else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_43","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_43","text":"Indeed. Here, \"Heretic\" carries a rather different meaning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_44","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_44","text":"Have you ever wondered where the term came from in the first place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_45","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_45","text":"Back when I was a Heretic, I heard V.T.C. was the one who came up with the term.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_46","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_46","text":"Yes, V.T.C. coined the name.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_47","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_47","text":"By their definition, Heretics are beings that cannot live beneath the blessing of Her Holiness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_48","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_48","text":"Raptures with human brains,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_49","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_49","text":"yet bearing the form of Nikkes...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_50","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_50","text":"That is what a Heretic is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_51","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_51","text":"!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_52","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_52","text":"What... do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_53","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_53","text":"That almost sounds as though you're saying Heretics are Raptures with human brains.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_54","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_54","text":"You're quite right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_55","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_55","text":"Which means you're still a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_56","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_56","text":"After all, that body of yours is made up of a human brain and a Rapture body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_57","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_57","text":"No, I'm... a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_58","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_58","text":"I don't want to fight for the Raptures or the Queen anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_59","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_59","text":"I'm acting of my own free will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_60","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_60","text":"Yes, the corruption may be gone,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_61","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_61","text":"but that doesn't mean your body has returned to its original state.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_62","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_62","text":"Your eyes are still red, for one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_63","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_63","text":"What is it you're trying to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_64","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_64","text":"You asked what my objective was, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_65","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_65","text":"What interests me is the corruption planted inside your head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_66","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_66","text":"I hear its source was one of the priestesses of V.T.C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_67","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_67","text":"If that's truly the case, then it means corruption is no longer something beyond our understanding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_68","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_68","text":"I suspect it is a form of code that can be understood by humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_69","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_69","text":"And that is precisely what I wish to learn from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_70","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_70","text":"Even if you're no longer corrupted, there must still be traces of it left within your body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_71","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_71","text":"You want to learn about... corruption?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_72","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_72","text":"That's right. You'll find no such corruption here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_73","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_73","text":"... Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_74","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_74","text":"Then absolutely not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_75","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_75","text":"Corruption brings nothing but misery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_76","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_76","text":"I'll never hand it over, not for the sake of the Nikkes here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_77","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_77","text":"Hmm... interesting. What if I were to take it from you by force?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_78","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_78","text":"Then I'll simply have to use my Glass Slippers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_79","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_79","text":"Glass Slippers...? Are you referring to the weapon at your side?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_80","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_80","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_81","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_81","text":"That name suits you, Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_82","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_82","text":"Yet you still think of yourself as a Nikke, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_83","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_83","text":"You're consciously refusing to use your abilities as a Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_84","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_84","text":"Did you know? In theory, you could still transform.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_85","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_85","text":"I'm a Nikke. I don't... transform like a Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_86","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_86","text":"... I would never do something so unsightly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_87","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_87","text":"It isn't that you won't. You simply can't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_88","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_88","text":"You've yet to accept what you are... a Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_89","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_90","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_90","text":"And you expect to defeat the Queen with that mindset?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_91","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_91","text":"How did you...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_92","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_92","text":"A long time ago, you and your friends took the Lift to fight the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_93","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_93","text":"If you've come to see my hellions now and ask them to fight alongside you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_94","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_94","text":"the answer seems rather obvious, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_95","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_95","text":"The Rapture Queen must finally be descending to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_96","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_97","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_97","text":"You may be formidable,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_98","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_98","text":"but your strength as it stands will not be enough to defeat the Rapture Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_99","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_99","text":"She is, quite simply, beyond what you can defeat as you are now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_100","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_100","text":"So I shall teach you","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_101","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_101","text":"how to make proper use of that body of yours,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_102","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_102","text":"and how to ensure that the remnants of the Corruption Code within you","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_103","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_103","text":"never awaken again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_104","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_104","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_105","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_105","text":"Why would you go to such lengths just to learn about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_106","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_106","text":"I'm curious, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_107","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_107","text":"A witch can't help but be drawn to rare and beautiful things, you see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_108","type":"Speech","speaker":"cinderella","key":"Locale_SideStory:s006_06_108","text":"A witch?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s006_06_109","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_109","text":"Allow me to introduce myself once more.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_06_01","bgArt":"eventscene_side_06_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_110","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_110","text":"I am the Heretic who betrayed V.T.C.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_oldtales_wall","movie":null,"shown":null,"affinity":null},{"id":"s006_06_111","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_111","text":"My name is Bernoullia, though I am better known to those hunting me as the Witch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_112","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_112","text":"I shall grant you greater power with which to stand against the Queen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_113","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_113","text":"in exchange for allowing me to examine your corruption code.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s006_06_114","type":"Speech","speaker":"bernoullia","key":"Locale_SideStory:s006_06_114","text":"Will you make a deal with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}