7_06_s_19","text":"It is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_06_s_20","type":"Speech","speaker":"maxwell_op","key":"Locale_MainScenario:d_main_37_06_s_20","text":"Don't get ahead of yourselves. Keep tracking Leviathan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["maxwell_op"],"affinity":null},{"id":"d_main_37_06_s_21","type":"Speech","speaker":"maxwell_op","key":"Locale_MainScenario:d_main_37_06_s_21","text":"I'll be doubling as your Operator, so don't try and be a hero out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_06_s_22","type":"Speech","speaker":"helm_op_l","key":"Locale_MainScenario:d_main_37_06_s_22","text":"The Admire's armaments are on standby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mast_op_c","helm_op_l","anchor_op_r"],"affinity":null},{"id":"d_main_37_06_s_23","type":"Speech","speaker":"helm_op_l","key":"Locale_MainScenario:d_main_37_06_s_23","text":"Feel free to request a bombardment whenever you need it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_06_s_24","type":"Speech","speaker":"mast_op_c","key":"Locale_MainScenario:d_main_37_06_s_24","text":"I'll make sure that every shot finds its mark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_37_06_s_25","type":"Speech","speaker":"helm_op_l","key":"Locale_MainScenario:d_main_37_06_s_25","text":"We'll also have Anchor scanning the surroundings. Unlike Drake, she can detect objects, so that should prove helpful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt