dess_01_79","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_79","text":"It's still a bit early, so I think I'll do some tidying up...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_80","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_80","text":"Do you want to take a walk on the beach together?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_81","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_81","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_82","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_82","text":"No reason. I just hate to think of you being cooped up in here all day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_83","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_83","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_84","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_84","text":"Heh-heh, all right. As long as we keep it quick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_85","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_85","text":"I never thought I'd be able to see the ocean up on the surface.","jump":null,"exit":false,"enter":null,"bg":"Beach_d","bgArt":"beach_d","image":null,"bgm":"bgm_story_sundayintheark","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_86","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_86","text":"I know I'm supposed to be here in a professional capacity, but I can't help but admire the view.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_87","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_87","text":"I'll never forget it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_88","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_88","text":"Just don't push yourself too hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_89","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_89","text":"Heh-heh, I hear you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_90","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_90","text":"But I can't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_91","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_91","text":"Especially here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_92","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_92","text":"This place has been abandoned for many years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_93","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_93","text":"Anything could happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_94","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_94","text":"Especially to you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_95","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_95","text":"I'm as healthy as a horse. It's all good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_96","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_96","text":"The more brash people are, the more they tend to get injured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_97","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_97","text":"Like I said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_Mary_BayGoddess_01_98","type":"Speech","speaker":"mary_s","key":"Locale_NikkeEpisode:d_nikke_Mary_BayGoddess_01_98","text":"This place has been deserted for a long time.","ju