{"id":"d_counseling_rupee_16","cat":"counsel","group":{"id":"char5034","label":"Rupee"},"label":"Advising Rupee: 16","stage":null,"prev":"d_counseling_rupee_15","next":"d_counseling_rupee_17","speakers":{"rupee":"Rupee"},"icons":{"rupee":"si_c200_00_s"},"lines":[{"id":"d_counseling_rupee_16_1","type":"Speech","speaker":"rupee","key":"Locale_Counseling:d_counseling_rupee_16_1","text":"Sweetie, how do you feel when you watch rich people go on a spending spree?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rupee"],"affinity":"_0"},{"id":"d_counseling_rupee_16_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rupee_16_2","text":"I find it therapeutic.","jump":"d_counseling_rupee_16_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rupee_16_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rupee_16_3","text":"I get nothing out of it.","jump":"d_counseling_rupee_16_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rupee_16_4","type":"Speech","speaker":"rupee","key":"Locale_Counseling:d_counseling_rupee_16_4","text":"Hehe. I'm glad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rupee_16_5","type":"Speech","speaker":"rupee","key":"Locale_Counseling:d_counseling_rupee_16_5","text":"I was hoping you'd feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rupee_16_6","type":"Speech","speaker":"rupee","key":"Locale_Counseling:d_counseling_rupee_16_6","text":"My hope is that my viewers can take a load off their minds by watching me spend.","jump