ncy_05_27","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_05_27","text":"Because I'm looking forward to those croquettes.","jump":"d_nikke_quency_05_29","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_05_28","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_05_28","text":"Because I want to see you in the Ark.","jump":"d_nikke_quency_05_30","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_05_29","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_05_29","text":"Why wait? I could have that arranged right now.","jump":"d_nikke_quency_05_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_05_30","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_05_30","text":"Sure, maybe one day.","jump":"d_nikke_quency_05_31","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_05_31","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_05_31","text":"Aren't you sick of this place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_05_32","type":"Speech","speaker":"quency","key":"Locale_NikkeEpisode:d_nikke_quency_05_32","text":"What's there not to like?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_quency_05_33","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_quency_05_33","text":"You'll have more freedom in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie"