{"id":"msg_m_ex_counters_07","cat":"messenger","group":{"id":"room_counters","label":"Counters · Group"},"label":"17. Commander,","stage":null,"prev":"msg_m_ex_counters_06","next":"msg_m_mainafter_26_01","speakers":{"anis_s":"Anis","rapi_s":"Rapi","neon_s":"Neon"},"icons":{"anis_s":"si_c015_00_s","rapi_s":"si_c010_02_s","neon_s":"si_c014_00_s"},"lines":[{"id":"m_ex_counters_07_1","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_1","text":"Commander,","jump":null},{"id":"m_ex_counters_07_2","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_2","text":"guess what we're doing right now?","jump":null},{"id":"m_ex_counters_07_3","type":"Speech","speaker":"rapi_s","key":"Locale_SuddenMessage:m_ex_counters_07_3","text":"Anis, I think this should stay between us.","jump":null},{"id":"m_ex_counters_07_4","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_4","text":"But why?","jump":null},{"id":"m_ex_counters_07_5","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_5","text":"Don't be so shy!","jump":null},{"id":"m_ex_counters_07_6","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_6","text":"Actually, I'm a bit nervous myself...","jump":null},{"id":"m_ex_counters_07_7","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_7","text":"Hehehe!","jump":null},{"id":"m_ex_counters_07_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_8","text":"What are you all up to now?","jump":null},{"id":"m_ex_counters_07_9","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_9","text":"Hehehe!","jump":null},{"id":"m_ex_counters_07_10","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_10","text":"Hehehehehe!","jump":null},{"id":"m_ex_counters_07_11","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_11","text":"We swapped swimsuits.","jump":null},{"id":"m_ex_counters_07_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_12","text":"!","jump":null},{"id":"m_ex_counters_07_13","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_13","text":"I'm wearing Rapi's.","jump":null},{"id":"m_ex_counters_07_14","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_14","text":"It's like a second skin.","jump":null},{"id":"m_ex_counters_07_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_15","text":"!!","jump":null},{"id":"m_ex_counters_07_16","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_16","text":"It looked so tight I thought it would be uncomfortable","jump":null},{"id":"m_ex_counters_07_17","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_17","text":"but it's actually super comfy.","jump":null},{"id":"m_ex_counters_07_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_18","text":"!!!","jump":null},{"id":"m_ex_counters_07_19","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_19","text":"Neon is wearing mine.","jump":null},{"id":"m_ex_counters_07_20","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_20","text":"Why don't you say something, Neon?","jump":null},{"id":"m_ex_counters_07_21","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_21","text":"I'm just feeling a little down on myself.","jump":null},{"id":"m_ex_counters_07_22","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_22","text":"When Anis wore it","jump":null},{"id":"m_ex_counters_07_23","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_23","text":"I could've sworn the ribbon at the back wasn't this long.","jump":null},{"id":"m_ex_counters_07_24","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_24","text":"I'm not in the mood to hone my waterpower anymore.","jump":null},{"id":"m_ex_counters_07_25","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_25","text":"For the time being, you're my new master, Anis.","jump":null},{"id":"m_ex_counters_07_26","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_26","text":"Thanks, but no thanks.","jump":null},{"id":"m_ex_counters_07_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_27","text":"So is Rapi wearing Neon's swimsuit?","jump":null},{"id":"m_ex_counters_07_28","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_28","text":"Yep.","jump":null},{"id":"m_ex_counters_07_29","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_29","text":"Crazy right?","jump":null},{"id":"m_ex_counters_07_30","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_30","text":"I can hardly believe it myself.","jump":null},{"id":"m_ex_counters_07_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_31","text":"Crazy indeed.","jump":null},{"id":"m_ex_counters_07_32","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_32","text":"I've gotta admit though, she pulls it off.","jump":null},{"id":"m_ex_counters_07_33","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_33","text":"Just a sec.","jump":null},{"id":"m_ex_counters_07_34","type":"Speech","speaker":"anis_s","key":"Locale_SuddenMessage:m_ex_counters_07_34","text":"I'll send you a photo.","jump":null},{"id":"m_ex_counters_07_35","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_35","text":"For a while, there's silence.","jump":null},{"id":"m_ex_counters_07_36","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_36","text":"Master!","jump":null},{"id":"m_ex_counters_07_37","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_37","text":"It's a real mess over here. Rapi stole Anis's phone.","jump":null},{"id":"m_ex_counters_07_38","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_38","text":"Hehehehehehehehehe!","jump":null},{"id":"m_ex_counters_07_39","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_39","text":"She's dead set on preventing us from sending a photo.","jump":null},{"id":"m_ex_counters_07_40","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_40","text":"I'm worried my swimsuit is gonna get ruined in the scuffle...","jump":null},{"id":"m_ex_counters_07_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_41","text":"That's too bad, I really wanted to see how you all look.","jump":null},{"id":"m_ex_counters_07_42","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_42","text":"Hehe!","jump":null},{"id":"m_ex_counters_07_43","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_43","text":"When the time is right,","jump":null},{"id":"m_ex_counters_07_44","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_44","text":"I'll try and send you a photo.","jump":null},{"id":"m_ex_counters_07_45","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_45","text":"But before then,","jump":null},{"id":"m_ex_counters_07_46","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_46","text":"I've got to... er, \"develop\" in a few areas...","jump":null},{"id":"m_ex_counters_07_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_47","text":"Where are Anis and Rapi?","jump":null},{"id":"m_ex_counters_07_48","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_48","text":"They are still fighting over the phone.","jump":null},{"id":"m_ex_counters_07_49","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_49","text":"I think they'll be at it for a while.","jump":null},{"id":"m_ex_counters_07_50","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_counters_07_50","text":"All right, well, you take it easy.","jump":null},{"id":"m_ex_counters_07_51","type":"Speech","speaker":"neon_s","key":"Locale_SuddenMessage:m_ex_counters_07_51","text":"You too, Master.","jump":null}],"chat":true}