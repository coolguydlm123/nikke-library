":"Locale_NikkeEpisode:d_nikke_emma_03_14","text":"Yeah, hey-hey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_15","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_15","text":"No matter what you say, it'll be as if nothing happened when you wake up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_16","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_16","text":"You can speak your mind here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_17","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_17","text":"Commander, what is it that worries you so? What's keeping you up at night?","jump":"d_nikke_emma_03_33","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_18","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_18","text":"As soon as I reach out, I catch something soft in my hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_19","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_19","text":"That's right. Based on its size, it's...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_20","text":"Emma?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_sunshinesorrow","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_21","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_21","text":"Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["emma"],"affinity":null},{"id":"d_nikke_emma_03_22","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_22","text":"Don't you think getting to know me in this manner is going a bit overboard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_23","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_23","text":"I thought you needed me, so I ran over immediately. But instead... You really are a tease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_24","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_24","text":"It's a mistake.","jump":"d_nikke_emma_03_26","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_25","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_25","text":"I'm sorry.","jump":"d_nikke_emma_03_26","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_26","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_26","text":"Well... I can't feel your sincerity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_27","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_27","text":"Of course, if you answer my question, your behavior is not inexcusable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_28","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_28","text":"You can ask whatever you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_29","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_30","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_30","text":"I've said it before, and I'll say it again, Commander...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_31","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_31","text":"You seem to push yourself too hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_32","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_32","text":"What is the reason?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_33","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_33","text":"Everyone is sacrificing themselves for my goals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_34","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_34","text":"Well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_35","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_35","text":"As far as I know, Commander, your goal is to...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_36","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_36","text":"There will be no more victims like Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_37","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_37","text":"Marian... is clearly","jump":null,"exit":false,"enter":null,"bg":"EventScene_Main_01_02_bg","bgArt":"eventscene_main_01_02_bg","image":null,"bgm":null,"movie":null,"shown":["marian_event_02"],"affinity":null},{"id":"d_nikke_emma_03_38","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_38","text":"the Nikke who was corroded during your first battle, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_39","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_39","text":"This is indeed a shocking experience for the newly-appointed commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_40","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_40","text":"However, most commanders believe putting these memories behind and moving forward is the only way to grow.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":null,"movie":null,"shown":["emma"],"affinity":null},{"id":"d_nikke_emma_03_41","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_41","text":"Can you follow their example, Commander?","jump":null,"exit"