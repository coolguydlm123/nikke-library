ull,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_49","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_49","text":"But this was not the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_50","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_50","text":"So what is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_51","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_52","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_52","text":"Hey... Cat got your tongue?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_53","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_53","text":"You're fighting and doing everything ultimately for us, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_54","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_54","text":"We're deeply aware and moved by your sentiments, Commander. Naturally, we're also willing to sacrifice ourselves for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_55","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_55","text":"Commander, why do you have to bear all this alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_56","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_56","text":"Of course, like this mission, we're not happy about being subjected to Syuen's whims and fancies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_57","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_57","text":"Nevertheless, Counters still follow you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_58","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_58","text":"Your desire to cross the deathtrap for an ideal homeland is meaningful to them as well, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_59","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_59","text":"Of course, the same is true for me. Woohoo!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_60","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_60","text":"Nevertheless, it was my fault that I failed to minimize the sacrifice.","jump":"d_nikke_emma_03_62","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_61","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_61","text":"Nod","jump":"d_nikke_emma_03_71","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_62","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_62","text":"Oh, now you're an extreme perfectionist, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_63","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_63","text":"I thought Eunhwa is the only one of that kind around me... It's amazing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_64","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_64","text":"So... what does it look like?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_65","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_65","text":"I'm always careless and making mistakes, but I want to turn over a new leaf and right my wrongs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_66","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_66","text":"Commander, from your point of view, do I look depressed and dissatisfied?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_67","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_67","text":"Absolutely not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_68","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_68","text":"Right? Hahaha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_69","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_69","text":"I hope this will also be a good answer to you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_70","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_70","text":"...","jump":"d_nikke_emma_03_73","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_71","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_71","text":"This kid has a heart of gold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_72","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_72","text":"And... kids like that should be rewarded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_73","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_73","text":"In that case, tomorrow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_74","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_74","text":"Let me take you to an awesome place where you can relax a bit, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_75","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_75","text":"A place that can beat daily fatigue, spiritual trauma, and the weight of life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_76","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_76","text":"Commander, I know you have your goals, but you're pushing yourself too hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_77","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_77","text":"You're reaching your physical and mental limits, which only wears you out more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_78","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_78","text":"So... will you come with me? To the paradise where I rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_79","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_79","text":"I have to take care of Neon and Anis tomorrow, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_80","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_80","text":"It should be fine if it's just a day or so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_81","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_81","text":"Woohoo! Nice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_82","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_82","text":"Then leave your body and mind to me the whole day tomorrow. As for today...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_83","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_emma_03_83","text":"As soon as Emma touches my head, my eyelids start to droop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_84","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_84","text":"Sleep tight, my precious baby...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_85","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_85","text":"In the front yard and over the back hills...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_emma_03_86","type":"Speech","speaker":"emma","key":"Locale_NikkeEpisode:d_nikke_emma_03_86","text":"the birds and baby lamb are all sound asleep...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}