crust","key":"Locale_SuddenStory:d_ex_command_10_40","text":"but the ones you made are incredibly neat!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_41","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_command_10_41","text":"I wanted to take photos of my cooking and show them to people,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_42","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_command_10_42","text":"so I tried really hard to keep everything neat and tidy throughout.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_43","type":"Speech","speaker":"crust","key":"Locale_SuddenStory:d_ex_command_10_43","text":"You truly do understand the importance of proper knife technique!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_44","type":"Speech","speaker":"crust","key":"Locale_SuddenStory:d_ex_command_10_44","text":"At this point, I'm starting to think you have a real talent for cooking!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_45","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_command_10_45","text":"Hehe, I wouldn't go that far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_46","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_command_10_46","text":"Uh... I'm done with my paperwork, so I'm ready to try the food...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,