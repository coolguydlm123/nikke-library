"Speech","speaker":"crust","key":"Locale_SuddenStory:d_ex_command_10_13","text":"Thank you, Mr. Gourmand!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_14","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_command_10_14","text":"You can keep doing your work for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_15","type":"Speech","speaker":"arcana_s","key":"Locale_SuddenStory:d_ex_command_10_15","text":"Once we're done making them, we'd love for you to give them a try!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_16","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_command_10_16","text":"All right. Give me a shout when you're done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_17","type":"Narration","speaker":null,"key":"Locale_SuddenStory:d_ex_command_10_17","text":"A short while later...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_18","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_command_10_18","text":"As I focus on my work, Arcana and Crust wrap up their cooking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_command_10_19","type":"Speech","speaker":"crust","key":"Locale_SuddenStory:d_ex_command_10_19","text":"Even to my eyes, these lunchboxes look very well made!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_