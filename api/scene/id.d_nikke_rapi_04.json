nikke_rapi_04_102","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_04_102","text":"Then we can enjoy a nice food coma together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_04_103","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_04_103","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_04_104","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_04_104","text":"I'll carry these. Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_04_105","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_04_105","text":"No, we can carry them together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_04_106","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_04_106","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_04_107","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_04_107","text":"Let's carry it together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}