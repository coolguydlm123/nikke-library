m":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_7","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_7","text":"What do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_8","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_8","text":"They're all portrayed as bloodthirsty monsters, so it must be quite a sight seeing them all resting here so peacefully.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_9","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_9","text":"The more you know about them, the greater their allure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_10","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_10","text":"Once you start to understand each of their individual personalities,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_11","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_11","text":"you'll really see why I think they should be considered a new form of animal life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_12","type":"Monologue","speaker":null,"key":"Locale_SubScenario:d_subquest_1104_12","text":"*Buzz buzz*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_13","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_13","text":"I'll introduce them one by one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_14","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_14","text":"First, at the very end, we have Crawler.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_15","type":"Speech","speaker":"landcrab","key":"Locale_SubScenario:d_subquest_1104_15","text":"*Screech* *Buzz*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_16","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_16","text":"I modeled my Raptocamo after him. He resembles a form of marine life called a crab.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_17","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_17","text":"At first, it seems unusual that Crawler skitters around sideways,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_18","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_18","text":"but various literature will tell you that crabs walk in the exact same fashion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_19","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_19","text":"Hence, the term \"crab walk\"!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_20","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_20","text":"To his left, we have Squid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_21","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_21","text":"You can guess which sea creature he takes after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_22","type":"Speech","speaker":"squid","key":"Locale_SubScenario:d_subquest_1104_22","text":"Blink. \nBlink, blink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_23","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_23","text":"Hey, he's sending you a friendly signal!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_24","type":"Speech","speaker":"raptilion","key":"Locale_SubScenario:d_subquest_1104_24","text":"Why don't you blink your flashlight as we practiced beforehand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_25","type":"Monologue","speaker":null,"key":"Locale_SubScenario:d_subquest_1104_25","text":"I fumble with the flashlight before turning it on and off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"re_d_subquest_1104_26","type":"Narration","speaker":null,"key":"Locale_SubScenario:d_subquest_1104_26","text":"Blink. Blink, blink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,