{"id":"d_counseling_poli_06","cat":"counsel","group":{"id":"char5016","label":"Poli"},"label":"Advising Poli: 06","stage":null,"prev":"d_counseling_poli_05","next":"d_counseling_poli_07","speakers":{"poli":"Poli"},"icons":{"poli":"si_c030_00_s"},"lines":[{"id":"d_counseling_poli_06_1","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_06_1","text":"Ugh... Commander, this rainy weather makes me feel like a sloth.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["poli"],"affinity":"_0"},{"id":"d_counseling_poli_06_2","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_06_2","text":"My body's so drained. I'm turning into a literal couch potato.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_06_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_06_3","text":"Do you want me to pet you?","jump":"d_counseling_poli_06_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_poli_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_poli_06_4","text":"It's because you have dog fur.","jump":"d_counseling_poli_06_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_poli_06_5","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_06_5","text":"Uh, I have no idea why you just said that, but since you did...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_poli_06_6","type":"Speech","speaker":"poli","key":"Locale_Counseling:d_counseling_poli_06_6","text":"I do like being stroked. I'll take it,