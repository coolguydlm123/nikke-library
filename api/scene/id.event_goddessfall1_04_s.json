{"id":"event_goddessfall1_04_s","cat":"event","group":{"id":"ev40093","label":"GODDESS FALL · Part 1"},"label":"Coronation: A","stage":null,"prev":"event_goddessfall1_intermission_01","next":"event_goddessfall1_04_e","speakers":{"nayuta_m":"Nayuta","mirror_r":"Mirror","janghwa_n":"Rose"},"icons":{"nayuta_m":"si_c223_00_s","mirror_r":"si_c982_00_s","janghwa_n":"si_c971_01_s"},"lines":[{"id":"event_goddessfall1_04_s_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_1","text":"Carrying Nayuta, Mantra tears across the ground.","jump":null,"exit":false,"enter":null,"bg":"DistantEden","bgArt":"distanteden","image":null,"bgm":"event_bgm_goddessfall_fear","movie":null,"shown":["nayuta_m"],"affinity":null},{"id":"event_goddessfall1_04_s_2","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_3","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_3","text":"Foolish. So foolish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_4","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_4","text":"To falter in that instant... to be swayed by petty attachments ere a grand undertaking...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_5","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_5","text":"... All these years hast been lived in vain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_6","text":"From afar, she watches the Raptures attacking Eden, and the flashes and explosions that repel them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_7","text":"Nayuta lowers her head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_8","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_8","text":"... I offer my deepest apologies... everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_9","text":"Mantra keeps running.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_10","text":"As the landscape whips past in a rapid blur, Nayuta catches a glimpse of red streaking past her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_11","text":"She twists around and peers behind, but sees nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_12","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_12","text":"Mantra continues its relentless run.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_13","text":"Still, the red continues to flicker persistently on the edge of her vision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_14","text":"Then, she spots a figure in the far distance, waving at her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_15","text":"Without hesitation, Nayuta brings Mantra to a stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["janghwa_n"],"affinity":null},{"id":"event_goddessfall1_04_s_16","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_16","text":"... Young Lady Mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_anothermirror","movie":null,"shown":["mirror_r"],"affinity":null},{"id":"event_goddessfall1_04_s_17","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_17","text":"It's been a while, Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_18","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_18","text":"... Methinks there lieth some purpose in thy appearing afore me at this most particular juncture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_19","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_19","text":"That's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_20","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_20","text":"Rose, will you bring her here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_21","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall1_04_s_21","text":"All right, all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_22","text":"Rose appears from the bush, carrying Marian on her back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_04_s_23","text":"She lays Marian on the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_24","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_24","text":"... Young Lady... Marian.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_25","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_25","text":"What brings her hither... in thy company...? She was at the Crown Kingdom...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_26","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_26","text":"And how came these injuries about...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_27","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_27","text":"She was betrayed...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_28","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_28","text":"by Indivilia and Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_29","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_30","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_30","text":"Young Lady Marian?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_31","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_31","text":"Nay, I cannot fathom thy meaning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_32","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_32","text":"Betrayed, thou sayest? Those twain did assail the Crown Kingdom from the outset...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_33","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_34","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_34","text":"Verily, it cannot be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_35","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_35","text":"As expected of a bystander, you seem to catch on quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_36","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_36","text":"Has Young Lady Marian... truly become the Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_37","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_37","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_38","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_38","text":"She has awakened. The Queen Gene has been activated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_39","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_39","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_40","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_40","text":"Because of the battle in the Crown Kingdom, Marian awakened the Queen Gene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_41","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_41","text":"With Indivilia and Chatterbox under her command, she sensed the original Queen and came here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_42","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_42","text":"Heh... utterly reckless, but it shows she is fully aware of her role as the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_43","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_43","text":"She must have come to absorb and integrate the original Queen's genes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_44","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_44","text":"Hmm... judging by her current state, that probably wasn't the wisest decision...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_45","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_45","text":"Nevertheless, her intentions are admirable, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_46","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_46","text":"Doth she yet live?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_47","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_47","text":"Of course, she's only just awakened the Queen Gene, but she's still a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_48","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_48","text":"She's badly beaten and recovering slowly, but she's not dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_49","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_49","text":"Take her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_50","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_50","text":"Take her with you, and protect her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_51","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_51","text":"Just so you know, it seems Marian wants to keep the fact that she's the Queen a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_52","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_52","text":"So please, don't go telling anyone once you get to Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_53","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_53","text":"I shall bear that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_54","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_54","text":"Is there any other news?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_55","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_55","text":"Verily, I recall the Maleficent Beast Quartet is creating a Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_56","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_56","text":"Oh, you mean the Four Beasts?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_57","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_57","text":"That's fine. There's no way something like that could be made so easily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_58","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_58","text":"A Queen isn't something you can create with such childish play, hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_59","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_60","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_60","text":"... Then comes the awakening of the Great Hero's gene...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_61","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_61","text":"... Might it be that it hath responded to Young Lady Marian?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_62","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_62","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_63","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_63","text":"Pray, hast thou any inkling of Young Lady Marian's awakening unto Queenhood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_64","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_64","text":"I'd like to hear your thoughts first, Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_65","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_66","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_66","text":"The Queen beyond the heavens hath been absent for too long, so the Raptures upon Earth sought a new Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_67","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_67","text":"The Queen Gene manifested within both Raptures and Heretics, thereby bestowing upon them the right to Queenship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_68","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_68","text":"Yet the Gene Reaper could not remain idle whilst this came to pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_69","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_69","text":"Whether she sensed, or perchance heard, the Queen Gene's emergence, none can say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_70","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_70","text":"Be that as it may, the Gene Reaper hath, unto this day, annihilated all who exhibited the Queen Gene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_71","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_71","text":"If Young Lady Marian likewise manifested this Queen Gene, the Gene Reaper would ne'er have remained idle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_72","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_72","text":"Hmm... since you've deduced that far, the answer should be obvious, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_73","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_73","text":"... The Queen Gene hath evolved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_74","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_74","text":"That's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_75","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_75","text":"To survive the crazed Gene Reaper, it evolved to manifest itself in secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_76","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_76","text":"That shows how desperately the surface longed for a Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_77","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_77","text":"Heh, and yet... the original Queen is descending from the sky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_78","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_78","text":"Things are getting quite interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_79","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_79","text":"Thou findest all this interesting, verily?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_80","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_80","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_81","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_81","text":"The sacrificial lamb for the coronation is coming down of her own accord. Isn't this delightful?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_82","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_82","text":"Nayuta, take good care of Marian until the day of the coronation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_83","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_83","text":"... Verily, I shall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_84","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_84","text":"Then we'll continue observing from a distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_85","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_85","text":"Mightst thou consider offering thy assistance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_86","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_86","text":"Don't make me laugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_87","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_87","text":"I want to be both a bystander and someone who intervenes at the decisive moment—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_88","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_88","text":"just like right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_89","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_90","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_90","text":"Let's go, Rose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_91","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall1_04_s_91","text":"Where are we going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_92","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_goddessfall1_04_s_92","text":"To the place with the best view of everything that's happening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_93","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_93","text":"... I understand, Young Lady Mirror, but can Swordwarden aid us in the least?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_94","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_94","text":"Thy agility doth far surpass the ordinary, and thou wouldst prove of great assistance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_95","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall1_04_s_95","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_96","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall1_04_s_96","text":"If I step in, Scarlet will only be miserable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_97","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_97","text":"She doth not seem particularly happy right now either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_98","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall1_04_s_98","text":"At least, relatively speaking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_99","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall1_04_s_99","text":"If she sees me, she'll certainly be far worse off than she is now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_100","type":"Speech","speaker":"nayuta_m","key":"Locale_MainScenario:event_goddessfall1_04_s_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_04_s_101","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:event_goddessfall1_04_s_101","text":"That's why I don't want to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}