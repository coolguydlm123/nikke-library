l,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_6","type":"Speech","speaker":"ce004_03","key":"Locale_SubScenario:event_ce004_1_06_s_6","text":"So this is this world's simulation room...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_7","type":"Speech","speaker":"ce004_03","key":"Locale_SubScenario:event_ce004_1_06_s_7","text":"I wonder what kind of method will be used for this test?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_8","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_06_s_8","text":"Let's hurry and get this test over with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_9","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_06_s_9","text":"We should be engaging in proper combat training, not this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_10","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_10","text":"Testing, testing. Can you hear me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["marciana_op"],"affinity":null},{"id":"event_ce004_1_06_s_11","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_1_06_s_11","text":"Yes, we can hear you, Miss Marciana.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_12","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_12","text":"As I said in the classroom,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_13","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_13","text":"this test is intended to assist with fostering harmony between the members of NERV and the Nikkes who will be assigned to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_14","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_14","text":"Although the Raptures you will be doing battle with are virtual,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_15","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_15","text":"their behavior will be indistinguishable from their real-life counterparts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_16","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_16","text":"Depending on where you are hit,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_17","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_17","text":"you will be marked either as injured or dead and will not be able to continue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_18","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_18","text":"Therefore, you must treat this simulation as if it were a real fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_19","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_06_s_19","text":"Did everyone get that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce004_04_op_r"],"affinity":null},{"id":"event_ce004_1_06_s_20","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_06_s_20","text":"Don't take this lightly, but don't psyche yourselves out either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_21","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_06_s_21","text":"Understood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_22","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_06_s_22","text":"Quit badgering us, Mistato.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_23","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_06_s_23","text":"I've gone up against the real deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_24","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_ce004_1_06_s_24","text":"Do you really think a simulation is gonna have me quaking in my boots?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_25","type":"Speech","speaker":"ce004_04","key":"Locale_SubScenario:event_ce004_1_06_s_25","text":"All right, all right. I trust you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_26","type":"Speech","speaker":"ein","key":"Locale_SubScenario:event_ce004_1_06_s_26","text":"We're always doing tests like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_27","type":"Speech","speaker":"ein","key":"Locale_SubScenario:event_ce004_1_06_s_27","text":"I doubt anything will happen, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_28","type":"Speech","speaker":"rei","key":"Locale_SubScenario:event_ce004_1_06_s_28","text":"Yeah, we'll be fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_29","type":"Speech","speaker":"rei","key":"Locale_SubScenario:event_ce004_1_06_s_29","text":"It's just another test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_30","type":"Speech","speaker":"rei","key":"Locale_SubScenario:event_ce004_1_06_s_30","text":"Isn't that right, Naru?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_31","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_1_06_s_31","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_32","type":"Speech","speaker":"zwei","key":"Locale_SubScenario:event_ce004_1_06_s_32","text":"If I'm being honest, I don't think it's even really necessary for Teacher to be here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_33","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_33","text":"The Commander will be joining you once the mission starts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_34","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_34","text":"It was determined that it would be beneficial for him to get a feel of what to expect out on the field.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_35","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_35","text":"Now, no matter how we do this, there's no getting around that this won't be quite the same as conducting exercises up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_36","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_36","text":"However, the main goal of this is to get everyone working as a team,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_37","type":"Speech","speaker":"marciana","key":"Locale_SubScenario:event_ce004_1_06_s_37","text":"so do your best not to intervene and stay out of the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce004_1_06_s_38","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce004_1_06_s_38","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,