{"id":"d_counseling_hongryeon_18","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 18","stage":null,"prev":"d_counseling_hongryeon_17","next":"d_counseling_hongryeon_19","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_18_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_1","text":"Many lives are at play in the realm of agriculture.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_18_2","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_2","text":"I smite the pests that afflict my crops. I drive out or slay the beasts that roam my fields.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_3","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_3","text":"There are those to whom farming is but a puritanical pursuit, one which the stench of death does not penetrate. They are mistaken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_4","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_4","text":"Tell me, my good fellow,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_5","text":"What says ye about achieving something from the sacrifice of something else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_18_6","text":"There must be another way.","jump":"d_counseling_hongryeon_18_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_18_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_18_7","text":"Sacrifice is inevitable.","jump":"d_counseling_hongryeon_18_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_18_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_8","text":"Aye, should I be thee, I would feel the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_9","text":"But I myself believe nothing can be accomplished without sacrifice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_10","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_10","text":"I hope that one day ye shall come to this realization as well.","jump":"d_counseling_hongryeon_18_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_11","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_11","text":"It is truly so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_12","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_12","text":"Aye, I feel the same as thee, but","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_13","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_18_13","text":"it is not an answer that warms the cockles of mine heart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_18_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_18_14","text":"Scarlet teaches me about various farming methods.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}