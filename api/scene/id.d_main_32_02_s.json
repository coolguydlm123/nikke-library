{"id":"d_main_32_02_s","cat":"main","group":{"id":"ch32","label":"Chapter 32 · Advance"},"label":"Apology and Forgiveness: A","stage":"32-6 STAGE · Start","prev":"d_main_32_01","next":"d_main_32_02_e","speakers":{"neon":"Neon","anis":"Anis","vesti":"Vesti","eunhwa":"Eunhwa","emma":"Emma","rapi":"Rapi","grave":"Grave"},"icons":{"neon":"si_c011_00_s","anis":"si_c012_00_s","vesti":"si_c091_00_s","eunhwa":"si_c092_00_s","emma":"si_c090_00_s","rapi":"si_c010_00_s","grave":"si_c510_00_s"},"lines":[{"id":"d_main_32_02_s_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_1","text":"Our goal is to retrieve Cinderella's specialized weapon,","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":"bgm_chapter32_field_advance","movie":null,"shown":["grave","rapi","neon","anis","eunhwa","emma","vesti"],"affinity":null},{"id":"d_main_32_02_s_2","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_2","text":"Glass Slippers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_3","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_3","text":"If at all possible, we also want to reawaken Cinderella herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_4","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_4","text":"Does that make sense to everyone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_32_02_s_5","text":"Yep! It's all clear to me this time around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_02_s_6","text":"Well, gooood for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_7","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_02_s_7","text":"Eunhwa, the mission parameters have changed. Will that be okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_8","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_8","text":"The final say on any decisions made on the field rests with the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_9","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_9","text":"Therefore, there is no issue with any of this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_10","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_10","text":"I can't say I'm entirely comfortable with it though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_11","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_11","text":"It's awfully risky to awaken someone whom you're not even entirely sure is a Heretic or not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_12","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_12","text":"I know Grave insists that she's free from corruption, but there's no way we can be sure of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_13","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_13","text":"That's correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_14","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_14","text":"But look at Modernia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_15","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_15","text":"There have been instances where someone has become a Heretic, and then come back. It's not unheard of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_16","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_16","text":"Also,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_17","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_17","text":"regardless of what her current situation is, if we can bring Cinderella over to our side,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_18","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_18","text":"it would be an incredible boon for the scientific community in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_19","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_19","text":"It'd be a big step towards reclaiming the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_20","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_20","text":"That's true. We don't get many chances to encounter a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_21","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_21","text":"Still, I have to make it clear how risky this venture is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_22","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_22","text":"The safest course of action would be to destroy the coffin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_23","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_02_s_23","text":"The Commander doesn't want to do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_24","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_24","text":"Yes, I know. But as Eunhwa said, his word is final when we're here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_25","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_25","text":"His judgment may seem counterintuitive at times,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_26","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_26","text":"but he's always managed to get results.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_27","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_27","text":"All we can do is hope that he's on the mark this time around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_02_s_28","text":"Sounds like you're starting to get the hots for him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_29","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_29","text":"Do you ever shut off that motormouth of yours?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_02_s_30","text":"I'd suggest against falling for him. It's tough enough as is with all the competition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_31","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_02_s_31","text":"Hmph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_32","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_02_s_32","text":"Hehe, that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_33","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_02_s_33","text":"R-right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_32_02_s_34","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_36","text":"Are you okay, Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_37","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_37","text":"Hmm? What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_38","text":"You seem to","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_39","text":"have something on your mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_40","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_40","text":"I was just thinking about Behemoth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_41","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_41","text":"Her defensive capabilities are unlike anything we've seen, and those clamps are a formidable weapon. In addition, since she is a Heretic, we cannot discount the possibility of her being able to transform.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_42","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_42","text":"We need to steal Glass Slippers from such a monster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_43","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_43","text":"I was thinking about ways in which we can pull this off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_44","text":"... Glad to have you back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_45","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_45","text":"I'm putting my trust in you. In your judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_46","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_46","text":"And in Grave as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_47","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_02_s_47","text":"... Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_48","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_48","text":"Don't mention it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_49","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_02_s_49","text":"Don't think I forgot that kick you gave me, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_50","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_50","text":"... Sorry about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_51","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_02_s_51","text":"Apology accepted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_52","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_02_s_52","text":"Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_02_s_53","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_02_s_53","text":"I can't make heads or tails of whether you two get along or not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}