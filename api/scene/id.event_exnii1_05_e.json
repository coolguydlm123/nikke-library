vent_exnii1_05_e_6","type":"Speech","speaker":"anis","key":"Locale_SubScenario:event_exnii1_05_e_6","text":"But you're a different person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_7","type":"Speech","speaker":"ce005_01","key":"Locale_SubScenario:event_exnii1_05_e_7","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_8","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_8","text":"Well, who cares? Everyone has their own story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_9","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_9","text":"Speaking of which, Rei, I saw you looking at my fish tank earlier...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_10","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_10","text":"Do you like fish?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_11","type":"Speech","speaker":"ce005_01","key":"Locale_SubScenario:event_exnii1_05_e_11","text":"Yes. They're very pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_12","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_12","text":"Then... would you like to learn how to fish? You might catch an even prettier one!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_13","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_13","text":"I have a set for work, though it's not really for fishing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_14","type":"Speech","speaker":"ce005_01","key":"Locale_SubScenario:event_exnii1_05_e_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_15","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_15","text":"Oh, looks like I struck a chord! Let's go to that fishing spot I found earlier! It's gonna be fun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ce005_01_01"],"affinity":null},{"id":"event_exnii1_05_e_16","type":"Speech","speaker":"ce005_01","key":"Locale_SubScenario:event_exnii1_05_e_16","text":"Really?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_17","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_17","text":"Catching fish is fun, but it's the fishing itself I truly enjoy. The thrill of waiting quietly in a peaceful spot for a big catch...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_18","type":"Speech","speaker":"mast","key":"Locale_SubScenario:event_exnii1_05_e_18","text":"I will teach you fishing 101!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_19","type":"Speech","speaker":"ce005_01","key":"Locale_SubScenario:event_exnii1_05_e_19","text":"Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_20","type":"Speech","speaker":"ce005_03","key":"Locale_SubScenario:event_exnii1_05_e_20","text":"Fishing...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_21","type":"Speech","speaker":"ce005_03","key":"Locale_SubScenario:event_exnii1_05_e_21","text":"If this peace could last...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_22","type":"Speech","speaker":"ce005_03","key":"Locale_SubScenario:event_exnii1_05_e_22","text":"Of course, there would be no more fighting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_23","type":"Speech","speaker":"ce005_03","key":"Locale_SubScenario:event_exnii1_05_e_23","text":"And no one would get hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_24","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_exnii1_05_e_24","text":"Then let's do our best together!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_25","type":"Speech","speaker":"ce005_03","key":"Locale_SubScenario:event_exnii1_05_e_25","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_26","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_exnii1_05_e_26","text":"Even if it's hard to prevent anyone from getting hurt,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_27","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_exnii1_05_e_27","text":"we can still do our best to heal them. What do you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_28","type":"Speech","speaker":"ce005_03","key":"Locale_SubScenario:event_exnii1_05_e_28","text":"Of course! I'll gladly help whenever you need me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_29","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_exnii1_05_e_29","text":"Hehehe... It makes me happy just hearing you say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_30","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_exnii1_05_e_30","text":"It's reassuring to have a doctor who's ready to help!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_31","type":"Speech","speaker":"pepper","key":"Locale_SubScenario:event_exnii1_05_e_31","text":"Thank you, Sakura.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_32","type":"Speech","speaker":"ce005_03","key":"Locale_SubScenario:event_exnii1_05_e_32","text":"Don't mention it. I'm grateful for your concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi","ce005_02"],"affinity":null},{"id":"event_exnii1_05_e_33","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_exnii1_05_e_33","text":"Everyone's so carefree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_34","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:event_exnii1_05_e_34","text":"Are you worried about the mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["pepper"],"affinity":null},{"id":"event_exnii1_05_e_35","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_exnii1_05_e_35","text":"It's not that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_36","type":"Speech","speaker":"ce004_01","key":"Locale_SubScenario:event_exnii1_05_e_36","text":"I'll be in my room. Let me know when you're ready to go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_37","type":"Self","speaker":null,"key":"Locale_SubScenario:event_exnii1_05_e_37","text":"Helm, what's wrong?","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["helm"],"affinity":null},{"id":"event_exnii1_05_e_38","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii1_05_e_38","text":"You're here, Subordinate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_39","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii1_05_e_39","text":"Mighty Tools has arrived at the Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_40","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii1_05_e_40","text":"They're checking the ship and remodeling the rooms as Asuka requested.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_41","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii1_05_e_41","text":"This is the room they're remodeling. Want to take a look?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_42","type":"Self","speaker":null,"key":"Locale_SubScenario:event_exnii1_05_e_42","text":"They even remodeled the clinic. Pepper will be happy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_43","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii1_05_e_43","text":"Yeah. The new clinic will have a new steam therapy device that Pepper prepared. I tried it, and it's amazing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_44","type":"Self","speaker":null,"key":"Locale_SubScenario:event_exnii1_05_e_44","text":"Then what I saw in your room earlier...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_45","type":"Self","speaker":null,"key":"Locale_SubScenario:event_exnii1_05_e_45","text":"I mistook the steam for smoke and thought there was a fire...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_exnii1_05_e_46","type":"Speech","speaker":"helm","key":"Locale_SubScenario:event_exnii1_05_e_46","text":"Th-that's because my room doesn't have a vent!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ex