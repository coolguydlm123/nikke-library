{"id":"d_counseling_bready_09","cat":"counsel","group":{"id":"char5135","label":"Bready"},"label":"Advising Bready: 09","stage":null,"prev":"d_counseling_bready_08","next":"d_counseling_bready_10","speakers":{"bready":"Bready"},"icons":{"bready":"si_c520_00_s"},"lines":[{"id":"d_counseling_bready_09_1","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_1","text":"Bonne Bouche, what do you think is the most important aspect of the dining experience?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["bready"],"affinity":"_0"},{"id":"d_counseling_bready_09_2","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_2","text":"The appearance of the food, or the taste?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_09_3","text":"It's like they say: food that looks good, also tastes good.","jump":"d_counseling_bready_09_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_bready_09_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_bready_09_4","text":"For me, the best thing is the act of eating itself.","jump":"d_counseling_bready_09_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_bready_09_5","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_5","text":"I suppose there may be something to that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_6","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_6","text":"but sometimes, sumptuous-looking food can end up tasting awful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_7","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_7","text":"When that happens, you can tell no heart was put into the making of it, and that ruins the entire experience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_8","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_8","text":"Of course, if the meal is like you, appetizing both visually and in terms of flavor, that's perfection.","jump":"d_counseling_bready_09_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_9","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_9","text":"You have the mindset of a true gourmet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_10","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_10","text":"They say you should taste food once with your eyes, once with your nose, and once again with your mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_11","type":"Speech","speaker":"bready","key":"Locale_Counseling:d_counseling_bready_09_11","text":"All your senses come together to create the full dining experience.","jump":"d_counseling_bready_09_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_bready_09_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_bready_09_12","text":"Bready and I talk about what we value when eating food.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}