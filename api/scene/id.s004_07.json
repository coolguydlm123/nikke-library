{"id":"s004_07","cat":"side","group":{"id":"side4","label":"EDEN SPEAR"},"label":"EDEN SPEAR: 7","stage":null,"prev":"s004_06","next":"s004_08","speakers":{"johan":"Johan","nayuta_n":"Nayuta","cecil_op_l":"Cecil"},"icons":{"johan":"si_c925_00_s","nayuta_n":"si_c9008_00_s","cecil_op_l":"si_c929_00_s"},"lines":[{"id":"s004_07_1","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_1","text":"This is the air purification facility.","jump":null,"exit":false,"enter":null,"bg":"Laboratory","bgArt":"laboratory","image":null,"bgm":"bgm_chapter40_field_turningpoint","movie":null,"shown":["johan","nayuta_n"],"affinity":null},{"id":"s004_07_2","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_2","text":"Ah, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_3","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_4","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_5","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_6","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_6","text":"Wilt thou not deign to impart further explanation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_7","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_7","text":"Of its principles, or the manner of its coming to be, such things I mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_8","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_8","text":"Don't you know that already?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_9","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_9","text":"I know not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_10","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_10","text":"Mine scant knowledge extendeth solely to certain antiquated technologies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_11","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_11","text":"The newer technology of the Ark is to me naught but a mystery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_12","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_12","text":"Ark's tech? This is Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_13","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_13","text":"Surely, Eden's technology is founded upon that of the Ark as well, is it not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_14","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_15","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_15","text":"Ah, alas. It seemeth I have misspoken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_16","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_16","text":"Long live the unique technology of Eden! Huzzah, huzzah, huzzah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_17","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_17","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_18","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_18","text":"Dost thou still harbor no intent to be on good terms with the Forerunner maidens?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_19","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_19","text":"Don't get it twisted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_20","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_20","text":"We did not reject the Pioneers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_21","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_21","text":"They are the ones who rejected us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_22","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_22","text":"Oh? It seems thou dost not harbor enmity toward them after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_23","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_23","text":"Each time I beheld thee growling at one another, this humble one did take thee for mortal foes, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_24","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_24","text":"I don't hate them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_25","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_25","text":"It's closer to respect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_26","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_26","text":"Ah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_27","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_27","text":"For all that time, they wandered the surface with a single goal in mind: catching the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_28","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_28","text":"They scoured all places she might be, confirming it with their own eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_29","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_29","text":"In the end, they discovered the Queen wasn't on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_30","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_30","text":"Indeed. By their grace was I granted the boon to elevate mine eyes unto the heavens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_31","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_31","text":"There's no way I could think poorly of such nobility.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_32","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_32","text":"Then, should I succeed in persuading the Forerunner maidens to come hither,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_33","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_33","text":"wilt thou extend unto them thy warmest welcome?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_34","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_34","text":"I see no reason not to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_35","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_35","text":"But every attempt so far has failed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_36","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_36","text":"Our methods differ too greatly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_37","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_37","text":"We don't fight for humanity or the Ark, but rather, we exist only to hunt the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_38","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_38","text":"They still fight for humanity even after being abandoned by humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_39","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_39","text":"When the Queen and humanity are weighed against each other, we choose the Queen, while they choose humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_40","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_40","text":"Eden would not so far debase herself as to employ humanity in pursuit of the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_41","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_41","text":"Right. I've no regrets for our methods, and that will never change.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_42","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_42","text":"But the Pioneers are different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_43","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_43","text":"That's why we can't work together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_44","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_44","text":"Alas. Methinks it is naught but a contest of pride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_45","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_45","text":"Which side are you on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_46","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_47","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_47","text":"Are you as noble as they are or pragmatic as we are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_48","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_49","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_49","text":"How amusing. To think you can actually keep your mouth shut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_50","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_50","text":"Forget it. This conversation ends here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_51","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_51","text":"Now where is the Queen's current location?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_52","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_52","text":"The data must needs be refreshed, but from the light reflections hitherto observed, she shall anon traverse above Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_53","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_53","text":"Any chance she'll descend?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_54","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_54","text":"Naught, as ever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_55","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_55","text":"How fares the observation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_56","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_56","text":"Still the same. Something's blocking her, so we can't get a visual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_57","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_58","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_58","text":"Pray tell, what might that be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_59","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_59","text":"We're not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_60","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_60","text":"We can only speculate that it's some kind of liquid metal that spreads across 120 kilometers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_61","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_61","text":"... Liquid metal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_62","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_63","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_63","text":"... Could it be...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_64","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_64","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_65","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_65","text":"'Tis naught. I shall speak of mine thoughts once they have taken proper form.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_66","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_66","text":"At present, they are scarcely coherent, and I am loath to utter them aloud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_67","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_67","text":"Still untrustworthy, as always.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_68","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_68","text":"Young Hero Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s004_07_69","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_69","text":"Since this rare moment finds us alone, I am minded to pose a question of import to thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_70","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_70","text":"What now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_71","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_71","text":"Pray tell, why dost thou harbor such disdain for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_72","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_72","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_73","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_73","text":"... Art thou...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_chapter36_field_deals","movie":null,"shown":null,"affinity":null},{"id":"s004_07_74","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_74","text":"afeared of me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_75","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_75","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_76","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_76","text":"You scatter countless copies of yourself across the surface, risking death to gather every scrap of intel, and then merge it all together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_77","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_77","text":"There's no way I wouldn't find such an act utterly terrifying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_78","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_78","text":"Verily, I risk death itself to gather intel, and yet thou show'st not so much as a token of praise. Most unwarranted, truly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_79","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_79","text":"Who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_80","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_81","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_81","text":"Are you the Nayuta I've met before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_82","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_82","text":"or one I've never encountered?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_83","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_83","text":"If the latter, which number are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_84","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_84","text":"So who are you exactly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_85","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_86","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_07_86","text":"This humble one is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_07_87","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_07_87","text":"Both of you. Hurry back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_l"],"affinity":null},{"id":"s004_07_88","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_07_88","text":"... Looks like she's awake.","jump