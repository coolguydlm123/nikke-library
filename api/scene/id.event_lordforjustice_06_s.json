ost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_79","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_79","text":"Unanimity isn't always mandatory for us to make decisions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_80","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_80","text":"Sometimes majority votes are sufficient. A single person can even push a resolution through, albeit at a great political risk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_81","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_81","text":"And to that end, I must admit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_82","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_82","text":"This was a decision that I made on my own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_83","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_83","text":"But as you can see, it failed miserably, so I will have to lay low for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_84","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_84","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_85","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_85","text":"I know what you're thinking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_86","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_86","text":"\"Why is he confessing all of this to me?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_87","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_87","text":"The moment doubt rears its ugly head, it's already over, and it's simply a matter of time until the truth is uncovered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_88","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_88","text":"... Like with K.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_89","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_89","text":"What do you possibly have to gain","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_90","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_90","text":"by roping me in with the Judges?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_91","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_91","text":"A formidable successor whom I can entrust the future to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_92","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_92","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_93","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_93","text":"Have you not been listening to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_94","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_94","text":"I don't have much time left, but the Ark is still in dire need of justice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_95","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_95","text":"I must impart my knowledge to a successor while I still can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_96","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_96","text":"However, in attempting to do so, I have been dealt a fatal blow. What a disaster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_97","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_97","text":"You say that, but you seem quite happy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_98","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_98","text":"Of course I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_99","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_99","text":"My successor has grown up splendidly, without me having to teach him anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_100","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_101","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_101","text":"While we're on the subject, you should consider having a child at some point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_102","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_102","text":"After retirement, doting on grandchildren is all we old folks have left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_103","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_103","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_104","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_104","text":"There I go again, saying too much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_105","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_105","text":"These kinds of things happen when you get old. I hope you understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_106","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_106","text":"We admire young folks and feel proud of them,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_107","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_107","text":"but we also envy them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_108","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_108","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_109","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_109","text":"So don't test my patience too much, {AccountData.NickName}.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_110","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_110","text":"I can't keep this position empty forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_111","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_111","text":"Oh, and one more thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_112","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_112","text":"I have a gift for you. Think of it as a tribute to the victor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_113","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lordforjustice_06_s_113","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_114","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_114","text":"I leave K's fate in your hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_115","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_115","text":"Kill her, erase her memory, make her a slave, ignore her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lordforjustice_06_s_116","type":"Speech","speaker":"soundonly_x","key":"Locale_SubScenario:event_lordforjustice_06_s_116","text":"The choice is entirely up to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i