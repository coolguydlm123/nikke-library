r":"princess","key":"Locale_MainScenario:d_main_43_03_42","text":"If I'd known it would come to this, I wouldn't have chosen to be a human this time...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_03_43","text":"Princess reaches out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_03_44","text":"Children in ragged clothes rush out from beyond the alley.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_45","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_03_45","text":"Hey, beggar princess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_stormbreakers","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_46","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_03_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_47","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_03_47","text":"What're you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_48","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_03_48","text":"You kids again? Scram.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_49","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_03_49","text":"I wouldn't deign to speak with someone beneath me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_50","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_03_50","text":"You ain't diggin' through the trash, are ya?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_51","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_03_51","text":"I said get out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_52","type":"Speech","speaker":"freerat","key":"Locale_MainScenario:d_main_43_03_52","text":"Why are you doing that? You so hungry that you'd even eat scraps?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_53","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_03_53","text":"I warned you before. Show me disrespect again, and I'll make you regret it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_54","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_03_54","text":"*Whoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_55","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_03_55","text":"*Splat*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_03_56","text":"A piece of bread drenched in