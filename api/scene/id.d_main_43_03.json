,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_7","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_7","text":"I just suddenly got curious about how she's doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_8","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_9","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_10","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_10","text":"She's dead, isn't she?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_11","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_11","text":"No, she's alive,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_12","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_12","text":"but probably not for long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_13","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_13","text":"Does she act like that outside too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_14","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_14","text":"Mm-hmm. That temper of hers isn't going anywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_15","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_15","text":"I take it the priestess who came by before never came back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_16","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_16","text":"She never did. After all that big talk...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_17","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_17","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_18","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_18","text":"... Hey, Third.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_19","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_19","text":"Just putting this out there, but don't go getting any bright ideas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_20","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_20","text":"You know better than anyone what a piece of work that girl is. It's a miracle she hasn't already died on the streets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_21","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_21","text":"Involving yourself with her won't get you anything. You'll be lucky if you don't end up paying for it instead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_22","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_22","text":"It's like I told you time and time again: everything comes with a price.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_23","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_23","text":"Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_24","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_24","text":"That's not true, and you know it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_25","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_25","text":"Oh? Are you doubting me now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_26","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_26","text":"Even after the money the priestess gave you ran out, you still looked after Princess for another month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_27","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_28","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_28","text":"That's why I like you, Big Madam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_29","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_29","text":"... Hmph.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_30","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_30","text":"Word is she's often spotted behind Marcus's place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_31","type":"Speech","speaker":"bigmadam","key":"Locale_MainScenario:d_main_43_03_31","text":"There's always plenty of leftovers there, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_32","type":"Speech","speaker":"stall3rd","key":"Locale_MainScenario:d_main_43_03_32","text":"Got it. Thank you, Big Madam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_43_03_33","type":"Speech","speaker":"princess","key":"Locale_MainScenario:d_main_43_03_33","text":"...","jump":null,"exit":false,"enter":null,"bg":"Backstreet","bgArt":"backstreet","image":null,"bgm":"bgm_story_empathize","movie":null,"shown":["princess"],"affinity":null},{"id":"d_main_43_03_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_43_03_34","text":"Princess stands in front of the trash can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"mo