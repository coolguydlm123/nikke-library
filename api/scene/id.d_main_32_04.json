Locale_MainScenario:d_main_32_04_34","text":"Umm, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_04_35","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_36","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_04_36","text":"When are you going to apologize to Eunhwa?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_37","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_32_04_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_38","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_04_38","text":"Vesti! Where are your manners?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_39","type":"Speech","speaker":"emma","key":"Locale_MainScenario:d_main_32_04_39","text":"Rapi needs some time, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_40","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_04_40","text":"I know that,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_41","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_04_41","text":"but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_42","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_04_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_43","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_04_43","text":"Go ahead, Vesti. Say what you want to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_44","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_04_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_45","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_32_04_45","text":"Vesti turns her head to the side","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_32_04_46","text":"and stares at Eunhwa, who is still off in the distance giving her lecture to Grave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_47","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_32_04_47","text":"Without taking her eyes off Eunhwa, Vesti begins to speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_48","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_04_48","text":"You know how Eunhwa is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_49","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_mai