{"id":"d_main_32_04","cat":"main","group":{"id":"ch32","label":"Chapter 32 · Advance"},"label":"Cessation","stage":"32-17 STAGE · Start","prev":"d_main_32_03","next":"d_main_32_05","speakers":{"eunhwa":"Eunhwa","grave":"Grave","anis":"Anis","vesti":"Vesti","emma":"Emma","rapi":"Rapi","neon":"Neon"},"icons":{"eunhwa":"si_c092_00_s","grave":"si_c510_00_s","anis":"si_c012_00_s","vesti":"si_c091_00_s","emma":"si_c090_00_s","rapi":"si_c010_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_32_04_1","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_1","text":"Before that, we need to do a quick inspection on ourselves.","jump":null,"exit":false,"enter":null,"bg":"CrystalCity","bgArt":"crystalcity","image":null,"bgm":"bgm_chapter32_field_advance_a","movie":null,"shown":["grave","eunhwa","anis","vesti"],"affinity":null},{"id":"d_main_32_04_2","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_2","text":"No, we need to hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_3","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_3","text":"You think we don't know that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_4","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_4","text":"We have no idea when we'll run into Behemoth. We need to be prepared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_5","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_5","text":"Preparation is not necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_6","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_6","text":"We will simply fight with every last ounce of strength we have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_7","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_7","text":"If you want to fight at full capacity, then prior preparation is key.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_8","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_8","text":"Fighting at full capacity simply means giving it your all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_9","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_9","text":"And I'm telling you that in order to do that, we need to prepare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_10","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_10","text":"We can do all of that without prior preparation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_11","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_11","text":"That's not \"giving it your all\". That's glorified suicide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_12","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_12","text":"It's not suicide at all. It's just giving it all you've got.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_13","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_14","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_04_14","text":"Hey, why are you shaking like that? Are you cold?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_15","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_15","text":"I feel foolish for humoring a moron who doesn't know the first thing about tactics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_04_16","text":"Yeah, that's really stupid of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_17","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_18","type":"Speech","speaker":"vesti","key":"Locale_MainScenario:d_main_32_04_18","text":"Wow, you're really shaking a bunch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_19","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_19","text":"Tactics are superfluous. Just give it your all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_20","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_20","text":"Why don't you sit down","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_21","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_21","text":"and let me teach you a few things about tactics?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_22","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_22","text":"No, we must hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_23","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_23","text":"Get over here and sit down, before I put you down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_24","type":"Speech","speaker":"grave","key":"Locale_MainScenario:d_main_32_04_24","text":"You've got a rotten attitude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_25","type":"Speech","speaker":"eunhwa","key":"Locale_MainScenario:d_main_32_04_25","text":"Get over here! Now!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_04_26","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_32_04_26","text":"Grave reluctantly approaches Eunhwa.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi","vesti","emma","neon"],"affinity":null},{"id":"d_main_32_04_27","type":"Self","speaker":null,"key":"Locale_MainScenario:d_ma