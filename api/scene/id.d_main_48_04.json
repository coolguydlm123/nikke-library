new it was fake, of course, but I still couldn't do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_04_80","type":"Speech","speaker":"janghwa","key":"Locale_MainScenario:d_main_48_04_80","text":"... I couldn't bring myself to attack you, because all of my memories are of me hurting you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_04_81","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_48_04_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_04_82","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_48_04_82","text":"Thou didst command me to wax stronger,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_04_83","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_48_04_83","text":"that I may never be controlled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_04_84","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_48_04_84","text":"I have lived long by that creed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_04_85","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_48_04_85","text":"and now know I am the master of mine own blade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_48_04_86","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_48_04_86","tex