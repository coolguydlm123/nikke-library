{"id":"d_main_20_01","cat":"main","group":{"id":"ch20","label":"Chapter 20 · Fire Dragon"},"label":"Proven Talent","stage":"20-1 STAGE · Start","prev":null,"next":"d_main_20_02","speakers":{"cecil_op_c":"Cecil","Self":"Commander","papillon":"Papillon","neon":"Neon","johan":"Johan","anis":"Anis","isabel":"Isabel","cecil":"Cecil","noah":"Noah","dorothy":"Dorothy"},"icons":{"cecil_op_c":"si_c929_00_s","papillon":"si_c890_00_s","neon":"si_c011_00_s","johan":"si_c925_00_s","anis":"si_c012_00_s","isabel":"si_c231_00_s","cecil":"si_c929_00_s","noah":"si_c232_00_s","dorothy":"si_c233_00_s"},"lines":[{"id":"d_main_20_01_1","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_1","text":"Initiating operation.","jump":null,"exit":false,"enter":null,"bg":"Desert_03","bgArt":"desert_03","image":null,"bgm":"bgm_volcanicnest_a","movie":null,"shown":["cecil_op_c","dorothy"],"affinity":null},{"id":"d_main_20_01_2","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_2","text":"The goal of this operation is to execute the Heretic known as Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_3","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_3","text":"Commencing Alva particle purification sequence to aid with scanning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_4","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_4","text":"53.58%... 28.77%...\n1.49%... purification complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_5","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_5","text":"Using scan data and past engagement experience to track the enemy's current position.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_6","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_6","text":"The expected coordinates have been sent to both commanders' terminals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_7","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_7","text":"She'll be taking to the skies and moving fast, so don't dally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_8","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_20_01_8","text":"Wait, this Heretic can fly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_9","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_9","text":"That's right. Nihilister's nomme de guerre is Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_10","type":"Speech","speaker":"cecil_op_c","key":"Locale_MainScenario:d_main_20_01_10","text":"When in flight, she resembles the creature of legend, and spouts scorching flames from her mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_11","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_20_01_11","text":"How on earth are we supposed to catch her then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["isabel","johan","noah","anis","neon","papillon","rapi"],"affinity":null},{"id":"d_main_20_01_12","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_20_01_12","text":"With anti-aircraft guns, maybe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_13","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_20_01_13","text":"What good will bullets do against a fire-breathing dragon...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_14","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_20_01_14","text":"I'm just a lieutenant, how can you expect me to catch that thing? I'll only end up being extra crispy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_15","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_20_01_15","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_16","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_20_01_16","text":"You could at least try not to look so pathetic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_17","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_20_01_17","text":"It'll be fine. We've been to hell and back and lived to tell the tale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_20_01_18","text":"Now that I think about it, you could say that my guns have been used in hell itself. Cool!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_19","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_20_01_19","text":"I'm afraid it won't be so easy this time around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_20","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_20_01_20","text":"What a sordid bunch...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_21","type":"Speech","speaker":"isabel","key":"Locale_MainScenario:d_main_20_01_21","text":"Are you going to be fine working with them, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_22","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_20_01_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_23","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_20_01_23","text":"What will you do, Johan?","jump":null,"exit":false,"enter":null,"bg":"EdenIndoor","bgArt":"edenindoor","image":null,"bgm":null,"movie":null,"shown":["cecil"],"affinity":null},{"id":"d_main_20_01_24","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_20_01_24","text":"As long as this ends with a Heretic on the ground, I don't care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_25","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_20_01_25","text":"Whether you choose to follow Dorothy's advice is up to you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_26","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_20_01_26","text":"so long as we achieve our goal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_27","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_20_01_27","text":"No.","jump":null,"exit":false,"enter":null,"bg":"Desert_03","bgArt":"desert_03","image":null,"bgm":null,"movie":null,"shown":["isabel","johan","noah","anis","neon","papillon","rapi","dorothy"],"affinity":null},{"id":"d_main_20_01_28","type":"Speech","speaker":"johan","key":"Locale_MainScenario:d_main_20_01_28","text":"We'll proceed like this is an individual operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_29","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_20_01_29","text":"Perfect, I won't have to do all the heavy lifting for those dimwits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_30","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_20_01_30","text":"Or I might end up as a shish kebab.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_31","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_20_01_31","text":"What are you going on about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_32","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_20_01_32","text":"None of you have ever gone up against Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_33","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_20_01_33","text":"Once we piss her off, this entire area will become scorched earth in seconds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_34","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_20_01_34","text":"If you just stand there with your fingers up your ass,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_35","type":"Speech","speaker":"noah","key":"Locale_MainScenario:d_main_20_01_35","text":"don't count on me coming to save you. Got it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_20_01_36","text":"Hey, don't think you're all that and a bag of chips just 'cause you went head-to-head with her a few times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_20_01_37","text":"If we'd had five previous encounters, we could fight with our eyes closed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_38","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_20_01_38","text":"... Are we going to be okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_39","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_20_01_39","text":"We'll be just fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_20_01_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_20_01_40","text":"They may not be the most cordial bunch, but everyone here is the best of the best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}