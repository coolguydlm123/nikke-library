{"id":"d_main_01af_03","cat":"main","group":{"id":"ch1","label":"Chapter 1 · Corruption"},"label":"Her Space","stage":null,"prev":"d_main_01af_02","next":"d_main_01af_04","speakers":{"ingrid":"Ingrid","anis":"Anis","rapi":"Rapi","Self":"Commander"},"icons":{"ingrid":"si_c900_00_s","anis":"si_c012_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_01af_03_1","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_03_1","text":"I'm Ingrid, your coach for today. Welcome to the Simulation Room.","jump":null,"exit":false,"enter":null,"bg":"SimulationRoom","bgArt":"simulationroom","image":null,"bgm":"bgm_story_fairytalesend_a","movie":null,"shown":["ingrid","rapi","anis"],"affinity":null},{"id":"d_main_01af_03_2","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_01af_03_2","text":"This is where I'll be putting your combat skills to the test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_03_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af_03_3","text":"... Commander, what is this all about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_03_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_03_4","text":"Having our combat skills tested after a mission? I've never heard of such a thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_03_5","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_01af_03_5","text":"They usually do this sort of thing beforehand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_01af_03_6","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_01af