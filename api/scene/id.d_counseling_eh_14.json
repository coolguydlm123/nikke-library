{"id":"d_counseling_eh_14","cat":"counsel","group":{"id":"char5166","label":"E.H."},"label":"Advising E.H.: 14","stage":null,"prev":"d_counseling_eh_13","next":"d_counseling_eh_15","speakers":{"eh_n":"E.H."},"icons":{"eh_n":"si_c113_00_s"},"lines":[{"id":"d_counseling_eh_14_1","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_14_1","text":"In the Outer Rim, we do whatever it takes to survive.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":"bgm_story_eh","movie":null,"shown":["eh_n"],"affinity":"_0"},{"id":"d_counseling_eh_14_2","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_14_2","text":"What do you think about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eh_14_3","text":"It's for survival. You don't have any other choice.","jump":"d_counseling_eh_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_eh_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eh_14_4","text":"Still, you shouldn't abandon your humanity.","jump":"d_counseling_eh_14_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eh_14_5","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_14_5","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eh_14_6","type":"Speech","speaker":"eh_n","key":"Locale_Counseling:d_counseling_eh_14_6","text":"When you're born into an environment like this, it's hard to tell right from wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":nu