{"id":"d_counseling_hongryeon_14","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 14","stage":null,"prev":"d_counseling_hongryeon_13","next":"d_counseling_hongryeon_15","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_14_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_1","text":"I must say, the weather up on the surface has been most inclement.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_14_2","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_2","text":"What say ye to imbibing the spirits on a rainy day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_14_3","text":"I think it's perfectly acceptable to drink on a rainy day.","jump":"d_counseling_hongryeon_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_14_4","text":"I personally think it's better to drink on a sunny day.","jump":"d_counseling_hongryeon_14_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_14_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_5","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_14_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_6","text":"Indeed, to enjoy the bottle amidst the rainfall is an experience like no other. Poetic, emotional...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_14_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_7","text":"However, as mine eyes shan't chance upon the light of the moon, I do not prefer it.","jump":"d_counseling_hongryeon_14_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_14_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_8","text":"It is as I thought. You and I are peas in a pod, my good fellow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_14_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_9","text":"To drink on a clear day is ideal, as only then can one capture the moonlight in one's glass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_14_10","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_14_10","text":"The moonlight and a gentle breeze are perfect bedfellows for a fine glass of spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_14_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_14_11","text":"Scarlet and I talk about what we think is the perfect drinking weather.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}