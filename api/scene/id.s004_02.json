{"id":"s004_02","cat":"side","group":{"id":"side4","label":"EDEN SPEAR"},"label":"EDEN SPEAR: 2","stage":null,"prev":"s004_01","next":"s004_03","speakers":{"johan":"Johan","harran":"Harran","papillon":"Papillon","cecil_op_l":"Cecil"},"icons":{"johan":"si_c925_00_s","harran":"si_c230_00_s","papillon":"si_c890_00_s","cecil_op_l":"si_c929_00_s"},"lines":[{"id":"s004_02_1","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"bgm_chapter40_field_turningpoint","movie":null,"shown":["johan","harran","papillon"],"affinity":null},{"id":"s004_02_2","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_2","text":"Johan, what are you so lost in thought about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_3","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_3","text":"It's about Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_4","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_4","text":"Go on, tell me. What's on your mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_5","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_5","text":"She's a real headache.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_6","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_6","text":"You know very well I'm not asking for a pithy response like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_7","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_7","text":"As a Commander, what do you intend to do about Dorothy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_8","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_8","text":"Members of Inherit act on their own judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_9","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_9","text":"The moment this matter is brought up for debate, that principle will fall apart.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_10","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_10","text":"We may act on our own judgment, but only under one condition:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_11","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_11","text":"the existence of Eden must not be revealed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_12","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_12","text":"Do you not think that, because of Dorothy, the Ark might catch wind of Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_13","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_13","text":"The Ark can't possibly be unaware of Eden. You know that as well as I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_14","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_14","text":"But more will come to know, you see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_15","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_15","text":"Among them, some will surely view Eden with disdain or try to crush us by sheer force.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_16","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_16","text":"Naturally, I'm well aware they're no match for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_17","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_17","text":"Yet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_18","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_18","text":"it could still become quite the nuisance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_19","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_19","text":"You're forcing my hand, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_20","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_20","text":"Noah, Isabel, even Cecil. They all seem to be taking this too lightly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_21","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_21","text":"But you? You can't afford to be so careless, can you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_22","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_22","text":"Commander Johan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_23","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_24","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_24","text":"We wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_25","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_25","text":"You're soft.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_26","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_26","text":"Four days. If we get no contact or response from Dorothy in that time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_27","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_27","text":"she will be expelled from Inherit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_28","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_28","text":"I don't know what kind of impact that might have on Dorothy, but I suppose it's a fair decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_29","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_29","text":"Now then, what's the next move?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_30","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_30","text":"Should Dorothy turn against Eden after her expulsion...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_31","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_32","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_32","text":"We always stand by the same principle:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_33","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_33","text":"Eden shows no mercy to its enemies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_34","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_34","text":"Indeed. That is our principle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_35","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_35","text":"I trust that when the day comes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_36","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_36","text":"that soft heart beating beneath your steel exterior will not falter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_37","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s004_02_38","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_38","text":"There's something I've been curious about since I got here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_39","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_40","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_41","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_41","text":"What exactly is Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_42","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_42","text":"How much did you hear? Or rather, since when have you known?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_theruinedcity","movie":null,"shown":null,"affinity":null},{"id":"s004_02_43","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_43","text":"Starting from \"Johan, what are you so lost in thought about?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_44","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_44","text":"... Although we're holding you hostage, we don't treat you like one. We've been letting you roam free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_45","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_45","text":"But at this rate, we might have no choice but to change that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_46","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_46","text":"What, you afraid I'll go blabbing about what I overheard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_47","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_47","text":"Ha, please. Who would I even tell that to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_48","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_02_48","text":"Papillon holds up her phone to show the screen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_49","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_02_49","text":"The \"NO SIGNAL\" message keeps appearing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_50","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_50","text":"I don't have access to social media, games, Tetra TV, or anything! So tell me, who exactly am I supposed to talk to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_51","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_51","text":"All I can do here is stare out the window at the livestock pens and the greenhouse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_52","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_52","text":"And you aren't letting me roam around freely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_53","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_53","text":"The only place I can go unattended is the bathroom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_54","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_54","text":"I can't open any doors, not even the fridge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_55","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_55","text":"The little freedom you give me isn't out of kindness or pity. It's because you don't think I'm capable of anything, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_56","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_56","text":"You're selling yourself short.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_57","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_57","text":"... but I can't say you're wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_58","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_58","text":"Yeah, so just tell me already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_59","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_59","text":"Exactly what kind of place is Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_60","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_60","text":"Do you really think we'll divulge our secrets just to alleviate your boredom?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_61","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_61","text":"Admit it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_62","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_62","text":"You guys want me, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_63","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_64","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_65","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_65","text":"You wouldn't have brought up defecting just to tease me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_66","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_66","text":"I even passed that weird Eden trial and played my part in the fight with Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_67","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_67","text":"You guys are probably thinking, 'Hey, this chick's not half bad.'","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_68","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_68","text":"You're desperate for talent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_69","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_69","text":"You built Eden to fill it with allies who share your cause, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_70","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_70","text":"Otherwise, there's no way you'd make this place so huge. It's way too big for just six people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_71","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_71","text":"But wouldn't you know it, a skilled Nikke waltzed right into your Eden when you need her most.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_72","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_72","text":"So, you guys owe me a proper pitch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_73","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_73","text":"Maybe then I'll think about your offer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_74","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_74","text":"Haha, please. Weren't you a spy for Follower?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_75","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_75","text":"To think that we would want someone of your ilk is simply sheer arrogance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_76","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_76","text":"You know what spies are like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_77","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_77","text":"Betrayal and deceit are everyday things to them, so switching sides is no big deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_78","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_78","text":"... Well, most of the time it's because they don't really have a choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_79","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_79","text":"You have no hesitation whatsoever about selling yourself out, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_80","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_81","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_81","text":"So you say we desire you... Yeah, that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_82","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_82","text":"But we're hardly that desperate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_83","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_83","text":"Right, Johan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_84","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_84","text":"That's right. Right now, you need a place to settle down, regardless of the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_85","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_85","text":"If you return to the Ark now, you'll be treated as a spy sent by Eden, and here, you'll be seen as a spy working for the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_86","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_86","text":"Like you said, betrayal and deceit are everyday things for spies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_87","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_87","text":"You can go anywhere, but you truly belong nowhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_88","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_88","text":"The desperate one here is you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_89","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_89","text":"So no, we don't need to make a pitch for Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_90","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_90","text":"The one who needs to promote themselves is you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_91","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_92","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_92","text":"Prove that we can trust you. Prove that you desire Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_93","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_93","text":"Only then will we reveal what Eden truly is and why it exists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_94","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_94","text":"Hmm... this isn't going well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_95","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_95","text":"Heh. You've come a long way, Commander Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_96","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_96","text":"Your foolish stubbornness of blindly charging forward has vanished without a trace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_97","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_97","text":"Then at least let me open the fridge myself, will you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_98","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_98","text":"You're probably breaking some kind of prisoner law or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_99","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_99","text":"Fine, I'll make sure Cecil knows.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_100","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_100","text":"Johan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["cecil_op_l"],"affinity":null},{"id":"s004_02_101","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_101","text":"I'm listening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_102","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_102","text":"Things appear to be taking an unusual turn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_103","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_103","text":"I take it you mean the Ark. What's the matter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_104","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_104","text":"We've received intel confirming that Chatterbox and Indivilia have been resurrected inside the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_105","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_105","text":"... What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_106","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_106","text":"Oh my...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_107","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_107","text":"When?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_108","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_108","text":"That occurred roughly 10 hours ago. We've just received the intel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_109","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_109","text":"What about Nihilister?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_110","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_110","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_111","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_111","text":"Two Nikkes are said to have driven Nihilister, Indivilia, and Chatterbox out of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_112","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_112","text":"Two...? Laplace, I presume? Even she couldn't have done it alone...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_113","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_113","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_114","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_114","text":"Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_115","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_115","text":"You're half correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_116","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_116","text":"They say it was Dorothy and Rapi who drove them out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_117","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_117","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_118","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_118","text":"Good grief. All I'm hearing are things I don't understand, so I can't make sense of any of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_119","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_119","text":"Hush. Quiet now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_120","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_120","text":"The terrorist incident in Ark was swiftly suppressed, and recovery operations have already commenced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_121","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_121","text":"What's the extent of the damage to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_122","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_122","text":"Not sure. I wasn't particularly curious, so I didn't ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_123","type":"Speech","speaker":"papillon","key":"Locale_SideStory:s004_02_123","text":"... Yeesh, that's harsh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_124","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_124","text":"What are Dorothy and Rapi's coordinates?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_125","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_125","text":"I've secured the coordinates where the elevator was ejected. They likely aren't there anymore, but this should still prove useful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_126","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_126","text":"Transmitting them n—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_127","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_127","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_128","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_128","text":"Hmm...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_129","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_02_129","text":"*Vrrr*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_130","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_02_130","text":"Johan's phone vibrates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_131","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_02_131","text":"At the same time, Harran's phone vibrates too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_132","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_02_132","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_133","type":"Speech","speaker":"harran","key":"Locale_SideStory:s004_02_133","text":"... Looks like it's a message from Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_134","type":"Speech","speaker":"cecil_op_l","key":"Locale_SideStory:s004_02_134","text":"... Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_02_135","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_02_135","text":"Johan picks up the phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}