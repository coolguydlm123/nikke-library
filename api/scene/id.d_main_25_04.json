l,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_57","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_25_04_57","text":"What if we end up with a bigger problem on our hands as a result, one that we can no longer fix? What then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_58","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_25_04_58","text":"If we sit here twiddling our thumbs, it'll be too late! We have to strike first!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_59","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_25_04_59","text":"I-I have something in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_60","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_25_04_60","text":"If worst comes to worst, we do have a failsafe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_61","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_25_04_61","text":"I assume you're referring to what Enikk is preparing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_62","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_25_04_62","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_63","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_25_04_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_64","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_64","text":"For now, we'll do as Burningum suggests.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_65","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_25_04_65","text":"What right do you have to propose our next course of action?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_66","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_25_04_66","text":"You sat by and did nothing at the crucial moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_67","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_67","text":"Regardless of what the Pilgrim's true intentions are, we cannot allow mere hearsay and skepticism to scuttle the pact with Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_68","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_68","text":"If the pact goes through, the gains will far outweigh any potential losses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_69","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_69","text":"So let's sit back, prepare for the worst, and wait for her to make her move.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_70","type":"Speech","speaker":"andersen","