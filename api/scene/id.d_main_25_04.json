ull,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_77","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_77","text":"If that is the case, what could the Ark possibly do to stop her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_78","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_25_04_78","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_79","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_79","text":"Even supposing we somehow foil her plans,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_80","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_80","text":"can you stop the combined forces of Eden? Do you have the slightest idea how mighty their forces are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_81","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_81","text":"So what you're telling me is that you want to wage war against a group of people","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_82","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_82","text":"who not only have managed to survive and thrive on the surface but have also developed their own technology?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_04_83","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_25_04_