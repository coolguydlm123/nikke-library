{"id":"d_main_49_07","cat":"main","group":{"id":"ch49","label":"Chapter 49 · Final Battle"},"label":"Gathering Forces","stage":"49-33 STAGE · Start","prev":"d_main_49_06","next":"d_main_49_08_s","speakers":{"anis_i_w":"Anis","neon_v_w":"Neon","rapi_red":"Rapi","snowwhite_h":"Snow White","rapunzel_s":"Rapunzel","hongryeon_g":"Scarlet","enikk_op_l":"Enikk","burningum_op_r":"Burningum","laplace_p":"Laplace","maxwell_p":"Maxwell","drake_p":"Drake","black_op_c":"Ark Ranger Black","red_op_l":"Ark Ranger Red","blue_op_r":"Ark Ranger Blue","rapi_red_op_c":"Rapi","anis_i_w_op_r":"Anis","arkrangerblack":"Ark Ranger Black","red":"Ark Ranger Red","neon_v_w_op_l":"Neon","snowwhite_h_op_c":"Snow White","hongryeon_g_op_r":"Scarlet","rapunzel_s_op_l":"Rapunzel","blue":"Ark Ranger Blue"},"icons":{"anis_i_w":"si_c017_00_s","neon_v_w":"si_c018_00_s","rapi_red":"si_c016_00_s","snowwhite_h":"si_c471_00_s","rapunzel_s":"si_c473_00_s","hongryeon_g":"si_c472_00_s","enikk_op_l":"si_c904_00_s","burningum_op_r":"si_c914_00_s","laplace_p":"si_c103_00_s","maxwell_p":"si_c105_00_s","drake_p":"si_c104_00_s","black_op_c":"si_c570_00_s","red_op_l":"si_c571_00_s","blue_op_r":"si_c572_00_s","rapi_red_op_c":"si_c016_00_s","anis_i_w_op_r":"si_c017_00_s","arkrangerblack":"si_c570_00_s","red":"si_c571_00_s","neon_v_w_op_l":"si_c018_00_s","snowwhite_h_op_c":"si_c471_00_s","hongryeon_g_op_r":"si_c472_00_s","rapunzel_s_op_l":"si_c473_00_s","blue":"si_c572_00_s"},"lines":[{"id":"d_main_49_07_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_1","text":"... There it is!","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_49_02_3","bgArt":"eventscene_chap_49_02_3","image":null,"bgm":"bgm_chapter46_field_redlight_a","movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_2","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:d_main_49_07_2","text":"Yikes...! What is that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_3","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_49_07_3","text":"Is that a mountain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_4","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_49_07_4","text":"To be precise, it used to be a mountain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_5","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_49_07_5","text":"... That thing is insanely powerful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_6","type":"Speech","speaker":"rapunzel_s","key":"Locale_MainScenario:d_main_49_07_6","text":"Still, it missed. Thank goodness for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_7","type":"Speech","speaker":"hongryeon_g","key":"Locale_MainScenario:d_main_49_07_7","text":"... I daresay it shall not happen again.","jump":null,"exit":false,"enter":null,"bg":"land_d","bgArt":"land_d","image":null,"bgm":null,"movie":null,"shown":["anis_i_w","neon_v_w","rapi_red","rapunzel_s","hongryeon_g","snowwhite_h"],"affinity":null},{"id":"d_main_49_07_8","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_49_07_8","text":"Commander, our comms are back online. It looks like we're finally out of range of the signal jammer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_9","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_9","text":"Got it. Enikk!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_10","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_10","text":"You've arrived. We've been waiting for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_l"],"affinity":null},{"id":"d_main_49_07_11","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_11","text":"I'll start with the situation on the surface! The Queen has absorbed the Lift and transformed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_12","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_12","text":"We've managed to keep it at bay for now, but not for long!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_13","text":"Also, the Four Beasts are cutting off the Rapture wave in the middle! I'm heading to the Ark with the Pioneers!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_14","type":"Speech","speaker":"burningum_op_r","key":"Locale_MainScenario:d_main_49_07_14","text":"... What? The Goddesses are coming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["burningum_op_r"],"affinity":null},{"id":"d_main_49_07_15","type":"Speech","speaker":"burningum_op_r","key":"Locale_MainScenario:d_main_49_07_15","text":"Oh, right. Enikk, bring him up to speed on the situation in the Ark too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_16","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_16","text":"As the Queen approaches the Ark, the risk of the Ark's power source self-destructing is increasing rapidly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_17","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_17","text":"If we allow the Queen to come any closer, the Ark will self-destruct underground, resulting in total annihilation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_18","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_18","text":"The Queen is actively attacking the Ark with her ultra-long-range beam, closing in on us, and deploying Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_19","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_49_07_19","text":"Damn you, Queen...! She's doing everything she can...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_20","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_20","text":"As such, we intend to initiate the Ark's ascent the moment preparations are complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_21","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_21","text":"At the same time, we will begin the Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_22","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_22","text":"The ascent sequence involves raising an enormous lift to bring the entire Ark to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_23","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_23","text":"Once the sequence begins, the gate covering the Ark will open, and the Ark will begin to ascend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_24","type":"Speech","speaker":"anis_i_w","key":"Locale_MainScenario:d_main_49_07_24","text":"A gate...? I don't see anything like that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_25","type":"Speech","speaker":"neon_v_w","key":"Locale_MainScenario:d_main_49_07_25","text":"If it covers the entire Ark, it must be huge. But I don't see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_26","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_26","text":"It's currently disguised to blend in with its surroundings. I will highlight the gate's area for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_27","text":"In the distance, blue light shoots up like a wall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_28","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_28","text":"It's huge. Even at this distance, I can't take it all in at once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_29","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_49_07_29","text":"That's because the Ark is so large. The thought of lifting the entire thing at once feels almost unreal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_30","type":"Speech","speaker":"rapunzel_s","key":"Locale_MainScenario:d_main_49_07_30","text":"... So the Ark is down there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_31","type":"Speech","speaker":"hongryeon_g","key":"Locale_MainScenario:d_main_49_07_31","text":"... Presumably so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_32","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_49_07_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_33","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_33","text":"When the ascent sequence begins, there can be no obstructions above or near the gate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_34","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_34","text":"Please prevent any Rapture from entering the highlighted area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_35","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_35","text":"We're in the final stages of preparations for the Ark's ascent. The Ark will ascend as soon as they are complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_36","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_36","text":"Once the Ark has ascended, we will mobilize all its forces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_37","type":"Speech","speaker":"enikk_op_l","key":"Locale_MainScenario:d_main_49_07_37","text":"Then we will strike the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_39","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_39","text":"All right! We'll hit the Raptures from behind!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_49_07_40","text":"Let's go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_41","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_49_07_41","text":"Roger!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_42","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_49_07_42","text":"Encounter!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_43","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_43","text":"After we get off the black wave, we charge toward the mass of Raptures swarming across the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_44","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_49_07_44","text":"Maxwell! Charge!","jump":null,"exit":false,"enter":null,"bg":"OldArkGate","bgArt":"oldarkgate","image":null,"bgm":"bgm_story_chapter49_bloodrain","movie":null,"shown":["drake_p","laplace_p","maxwell_p"],"affinity":null},{"id":"d_main_49_07_45","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_45","text":"Already? Aren't you firing a little too recklessly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_46","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_49_07_46","text":"There's too many of them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_47","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_47","text":"... Tsk. Fair enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_48","text":"Maxwell takes up a position beside Laplace, who is charging, and opens fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_49","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_49","text":"*Bang, bang!* She fires her railgun, piercing through the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_50","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_50","text":"Argh, they just keep coming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_51","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_51","text":"Her previous attack took out a dozen Raptures, but the situation remains unchanged.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_52","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_52","text":"The sea of Raptures is so dense, the ground can barely be seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_53","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_53","text":"This is ridiculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_54","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_49_07_54","text":"Enough complaining, Maxwell! If you've got time to whine, then shoot!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_55","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_55","text":"Ugh! I am shooting!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_56","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_49_07_56","text":"Then fire two shots at a time!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_57","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_49_07_57","text":"Oh! Why didn't I think of that? You're a genius, Drake!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_58","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_49_07_58","text":"Hehehe. My way of thinking is on a whole other level from you heroes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_59","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_59","text":"It's different all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_60","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_60","text":"Drake, what's your power level at?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_61","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_49_07_61","text":"15%! I can last three days at this rate!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_62","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_62","text":"Charge up, you dummy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_63","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_49_07_63","text":"Fine. Cover me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_64","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_64","text":"Ahh... This is bad. We're doing whatever we can to stop them, but we need more backup.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_65","type":"Speech","speaker":"black_op_c","key":"Locale_MainScenario:d_main_49_07_65","text":"Ark... Nooovaaaa!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["black_op_c","red_op_l","blue_op_r"],"affinity":null},{"id":"d_main_49_07_66","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_66","text":"*Booooooom!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_67","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_67","text":"A massive beam of light sweeps past Matis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_68","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_68","text":"The swarm of Raptures disappears without a trace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_69","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_69","text":"Whoa...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_70","type":"Speech","speaker":"black_op_c","key":"Locale_MainScenario:d_main_49_07_70","text":"The area in front of Matis has been cleared. Let's use this chance to regroup!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_71","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_49_07_71","text":"Thanks. How are things over there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_72","type":"Speech","speaker":"red_op_l","key":"Locale_MainScenario:d_main_49_07_72","text":"We're getting absolutely pummeled. The Ark Buster is just too big.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_73","type":"Speech","speaker":"blue_op_r","key":"Locale_MainScenario:d_main_49_07_73","text":"Still, things aren't too bad. I don't know how long it'll last, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_74","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_74","text":"*Rumble*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_75","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_07_75","text":"The area that had been wiped clean by the Ark Buster is quickly overrun with Raptures again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_07_76","type":"Speech","speaker":"red_op_l","key":"Locale_MainScenario:d_main_49_07_76","text":"You've got to be kidding me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null