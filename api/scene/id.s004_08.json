null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_111","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_111","text":"Stay out of this, Monk. This is none of your business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_112","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_112","text":"Young Lady Cecil, wouldst thou be so kind as to tell Young Hero Johan who it was that saved the Fire Dragon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_113","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_08_113","text":"It was neither Johan nor me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_114","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_114","text":"And whom doth that leave remaining? Myself, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_115","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_115","text":"Striking a deal with a Heretic is absurd.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_116","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_116","text":"Pray, tell us, Young Lady Fire Dragon:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_117","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_117","text":"what is thy intent with Lilith's body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_118","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_118","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_119","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_119","text":"I daresay thou art curious about this, seeing as thou hast gone silent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_120","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_120","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_121","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_121","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_122","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_122","text":"I can't talk properly on an empty stomach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_123","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_123","text":"Well then, shall this humble one grant thee a taste of leaden bullets?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_124","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_124","text":"Okay, okay, I'm just kidding!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_125","type":"Speech","speaker":"nihilister","key":"Locale_SideStory