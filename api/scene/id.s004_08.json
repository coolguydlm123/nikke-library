{"id":"s004_08","cat":"side","group":{"id":"side4","label":"EDEN SPEAR"},"label":"EDEN SPEAR: 8","stage":null,"prev":"s004_07","next":"s004_09","speakers":{"nihilister":"Nihilister","johan":"Johan","cecil":"Cecil","nayuta_n":"Nayuta"},"icons":{"nihilister":"si_c261_00_s","johan":"si_c925_00_s","cecil":"si_c929_00_s","nayuta_n":"si_c9008_00_s"},"lines":[{"id":"s004_08_1","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_1","text":"Enjoying the show?","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_2","bgArt":"eventscene_side_04_01_2","image":null,"bgm":"bgm_chapter32_field_advance","movie":null,"shown":null,"affinity":null},{"id":"s004_08_2","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_2","text":"If you're done staring, piss off!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_3","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_3","text":"Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_4","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_4","text":"I have many questions for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_5","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_5","text":"Then ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_6","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_6","text":"Are you following the Queen's orders right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_7","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_7","text":"What is the Queen? Is it something you eat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_8","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_9","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_9","text":"What's keeping the Queen from coming down?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_10","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_10","text":"Maybe she doesn't want to. I wouldn't either if I were out in space.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_11","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_11","text":"Think about how fun it'd be floating around out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_12","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_13","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_13","text":"Hey, woman. Food.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_14","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_08_14","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_15","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_08_15","text":"Cecil moves the robotic arm and places more Rapture parts against Nihilister's mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_16","type":"Narration","speaker":null,"key":"Locale_SideStory:s004_08_16","text":"*Crunch*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_17","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_17","text":"Blech. Can't believe I'm eating such garbage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_18","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_18","text":"Bring me a proper meal next time, why don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_19","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_19","text":"Verily, thou dost dwell in most felicitous ease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_20","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_20","text":"Yes! I should've done this ages ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_21","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_21","text":"Knowest thou me not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_22","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_22","text":"You? Who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_23","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_23","text":"Once have I been struck by thy bolt of fire, Fire Dragon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_24","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_24","text":"Oh, really? I've burned so many people that I can't even keep track.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_25","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_25","text":"But you're still alive? Maybe I didn't roast you enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_26","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_26","text":"Wait just a sec, I'll burn you to a crisp in no time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_27","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_28","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_28","text":"Pray, answer our questions. Shouldst thou refuse, thou shalt forgo thy meal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_29","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_29","text":"Threatening me with food, are you? Pathetic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_30","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_30","text":"We received intel that Indivilia and Chatterbox were revived inside the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_31","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_31","text":"and that you played a huge part in it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_32","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_32","text":"Did you revive them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_33","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_33","text":"What's it to you?","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_3","bgArt":"eventscene_side_04_01_3","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_34","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_34","text":"I'll take it that means yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_35","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_35","text":"Yet thou wert betrayed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_36","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_36","text":"and nigh unto being devoured alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_37","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_38","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_38","text":"How pleasant to see that mouth, which never stopped spewing bravado, finally shut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_39","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_39","text":"The wounds hath been cut and crushed by some force. Marks of teeth were also discernible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_40","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_40","text":"Such is the manner of Indivilia and Chatterbox's usual assaults.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_41","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_41","text":"Doth mine reasoning hold true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_42","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_42","text":"I'm going to roast you alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_43","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_43","text":"I shall take that as a response in the affirmative and continue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_44","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_44","text":"Heretics verily seldom act in concert.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_45","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_45","text":"Yet thou wentest out of thy way to enter the Ark and revive Indivilia and Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_46","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_46","text":"Such deeds can scarce be without purpose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_47","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_47","text":"Methinks... thou soughtest comrades, didst thou not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_48","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_48","text":"Hey, shut up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"s004_08_49","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_49","text":"Permit me this inquiry: Hast any stirrings of camaraderie arisen within thee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_50","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_50","text":"Shut it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_theruinedcity","movie":null,"shown":null,"affinity":null},{"id":"s004_08_51","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_51","text":"Ah, how lamentable hath it become. A heart so pure, returned but as a meal, so it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_52","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_52","text":"Shut up! I said shut the hell up!","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_4","bgArt":"eventscene_side_04_01_4","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_53","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_08_53","text":"Stop thrashing. Your output is dropping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_54","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_08_54","text":"For the record, you're barely clinging to life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_55","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_08_55","text":"Act as if all your limbs are intact, and you'll die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_56","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_56","text":"Hrngh...! Hrngh...!","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_1","bgArt":"eventscene_side_04_01_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_57","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_57","text":"... Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_58","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_58","text":"What hath brought about this sudden need for companions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_59","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_59","text":"Bullshit! Why the hell would I need comrades?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_60","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_61","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_61","text":"It must be... to take down the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_62","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_63","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_63","text":"Ho! How remarkably bold this is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_64","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_64","text":"During our previous alliance with the Counters,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_65","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_65","text":"I remember the words you uttered while begging for your life after being hit by Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_66","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_66","text":"Lilith's body—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_67","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_67","text":"the Queen's original form and her last remaining tie to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_68","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_68","text":"You said that if you could find it, you'd kill the Queen yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_69","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_69","text":"You want to kill the Queen, and for that, you need comrades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_70","type":"Speech","speaker":"cecil","key":"Locale_SideStory:s004_08_70","text":"Isn't that a bit strange? If that was her goal, she would have made her move long ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_71","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_71","text":"... It is that she has found","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_72","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_72","text":"Lilith's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_73","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_73","text":"...","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_3","bgArt":"eventscene_side_04_01_3","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_74","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_74","text":"Right. I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_75","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_75","text":"That's why she needs comrades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_76","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_76","text":"... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_77","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_77","text":"Cecil, I'll take over from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_78","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_78","text":"Now, it's time to extract information from this Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_79","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_79","text":"Pray, how dost thou intend to accomplish this endeavor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_80","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_80","text":"What else? Interrogation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_81","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_81","text":"Yet, not torture?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_82","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_82","text":"Not much difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_83","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_83","text":"For a Heretic with no regenerative ability, this should be quite effective.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_84","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_84","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_85","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_85","text":"Haha...! Hahaha...!","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_4","bgArt":"eventscene_side_04_01_4","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_86","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_86","text":"Hahahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_87","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_87","text":"... Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_88","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_88","text":"Just kill me and get it over with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_89","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_89","text":"You think I'll ever tell you anything you wanna hear? You're wasting both of our time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_90","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_90","text":"Hmm. You clearly aren't used to pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_91","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_91","text":"Judging by how you spilled vital intel at the first sign of danger, your resolve is laughable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_92","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_92","text":"With your body unrecovered and trapped, I'm curious how long you'll last.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_93","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_93","text":"And most importantly, no one's coming to save you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_94","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_94","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_95","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_95","text":"Hey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_96","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_96","text":"Let's make a deal.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_04_01_2","bgArt":"eventscene_side_04_01_2","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_97","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_97","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_98","type":"Speech","speaker":"nayuta_n","key":"Locale_SideStory:s004_08_98","text":"Do speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_99","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_99","text":"Heal me just enough to walk,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_100","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_100","text":"and I'll personally","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_101","type":"Speech","speaker":"nihilister","key":"Locale_SideStory:s004_08_101","text":"take you to Lilith's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_102","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_102","text":"That's by far the most amusing thing I've heard from your mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s004_08_103","type":"Speech","speaker":"johan","key":"Locale_SideStory:s004_08_1