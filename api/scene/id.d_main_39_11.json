{"id":"d_main_39_11","cat":"main","group":{"id":"ch39","label":"Chapter 39 · Gene"},"label":"Harbinger","stage":"39-36 BOSS · Start","prev":"d_main_39_10","next":"d_main_39_af_01","speakers":{"rapi_red":"Rapi","laplace_p":"Laplace","drake_p":"Drake","maxwell_p":"Maxwell","nayuta_n":"Nayuta","ziz":"Ziz","leviathan":"Leviathan","raptilion":"Raptilion"},"icons":{"rapi_red":"si_c016_00_s","laplace_p":"si_c103_00_s","drake_p":"si_c104_00_s","maxwell_p":"si_c105_00_s","nayuta_n":"si_c9008_00_s","ziz":"si_c561_00_s","leviathan":"si_c562_00_s"},"lines":[{"id":"d_main_39_11_1","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_1","text":"All clear.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_chapter39_field_gliding","movie":null,"shown":["nayuta_n","rapi_red","maxwell_p","laplace_p","drake_p"],"affinity":null},{"id":"d_main_39_11_2","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_11_2","text":"Flawless victory!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_3","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_11_3","text":"That barely even qualified as a warm-up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_4","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_11_4","text":"Well? Satisfied with our performance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_5","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_5","text":"Were the Matis wrought solely from the Ark's own technology?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_6","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_11_6","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_7","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_7","text":"Would I be correct in assuming Matis doth employ the most advanced technology known, verily?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_8","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_11_8","text":"Of course! We're brand spankin' new!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_9","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_11_9","text":"Don't stare too long, or our brilliance might blind you, heh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_10","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_11","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_11","text":"To have come thus far... it is wondrous indeed. Humanity's potential doth move upon a plane apart from beings such as ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_12","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_12","text":"... Yet, mayhap, not quite as yet...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_13","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_13","text":"As I foresaw, without the key...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_14","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_39_11_14","text":"What's the matter, Pilgrim? Lost for words after seeing our amazing performance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_15","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_39_11_15","text":"Don't get discouraged! If you work hard, you can also become a hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_16","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_16","text":"Haha. Thy kind words are much appreciated. I shall strive diligently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_17","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_11_17","text":"Cutey, are you hurt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_11_18","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_19","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_39_11_19","text":"Your arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_20","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_11_20","text":"I look at both my arms, and notice blood seeping through my left sleeve.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_21","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_11_21","text":"Oh... I must have caught a stray bullet or shrapnel. It's nothing serious. Don't worry about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_22","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_22","text":"Let me take a look at your wound.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_23","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_24","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_24","text":"No wounds, as expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_25","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_25","text":"How's the pain?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_11_26","text":"... I didn't even realize I was injured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_28","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_28","text":"Commander, I feel that tracking the Four Beasts is no longer our top priority.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_29","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_29","text":"We must get you back to the Ark for a full medical examination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_30","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_39_11_30","text":"We've come all this way, and Matis is here supporting us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_31","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_39_11_31","text":"Yes, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_39_11_32","text":"Nayuta approaches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_33","type":"Speech","speaker":"nayuta_n","key":"Locale_MainScenario:d_main_39_11_33","text":"... Great Hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_11_34","type":"Speech","speaker":"na