othy","key":"Locale_MainScenario:event_overzone2_epilogue_12","text":"Nice to meet you too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_epilogue_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_epilogue_13","text":"It's been some time since I've interacted with a Nikke that's been sent up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_epilogue_14","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_epilogue_14","text":"If you don't mind me asking, how is the Ark faring these days?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_epilogue_15","type":"Speech","speaker":"massproduction01","key":"Locale_MainScenario:event_overzone2_epilogue_15","text":"I don't mind one bit!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_epilogue_16","type":"Speech","speaker":"massproduction01","key":"Locale_MainScenario:event_overzone2_epilogue_16","text":"You saved my life, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_epilogue_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_epilogue_17","text":"Hehe, well I appreciate that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_epilogue_18","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_epilogue_18","text":"They're preparing a countermeasure against the AI that oversees 