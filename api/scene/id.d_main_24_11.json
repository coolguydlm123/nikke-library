{"id":"d_main_24_11","cat":"main","group":{"id":"ch24","label":"Chapter 24 · Banishment"},"label":"Mediator","stage":"24-30 STAGE · Start","prev":"d_main_24_10","next":"d_main_24_12","speakers":{"Narration":"Narration","dorothy":"Dorothy","burningum":"Burningum","poli_op":"Poli"},"icons":{"Narration":"si_c999_00_s","dorothy":"si_c233_00_s","burningum":"si_c914_00_s","poli_op":"si_c030_00_s"},"lines":[{"id":"d_main_24_11_1","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24_11_1","text":"Central Government, briefing room 13.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_2","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_2","text":"Things in the Ark seem to be bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["burningum","dorothy"],"affinity":null},{"id":"d_main_24_11_3","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_3","text":"I-it's nearly taken care of. You don't need to worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_4","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_4","text":"Anything I can do to lend a hand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_5","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_5","text":"N-no.\nIt's okay. We can take care of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_6","text":"All right then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_7","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_7","text":"Oh, did you receive my gift?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_8","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_8","text":"It's rather rare even up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_9","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_9","text":"Th-the Heretic... Nihilister, you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_10","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_10","text":"I had her put into M.M.R.'s Atlas Cage right away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_11","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_11","text":"The te-tech team was over the moon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_12","text":"Hehe, I'm glad they were pleased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_13","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_14","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_15","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_15","text":"You came at a different time than you said you would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_16","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_16","text":"Wh-why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_17","text":"Well, you originally wanted me to use that 'secret elevator', as you called it, and ride it straight to the Ark, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_18","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_18","text":"I was going to do that, but then there was all that business with the gaping hole in the Ark's roof.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_19","text":"Once the Heretic showed up, I decided to help out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_20","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_20","text":"You drew too much attention to yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_21","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_21","text":"I-I'm just glad all the citizens were in the shelters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_22","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_22","text":"If they had seen you and that Heretic, we'd have had a real mess on our hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_23","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_23","text":"That's why I did it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_24","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_24","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_25","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_25","text":"I did it so the humans in the Ark could see me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_26","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_26","text":"But you're telling me that everyone was cloistered off in the shelters?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_27","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_27","text":"That's a shame. \nIt would have been a hell of a show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_28","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_28","text":"I missed the chance to give some people a memory that would last a lifetime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_29","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_29","text":"I was going to go out and bash some Raptures while I was in the area, but I'm suddenly feeling bereft of inspiration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_30","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_31","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_31","text":"Y-you should have kept your arrival in the Ark a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_32","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_32","text":"N-now everyone knows you're here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_33","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_33","text":"Th-thanks to you, people are asking for an explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_34","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_34","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_35","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_35","text":"I go out of my way to catch a Heretic, \nand you're blaming me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_36","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_36","text":"If I hadn't stepped in to help, I think it's easy to assume what state the Ark would be in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_37","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_37","text":"The A-Ark is strong. \nThey could easily dispose of a Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_38","text":"Oh, so my contribution means nothing, then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_39","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_39","text":"Th-that's not what I meant. \nI'm just saying, i-it's complicated because your arrival was so ostentatious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_40","text":"... I've been meaning to ask.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_41","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_41","text":"Why do you want to keep my coming to the Ark all hush-hush?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_42","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_42","text":"So what if a Pilgrim comes to the Ark? Is that the end of the world?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_43","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_43","text":"Is there something you're not telling me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_44","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_44","text":"N-no! Not at all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_45","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_45","text":"I'm just scared, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_46","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_46","text":"Scared? Of what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_47","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_47","text":"Right now, the situation is mostly taken care of, but the fact remains that enemies from the outside encroached on the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_48","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_48","text":"If a Pilgrim were to show up at a time like that and declare war, it'd be pandemonium.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_49","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_49","text":"Granted, any suspicions towards you have been assuaged somewhat thanks to you taking care of that Here-Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_50","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_50","text":"Bu-but I still don't know what you're after.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_51","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_51","text":"Haha. I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_52","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_52","text":"So, while we're on that topic, I'd like you to make everything perfectly clear to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_53","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_53","text":"Wh-why did you come to the Ark, and ask to see me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_54","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_54","text":"I want to make a pact between the Ark and Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_55","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_55","text":"And I want to be the ambassador of that pact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_56","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_56","text":"A pact...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_57","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_57","text":"Between th-the Ark and Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_58","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_58","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_59","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_59","text":"Wh-what kind of pact?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_60","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_60","text":"Let's start with something simple: sharing our technology, resources, and manpower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_61","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_61","text":"You scratch our back, and we'll scratch yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_62","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_63","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_63","text":"Eden is far more technologically advanced than the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_64","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_64","text":"But there's something we're lacking that you have in spades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_65","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_65","text":"Resources and manpower, I presume?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_66","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_66","text":"Bingo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_67","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_67","text":"I've gotta say, you're easier to talk to than I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_68","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_68","text":"Bu-but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_69","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_69","text":"I don't know the de-details, but doesn't Eden","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_70","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_70","text":"despise the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_71","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_71","text":"Indeed they do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_72","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_72","text":"That's where I come in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_73","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_73","text":"I can be a goodwill ambassador; a mediator between Eden and the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_74","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_24_11_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_11_75","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_24_11_75","text":"You don't look too convinced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id"