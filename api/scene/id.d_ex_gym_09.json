{"id":"d_ex_gym_09","cat":"outpost","group":{"id":"outpost12301","label":"Fitness Club"},"label":"Nepenthe's Exercises","stage":null,"prev":"d_ex_gym_08","next":"d_ex_gym_10","speakers":{"rumani":"Rumani","epinel":"Epinel","folkwang":"Folkwang","Self":"Commander","Monologue":"Monologue"},"icons":{"rumani":"si_c240_00_s","epinel":"si_c241_00_s","folkwang":"si_c242_00_s"},"notes":["Unlock: Rumani · Folkwang · Epinel","Featuring Rumani · 1 stamina · Reward: Darling for a Day ×1"],"lines":[{"id":"d_ex_gym_09_1","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_1","text":"Is that everyone?","jump":null,"exit":false,"enter":null,"bg":"Gym","bgArt":"gym","image":null,"bgm":"none","movie":null,"shown":["folkwang","epinel","rumani"],"affinity":null},{"id":"d_ex_gym_09_2","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_2","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_onlineshopping","movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_3","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_3","text":"I think so... Ugh, it's so hot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_4","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_4","text":"The reason I asked you all to gather here is simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_5","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_5","text":"I want each of us to show Gym Rat the appeal of our workouts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_6","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_6","text":"Show Coach? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_7","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_7","text":"It seems that his interest in exercise has decreased a lot lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_8","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_8","text":"So we should help him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_9","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_9","text":"I don't think that's necessary...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_10","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_10","text":"Oh no, it's quite necessary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_11","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_11","text":"This is exactly the kind of situation that Nepenthe exists for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_12","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_12","text":"Having said that, I don't know everything there is to know about exercise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_13","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_13","text":"So while I always want to teach you more, there are times when I can't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_14","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_14","text":"That's why I think it'd be invigorating for all of us to learn about different types of exercise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_15","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_15","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_16","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_16","text":"Then, Epinel, if you would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_17","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_17","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_18","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_18","text":"As you already know, Coach, I'm a big fan of skateboarding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_19","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_19","text":"It's mainly an aerobic exercise that really boosts your stamina.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_20","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_20","text":"It requires significant core strength to maintain your posture, and your lower body strength to keep your balance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_21","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_21","text":"But the most important thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_22","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_22","text":"You can actually have fun while you're at it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_23","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_gym_09_23","text":"Epinel sets off on her board and does a quick lap around the gym.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_24","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_gym_09_24","text":"Her joyous expression in the wind is so infectious that it puts a smile on everyone's faces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_25","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_25","text":"Here's a tip:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_26","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_26","text":"Don't be afraid of falling down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_27","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_27","text":"That was an amazing introduction, Epinel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_28","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_28","text":"That'd be enough to stoke anyone's interest in skateboarding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_29","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_29","text":"Yeah, that was great. I'm actually tempted to go skate on the board right away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_30","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_30","text":"Thanks, I appreciate that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_31","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_31","text":"Folkwang, you're next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_32","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_32","text":"Phew... Okay,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_33","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_33","text":"so running is my go-to exercise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_34","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_34","text":"It's great for building strength, endurance, and even helps with stress,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_35","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_35","text":"but you probably already know all that. So let me tell you what I love about it personally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_36","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_36","text":"Whenever I run and work up a sweat, the perspiration has a nice cooling effect on my skin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_37","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_37","text":"Plus, running clears my mind completely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_38","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_38","text":"All those pesky thoughts about being too hot or sticky just vanish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_39","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_39","text":"I absolutely live for that feeling... Whew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_40","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_40","text":"Oh, and don't forget to take some supplements too! About 20 capsules shou—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_41","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_41","text":"Folkwang.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_42","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_42","text":"... No, you should only take them in moderation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_43","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_43","text":"That's better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_44","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_44","text":"That was a lovely introduction to running,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_45","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_45","text":"excluding that last bit about the supplements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_46","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_46","text":"My precious supplements...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_47","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_47","text":"I feel like going for a run right now while listening to my favorite song.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_48","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_48","text":"Thanks for saying that, Coach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_49","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_49","text":"Now, it's my turn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_50","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_50","text":"I know that it can be hard to get excited about going to the gym,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_51","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_51","text":"especially when it's compared to these other unique and novel exercise methods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_52","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_52","text":"But!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_53","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_53","text":"There's nothing quite like a gym workout to put both my strength and endurance to the test all at once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_54","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_54","text":"The rush of flawlessly executing a set,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_55","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_55","text":"the sense of achievement when lifting more weight than the day before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_56","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_56","text":"and the joy of setting your own pace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_57","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_57","text":"That, to me, is the true definition of exercise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_58","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_58","text":"Folkwang, Epinel. What do you two think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_59","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_59","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_60","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_60","text":"I... find it a bit tough to keep up with your pace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_61","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_61","text":"That's precisely the point! That's when you overcome your limits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_62","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_62","text":"It's so tough. I always sweat so much that it makes gripping the dumbbells and barbells really difficult...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_63","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_63","text":"That's why I made custom gloves and straps for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_64","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_65","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_66","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_66","text":"There's definitely a certain charm to working out at the gym... even if it is tough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_67","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_67","text":"Coach, what are you doing?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_68","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_68","text":"If you say that, Rumani will—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_69","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_69","text":"Huh? Did I say something wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_70","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_70","text":"I knew you'd agree with me, Gym Rat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_71","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_71","text":"How about we start with some skateboarding, follow it up with a run,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_72","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_72","text":"and then wrap it up with a gym workout?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_73","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_73","text":"Wha... Why are we doing all three?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_74","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_74","text":"It seems like you're really interested in all three of our exercises.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_75","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_75","text":"Once you show an interest in physical activity, it's best to jump straight into it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_76","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_76","text":"... So we have to work out right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_77","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_77","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_78","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_78","text":"We'll be joining you, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_79","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_79","text":"That way, we can all motivate each other while we exercise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_80","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_80","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_81","type":"Speech","speaker":"folkwang","key":"Locale_SuddenStory:d_ex_gym_09_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_82","type":"Self","speaker":"Self","key":"Locale_SuddenStory:d_ex_gym_09_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_83","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_83","text":"Epinel! Are you ready to teach us how to skateboard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_84","type":"Speech","speaker":"rumani","key":"Locale_SuddenStory:d_ex_gym_09_84","text":"I'll get a board for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_85","type":"Speech","speaker":"epinel","key":"Locale_SuddenStory:d_ex_gym_09_85","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_86","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_gym_09_86","text":"For the rest of the day, we're held hostage by Rumani and forced to exercise continuously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_gym_09_87","type":"Monologue","speaker":"Monologue","key":"Locale_SuddenStory:d_ex_gym_09_87","text":"By the time we reach the final workout at the gym, the intensity is enough to make me kick myself for speaking out earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}