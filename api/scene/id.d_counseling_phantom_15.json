{"id":"d_counseling_phantom_15","cat":"counsel","group":{"id":"char5122","label":"Phantom"},"label":"Advising Phantom: 15","stage":null,"prev":"d_counseling_phantom_14","next":"d_counseling_phantom_16","speakers":{"phantom":"Phantom"},"icons":{"phantom":"si_c580_00_s"},"lines":[{"id":"d_counseling_phantom_15_1","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_15_1","text":"I saw a news report stating the decline of people's reading habits.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["phantom"],"affinity":"_0"},{"id":"d_counseling_phantom_15_2","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_15_2","text":"Maybe that's why it's been so quiet at the library.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_15_3","type":"Speech","speaker":"phantom","key":"Locale_Counseling:d_counseling_phantom_15_3","text":"What can we do to encourage more people to read?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_phantom_15_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_15_4","text":"Increase the variety of books.","jump":"d_counseling_phantom_15_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_phantom_15_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_phantom_15_5","text":"Promote the library by holding various events.","jump":"d_counseling_phantom_15_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_phantom_15_6","type":"Speech","speaker":"phantom","key":"Locale_Couns