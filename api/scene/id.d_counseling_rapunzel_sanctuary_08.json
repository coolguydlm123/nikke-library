{"id":"d_counseling_rapunzel_sanctuary_08","cat":"counsel","group":{"id":"char5187","label":"Rapunzel: Sanctuary"},"label":"Advising Rapunzel: Sanctuary: 08","stage":null,"prev":"d_counseling_rapunzel_sanctuary_07","next":"d_counseling_rapunzel_sanctuary_09","speakers":{"rapunzel_s":"Rapunzel"},"icons":{"rapunzel_s":"si_c473_00_s"},"lines":[{"id":"d_counseling_rapunzel_sanctuary_08_1","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_1","text":"Believer, you seem to be having trouble sleeping lately,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rapunzel_s"],"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_2","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_2","text":"so I prepared a warm eye mask for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_3","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_3","text":"Wear this to bed, and I'm sure you'll sleep peacefully tonight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_4","text":"How did you know I haven't been sleeping?","jump":"d_counseling_rapunzel_sanctuary_08_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_rapunzel_sanctuary_08_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_5","text":"Uh, eye masks feel a little uncomfortable to me...","jump":"d_counseling_rapunzel_sanctuary_08_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_rapunzel_sanctuary_08_6","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_6","text":"I've noticed you tossing and turning in the early hours, and you've been coughing, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_7","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_7","text":"You really should get plenty of rest whenever you can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_8","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_8","text":"Don't push yourself too hard, and make sure you get to bed early tonight.","jump":"d_counseling_rapunzel_sanctuary_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_9","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_9","text":"Oh, I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_10","type":"Speech","speaker":"rapunzel_s","key":"Locale_Counseling:d_counseling_rapunzel_sanctuary_08_10","text":"Actually, I've seen you coughing and tossing and turning whenever I go for my morning prayers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_rapunzel_sanctuary_08_11","type":"Speech","speaker":"rapunzel_s","key":"Loca