{"id":"d_counseling_cinderella_16","cat":"counsel","group":{"id":"char5124","label":"Cinderella"},"label":"Advising Cinderella: 16","stage":null,"prev":"d_counseling_cinderella_15","next":"d_counseling_cinderella_17","speakers":{"cinderella":"Cinderella","Narration":"Narration"},"icons":{"cinderella":"si_c511_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_counseling_cinderella_16_1","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_16_1","text":"Can you help me comb my hair, Prince?","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["cinderella"],"affinity":"_0"},{"id":"d_counseling_cinderella_16_2","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_16_2","text":"My hair keeps getting tangled today, and it's really bothering me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_16_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_16_3","text":"Comb it gently from top to bottom in sections.","jump":"d_counseling_cinderella_16_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_16_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_16_4","text":"Comb it from top to bottom all at once.","jump":"d_counseling_cinderella_16_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_16_5","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_cinderella_16_5","text":"*Swoosh* *Swoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"