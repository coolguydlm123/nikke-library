ertain point.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_16_13","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_16_13","text":"It seems you're not very familiar with handling long hair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_16_14","type":"Speech","speaker":"cinderella","key":"Locale_Counseling:d_counseling_cinderella_16_14","text":"If you comb it all at once, it'll only become more tangled and cause pain.","jump":"d_counseling_cinderella_16_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_16_15","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_cinderella_16_15","text":"I spend the rest of the session combing Cinderella's hair.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}