{"id":"d_main_50_af_01","cat":"main","group":{"id":"ch50","label":"Chapter 50 · Ascension"},"label":"A New Map","stage":null,"prev":"d_main_50_10","next":"d_main_50_af_02","speakers":{"privaty":"Privaty","yulha":"Yulha","admi":"Admi","quiry":"Quiry"},"icons":{"privaty":"si_c170_00_s","yulha":"si_c171_00_s","admi":"si_c172_00_s","quiry":"si_c033_00_s"},"lines":[{"id":"d_main_50_af_01_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_1","text":"I look around me.","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":"bgm_chapter50_field_surfacing","movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_2","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_2","text":"The city is full of people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_3","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_3","text":"Some of them are looking at the sky, and some are coming to the hospital.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_4","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_4","text":"I stand there, looking around me in a daze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_5","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_5","text":"Just then, somebody taps my shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_6","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_6","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["privaty","yulha","admi"],"affinity":null},{"id":"d_main_50_af_01_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_7","text":"Oh... Privaty, Yulha, Admi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_8","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_8","text":"What are you doing out here, Newbie?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_9","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_9","text":"Shouldn't you be lying down in your room?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_10","text":"What... happened to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_11","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_11","text":"... After the battle with the Queen, you were brought here in critical condition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_12","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_12","text":"It turned out to just be fatigue, though, so they gave you a room to rest in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_13","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_13","text":"I have no idea how you fought the Queen and got off with nothing worse than fatigue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_14","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_14","text":"You seem to have recovered very quickly. We'd heard you would have to rest for several days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_15","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_15","text":"No one was there when I woke up, so I just walked out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_16","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_17","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_17","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_18","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_18","text":"Oh my...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_19","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_19","text":"Do you remember who the doctor in charge is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_20","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_20","text":"Just a moment. I wrote it down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_21","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_21","text":"It's Patrick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_22","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_22","text":"Got it. I'll give him a call right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_23","text":"Um... Am I not allowed to be outside?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_24","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_24","text":"It's not that. The problem is they didn't assign anyone to watch over you at all times,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_25","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_25","text":"and they left you alone to walk here all by yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_26","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_26","text":"That is no way to treat one of the most important figures from the Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_27","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_27","text":"We can't just let this slide.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_28","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_28","text":"He's not picking up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_29","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_29","text":"I know his address. It's ten minutes from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_30","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_30","text":"Privaty. Go pay him a visit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_31","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_31","text":"Make sure to file a complaint.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_32","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_32","text":"Oh, you bet I will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_33","text":"No, I don't think you should. I'm fine. I walked outside because I was well enough to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_34","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_34","text":"I'm sure that's true, but this is still a matter of negligence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_35","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_35","text":"That's right. We can't just ignore that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_36","text":"... Let it go. There must be a good reason.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_37","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_38","text":"More importantly, how did things end? What happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_39","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_39","text":"Tch. You're too soft.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_40","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_41","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_41","text":"We won.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_42","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_42","text":"The Ark ascended safely to the surface, and we defeated the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_43","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_43","text":"We deployed large-scale optical camouflage around the Ark, but there was basically no need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_44","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_44","text":"We sent out large search teams around the Ark, but we couldn't find traces of any Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_45","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_45","text":"You used to be guaranteed to encounter Raptures within an hour. Now it's like that was never thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_46","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_46","text":"We couldn't find a single one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_47","text":"Not a single one...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_48","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_48","text":"Yeah. I mean that literally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_49","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_49","text":"The search teams said it felt like a dream.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_50","text":"What about everyone else who fought against the Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_51","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_51","text":"... None of them made it without injuries, so they're undergoing intensive care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_52","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_52","text":"Many of them are in critical condition...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_53","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_54","text":"Where do I need to go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_55","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_55","text":"The Ark is in chaos right now, so they're all at the Outpost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_56","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_56","text":"We moved a bunch of medical equipment there so they could be treated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_57","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_57","text":"Oh, the Outpost came to the surface too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_58","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_58","text":"Yeah. Apparently it was built with ascension in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_59","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_59","text":"You can't use the elevator to get there anymore, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_60","text":"Then how do I get there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_61","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_61","text":"You have to go through the partition, past the Outer Rim, and then walk. It takes quite a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_62","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_62","text":"Are you going to head over right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_63","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_63","text":"Yeah, I should.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_64","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_64","text":"... I'll show you the way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_65","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_65","text":"Hmph, I knew it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_66","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_50_af_01_66","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_67","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_67","text":"No, don't worry about it. You seem pretty busy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_68","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_68","text":"By the way, what's Triangle doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_69","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_69","text":"People are swarming the hospital.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_70","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_70","text":"Apparently some strange rumors are going around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_71","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_71","text":"People are saying the air of the surface is poison, and the sunlight will melt your skin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_72","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_72","text":"I don't know where those ideas came from, but they've spread throughout the whole Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_73","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_73","text":"So now, whenever someone has even a minor problem with their body, they rush to the hospital.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_74","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_74","text":"That's why this place is like this. Other hospitals are having the same problem too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_75","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_75","text":"We're here helping the A.C.P.U. contain the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_76","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_76","text":"Admi turns and looks in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["quiry"],"affinity":null},{"id":"d_main_50_af_01_77","type":"Speech","speaker":"quiry","key":"Locale_MainScenario:d_main_50_af_01_77","text":"Everyone! Please maintain order!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_78","type":"Speech","speaker":"quiry","key":"Locale_MainScenario:d_main_50_af_01_78","text":"Do you see this line on the floor? Please stand here and form a single file line!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_79","type":"Speech","speaker":"quiry","key":"Locale_MainScenario:d_main_50_af_01_79","text":"... Hm? Wait, this is just a rope. Who left this here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_80","type":"Speech","speaker":"quiry","key":"Locale_MainScenario:d_main_50_af_01_80","text":"Everyone! You must stand in line to be seen more quickly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_81","type":"Speech","speaker":"quiry","key":"Locale_MainScenario:d_main_50_af_01_81","text":"You! No cutting in line!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_82","type":"Speech","speaker":"quiry",