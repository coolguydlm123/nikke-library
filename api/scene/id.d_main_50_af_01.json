 the Ark was able to ascend to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_90","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_90","text":"Oh, I should've said this sooner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_91","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_91","text":"Thank you so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_92","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_92","text":"... Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_93","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_93","text":"I'd better get going then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_94","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_01_94","text":"Keep up the good work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_95","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_50_af_01_95","text":"Before you go, Newbie, let us send you the new map. It's been updated to include the terrain surrounding the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_01_96","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_50_af_01_96","text":"I already sent it to him.","ju