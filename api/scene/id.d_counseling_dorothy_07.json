{"id":"d_counseling_dorothy_07","cat":"counsel","group":{"id":"char5061","label":"Dorothy"},"label":"Advising Dorothy: 07","stage":null,"prev":"d_counseling_dorothy_06","next":"d_counseling_dorothy_08","speakers":{"dorothy":"Dorothy"},"icons":{"dorothy":"si_c233_00_s"},"lines":[{"id":"d_counseling_dorothy_07_1","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_07_1","text":"Do you believe in the idea of karma?","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"bgm_story_edenin","movie":null,"shown":["dorothy"],"affinity":"_0"},{"id":"d_counseling_dorothy_07_2","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_07_2","text":"That actions have consequences and people who do bad things will eventually get what's coming to them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_07_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_07_3","text":"Yes, I think it's true.","jump":"d_counseling_dorothy_07_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_dorothy_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_07_4","text":"It's hard to say.","jump":"d_counseling_dorothy_07_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_dorothy_07_5","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_07_5","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_07_6","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_07_6","text":"However, the wretched scum always manage to escape their just desserts.","jump":"d_counseling_dorothy_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_07_7","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_07_7","text":"That's a realistic answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_07_8","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_07_8","text":"The unfortunate truth is that not everyone can be punished for their wrongdoings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_07_9","type":"Speech","speaker":"dorothy","key":"Locale_Counseling:d_counseling_dorothy_07_9","text":"... That's why I can't stop myself.","jump":"d_counseling_dorothy_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_07_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_07_10","text":"Dorothy and I discuss a bitter topic.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}