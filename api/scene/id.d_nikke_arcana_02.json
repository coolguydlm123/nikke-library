":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_48","text":"But now, only specific parts, like certain information that I saw during, get wiped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_49","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_49","text":"I heard that this is the way Phantom gets it done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_50","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_02_50","text":"That's what I heard as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_51","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_51","text":"That wasn't done with me before, due to security reasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_52","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_52","text":"But I guess they made some tactical upgrades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_53","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_53","text":"That's why I still remember you proposing to me and getting rejected earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_54","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_02_54","text":"When did I do that?","jump":"d_nikke_arcana_02_56","exit":false,"enter":null