you are. Think back to when we first met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_82","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_82","text":"It'd be crazy for you to go through all that to help someone that you knew,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_83","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_83","text":"let alone a total stranger, like me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_84","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_02_84","text":"Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_85","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_85","text":"You don't have to feel too pressured to steer the ship.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_86","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_02_86","text":"But I do. A lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_87","type":"Speech","speaker":"arcana","key":"Locale_NikkeEpisode:d_nikke_arcana_02_87","text":"Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_arcana_02_88","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_arcana_02_88","text":"Just like she did at th