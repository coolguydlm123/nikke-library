{"id":"msg_m_ex_underworldqueen_03","cat":"messenger","group":{"id":"room_underworldqueen","label":"Underworld Queen · Group"},"label":"3. Hey,","stage":null,"prev":"msg_m_ex_underworldqueen_02","next":"msg_m_ex_underworldqueen_04","speakers":{"moran":"Moran","rosanna":"Rosanna","sakura":"Sakura"},"icons":{"moran":"si_c281_00_s","rosanna":"si_c280_00_s","sakura":"si_c282_00_s"},"lines":[{"id":"m_ex_underworldqueen_03_1","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_1","text":"Hey,","jump":null},{"id":"m_ex_underworldqueen_03_2","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_2","text":"guys.","jump":null},{"id":"m_ex_underworldqueen_03_3","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_3","text":"There's something I've been wanting to ask.","jump":null},{"id":"m_ex_underworldqueen_03_4","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_4","text":"How do you manage your subordinates?","jump":null},{"id":"m_ex_underworldqueen_03_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_03_5","text":"?","jump":null},{"id":"m_ex_underworldqueen_03_6","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_6","text":"^^","jump":null},{"id":"m_ex_underworldqueen_03_7","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_7","text":"What kind of a moronic question is that?","jump":null},{"id":"m_ex_underworldqueen_03_8","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_8","text":"Where is this coming from?","jump":null},{"id":"m_ex_underworldqueen_03_9","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_9","text":"Er...","jump":null},{"id":"m_ex_underworldqueen_03_10","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_10","text":"It's coming from me, who else?","jump":null},{"id":"m_ex_underworldqueen_03_11","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_11","text":"That's not what I mean,","jump":null},{"id":"m_ex_underworldqueen_03_12","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_12","text":"you simpleton.","jump":null},{"id":"m_ex_underworldqueen_03_13","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_13","text":"Let me ask YOU something: What's your job?","jump":null},{"id":"m_ex_underworldqueen_03_14","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_14","text":"Me?","jump":null},{"id":"m_ex_underworldqueen_03_15","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_15","text":"I'm the boss of the Peony Association.","jump":null},{"id":"m_ex_underworldqueen_03_16","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_16","text":"You have the gall to call yourself that,","jump":null},{"id":"m_ex_underworldqueen_03_17","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_17","text":"and at the same time ask us how to manage your own subordinates?","jump":null},{"id":"m_ex_underworldqueen_03_18","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_18","text":"It's like","jump":null},{"id":"m_ex_underworldqueen_03_19","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_19","text":"a chef asking a customer","jump":null},{"id":"m_ex_underworldqueen_03_20","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_20","text":"how to cook something!","jump":null},{"id":"m_ex_underworldqueen_03_21","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_21","text":"No way, those are totally different!","jump":null},{"id":"m_ex_underworldqueen_03_22","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_22","text":"I'm not asking about how to cook anything.","jump":null},{"id":"m_ex_underworldqueen_03_23","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_23","text":"^^","jump":null},{"id":"m_ex_underworldqueen_03_24","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_24","text":"Honestly,","jump":null},{"id":"m_ex_underworldqueen_03_25","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_25","text":"I can feel your stupidity","jump":null},{"id":"m_ex_underworldqueen_03_26","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_26","text":"rubbing off on me.","jump":null},{"id":"m_ex_underworldqueen_03_27","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_27","text":"This is what my phone was vibrating non-stop for?","jump":null},{"id":"m_ex_underworldqueen_03_28","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_28","text":"It was hardly worth me checking at all.","jump":null},{"id":"m_ex_underworldqueen_03_29","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_29","text":"I'm turning off notifications.","jump":null},{"id":"m_ex_underworldqueen_03_30","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_30","text":"Hey, wait!","jump":null},{"id":"m_ex_underworldqueen_03_31","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_31","text":"Why would you do that?","jump":null},{"id":"m_ex_underworldqueen_03_32","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_32","text":"... Cadet,","jump":null},{"id":"m_ex_underworldqueen_03_33","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_33","text":"was my question really that strange?","jump":null},{"id":"m_ex_underworldqueen_03_34","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_03_34","text":"A little bit, yeah.","jump":"m_ex_underworldqueen_03_36"},{"id":"m_ex_underworldqueen_03_35","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_03_35","text":"I thought it was a perfectly valid question.","jump":"m_ex_underworldqueen_03_40"},{"id":"m_ex_underworldqueen_03_36","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_36","text":"You see?","jump":null},{"id":"m_ex_underworldqueen_03_37","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_37","text":"We're not the only ones who feel that way.","jump":null},{"id":"m_ex_underworldqueen_03_38","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_38","text":"This can't be!","jump":null},{"id":"m_ex_underworldqueen_03_39","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_39","text":"I never expected to hear you say something like that, Cadet.","jump":"m_ex_underworldqueen_03_43"},{"id":"m_ex_underworldqueen_03_40","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_40","text":"You heard that?","jump":null},{"id":"m_ex_underworldqueen_03_41","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_41","text":"I knew I could count on you,","jump":null},{"id":"m_ex_underworldqueen_03_42","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_42","text":"Cadet.","jump":"m_ex_underworldqueen_03_43"},{"id":"m_ex_underworldqueen_03_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_03_43","text":"What made you ask that question in the first place, though?","jump":null},{"id":"m_ex_underworldqueen_03_44","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_44","text":"Well,","jump":null},{"id":"m_ex_underworldqueen_03_45","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_45","text":"I like to keep things casual at the Peony Association.","jump":null},{"id":"m_ex_underworldqueen_03_46","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_46","text":"We're like one big family, and so my subordinates act pretty relaxed around me.","jump":null},{"id":"m_ex_underworldqueen_03_47","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_47","text":"Other organizations are much more stringent with their regulations,","jump":null},{"id":"m_ex_underworldqueen_03_48","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_48","text":"so I was curious to see how they functioned.","jump":null},{"id":"m_ex_underworldqueen_03_49","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_49","text":"Ah,","jump":null},{"id":"m_ex_underworldqueen_03_50","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_50","text":"so that's it.","jump":null},{"id":"m_ex_underworldqueen_03_51","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_51","text":"You're wondering how to better wrangle your subordinates,","jump":null},{"id":"m_ex_underworldqueen_03_52","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_52","text":"is that it?","jump":null},{"id":"m_ex_underworldqueen_03_53","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_53","text":"Yeah, I'm curious.","jump":null},{"id":"m_ex_underworldqueen_03_54","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_54","text":"All right,","jump":null},{"id":"m_ex_underworldqueen_03_55","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_55","text":"then come find me at the park.","jump":null},{"id":"m_ex_underworldqueen_03_56","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_56","text":"I'll tell you exactly what you want to hear.","jump":null},{"id":"m_ex_underworldqueen_03_57","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_57","text":"^^","jump":null},{"id":"m_ex_underworldqueen_03_58","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_58","text":"Really?","jump":null},{"id":"m_ex_underworldqueen_03_59","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_59","text":"I'm on my way!","jump":null},{"id":"m_ex_underworldqueen_03_60","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_60","text":"Mister, would you like to come and see the show?","jump":null},{"id":"m_ex_underworldqueen_03_61","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_61","text":"It's gonna be a whole lotta fun.","jump":null},{"id":"m_ex_underworldqueen_03_62","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_62","text":"^^","jump":null},{"id":"m_ex_underworldqueen_03_63","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_03_63","text":"For some reason, I have an uneasy feeling about all this.","jump":null},{"id":"m_ex_underworldqueen_03_64","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_03_64","text":"Sorry, I'm a bit busy.","jump":null},{"id":"m_ex_underworldqueen_03_65","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_65","text":"Aw darn, that's too bad.","jump":null},{"id":"m_ex_underworldqueen_03_66","type":"Speech","speaker":"moran","key":"Locale_SuddenMessage:m_ex_underworldqueen_03_66","text":"See you later!","jump":null}],"chat":true}