gy from Volume for her recent talk show outburst.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_04_75","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_volume_04_75","text":"Volume and her manager tried to appeal to the fans, but nothing seemed to quell their anger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_04_76","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_volume_04_76","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_04_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_volume_04_77","text":"... Why do you keep getting in the way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_04_78","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:d_nikke_volume_04_78","text":"I didn't get in the way. I just wanted to clear up some misunderstandings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_04_79","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:d_nikke_volume_04_79","text":"Did you ever consider that you're not doing a good enough job?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_volume_04_80","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_volume_04_80","text":"All right, next step.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ni