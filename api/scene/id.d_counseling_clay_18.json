{"id":"d_counseling_clay_18","cat":"counsel","group":{"id":"char5115","label":"Clay"},"label":"Advising Clay: 18","stage":null,"prev":"d_counseling_clay_17","next":"d_counseling_clay_19","speakers":{"clay":"Clay"},"icons":{"clay":"si_c551_00_s"},"lines":[{"id":"d_counseling_clay_18_1","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_clay_18_1","text":"Coach, do you think hard work and tenacity can beat natural talent?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["clay"],"affinity":"_0"},{"id":"d_counseling_clay_18_2","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_clay_18_2","text":"It's something that often crosses my mind while I'm watching sports matches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_clay_18_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_clay_18_3","text":"I don't think effort means much in the face of overwhelming talent.","jump":"d_counseling_clay_18_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_clay_18_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_clay_18_4","text":"If you try hard enough, nothing is impossible.","jump":"d_counseling_clay_18_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_clay_18_5","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_clay_18_5","text":"Yeah... I kind of suspected that was the case.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_clay_18_6","type":"Speech","speaker":"clay","key":"Locale_Counseling:d_counseling_