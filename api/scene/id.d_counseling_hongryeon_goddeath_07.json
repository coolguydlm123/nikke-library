{"id":"d_counseling_hongryeon_goddeath_07","cat":"counsel","group":{"id":"char5186","label":"Scarlet: Goddeath"},"label":"Advising Scarlet: Goddeath: 07","stage":null,"prev":"d_counseling_hongryeon_goddeath_06","next":"d_counseling_hongryeon_goddeath_08","speakers":{"hongryeon_g":"Scarlet"},"icons":{"hongryeon_g":"si_c472_00_s"},"lines":[{"id":"d_counseling_hongryeon_goddeath_07_1","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_07_1","text":"Hast thou any plans for the morrow, my Lord?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon_g"],"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_07_2","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_07_2","text":"If thou hast none, I would fain have thee spend it in mine company.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_goddeath_07_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_07_3","text":"I don't have any plans.","jump":"d_counseling_hongryeon_goddeath_07_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_goddeath_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_goddeath_07_4","text":"You wanna get a drink again?","jump":"d_counseling_hongryeon_goddeath_07_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_goddeath_07_5","type":"Speech","speaker":"hongryeon_g","key":"Locale_Counseling:d_counseling_hongryeon_goddeath_07_5","text":"Then let us go fishing on the morrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgA