diculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_af_01_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_af_01_36","text":"Having said that, you did recover awfully quickly. Almost unnaturally so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_af_01_37","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_32_af_01_37","text":"Can either of you explain to me what happened?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_af_01_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_af_01_38","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_af_01_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_af_01_39","text":"Cinderella fought with Behemoth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_af_01_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_32_af_01_40","text":"She wasn't quite able to overcome her. It was a long brawl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_af_01_41","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_32_af_01_41","text":"Behemoth ended up expanding that dark matter of hers,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_af_01_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_32_af_01_42","text":"so much so