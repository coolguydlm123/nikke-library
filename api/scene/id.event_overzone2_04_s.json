age":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_6","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_04_s_6","text":"In her mind, she made a pinky promise with Pinne, and when she did, she actually put her hand up and moved her fingers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_7","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_04_s_7","text":"In Dorothy's mind, Pinne really exists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_8","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_8","text":"So, when she skinned the deer...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_9","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_9","text":"She recalled Pinne skinning it and followed along with the image imprinted in her mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_10","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_10","text":"To her, it was as if Pinne was beside her, helping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_11","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_12","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_12","text":"What do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_13","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_13","text":"I'm not sure...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_14","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_04_s_14","text":"I don't see a problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_15","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_15","text":"You don't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_16","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_16","text":"Neither do I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_17","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_04_s_17","text":"Dorothy is using this as a coping mechanism, and it isn't disrupting her day-to-day life in any significant way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_18","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_04_s_18","text":"As long as it stays this way, I don't see a problem with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_19","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_19","text":"Sure, but what if it doesn't stay this way? How bad do you think it could get?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_20","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_20","text":"Could Dorothy lose her entire sense of self to this delusion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_21","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_21","text":"Since it's a product of Dorothy's own mind, it will only act within the boundaries that Dorothy confines it to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_22","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_22","text":"Pinne was Dorothy's friend. She was a positive force in her life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_23","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_23","text":"She'll remain devoted to that role.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_24","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_24","text":"In fact, the worst-case scenario would be","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_25","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_25","text":"if Pinne disappeared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_26","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_27","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_27","text":"We're in unexplored territory here, so it's high risk. The slightest variation could cause Pinne to disappear entirely from Dorothy's mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_28","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_28","text":"What should we do to ensure Dorothy remains normal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_29","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_29","text":"I think we just need to act the way we do normally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_30","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_04_s_30","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_31","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_31","text":"Hmm... very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_32","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_04_s_32","text":"We shall try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_33","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_04_s_33","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_34","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_04_s_34","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_35","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_35","text":"We received confirmation of the destruction of the freight elevator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_signal","movie":null,"shown":["dorothy","collectrobot"],"affinity":null},{"id":"event_overzone2_04_s_36","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_36","text":"We cannot thank you enough. We will be proceeding to the final stage of the Ark sealing procedure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_37","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_37","text":"Our expected time frame is 3 weeks. In the meantime, we must ask you to continue protecting us as you have been.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_38","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_s_38","text":"We will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_39","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_39","text":"Did you receive the supply shipment we sent?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_40","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_s_40","text":"Yes. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_41","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_s_41","text":"I've been meaning to ask, what is this plasticine-like substance? There doesn't seem to be enough of it for it to be reinforcement material.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_42","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_42","text":"Ah, that is Splendamin. It is going to be used as the primary food source in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_43","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_s_43","text":"This... is food?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_44","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_44","text":"Haha. I know that it's a far cry from mom's home-cooked food, but it really is the perfect superfood. At least, in theory. You could live a long, healthy life eating that and nothing else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_45","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_45","text":"Having said that, I'd recommend only eating it when you have to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_46","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_s_46","text":"Hehe, understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_47","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_04_s_47","text":"We'll continue to contact you on a daily basis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_48","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_04_s_48","text":"Sounds good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_49","type":"Speech","speaker":"collectrobot","key":"Locale_MainScenario:event_overzone2_04_s_49","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_04_s_50","type":"Speech","speaker":"collectrobot","key":"Locale_MainScenario:event_overzone2_04_s_50","text":"Communication ended.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":