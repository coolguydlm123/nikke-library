gArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_63","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_63","text":"your grades have plummeted, and I'm the reason for it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_64","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_64","text":"I can't let that continue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_65","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_65","text":"Besides, starting today I'll be busy with festival-related faculty meetings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_66","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_66","text":"So it might be better if we don't see each other for a while.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_67","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_67","text":"I'm sure there are still many wonderful things about school life you haven't discovered yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_68","type":"Self","speaker":null,"key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_68","text":"I highly doubt so...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_69","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_69","text":"Well then, I have to go. I have a meeting to attend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_70","type":"Speech","speaker":"privaty_t","key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_70","text":"Take care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_71","type":"Self","speaker":null,"key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_72","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_72","text":"Privaty leaves the teachers' office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_73","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_73","text":"Can she really be this firm now that she's a teacher?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_74","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_twoxtwolove_2ch_02_s_p_02_74","text":"Disappointment and gloom wash over me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_twoxtwolove_2ch_02_s_p_02_75","typ