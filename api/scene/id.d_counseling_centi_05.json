{"id":"d_counseling_centi_05","cat":"counsel","group":{"id":"char5021","label":"Centi"},"label":"Advising Centi: 05","stage":null,"prev":"d_counseling_centi_04","next":"d_counseling_centi_06","speakers":{"centi":"Centi"},"icons":{"centi":"si_c080_00_s"},"lines":[{"id":"d_counseling_centi_05_1","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_1","text":"One time, my hammer broke and we had to stop working for a while!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["centi"],"affinity":"_0"},{"id":"d_counseling_centi_05_2","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_2","text":"Because of that delay, we couldn't finish the building according to schedule!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_3","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_3","text":"A building schedule is like a promise!\nI can't go around breaking my promises!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_centi_05_4","text":"Bad things happen from time to time!","jump":"d_counseling_centi_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_centi_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_centi_05_5","text":"A good builder does not blame their tools!","jump":"d_counseling_centi_05_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_centi_05_6","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_6","text":"I didn't come to you for comforting words, Boss!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_7","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_7","text":"I'm gonna keep working hard and do my best!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_8","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_8","text":"Boss! Are you telling me I'm not good enough?","jump":"d_counseling_centi_05_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_9","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_10","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_10","text":"Oh, I got it!\nWhat you meant was: where there's a will, there's a way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_11","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_05_11","text":"Ok! Next time my hammer breaks, I'll keep hammering with my fists!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_05_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_centi_05_12","text":"I discuss the importance of tools with Centi.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}