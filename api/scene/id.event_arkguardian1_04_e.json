_arkguardian1_04_e_6","text":"I truly hate this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_e_7","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_04_e_7","text":"What exactly do you hate so much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_arkguardian_flowerfades_loop","movie":null,"shown":["liliweiss"],"affinity":null},{"id":"event_arkguardian1_04_e_8","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_e_8","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_e_9","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_04_e_9","text":"If you're startled, can't you at least react like you are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_e_10","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_e_10","text":"I didn't think anyone else was here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_e_11","type":"Speech","speaker":"liliweiss","key":"Locale_MainScenario:event_arkguardian1_04_e_11","text":"Didn't you hear? I even knocked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkguardian1_04_e_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_arkguardian1_04_e_12","text":"Oh... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkgua