inity":null},{"id":"d_main_50_af_05_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_05_14","text":"Friend!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_15","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_af_05_15","text":"All the other Mother Whales went back! I'm so relieved that none of them got seriously hurt!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_16","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_50_af_05_16","text":"But Uncle got seriously hurt. They had to treat him here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_17","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_05_17","text":"Wait, you got hurt?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_18","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_af_05_18","text":"Haha! It was nothing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_19","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_af_05_19","text":"It was a good experience. It makes all the pain worth it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_20","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_af_05_20","text":"Really, it was nothing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_21","type":"Speech","speaker":"pinocchio","key":"Locale_MainScenario:d_main_50_af_05_21","text":"Yeah! It was a good experience!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_22","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_af_05_22","text":"I want to tell you all about it at some point, so let's meet up again later!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_05_23","text":"Okay. I can't wait to hear about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_05_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_25","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_50_af_05_25","text":"Friend, I don't see any Raptures on the surface. Do you know anything about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_26","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_af_05_26","text":"Hmm... You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_50_af_05_27","type":"Speech","speaker":"raptilion","key":"Locale_MainScenario:d_main_50_af_05_27","text":"I did think that was strange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":nu