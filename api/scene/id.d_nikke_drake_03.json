ch","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_120","text":"Damages, big and small, were also an issue that plagued the bike paths due to speeding cyclists.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_121","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_121","text":"Fortunately, these cyclists were kept on their toes by Drake's decision to walk on the bicycle path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_122","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_122","text":"She taught us a valuable lesson.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_123","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_123","text":"She showed us how dangerous it is when we act like we're the only ones on the road.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_124","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_124","text":"Drake's good deeds have made a lasting impression on the Ark tonight, and Missilis's industry shares are rising in small quantities...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_125","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_125","text":"Damn...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_126","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_126","text":"What the heck is this?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_127","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_127","text":"What a good Samaritan you are.","jump":"d_nikke_drake_03_129","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_128","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_128","text":"Some villainous debut.","jump":"d_nikke_drake_03_129","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_129","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_129","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_130","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_130","text":"No! Now my reputation as a hero will be cemented in everyone's minds!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_131","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_131","text":"I must do something about this!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}