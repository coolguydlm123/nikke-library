ll,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_83","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_83","text":"Tired already? Your weakness sickens me. Our reign of terror has only just begun!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_84","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_84","text":"You're a disgrace to the Villain Union.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_85","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_85","text":"Drake sits on the sofa in my room and turns on the TV.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_86","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_86","text":"You're not going back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_87","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_87","text":"We really caused a commotion out there. I mean, we're bound to make the news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_88","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_88","text":"Once the news comes on and covers us, I will be immortalized as the infamous villain I was meant to be!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_89","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_89","text":"It'd be a miracle if we even get a tiny blurb in the online news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_90","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_90","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_91","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_91","text":"That's right. They might conceal information to keep the public in the dark and maintain peace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_92","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_92","text":"I didn't think about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_93","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_93","text":"Next time, I will take a video myself and upload it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_94","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_94","text":"Matis, the strongest squad in the Missilis industry, needs no introduction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_95","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_95","text":"Today, there have been several reports regarding a member of the Matis, Drake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_96","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_96","text":"They're talking about it! I told you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_97","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_97","text":"... No way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_98","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_98","text":"Mwahaha! Let's see what they have to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_99","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_99","text":"My life as a villain is off to a wonderful start!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_100","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_100","text":"Here we see Drake's signature hanging at a small downtown restaurant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_herecomestrouble","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_101","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_101","text":"It is a signature of a Matis member, widely considered a hero amongst those living in the Ark! Many citizens have gathered to see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_102","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_102","text":"All the citizens who ate at the restaurant gave nothing but rave reviews, commenting on the exquisite taste of the food served at the establishment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_103","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_103","text":"This positive word-of-mouth spread like wildfire, and the restaurant has flourished practically overnight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_104","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_104","text":"In fact, behind this restaurant lies a tragic backstory. Some years back, the child of the restaurant owner voluntarily became a Nikke and lost her life in a battle up on the surface.","jump":null,"exit":false,"enter":null,"bg":"FastFood","bgArt":"fastfood","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_105","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_105","text":"Drake, who fought alongside her at the time, continues to visit the restaurant to comfort the mother who lost her daughter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_106","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_106","text":"Due to Drake's kindness, the restaurant has been able to stay afloat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_107","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_107","text":"And the citizens of the Ark have found a hidden gem.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_108","type":"Speech","speaker":"drake","key":"Locale_NikkeEpisode:d_nikke_drake_03_108","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["drake"],"affinity":null},{"id":"d_nikke_drake_03_109","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_109","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_110","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_110","text":"Drake's good deeds do not end there.","jump":null,"exit":false,"enter":null,"bg":"ShoppingMall","bgArt":"shoppingmall","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_111","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_111","text":"Sliced Splendamin has recently become the latest culinary craze downtown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_112","type":"Speech","speaker":"announcer","key":"Locale_NikkeEpisode:d_nikke_drake_03_112","text":"But a tip from a helpful citizen revealed that raw materials used to make the dish contained industrial waste.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_drake_03_113","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_drake_03_113","text":"I was suspicious because (Drake) bought the entire stock.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":n