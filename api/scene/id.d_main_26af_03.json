{"id":"d_main_26af_03","cat":"main","group":{"id":"ch26","label":"Chapter 26 · Return"},"label":"Newcomer","stage":null,"prev":"d_main_26af_02","next":null,"speakers":{"shifty_c":"Shifty","anis":"Anis","neon":"Neon","shifty":"Shifty","rapi":"Rapi"},"icons":{"shifty_c":"si_c907_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","shifty":"si_c907_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_26af_03_1","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_26af_03_1","text":"Let's see...","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":"bgm_aztec","movie":null,"shown":["rapi","anis","neon","shifty_c"],"affinity":null},{"id":"d_main_26af_03_2","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_26af_03_2","text":"We've organized all the supplies that were sent up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_3","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_26af_03_3","text":"The accommodation and other living quarters are all in place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_4","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_26af_03_4","text":"I think we've covered just about everything that needs doing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_5","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_26af_03_5","text":"Thanks for all the hard work you've been putting in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_6","type":"Speech","speaker":"shifty_c","key":"Locale_MainScenario:d_main_26af_03_6","text":"I barely did anything. The ones who had to transport this stuff are the real hard workers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_26af_03_7","text":"Preach, sister. Manual labor is the really tough part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_26af_03_8","text":"I've been meaning to ask you, Shifty,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_9","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_26af_03_9","text":"will you be helping us from now on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_10","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_10","text":"Yes. I've been officially appointed as a dedicated operator for the Commando Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_26af_03_11","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_11","text":"I've worked alongside you all before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_12","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_12","text":"and I performed exceptionally well in the recent standardized operator exams.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_26af_03_13","text":"You're not actually going to be joining us in person, are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_14","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_14","text":"No, it's still too dangerous up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_15","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_15","text":"If it weren't for the Ark, our job prospects as operators would be quite limited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_16","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_16","text":"Of course, you all have managed to do just fine without much outside assistance,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_17","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_17","text":"but having a dedicated operator can make a world of difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_18","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_18","text":"I memorized the map the Commander brought and I've assessed all the potential scenarios that might pose a risk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_19","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_19","text":"Naturally,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_20","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_20","text":"since we are exploring uncharted territory, there is a high chance that something unexpected will occur.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_21","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_21","text":"Even verbal support from my end could be a lifesaver during any unexpected situations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_22","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_22","text":"Also, perhaps most importantly,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_23","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_26af_03_23","text":"I can handle most of the Commander's administrative tasks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_24","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_26af_03_24","text":"Wow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_26af_03_25","text":"That certainly got your attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_26af_03_26","typ