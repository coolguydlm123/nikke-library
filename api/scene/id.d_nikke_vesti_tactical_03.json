ull,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_72","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_72","text":"Commander, did you enjoy the movie?","jump":null,"exit":false,"enter":null,"bg":"Cafe","bgArt":"cafe","image":null,"bgm":"bgm_story_girlstalk","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_73","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_73","text":"Yeah, I did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_74","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_74","text":"Hehe, that's a relief. I-it was different from what I expected, but I still enjoyed it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_75","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_75","text":"You know, I was really surprised when the villain suddenly popped out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_76","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_76","text":"Because the main character's plan got messed up, I was super t-tense, wondering what would happen next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_77","text":"Yeah, I'm just glad it worked out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_78","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_78","text":"Yeah, that's right. The villain failed to thwart the main character's plan, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_79","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_79","text":"That's what I really liked about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_80","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_80","text":"O-oh, wow... this cake is really delicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_81","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_81","text":"Um... C-Commander,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_82","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_82","text":"I was wondering what your cake tastes like. C-can I try some?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_83","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_83","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_84","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_84","text":"Uh, y-yeah. Thanks. Hehe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_85","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_85","text":"Um, Commander, I-I can't reach, so could you...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_86","type":"Speech","speaker":"unknown","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_86","text":"My oh my! Look who it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_87","type":"Speech","speaker":"unknown","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_87","text":"To cross paths with Partner and Blue-Eyed Little Devil here... No wonder the seal was acting up so much today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_88","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_88","text":"Is that... Guillotine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_89","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_89","text":"To think you'd recognize me without even looking... As expected of you, Partner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_darklord","movie":null,"shown":["guillotine"],"affinity":null},{"id":"d_nikke_vesti_tactical_03_90","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_90","text":"Yes, it is I, Guillotine de Mephisto.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_91","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_91","text":"Heh heh. Some call this fate... no, destiny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_92","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_92","text":"... Uh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_93","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_93","text":"Hm? What troubles you, Blue-Eyed Little Devil? Do you have something you wish to say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_94","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_94","text":"N-no... It's not like that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_95","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_95","text":"... B-Blue-Eyed Little Devil...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_96","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_96","text":"Very well then. What business has brought you two together?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_97","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_97","text":"Has the Big O commenced a new operation which I'm unaware of?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_98","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_98","text":"We're just spending our day off together, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_99","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_99","text":"I see. It's a relief nothing urgent has come to pass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_100","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_100","text":"Had it, a tragedy would have surely occurred, forcing me to shatter the solemn oath I hold with a dear comrade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_101","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_101","text":"So, what're you doing here, Guillotine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_102","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_102","text":"Heh. Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_103","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_103","text":"I'm waiting to consult with a fellow from The Association about our future plans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_104","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_104","text":"The threat posed by the Big O draws ever nearer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_105","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_105","text":"Ah! Come to think of it, are you not part of the Big O, Blue-Eyed Little Devil?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_106","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_106","text":"Th-the Big O?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_107","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_107","text":"Tch, that I would make such a blunder... I must've been too absorbed in my rendezvous with a comrade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_108","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_108","text":"Guillotine, don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_109","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_109","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_110","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_110","text":"She's no longer with The Big O. I've got her under control now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_111","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_111","text":"Ah, so it is. Once again, I find myself indebted to you, Partner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_112","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_112","text":"I am without excuse. I cannot believe I did you such a discourtesy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_113","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_113","text":"... Ah, how time flies! The fated hour has come during our brief council.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_114","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_114","text":"Though but a fleeting moment, I am glad to have met you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_115","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_115","text":"I must now take my leave to meet my comrade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_116","type":"Speech","speaker":"guillotine","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_116","text":"Farewell, Partner, Blue-Eyed Little Devil. May you have a most pleasant time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_117","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_117","text":"Guillotine strikes a dramatic pose, then leaves the cafe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_118","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_118","text":"... Again... an interruption...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_119","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_119","text":"Huh? What was that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_120","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_120","text":"I-it's nothing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_03_121","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_03_121","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinit