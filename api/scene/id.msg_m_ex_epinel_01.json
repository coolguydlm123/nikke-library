{"id":"msg_m_ex_epinel_01","cat":"messenger","group":{"id":"room_epinel","label":"Epinel · Nikke"},"label":"1. Hey there.","stage":null,"prev":null,"next":"msg_m_ex_epinel_02","speakers":{"epinel":"Epinel"},"icons":{"epinel":"si_c241_00_s"},"lines":[{"id":"m_ex_epinel_01_1","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_1","text":"Hey there.","jump":null},{"id":"m_ex_epinel_01_2","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_2","text":"Is this Coach?","jump":null},{"id":"m_ex_epinel_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_epinel_01_3","text":"That's right.","jump":null},{"id":"m_ex_epinel_01_4","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_4","text":"I was just thinking that since we're teamed up now,","jump":null},{"id":"m_ex_epinel_01_5","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_5","text":"I may need to speak to you.","jump":null},{"id":"m_ex_epinel_01_6","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_6","text":"I'm looking forward to working with you.","jump":null},{"id":"m_ex_epinel_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_epinel_01_7","text":"Likewise.","jump":null},{"id":"m_ex_epinel_01_8","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_8","text":"Well...","jump":null},{"id":"m_ex_epinel_01_9","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_9","text":"What else should I say?","jump":null},{"id":"m_ex_epinel_01_10","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_10","text":"I'm a Nikke in sports entertainment","jump":null},{"id":"m_ex_epinel_01_11","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_11","text":"and mostly skate using a skateboard.","jump":null},{"id":"m_ex_epinel_01_12","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_12","text":"It really depends on the weather. Sometimes I'll skate on a snowboard or a surfboard.","jump":null},{"id":"m_ex_epinel_01_13","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_epinel_01_13","text":"So you're a pro skater.","jump":"m_ex_epinel_01_15"},{"id":"m_ex_epinel_01_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_epinel_01_14","text":"You're such a sporting all-rounder.","jump":"m_ex_epinel_01_15"},{"id":"m_ex_epinel_01_15","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_15","text":"If you say so.","jump":null},{"id":"m_ex_epinel_01_16","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_16","text":"I'm the kind of Nikke who's made that way.","jump":null},{"id":"m_ex_epinel_01_17","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_17","text":"Anyway, looking forward to working with you.","jump":null},{"id":"m_ex_epinel_01_18","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_18","text":"Oh right, one more thing.","jump":null},{"id":"m_ex_epinel_01_19","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_19","text":"If there are any letters from kids or something else sent to the dorm,","jump":null},{"id":"m_ex_epinel_01_20","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_20","text":"just send it to my room.","jump":null},{"id":"m_ex_epinel_01_21","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_21","text":"They are probably from my fans.","jump":null},{"id":"m_ex_epinel_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_epinel_01_22","text":"Your fans?","jump":null},{"id":"m_ex_epinel_01_23","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_23","text":"Yes.","jump":null},{"id":"m_ex_epinel_01_24","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_24","text":"After all, my sport is for younger people.","jump":null},{"id":"m_ex_epinel_01_25","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_25","text":"My fans are mostly kids or teens.","jump":null},{"id":"m_ex_epinel_01_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_epinel_01_26","text":"Actually, there have been like 20 letters sent to the dorm.","jump":null},{"id":"m_ex_epinel_01_27","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_27","text":"Really?","jump":null},{"id":"m_ex_epinel_01_28","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_28","text":"They're so quick.","jump":null},{"id":"m_ex_epinel_01_29","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_29","text":"Thanks for telling me.","jump":null},{"id":"m_ex_epinel_01_30","type":"Speech","speaker":"epinel","key":"Locale_SuddenMessage:m_ex_epinel_01_30","text":"I'll go get them now.","jump":null},{"id":"m_ex_epinel_01_31","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_epinel_01_31","text":"I put all the letters together so that Epinel can take them easily.","jump":null}],"chat":true}