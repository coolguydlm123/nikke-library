{"id":"msg_m_ex_mary_01","cat":"messenger","group":{"id":"room_mary","label":"Mary · Nikke"},"label":"1. *Knock knock* Are you there?","stage":null,"prev":null,"next":"msg_m_ex_mary_02","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"m_ex_mary_01_1","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_1","text":"*Knock knock* Are you there?","jump":null},{"id":"m_ex_mary_01_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_2","text":"Yes.","jump":null},{"id":"m_ex_mary_01_3","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_3","text":"Haha, here you are!","jump":null},{"id":"m_ex_mary_01_4","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_4","text":"Hi there, Commander.","jump":null},{"id":"m_ex_mary_01_5","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_5","text":"We're finally together.","jump":null},{"id":"m_ex_mary_01_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_6","text":"Finally?","jump":null},{"id":"m_ex_mary_01_7","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_7","text":"Yes.","jump":null},{"id":"m_ex_mary_01_8","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_8","text":"Everyone says it's nice to go on a mission with you, Commander.","jump":null},{"id":"m_ex_mary_01_9","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_9","text":"The rumors are everywhere.","jump":null},{"id":"m_ex_mary_01_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_10","text":"I've never heard of that before.","jump":null},{"id":"m_ex_mary_01_11","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_11","text":"Really?","jump":null},{"id":"m_ex_mary_01_12","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_12","text":"That's weird.","jump":null},{"id":"m_ex_mary_01_13","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_13","text":"Nikkes, who come to our hospital, always talk about it.","jump":null},{"id":"m_ex_mary_01_14","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_14","text":"Anyway,","jump":null},{"id":"m_ex_mary_01_15","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_15","text":"the rumors don't matter.","jump":null},{"id":"m_ex_mary_01_16","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_16","text":"What really matters is that I'm finally going to experience it myself!","jump":null},{"id":"m_ex_mary_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_17","text":"I see.","jump":null},{"id":"m_ex_mary_01_18","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_18","text":"Commander,","jump":null},{"id":"m_ex_mary_01_19","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_19","text":"since you're now with me,","jump":null},{"id":"m_ex_mary_01_20","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_20","text":"please let me know if you ever feel uncomfortable with anything.","jump":null},{"id":"m_ex_mary_01_21","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_21","text":"Understand?","jump":null},{"id":"m_ex_mary_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_22","text":"That sounds scary.","jump":null},{"id":"m_ex_mary_01_23","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_23","text":"C'mon, hahaha.","jump":null},{"id":"m_ex_mary_01_24","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_24","text":"Don't be afraid of the doctor ^^","jump":null},{"id":"m_ex_mary_01_25","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_25","text":"I'm not going to give you a painful injection ^^","jump":null},{"id":"m_ex_mary_01_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_26","text":"I'll try my best to stay healthy.","jump":null},{"id":"m_ex_mary_01_27","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_27","text":"Well, that's good to hear.","jump":null},{"id":"m_ex_mary_01_28","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_28","text":"To get you to be more determined,","jump":null},{"id":"m_ex_mary_01_29","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_29","text":"I'll need to prepare more really painful shots.","jump":null},{"id":"m_ex_mary_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_30","text":"You just mentioned you weren't going to do that.","jump":null},{"id":"m_ex_mary_01_31","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_31","text":"Hahaha, did I mention that before?","jump":null},{"id":"m_ex_mary_01_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_32","text":"Yeah, I have it on record.","jump":null},{"id":"m_ex_mary_01_33","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_33","text":"Wow, you're right.","jump":null},{"id":"m_ex_mary_01_34","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_34","text":"There is no response for a long time.","jump":null},{"id":"m_ex_mary_01_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_35","text":"Mary?","jump":null},{"id":"m_ex_mary_01_36","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_36","text":"Huh? It seems that I can't recall those messages after sending them.","jump":null},{"id":"m_ex_mary_01_37","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_37","text":"What a pity. I can't destroy the evidence ^^","jump":null},{"id":"m_ex_mary_01_38","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_38","text":"I'll just have to be careful next time ^^","jump":null},{"id":"m_ex_mary_01_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_39","text":"Careful in destroying evidence?","jump":null},{"id":"m_ex_mary_01_40","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_40","text":"Hahaha, there's no way to do that.","jump":null},{"id":"m_ex_mary_01_41","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_41","text":"I'll let you off the hook for now.","jump":null},{"id":"m_ex_mary_01_42","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_mary_01_42","text":"Please don't hurt me in the future.","jump":null},{"id":"m_ex_mary_01_43","type":"Speech","speaker":"mary","key":"Locale_SuddenMessage:m_ex_mary_01_43","text":"We'll see about that. Hahaha.","jump":null}],"chat":true}