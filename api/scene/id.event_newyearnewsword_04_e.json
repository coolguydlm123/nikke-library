ch","speaker":"hongryeon_o","key":"Locale_SubScenario:event_newyearnewsword_04_e_25","text":"How can thee, as a Nikke, utter such profane words?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_04_e_26","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_04_e_26","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_04_e_27","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_04_e_27","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_04_e_28","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_04_e_28","text":"That's exactly what I'm proposing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_04_e_29","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_04_e_29","text":"Because if we don't, we're going to die out here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_04_e_30","type":"Speech","speaker":"hongryeon_o","key":"Locale_SubScenario:event_newyearnewsword_04_e_30","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_04_e_31","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_04_e_31","text":"Did you get a glimpse at the mission briefing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":n