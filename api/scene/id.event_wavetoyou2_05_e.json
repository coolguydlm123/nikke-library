ffinity":null},{"id":"event_wavetoyou2_05_e_17","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_05_e_17","text":"Why would someone want to keep the Island Eater here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_18","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_wavetoyou2_05_e_18","text":"There's no way to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_19","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_wavetoyou2_05_e_19","text":"But there is a lighthouse on this island,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_20","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_wavetoyou2_05_e_20","text":"and all those murals we saw.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_21","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_wavetoyou2_05_e_21","text":"That must mean people used to live here a long time ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_22","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_wavetoyou2_05_e_22","text":"Based on what we know so far,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_23","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_wavetoyou2_05_e_23","text":"they're probably the ones who wanted to keep the Island Eater bound here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_24","type":"Speech","speaker":"littlemermaid_s","key":"Locale_MainScenario:event_wavetoyou2_05_e_24","text":"That makes sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_25","type":"Speech","speaker":"marciana_s","key":"Locale_MainScenario:event_wavetoyou2_05_e_25","text":"The problem is deciding what to do from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_26","type":"Self","speaker":null,"key":"Locale_MainScenario:event_wavetoyou2_05_e_26","text":"What if we destroy the main unit underground?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_27","type":"Self","speaker":null,"key":"Locale_MainScenario:event_wavetoyou2_05_e_27","text":"When the main unit shut down earlier, the Island Eater started to wake up, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_28","type":"Self","speaker":null,"key":"Locale_MainScenario:event_wavetoyou2_05_e_28","text":"Well, if it completely wakes up, it'll naturally get away from the island.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_wavetoyou2_05_e_29","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_wavetoyou2_05_e_29","text":"That may be the fastest option, but it's also dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"af