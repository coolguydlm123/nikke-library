xt":"If the Admire's navigational systems fail, a single compass isn't going to be of much help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_82","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_82","text":"... Well, if nothing else, it's very Helm-like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_83","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:treasurestory_helm_03_83","text":"Hold up, how come the needle keeps moving?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_84","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_helm_03_84","text":"Instead of remaining in a fixed position, the needle of the old compass sways back and forth erratically.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_85","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:treasurestory_helm_03_85","text":"It must be the Ark's magnetic field.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_86","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_86","text":"The Ark's power grid does shift the magnetic field by a significant margin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_87","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_87","text":"Something operating on the principles of ordinary magnetism doesn't stand a chance here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_88","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_88","text":"After all, the Ark's energy output is far greater, don't you think? Not to mention it being way closer than the distance between the North and South Pole.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_89","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:treasurestory_helm_03_89","text":"Oooh, you're so smart, Mast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_90","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_90","text":"Hehe. So...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_91","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_helm_03_91","text":"Mast pulls out a similar compass from her pocket.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_92","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_92","text":"That's why we use specially calibrated compasses like this one!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_93","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_93","text":"That ancient compass of Helm's is probably busted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_94","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:treasurestory_helm_03_94","text":"You carry around a compass too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_95","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_95","text":"Of course! You never know when you'll need to set sail in a little rowboat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_96","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_96","text":"A true pirate is always ready for adventure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_97","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:treasurestory_helm_03_97","text":"Why were you looking for that compass anyway, Helm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_98","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:treasurestory_helm_03_98","text":"Because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_99","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_helm_03_99","text":"Helm looks at Mast's compass, whose needle is firmly pointing north.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_100","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_helm_03_100","text":"She then looks down at her compass, whose needle is wandering aimlessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_101","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:treasurestory_helm_03_101","text":"I think a new goal has come into view.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_102","type":"Speech","speaker":"mast","key":"Locale_NikkeEpisode:treasurestory_helm_03_102","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_103","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:treasurestory_helm_03_103","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"treasurestory_helm_03_104","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:treasurestory_helm_03_104","text":"Mast and Anchor silently exchange a look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}