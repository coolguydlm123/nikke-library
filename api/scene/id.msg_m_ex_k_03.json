{"id":"msg_m_ex_k_03","cat":"messenger","group":{"id":"room_k","label":"K · Nikke"},"label":"3. {AccountData.NickName}.","stage":null,"prev":"msg_m_ex_k_02","next":null,"speakers":{"k":"K"},"icons":{"k":"si_c041_00_s"},"lines":[{"id":"m_ex_k_03_1","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_1","text":"{AccountData.NickName}.","jump":null},{"id":"m_ex_k_03_2","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_2","text":"Got a minute?","jump":null},{"id":"m_ex_k_03_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_3","text":"Right now?","jump":null},{"id":"m_ex_k_03_4","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_4","text":"Yeah.","jump":null},{"id":"m_ex_k_03_5","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_5","text":"Take a look at this.","jump":null},{"id":"m_ex_k_03_6","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_6","text":"Hey honey, are you free this evening? Let's hang out! AK4234","jump":null},{"id":"m_ex_k_03_7","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_7","text":"Okay, where should we go?","jump":"m_ex_k_03_9"},{"id":"m_ex_k_03_8","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_8","text":"Did you get a spam message?","jump":"m_ex_k_03_12"},{"id":"m_ex_k_03_9","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_9","text":"%@$%@","jump":null},{"id":"m_ex_k_03_10","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_10","text":"Are you messing with me?","jump":null},{"id":"m_ex_k_03_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_11","text":"Hehe. Did you get a spam message?","jump":"m_ex_k_03_12"},{"id":"m_ex_k_03_12","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_12","text":"Yeah. I think it came in the day before yesterday.","jump":null},{"id":"m_ex_k_03_13","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_13","text":"Something about it didn't smell right,","jump":null},{"id":"m_ex_k_03_14","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_14","text":"so I tried adding them to dig deeper.","jump":null},{"id":"m_ex_k_03_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_15","text":"But it didn't go well?","jump":null},{"id":"m_ex_k_03_16","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_16","text":"Not at all. I think they caught on to me.","jump":null},{"id":"m_ex_k_03_17","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_17","text":"Unlike D,","jump":null},{"id":"m_ex_k_03_18","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_18","text":"I'm not the best at acting.","jump":null},{"id":"m_ex_k_03_19","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_19","text":"What strategy did you go for?","jump":null},{"id":"m_ex_k_03_20","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_20","text":"I switched to a different account. Here, I'll show you.","jump":null},{"id":"m_ex_k_03_21","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_21","text":"Robert: So, where are we going?  Lina: Anywhere is okay with me.\nLina: Are you rich, Big Boy?             Robert: I am.\nLina: Really?? How much?           Robert: Let's talk when we meet.\nLina: Hehe. You wanted to see me that bad?\nLina: I'm kind of expensive. You okay with that?\nRobert: How expensive, exactly?","jump":null},{"id":"m_ex_k_03_22","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_22","text":"Ugh, why is copy-paste so messed up here?","jump":null},{"id":"m_ex_k_03_23","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_23","text":"Whatever. You get the idea.","jump":null},{"id":"m_ex_k_03_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_24","text":"It seems fine to me.","jump":null},{"id":"m_ex_k_03_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_25","text":"Is that everything?","jump":null},{"id":"m_ex_k_03_26","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_26","text":"Yeah. They stopped responding after that.","jump":null},{"id":"m_ex_k_03_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_27","text":"Hmm...","jump":null},{"id":"m_ex_k_03_28","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_28","text":"You should make a new ID and message them too.","jump":null},{"id":"m_ex_k_03_29","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_29","text":"If they respond, that means I got them.","jump":null},{"id":"m_ex_k_03_30","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_30","text":"If not, something else is up.","jump":null},{"id":"m_ex_k_03_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_31","text":"Got it. I'll try.","jump":null},{"id":"m_ex_k_03_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_32","text":"Look at you, making secondary accounts. You're starting to get the hang of BlaBla.","jump":null},{"id":"m_ex_k_03_33","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_33","text":"You're mistaken in thinking I don't know how to use this app.","jump":null},{"id":"m_ex_k_03_34","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_34","text":"I just didn't care about it.","jump":null},{"id":"m_ex_k_03_35","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_35","text":"Figuring out how to use it is easy.","jump":null},{"id":"m_ex_k_03_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_36","text":"Ha, fair enough.","jump":null},{"id":"m_ex_k_03_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_37","text":"Okay.","jump":null},{"id":"m_ex_k_03_38","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_38","text":"I create an anonymous account, and get a response to a message I sent to Lina.","jump":null},{"id":"m_ex_k_03_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_39","text":"She replied.","jump":null},{"id":"m_ex_k_03_40","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_40","text":"So they found me out.","jump":null},{"id":"m_ex_k_03_41","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_41","text":"Try luring her out slowly.","jump":null},{"id":"m_ex_k_03_42","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_42","text":"That's something you're good at.","jump":null},{"id":"m_ex_k_03_43","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_43","text":"All right.","jump":null},{"id":"m_ex_k_03_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_44","text":"Anyway,","jump":null},{"id":"m_ex_k_03_45","type":"Speech","speaker":"k","key":"Locale_SuddenMessage:m_ex_k_03_45","text":"I'll be standing by.","jump":null},{"id":"m_ex_k_03_46","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_k_03_46","text":"I'll let you know once everything's set.","jump":null}],"chat":true}