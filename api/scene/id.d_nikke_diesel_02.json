ke_diesel_02_56","text":"Government officials who know we are Nikkes will say,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_02_57","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_diesel_02_57","text":"\"How can a robot be too sick to attend a meeting? If she's broken, fix her and bring her out!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_02_58","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_diesel_02_58","text":"Something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_02_59","type":"Speech","speaker":"brid","key":"Locale_NikkeEpisode:d_nikke_diesel_02_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_02_60","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_diesel_02_60","text":"Shouldn't I just go attend a little memorial to put a stop to that? They're hurting Brid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_02_61","type":"Speech","speaker":"brid","key":"Locale_NikkeEpisode:d_nikke_diesel_02_61","text":"Their words can't hurt me, no matter how hard they try.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_diesel_02_62","type":"Speech","speaker":"diesel","key":"Locale_NikkeEpisode:d_nikke_diesel_02_62","text":"Too much of anything is bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}