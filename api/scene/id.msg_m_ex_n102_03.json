{"id":"msg_m_ex_n102_03","cat":"messenger","group":{"id":"room_n102","label":"N102 · Nikke"},"label":"3. Teacher, what are you doing?","stage":null,"prev":"msg_m_ex_n102_02","next":"msg_m_ex_anne_miraclefairy_01","speakers":{"n102":"N102"},"icons":{"n102":"si_c120_00_s"},"lines":[{"id":"m_ex_n102_03_1","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_1","text":"Teacher, what are you doing?","jump":null},{"id":"m_ex_n102_03_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_2","text":"Not much. How about you?","jump":null},{"id":"m_ex_n102_03_3","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_3","text":"I've got a hankering for some croquette, so","jump":null},{"id":"m_ex_n102_03_4","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_4","text":"I'm about to head out now.","jump":null},{"id":"m_ex_n102_03_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_5","text":"Do you enjoy anything other than croquette?","jump":null},{"id":"m_ex_n102_03_6","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_6","text":"Hmm, there may have been something once...","jump":null},{"id":"m_ex_n102_03_7","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_7","text":"but I can't remember T^T","jump":null},{"id":"m_ex_n102_03_8","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_8","text":"What about you? What do you like?","jump":null},{"id":"m_ex_n102_03_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_9","text":"Top-tier filet mignon.","jump":"m_ex_n102_03_11"},{"id":"m_ex_n102_03_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_10","text":"Tuna belly, with lots of fat.","jump":"m_ex_n102_03_11"},{"id":"m_ex_n102_03_11","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_11","text":"You're making me","jump":null},{"id":"m_ex_n102_03_12","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_12","text":"want to try some too.","jump":null},{"id":"m_ex_n102_03_13","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_13","text":"What does it taste like?","jump":null},{"id":"m_ex_n102_03_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_14","text":"It melts in your mouth.","jump":"m_ex_n102_03_16"},{"id":"m_ex_n102_03_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_15","text":"It's as if you've died and gone to heaven.","jump":"m_ex_n102_03_16"},{"id":"m_ex_n102_03_16","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_16","text":"Woow...","jump":null},{"id":"m_ex_n102_03_17","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_17","text":"I've never tasted it myself, but","jump":null},{"id":"m_ex_n102_03_18","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_18","text":"the way you describe it sounds amazing!","jump":null},{"id":"m_ex_n102_03_19","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_19","text":"For me though,","jump":null},{"id":"m_ex_n102_03_20","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_20","text":"nothing beats croquette!","jump":null},{"id":"m_ex_n102_03_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_21","text":"We should go on a culinary trip.","jump":null},{"id":"m_ex_n102_03_22","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_22","text":"A culinary trip?","jump":null},{"id":"m_ex_n102_03_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_23","text":"It's when you travel to different places and eat the local delicacies.","jump":null},{"id":"m_ex_n102_03_24","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_24","text":"Holy moly!","jump":null},{"id":"m_ex_n102_03_25","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_25","text":"That sounds amazing!","jump":null},{"id":"m_ex_n102_03_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_26","text":"Do you want to go?","jump":null},{"id":"m_ex_n102_03_27","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_27","text":"You bet I do!","jump":null},{"id":"m_ex_n102_03_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_28","text":"Then make your way to the Commander's Room.","jump":null},{"id":"m_ex_n102_03_29","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_29","text":"Right now?","jump":null},{"id":"m_ex_n102_03_30","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_30","text":"Are we leaving today?","jump":null},{"id":"m_ex_n102_03_31","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_31","text":"When inspiration strikes, you've got to grab it.","jump":null},{"id":"m_ex_n102_03_32","type":"Speech","speaker":"n102","key":"Locale_SuddenMessage:m_ex_n102_03_32","text":"All right, I'm on my way!","jump":null},{"id":"m_ex_n102_03_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_n102_03_33","text":"I'll be waiting.","jump":null}],"chat":true}