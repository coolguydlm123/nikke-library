y.","jump":"snowfall_speech_ludmilla_31_32","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_31_32","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_31_32","text":"I feel as if a burden has been lifted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_31_33","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_31_33","text":"Just like the other day, Ludmilla leans against me and gazes at the note that we hung up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_31_34","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_31_34","text":"At one particular moment, both of us turn our heads at the same time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_31_35","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_31_35","text":"The red note flutters in the wind, revealing the lettering written on it:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_31_36","type":"Monologue","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_31_36","text":"May we be happy forever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"snowfall_speech_ludmilla_31_37","type":"Narration","speaker":null,"key":"Locale_SubScenario:snowfall_speech_ludmilla_31_37","text":"Ludmilla and I wish for Lumi's happiness.","jump":null,"exit":f