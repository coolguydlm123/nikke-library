{"id":"d_counseling_chime_01","cat":"counsel","group":{"id":"char5157","label":"Chime"},"label":"Advising Chime: 01","stage":null,"prev":null,"next":"d_counseling_chime_02","speakers":{"chime":"Chime"},"icons":{"chime":"si_c331_00_s"},"lines":[{"id":"d_counseling_chime_01_1","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_01_1","text":"Rejoice! Thou art now a subject of the Crown Kingdom.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["chime"],"affinity":"_0"},{"id":"d_counseling_chime_01_2","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_01_2","text":"Hmm? Didst thou think any mere knave could earn such honor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_01_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_01_3","text":"Huh? I thought anyone could become one.","jump":"d_counseling_chime_01_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_chime_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_chime_01_4","text":"Thanks, it's an honor.","jump":"d_counseling_chime_01_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_chime_01_5","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_01_5","text":"How could it be so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_01_6","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_01_6","text":"Only after one hath received the grace of Her Highness and myself","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_01_7","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_01_7","text":"shalt they be granted the right to become a subject of the Crown Kingdom.","jump":"d_counseling_chime_01_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_01_8","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_01_8","text":"Aye, that is the attitude of a true subject.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_01_9","type":"Speech","speaker":"chime","key":"Locale_Counseling:d_counseling_chime_01_9","text":"Live always in gratitude for the boundless grace of Her Highness!","jump":"d_counseling_chime_01_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_chime_01_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_chime_01_10","text":"Chime and I talk about the subjects of the Crown Kingdom.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}