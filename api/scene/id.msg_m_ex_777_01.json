{"id":"msg_m_ex_777_01","cat":"messenger","group":{"id":"room_777","label":"777 · Group"},"label":"1. Pit Boss!!","stage":null,"prev":null,"next":"msg_m_ex_777_02","speakers":{"blanc":"Blanc","noir":"Noir"},"icons":{"blanc":"si_c270_00_s","noir":"si_c271_00_s"},"lines":[{"id":"m_ex_777_01_1","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_1","text":"Pit Boss!!","jump":null},{"id":"m_ex_777_01_2","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_2","text":"Are you busy?","jump":null},{"id":"m_ex_777_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_3","text":"Not really.","jump":null},{"id":"m_ex_777_01_4","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_4","text":"Okay, great!","jump":null},{"id":"m_ex_777_01_5","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_5","text":"What's the matter?","jump":null},{"id":"m_ex_777_01_6","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_6","text":"Um... Can you join our show?","jump":null},{"id":"m_ex_777_01_7","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_7","text":"Just this once? T^T","jump":null},{"id":"m_ex_777_01_8","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_8","text":"Me?","jump":null},{"id":"m_ex_777_01_9","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_9","text":"Yeah!","jump":null},{"id":"m_ex_777_01_10","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_10","text":"The one we were supposed to perform with stood us up.","jump":null},{"id":"m_ex_777_01_11","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_11","text":"Are you sure I'm qualified?","jump":null},{"id":"m_ex_777_01_12","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_12","text":"Of course!","jump":null},{"id":"m_ex_777_01_13","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_13","text":"You don't have to do much.","jump":null},{"id":"m_ex_777_01_14","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_14","text":"Just stand on the stage,","jump":null},{"id":"m_ex_777_01_15","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_15","text":"and Noir and I will take care of the rest.","jump":null},{"id":"m_ex_777_01_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_16","text":"Can you tell me what you're planning on doing?","jump":null},{"id":"m_ex_777_01_17","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_17","text":"Well...","jump":null},{"id":"m_ex_777_01_18","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_18","text":"After the show starts,","jump":null},{"id":"m_ex_777_01_19","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_19","text":"I'm going to run my hands over you.","jump":null},{"id":"m_ex_777_01_20","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_20","text":"Head to toe.","jump":null},{"id":"m_ex_777_01_21","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_21","text":"Then Blanc stands behind you, wraps her arms around you, and...","jump":null},{"id":"m_ex_777_01_22","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_22","text":"Noir doesn't reply for a while.","jump":null},{"id":"m_ex_777_01_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_23","text":"Then what?","jump":null},{"id":"m_ex_777_01_24","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_24","text":"Well...","jump":null},{"id":"m_ex_777_01_25","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_25","text":"...","jump":null},{"id":"m_ex_777_01_26","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_26","text":"I can't.","jump":null},{"id":"m_ex_777_01_27","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_27","text":"It's so weird talking about this over text.","jump":null},{"id":"m_ex_777_01_28","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_28","text":"Lol, don't be silly, Noir.","jump":null},{"id":"m_ex_777_01_29","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_29","text":"What's there to be embarrassed about?","jump":null},{"id":"m_ex_777_01_30","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_30","text":"It's just a simple show.","jump":null},{"id":"m_ex_777_01_31","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_31","text":"In a nutshell, Pit Boss, we'll be using you as an makeshift pole.","jump":null},{"id":"m_ex_777_01_32","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_32","text":"Other than that, it'll be the same show that we put on as always.","jump":null},{"id":"m_ex_777_01_33","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_33","text":"I see.","jump":null},{"id":"m_ex_777_01_34","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_34","text":"I'll take it that's a yes, then?","jump":null},{"id":"m_ex_777_01_35","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_35","text":"Um...","jump":null},{"id":"m_ex_777_01_36","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_36","text":"Could I sit down, by any chance?","jump":null},{"id":"m_ex_777_01_37","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_37","text":"Why?","jump":null},{"id":"m_ex_777_01_38","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_38","text":"Yeah, how come?","jump":null},{"id":"m_ex_777_01_39","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_39","text":"Er... my legs have been feeling weak lately.","jump":"m_ex_777_01_41"},{"id":"m_ex_777_01_40","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_40","text":"I've got stage fright.","jump":"m_ex_777_01_41"},{"id":"m_ex_777_01_41","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_41","text":"Huh?","jump":null},{"id":"m_ex_777_01_42","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_42","text":"You don't say...","jump":null},{"id":"m_ex_777_01_43","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_43","text":"In that case, maybe we should find someone else.","jump":null},{"id":"m_ex_777_01_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_44","text":"No! I want to perform with you.","jump":null},{"id":"m_ex_777_01_45","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_45","text":"Hmm...","jump":null},{"id":"m_ex_777_01_46","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_46","text":"Are you sure?","jump":null},{"id":"m_ex_777_01_47","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_47","text":"It'd be great if you could join us.","jump":null},{"id":"m_ex_777_01_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_48","text":"I can.","jump":null},{"id":"m_ex_777_01_49","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_49","text":"You see, Noir?","jump":null},{"id":"m_ex_777_01_50","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_50","text":"He can't wait to do it!","jump":null},{"id":"m_ex_777_01_51","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_51","text":"Everything's gonna be fine.","jump":null},{"id":"m_ex_777_01_52","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_52","text":"I hope so...","jump":null},{"id":"m_ex_777_01_53","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_53","text":"Anyway, let us know if you're having any trouble at any point.","jump":null},{"id":"m_ex_777_01_54","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_54","text":"Your health is far more important than the show.","jump":null},{"id":"m_ex_777_01_55","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_55","text":"For sure!","jump":null},{"id":"m_ex_777_01_56","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_56","text":"Could I have a blanket to put over my lap as well?","jump":null},{"id":"m_ex_777_01_57","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_57","text":"Huh? It'll be really hot, though...","jump":null},{"id":"m_ex_777_01_58","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_58","text":"Well, if you insist.","jump":null},{"id":"m_ex_777_01_59","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_59","text":"We're gonna tweak the choreography a bit. We'll let you know when we're done.","jump":null},{"id":"m_ex_777_01_60","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_60","text":"It's the first time the other person joining us on stage will be sitting, so we need to change some movements.","jump":null},{"id":"m_ex_777_01_61","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_61","text":"Thanks, I appreciate it.","jump":null},{"id":"m_ex_777_01_62","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_62","text":"You just sit back and relax. We'll handle the rest.","jump":null},{"id":"m_ex_777_01_63","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_63","text":"Once we've arranged a new routine, we'll set a date to practice together.","jump":null},{"id":"m_ex_777_01_64","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_01_64","text":"Got it.","jump":null},{"id":"m_ex_777_01_65","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_01_65","text":"Thanks, Pit Boss!","jump":null},{"id":"m_ex_777_01_66","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_01_66","text":"You're the best!","jump":null}],"chat":true}