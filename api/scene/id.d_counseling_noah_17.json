{"id":"d_counseling_noah_17","cat":"counsel","group":{"id":"char5043","label":"Noah"},"label":"Advising Noah: 17","stage":null,"prev":"d_counseling_noah_16","next":"d_counseling_noah_18","speakers":{"noah":"Noah"},"icons":{"noah":"si_c232_00_s"},"lines":[{"id":"d_counseling_noah_17_1","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_1","text":"I really don't like those Pioneer guys.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["noah"],"affinity":"_0"},{"id":"d_counseling_noah_17_2","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_2","text":"They're always going on about how they must protect humans, how everything is for mankind's benefit... blah, blah, blah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_3","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_3","text":"When have humans ever done anything for us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_noah_17_4","text":"As long as you continue walking your own path, you'll be fine.","jump":"d_counseling_noah_17_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_noah_17_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_noah_17_5","text":"True belief is greater than petty things like personal gain.","jump":"d_counseling_noah_17_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_noah_17_6","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_6","text":"Trust me, I was planning on it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_7","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_8","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_8","text":"But, just so you know, I don't mean to say I've never received anything from you.","jump":"d_counseling_noah_17_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_9","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_9","text":"Yeah yeah, but do beliefs put food on the table?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_10","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_10","text":"Seems like it's the opposite to me. Just look at Snow White, she's always going hungry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_11","type":"Speech","speaker":"noah","key":"Locale_Counseling:d_counseling_noah_17_11","text":"Anyway, all I'm saying is that we should all learn to live on our own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_noah_17_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_noah_17_12","text":"I have a conversation with Noah about Pilgrims who are on different paths.","jump":null,"exit":false,"e