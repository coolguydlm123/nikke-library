{"id":"event_boomtheghost1_05_e","cat":"event","group":{"id":"ev40084","label":"BOOM! THE GHOST! · Part 1"},"label":"BFG: B","stage":null,"prev":"event_boomtheghost1_05_s","next":"event_boomtheghost1_06_s","speakers":{"rapi_ss":"Rapi","dorothy_s":"Dorothy"},"icons":{"rapi_ss":"si_c016_01_s","dorothy_s":"si_c234_00_s"},"lines":[{"id":"event_boomtheghost1_05_e_1","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_1","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":"CruiseShipPool_n","bgArt":"cruiseshippool_n","image":null,"bgm":"none","movie":null,"shown":["rapi_ss","dorothy_s"],"affinity":null},{"id":"event_boomtheghost1_05_e_2","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_2","text":"I heard a loud noise over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_3","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_3","text":"Dorothy. Can you take a look?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whatsthat","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_4","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_4","text":"Go yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_5","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_5","text":"You have better mobility, so it makes sense for you to go... Was that convincing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_6","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_6","text":"If you just admit that you won't go because you're scared of ghosts, then I'll go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_7","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_7","text":"Dorothy. Let me tell you something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_8","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_8","text":"There are no such things as ghosts... or at least, there shouldn't be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_9","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_9","text":"... I don't even know what to say to that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_10","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_10","text":"Now hurry up and go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_11","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_11","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_12","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_12","text":"Then let's go together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_13","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_13","text":"I said, no.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_14","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_14","text":"Okay, fine. Then answer this one question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_15","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_15","text":"Did you turn off the lights in the engine room?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_16","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_16","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_17","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_17","text":"Is all this ghost business your doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_18","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_18","text":"How did you possibly jump to that conclusion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_19","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_19","text":"Because something about you seems off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_20","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_20","text":"What the... I don't know what happened to make you change like this, but I preferred the old you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_21","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_21","text":"The one who only spoke when necessary and stayed quiet otherwise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_22","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_22","text":"I don't think I'm a fan of the current you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_23","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_23","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_24","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_24","text":"Do I have to spell it out for you? It's because...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_25","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_26","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_26","text":"Because I remind you of Red Hood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_areah","movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_27","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_28","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_28","text":"You like Red Hood. Why don't you like me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_29","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_29","text":"Because it feels like I'm looking at someone pretending to be Red Hood. An impostor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_30","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_30","text":"I am me, Dorothy. Not Red Hood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_31","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_31","text":"Then stop this pathetic mimicry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_32","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_32","text":"What are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_33","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_33","text":"Trying to cozy up to me. Assuming that if you like something, others must too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_34","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_34","text":"I don't believe those are traits unique to Red Hood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_35","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_35","text":"Perhaps your social circle is too small, and Red Hood is your only point of reference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_36","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_36","text":"*Sigh*... Fine, I give up. Just leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_37","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_37","text":"I have things to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_38","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_38","text":"What is it? Let's do it together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_39","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_39","text":"No. It's something very personal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_40","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_40","text":"Huh? This is your first time on this ship. How do you do personal business here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_41","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_41","text":"I just do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_42","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_42","text":"The moment you saw that figure in the window, you changed your tune and wanted to come here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_43","type":"Speech","speaker":"rapi_ss","key":"Locale_MainScenario:event_boomtheghost1_05_e_43","text":"What are you looking for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_44","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_05_e_45","type":"Speech","speaker":"dorothy_s","key":"Locale_MainScenario:event_boomtheghost1_05_e_45","text":"There'