{"id":"msg_m_ex_rosanna_01","cat":"messenger","group":{"id":"room_rosanna","label":"Rosanna · Nikke"},"label":"1. Hi, Mister.","stage":null,"prev":null,"next":"msg_m_ex_rosanna_02","speakers":{"rosanna":"Rosanna"},"icons":{"rosanna":"si_c280_00_s"},"lines":[{"id":"m_ex_rosanna_01_1","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_1","text":"Hi, Mister.","jump":null},{"id":"m_ex_rosanna_01_2","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_2","text":"Did you hear the news?","jump":null},{"id":"m_ex_rosanna_01_3","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_01_3","text":"I didn't hear anything.","jump":"m_ex_rosanna_01_5"},{"id":"m_ex_rosanna_01_4","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_01_4","text":"Is this Rosanna?","jump":"m_ex_rosanna_01_7"},{"id":"m_ex_rosanna_01_5","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_5","text":"You haven't?","jump":null},{"id":"m_ex_rosanna_01_6","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_6","text":"Guess news travels slow over there.","jump":"m_ex_rosanna_01_8"},{"id":"m_ex_rosanna_01_7","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_7","text":"It is.","jump":"m_ex_rosanna_01_8"},{"id":"m_ex_rosanna_01_8","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_8","text":"I'm Rosanna, head of Hedonia.","jump":null},{"id":"m_ex_rosanna_01_9","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_9","text":"The only people I harm are my enemies.","jump":null},{"id":"m_ex_rosanna_01_10","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_10","text":"So there isn't any reason for me to hurt you.","jump":null},{"id":"m_ex_rosanna_01_11","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_11","text":"That would change swiftly, however, if you were to betray me.","jump":null},{"id":"m_ex_rosanna_01_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_01_12","text":"I don't intend on doing that.","jump":null},{"id":"m_ex_rosanna_01_13","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_13","text":"Good.","jump":null},{"id":"m_ex_rosanna_01_14","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_14","text":"I'm normally a very guarded person,","jump":null},{"id":"m_ex_rosanna_01_15","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_15","text":"but I oddly feel like I can trust you.","jump":null},{"id":"m_ex_rosanna_01_16","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_16","text":"Maybe it's because you're my type, hehe.","jump":null},{"id":"m_ex_rosanna_01_17","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_17","text":"Anyway, I look forward to working with you.","jump":null},{"id":"m_ex_rosanna_01_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_01_18","text":"Likewise.","jump":null},{"id":"m_ex_rosanna_01_19","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_19","text":"Well, now that we've been properly introduced,","jump":null},{"id":"m_ex_rosanna_01_20","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_20","text":"we should get to know each other a little bit more.","jump":null},{"id":"m_ex_rosanna_01_21","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_21","text":"What are some things you enjoy doing?","jump":null},{"id":"m_ex_rosanna_01_22","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_22","text":"What do you like?","jump":null},{"id":"m_ex_rosanna_01_23","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_23","text":"Feel free to tell me anything.","jump":null},{"id":"m_ex_rosanna_01_24","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_01_24","text":"You're my favorite.","jump":"m_ex_rosanna_01_26"},{"id":"m_ex_rosanna_01_25","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_rosanna_01_25","text":"How about we just get acquainted with each other naturally?","jump":"m_ex_rosanna_01_29"},{"id":"m_ex_rosanna_01_26","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_26","text":"...","jump":null},{"id":"m_ex_rosanna_01_27","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_27","text":"I see you're someone who could talk their way out of any situation.","jump":null},{"id":"m_ex_rosanna_01_28","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_28","text":"Isn't that right?","jump":"m_ex_rosanna_01_33"},{"id":"m_ex_rosanna_01_29","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_29","text":"What?","jump":null},{"id":"m_ex_rosanna_01_30","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_30","text":"Are you putting up a wall?","jump":null},{"id":"m_ex_rosanna_01_31","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_31","text":"How adorable.","jump":null},{"id":"m_ex_rosanna_01_32","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_32","text":"Fine.","jump":"m_ex_rosanna_01_33"},{"id":"m_ex_rosanna_01_33","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_33","text":"I'll find out about you soon enough.","jump":null},{"id":"m_ex_rosanna_01_34","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_34","text":"We'll do as you say,","jump":null},{"id":"m_ex_rosanna_01_35","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_35","text":"and take things slow.","jump":null},{"id":"m_ex_rosanna_01_36","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_36","text":"We're in no hurry.","jump":null},{"id":"m_ex_rosanna_01_37","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_37","text":"We'll meet soon.","jump":null},{"id":"m_ex_rosanna_01_38","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_rosanna_01_38","text":"Take care until then.","jump":null}],"chat":true}