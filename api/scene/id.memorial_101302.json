{"id":"memorial_101302","cat":"memorial","group":{"id":"memorial101300","label":"Memoirs · A Girl's Memoir"},"label":"July 24, XX (Cloudy)","stage":null,"prev":"memorial_101301","next":"memorial_101303","speakers":{},"icons":{},"lines":[{"id":"memorial_101302_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_02_description","text":"I saw aliens outside the car window."},{"id":"memorial_101302_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_02_description","text":"Their bellies were glistening."},{"id":"memorial_101302_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_02_description","text":"Daddy told me they're props for a movie that's filming near us."},{"id":"memorial_101302_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_13_02_description","text":"They were even setting off explosions, which looked so real."}]}