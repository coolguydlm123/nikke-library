{"id":"d_Counseling_elegg_boomandshock_01","cat":"counsel","group":{"id":"char5146","label":"Elegg: Boom and Shock"},"label":"Advising Elegg: Boom and Shock: 01","stage":null,"prev":null,"next":"d_Counseling_elegg_boomandshock_02","speakers":{"elegg_s":"Elegg"},"icons":{"elegg_s":"si_c502_00_s"},"lines":[{"id":"d_Counseling_elegg_boomandshock_01_1","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_1","text":"Have you ever heard that urban legend about this old game?","jump":null,"exit":false,"enter":null,"bg":"Deck_d","bgArt":"deck_d","image":null,"bgm":"bgm_story_summermood","movie":null,"shown":["elegg_s"],"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_2","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_2","text":"A mysterious character would appear in-game, but","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_3","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_3","text":"not even the devs knew who, or what, it was. How freaky is that?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_4","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_4","text":"Could it have been an actual haunted game with a ghost inside it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_5","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_5","text":"What do you think, Mr. Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_6","text":"Probably just a bug.","jump":"d_Counseling_elegg_boomandshock_01_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_Counseling_elegg_boomandshock_01_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_7","text":"... What if it really was a ghost?","jump":"d_Counseling_elegg_boomandshock_01_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_Counseling_elegg_boomandshock_01_8","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_8","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_9","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_9","text":"In a way... that's even scarier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_10","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_10","text":"A mysterious bug is way more terrifying than a ghost.","jump":"d_Counseling_elegg_boomandshock_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_11","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_11","text":"That'd actually be kinda fun, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_12","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_12","text":"The only thing is, how do you exorcise a game that's possessed by a ghost?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_13","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_13","text":"Maybe you could craft some kind of ghost-hunting gadget?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_14","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_14","text":"If it were up to Mr. BOOM Guy, he'd take care of it no problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_15","type":"Speech","speaker":"elegg_s","key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_15","text":"No ghost would stand a chance against Mr. BOOM Guy.","jump":"d_Counseling_elegg_boomandshock_01_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_Counseling_elegg_boomandshock_01_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_Counseling_elegg_boomandshock_01_16","text":"Elegg and I talk about the frightening unknown that resides in games.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}