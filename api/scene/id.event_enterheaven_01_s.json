y":"Locale_SubScenario:event_enterheaven_01_s_58","text":"Yeah. I was asked to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_59","type":"Speech","speaker":"rapi_red","key":"Locale_SubScenario:event_enterheaven_01_s_59","text":"Were you able to get in touch with her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_60","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_60","text":"No. She's not answering any messages or calls.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_61","type":"Speech","speaker":"rapi_red","key":"Locale_SubScenario:event_enterheaven_01_s_61","text":"That's not good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_62","type":"Speech","speaker":"rapi_red","key":"Locale_SubScenario:event_enterheaven_01_s_62","text":"Whatever's really going on, this whole situation is suspicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_63","type":"Speech","speaker":"rapi_red","key":"Locale_SubScenario:event_enterheaven_01_s_63","text":"I'd advise keeping your guard up, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_64","type":"Speech","speaker":"rapi_red","key":"Locale_SubScenario:event_enterheaven_01_s_64","text":"Regardless of whatever E.H. intended, something is already in motion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm