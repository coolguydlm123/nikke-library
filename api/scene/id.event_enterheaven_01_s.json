tacks in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_7","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_7","text":"Crow used them to blow a hole in the Dome of Eternity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_8","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_8","text":"Then do you know who founded Heavenly Ascension?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_9","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_9","text":"I do.","jump":"event_enterheaven_01_s_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_10","type":"Choice","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_10","text":"I don't.","jump":"event_enterheaven_01_s_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_11","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_11","text":"Good. That'll make this quick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_12","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_12","text":"As you know, E.H. is the one who founded Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_13","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_13","text":"... Right.","jump":"event_enterheaven_01_s_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_14","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_14","text":"I figured you might not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_15","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_15","text":"It would be good for you to know, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_16","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_16","text":"It was E.H. who founded Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_17","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_17","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_18","text":"... I see.","jump":"event_enterheaven_01_s_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_19","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_19","text":"Why are you telling me this now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_20","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_20","text":"After the attack on the Ark, E.H. expressed a desire to atone for her sins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_21","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_21","text":"She asked to become a Nikke so she could take responsibility for what she'd done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_22","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_22","text":"As part of the deal, she was forbidden from leaving the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_23","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_23","text":"A bomb was placed around her neck, and she became the leader of Exotic, agreeing to dismantle Heavenly Ascension herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_24","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_24","text":"Those who left the group under E.H.'s orders were spared their lives,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_25","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_25","text":"while those who didn't were punished for the terrorist attack,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_26","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_26","text":"and Heavenly Ascension was thereby declared disbanded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_27","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_27","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_28","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_28","text":"I... had no idea that all happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_29","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_29","text":"However, there's an issue...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_30","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_30","text":"Since then, the remnants of Heavenly Ascension were quiet, or at least we hadn't seen any signs of activity from them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_31","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_31","text":"Recently, though, we received intel that they've started moving again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_32","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_32","text":"Didn't you just say the group was dismantled?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_33","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_33","text":"It was. But then... reports started coming in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_34","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_34","text":"\"Light is our right. Heavenly Ascension.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_35","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_35","text":"That's their most famous slogan, and it's being written all over the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_36","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_36","text":"Couldn't it just be some copycat, though?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_37","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_37","text":"Of course. That's entirely possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_38","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_38","text":"But we also can't rule out the possibility that there are remnants of the group still around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_39","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_39","text":"If so, E.H.'s report of dismantling Heavenly Ascension may have been false,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_40","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_40","text":"a ruse meant to protect what remains of their group. At least, that's one theory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_41","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_41","text":"... The suspicion got pointed at her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_42","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_42","text":"It's not unreasonable for the Central Government to come to that conclusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_43","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_43","text":"After all, the only thing they see when they look at E.H. is the former head of a terrorist organization.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_44","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_44","text":"That's why they're asking me to look into what's really going on with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_45","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_45","text":"Do you think she lied?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_46","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_46","text":"... I don't know. I can't say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_47","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_47","text":"I don't want to give my opinion first and influence your judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_48","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_48","text":"Besides...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_49","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_49","text":"Let's just say I'm not fit to judge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_50","type":"Self","speaker":null,"key":"Locale_SubScenario:event_enterheaven_01_s_50","text":"What do you mean by that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_enterheaven_01_s_51","type":"Speech","speaker":"ingrid","key":"Locale_SubScenario:event_enterheaven_01_s_51","text":"For now, I want you to see E.H. in person and determine whether she's involved in this or not.","jump":null,"