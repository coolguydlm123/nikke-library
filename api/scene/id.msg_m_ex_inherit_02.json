{"id":"msg_m_ex_inherit_02","cat":"messenger","group":{"id":"room_inherit","label":"Inherit · Group"},"label":"2. Call and Response Game! 1!","stage":null,"prev":"msg_m_ex_inherit_01","next":null,"speakers":{"noah":"Noah","harran":"Harran","isabel":"Isabel"},"icons":{"noah":"si_c232_00_s","harran":"si_c230_00_s","isabel":"si_c231_00_s"},"lines":[{"id":"m_ex_inherit_02_1","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_1","text":"Call and Response Game! 1!","jump":null},{"id":"m_ex_inherit_02_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_inherit_02_2","text":"2!","jump":null},{"id":"m_ex_inherit_02_4","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_inherit_02_4","text":"No one else responds.","jump":null},{"id":"m_ex_inherit_02_5","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_5","text":"Hey, what's with you guys?","jump":null},{"id":"m_ex_inherit_02_6","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_6","text":"How come the Imposter is the only one who responded?","jump":null},{"id":"m_ex_inherit_02_11","type":"Speech","speaker":"harran","key":"Locale_SuddenMessage:m_ex_inherit_02_11","text":"What exactly is the purpose of this game?","jump":null},{"id":"m_ex_inherit_02_12","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_12","text":"Call and response games don't have to mean anything!","jump":null},{"id":"m_ex_inherit_02_13","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_13","text":"They're just designed to kill time.","jump":null},{"id":"m_ex_inherit_02_14","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_inherit_02_14","text":"I'm busy.","jump":null},{"id":"m_ex_inherit_02_15","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_15","text":"Oh, ARE YOU?","jump":null},{"id":"m_ex_inherit_02_16","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_16","text":"I know for a fact you don't have any unfinished tasks at the moment.","jump":null},{"id":"m_ex_inherit_02_17","type":"Speech","speaker":"isabel","key":"Locale_SuddenMessage:m_ex_inherit_02_17","text":"Tasks? My work is far too important to be associated with such a trivial word.","jump":null},{"id":"m_ex_inherit_02_18","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_18","text":"Sure, if you call hiding in the corner and peeping at the Imposter work!","jump":null},{"id":"m_ex_inherit_02_19","type":"Speech","speaker":"harran","key":"Locale_SuddenMessage:m_ex_inherit_02_19","text":"Noah, if you have nothing to do, why don't you help me concoct some potions?","jump":null},{"id":"m_ex_inherit_02_20","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_20","text":"Thanks, but no thanks.","jump":null},{"id":"m_ex_inherit_02_21","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_21","text":"You guys are so boring.","jump":null},{"id":"m_ex_inherit_02_22","type":"Speech","speaker":"noah","key":"Locale_SuddenMessage:m_ex_inherit_02_22","text":"I gotta go. Bye.","jump":null}],"chat":true}