{"id":"msg_m_ex_centi_03","cat":"messenger","group":{"id":"room_centi","label":"Centi · Nikke"},"label":"3. Boss!","stage":null,"prev":"msg_m_ex_centi_02","next":"msg_m_ex_centi_04","speakers":{"centi":"Centi"},"icons":{"centi":"si_c080_00_s"},"lines":[{"id":"m_ex_centi_03_1","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_1","text":"Boss!","jump":null},{"id":"m_ex_centi_03_2","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_2","text":"I'm in the hospital!","jump":null},{"id":"m_ex_centi_03_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_3","text":"Are you injured?!","jump":null},{"id":"m_ex_centi_03_4","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_4","text":"Not exactly.","jump":null},{"id":"m_ex_centi_03_5","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_5","text":"I accidently bopped my hand with a hammer, that's all.","jump":null},{"id":"m_ex_centi_03_6","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_6","text":"Sounds like an injury to me.","jump":null},{"id":"m_ex_centi_03_7","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_7","text":"!!","jump":null},{"id":"m_ex_centi_03_8","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_8","text":"Really?","jump":null},{"id":"m_ex_centi_03_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_9","text":"Are you all right?","jump":null},{"id":"m_ex_centi_03_10","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_10","text":"I think I'm fine,","jump":null},{"id":"m_ex_centi_03_11","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_11","text":"but Liter insisted I go to the hospital.","jump":null},{"id":"m_ex_centi_03_12","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_12","text":"So here I am.","jump":null},{"id":"m_ex_centi_03_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_13","text":"What did the doctor say?","jump":null},{"id":"m_ex_centi_03_14","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_14","text":"Mary said she'd never seen","jump":null},{"id":"m_ex_centi_03_15","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_15","text":"such a tough cookie!","jump":null},{"id":"m_ex_centi_03_16","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_16","text":"I suppose that means you're lucky.","jump":null},{"id":"m_ex_centi_03_17","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_17","text":"Of course!","jump":null},{"id":"m_ex_centi_03_18","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_18","text":"Actually, I feel more humiliated than anything","jump":null},{"id":"m_ex_centi_03_19","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_19","text":"for making such a stupid mistake.","jump":null},{"id":"m_ex_centi_03_20","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_20","text":"I wish I could dig a hole and bury myself in it.","jump":null},{"id":"m_ex_centi_03_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_21","text":"Everyone makes mistakes.","jump":null},{"id":"m_ex_centi_03_22","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_22","text":"Yeah?","jump":null},{"id":"m_ex_centi_03_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_23","text":"Luckily, you're not seriously injured.","jump":null},{"id":"m_ex_centi_03_24","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_24","text":"Thank you for your concern!","jump":null},{"id":"m_ex_centi_03_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_25","text":"All done at the hospital?","jump":null},{"id":"m_ex_centi_03_26","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_26","text":"Yep, I'm good to go!","jump":null},{"id":"m_ex_centi_03_27","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_27","text":"Time to get back to work.","jump":null},{"id":"m_ex_centi_03_28","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_28","text":"Why not take a break?","jump":null},{"id":"m_ex_centi_03_29","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_29","text":"No way! Liter will be up to her elbows in work otherwise.","jump":null},{"id":"m_ex_centi_03_30","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_30","text":"I've gotta get back and help her out asap!","jump":null},{"id":"m_ex_centi_03_31","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_31","text":"Back on the clock!","jump":null},{"id":"m_ex_centi_03_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_centi_03_32","text":"Take care.","jump":null},{"id":"m_ex_centi_03_33","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_33","text":"Will do!","jump":null},{"id":"m_ex_centi_03_34","type":"Speech","speaker":"centi","key":"Locale_SuddenMessage:m_ex_centi_03_34","text":"Thank you, Boss!","jump":null}],"chat":true}