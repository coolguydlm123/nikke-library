{"id":"d_main_25_07_s","cat":"main","group":{"id":"ch25","label":"Chapter 25 · Tracking"},"label":"Gratitude: A","stage":"25-27 STAGE · Start","prev":"d_main_25_06","next":"d_main_25_07_e","speakers":{"anis":"Anis","neon":"Neon","dorothy":"Dorothy"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","dorothy":"si_c233_00_s"},"lines":[{"id":"d_main_25_07_s_1","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_1","text":"I've set up all the decoys.","jump":null,"exit":false,"enter":null,"bg":"CityForest_02_n","bgArt":"cityforest_02_n","image":null,"bgm":"bgm_chaser","movie":null,"shown":["dorothy","anis","neon"],"affinity":null},{"id":"d_main_25_07_s_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_07_s_2","text":"All done on my end as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_3","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_3","text":"It's been a little while since I went camping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_4","text":"I'm surprised you've even camped at all. Doesn't exactly seem up your alley.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_5","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_5","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_6","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_6","text":"I suppose it has been a few years.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_07_s_7","text":"Color me surprised. I thought you'd be going on about how you couldn't sleep without a proper bed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_07_s_8","text":"Complete with silk sheets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_9","text":"... You seem to have a rather myopic perception of people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_10","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_07_s_10","text":"Sorry. It's probably because of my glasses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_11","text":"What do you usually eat when you go camping?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_12","text":"I don't really eat much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_13","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_13","text":"It's the others in Eden who are voracious eaters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_14","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_14","text":"They're fans of different fruits, meats and vegetables.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_15","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_15","text":"Wow, a bunch of fancy pants!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_16","text":"Sounds more like a royal outing than roughing it out at a campsite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_17","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_17","text":"Well, it's certainly not efficient, I'll tell you that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_18","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_18","text":"All those food supplies are bulky, yet they aren't high in calories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_19","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_19","text":"Anyway, what do you all eat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_20","text":"Usually, whatever we bring from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_21","text":"Apparently, there are tons of food sources up on the surface, but you've got to be a skilled hunter in order to enjoy them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_22","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_22","text":"That's a tall order for amateurs like ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_07_s_23","text":"Would you like to try some? It might not look like much, but it's not bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_24","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_24","text":"No. I don't eat food from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_07_s_25","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_26","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_25_07_s_26","text":"I despise nothing more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_07_s_27","type":"Narration","speake