{"id":"event_ltk_intermission_01","cat":"event","group":{"id":"ev40012","label":"LICENSE TO KILL"},"label":"Approach","stage":null,"prev":"event_ltk_03_e","next":"event_ltk_04_s","speakers":{"productionlinestaff":"Production Line Employee","Self":"Commander","Monologue":"Monologue","d":"D","owner":"President"},"icons":{"productionlinestaff":"si_c912_00_s","d":"si_c040_00_s"},"lines":[{"id":"event_ltk_intermission_01_1","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_1","text":"Oh my stars! How wonderful it is to hear some good news in a dark time like this.","jump":null,"exit":false,"enter":null,"bg":"Storage","bgArt":"storage","image":null,"bgm":"bgm_story_leisuretime","movie":null,"shown":["d"],"affinity":null},{"id":"event_ltk_intermission_01_2","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_2","text":"How far along is she? Did the hospital tell you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_3","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_3","text":"5 weeks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_4","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_4","text":"Oh! So it's a recent development!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_5","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_5","text":"But what are you going to do? Before long, you won't be able to work...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_6","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_6","text":"And you'll be needing more money than ever.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_7","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_7","text":"Funny that you mention that. Would it be possible to take on another job at this same company?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_8","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_8","text":"Two jobs? I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_9","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_9","text":"If you bring it up with them, I don't think it'd be an issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_10","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_11","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_11","text":"Would you like me to try and have a word with the higher-ups?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_12","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_12","text":"I can tell them the new hire could use the extra money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_13","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_13","text":"If you can, that'll be great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_14","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_14","text":"Okay, I'll see what I can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_15","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_15","text":"The president is a good person. I'm sure he'll work something out for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_16","type":"Speech","speaker":"productionlinestaff","key":"Locale_SubScenario:event_ltk_intermission_01_16","text":"Don't you worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_17","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_intermission_01_17","text":"The lady scurries off the production line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_18","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_19","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_19","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_20","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_20","text":"Is there a problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_21","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_21","text":"I feel rotten.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_22","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_22","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_23","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_23","text":"I feel like we're taking advantage of that lady.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_24","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_25","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_25","text":"I feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_26","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_intermission_01_26","text":"On the way home after work,","jump":null,"exit":false,"enter":null,"bg":"Backstreet_n","bgArt":"backstreet_n","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_27","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_intermission_01_27","text":"as soon as we enter an area with no other people, someone calls for us to stop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["d"],"affinity":null},{"id":"event_ltk_intermission_01_28","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_28","text":"Excuse me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["owner"],"affinity":null},{"id":"event_ltk_intermission_01_29","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_29","text":"You're Diana and Steve, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_30","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_30","text":"Nice to meet you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_31","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_31","text":"Hi, nice to meet you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_32","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_32","text":"It's a pleasure to meet you, Mr. President.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_33","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_33","text":"I heard from some of the other employees that you're looking to take on some additional responsibilities?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_34","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_34","text":"Yes. We're in urgent need of some additional funds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_35","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_35","text":"Mmm, they informed me of your situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_36","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_36","text":"I've also heard a few things about both of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_37","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_37","text":"You two are real hard workers with a whole lotta passion, or so I'm told.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_38","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_38","text":"Since you could use a little help financially,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_39","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_39","text":"how would you like to come work for me personally?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_40","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_40","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_41","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_41","text":"What would our job be, exactly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_42","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_42","text":"It's quite simple, really.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_43","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_43","text":"C.O.L. is also involved in the transportation business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_44","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_44","text":"We do deliveries to certain special areas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_45","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_45","text":"You'll be responsible for making those deliveries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_46","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_46","text":"What is this \"special\" location?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_47","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_47","text":"The Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_48","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_48","text":"... The Outer Rim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_49","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_49","text":"Oh, don't worry. It's nothing illegal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_50","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_50","text":"I've been donating electronics to the Outer Rim for some time now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_51","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_51","text":"You know how tough it can be out there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_52","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_52","text":"The people there should have the right to have access to technology, even if it may not be the latest models.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_53","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_53","text":"You must have a lot of people willing to carry out these deliveries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_54","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_54","text":"If only that were true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_55","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_55","text":"The Outer Rim is a dangerous place,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_56","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_56","text":"or at least that's what most people think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_57","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_57","text":"If you ask me, it's not dangerous at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_58","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_58","text":"The people there know we have good intentions, and have been nothing but friendly to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_59","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_59","text":"That I can guarantee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_60","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_60","text":"Anyway, that long-standing prejudice means that a lot of people are hesitant to go to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_61","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_61","text":"But from what I've heard about you two, something tells me you won't feel that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_62","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_62","text":"How much does it pay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_63","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_63","text":"Five times what you get now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_64","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_64","text":"F-five times?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_65","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_65","text":"Please don't think I'm giving you that much because it's illegal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_66","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_66","text":"It's nothing like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_67","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_67","text":"It's just my way of showing a little appreciation to those working for me who go above and beyond.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_68","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_68","text":"Well, what do you say?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_69","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_69","text":"Can we think ab--","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_70","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_70","text":"We'll do it. When do we start?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_71","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_71","text":"Very good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_72","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_72","text":"Be at the number 3 inventory warehouse by 6 o'clock tomorrow morning.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_73","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_73","text":"I'll have an employee there waiting. They'll explain everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_74","type":"Speech","speaker":"owner","key":"Locale_SubScenario:event_ltk_intermission_01_74","text":"Looking forward to working with you both.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_75","type":"Monologue","speaker":"Monologue","key":"Locale_SubScenario:event_ltk_intermission_01_75","text":"The president nods and turns around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_76","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_76","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_77","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_77","text":"That was fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_78","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_78","text":"Because his last assistant is gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_79","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_ltk_intermission_01_79","text":"At any rate, something fishy is definitely going on. We'll see for sure tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ltk_intermission_01_80","type":"Speech","speaker":"d","key":"Locale_SubScenario:event_ltk_intermission_01_80","text":"Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}