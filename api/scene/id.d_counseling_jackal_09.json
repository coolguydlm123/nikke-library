{"id":"d_counseling_jackal_09","cat":"counsel","group":{"id":"char1020","label":"Jackal"},"label":"Advising Jackal: 09","stage":null,"prev":"d_counseling_jackal_08","next":"d_counseling_jackal_10","speakers":{"jackal":"Jackal"},"icons":{"jackal":"si_c111_00_s"},"lines":[{"id":"d_counseling_jackal_09_1","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_1","text":"There's this giant wall that separates my neighborhood from the Ark.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["jackal"],"affinity":"_0"},{"id":"d_counseling_jackal_09_2","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_2","text":"It's a real pain in the butt to move around, and it's next to impossible to jump over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_jackal_09_3","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_3","text":"Got any bright ideas on how I can get around it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_jackal_09_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_jackal_09_4","text":"Let's practice jumping over it.","jump":"d_counseling_jackal_09_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_jackal_09_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_jackal_09_5","text":"I'll tear that wall down.","jump":"d_counseling_jackal_09_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_jackal_09_6","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_6","text":"Good idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_jackal_09_7","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_7","text":"Since we won't be able to get rid of the wall, I might as well try and learn to jump higher.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_jackal_09_8","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_8","text":"Hehe! I'm gonna start practicing straight away!","jump":"d_counseling_jackal_09_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_jackal_09_9","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_9","text":"Ha, you can't be serious!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_jackal_09_10","type":"Speech","speaker":"jackal","key":"Locale_Counseling:d_counseling_jackal_09_10","text":"Not even the Captain could tear down such an imposing wall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_jackal_09_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_jackal_09_11","text":"Jackal and I practice how to add some height to our jumps.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}