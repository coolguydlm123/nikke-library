id just that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_117","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_117","text":"... Only problem is, you took it a little too seriously.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_118","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_118","text":"Hahaha.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_05_06_7","bgArt":"eventscene_side_05_06_7","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_119","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_119","text":"Now then... Where should I begin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_120","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_120","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_121","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_121","text":"Once upon a time, there were those who fought for humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_122","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_122","text":"They were called the Goddesses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_123","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_123","text":"Truly, they were beings worthy of being called the Goddesses of Victory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}