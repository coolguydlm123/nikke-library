ull,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_73","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_73","text":"Same as always.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_74","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_75","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_75","text":"I'm sorry, Arthur. I didn't take care of you the way I should have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_76","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_76","text":"What are you saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_77","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_77","text":"I've always respected you, Dad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_78","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_78","text":"After my biological father fell in the line of duty, you took me in and raised me without ever asking for anything in return.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_79","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_79","text":"You gave me the strength to stand tall in a world like this, and for that, I'm truly grateful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_80","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_80","text":"If there's one thing I resent,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_81","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_81","text":"it's that my old man never got to retire because of you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_82","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_83","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_83","text":"I'm joking. My father always respected you,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_84","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_84","text":"and so do I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_85","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_85","text":"... I've been training hard","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_86","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_86","text":"to live up to your expectations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_87","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_87","text":"I didn't quite make it to Deputy Chief, which is a bit of a letdown, but I've made a bit of a name for myself in the Ark, haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_88","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_88","text":"You've done well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_89","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_89","text":"The Best Seller Squad will be formed, as you desired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_90","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_90","text":"Records that must never be forgotten will be passed down through many generations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_91","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_91","text":"And one day, they will return to the world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_92","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_92","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_93","type":"Narration","speaker":null,"key":"Locale_SideStory:s005_15_93","text":"Arthur's gaze lingers on the book in front of Oswald.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_94","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_94","text":"Huh, I've never seen this book closed before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_95","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_95","text":"... And you even took out Red Hood's gloves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_96","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_96","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_97","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_97","text":"Did you really finish the whole thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_98","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_98","text":"Yes, I've just finished it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_99","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_99","text":"That's incredible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_100","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_100","text":"Well, looks like the hard part's all yours from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_101","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_101","text":"It's all good. If I can't do it, my son will.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_102","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_102","text":"Isn't that right,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_103","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_103","text":"Burningum?","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_05_06_5","bgArt":"eventscene_side_05_06_5","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_104","type":"Speech","speaker":"burningum","key":"Locale_SideStory:s005_15_104","text":"Grandpa, I think keeping records on paper these days is a waste of resources.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_105","type":"Speech","speaker":"arthur","key":"Locale_SideStory:s005_15_105","text":"Watch your tone, young man! Don't speak to your grandfather like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_106","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_106","text":"It's fine. He's not wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_107","type":"Speech","speaker":"burningum","key":"Locale_SideStory:s005_15_107","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_108","type":"Speech","speaker":"burningum","key":"Locale_SideStory:s005_15_108","text":"Have you really finished it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_109","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_109","text":"That's right. Since you