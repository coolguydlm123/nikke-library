ual","key":"Locale_SideStory:s005_15_21","text":"If I remember correctly, you said you liked Pretty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_22","type":"Speech","speaker":"anis_idol","key":"Locale_SideStory:s005_15_22","text":"Oh yeah, I talk about her whenever I get the chance, haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_23","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_23","text":"Do you want to be like Pretty?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_24","type":"Speech","speaker":"anis_idol","key":"Locale_SideStory:s005_15_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_25","type":"Speech","speaker":"anis_idol","key":"Locale_SideStory:s005_15_25","text":"Yeah, she's my idol and star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_26","type":"Speech","speaker":"osward_casual","key":"Locale_SideStory:s005_15_26","text":"Oh, really? Why's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_27","type":"Speech","speaker":"anis_idol","key":"Locale_SideStory:s005_15_27","text":"That's because she gave me hope when I had nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"s005_15_28","type":"Speech","speaker":"anis_idol","key":"Locale_SideStory:s005_15_28","text":"I know I can't ever be like her...","jump":null,"exit":false,"enter":null,"bg":nu