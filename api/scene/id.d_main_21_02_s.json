{"id":"d_main_21_02_s","cat":"main","group":{"id":"ch21","label":"Chapter 21 · Giant Whale"},"label":"New Hope: A","stage":"21-6 STAGE · Start","prev":"d_main_21_01_e","next":"d_main_21_02_e","speakers":{"Self":"Commander","cecil":"Cecil","rapi":"Rapi","anis":"Anis","neon":"Neon"},"icons":{"cecil":"si_c929_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_main_21_02_s_1","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_02_s_1","text":"You're telling me Raptures used humans and animals as a kind of fuel?","jump":null,"exit":false,"enter":null,"bg":"EdenLobby","bgArt":"edenlobby","image":null,"bgm":"bgm_story_cecil","movie":null,"shown":["cecil"],"affinity":null},{"id":"d_main_21_02_s_2","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_2","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_3","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_3","text":"When the Raptures first arrived, they laid waste to everything in their path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_4","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_4","text":"But soon after, they shifted their focus towards capturing humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_5","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_5","text":"This is most likely because they needed a long-term power source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_6","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_6","text":"I assume I don't have to tell you what they did to the humans after capturing them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_7","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_02_s_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_8","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_8","text":"Then again, there's always a silver lining.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_9","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_9","text":"After mankind migrated to the Ark, this gathering of \"ingredients\" ceased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_10","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_10","text":"It could have been that there were no longer any humans on the surface, or perhaps the Raptures found something more efficient.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_11","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_11","text":"At any rate, after that, Raptures moved on to their current semi-permanent power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_12","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_12","text":"This whole period of human hunting didn't last long. Only 10 years or so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_13","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_13","text":"It's a behavior that later models have never engaged in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_14","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_14","text":"While there are still some Raptures remaining from the initial invasion, they'll soon run out of power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_15","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_15","text":"That's why we need to get our hands on Mother Whale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_16","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_16","text":"The fuel economy of that ship is astounding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_17","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_17","text":"However, much like the Raptures present during the first invasion,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_18","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_18","text":"Mother Whale's power is by no means infinite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_19","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_19","text":"It has had to secure living materials several times in order to reinforce its core.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_20","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_20","text":"In other words,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_21","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_21","text":"Mother Whale's core is bound to contain human cells.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_22","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_22","text":"If we synthesize that core with Vapaus,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_23","type":"Speech","speaker":"cecil","key":"Locale_MainScenario:d_main_21_02_s_23","text":"you'll get your Vapaus bullet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_02_s_24","text":"...","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_25","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_02_s_25","text":"Commander. Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":["rapi","neon","anis"],"affinity":null},{"id":"d_main_21_02_s_26","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_02_s_26","text":"Huh? Oh, yeah. I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_02_s_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_02_s_28","text":"A friendly reminder: You don't need to feel bad if you have to keep a secret from us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_02_s_29","text":"Yeah, as long as you don't betray us, it's all good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_02_s_30","text":"I've got secrets too. The main one is that I'm a spy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_31","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_21_02_s_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_02_s_32","text":"Besides, being too transparent can be a bad thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_33","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_21_02_s_33","text":"Yeah, Master was so transparent the first time we met, I could see through him almost like he was an apparition!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_21_02_s_34","text":"Whoa! No kidding?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_02_s_35","text":"... Commander, we'll be arriving at the meeting point to rendezvous with Johan soon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21_02_s_36","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_21_02_s_36","text":"Let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}