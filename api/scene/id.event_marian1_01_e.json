,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_26","type":"Speech","speaker":"maria-55","key":"Locale_MainScenario:event_marian1_01_e_26","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_27","type":"Speech","speaker":"maria-55","key":"Locale_MainScenario:event_marian1_01_e_27","text":"... One moment. There's a Rapture I've never seen before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_28","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_01_e_28","text":"It's an aerial type. I've never seen one around here before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_29","type":"Speech","speaker":"maria-55","key":"Locale_MainScenario:event_marian1_01_e_29","text":"I'll try attacking it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_30","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_01_e_30","text":"No, don't. Why fight when you can just go around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_31","type":"Speech","speaker":"maria-55","key":"Locale_MainScenario:event_marian1_01_e_31","text":"Because we can get more data that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_32","type":"Speech","speaker":"maria-55","key":"Locale_MainScenario:event_marian1_01_e_32","text":"