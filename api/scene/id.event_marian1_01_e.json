ech","speaker":"maria-24","key":"Locale_MainScenario:event_marian1_01_e_12","text":"Oh, okay. Understo—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_01_e_13","text":"*Whoosh!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_01_e_14","text":"*Kaboom!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_15","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_01_e_15","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_16","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_01_e_16","text":"Respond! Respond!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_17","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_01_e_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_18","type":"Speech","speaker":"doctormaria_op_l","key":"Locale_MainScenario:event_marian1_01_e_18","text":"Agh... Again...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_01_e_19","type":"Speech","speaker":"maria-55","key":"Locale_MainScenario:event_marian1_01_e_19","text":"One moment. I'm relocating.",