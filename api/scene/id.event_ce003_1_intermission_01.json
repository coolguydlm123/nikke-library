Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_25","text":"I am a bit preoccupied with helping Cocoa and Soda craft up a new menu for the cafe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_26","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_26","text":"If your friends wanted to join us, I don't think it'd be a problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_27","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_intermission_01_27","text":"That'd be fantastic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_28","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_28","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_29","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_29","text":"I'm not sure how much help I'll be, but I'll do my best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_30","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_intermission_01_30","text":"Thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_31","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_31","text":"Haha, don't mention it. I'm just glad I can repay you in some way for all the help you've given me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_32","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_32","text":"I have a few things I've got to take care of, but I'll be right with you when I'm done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["soda","cocoa","ce_003_02","ce_003_01","ce_003_03","rapi","anis","neon"],"affinity":null},{"id":"event_ce003_1_intermission_01_33","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_33","text":"That's how I came to be your teacher today.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"event_bgm_ce003_story_1","movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_34","type":"Speech","speaker":"ce_003_02","key":"Locale_SubScenario:event_ce003_1_intermission_01_34","text":"My name is Emilia. I look forward to working with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_35","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_35","text":"Likewise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_36","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_intermission_01_36","text":"I'm Rem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_37","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_intermissio