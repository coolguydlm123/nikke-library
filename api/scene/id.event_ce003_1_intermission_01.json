:"Locale_SubScenario:event_ce003_1_intermission_01_12","text":"Would you like to order something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_13","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_intermission_01_13","text":"I'm fine for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_14","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_14","text":"Oh? Do you perhaps have something to discuss then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_15","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_intermission_01_15","text":"I do. In fact, I came to ask for your help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_16","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_16","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_17","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce003_1_intermission_01_17","text":"I have some friends who are practicing for a cooking competition and I thought you might be able to help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_18","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_18","text":"You mean the competition at the connoisseur's mansion?","jump":null,