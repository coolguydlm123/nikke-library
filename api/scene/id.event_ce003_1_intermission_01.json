_intermission_01_44","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_intermission_01_44","text":"Oh, sorry! It's just been a while since we've seen another maid...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_45","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_ce003_1_intermission_01_45","text":"I've never seen twin maids! So cool!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_46","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_ce003_1_intermission_01_46","text":"And that pink hair... it's the telltale sign of a professional maid!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_47","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce003_1_intermission_01_47","text":"Cocoa gives a thumbs up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_48","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_intermission_01_48","text":"Everyone knows that Sister is the best, but what was that you're saying about a \"telltale sign\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_49","type":"Speech","speaker":"ce_003_03","key":"Locale_SubScenario:event_ce003_1_intermission_01_49","text":"You look like a maid yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_50","type":"Speech","speaker":"ade","key":"Locale_SubScenario:event_ce003_1_intermission_01_50","text":"Let's continue with the introductions, shall we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_51","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_intermission_01_51","text":"Hello, I'm Soda, and this is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_52","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_ce003_1_intermission_01_52","text":"Cocoa, the head maid of Maid For You!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_53","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_ce003_1_intermission_01_53","text":"Nice to meet you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_54","type":"Speech","speaker":"ce_003_01","key":"Locale_SubScenario:event_ce003_1_intermission_01_54","text":"You must be quite skilled to have become a head maid at such a young age.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_55","type":"Speech","speaker":"cocoa","key":"Locale_SubScenario:event_ce003_1_intermission_01_55","text":"That's 'cause I'm a professional!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce003_1_intermission_01_56","type":"Speech","speaker":"soda","key":"Locale_SubScenario:event_ce003_1_intermission_01_56","text":"This is gonna be fun!","jump"