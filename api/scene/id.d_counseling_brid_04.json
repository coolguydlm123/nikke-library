{"id":"d_counseling_brid_04","cat":"counsel","group":{"id":"char5018","label":"Brid"},"label":"Advising Brid: 04","stage":null,"prev":"d_counseling_brid_03","next":"d_counseling_brid_05","speakers":{"brid":"Brid"},"icons":{"brid":"si_c070_00_s"},"lines":[{"id":"d_counseling_brid_04_1","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_1","text":"Did you know that Diesel likes to sing?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["brid"],"affinity":"_0"},{"id":"d_counseling_brid_04_2","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_2","text":"Passengers occasionally report that some tone-deaf woman is bombarding them with noise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_3","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_3","text":"I believe it must be Diesel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_4","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_4","text":"What can I do to discourage Diesel from singing without offending her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_brid_04_5","text":"Tell her to stop her awful singing.","jump":"d_counseling_brid_04_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_brid_04_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_brid_04_6","text":"Tell her to fill her mouth with candy during her shift.","jump":"d_counseling_brid_04_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_brid_04_7","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_7","text":"I'm not sure if saying that won't hurt her feelings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_8","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_8","text":"*Sigh* But perhaps there's no other choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_9","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_9","text":"I will try to speak to her sincerely.","jump":"d_counseling_brid_04_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_10","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_10","text":"That's a great idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_11","type":"Speech","speaker":"brid","key":"Locale_Counseling:d_counseling_brid_04_11","text":"Thank you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_brid_04_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_brid_04_12","text":"Brid and I remain concerned about Diesel's singing.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}