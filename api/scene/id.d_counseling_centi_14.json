{"id":"d_counseling_centi_14","cat":"counsel","group":{"id":"char5021","label":"Centi"},"label":"Advising Centi: 14","stage":null,"prev":"d_counseling_centi_13","next":"d_counseling_centi_15","speakers":{"centi":"Centi"},"icons":{"centi":"si_c080_00_s"},"lines":[{"id":"d_counseling_centi_14_1","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_14_1","text":"It's such a pain working in the rain!","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["centi"],"affinity":"_0"},{"id":"d_counseling_centi_14_2","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_14_2","text":"I only have two hands, so I can't hold an umbrella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_centi_14_3","text":"Wear a raincoat while you're working.","jump":"d_counseling_centi_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_centi_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_centi_14_4","text":"Take a break whenever it starts raining.","jump":"d_counseling_centi_14_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_centi_14_5","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_14_5","text":"That's genius!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_centi_14_6","type":"Speech","speaker":"centi","key":"Locale_Counseling:d_counseling_centi_14_6","text":"Why didn't I think of that?","jump":null,"exit":false,"enter":null,"bg":null,