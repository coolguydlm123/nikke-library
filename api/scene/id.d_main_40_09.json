ovie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_6","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_6","text":"And if she exists, the Queen as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_09_7","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_8","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_8","text":"What do you mean, by why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_9","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_9","text":"This won't be bad news for you either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_10","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_11","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_11","text":"Oh. I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_12","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_12","text":"You think the Queen might prove useful to you in some way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_13","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_09_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_14","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_14","text":"A feasible notion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_15","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_15","text":"But not one that's going to happen, unfortunately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_16","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_16","text":"You don't understand what it means for a new Queen to be born.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_17","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_17","text":"The birth of a new Queen signifies changes in the laws of nature.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_18","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_18","text":"The behavioral patterns of the Raptures will be completely altered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_19","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_19","text":"I can't say exactly what those changes would be, but it will be in ways no one can possibly predict.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_20","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_20","text":"They could get smaller and multiply, or grow larger and decrease in number.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_21","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_21","text":"They might wrap themselves in living tissue or some other natural material.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_22","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_22","text":"They could choose to live alongside humans, or to wipe out humanity entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_23","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_23","text":"There's no telling what could happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_24","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_24","text":"Everything you've learned about Raptures over the past century will become worthless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_25","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_09_25","text":"If it's a 50-50 chance, it's a risk I'm willing to take.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_26","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_26","text":"Don't bet the future of humanity on a foolish gamble, human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_27","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_27","text":"If the Raptures truly meant to harm humans, your puny shelter would have been destroyed a long time ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_28","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_28","text":"Use your head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_29","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_29","text":"Right now, you're safe if you remain underground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_30","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_30","text":"The Raptures that exist now have no interest in humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_31","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_31","text":"But...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_32","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_32","text":"Could the same be said if the Four Beasts' Queen exists?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_09_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_34","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_09_34","text":"And if we turn down your proposal?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_35","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_35","text":"Then I'll take that to mean you're working with the Four Beasts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_36","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_09_36","text":"Tell me something, Heretic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["maxwell_p","rapi_red","laplace_p","drake_p"],"affinity":null},{"id":"d_main_40_09_37","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_37","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_38","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_09_38","text":"Can't you just go and deal with the Four Beasts, or their Queen, yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_39","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_09_39","text":"You act like you could solve everything on your own, so why are you so interested in cooperating with us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_40","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_40","text":"Because you all are strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_41","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_41","text":"In contrast, I've become weaker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_42","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_09_42","text":"What? Did someone knock you around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_43","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_43","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_44","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_44","text":"That's why I wish to stack the odds more in my favor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_45","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_09_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_46","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_09_46","text":"What's stopping us from clobbering you and doing things our way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_47","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_47","text":"That would be an unwise decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_48","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_48","text":"You can either team up with me and fight the Four Beasts, or side with them and oppose me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_09_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_50","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_40_09_50","text":"I'll go find Leviathan and Ziz—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_51","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_40_09_51","text":"Birdie! Raptures incoming!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_52","type":"Speech","speaker":"drake_p","key":"Locale_MainScenario:d_main_40_09_52","text":"Don't they know it's rude to interrupt a conversation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_53","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_09_53","text":"So this was your plan, you filthy Heretic!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_54","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_54","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_55","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_55","text":"I see. So this is what you think of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_56","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_40_09_56","text":"I did not call them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_57","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_09_57","text":"All the Raptures here are friends of Raptilion's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_58","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_09_58","text":"That means there are only non-hostile Raptures around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_59","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_09_59","text":"Besides, Raptures have been ambushing us from the moment we arrived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_60","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_40_09_60","text":"The only explanation I can come up with is that you called them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_09_61","type":"Speech","speaker":"maxwell_p","key":"Locale_MainScenario:d_main_40_09_61","text":"All negotiations are off, Heretic!","jump":null,"exit":false,"enter