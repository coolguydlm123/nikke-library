{"id":"event_goddessfall1_02_e","cat":"event","group":{"id":"ev40093","label":"GODDESS FALL · Part 1"},"label":"Headless Goddess: B","stage":null,"prev":"event_goddessfall1_02_s","next":"event_goddessfall1_03_s","speakers":{"nayuta":"Nayuta","nihilister_m":"Nihilister"},"icons":{"nayuta":"si_c223_00_s","nihilister_m":"si_c9009_00_s"},"lines":[{"id":"event_goddessfall1_02_e_1","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_1","text":"Is this...","jump":null,"exit":false,"enter":null,"bg":"TemporaryCamp","bgArt":"temporarycamp","image":null,"bgm":"event_bgm_goddessfall_heap","movie":null,"shown":["nayuta","nihilister_m"],"affinity":null},{"id":"event_goddessfall1_02_e_2","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_2","text":"This is it. I left it here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_3","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_3","text":"A civilian camp by the entrance of the Ark?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_4","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_4","text":"What are you mumbling about? Hurry up and look.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_5","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_5","text":"Where might it be, pray?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_6","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_7","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_7","text":"I buried it underneath a pile of human imposters' bodies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_8","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_8","text":"Follow me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_9","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_10","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_10","text":"It's up ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_11","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_11","text":"Nayuta follows behind Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_12","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_12","text":"Soon, they arrive at a place,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_13","text":"at a place where a mountain formed by Nikke corpses lies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_14","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_14","text":"What... in the name of all that is holy...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_15","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_15","text":"What else did you think happened to all the human imposters that were left behind after the Ark was sealed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_16","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_16","text":"They kept banging on the door to the Ark, hoping that it might open.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_17","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_17","text":"This is the result of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_18","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_18","text":"The door didn't open, and they all died.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_19","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_19","text":"Their cores hath been wholly torn asunder. What is the cause thereof?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_20","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_20","text":"Without a core, the bodies of human imposters are worthless to the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_21","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_21","text":"Someone must have done it in hopes they wouldn't be defiled after death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_22","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_23","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_23","text":"Was it you, Fire Dragon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_24","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_24","text":"Yes. It was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_25","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_25","text":"I see thou dost remember the past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_26","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_26","text":"Yes. A pathetic past I would rather erase.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_27","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_27","text":"Lilith's body is underneath all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_28","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_28","text":"Find it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_29","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_29","text":"Wouldst thou not lend a hand...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_30","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_30","text":"I'm not in the mood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_31","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_31","text":"Besides, you all turned me into a living corpse, I have no strength left to spare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_32","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_32","text":"There are far too many bodies, methinks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_33","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_33","text":"Not my problem. Go figure it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_34","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_34","text":"*Sigh* I am not well-versed in the labor of the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_35","text":"Nayuta walks toward the mountain of corpses and extracts a Nikke from beneath.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_36","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_36","text":"Just yank them out. Why are you handling them like holy relics?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_37","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_37","text":"'Tis no easy feat. I wish not to wound nor break them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_38","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_39","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_39","text":"Nayuta lays the body she extracted to the side with great care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_40","text":"Then she presses her hands together in a short prayer before heading back toward the mountain of bodies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_41","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_41","text":"We're gonna be here all day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_42","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_42","text":"Be silent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_43","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_44","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_44","text":"Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_45","text":"Nihilister walks over to Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_46","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_46","text":"Grab that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_47","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_47","text":"... I thank thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_48","text":"Several bodies lay neatly next to Nayuta and Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_49","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_49","text":"How didst thou come by Lilith's body?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_50","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_50","text":"Far up north. It was trapped in a glacier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_51","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_51","text":"It took some effort to locate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_52","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_52","text":"... Was it Gene Reaper, perchance, who sent forth Lilith's head to the Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_53","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_53","text":"Yes. It was the Great Mother's wish.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_54","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_54","text":"Had it not been for that, the Queen would have perished ages past.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_55","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_55","text":"Yeah. Since her brain was already dying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_56","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_56","text":"For some reason, the station the Queen was in detached from the orbital elevator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_57","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_57","text":"The Queen and the station drifted through space together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_58","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_58","text":"By then, her brain was already failing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_59","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_59","text":"Haha. How badly must she have wanted to live to say, \"Hey, send up a head,\" all the way into space.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_60","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_60","text":"And even in that state, she only wanted the finest human imposter. How greedy our Great Mother is, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_61","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_61","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_62","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_62","text":"Liberalio cut off Lilith's head and sent it to the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_63","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_63","text":"But then guess what? Later, she even wanted the body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_64","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_64","text":"She kept repeating it ad nauseam, \"Find Lilith's body. Find Lilith's body.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_65","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_65","text":"Liberalio scrambled to look for it, but failed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_66","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_66","text":"It wasn't where it was originally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_67","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_67","text":"I don't know what intentions they had, but someone went far up north to hide Lilith's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_68","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_68","text":"Now that I think about it, that was probably for the best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_69","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_69","text":"By what means didst thou come upon the remains of Lilith, Fire Dragon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_70","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_70","text":"Not sure. Just a gut feeling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_71","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_71","text":"Thou surely hast a conspirator amongst thy ranks. A fellow Heretic yearning for the Queen's downfall.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_72","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_72","text":"Haha, you're free to think that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_73","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_73","text":"Anyway, Liberalio was frantic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_74","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_74","text":"She scoured everywhere for Lilith's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_75","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_75","text":"But in the midst of that, the Queen's voice suddenly went quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_76","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_76","text":"Because of what you guys called the \"veil\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_77","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_77","text":"After that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_78","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_78","text":"We've been wandering the surface, abandoned.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_79","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_79","text":"For one of thy plight, thou has been exceedingly rambunctious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_80","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_80","text":"What can you expect from children who've lost their mother?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_81","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_81","text":"I \"remember\" the Gene Reaper's goal was to set things in proper order before the Queen descends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_82","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_82","text":"Dost thou know what this doth mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_83","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_83","text":"It's simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_84","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_84","text":"She was paving the way for the return of her beloved mother, whom she had not been able to see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_85","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_85","text":"If her mother returns to find the house a mess, she'd be mighty upset.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_86","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_86","text":"She was obsessed with getting everything in order to welcome Mother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_87","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_88","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_88","text":"In other words, she's crazy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_89","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_89","text":"I do agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_90","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_90","text":"Here. It's right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_91","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_91","text":"Amid the corpses, an old stone coffin can be seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_wm_grassland","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_92","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_92","text":"Nayuta slowly approaches and carefully opens the lid.","jump":null,"exit":false,"enter":null,"bg":"EventScene_goddessfall_03","bgArt":"eventscene_goddessfall_03","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_93","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_93","text":"Inside lies a fragile body in a white dress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_94","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_94","text":"Her hands are neatly gathered together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_95","text":"The flowers that once filled the coffin, crumbled even at the slightest breeze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_96","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_96","text":"The headless goddess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_97","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_97","text":"Liliweiss's body lay there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_98","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_98","text":"Lili...weiss...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_99","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_99","text":"Lili...weiss...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_100","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_100","text":"*Sob... sob...*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_101","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_101","text":"Why are you crying and making a scene?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_102","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_102","text":"F-forgive me. Wouldst thou lend me thy assistance in extricating her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_103","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_103","text":"I desire to treat her with the utmost gentleness possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_104","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_104","text":"All right. Let's do it this way then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["nayuta","nihilister_m"],"affinity":null},{"id":"event_goddessfall1_02_e_105","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_105","text":"Nihilister leans down and scoops up Liliweiss's body.","jump":null,"exit":false,"enter":null,"bg":"TemporaryCamp","bgArt":"temporarycamp","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_106","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_106","text":"Just like that, she lifts Liliweiss's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_107","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_107","text":"Liliweiss's body hangs limp.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_108","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_108","text":"Thou dost not understand the meaning of treating her with care...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_109","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_109","text":"Of course I do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_110","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_110","text":"*Crack! Craack!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_goddessfall_drifter","movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_111","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_111","text":"Liliweiss's body disappears as though it were being absorbed into Nihilister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_112","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_goddessfall1_02_e_112","text":"*Thuuud*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_113","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_113","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_114","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_114","text":"*Sigh* Finally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_115","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_115","text":"Thou scoundrel!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_116","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_116","text":"Whoa, don't get so worked up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_117","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_117","text":"I didn't actually absorb her. I'm just storing her inside my body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_118","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_118","text":"Well... She might be a little beaten up once I spit her out, but at least she's safe, right? There's no risk of losing her too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_119","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_119","text":"Like you said, we need to treat her with \"utmost\" care, don't we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_120","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_120","text":"I'll end thy life this instant, thou vile fiend!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_121","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_121","text":"If I die, then Lilith's body will turn to dust.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_122","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_122","text":"Are you sure that's what you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_123","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_123","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_124","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_124","text":"I have to make sure I come out of this alive, don't I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_125","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_125","text":"If I simply gave you Lilith's body, I'll only be a liability to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_126","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_126","text":"There's nothing guaranteeing that I'd be kept safe from harm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_127","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_127","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_128","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_128","text":"Just think of this in simpler terms. The transport vessel has changed, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_129","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_129","text":"Our little \"truce\" is still in effect. Nothing has changed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_130","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_130","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_131","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_131","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_132","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_132","text":"Very well. Let's return to Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_133","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_133","text":"There, that's better. You see, calming down helps you think straight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_134","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_134","text":"Please...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_135","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:event_goddessfall1_02_e_135","text":"Do be silent...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goddessfall1_02_e_136","type":"Speech","speaker":"nihilister_m","key":"Locale_MainScenario:event_goddessfall1_02_e_136","text":"Haha, a while ago, you were all about small talk. Now you want me to shut up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}