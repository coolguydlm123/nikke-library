{"id":"d_counseling_leona_07","cat":"counsel","group":{"id":"char5092","label":"Leona"},"label":"Advising Leona: 07","stage":null,"prev":"d_counseling_leona_06","next":"d_counseling_leona_08","speakers":{"leona":"Leona"},"icons":{"leona":"si_c382_00_s"},"lines":[{"id":"d_counseling_leona_07_1","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_1","text":"Timi has been shedding like crazy lately.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["leona"],"affinity":"_0"},{"id":"d_counseling_leona_07_2","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_2","text":"I could probably knit a blanket with all the fur he's lost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_07_3","text":"You should brush Timi every day.","jump":"d_counseling_leona_07_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_leona_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_07_4","text":"It's shedding season, so these things are inevitable.","jump":"d_counseling_leona_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_leona_07_5","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_5","text":"Are you insinuating that I don't already do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_6","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_6","text":"Zoo Keeper, that's mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_7","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_7","text":"Where do you think Timi's beautiful coat gets its luster?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_8","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_8","text":"I take great care to brush it every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_9","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_9","text":"During the shedding season, it doesn't matter how often you brush them. They just keep shedding.","jump":"d_counseling_leona_07_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_10","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_10","text":"You're right. No matter how much I brush him, it doesn't seem to make any difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_11","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_11","text":"It takes me over an hour to remove all the strands of hair off my clothes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_12","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_12","text":"Anyway, I'm impressed you knew about seasonal shedding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_13","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_07_13","text":"Are you sure you don't want to volunteer at the animal shelter?","jump":"d_counseling_leona_07_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_07_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_leona_07_14","text":"I have a discussion with Leona about Timi's shedding.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}