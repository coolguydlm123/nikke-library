{"id":"d_counseling_mary_11","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 11","stage":null,"prev":"d_counseling_mary_10","next":"d_counseling_mary_12","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_11_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_11_1","text":"I've been thinking about redecorating the rooms for our long-term patients, giving them some pizzazz.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_11_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_11_2","text":"If you have any good ideas, feel free to share.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_11_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_11_3","text":"How about we place some flowers?","jump":"d_counseling_mary_11_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_11_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_11_4","text":"Let's put in a video game system.","jump":"d_counseling_mary_11_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_11_5","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_11_5","text":"Hmm...the only thing is that it's very difficult to find any fresh flowers in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_11_6","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_11_6","text":"But if you're able to bring some back from up on the surface, then","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_11_7","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_11_7","text":"I think the patients would be very happy. I'd appreciate it as well, hehe.","jump":"d_counseling_mary_11_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_11_8","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_11_8","text":"Are you sure that's not just what you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_11_9","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_11_9","text":"On top of that, not every patient is in the condition to be gaming.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_11_10","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mary_11_10","text":"Mary and I brainstormed about ways to decorate the hospital rooms.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}