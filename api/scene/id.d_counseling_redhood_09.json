{"id":"d_counseling_redhood_09","cat":"counsel","group":{"id":"char5101","label":"Red Hood"},"label":"Advising Red Hood: 09","stage":null,"prev":"d_counseling_redhood_08","next":"d_counseling_redhood_10","speakers":{"redhood":"Red Hood"},"icons":{"redhood":"si_c470_00_s"},"lines":[{"id":"d_counseling_redhood_09_1","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_1","text":"How's my buddy, Snow White?","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":["redhood"],"affinity":"_0"},{"id":"d_counseling_redhood_09_2","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_2","text":"Is she still as adorable as before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_09_3","text":"Utterly irresistible.","jump":"d_counseling_redhood_09_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_redhood_09_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_09_4","text":"The relationship between you two is... rather unusual.","jump":"d_counseling_redhood_09_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_redhood_09_5","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_5","text":"Ha, she really is, isn't she?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_6","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_6","text":"I'm going to tell you something that I haven't told anyone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_7","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_7","text":"There's no better feeling than getting her in a solid headlock with only one arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_8","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_8","text":"Her reaction is simply adorable.","jump":"d_counseling_redhood_09_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_9","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_9","text":"Huh? What's so strange about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_10","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_10","text":"She's as cute as a button! No one can deny that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_11","type":"Speech","speaker":"redhood","key":"Locale_Counseling:d_counseling_redhood_09_11","text":"Oh, you know what? There was this one time...","jump":"d_counseling_redhood_09_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_redhood_09_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_redhood_09_12","text":"Red Hood goes on to tell various stories about Snow White, but it feels like she is describing a completely different person.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}