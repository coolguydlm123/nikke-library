cale_SubScenario:event_skyontherock_prologue_77","text":"On top of that, the paperwork required for flying has more than doubled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_78","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_78","text":"But rules are rules, and no matter how much paperwork there is, we still have to follow the proper procedures...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_79","type":"Self","speaker":null,"key":"Locale_SubScenario:event_skyontherock_prologue_79","text":"That's a shame. I was hoping to go on a balloon ride with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_80","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_80","text":"I-I really want to ride in a balloon with you too, Captain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_81","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_81","text":"So if we ever get the chance...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_82","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_82","text":"I hope you'll let me come along!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}