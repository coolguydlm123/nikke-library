_SubScenario:event_skyontherock_prologue_19","text":"And you just barely passed, Captain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_20","type":"Self","speaker":null,"key":"Locale_SubScenario:event_skyontherock_prologue_20","text":"... Lowest score possible, huh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_21","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_21","text":"Isn't what matters that you scored at least 70?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_22","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_22","text":"There's a 30-point gap between a 70 and a perfect score, but in the grand scheme of things, it makes little difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_23","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_23","text":"On the other hand, that single point between a 69 and a 70 can make all the difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_24","type":"Self","speaker":null,"key":"Locale_SubScenario:event_skyontherock_prologue_24","text":"Yeah, that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_skyontherock_prologue_25","type":"Speech","speaker":"sky","key":"Locale_SubScenario:event_skyontherock_prologue_25","text":"Just a moment