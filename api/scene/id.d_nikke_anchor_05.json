_anchor_05_138","text":"Where was that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_139","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_139","text":"The Merchant Union.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_140","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_140","text":"They must have seen some way they could benefit from this whole situation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_141","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_141","text":"so they said they'd handle lobbying the Wildlife Agency themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_142","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_142","text":"Then they came to us with a proposal and asked if they could sell...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_143","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_143","text":"character merch of the Admire, the starfish, Anchor, and everything else...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_144","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_05_144","text":"Wow...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_145","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_145","text":"I can scarcely believe it myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_146","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_146","text":"So Anchor, you don't have to run around","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_147","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_147","text":"worrying that they'll take your marine creatures away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_148","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_148","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_149","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_149","text":"Even though it seems you can get by without them now,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_150","type":"Speech","speaker":"helm","key":"Locale_NikkeEpisode:d_nikke_anchor_05_150","text":"I can see that you're still fond of them, yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_151","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_151","text":"Yes! Yes, of course!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_152","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_05_152","text":"That's good news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_153","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_anchor_05_153","text":"We peek inside the box and see the marine creatures wriggling about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_154","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_05_154","text":"From now on, these won't be Anchor's cherished dolls anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_155","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_anchor_05_155","text":"Instead, they'll be a symbol that we made it back alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_156","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_156","text":"A symbol...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_157","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_157","text":"From now on,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_158","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_158","text":"whenever I'm feeling down,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_159","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_159","text":"and start to doubt whether I'm alive or not,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_160","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_160","text":"I'll look at these marine creatures and remind myself of this moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_161","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_161","text":"If life isn't defined by the body,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_162","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_162","text":"but by the things we like, dislike, or feel we absolutely must do...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_163","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_163","text":"Then you're part of that now too, Captain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_164","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_164","text":"You jumped into the water to save me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_anchor_05_165","type":"Speech","speaker":"anchor","key":"Locale_NikkeEpisode:d_nikke_anchor_05_165","text":"So even if my heart doesn't beat, I'll live like it does 