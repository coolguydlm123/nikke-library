{"id":"d_counseling_hongryeon_12","cat":"counsel","group":{"id":"char5041","label":"Scarlet"},"label":"Advising Scarlet: 12","stage":null,"prev":"d_counseling_hongryeon_11","next":"d_counseling_hongryeon_13","speakers":{"hongryeon":"Scarlet"},"icons":{"hongryeon":"si_c222_00_s"},"lines":[{"id":"d_counseling_hongryeon_12_1","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_1","text":"Snow White inquired unto me what I find so enchanting about drinking.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_12_2","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_2","text":"Tell me, my good fellow, why do you drink?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_12_3","text":"I like the taste.","jump":"d_counseling_hongryeon_12_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_12_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_12_4","text":"To get drunk.","jump":"d_counseling_hongryeon_12_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_12_5","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_5","text":"Indeed, spirits are a most intoxicating elixir.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_6","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_6","text":"It is most upsetting that others of the female persuasion shan't appreciate its flavor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_7","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_7","text":"To that end, I brought some of the finest spirits with me. Would you perchance care to have a nip?","jump":"d_counseling_hongryeon_12_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_8","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_8","text":"To imbibe simply to be three sheets to the wind is a rather trying experience on one's body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_9","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_9","text":"There are as many flavors of spirit as there are stars in the sky, and you can have your pick of the lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_10","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_10","text":"However, one must take care not to overdo it, as inebriation must not be one's end goal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_11","type":"Speech","speaker":"hongryeon","key":"Locale_Counseling:d_counseling_hongryeon_12_11","text":"With that being said, why don't we have a drink?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_12_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_12_12","text":"Scarlet and I had a conversation about different flavors of alcohol.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}