d","key":"Locale_MainScenario:d_main_46_af_09_7","text":"And that you smuggled out a book about Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_8","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_8","text":"Apparently you were attacked while making your escape?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_9","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_9","text":"Is that correct?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_10","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_46_af_09_10","text":"Yes. That's about right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_11","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_11","text":"... What are you being so brazen about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_12","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_12","text":"It's only thanks to Arcana that we found you so quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_13","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_13","text":"Had we been any later, we might not have been able to save you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_14","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_46_af_09_14","text":"But you did save me, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_15","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_15","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_16","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_46_af_09_16","text":"Oh, um... What became of Arcana...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_17","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_17","text":"Since Forbidden Library materials were leaked under her care, she will be punished accordingly...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_18","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_46_af_09_18","text":"I'm the one who stole it. She's the victim here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_19","type":"Speech","speaker":"eyeri","key":"Locale_MainScenario:d_main_46_af_09_19","text":"Why would you punish the victim? What kind of abuse of power is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_09_20","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_09_20","text":"I haven't finished speaking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":nul