_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_13","text":"... I still feel like it's not enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_14","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_14","text":"When we went to see the movie and ran into Laplace, and the time we spent talking with Guillotine at the cafe,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_15","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_15","text":"I actually felt upset because it meant I had less time alone with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_16","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_16","text":"... When I asked to go sh-shopping together, it was because I wanted to spend m-more time with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_17","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_17","text":"But even now, I still want more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_18","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_18","text":"You're the only one who makes me feel this way,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_19","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_19","text":"so I don't know what to call these feelings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_20","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_20","text":"That's why I asked you to spend the day with me, so I could try to figure it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_21","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_21","text":"But I still don't know,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_22","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_22","text":"... and that makes me really anxious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_23","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_23","text":"... Vesti.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_24","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_24","text":"Close your eyes for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_vesti_tactical_05_25","type":"Speech","speaker":"vesti_t","key":"Locale_NikkeEpisode:d_nikke_vesti_tactical_05_25","text":"Uh... cl-close my eyes? Why all of a sudden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"i