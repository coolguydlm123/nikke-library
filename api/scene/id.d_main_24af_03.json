've been revived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_7","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_7","text":"But what about my pride! I scampered off with my tail between my legs!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_8","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:d_main_24af_03_8","text":"I thought you gave up any notion of pride when you played dead and let yourself be dragged all that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_9","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_9","text":"... You better shut your mouth, or I'll shut it for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_10","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:d_main_24af_03_10","text":"My apologies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_11","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_11","text":"Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_12","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_12","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_13","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_13","text":"Who on earth was that thing? What was up with her head turning red? She went berserk!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_14","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_14","text":"I'm not sure myself. It's my first time seeing that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_15","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_15","text":"You don't know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_16","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24af_03_16","text":"*Pow*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_17","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_17","text":"So that's it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_18","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_18","text":"Seems so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_19","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_19","text":"Well, go and find out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_20","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_24af_03_20","text":"*Pow*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_21","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_22","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_22","text":"Nothing gets through this half-breed's thick skull if you say it nicely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_23","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_23","text":"I don't see why it's necessary to use slurs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_24","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_24","text":"Well, I do. What are you gonna do to me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_25","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_26","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_26","text":"You should all be thanking me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_27","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_27","text":"I'm the one who provided all that tasty grub for you two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_28","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_28","text":"You're only here because of me. Without me, you'd both be in a scrap heap being dismantled for spare parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_29","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_29","text":"So, for the last time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_30","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_30","text":"go find out about that crimson son-of-a-bitch!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_31","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_31","text":"I don't answer to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_32","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_32","text":"The only orders I follow are those from the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_33","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_33","text":"What are you blabbering about? The Queen doesn't even know who you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_34","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_34","text":"I don't care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_35","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_35","text":"I've been saved by the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_36","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_36","text":"I had lost my way and was on the verge of dying, but the Queen saved me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_37","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_37","text":"So, she's the only one who gets to order me around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_38","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:d_main_24af_03_38","text":"Not you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_39","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_39","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_40","type":"Speech","speaker":"nihilister_a","key":"Locale_MainScenario:d_main_24af_03_40","text":"Whoa. Well done for you and your commendable sense of loyalty!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24af_03_41","type":"Speech","speaker":"indivilia","key":"Locale_MainScenario:d_main_24