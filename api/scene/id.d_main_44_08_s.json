{"id":"d_main_44_08_s","cat":"main","group":{"id":"ch44","label":"Chapter 44 · Path"},"label":"A New Imitation: A","stage":"44-36 BOSS · Start","prev":"d_main_44_07","next":"d_main_44_08_e","speakers":{"snowwhite_h":"Snow White","anis_i":"Anis","rapi_red":"Rapi","altruia":"Altruia"},"icons":{"snowwhite_h":"si_c471_00_s","anis_i":"si_c017_00_s","rapi_red":"si_c016_00_s","altruia":"si_c9017_00_s"},"lines":[{"id":"d_main_44_08_s_1","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_1","text":"A few days later...","jump":null,"exit":false,"enter":null,"bg":"land_d","bgArt":"land_d","image":null,"bgm":"bgm_chapter44_field_ashesofeden","movie":null,"shown":["snowwhite_h","anis_i","rapi_red"],"affinity":null},{"id":"d_main_44_08_s_2","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_2","text":"Liberalio said she would speak with the Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_3","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_3","text":"We shouldn't trust her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_4","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_4","text":"I'm certain the Queen can't be reasoned with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_5","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_5","text":"We should make our own preparations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_6","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_6","text":"Yeah, we'll be prepared for the worst.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_7","text":"I trust Liberalio, but given who we're dealing with, we can't rule out the possibility that things will go south.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_8","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_8","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_9","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_9","text":"Keep walking this way, and you'll reach the elevator to the Ark in two days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_10","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_10","text":"This is as far as I'll take you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_11","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_08_s_11","text":"This was less of an escort and more of a catch-up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_12","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_12","text":"Thanks to that, I feel much calmer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_13","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_13","text":"Speaking about myself to someone else helps more than I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_14","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_14","text":"Go. We'll meet again.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_15","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_08_s_15","text":"All right, see you aga...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_16","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_16","text":"Suddenly, something with a strange silhouette appears in the distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_17","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_17","text":"It looks human... but there's something off about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_18","text":"It stands there, unmoving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_19","text":"For some reason, it feels like it's watching us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_20","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_08_s_20","text":"What is that...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_21","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_08_s_21","text":"Whatever it is, it isn't our ally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_22","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_23","text":"Should we get closer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_24","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_24","text":"No. It's coming to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_25","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_25","text":"The strange silhouette moves toward us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["altruia"],"affinity":null},{"id":"d_main_44_08_s_26","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_26","text":"I am grateful for this unexpected encounter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_27","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_27","text":"If it is not too great an imposition, may I ask you a question?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_28","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_28","text":"A gentle voice seems to echo around us, paired with a serene face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_29","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_29","text":"However, one thing is clear to all of us:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_30","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_30","text":"Whatever this thing is, it's neither Nikke nor Rapture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_31","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_08_s_31","text":"Who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_32","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_32","text":"I am Altruia.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_33","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_33","text":"That is the glorious name bestowed upon me by Mother.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_34","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_08_s_34","text":"Mother?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_35","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_35","text":"Yes, that is correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_36","text":"You mean the Queen...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_37","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_37","text":"Ah, yes. Indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_38","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_38","text":"It brings me such relief that you understood so quickly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_39","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_39","text":"The human imposters I encountered over these past few days could not grasp my words. It grieved me deeply.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_40","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_44_08_s_40","text":"Are you a Heretic?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_41","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_41","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_42","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_42","text":"Such blasphemous words! Refrain from speaking them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_43","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_43","text":"We are daughters born of our Mother!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_44","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_44","text":"As such, we are worthy of being addressed by our noble names!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_45","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_08_s_45","text":"Wh-what's up with her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_46","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_08_s_46","text":"It looks like she's part of the Queen's new elite forces.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_47","text":"... So, what did you want to ask?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_48","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_49","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_49","text":"Ah, yes. Forgive me. I let my emotions get the best of me for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_50","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_50","text":"How might one be invited to the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_51","text":"Why do you need an invitation to the Ark...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_52","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_52","text":"I have received orders to bring about humanity's extinction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_53","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_53","text":"I know its location, but it would be improper to go there uninvited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_08_s_54","text":"Extinction...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_55","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_55","text":"That is the mission Mother has personally entrusted to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_56","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_56","text":"And yet... I do not wish to take their lives without cause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_57","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_57","text":"For they too must have lives of their own, guided by aspirations they hold sacred.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_58","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_58","text":"Even if it is Mother's divine command, I cannot commit such savage and barbaric acts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_59","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_59","text":"Thus, after receiving formal invitation to the Ark and taking my place, I shall engage in deep, heartfelt conversation with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_60","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_60","text":"I shall propose their extinction,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_08_s_61","type":"Speech","speaker":"altruia","key":"Locale_MainScenario:d_main_44_08_s_61","text":"in the most peaceful and merciful manner possible.","jump":null,"exit":false,"enter":null