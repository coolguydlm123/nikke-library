ll,"affinity":null},{"id":"d_main_19_01_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_63","text":"It's certainly tempting...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_64","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_64","text":"But we have to keep our mission strictly confidential. We don't want any leaks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_65","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19_01_65","text":"It should be okay if we keep it between us. How about if we use some kind of secret code?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_66","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_66","text":"Nice! Let's do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_67","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_67","text":"From now on, our codename for our destination is \"sewage.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_68","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19_01_68","text":"As for the item we're after, we'll call it \"cartridge case.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_69","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_69","text":"... You do realize I can hear everything you're saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}