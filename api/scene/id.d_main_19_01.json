{"id":"d_main_19_01","cat":"main","group":{"id":"ch19","label":"Chapter 19 · Eden"},"label":"A Butterfly Chasing Bees","stage":"19-3 STAGE · End","prev":null,"next":"d_main_19_02","speakers":{"rapi":"Rapi","anis":"Anis","neon":"Neon","Self":"Commander","unknown":"???","papillon":"Papillon"},"icons":{"rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","unknown":"si_c999_00_s","papillon":"si_c890_00_s"},"lines":[{"id":"d_main_19_01_1","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_1","text":"Clear.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":"bgm_peripeteia_a","movie":null,"shown":["neon","anis","rapi"],"affinity":null},{"id":"d_main_19_01_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_2","text":"It's a clear shot to the research facility from here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_3","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_3","text":"We're well-stocked with supplies. Things are looking good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_4","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_4","text":"There is something, however, that I'm curious about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_5","text":"Are Nikkes allowed to engage in operations on the surface without a commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19_01_6","text":"Huh? I don't remember ever doing that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_7","text":"Then what about conducting corporate espionage to spy on another squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_8","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_01_8","text":"It's completely forbidden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_9","text":"So they say. Anyway, what's our next move, Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_11","text":"Show yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_12","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_12","text":"If you're not out here by the time I count to three, I'll open fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_13","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_13","text":"Three.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_14","type":"Speech","speaker":"unknown","key":"Locale_MainScenario:d_main_19_01_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_15","text":"Two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_16","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_16","text":"Ugh, what a killjoy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_stormbreakers","movie":null,"shown":["papillon"],"affinity":null},{"id":"d_main_19_01_17","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_17","text":"I was going to come out when the timing was right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_18","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_18","text":"Not when there are all these irksome bees buzzing about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_19","text":"Hey, aren't you the one always trailing behind Burningum?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_20","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_20","text":"That's me! Thanks for noticing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_21","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_01_21","text":"What are you doing here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_22","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_22","text":"As if you had to ask! I'm here to lend a hand, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19_01_23","text":"If you want to help, how about fixing our dorm which your superior laid waste to?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_24","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_24","text":"Sorry, I'm afraid that's out of my purview.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_25","text":"Didn't Burningum put a hit out on us before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_26","text":"You oughta compensate us for emotional distress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_27","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_28","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_28","text":"I'm very disappointed in you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_29","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_29","text":"We're all paid employees working for the same people. You really ought to be more trusting of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_30","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_30","text":"Honey, everybody's ganging up on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_31","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_31","text":"Why don't you put a stop to them? I thought you'd want to defend my honor...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_32","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_01_32","text":"Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_01_33","text":"But I don't think I can help you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_34","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_34","text":"What are you really doing out here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_35","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_35","text":"Are you conducting surveillance, or trying to turn up information on Marian?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_36","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_36","text":"*sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_37","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_37","text":"Now now, don't get your stinger in a tangle, busy little bee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_38","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_38","text":"Fine, I can see none of you are in the mood for repartee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_39","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_39","text":"You asked if I wanted information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_40","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_40","text":"That's precisely what I'm after. If not that, then what else? At this point, it's about all you can offer me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_41","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_41","text":"You don't have a problem with that, do you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_42","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_42","text":"After all, sharing information isn't a one-way street.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_43","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_01_43","text":"What are you getting at?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_44","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_44","text":"Let me put it this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_45","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_45","text":"If you scratch my back, I'll scratch yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_46","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_46","text":"If you do that, you might be able to receive some top-secret information about a certain Deputy Chief in the process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_47","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_47","text":"So let's say... what's a good example...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_48","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_48","text":"Ah, got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_49","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_49","text":"The \"fact\" that there are zero survivors on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_50","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_50","text":"That's a bald-faced lie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_51","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_51","text":"In truth, there's a lost utopia where humans have gathered and are living quite happily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_52","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_01_52","text":"Were you not aware of this? The suits at the Ark have known about it for a coon's age.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_53","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_01_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_54","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_19_01_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_01_55","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19_01_55","text":"You mean someplace other than the amusement park?","jump":null,"exit":f