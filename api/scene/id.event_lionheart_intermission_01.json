ump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_intermission_01_32","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_intermission_01_32","text":"Honnêtement, I did feel that one week was a tad exagéré.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_intermission_01_33","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_intermission_01_33","text":"However, I felt it might be a good opportunity for the ladies to have a rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_intermission_01_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_lionheart_intermission_01_34","text":"Do you really think Happy Zoo would be able to relax peacefully with their animals locked up for an entire week?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_intermission_01_35","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_intermission_01_35","text":"Quoi? Whatever are you talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_intermission_01_36","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_intermission_01_36","text":"I was told les animaux would be cared for in the meantime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_intermission_01_37","type":"Speech","speaker":"mustang","key":"Locale_SubScenario:event_lionheart_intermission_01_37","text