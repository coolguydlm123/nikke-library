{"id":"msg_m_ex_777_02","cat":"messenger","group":{"id":"room_777","label":"777 · Group"},"label":"2. Pit Boss!","stage":null,"prev":"msg_m_ex_777_01","next":null,"speakers":{"blanc":"Blanc","noir":"Noir"},"icons":{"blanc":"si_c270_00_s","noir":"si_c271_00_s"},"lines":[{"id":"m_ex_777_02_1","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_1","text":"Pit Boss!","jump":null},{"id":"m_ex_777_02_2","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_2","text":"You there?","jump":null},{"id":"m_ex_777_02_3","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_3","text":"I much prefer 'Honey'.","jump":"m_ex_777_02_5"},{"id":"m_ex_777_02_4","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_4","text":"I much prefer 'Master'.","jump":"m_ex_777_02_11"},{"id":"m_ex_777_02_5","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_5","text":"Hehe.","jump":null},{"id":"m_ex_777_02_6","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_6","text":"Honey?","jump":null},{"id":"m_ex_777_02_7","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_7","text":"Sounds kinda weird to me.","jump":null},{"id":"m_ex_777_02_8","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_8","text":"Blanc! Don't be so rude.","jump":null},{"id":"m_ex_777_02_9","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_9","text":"Oh, relax! They don't care.","jump":null},{"id":"m_ex_777_02_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_10","text":"Anyway, what can I do for you?","jump":"m_ex_777_02_14"},{"id":"m_ex_777_02_11","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_11","text":"If you insist!","jump":null},{"id":"m_ex_777_02_12","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_12","text":"Master!","jump":null},{"id":"m_ex_777_02_13","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_13","text":"Yes?","jump":null},{"id":"m_ex_777_02_14","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_14","text":"Coin Rush is","jump":null},{"id":"m_ex_777_02_15","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_15","text":"putting on a new show.","jump":null},{"id":"m_ex_777_02_16","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_16","text":"We need some help with the name.","jump":null},{"id":"m_ex_777_02_17","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_17","text":"Right now it's \"The Blanc & Noir Show\".","jump":null},{"id":"m_ex_777_02_18","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_18","text":"It's waaaay too generic.","jump":null},{"id":"m_ex_777_02_19","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_19","text":"Have you got any better suggestions?","jump":null},{"id":"m_ex_777_02_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_20","text":"The Ultra-Fantastic Bunny Hour.","jump":null},{"id":"m_ex_777_02_21","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_21","text":"???","jump":null},{"id":"m_ex_777_02_22","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_22","text":"???","jump":null},{"id":"m_ex_777_02_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_23","text":"... Just kidding.","jump":null},{"id":"m_ex_777_02_24","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_24","text":"... I'm not entirely convinced you were.","jump":null},{"id":"m_ex_777_02_25","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_25","text":"Hahahaha!","jump":null},{"id":"m_ex_777_02_26","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_26","text":"Any keywords that you want included?","jump":null},{"id":"m_ex_777_02_27","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_27","text":"We definitely want our names in it.","jump":null},{"id":"m_ex_777_02_28","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_28","text":"And it'd be nice if we could squeeze in the word 'lucky'.","jump":null},{"id":"m_ex_777_02_29","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_29","text":"In that case...","jump":null},{"id":"m_ex_777_02_30","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_30","text":"Oh boy, I can't wait!","jump":null},{"id":"m_ex_777_02_31","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_31","text":"Me neither!","jump":null},{"id":"m_ex_777_02_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_32","text":"Noir & Blanc's Lucky Show.","jump":null},{"id":"m_ex_777_02_33","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_33","text":"...","jump":null},{"id":"m_ex_777_02_34","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_34","text":"...","jump":null},{"id":"m_ex_777_02_35","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_35","text":"... Er, just kidding. Again.","jump":null},{"id":"m_ex_777_02_36","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_36","text":"...","jump":null},{"id":"m_ex_777_02_37","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_37","text":"Pit Boss, get serious!","jump":null},{"id":"m_ex_777_02_38","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_38","text":"Yeah!","jump":null},{"id":"m_ex_777_02_39","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_39","text":"We want to hear a real suggestion from you.","jump":null},{"id":"m_ex_777_02_40","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_40","text":"... Actually, those were both serious suggestions.","jump":null},{"id":"m_ex_777_02_41","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_41","text":"Pit Boss?","jump":null},{"id":"m_ex_777_02_42","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_42","text":"Blanc & Noir: The Lucky Bunnies","jump":"m_ex_777_02_44"},{"id":"m_ex_777_02_43","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_43","text":"The Good Luck Bunnies","jump":"m_ex_777_02_44"},{"id":"m_ex_777_02_44","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_44","text":"Neither of the girls reply for a while.","jump":null},{"id":"m_ex_777_02_45","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_45","text":"Not a fan?","jump":null},{"id":"m_ex_777_02_46","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_46","text":"It's not that.","jump":null},{"id":"m_ex_777_02_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_47","text":"Why didn't you reply then?","jump":null},{"id":"m_ex_777_02_48","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_48","text":"We're busy preparing for the show, silly!","jump":null},{"id":"m_ex_777_02_49","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_49","text":"I thought you had the day off.","jump":null},{"id":"m_ex_777_02_50","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_50","text":"Sorry, Pit Boss, but we've kinda got our hands full at the moment.","jump":null},{"id":"m_ex_777_02_51","type":"Speech","speaker":"blanc","key":"Locale_SuddenMessage:m_ex_777_02_51","text":"Talk to you later!","jump":null},{"id":"m_ex_777_02_52","type":"Speech","speaker":"noir","key":"Locale_SuddenMessage:m_ex_777_02_52","text":"Thanks for the suggestions!","jump":null},{"id":"m_ex_777_02_53","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_777_02_53","text":"I'll have to check out the promotional posters later to see what they went with.","jump":null}],"chat":true}