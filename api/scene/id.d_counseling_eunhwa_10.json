{"id":"d_counseling_eunhwa_10","cat":"counsel","group":{"id":"char5023","label":"Eunhwa"},"label":"Advising Eunhwa: 10","stage":null,"prev":"d_counseling_eunhwa_09","next":"d_counseling_eunhwa_11","speakers":{"eunhwa":"Eunhwa"},"icons":{"eunhwa":"si_c092_00_s"},"lines":[{"id":"d_counseling_eunhwa_10_1","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_10_1","text":"Tell me. How do you define comradery?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["eunhwa"],"affinity":"_0"},{"id":"d_counseling_eunhwa_10_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_10_2","text":"It's an unbreakable sense of trust. You can entrust the other person with anything.","jump":"d_counseling_eunhwa_10_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eunhwa_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_10_3","text":"It's a sense of loyalty that lasts forever.","jump":"d_counseling_eunhwa_10_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_eunhwa_10_4","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_10_4","text":"Oh? That means nothing to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_10_5","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_10_5","text":"The only person I can rely on is myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_10_6","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_10_6","text":"The moment I put too much trust in someone else, I could lose everything.","jump":"d_counseling_eunhwa_10_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_10_7","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_10_7","text":"... That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_10_8","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_10_8","text":"No matter what happens, it means nothing if you have no one by your side at the end of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_10_9","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_10_9","text":"I talk with Eunhwa about the meaning of comradery.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}