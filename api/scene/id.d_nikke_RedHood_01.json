{"id":"d_nikke_RedHood_01","cat":"bond","group":{"id":"char5101","label":"Red Hood"},"label":"Half a Legend","stage":null,"prev":null,"next":"d_nikke_RedHood_02","speakers":{"Narration":"Narration","Monologue":"Monologue","redhood":"Red Hood","Self":"Commander","anis":"Anis","neon":"Neon"},"icons":{"Narration":"si_c999_00_s","redhood":"si_c470_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_nikke_RedHood_01_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_1","text":"A campsite on the surface.","jump":null,"exit":false,"enter":null,"bg":"Desert_02_n","bgArt":"desert_02_n","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_2","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_2","text":"My pounding heart keeps me from falling asleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_3","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_3","text":"After tossing and turning, I give up and decide to get up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_4","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_4","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_5","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_5","text":"It's pitch black outside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_6","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_6","text":"I can barely make out anything amongst the stygian abyss around me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_7","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_7","text":"Can't sleep?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_8","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_8","text":"A voice rings out from the darkness, giving me quite a scare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_9","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_9","text":"I turn in the direction of the voice, straining my eyes to make out anything in the darkness of the night.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_10","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_10","text":"Hey, did you hear me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["redhood"],"affinity":null},{"id":"d_nikke_RedHood_01_11","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_11","text":"Slowly but surely, my eyes become accustomed to the darkness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_12","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_12","text":"I can now vaguely make out a striking tinge of red in the moonless night.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_13","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_13","text":"A Nikke clad entirely in red regards me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_14","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_14","text":"You okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_15","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_15","text":"Red Hood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_16","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_16","text":"That's my name. Don't wear it out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_17","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_17","text":"You've been tossing and turning for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_18","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_18","text":"So you're the type that can't sleep anywhere unfamiliar?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_19","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_19","text":"Not exactly. Just couldn't sleep, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_20","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_20","text":"You're not exhausted after walking such a long way? You must be in good shape.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_21","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_21","text":"What about the others?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_22","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_22","text":"Still asleep. Dorothy went for a short walk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_23","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_23","text":"Don't worry about her though, she's not in any danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_24","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_24","text":"She's always wandering off on her own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_25","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_25","text":"Wanna sit in front of me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_26","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_26","text":"I move over and sit in front of Red Hood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_27","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_27","text":"An indistinct red blur is still all I can make out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_28","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_28","text":"Let's see here... how about we make a fire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_29","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_29","text":"Raptures could pick up the heat signals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_30","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_30","text":"Don't worry, I've got your back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_31","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_31","text":"Red Hood gathers some kindling and lights a small fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_32","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_32","text":"Our immediate surroundings are now tinged with a fiery crimson hue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_33","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_33","text":"The flames also illuminate Red Hood's features.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_34","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_34","text":"Much better. This really takes me back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_35","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_35","text":"When I was young... or maybe later on... at any rate, I used to camp a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_36","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_36","text":"I traveled all over the land, camping in every kind of place you can imagine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_37","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_37","text":"I believe you. After all, the Goddesses distinguished themselves all the way back during the 1st Rapture Invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_38","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_39","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_39","text":"So you've heard of us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_40","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_40","text":"Of course, who hasn't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_41","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_41","text":"You make it sound like we're famous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_42","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_42","text":"You are. In the Ark, the Goddess Squad is the stuff of legend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_43","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_44","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_44","text":"After all you've done for us,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_45","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_45","text":"I'd wager most people in the Ark have heard your name, as well as a majority of Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_46","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_46","text":"Are you being for real?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_47","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_47","text":"Have they adapted our story into a movie or a book?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_48","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_48","text":"Well... not yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_49","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_49","text":"Heh, you see? I'd hardly say we're mythical figures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_50","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_50","text":"Information on individual members may be scant, but you're all renowned as a singular unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_RedHood_01_51","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_51","text":"What the... how long have you been awake?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_52","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_52","text":"Just now. Got woken up by all the noise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_53","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_53","text":"Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_54","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_54","text":"Don't worry about it. It's actually pretty calming listening to your voice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_55","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_55","text":"As for the other one... you're about as shrill as a train whistle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_56","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_56","text":"Hey! I like my voice, thank you very much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_57","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_57","text":"Anyway, can you elaborate on what you just said?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_58","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_58","text":"About us being famous as a team and all that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_59","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_59","text":"Hmm... how should I put it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_60","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_60","text":"The Nikkes in the Goddess Squad are regarded as heroes who saved humanity from the Raptures. They're our guardian angels.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_61","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_61","text":"That's why we should always be grateful and show them the proper degree of respect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_62","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_62","text":"Something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_63","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_63","text":"Goddess of Victory statues are all over the Ark, and commemorations are held very often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_64","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_64","text":"But at the same time, no one knows who was in the Goddess Squad, nor the specific actions they took to save us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_65","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_65","text":"In a sense,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_66","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_66","text":"the Goddess Squad is more symbolic than anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_67","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_67","text":"The lack of information even makes some people wonder if you all truly existed, but those with a shred of common sense know in their hearts you did amazing things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_68","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_68","text":"So we're halfway to being legends, is more like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_69","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_69","text":"In a way... I suppose, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_70","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_70","text":"Everyone knows who you are, but no one knows the details of what actually transpired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_71","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_72","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_72","text":"Then how did you know I was a member of the Goddess Squad, Handsome?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_73","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_73","text":"I heard your name being bandied about quite often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_74","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_74","text":"What? She just said people don't know the details. How could...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_75","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_75","text":"Oh, let me guess. Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_76","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_76","text":"No, I heard about you from the other Goddesses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_77","type":"Speech","speaker":"redhood","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_78","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_RedHood_01_78","text":"We've crossed paths with them a few times now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_RedHood_01_79","t