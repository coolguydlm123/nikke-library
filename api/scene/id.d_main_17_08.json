dge of the big lake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_55","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_55","text":"It's hidden inside it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_56","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_08_56","text":"Then there's no time to waste! Let's go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_57","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_57","text":"No. If you go in your current state, you will die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_58","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_58","text":"The Raptures over there are in a different league than the Raptures you'll find here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_59","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_59","text":"You need to gear up properly before you set out, otherwise you won't stand a chance against them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_60","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_08_60","text":"*Sigh* Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_61","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_61","text":"I'll send you the exact coordinates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_62","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_08_62","text":"Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_63","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_63","text":"No need to thank me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_64","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_64","text":"Even if you find the institute,\nI can't promise you'll find anything on how to create it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_65","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_65","text":"And don't forget.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_66","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_66","text":"Once you find out how to synthesize it, the Raptures will be the least of your worries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_67","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_67","text":"A world where Nikkes are given freedom of choice...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_68","type":"Speech","speaker":"snowwhite","key":"Locale_MainSce