{"id":"d_main_17_08","cat":"main","group":{"id":"ch17","label":"Chapter 17 · Purpose"},"label":"Truth","stage":"17-24 STAGE · Start","prev":"d_main_17_07","next":"d_main_17_09","speakers":{"snowwhite":"Snow White","rapi":"Rapi","rapunzel":"Rapunzel","neon":"Neon","anis":"Anis","hongryeon":"Scarlet"},"icons":{"snowwhite":"si_c220_00_s","rapi":"si_c010_00_s","rapunzel":"si_c221_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","hongryeon":"si_c222_00_s"},"lines":[{"id":"d_main_17_08_1","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_1","text":"You are already aware of the effect Vapaus has.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"bgm_story_6f6e6573656c66","movie":null,"shown":["snowwhite","rapunzel","hongryeon","rapi","anis","neon"],"affinity":null},{"id":"d_main_17_08_2","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_2","text":"Perhaps you are already putting it to better use than we ever did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_3","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_3","text":"We only used it as an ace-in-the-hole when eliminating Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_08_4","text":"Are you saying that Vapaus has been distributed in the past?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_5","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_5","text":"Not to just anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_6","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_6","text":"Its uniqueness is due to how it's made. It was discovered purely by happenstance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_08_7","text":"You're saying it was found on accident?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_8","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_8","text":"It was pure coincidence when we found out during one of our fights that someone's blood had a special effect on the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_9","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_08_9","text":"Blood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_10","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_10","text":"Yes. Blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_11","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_11","text":"We found out it could be used as a weapon against the Heretics. It could bring down what we thought was unkillable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_12","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_12","text":"Thus, Vapaus came into existence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_08_13","text":"Vapaus is made from a person's blood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_14","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_14","text":"Yes, him to be specific.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_15","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_15","text":"A bullet made from the blood of our Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_16","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_16","text":"That is Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_17","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_08_17","text":"!!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_08_18","text":"A bullet made from human blood...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_08_19","text":"Is that why no one knew how to manufacture it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_20","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_08_20","text":"If word had gotten out, the Commander would never have been allowed on the battlefield. They would retain him and harvest his blood for the rest of his life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_21","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_08_21","text":"Our Commander was one-of-a-kind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_22","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_08_22","text":"Even then, people considered him a legend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_23","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_08_23","text":"The Legendary Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_24","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_08_24","text":"Back then, bringing down the Heretics paled in significance to a Commander who was able to defeat hordes of Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_25","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_08_25","text":"It was decided he would remain a Commander and that Vapaus would be kept a secret. Only a select few knew of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_26","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_08_26","text":"One of the main reasons for this was likely due to them not having enough time to conduct the proper amount of research.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_17_08_27","text":"Where is he now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_28","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_28","text":"That, I do not know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_08_29","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_30","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_30","text":"My memories were a casualty of my mind switch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_31","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_08_31","text":"Even the story I just told you was relayed to me by Rapunzel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_32","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_32","text":"He's in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_33","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_33","text":"Maybe...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_08_34","text":"What? As in THE Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_35","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_17_08_35","text":"Rapunzel nods her head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_08_36","text":"Seriously? We came all the way up here for nothing?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_37","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_37","text":"He might not be there anymore. He is human after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_17_08_38","text":"What do you mean?\nDidn't you just say he's in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_39","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_39","text":"Did I forget to mention that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_08_40","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_08_40","text":"All of this occurred","jump":null,"exit":fal