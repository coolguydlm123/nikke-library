{"id":"d_counseling_sakura_10","cat":"counsel","group":{"id":"char1012","label":"Sakura"},"label":"Advising Sakura: 10","stage":null,"prev":"d_counseling_sakura_09","next":"d_counseling_sakura_11","speakers":{"sakura":"Sakura"},"icons":{"sakura":"si_c282_00_s"},"lines":[{"id":"d_counseling_sakura_10_1","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_1","text":"When I was out at the mall shopping today, I stopped by to see a fortune teller.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sakura"],"affinity":"_0"},{"id":"d_counseling_sakura_10_2","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_2","text":"When she read my fortune, she mentioned your name. What do you think that means?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_10_3","text":"It certainly sounds positive to me.","jump":"d_counseling_sakura_10_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sakura_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_10_4","text":"I've never put much faith in fortune-telling.","jump":"d_counseling_sakura_10_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sakura_10_5","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_5","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_6","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_6","text":"... Yeah, maybe that was what the fortune teller meant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_7","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_7","text":"I'll have to go see her again sometime.","jump":"d_counseling_sakura_10_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_8","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_8","text":"So you don't think there's any truth to fortune-telling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_9","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_9","text":"Actually, neither do I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_10","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_11","type":"Speech","speaker":"sakura","key":"Locale_Counseling:d_counseling_sakura_10_11","text":"But still, it was nice to hear that you were a part of my future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sakura_10_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_sakura_10_12","text":"I talk with Sakura about fortune-telling for a while.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":