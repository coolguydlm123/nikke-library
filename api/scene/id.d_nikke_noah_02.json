bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_14","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_14","text":"Ah, it's really there.","jump":"d_nikke_noah_02_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_15","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_15","text":"Ha, well, that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_16","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_16","text":"... Isn't it a Black Smith? It's my cash cow!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_17","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_02_17","text":"Noah runs toward the Black Smith's wreck in excitement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_18","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_18","text":"Cash cow?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_19","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_19","text":"Yep! That's exactly what it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_20","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_20","text":"They melt Nikkes alive to get Parts.\nThat's why they are called \"the Walking Recycling Factory\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_21","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_21","text":"You may even find living Nikkes in their belly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_22","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_22","text":"Well, mostly you don't. It's super rare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_23","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_23","text":"Ah!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_24","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_02_24","text":"The Energy Beams from Noah's shields cut the Black Smith into halves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_25","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_25","text":"There's a lot of neatly disassembled Parts inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_26","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_26","text":"Uh... *Cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["littlenikke"],"affinity":null},{"id":"d_nikke_noah_02_27","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_27","text":"... Eh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_enemyclose","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_28","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_28","text":"What is that? A living Nikke in the belly of a Rapture?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_29","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_29","text":"Must have been swallowed pretty recently.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_30","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_30","text":"Do you think I don't know that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_31","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_31","text":"What I am trying to say is, the chances of it actually happening are so small. It's unreal!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_32","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_32","text":"Uh, excuse me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_33","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_33","text":"Are you a Pilgrim... from Eden?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_34","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_34","text":"... Ahem. Oh, yeah, you could say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_35","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_35","text":"Ah, it looks like... I got rescued.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_36","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_36","text":"That's... great...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_37","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_37","text":"Whoa, whoa... Wait a second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_38","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_38","text":"That's not entirely correct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_39","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_39","text":"Although I am a magnificent Pilgrim of legend, I can't save you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_40","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_40","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_41","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_noah_02_41","text":"*Whoosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_42","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_02_42","text":"Noah retrieves her shields.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_43","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_43","text":"As you can see, I'm a tank, not a healer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_44","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_44","text":"I can't do it, so... hang in there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_45","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_45","text":"Wait. I know how to save a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_46","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_46","text":"Oh... does that mean...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_47","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_47","text":"Imposter, you were once an orderly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_48","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_48","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_49","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_49","text":"Come on, I thought you were going to save the day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_50","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_50","text":"Take her to the base to the north.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_51","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_51","text":"... Ah, you mean the “Unlimited” base? Now that you mention it, I remember it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_52","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_52","text":"They save Nikkes in distress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_53","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_53","text":"They may help her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_54","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_54","text":"However...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_55","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_55","text":"We are not doing this for charity. Why should we make trouble for ourselves?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_56","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_56","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_57","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_57","text":"Didn't you hear what I just said? Here on the surface, it's a jungle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_58","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_58","text":"The strong prey on the weak. It is the law here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_59","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_59","text":"To become stronger, I hurt Raptures and collect Parts every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_60","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_60","text":"That's just how it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_61","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_61","text":"Understand?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_62","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_62","text":"But if we leave her here, she won't survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_63","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_63","text":"... Ugh, you're so annoying. What are you even talking about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_64","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_64","text":"I was even younger than her when I was abandoned, and I survived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_65","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_65","text":"I set up an almost-shattered shield on the ground, hid behind it, and counted sheep endlessly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_66","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_66","text":"Then, a few years later, a true Commander told me, “You look useful.” He recruited me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_67","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_67","text":"In this crazy land, I survived just by my unyielding pride.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_68","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_68","text":"... If I was able to make it through, why can't she?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_69","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_69","text":"She is in better condition than I was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_70","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_70","text":"Anyway, I won't touch that dying girl.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_71","type":"Speech","speaker":"noah","key":"Locale_NikkeEpisode:d_nikke_noah_02_71","text":"If you want to carry her to the base, help yourself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_72","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_noah_02_72","text":"... Noah turns around and leaves in a hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_73","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_73","text":"... I'll carry you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_74","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_74","text":"B-but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_75","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_noah_02_75","text":"If we don't follow Noah, we will both die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_noah_02_76","type":"Speech","speaker":"littlenikke","key":"Locale_NikkeEpisode:d_nikke_noah_02_76","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,