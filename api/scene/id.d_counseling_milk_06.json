{"id":"d_counseling_milk_06","cat":"counsel","group":{"id":"char5028","label":"Milk"},"label":"Advising Milk: 06","stage":null,"prev":"d_counseling_milk_05","next":"d_counseling_milk_07","speakers":{"milk":"Milk"},"icons":{"milk":"si_c141_00_s"},"lines":[{"id":"d_counseling_milk_06_1","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_1","text":"Yesterday, I got up in the middle of the night to drink some water.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["milk"],"affinity":"_0"},{"id":"d_counseling_milk_06_2","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_2","text":"But, I stepped on Frima's back. She was just sleeping there on the floor.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_milk_06_3","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_3","text":"She got really worked up about it. But, is it really my fault?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_milk_06_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_milk_06_4","text":"It is your fault.","jump":"d_counseling_milk_06_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_milk_06_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_milk_06_5","text":"It's Frima's fault.","jump":"d_counseling_milk_06_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_milk_06_6","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_6","text":"What did I do wrong?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_milk_06_7","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_7","text":"Isn't it common sense not to sleep on the last step of the stairs? Or anywhere on the stairs, for that matter?","jump":"d_counseling_milk_06_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_milk_06_8","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_8","text":"Right? Don't you think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_milk_06_9","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_9","text":"It's her fault for falling asleep on the stairs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_milk_06_10","type":"Speech","speaker":"milk","key":"Locale_Counseling:d_counseling_milk_06_10","text":"If she does it again, I'll sit on her and crush her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_milk_06_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_milk_06_11","text":"I talk to Milk about Frima's sleeping habits.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}