ll,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_20","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_20","text":"But now that I'm actually here...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_21","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_21","text":"I feel a little relieved.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_22","text":"Can I ask you why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_23","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_23","text":"... I finally see some hope.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_24","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_24","text":"The dream of recapturing the surface that I'd long since given up on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_25","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_25","text":"Perhaps it can be realized in a different way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_26","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_26","text":"What do you mean?","jump":"d_nikke_eunhwa_05_28","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_27","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_27","text":"...","jump":"d_nikke_eunhwa_05_29","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_28","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_28","text":"Shut up and just listen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_29","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_29","text":"The last 2 nights and 3 days you showed your toughness, judgment, and analysis of team members.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_30","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_30","text":"They weren't all bad by my standards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_31","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_31","text":"Compared to other Commanders... There was a difference between livestock and human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_32","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_32","text":"Of course, I wouldn't say it's perfect,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_eunhwa_05_33","type":"Speech","speaker":"eunhwa","key":"Locale_NikkeEpisode:d_nikke_eunhwa_05_33","text":"but I don't expect too much fro