in_swiftbunny_04_6","text":"I take a piece of paper with Mast's name written on it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_7","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_7","text":"as well as the heading, \"Heated Mat Fraud Victims,\" and hand it to Sin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_8","text":"It all depends on the speaker's intent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_9","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_10","text":"This won't be easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_11","text":"Some of these people might not realize that they've been deceived,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_12","text":"and others might not even want to admit it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_13","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_13","text":"Your job this time is to convince those people to use their voices for the right cause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_14","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_14","text":"... That really doesn't sound easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_15","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_15","text":"It'd be simple if I took off my converter, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_16","text":"Well... yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_17","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_17","text":"... Which do you think would be better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_18","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_18","text":"What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_19","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_19","text":"Between the bunny girl outfit and my normal outfit, which would get my point across better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_21","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_21","text":"I mean, I like the bunny girl outfit, but maybe not for this occasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_22","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_22","text":"Hahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_23","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_23","text":"In front of a house in the residential area...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_cottoncandy","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_24","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_24","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_25","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_25","text":"Sin slightly hesitates before carefully ringing the doorbell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_26","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_26","text":"The door creaks open.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_27","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_27","text":"... Who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_28","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_28","text":"Um...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_29","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_29","text":"Sin glances over at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_30","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_30","text":"Just do what you practiced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_31","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_31","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_32","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_32","text":"Sin bows her head at the old lady.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_33","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_33","text":"We're from a support group for heated mat fraud victims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_34","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_34","text":"Did you purchase this heated mat recently?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_35","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_35","text":"Sin shows the old lady the heated mat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_36","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_36","text":"... I did. Is there a problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_37","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_37","text":"We just wanted to let you know that this heated mat is a scam.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_38","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_38","text":"My friend and I were scammed, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_39","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_39","text":"As the old lady hears what Sin has to say, the wariness in her expression slowly fades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_40","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_40","text":"We've been going around looking for other victims so that we can report the seller and get a refund.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_41","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_41","text":"If you wouldn't mind, I'd like to ask for you to sign this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_42","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_42","text":"We'll keep you updated on the progress of the lawsuit using this number...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_43","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_43","text":"What, you think I didn't know it was nonsense?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_44","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_44","text":"I bought it because those salesmen would come by and make pleasant conversation with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_45","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_45","text":"They'd even massage my shoulders, so I felt like I owed them that much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_46","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_47","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_47","text":"The old lady takes the pen from Sin's hand and scribbles her name down on the paper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_48","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_48","text":"Still, when a girl young enough to be my granddaughter is so nice as to come by and try to help,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_49","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_49","text":"I can't sit back and do nothing just because I'm getting a little old.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_50","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_50","text":"... We'll make sure you get your money back. Just leave it to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_cosmos","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_51","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_51","text":"Goodness, you certainly know how to inspire confidence, young lady.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_52","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_52","text":"Come to think of it, the woman up the street bought one too. She's old like me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_53","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_53","text":"Hold on just a moment. I'll call her and tell her to come over. In the meantime, come in and have a cup of tea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_54","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_54","text":"Actually, have you eaten yet? The other day, I just so happened to buy a bit more food than I need...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_55","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_55","text":"The old woman steps back inside, leaving the door open behind her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_56","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_57","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_57","text":"I really can't get used to this sort of thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_58","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_58","text":"You should probably try to get used to it sooner than later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_59","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_59","text":"You'll wear yourself out if you keep reacting to every little normal thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_60","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_60","text":"... So what should I do in a situation like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_61","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_61","text":"All you need to do is say, \"Thank you.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_62","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_63","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_63","text":"Sin smiles and steps through the doorway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_64","type":"Speech","speaker":"sin","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_64","text":"Thank you for the offer! I actually haven't eaten yet!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_65","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_65","text":"You shouldn't go hungry when you're working for a good cause.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_66","type":"Speech","speaker":"sharpgrandma","key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_66","text":"You too, young man! Have a bite to eat before you go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_67","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_67","text":"Okay!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_68","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_68","text":"I check my phone as I respond to the old woman.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_sin_swiftbunny_04_69","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_sin_swiftbunny_04_69","text":"I see a text message saying that things are going well, along with a photo of Mast, Anchor, and Trony being treated to a feast by some older folks.","jump":null,"exit":false,"enter":null