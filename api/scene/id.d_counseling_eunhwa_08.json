{"id":"d_counseling_eunhwa_08","cat":"counsel","group":{"id":"char5023","label":"Eunhwa"},"label":"Advising Eunhwa: 08","stage":null,"prev":"d_counseling_eunhwa_07","next":"d_counseling_eunhwa_09","speakers":{"eunhwa":"Eunhwa"},"icons":{"eunhwa":"si_c092_00_s"},"lines":[{"id":"d_counseling_eunhwa_08_1","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_1","text":"There is no weather in the Ark.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["eunhwa"],"affinity":"_0"},{"id":"d_counseling_eunhwa_08_2","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_2","text":"I find this somewhat depressing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_08_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_08_3","text":"If it's weather you want, we can just go up to the surface for a minute.","jump":"d_counseling_eunhwa_08_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_eunhwa_08_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_08_4","text":"We'll enjoy all four seasons once we reclaim the surface.","jump":"d_counseling_eunhwa_08_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_eunhwa_08_5","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_5","text":"... Have you completely lost your little mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_08_6","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_6","text":"The surface is a war zone.\nYou could get blown to smithereens by a laser beam in the blink of an eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_08_7","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_7","text":"Now you're saying you want to go up just to enjoy the weather?\nThe depths of your stupidity continue to astound me.","jump":"d_counseling_eunhwa_08_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_08_8","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_8","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_08_9","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_9","text":"Now, that's quite a coincidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_08_10","type":"Speech","speaker":"eunhwa","key":"Locale_Counseling:d_counseling_eunhwa_08_10","text":"I was thinking the exact same thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_eunhwa_08_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_eunhwa_08_11","text":"I have a meaningful conversation with Eunhwa.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}