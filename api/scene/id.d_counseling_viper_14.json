{"id":"d_counseling_viper_14","cat":"counsel","group":{"id":"char1022","label":"Viper"},"label":"Advising Viper: 14","stage":null,"prev":"d_counseling_viper_13","next":"d_counseling_viper_15","speakers":{"viper":"Viper"},"icons":{"viper":"si_c112_00_s"},"lines":[{"id":"d_counseling_viper_14_1","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_14_1","text":"If I didn't have this choker on my neck,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["viper"],"affinity":"_0"},{"id":"d_counseling_viper_14_2","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_14_2","text":"what do you think would be the first thing I'd do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_14_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_14_3","text":"... Kill me?","jump":"d_counseling_viper_14_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_viper_14_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_viper_14_4","text":"... Terrorize the Ark?","jump":"d_counseling_viper_14_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_viper_14_5","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_14_5","text":"What? How can you say that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_viper_14_6","type":"Speech","speaker":"viper","key":"Locale_Counseling:d_counseling_viper_14_6","text":"I'd never kill you! You've been so nice to me. I'm not totally heartless, you know.","jump":null,"exit":