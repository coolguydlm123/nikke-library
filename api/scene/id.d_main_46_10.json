{"id":"d_main_46_10","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"Sword and Wings: A","stage":"46-40 BOSS · Start","prev":"d_main_46_09","next":"d_main_46_11","speakers":{"nayuta":"Nayuta","janghwa_n":"Rose","snowwhite_h":"Snow White","mirror_r":"Mirror"},"icons":{"nayuta":"si_c223_00_s","janghwa_n":"si_c971_01_s","snowwhite_h":"si_c471_00_s","mirror_r":"si_c982_00_s"},"lines":[{"id":"d_main_46_10_1","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"SpaceStationRoad","bgArt":"spacestationroad","image":null,"bgm":"bgm_chapter46_field_redlight","movie":null,"shown":["snowwhite_h","nayuta","janghwa_n"],"affinity":null},{"id":"d_main_46_10_2","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_2","text":"You look like you have a lot on your mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_3","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_3","text":"Ah. Well, indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_4","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_4","text":"Feeling pushed around by Mirror?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_5","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_6","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_6","text":"It can't be helped. You lost so many of your clones since that day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_7","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_7","text":"All of you lost a great deal of strength.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_8","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_8","text":"Meanwhile, the Queen got a clean slate,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_9","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_9","text":"and Mirror's been glued to her side, watching everything unfold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_10","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_10","text":"There's bound to be a gap in our intel, don't you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_11","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_11","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_12","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_12","text":"Mirror wants to see where things are at for you all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_13","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_13","text":"Whether you truly have the power to stand against the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_14","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_14","text":"Stand against her? No. We're going to kill her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_15","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_15","text":"She wants to make sure it's not all talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_16","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_16","text":"If you have what it takes to be the ones who kill the Queen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_17","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_17","text":"Mirror will offer even more help than she does now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_18","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_18","text":"But if you're not...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_19","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_19","text":"No doubt she shall cleave to the Queen's side without a moment's hesitation. That much I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_20","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_20","text":"Right. So don't disappoint her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_21","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_21","text":"She's devious, but incredibly capable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_22","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_22","text":"Having her as an ally is always an advantage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_23","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_23","text":"... Art thou not speaking rather too much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_24","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_24","text":"Oh, don't you worry. Mirror probably sent me to see you off just so I'd tell you all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_25","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_25","text":"She loves making others do the talking for her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_26","type":"Speech","speaker":"janghwa_n","key":"Locale_MainScenario:d_main_46_10_26","text":"She fancies herself a puppet master pulling strings from the shadows. She's devious to the core, that Mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_27","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_27","text":"On that, I concur.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_28","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_28","text":"Nayuta.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_29","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_29","text":"... Hm. What troubleth thee?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_30","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_30","text":"Explain how you came to know this Mirror.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_31","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_31","text":"She says she's helping us, but she's more like a Rapture strategist than anything else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_32","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_32","text":"With how she talks about creating Liberalio, she's clearly been around for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_33","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_33","text":"That means she had a significant hand in humanity's destruction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_34","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_34","text":"How did you end up allied with something like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_35","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_35","text":"What a predicament.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_36","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_37","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_37","text":"If I were to lie, wouldst thou let it pass?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_38","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_38","text":"Fine. I'll believe it even if it's a lie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_39","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_39","text":"What an even greater predicament this is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_40","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_41","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_41","text":"'Tis a simple enough tale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_42","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_42","text":"When mine replicas did roam the surface in great numbers, seeking a means to fell the Queen,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_43","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_43","text":"'twas Young Lady Mirror who first approached me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_44","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_44","text":"By means of a nearby Rapture, she did drive a corrupted thorn into me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_45","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_45","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_46","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_46","text":"Fortunately, I am possessed of some small skill in the handling of NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_47","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_47","text":"Should the corruption be minor, I may address it by excising only the corrupted NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_48","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_48","text":"The drawback is that much information is thereby lost. Yet I at least evade utter corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_49","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_49","text":"Young Lady Mirror witnessed this and did propose a deal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_50","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_50","text":"Having observed mine replicas that did linger nearby and the treating of my corruption, she divined the extraordinary nature of my ability and put forth her proposal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_51","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_51","text":"'Twas a deal to strike down the Queen together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_52","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_52","text":"I knew full well the sort of being Young Lady Mirror was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_53","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_53","text":"How grave a threat she doth pose to humanity. How much suffering she hath wrought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_54","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_54","text":"... Even so, I joined hands with her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_55","type":"Speech","speaker":"snowwhite_h","key":"Locale_MainScenario:d_main_46_10_55","text":"... Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_56","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_56","text":"I coveted the knowledge too greatly to forgo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_57","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_57","text":"However many replicas I may possess, there is no means of learning the Raptures' inner affairs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_58","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_58","text":"Thus I joined hands with her, and much was brought to light.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_59","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_59","text":"... 'Twould be a falsehood to claim I felt no self-reproach over that decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_10_60","type":"Speech","speaker":"nayuta","key":"Locale_MainScenario:d_main_46_10_60","text":"Even so, to secure victory, I shall stoop to any deed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":nul