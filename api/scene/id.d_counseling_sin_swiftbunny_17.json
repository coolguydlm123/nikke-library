{"id":"d_counseling_sin_swiftbunny_17","cat":"counsel","group":{"id":"char5183","label":"Sin: Swift Bunny"},"label":"Advising Sin: Swift Bunny: 17","stage":null,"prev":"d_counseling_sin_swiftbunny_16","next":"d_counseling_sin_swiftbunny_18","speakers":{"sin_b":"Sin"},"icons":{"sin_b":"si_c405_00_s"},"lines":[{"id":"d_counseling_sin_swiftbunny_17_1","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_sin_swiftbunny_17_1","text":"As I look at Sin, for some reason she starts to remind me of a butterfly.","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sin_b"],"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_17_2","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_sin_swiftbunny_17_2","text":"Your new outfit makes you look like a butterfly, Sin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_17_3","type":"Speech","speaker":"sin_b","key":"Locale_Counseling:d_counseling_sin_swiftbunny_17_3","text":"A butterfly...? I'm pretty sure this is a bunny girl outfit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sin_swiftbunny_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sin_swiftbunny_17_4","text":"Maybe I got confused, since you're as pretty as a butterfly.","jump":"d_counseling_sin_swiftbunny_17_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sin_swiftbunny_17_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sin_swiftbunny_17_5","text":"Hmm... Now that I look again, you do look like a bunny.","jump":"d_counseling_sin_swiftbunny_17_9","exit":false,"enter":null,"bg":null,"bgAr