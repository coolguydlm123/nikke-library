ario:event_coinrushshowdown2_01_s_5","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_01_s_6","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown2_01_s_6","text":"Partner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_01_s_7","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_01_s_7","text":"I must be pretty stressed lately. I could've sworn I just heard Sugar's voice coming from the fire hydrant cabinet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_01_s_8","type":"Speech","speaker":"sugar_b","key":"Locale_MainScenario:event_coinrushshowdown2_01_s_8","text":"Nothing beats a cup of sugar coffee when you're stressed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_01_s_9","type":"Self","speaker":null,"key":"Locale_MainScenario:event_coinrushshowdown2_01_s_9","text":"... What are you doing in there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_01_s_10","type":"Speech","speaker":"sin_b","key":"Locale_MainScenario:event_coinrushshowdown2_01_s_10","text":"Are you alright, Instructor? Are you so stressed that you're having a conversation with the fire hydrant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinrushshowdown2_01_s_11","type":"Speech","speaker":"mana_b","key":"Locale_MainScenario:event_coinrushshowdown2_01_s_11","text":"*Sigh* I suppo