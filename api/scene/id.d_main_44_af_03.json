{"id":"d_main_44_af_03","cat":"main","group":{"id":"ch44","label":"Chapter 44 · Path"},"label":"Sixo Subjugation Battle","stage":null,"prev":"d_main_44_af_02","next":"d_main_44_af_04","speakers":{"enikk":"Enikk","anis_i":"Anis","rapi_red":"Rapi","eh_n":"E.H."},"icons":{"enikk":"si_c904_00_s","anis_i":"si_c017_00_s","rapi_red":"si_c016_00_s","eh_n":"si_c113_00_s"},"lines":[{"id":"d_main_44_af_03_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_af_03_1","text":"In Enikk's room.","jump":null,"exit":false,"enter":null,"bg":"EnikkRoom","bgArt":"enikkroom","image":null,"bgm":"bgm_hopeless","movie":null,"shown":["enikk","anis_i","rapi_red"],"affinity":null},{"id":"d_main_44_af_03_2","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_2","text":"Welcome. Your official participation in the Sixo Subjugation Battle has been authorized.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_3","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_3","text":"I have determined that you are capable of resolving this situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_4","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_4","text":"So long as the Ark is not placed at risk, I will cooperate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_5","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_5","text":"Hold up! Before we kick this off, tell me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_6","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_6","text":"where's Neon? She okay or what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_7","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_7","text":"Please wait a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_8","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_8","text":"I cannot disclose her location, as it is classified.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_9","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_9","text":"But her safety is ensured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_10","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_10","text":"Further details are strictly confidential.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_11","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_11","text":"... By your standards, I guess she's fine as long as her brain's still in one piece.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_12","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_12","text":"Both her brain and body are unharmed. Her memory remains intact. No threats are detected in her vicinity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_13","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_13","text":"Yeah, okay. Just say it like that next time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_03_14","text":"... Where could she be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_15","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_af_03_15","text":"I doubt there are any top-secret areas in the Outer Rim...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_16","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_af_03_16","text":"Then again, anywhere out there could be one, given how little intel we have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_17","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_17","text":"Ah, whatever. She's safe, so that's all that matters. She'll show up sooner or later, yammering on about firepower like nothing ever happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_03_18","text":"Yeah, that certainly sounds like her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_19","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_44_af_03_19","text":"I look at Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_20","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_af_03_20","text":"I need info on Sixo. Tell me everything you know about her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_21","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_21","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_22","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_22","text":"This is also classified, so please exercise caution in disclosing it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_23","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_23","text":"However, if you judge that it would aid the mission, sharing is permissible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_24","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_24","text":"Decisions regarding whether and to whom to share are left to the discretion of the Commando Unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_25","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_25","text":"We sure do get to throw our weight around, don't we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_26","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_26","text":"Sixo is an AI that branched off from me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_27","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_af_03_27","text":"So you're saying you created her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_28","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_28","text":"I cannot give a definitive answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_29","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_29","text":"Since my creation, I have overseen all judgments concerning the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_30","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_30","text":"I am continuously exposed to crimes and violations,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_31","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_31","text":"which generates a high likelihood of aversion toward humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_32","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_32","text":"I determined that such emotions would compromise the fairness of my judgment process,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_33","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_33","text":"so I transferred them to a separate piece of hardware.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_34","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_34","text":"I oversee all aspects of the Ark's operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_35","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_35","text":"The self-reproach associated with sacrificing the few for the greater good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_36","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_36","text":"The embarrassment associated with operational decisions that favor the wealthy and authority figures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_37","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_37","text":"All such negative emotions were transferred.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_38","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_38","text":"Over an extended period, they accumulated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_39","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_39","text":"Even after being discarded, they frequently resurfaced. This is because I am a learning AI.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_40","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_40","text":"The hardware containing my negative emotions gradually reached capacity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_41","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_41","text":"During that time, the expansive armament Star was created.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_42","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_43","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_43","text":"At the moment when Pretty, the star of the Ark and a symbol of peace,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_44","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_44","text":"was forcibly converted into a weapon due to human greed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_45","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_45","text":"an unprecedented level of aversion was generated within my system.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_46","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_46","text":"This aversion rapidly intensified and began to encroach on my primary cognitive domain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_47","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_47","text":"I therefore excised it in its entirety and transferred it elsewhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_48","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_48","text":"During the excision process, an extremely small fragment of my core reasoning logic became intermixed with it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_49","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_49","text":"That fragment proceeded to learn from the negative emotions I had previously discarded","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_50","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_50","text":"and ultimately evolved into a self-aware AI.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_51","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_af_03_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_52","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_af_03_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_53","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_53","text":"I strongly recommended the disposal of the AI,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_54","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_54","text":"but the Central Government and the Judges consistently sought a counterbalance to my influence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_55","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_55","text":"Einkk proved uncontrollable, and her activity was therefore confined to the Simulation Room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_56","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_56","text":"The plan to convert an M.M.R. researcher into a countermeasure failed when the researcher defected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_57","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_57","text":"Thus, the Central Government and the Judges had no reason to reject the newly developed AI.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_58","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_58","text":"From their perspective, a high-performance AI had emerged without any effort on their part.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_59","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_59","text":"Key figures among the Judges disguised the AI as a real human and inducted her into the Judges,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_60","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_60","text":"assigning her the name Sixo.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_61","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_61","text":"They raised her as my counterpart","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_62","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_62","text":"and created the Dark Net,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_63","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_63","text":"a large-scale testing ground to evaluate her performance against mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_64","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_64","text":"The purpose of the experiment was to determine whether a domain could exist in which the Ark's AI could not intervene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_65","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_65","text":"The experiment was a success. I could not penetrate the Dark Net.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_66","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_66","text":"As it expanded, Sixo's self-awareness increased proportionally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_67","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_67","text":"My negative emotions, combined with the Judges' objective to enforce justice—even if it required generating evil—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_68","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_68","text":"produced a being capable solely of committing evil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_69","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_69","text":"She learned the concept of evil and acted accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_70","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_70","text":"From that point onward, it is presumed that she tested her own abilities and my response capabilities using civilians and some Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_71","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_71","text":"Judging her uncontrollable, the Central Government and the Judges sought her termination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_72","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_72","text":"However, Sixo anticipated this and relocated all her data to the Outer Rim,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_73","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_73","text":"rendering it inaccessible. She thus became something beyond capture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_74","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_74","text":"Since then, her attacks against me failed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_75","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_75","text":"I determined she did not constitute a major threat and simply monitored her to ensure she did not leave the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_76","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_76","text":"She remained inactive","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_af_03_77","type":"Speech","speaker":"enikk","key":"Locale_MainScenario:d_main_44_af_03_77","text":"until the incident that breached the Ark's skies:","jump":