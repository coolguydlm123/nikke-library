sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_10","text":"I thought I'd sent a personal message to just you.","jump":null},{"id":"m_ex_underworldqueen_01_11","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_11","text":"Apparently I accidently sent it to the group chat.","jump":null},{"id":"m_ex_underworldqueen_01_12","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_12","text":"Rosanna","jump":null},{"id":"m_ex_underworldqueen_01_13","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_13","text":"Moran","jump":null},{"id":"m_ex_underworldqueen_01_14","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_14","text":"If either of you want to come, that's fine with me.","jump":null},{"id":"m_ex_underworldqueen_01_15","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_15","text":"Of course, not coming is also an option...","jump":null},{"id":"m_ex_underworldqueen_01_16","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_16","text":"Oof, I can read between the lines.","jump":null},{"id":"m_ex_underworldqueen_01_17","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_17","text":"I know when I'm not wanted.","jump":null},{"id":"m_ex_underworldqueen_01_18","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_18","text":"However, if Mister is going,","jump":null},{"id":"m_ex_underworldqueen_01_19","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_19","text":"then I've gotta tag along.","jump":null},{"id":"m_ex_underworldqueen_01_20","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_20","text":"I'm going too.","jump":null},{"id":"m_ex_underworldqueen_01_21","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_21","text":"Any chance I could have whiskey instead of tea?","jump":null},{"id":"m_ex_underworldqueen_01_22","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_22","text":"On the rocks.","jump":null},{"id":"m_ex_underworldqueen_01_23","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_23","text":"Sorry, I don't have whiskey on hand.","jump":null},{"id":"m_ex_underworldqueen_01_24","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_24","text":"You don't?","jump":null},{"id":"m_ex_underworldqueen_01_25","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_25","text":"That's okay, any alcohol will do.","jump":null},{"id":"m_ex_underworldqueen_01_26","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_26","text":"We don't have any alcoholic beverages here.","jump":null},{"id":"m_ex_underworldqueen_01_27","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_27","text":"You're kidding.","jump":null},{"id":"m_ex_underworldqueen_01_28","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_28","text":"As I said earlier,","jump":null},{"id":"m_ex_underworldqueen_01_29","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_29","text":"if there isn't anything that appeals to you, you don't HAVE to come.","jump":null},{"id":"m_ex_underworldqueen_01_30","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_30","text":"Well then,","jump":null},{"id":"m_ex_underworldqueen_01_31","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_31","text":"it appears my hands are tied.","jump":null},{"id":"m_ex_underworldqueen_01_32","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_32","text":"Perhaps I will indulge in a nice cup of tea. Sounds fancy.","jump":null},{"id":"m_ex_underworldqueen_01_33","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_33","text":"When are you going, Mister?","jump":null},{"id":"m_ex_underworldqueen_01_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_01_34","text":"Right now.","jump":null},{"id":"m_ex_underworldqueen_01_35","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_35","text":"Can you hold up for a moment?","jump":null},{"id":"m_ex_underworldqueen_01_36","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_36","text":"There's something I've gotta take care of.","jump":null},{"id":"m_ex_underworldqueen_01_37","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_37","text":"Once I'm finished, I'll head over to the Commander's Room.","jump":null},{"id":"m_ex_underworldqueen_01_38","type":"Speech","speaker":"rosanna","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_38","text":"We can go together.","jump":null},{"id":"m_ex_underworldqueen_01_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_underworldqueen_01_39","text":"All right, I'll wait for you to get here.","jump":null},{"id":"m_ex_underworldqueen_01_40","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_40","text":"Since Moran isn't replying,","jump":null},{"id":"m_ex_underworldqueen_01_41","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_41","text":"we'll consider her a no-show.","jump":null},{"id":"m_ex_underworldqueen_01_42","type":"Speech","speaker":"sakura","key":"Locale_SuddenMessage:m_ex_underworldqueen_01_42","text":"I'll prepare enough tea for just the three of us.","jump":null},{"id":"m_ex_underworldqueen_01_43","type":"Speech","speaker":"sakura","key":"Locale_SuddenMess