y":null},{"id":"d_main_42_02_71","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_71","text":"Precisely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_72","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_42_02_72","text":"Why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_73","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_42_02_73","text":"Because that's the kind of person you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_74","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_74","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_75","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_42_02_75","text":"... That somehow both makes sense and doesn't at the same time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_76","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_42_02_76","text":"I called it. I have good instincts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_77","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_77","text":"Laplace, you've changed so much. \nYou've become beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_78","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_42_02_78","text":"The same goes for Drake and Maxwell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_79","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_79","text":"I'm sure when the three of you reunite, it will be even more beautiful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_80","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_80","text":"We must rescue them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_81","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_42_02_81","text":"Cinderella...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_82","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_42_02_82","text":"You're positively brimming with heroic spirit!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_83","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_42_02_83","text":"I'm touched and so grateful to have met another true hero!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_84","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_84","text":"... Right. It's important to be grateful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_85","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_86","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_86","text":"And you are...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_87","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_88","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_88","text":"Hello, I'm Liberalio.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_89","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_89","text":"I'm your sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_90","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_90","text":"Whose? Mine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_91","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_91","text":"You're the first daughter Mother made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_92","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_92","text":"I was created based on your data.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_93","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_93","text":"You were the first, and I was the second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_94","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_94","text":"That makes us siblings, Sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_95","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_95","text":"Sorry, but please don't call me that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_96","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_96","text":"I'm not a Heretic anymore.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_97","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_97","text":"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_98","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_98","text":"You cannot change your origin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_99","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_99","text":"And your origin determines what you are.\nTherefore, you cannot change what you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_100","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_100","text":"Your origin makes you my sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_101","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_101","text":"You are the only blood relative I have, the only other one Mother made herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_102","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_102","text":"I am not the Queen's child, nor am I your sister.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_103","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_103","text":"I've come back. Unlike you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_104","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_104","text":"So forgive me, but I'm not interested in being sisters or even friends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_105","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_105","text":"We're working together now because the situation demands it,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_106","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_106","text":"but to me, you're merely someone I'll have to put down one day,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_107","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_107","text":"because you are the Queen's child.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_108","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_108","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_109","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_109","text":"I don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_110","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_110","text":"Nothing you've said can change who you are or where you came from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_111","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_42_02_111","text":"Yes, it can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_112","type":"Speech","speaker":"grave_p","key":"Locale_MainScenario:d_main_42_02_112","text":"Anyone can change. You just have to want it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_113","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_113","text":"So long as someone is there to take your hand, you can change.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_114","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_114","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_115","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_115","text":"I doubt you will ever understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_116","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_116","text":"You're right. I don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_117","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_117","text":"I'll switch topics, then. Talking about things neither of us understands is a waste of time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_118","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_118","text":"Much appreciated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_119","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_119","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_120","type":"Speech","speaker":"liberalio","key":"Locale_MainScenario:d_main_42_02_120","text":"Human, isn't there one more thing you should share?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"a