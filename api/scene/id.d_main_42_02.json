null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_128","type":"Speech","speaker":"laplace_p","key":"Locale_MainScenario:d_main_42_02_128","text":"Coming straight for us, huh? They must've been itching for a fight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_129","type":"Speech","speaker":"cinderella","key":"Locale_MainScenario:d_main_42_02_129","text":"Something doesn't feel right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_130","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_42_02_130","text":"It's Gluttony.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_131","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:d_main_42_02_131","text":"Ah woo?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_132","type":"Speech","speaker":"mori","key":"Locale_MainScenario:d_main_42_02_132","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":"EventScene_Side_03_02_5","bgArt":"eventscene_side_03_02_5","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_133","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_42_02_133","text":"*Boooom!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_42_02_134","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_42_02_134","text":"The ground splits open, and a colossal mouth erupts forth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_mai