{"id":"event_oldtales1_05_e","cat":"event","group":{"id":"ev40061","label":"OLD TALES · Part 1"},"label":"Traitor: B","stage":null,"prev":"event_oldtales1_05_s","next":"event_oldtales1_06_s","speakers":{"hansel":"Hansel","abe":"Abe","littlemermaid":"Little Mermaid","redshoes":"Red Shoes","oswald_o":"Oswald"},"icons":{"hansel":"si_c980_00_s","abe":"si_c979_00_s","littlemermaid":"si_c513_00_s","redshoes":"si_c982_00_s","oswald_o":"si_c961_00_s"},"lines":[{"id":"event_oldtales1_05_e_1","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_05_e_1","text":"We don't understand what you're saying.","jump":null,"exit":false,"enter":null,"bg":"RuinTechIndoor","bgArt":"ruintechindoor","image":null,"bgm":"event_bgm_oldtales_oswald","movie":null,"shown":["redshoes","oswald_o","abe","littlemermaid","hansel","gretel"],"affinity":null},{"id":"event_oldtales1_05_e_2","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_2","text":"In the Central Government's eyes, you all are being treated the same as Cinderella.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_3","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_3","text":"You're considered traitors who have turned their back on humanity and sided with the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_4","type":"Speech","speaker":"hansel","key":"Locale_MainScenario:event_oldtales1_05_e_4","text":"... We still don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_5","type":"Speech","speaker":"littlemermaid","key":"Locale_MainScenario:event_oldtales1_05_e_5","text":"Argh!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_6","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_6","text":"Oswald...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_7","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_7","text":"Is this true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_8","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_8","text":"You are not considered traitors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_9","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_9","text":"I knew it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_10","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_10","text":"It is true, however, that you're suspected of being traitors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_11","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_11","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_12","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_12","text":"Everyone, get ready. Let's run.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_13","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_13","text":"Why would you announce your plan out loud like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_14","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_14","text":"What are you going to do about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_15","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_15","text":"Do you think you can stop us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_16","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_16","text":"Don't forget that it was I who made these guys. Normal bullets won't put a dent in them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_17","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_17","text":"Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_18","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_18","text":"O-Oswald, there's been some misunderstanding...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_19","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_19","text":"Stay back, Red Shoes."