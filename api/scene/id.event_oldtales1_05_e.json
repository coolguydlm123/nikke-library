:null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_27","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_27","text":"Ahh...! Agh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_28","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_28","text":"What is this?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_29","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_29","text":"An experimental suppression round developed for Cinder... I mean, Anachiro.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_30","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_30","text":"It sends a shock to the nervous system and renders the victim unconscious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_31","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_31","text":"We're still in the developmental stages, so we thought we'd need to make some adjustments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_32","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_32","text":"However, as you can see, they're quite effective already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_33","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_33","text":"All second generation Grimms models have unique exterior shells,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_34","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_34","text":"but that didn't stop these bullets, so we're clearly heading in the right direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_35","type":"Speech","speaker":"abe","key":"Locale_MainScenario:event_oldtales1_05_e_35","text":"You son of a...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_36","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_36","text":"Come with us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_37","type":"Speech","speaker":"oswald_o","key":"Locale_MainScenario:event_oldtales1_05_e_37","text":"If you follow us willingly, we won't have to use any further force.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_38","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_38","text":"Ah... Ugh...! ... O-Oswald. Tell me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_oldtales1_05_e_39","type":"Speech","speaker":"redshoes","key":"Locale_MainScenario:event_oldtales1_05_e_39","text":"What do we need to do to clear our names?","jump":null,"exit":false,"enter":null,"