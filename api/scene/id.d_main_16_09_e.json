ctivating those collars, we can't even send a distress signal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_27","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_e_27","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_28","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_e_28","text":"any evidence to back up these claims of yours?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_09_e_29","text":"Call it intuition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_30","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_09_e_30","text":"You've had nothing but bad things to say about us since this operation began.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_09_e_31","text":"Then you just happen to find this place first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_32","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_09_e_32","text":"You had plenty of time to tamper with the map before calling us over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_33","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_e_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_34","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_e_34","text":"I should kill you for that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_16_09_e_35","text":"Give me your best shot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_36","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_16_09_e_36","text":"...","jump":"d_main_16_09_e_38","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_37","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_16_09_e_37","text":"Let's trust Exotic.","jump":"d_main_16_09_e_52","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_38","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_e_38","text":"Ah, there it is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_39","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_e_39","text":"The oh-so-holy humans once again reveal their prejudice against the outlaws.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_16_09_e_40","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_16_09_e_40","text":"If we belonged to a regular unit like the Scouts,","jump":null,"exit":false,"ent