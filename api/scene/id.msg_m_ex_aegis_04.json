{"id":"msg_m_ex_aegis_04","cat":"messenger","group":{"id":"room_aegis","label":"Aegis · Group"},"label":"4. Emergency!","stage":null,"prev":"msg_m_ex_aegis_03","next":"msg_m_ex_aegis_05","speakers":{"anchor":"Anchor","mast_s":"Mast","helm_s":"Helm"},"icons":{"anchor":"si_c351_00_s","mast_s":"si_c350_01_s","helm_s":"si_c353_00_s"},"lines":[{"id":"m_ex_aegis_04_1","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_1","text":"Emergency!","jump":null},{"id":"m_ex_aegis_04_2","type":"Speech","speaker":"mast_s","key":"Locale_SuddenMessage:m_ex_aegis_04_2","text":"What's wrong?","jump":null},{"id":"m_ex_aegis_04_3","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_3","text":"My Star Starfish","jump":null},{"id":"m_ex_aegis_04_4","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_4","text":"has disappeared!","jump":null},{"id":"m_ex_aegis_04_5","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_5","text":"When did you last see it?","jump":"m_ex_aegis_04_13"},{"id":"m_ex_aegis_04_6","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_6","text":"Star Starfish?","jump":"m_ex_aegis_04_7"},{"id":"m_ex_aegis_04_7","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_7","text":"Ah","jump":null},{"id":"m_ex_aegis_04_8","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_8","text":"It's only the cutest","jump":null},{"id":"m_ex_aegis_04_9","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_9","text":"of all the starfish!","jump":null},{"id":"m_ex_aegis_04_10","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_10","text":"It's got five legs,","jump":null},{"id":"m_ex_aegis_04_11","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_11","text":"with a blue base and orange polka dots.","jump":null},{"id":"m_ex_aegis_04_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_12","text":"When did you last see it?","jump":"m_ex_aegis_04_13"},{"id":"m_ex_aegis_04_13","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_13","text":"In Helm's office, I think?","jump":null},{"id":"m_ex_aegis_04_14","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_14","text":"I went in to report that I was done with my cleaning.","jump":null},{"id":"m_ex_aegis_04_15","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_15","text":"That must have been when it escaped from its box.","jump":null},{"id":"m_ex_aegis_04_16","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_16","text":"Excuse me?","jump":null},{"id":"m_ex_aegis_04_17","type":"Speech","speaker":"mast_s","key":"Locale_SuddenMessage:m_ex_aegis_04_17","text":"Oh my!","jump":null},{"id":"m_ex_aegis_04_18","type":"Speech","speaker":"mast_s","key":"Locale_SuddenMessage:m_ex_aegis_04_18","text":"That means it must be wriggling around Helm's feet right about now.","jump":null},{"id":"m_ex_aegis_04_19","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_19","text":"!!!","jump":null},{"id":"m_ex_aegis_04_20","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_20","text":"Wait a moment.","jump":null},{"id":"m_ex_aegis_04_21","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_21","text":"Let me look.","jump":null},{"id":"m_ex_aegis_04_22","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_22","text":"AGH!","jump":null},{"id":"m_ex_aegis_04_23","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_23","text":"?","jump":null},{"id":"m_ex_aegis_04_24","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_24","text":"Helm doesn't send any further messages for a while.","jump":null},{"id":"m_ex_aegis_04_25","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_25","text":"Someone.","jump":null},{"id":"m_ex_aegis_04_26","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_26","text":"Please.","jump":null},{"id":"m_ex_aegis_04_27","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_27","text":"Come here.","jump":null},{"id":"m_ex_aegis_04_28","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_28","text":"I think I feel something squirming underneath my foot.","jump":null},{"id":"m_ex_aegis_04_29","type":"Speech","speaker":"mast_s","key":"Locale_SuddenMessage:m_ex_aegis_04_29","text":"??","jump":null},{"id":"m_ex_aegis_04_30","type":"Speech","speaker":"mast_s","key":"Locale_SuddenMessage:m_ex_aegis_04_30","text":"Now's not really a good time for me.","jump":null},{"id":"m_ex_aegis_04_31","type":"Speech","speaker":"mast_s","key":"Locale_SuddenMessage:m_ex_aegis_04_31","text":"I'm in the middle of doing a repair on the Admire,","jump":null},{"id":"m_ex_aegis_04_32","type":"Speech","speaker":"mast_s","key":"Locale_SuddenMessage:m_ex_aegis_04_32","text":"and some high-ranking official wants me to explain something to them.","jump":null},{"id":"m_ex_aegis_04_33","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_33","text":"Anchor?","jump":null},{"id":"m_ex_aegis_04_34","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_34","text":"I'm on my way, box in tow.","jump":null},{"id":"m_ex_aegis_04_35","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_35","text":"But I wandered off quite the distance while searching for the starfish.","jump":null},{"id":"m_ex_aegis_04_36","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_36","text":"I'm probably 20 minutes out.","jump":null},{"id":"m_ex_aegis_04_37","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_37","text":"You'll have to keep an eye on the starfish in the meantime","jump":null},{"id":"m_ex_aegis_04_38","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_38","text":"and make sure it doesn't run off anywhere.","jump":null},{"id":"m_ex_aegis_04_39","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_39","text":"Oh, and by the way,","jump":null},{"id":"m_ex_aegis_04_40","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_40","text":"starfish can die if they dry up,","jump":null},{"id":"m_ex_aegis_04_41","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_41","text":"so be sure to spritz it with some water.","jump":null},{"id":"m_ex_aegis_04_42","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_42","text":"What?","jump":null},{"id":"m_ex_aegis_04_43","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_43","text":"You expect me to watch this thing for 20 minutes?","jump":null},{"id":"m_ex_aegis_04_44","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_44","text":"Not only that, but I'm expected to spray it with water, which is bound to make it squirm around even more.","jump":null},{"id":"m_ex_aegis_04_45","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_45","text":"You must be dreaming.","jump":null},{"id":"m_ex_aegis_04_46","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_46","text":"Subordinate.","jump":null},{"id":"m_ex_aegis_04_47","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_47","text":"Can you","jump":null},{"id":"m_ex_aegis_04_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_48","text":"I'd love to help...","jump":null},{"id":"m_ex_aegis_04_49","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_49","text":"come over here?","jump":null},{"id":"m_ex_aegis_04_50","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_50","text":"I just got roped into a meeting.","jump":null},{"id":"m_ex_aegis_04_51","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_51","text":"Oh.","jump":null},{"id":"m_ex_aegis_04_52","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_52","text":"Helm,","jump":null},{"id":"m_ex_aegis_04_53","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_53","text":"if you find being in the company of a starfish that unpleasant,","jump":null},{"id":"m_ex_aegis_04_54","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_54","text":"just try repeating positive thoughts in your mind.","jump":null},{"id":"m_ex_aegis_04_55","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_55","text":"Tell yourself that it's your friend.","jump":null},{"id":"m_ex_aegis_04_56","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_56","text":"No!","jump":null},{"id":"m_ex_aegis_04_57","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_57","text":"I can't!","jump":null},{"id":"m_ex_aegis_04_58","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_58","text":"I'm going to stand on top of my desk chair until you get here,","jump":null},{"id":"m_ex_aegis_04_59","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_59","text":"so hurry up and get this thing out of here.","jump":null},{"id":"m_ex_aegis_04_60","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_60","text":"?!","jump":null},{"id":"m_ex_aegis_04_61","type":"Speech","speaker":"anchor","key":"Locale_SuddenMessage:m_ex_aegis_04_61","text":"Even if I really book it, the fastest I can get there is in 15 minutes.","jump":null},{"id":"m_ex_aegis_04_62","type":"Speech","speaker":"helm_s","key":"Locale_SuddenMessage:m_ex_aegis_04_62","text":"I don't care, just hurry up and get here!","jump":null},{"id":"m_ex_aegis_04_63","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_aegis_04_63","text":"I hope everything gets resolved. Keep me updated.","jump":null}],"chat":true}