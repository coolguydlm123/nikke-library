{"id":"d_main_40_af_04","cat":"main","group":{"id":"ch40","label":"Chapter 40 · Choice"},"label":"P","stage":null,"prev":"d_main_40_af_03","next":"d_main_40_af_05","speakers":{"eh_n":"E.H.","neon":"Neon","viper":"Viper","jackal":"Jackal","mrsmiss":"Mrs. Miss"},"icons":{"eh_n":"si_c113_00_s","neon":"si_c011_00_s","viper":"si_c112_00_s","jackal":"si_c111_00_s","mrsmiss":"si_c9003_00_s"},"lines":[{"id":"d_main_40_af_04_1","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_1","text":"All right. We'll escort you and Neon to the partition.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_story_eh","movie":null,"shown":["neon","eh_n","viper","jackal"],"affinity":null},{"id":"d_main_40_af_04_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_2","text":"Come on guys, I'm not that weak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_3","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_3","text":"With all that commotion we just made, Lion's crew is probably posted all over the Outer Rim by now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_4","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_4","text":"We barged into their turf and made a mess of things. They'll be out for blood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_5","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_40_af_04_5","text":"They're not particularly well-trained, but we can't underestimate their sheer numbers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_6","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_40_af_04_6","text":"We'll be fine, but for civilians like you two, it could get dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_7","text":"Hm... I guess that's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_8","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_8","text":"There's a secret route only a few people know about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_9","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_9","text":"We'll go that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_10","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_40_af_04_10","text":"Oooh, we're taking that route? Hehe! I like that place!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_11","text":"How come? What's so cool about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_12","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_40_af_04_12","text":"It's so dark in there you can barely see, but it also means you'll constantly trip on all sorts of stuff! It's super fun!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_13","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_40_af_04_13","text":"Once a while, you might even stumble over a human body!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_14","text":"Wow! Gotcha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_15","text":"Dang, this place really is dark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_16","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_16","text":"That's because light from the Ark doesn't reach the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_17","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_17","text":"As crazy as it may sound, the parts of the Outer Rim you usually go to are the more developed areas.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_18","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_18","text":"So the Outer Rim used to be more like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_19","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_19","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_20","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_20","text":"We did everything we could to make this place a little more livable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_21","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_21","text":"We really did try just about everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_22","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_23","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_23","text":"Stay behind me. And watch your step.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_af_04_24","text":"The group walks on, relying on E.H.'s small flashlight for vision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_25","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_26","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_40_af_04_26","text":"What's wrong? You scared?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_27","text":"N-no, it's not that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_28","text":"I just feel a little...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_29","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_29","text":"Never mind. It's nothing. I guess I'm just a little tired.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_30","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_40_af_04_30","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_31","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_31","text":"Anyway, I see there are elevators here too?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_32","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_af_04_32","text":"Neon points to several pillar-like silhouettes where elevators are running.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_33","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_33","text":"There are thousands of elevators in and around the Ark, including the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_34","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_34","text":"In the early days when the Ark was being constructed, they built elevators pretty much at random. Most of them aren't even being properly maintained now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_35","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_35","text":"There are plenty of elevators in the Outer Rim, too. People use them to go up to the surface to collect Rapture parts, then trade them for other things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_36","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_36","text":"For a lot of people, they're a precious lifeline. But since they're not maintained, all you can really do is pray they don't break down when you use them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_37","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_37","text":"In the Outer Rim, you're rolling the dice whenever you use those elevators to head up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_38","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_38","text":"So, if the light above an elevator is on, does that mean it's being used?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_39","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_39","text":"Correct. The light comes on whenever it's running.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_40","text":"That light over there is on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_41","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_41","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_42","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_40_af_04_42","text":"... You're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_43","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_40_af_04_43","text":"No one uses this elevator here anymore. I wonder what's going on?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_44","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_40_af_04_44","text":"Unless someone's using it for something really shady, no one ever gives it the time of day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_45","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_45","text":"Let's check it out before leaving.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mrsmiss"],"affinity":null},{"id":"d_main_40_af_04_46","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_04_46","text":"We will be able to leave the Outer Rim, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_47","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_47","text":"Don't worry. We'll get you out of here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_48","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_af_04_48","text":"The group watches the elevator from inside a collapsed tent, a short distance away.","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_49","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_af_04_49","text":"The elevator emits loud, creaking mechanical sounds as it operates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_50","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_04_50","text":"I never thought I'd be involved in a situation like this...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_51","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_51","text":"Not many people get to participate in this kind of thing. You can consider it a life experience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_52","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_04_52","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_53","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_04_53","text":"Haha. You're really naive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_54","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_54","text":"I prefer to think of it as innocence instead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_55","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_40_af_04_55","text":"Oh, it's here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_56","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_56","text":"Everyone be quiet, and stay still.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_af_04_57","text":"The hum of the elevator dies down as it comes to a halt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_af_04_58","text":"*Ding*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liveryn"],"affinity":null},{"id":"d_main_40_af_04_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_40_af_04_59","text":"The elevator door opens and someone steps out.","jump":null,"exit":false,"enter":null,"bg":null