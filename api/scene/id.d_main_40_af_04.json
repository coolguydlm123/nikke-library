:null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_67","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_67","text":"You mean there's a head inside it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_68","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_68","text":"Probably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_69","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_69","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_70","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_70","text":"Everyone, I'm sorry, but I'm going to have to ask you to bring Mrs. Miss to the partition without me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_71","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_40_af_04_71","text":"I'm going after Liveryn.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_72","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_40_af_04_72","text":"I'm coming too. I want to know what she's doing taking that elevator to such a remote part of the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_40_af_04_73","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:d_main_40_af_04_73","text":"Wait! What about me?","jump":null,"ex