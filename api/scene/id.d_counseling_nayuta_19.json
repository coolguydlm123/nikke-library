{"id":"d_counseling_nayuta_19","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 19","stage":null,"prev":"d_counseling_nayuta_18","next":"d_counseling_nayuta_20","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_19_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_19_1","text":"Pray tell, how dost thou while away thy leisure hours?","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_19_2","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_19_2","text":"Spend time with my friends.","jump":"d_counseling_nayuta_19_4","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_19_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_19_3","text":"Just laze around.","jump":"d_counseling_nayuta_19_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_19_4","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_19_4","text":"Verily, e'en in thy hours of respite, thou dost employ them in fortifying the bonds 'twixt thee and thy companions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_19_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_19_5","text":"Truly, an act most befitting a great hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_19_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_19_6","text":"'Tis no marvel that many do follow thee.","jump":"d_counseling_nayuta_19_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_19_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_19_7","text":"'Tis curious that thou allow time to pass so idly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_19_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_19_8","text":"I had thought, perchance, that thou mightst employ it toward a more worthy purpose.","jump":"d_counseling_nayuta_19_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_19_9","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_19_9","text":"I spend time chit-chatting with Nayuta.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}