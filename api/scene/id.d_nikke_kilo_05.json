s filed complaints.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_05_77","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_05_77","text":"Isn't Missilis loaded? Why don't they foot the bill?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_05_78","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_05_78","text":"They offered, but the other squads still declined.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_05_79","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_05_79","text":"They say they have to lug around too much mechanical equipment and supplies, three times more than usual according to their estimates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_05_80","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_05_80","text":"If we were 3 times more effective than an ordinary Nikke, then it wouldn't be a problem, but since that's not the case...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_05_81","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_05_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_05_82","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_05_82","text":"Before piloting T.A.L.O.S.,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":