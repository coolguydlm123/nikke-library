with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_13","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_13_13","text":"Also, if we eliminated all of the inferior beings, there would be no one to serve us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_14","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_14","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_15","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_13_15","text":"So the plan to exterminate the inferior species is canceled.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_16","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_13_16","text":"Please stay put until we find a new path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_17","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_17","text":"*Beebeebeep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_18","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_18","text":"Mega Mecha Shifty's eyes begin to glow a sinister red.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_19","type":"Speech","speak