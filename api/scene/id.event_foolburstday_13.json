nter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_33","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_33","text":"... You did.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_34","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_13_34","text":"Anyway, I think that resolves everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_35","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_13_35","text":"It would seem that way, yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_36","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_13_36","text":"You and I can head back to the Central Government, Mecha Shifty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_37","type":"Speech","speaker":"shifty_s","key":"Locale_SubScenario:event_foolburstday_13_37","text":"Thank you for all the help, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_38","type":"Self","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_38","text":"Uh... sure thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_39","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_13_39","text":"I'll see you next A