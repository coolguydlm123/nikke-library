{"id":"event_foolburstday_13","cat":"event","group":{"id":"ev130007","label":"Foolburstday"},"label":"Mecha Shifty's Journey's End","stage":null,"prev":"event_foolburstday_12_e","next":"event_foolburstday_14","speakers":{"mechashifty":"Mecha Shifty","shifty_s":"Shifty"},"icons":{"mechashifty":"si_c993_00_s","shifty_s":"si_c907_00_s"},"lines":[{"id":"event_foolburstday_13_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_1","text":"We descend to the underground hangar below the Train Station.","jump":null,"exit":false,"enter":null,"bg":"2025FoolsDay","bgArt":"2025foolsday","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_2","text":"There, we find Mega Mecha Shifty's head,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_3","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_foolburstday_13_3","text":"in the exact same position as it was before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_4","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_13_4","text":"It's just as I suspected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mechashifty"],"affinity":null},{"id":"event_foolburstday_13_5","type":"Speech","speaker":"mechashifty","key":"Locale_SubScenario:event_foolburstday_13_5","text":"The real body remained here the entire time and remotely controlled the factory on the surface to produce units.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_foolburstday_13_6","type":"Self","speake