{"id":"d_counseling_hongryeon_blackshadow_20","cat":"counsel","group":{"id":"char5105","label":"Scarlet: Black Shadow"},"label":"Advising Scarlet: Black Shadow: 20","stage":null,"prev":"d_counseling_hongryeon_blackshadow_19","next":null,"speakers":{"hongryeon_o":"Scarlet"},"icons":{"hongryeon_o":"si_c225_00_s"},"lines":[{"id":"d_counseling_hongryeon_blackshadow_20_1","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_1","text":"Scarlet closes her eyes and recalls the past, which has become a blur.","jump":null,"exit":false,"enter":null,"bg":"black","bgArt":"black","image":null,"bgm":"event_bgm_redash_alldownhill","movie":null,"shown":["hongryeon"],"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_2","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_2","text":"If thou were to cast off this mortal coil tomorrow's eve,","jump":null,"exit":false,"enter":null,"bg":"BattleShipBridge","bgArt":"battleshipbridge","image":null,"bgm":null,"movie":null,"shown":["hongryeon_o"],"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_3","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_3","text":"what would thou do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_4","text":"I would spend time with the people that are precious to me.","jump":"d_counseling_hongryeon_blackshadow_20_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_hongryeon_blackshadow_20_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_5","text":"I would spend some quiet time alone.","jump":"d_counseling_hongryeon_blackshadow_20_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_hongryeon_blackshadow_20_6","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_6","text":"Verily, nothing holds a greater meaning than this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_7","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_7","text":"Aye, that thought did grace my mind as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_8","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_8","text":"I would spend my time telling them all the things I have kept inside me for so long.","jump":"d_counseling_hongryeon_blackshadow_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_9","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_9","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_10","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_10","text":"To be lone in one's final moments... would that not be a most forlorn demise?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_11","type":"Speech","speaker":"hongryeon_o","key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_11","text":"Were it me, I'd revel in the company of those dear to me.","jump":"d_counseling_hongryeon_blackshadow_20_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_hongryeon_blackshadow_20_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_hongryeon_blackshadow_20_12","text":"Scarlet seems to be preoccupied with mortality.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}