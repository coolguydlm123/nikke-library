{"id":"d_counseling_snowcrane_01","cat":"counsel","group":{"id":"char5168","label":"Snow Crane"},"label":"Advising Snow Crane: 01","stage":null,"prev":null,"next":"d_counseling_snowcrane_02","speakers":{"snowcrane":"Snow Crane"},"icons":{"snowcrane":"si_c620_00_s"},"lines":[{"id":"d_counseling_snowcrane_01_1","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_1","text":"It's good to be kind.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["snowcrane"],"affinity":"_0"},{"id":"d_counseling_snowcrane_01_2","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_2","text":"People like that make the world better, little by little.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_01_3","text":"I think kind people deserve more respect.","jump":"d_counseling_snowcrane_01_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_snowcrane_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_01_4","text":"If you're too nice these days, people would take you for a pushover.","jump":"d_counseling_snowcrane_01_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_snowcrane_01_5","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_5","text":"You're absolutely right!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_6","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_6","text":"Hehe, how do you always say such lovely things?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_7","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_7","text":"That's right, kind people deserve to be treated with more respect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_8","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_8","text":"So I hope you'll be treated that way too.","jump":"d_counseling_snowcrane_01_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_9","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_9","text":"A pushover?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_10","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_10","text":"Oh my, that's not a very nice thing to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_11","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_11","text":"Kind people deserve a little more respect. They're precious because they make the world a better place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_12","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_01_12","text":"So don't let words like that sway you, all right? You mustn't give up on being kind.","jump":"d_counseling_snowcrane_01_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_01_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_01_13","text":"I talk with Snow Crane about how to appreciate and love kind people.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}