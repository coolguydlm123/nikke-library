peech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermission_01_18","text":"Everything went fine. No issues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["puppies"],"affinity":null},{"id":"event_secretgarden_intermission_01_19","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermission_01_19","text":"Nero did scurry off every time she saw the watering robot, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_20","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermission_01_20","text":"And she kept pestering the butterflies.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_21","type":"Speech","speaker":"nero","key":"Locale_SubScenario:event_secretgarden_intermission_01_21","text":"Sorry, I can't help it. Instinct.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_22","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermission_01_22","text":"The dogs kept digging holes in the dirt as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_23","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermission_01_23","text":"They also kept trying to pee on the flowers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_24","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_intermission_01_24","text":"Oh my gosh! How could those guys get up to so much trouble when I wasn't here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_25","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermission_01_25","text":"It's all right. Max was here, so it all worked out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_26","type":"Speech","speaker":"max","key":"Locale_SubScenario:event_secretgarden_intermission_01_26","text":"*Ruff ruff*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_27","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_intermission_01_27","text":"Sounds like it was an eventful time over here as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_28","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_intermission_01_28","text":"Thanks for doing me a solid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_29","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermission_01_29","text":"Don't mention it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_intermission_01_30","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_secretgarden_intermis