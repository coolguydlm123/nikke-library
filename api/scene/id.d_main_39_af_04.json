{"id":"d_main_39_af_04","cat":"main","group":{"id":"ch39","label":"Chapter 39 · Gene"},"label":"Suspicious Movement","stage":null,"prev":"d_main_39_af_03","next":"d_main_39_af_05","speakers":{"viper":"Viper","neon":"Neon","jackal":"Jackal","eh_n":"E.H."},"icons":{"viper":"si_c112_00_s","neon":"si_c011_00_s","jackal":"si_c111_00_s","eh_n":"si_c113_00_s"},"lines":[{"id":"d_main_39_af_04_1","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_1","text":"We're nearly there. It's right up ahead.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_manifest_a","movie":null,"shown":["neon","eh_n","viper","jackal"],"affinity":null},{"id":"d_main_39_af_04_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_2","text":"Wow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_3","text":"Even from a distance, it practically screams, \"Come here to get your kicks!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_4","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_4","text":"Hehe. ♡ Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_5","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_5","text":"But it's more of a warning than just showing off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_6","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_6","text":"From here on, this is Ephialtes territory, so don't mess around. ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_7","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_7","text":"This place is probably propped up thanks to the backing of shady organizations, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_8","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_8","text":"You bet! It's not as huge as Hedonia or Seimeikai, but definitely no small-time joint either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_9","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_9","text":"All right, let's go in!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_10","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_10","text":"It's been ages since I've been here. ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_11","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_39_af_04_11","text":"Ugh... I hate this place. It's so noisy and flashy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_12","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_12","text":"Doesn't matter. A job's a job.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_13","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_39_af_04_13","text":"... Fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_14","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_39_af_04_14","text":"But if anyone messes with me like last time, I'm gonna take a bite outta them!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_15","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_15","text":"Yeah, yeah. Just try not to kill anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_16","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_16","text":"Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_17","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_18","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_18","text":"If I don't talk to you now, I don't think I'll get another chance. Do you have a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_19","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_19","text":"Oh, is it a secret?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_20","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_20","text":"You could say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_21","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_21","text":"Whoa, how did you know I was a spy?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_22","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_22","text":"What's this? You two planning to share some juicy little secret?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_23","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_23","text":"E.H. shoots Viper a long, intense stare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_24","text":"Viper seems to catch on and gives a small nod.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_25","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_25","text":"This way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_26","text":"E.H. and Neon move to the side.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_27","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_27","text":"Just a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_28","text":"*Beeeeep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_29","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_29","text":"Agh, what's that noise?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_30","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_30","text":"It's an electronic jammer, so no one can eavesdrop on us. They'll catch on eventually, but we're good for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_31","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_31","text":"All right, we should make this quick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_32","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_32","text":"So, what's this exciting secret that's gonna make me feel like a superspy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_33","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_33","text":"Do you know anything about the Third Surface Reclamation War?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_34","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_35","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_35","text":"Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_36","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_36","text":"I asked if you knew anything about the Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_37","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_37","text":"This is the first I've ever heard of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_38","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_38","text":"... Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_39","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_39","text":"All right, that's all I wanted to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_40","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_40","text":"Hey, wait! You can't drop a bombshell like that and peace out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_41","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_41","text":"If you have no information, then we have nothing further to discuss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_42","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_42","text":"I could pass the information along to Master.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_43","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_43","text":"This sounds pretty darn important, so I want to hear it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_44","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_45","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_45","text":"Yeah. It wouldn't hurt if the rest of your squad heard this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_46","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_46","text":"If your Commander happens to know anything else, can you promise you'll share it with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_47","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_47","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_48","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_48","text":"... We've received intel that the Central Government is gearing up for a Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_49","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_49","text":"I thought it was a load of nonsense at first, but recent movements have been anything but normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_50","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_50","text":"Production at military factories has surged, tens of times higher than usual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_51","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_51","text":"They say it's only at facilities directly controlled by the Central Government, but still, it's definitely worrying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_52","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_52","text":"Maybe they're replenishing their inventory?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_53","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_53","text":"I thought it might just be about securing more quantity at first, too. But the equipment they're producing isn't the usual stuff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_54","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_54","text":"The tech level is leaps and bounds ahead, several generations beyond anything they've made before.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_55","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_55","text":"I don't know exactly what's going on, but either there's been some breakthrough,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_56","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_56","text":"or they've gotten their hands on tech from somewhere else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_57","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_57","text":"Maybe they've discovered some new tech and are rushing it into production.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_58","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_58","text":"Things are running fine as is. There's no real reason to start pumping out better weapons or gear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_59","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_59","text":"Besides...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_60","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_60","text":"The Ark has more firepower and tech now than it's ever had since it was founded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_61","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_61","text":"They've already reclaimed part of the surface, now called Reclamation Site 01. They've got plenty of powerful Nikkes too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_62","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_62","text":"Optical camouflage is in their hands now, and then there's the Commando Unit that's something else entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_63","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_63","text":"Ahem!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_64","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_64","text":"Plus, they have unknown materials like E2 Crystals and Dark Matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_65","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_65","text":"Now would be the perfect time to launch a reclamation war.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_66","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_66","text":"And if that were the case, I figured that a Commando Unit like the Counters might know something about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_67","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_67","text":"I haven't heard anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_68","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_68","text":"... All right. Make sure your Commander gets this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_69","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_69","text":"We need to know where things are headed so the Outer Rim can respond accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_70","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_70","text":"Okay. I'll let him know, and if I hear anything, I'll tell you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_71","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_71","text":"How do you know all of this, by the way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_72","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_72","text":"I have informants here and there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_73","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_73","text":"Old connections.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_74","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_74","text":"Terrorists, you mean? I should report you right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_75","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_75","text":"No, not from Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_76","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_76","text":"Just... old connections, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_77","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_77","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_78","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_39_af_04_78","text":"Let's go. We'll have other chances to talk later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_79","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_79","text":"Ephialtes is this way.","jump":null,"exit":false,"enter":null,"bg":"Backstreet_n","bgArt":"backstreet_n","image":null,"bgm":null,"movie":null,"shown":["viper","jackal"],"affinity":null},{"id":"d_main_39_af_04_80","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_80","text":"There's a whole bevy of red-light districts in the Outer Rim, but most of them are exceedingly dangerous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_81","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_81","text":"They're buried so deep in the shadows that no word of whatever happens there ever reaches the outside world. ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_82","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_82","text":"But this place is relatively safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_83","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_83","text":"Don't think that that dilutes the fun, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_84","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_84","text":"It's literally a place where you can find every kind of pleasure you can possibly imagine. If they don't have what you want, they'll make it just for you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_85","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_85","text":"What they consider depraved in the Ark is kiddy stuff here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_86","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_86","text":"So, unless you plan on never leaving, I'd suggest you don't get too involved while you're here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_87","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_87","text":"I wasn't planning on it. I'm as wholesome as apple pie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_88","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_88","text":"The reason a place like this can exist out in the open is that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_89","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_89","text":"it's managed exclusively by a major organization called Lion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_90","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_90","text":"And, surprise, surprise, the head of Lion has tons of connections in the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_91","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_91","text":"If things went sideways here, it'd be bad for everyone, so they keep things under control any way they can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_92","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_92","text":"In that sense, you could consider this the safest place in the entire Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_93","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_39_af_04_93","text":"That is, if you've got the cash to back it up. ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_94","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_94","text":"Man, it's so flashy. Like, it's literally glittering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_95","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_95","text":"Neon looks around with her eyes aglow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_96","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_96","text":"Everywhere she looks, the streets are filled with lights and neon signs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_97","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_97","text":"Nikkes and humans alike walk through the illuminated streets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_98","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_39_af_04_98","text":"Passersby laugh, cry, and shout as they stroll along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_39_af_04_99","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_39_af_04_99","text":"...","jump":null,"exit":false,"