{"id":"d_counseling_arcana_06","cat":"counsel","group":{"id":"char5140","label":"Arcana"},"label":"Advising Arcana: 06","stage":null,"prev":"d_counseling_arcana_05","next":"d_counseling_arcana_07","speakers":{"arcana":"Arcana"},"icons":{"arcana":"si_c581_00_s"},"lines":[{"id":"d_counseling_arcana_06_1","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_06_1","text":"*Yawn*","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["arcana"],"affinity":"_0"},{"id":"d_counseling_arcana_06_2","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_06_2","text":"Phew, sorry. I promise it's not boring talking to you, but—*yawn*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_06_3","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_06_3","text":"If you're sleepy, would you like to take a nap?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_06_4","type":"Speech","speaker":"arcana","key":"Locale_Counseling:d_counseling_arcana_06_4","text":"Together?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_arcana_06_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_06_5","text":"Yeah. I'm kinda sleepy too.","jump":"d_counseling_arcana_06_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_arcana_06_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_arcana_06_6","text":"That's not what I meant.","jump":"d_counseling_arcana_06_10","exit":false,"enter":null,"bg":null,"bgAr