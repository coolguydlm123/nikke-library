{"id":"d_nikke_liter_02","cat":"bond","group":{"id":"char5011","label":"Liter"},"label":"The Main Culprit","stage":null,"prev":"d_nikke_liter_01","next":"d_nikke_liter_03","speakers":{"liter":"Liter","neon":"Neon","anis":"Anis","Narration":"Narration","rapi":"Rapi","Monologue":"Monologue","Self":"Commander"},"icons":{"liter":"si_c082_00_s","neon":"si_c011_00_s","anis":"si_c012_00_s","Narration":"si_c999_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_nikke_liter_02_1","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_1","text":"Clean the walls and ceiling.\nNeedless to say, you'll have to clean the floors, too.","jump":null,"exit":false,"enter":null,"bg":"ShowerRoom","bgArt":"showerroom","image":null,"bgm":"bgm_story_languor","movie":null,"shown":["liter","anis","rapi","neon"],"affinity":null},{"id":"d_nikke_liter_02_2","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_02_2","text":"I'm too short to clean the ceiling!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_3","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_3","text":"Me, too!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_4","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_4","text":"Seriously? Wait a minute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_5","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_liter_02_5","text":"*Clank, clank*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_6","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_6","text":"Here you go. Now you can clean the ceiling.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_7","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_02_7","text":"Whoa! You made a whole ladder so fast! Amazing!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_8","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_8","text":"Haha. There's nothing Mighty Tools can't do!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_9","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_10","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_10","text":"OK. This time, you should clean up here.","jump":null,"exit":false,"enter":null,"bg":"OutpostOut","bgArt":"outpostout","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_11","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_11","text":"... Do we have to clean up all of this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["anis","neon"],"affinity":null},{"id":"d_nikke_liter_02_12","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_02_12","text":"This place is so big.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_nikke_liter_02_13","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_13","text":"Take a look around you. The materials and tools are everywhere. It's all a mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liter"],"affinity":null},{"id":"d_nikke_liter_02_14","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_14","text":"It's not safe to keep them like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_15","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_15","text":"They might be stolen, or corroded by rainwater.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_16","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_16","text":"There is no rain here. No thieves, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_17","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_17","text":"Look at that steel barrel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_18","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_18","text":"What do you think is in it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_19","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_19","text":"I don't know. It could be anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_20","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_20","text":"Actually, its liquid fuel that can be ignited by a single spark!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_21","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_22","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_22","text":"Though not very often, we still fight against the Raptures here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_23","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_23","text":"We've been lucky lately. But what if that barrel gets hit by a stray bullet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_24","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_24","text":"I know you guys would survive. The worst you'll get is probably burnt hair or clothes. But Greenhorn might not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_25","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_25","text":"Do you really wanna risk it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_26","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_26","text":"... Fine. I'll organize all of this stuff, just like you want it, OK?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_27","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_02_27","text":"But the machines and tools here are too heavy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_28","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_02_28","text":"We might need larger equipment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_29","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_29","text":"Seriously? Wait a minute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_30","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_liter_02_30","text":"*Clank, clank*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_31","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_31","text":"Hmph, not bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_32","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_liter_02_32","text":"A forklift appears beside Liter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_33","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_02_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_34","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_35","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_02_35","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_36","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_36","text":"I'll operate the forklift. You guys just lend me a hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_37","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_37","text":"Since you can make a forklift so easily, why not just make a cleaning robot?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_38","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_38","text":"Those kinds of things are patented. I can't just go around making robots whenever I want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_39","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_39","text":"Can't you just make and use it secretly here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_40","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_40","text":"No way, Anis. Where are your morals?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_41","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_41","text":"This is so annoying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_42","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_liter_02_42","text":"In the Armory.","jump":null,"exit":false,"enter":null,"bg":"Armory","bgArt":"armory","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_43","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_43","text":"Geez, take a look at the grease!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liter","anis","rapi","neon"],"affinity":null},{"id":"d_nikke_liter_02_44","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_44","text":"If we leave it like this, the grease will dry out and the weapons will be unusable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_45","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_45","text":"Wipe the weapons clean!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_46","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_02_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_47","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_liter_02_47","text":"In the Canteen.","jump":null,"exit":false,"enter":null,"bg":"FastFood","bgArt":"fastfood","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_48","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_48","text":"Hmm...! This is worse than I imagined...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["liter","anis","rapi","neon"],"affinity":null},{"id":"d_nikke_liter_02_49","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_49","text":"Rotting food is the worst! Clean up the canteen immediately!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_50","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_50","text":"This is a place for eating! It needs to be sanitary! How could this happen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_51","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_51","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_52","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_52","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_53","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_02_53","text":"Who put the green waste oil in the pot?\nAre you trying to ruin the pot?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_02_54","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_02_54","text":"... That's cream soup. Emma made it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null