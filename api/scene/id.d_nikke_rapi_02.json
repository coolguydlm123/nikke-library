{"id":"d_nikke_rapi_02","cat":"bond","group":{"id":"char3001","label":"Rapi"},"label":"Heroes of the Ark","stage":null,"prev":"d_nikke_rapi_01","next":"d_nikke_rapi_03","speakers":{"rapi":"Rapi","Self":"Commander","Monologue":"Monologue","sadcommander":"Aggrieved commander","staff":"Clerk"},"icons":{"rapi":"si_c010_00_s","sadcommander":"si_c999_00_s","staff":"si_c912_00_s"},"lines":[{"id":"d_nikke_rapi_02_1","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_1","text":"The Central Government's office is right up ahead.","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":"bgm_story_orangepop","movie":null,"shown":["rapi"],"affinity":null},{"id":"d_nikke_rapi_02_2","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_2","text":"That's where you can submit the completed forms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_3","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_3","text":"You're not coming?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_4","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_4","text":"A Nikke cannot enter the Central Government Offices except under very special circumstances.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_5","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_5","text":"Why is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_6","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_7","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_7","text":"Because there is a high chance we will see a negative side of the Commander inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_8","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_8","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_9","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_9","text":"I will wait. Go in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_10","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_10","text":"I open the door and head inside.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_11","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_11","text":"It is quite noisy inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_12","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_12","text":"The majority of the sound comes from people who are shouting. They are dressed in the same military uniform as I am.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_13","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_13","text":"The people sitting behind the counters are all either quiet, or smiling awkwardly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_14","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_14","text":"I decide to get in line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_15","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_15","text":"I can hear a Commander talking to the staff in front of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_16","type":"Speech","speaker":"sadcommander","key":"Locale_NikkeEpisode:d_nikke_rapi_02_16","text":"Hey, what is this? This amount doesn't make sense!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_17","type":"Speech","speaker":"sadcommander","key":"Locale_NikkeEpisode:d_nikke_rapi_02_17","text":"I just came back from the surface! Do you realize how many close calls I had up there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_18","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_18","text":"The salary you have been given is accurate.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_19","type":"Speech","speaker":"sadcommander","key":"Locale_NikkeEpisode:d_nikke_rapi_02_19","text":"This is insane! I risk my neck and all I get is chump change!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_20","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_20","text":"This is the designated payment for all basic transport operations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_21","type":"Speech","speaker":"sadcommander","key":"Locale_NikkeEpisode:d_nikke_rapi_02_21","text":"Basic transport my foot! I lost two Nikkes, and I...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_22","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_22","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_23","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_23","text":"Whether an incident does or does not occur during an operation is entirely dependent on your own capabilities as a Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_24","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_24","text":"Please understand that there is nothing more we can do for you in this situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_25","type":"Speech","speaker":"sadcommander","key":"Locale_NikkeEpisode:d_nikke_rapi_02_25","text":"That's easy for you to say, sitting there safe and sound behind your nice desk! You've never even been up to the surface! I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_26","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_26","text":"Next. What can I help you with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_27","type":"Speech","speaker":"sadcommander","key":"Locale_NikkeEpisode:d_nikke_rapi_02_27","text":"Hey! Are you ignoring me?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_28","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_28","text":"Do I have to call security?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_29","type":"Speech","speaker":"sadcommander","key":"Locale_NikkeEpisode:d_nikke_rapi_02_29","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_30","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_30","text":"Next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_31","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_31","text":"The Commander in front leaves the building in a huff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_32","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_32","text":"I sit in the empty seat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_33","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_33","text":"What can I help you with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_34","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_34","text":"I came to submit my operation reports.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_35","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_35","text":"Very well. Hand them to me, please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_36","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_36","text":"I hand over the reports to the employee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_37","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_37","text":"The employee's gaze shifts back and forth between the monitor and the forms as they type away on the keyboard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_38","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_38","text":"Suddenly the employee freezes, then gives a cordial smile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_39","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_39","text":"Nice to meet you, Commander {AccountData.NickName}. It's an honor to finally meet the person behind all the rumors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_40","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_40","text":"The veracity of your op reports has been confirmed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_41","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_41","text":"Would you like your salary deposited directly to your bankbook, or would you like a voucher?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_42","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_42","text":"What is the difference?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_43","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_43","text":"It helps determine the availability of certain transactional options.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_44","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_44","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_45","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_45","text":"I can see that you're not familiar with this process, so I've deposited the funds directly into your bankbook.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_46","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_46","text":"The deposit has been completed. Could you please confirm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_47","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_48","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_48","text":"There is a new entry in the bankbook, and the amount...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_49","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_49","text":"But that's...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_50","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_50","text":"Yes. In light of the difficult nature of the operations, the amount has been raised accordingly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_51","type":"Speech","speaker":"staff","key":"Locale_NikkeEpisode:d_nikke_rapi_02_51","text":"Please continue your efforts on behalf of humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_52","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_52","text":"I exit the office.","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":"bgm_menu_ark","movie":null,"shown":["rapi"],"affinity":null},{"id":"d_nikke_rapi_02_53","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_53","text":"As I walk out, I notice the other Commanders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_54","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_rapi_02_54","text":"Many of them are crouched down in front of the office building, or staring at the wall sighing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_55","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_55","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_56","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_56","text":"Is it all taken care of?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_57","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_57","text":"Yes. It's done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_58","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_58","text":"Then let's go purchase the necessities we require.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_59","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_59","text":"Rapi.","jump":null,"exit":false,"enter":null,"bg":"ShoppingMall","bgArt":"shoppingmall","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_60","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_60","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_61","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_61","text":"Do Commanders... have it hard?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_62","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_63","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_63","text":"Yes, they do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_64","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_64","text":"Most of us are led to believe that Commanders are elite figures who have undergone a proper education in the military academy, and that they are heroes who work with Nikkes to recapture the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_65","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_65","text":"However, that couldn't be further from the truth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_66","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_66","text":"Their so-called 'proper education' doesn't even last a year.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_67","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_67","text":"It's not nearly enough time to learn all there is to know about the Ark, Nikkes, and Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_68","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_68","text":"Instead, during their time at the military academy, Commanders are essentially brainwashed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_69","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_69","text":"They're told they are the ones who will save humanity, and Nikkes are merely tools meant to serve Commanders and mankind itself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_70","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_70","text":"This is the narrative they drill into their minds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_71","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_71","text":"I'm sure you yourself have noticed it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_72","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_72","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_73","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_73","text":"As a result, the mortality rate amongst Commanders is staggering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_74","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_74","text":"They are thrown into operations without proper preparation. This, along with their lack of empathy for the Nikkes under their command, often leads to disaster.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_75","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_75","text":"And, most crucially...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_76","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_76","text":"Commanders do not receive pay if they fail to complete an operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_77","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_77","text":"There is no concept of hourly, weekly, monthly, or annual salaries. You are paid upon successful completion of an operation, or not at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_78","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_78","text":"The salary also depends on the difficulty of the operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_79","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_79","text":"You risk your life going up to the surface, where you carry out operations, and get paid based on your performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_80","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_80","text":"In a way...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_81","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_81","text":"It's just like being a mercenary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_82","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_82","text":"And that's where we start seeing some internal conflict.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_83","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_83","text":"Those who go through the military academy are led to believe they are above the rest of society.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_84","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_84","text":"They are full of confidence, and have no doubt that they are truly the ones who will save humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_85","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_85","text":"But soon after, they are faced with reality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_86","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_86","text":"Once they realize they've been risking their lives for pennies, they take out their frustrations on the staff.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_87","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_87","text":"It's a rude awakening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_88","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_88","text":"Some Commanders find themselves unable to cope, and resort to extreme measures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_89","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_90","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_90","text":"However, very few people in the Ark even know about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_91","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_91","text":"That's because the Ark continues to venerate the Commanders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_92","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_92","text":"As a result, the competition for entry into the military academy remains fierce.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_93","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_93","text":"What is an operation report voucher?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_94","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_94","text":"It's one method of receiving payment after successfully completing an operation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_95","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_95","text":"You can carry it around and exchange it for cash when needed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_96","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_96","text":"Why would I need something like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_97","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_97","text":"Commanders are members of the elite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_98","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_98","text":"Many unscrupulous people set their sights on Commanders who are fresh graduates from the military academy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_99","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_99","text":"They are extremely susceptible to being hacked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_100","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_100","text":"Currency within the Ark is also digitized, and it's not too difficult to hack the system.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_101","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_101","text":"Therefore, vouchers are a way of making sure that you don't lose a lot of money at once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_102","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_102","text":"... But vouchers don't sound very secure, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_103","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_103","text":"Well, there are some minimal safety procedures to prevent anyone other than a Commander from cashing them in...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_104","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_104","text":"But overall, they are indeed not entirely safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_105","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_105","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_106","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_106","text":"However, operation report vouchers do have one other special use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_107","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_107","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_108","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_108","text":"Commanders can exchange vouchers to receive their salary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_109","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_109","text":"However, the vouchers are not Commander-specific. Any Commander can use any voucher.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_110","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_110","text":"So, what you're saying is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_111","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_111","text":"Yes. They can be used to transfer funds to other Commanders who are having a hard time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_112","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_112","text":"Do you find this all strange?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_113","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_rapi_02_113","text":"Well, it's certainly not normal...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_114","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_114","text":"There is no other way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_115","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_115","text":"Commanders must be the heroes of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_116","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_116","text":"The Central Government can't have their heroes begging on the streets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_117","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_117","text":"There is a saying among the Commanders...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_118","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_118","text":"\"A hero only begs from other heroes.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_119","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_119","text":"The reality of the situation must not be exposed to the outside world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_120","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_120","text":"This way, the people will continue to idolize their \"heroes.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rapi_02_121","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_rapi_02_121","text":"They'll even dream of becoming one themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}