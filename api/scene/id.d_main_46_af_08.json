me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_66","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_66","text":"The Queen has descended.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_67","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_67","text":"The Raptures are no longer infinite.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_68","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_68","text":"With Eden's new technology, our equipment production output is sufficient.","jump":null,"exit":false,"enter":null,"bg":"Eden","bgArt":"eden","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_69","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_69","text":"The Ark's strength is at its peak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_70","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_70","text":"And our comrades on the surface will be a great asset to us.","jump":null,"exit":false,"enter":null,"bg":"BriefingRoom","bgArt":"briefingroom","image":null,"bgm":null,"movie":null,"shown":["andersen","burningum","syuen","ingrid","mustang"],"affinity":null},{"id":"d_main_46_af_08_71","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_71","text":"The time for the Third Surface Reclamation War is now. If we don't do this now, it will be impossible later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_72","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_72","text":"... I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_73","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_73","text":"... We haven't even put this to a vote yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_74","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_74","text":"I'm fully in agreement!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_75","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_75","text":"We're talking about surface reclamation. Doesn't just the thought of it make your heart race?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_76","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_76","text":"This is the moment Elysion has been walking the tactical path toward!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_77","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_77","text":"Onward AZX! Onward Admire!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_78","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_78","text":"Onward Wings of Victor—!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_79","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_79","text":"Pipe down, Miss Tactical.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_80","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_80","text":"Whew... my apologies. I got a bit carried away there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_81","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_82","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_82","text":"Will this be another large-scale surface deployment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_83","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_83","text":"That remains to be seen, but it's unlikely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_84","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_84","text":"In many ways, this may well be our last opportunity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_85","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_85","text":"Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_86","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_86","text":"... Fine. I'll run a check on that function then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_87","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_87","text":"It's been maintained pretty consistently, so there shouldn't be a problem.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_88","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_88","text":"Much appreciated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_89","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_89","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_90","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_90","text":"What, you didn't know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_91","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_91","text":"The Ark can rise to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_92","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_92","text":"What?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_93","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_93","text":"It is not called the Ark for nothing. It can float. That's what it was designed and built for.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_94","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_94","text":"Th-the Ark can rise to the surface?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_95","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_95","text":"Yes, how many times do I have to say it? It rises. It can go up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_96","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_96","text":"I can't believe it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_97","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_97","text":"Enikk, if you would.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_98","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_08_98","text":"Yes. I will review the feasibility, timing, and probability of success for the Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_r"],"affinity":null},{"id":"d_main_46_af_08_99","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_99","text":"How long will it take?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_100","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_08_100","text":"The report will be ready within one month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_101","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_101","text":"Good. I'll leave it to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_102","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_102","text":"Ah, right. We need the two other Deputy Chiefs to agree on this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_103","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_103","text":"A matter of this magnitude requires a unanimous decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_104","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_08_104","text":"Th-there's no need to worry. The c-commander in chief is still in the same state...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_105","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_08_105","text":"Th-the remaining two have delegated full au-authority to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_106","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_106","text":"... I see they still have no interest in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_107","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_107","text":"I'd like each of you to begin your research and preparations with the Third Surface Reclamation War's execution in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_108","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_108","text":"Un moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_109","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_109","text":"What is it, Mustang?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_110","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_110","text":"You're announcing the Third Surface Reclamation War maintenant?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_111","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_111","text":"Oh non, certainement not! Public morale is at its absolute lowest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_112","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_112","text":"To déclarer war in the middle of this would be catastrophic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_113","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_113","text":"I would not be surprised if une révolte occurs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_114","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_114","text":"But we have no proper alternative. Our only choice is to push forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_115","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_115","text":"C'est moi, I have the idéale solution!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_116","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_116","text":"We hold un grand concert to célébrer the Third Surface Reclamation War!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_117","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_117","text":"Strip away the solemnité and march toward a better tomorrow pour all of humanité!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_118","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_118","text":"Et voilà! That's how we présent le festival.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_119","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_119","text":"... Huh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_120","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_120","text":"Moi excels at this. The crème de la crème, in fact.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_121","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_121","text":"Mais. It will costs beaucoup de money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_122","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_122","text":"This won't end with just one concert, non! We open concert after concert, encore et encore!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_123","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_123","text":"We will captiver the souls of every Ark citizen, absolument!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_124","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_124","text":"Entertainment, c'est what makes people forget their pain and anxiety!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_125","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_125","text":"... Very well. You'll have the Central Government's backing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_126","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_126","text":"I'll leave that part in your hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_127","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_127","text":"C'est bon!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_128","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_128","text":"Therefore, Commandant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_129","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_129","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_130","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_130","text":"T.T. STAR must be the première act at the Third Surface Reclamation War festival!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_mustang","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_131","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_131","text":"They must be our numéro un! Absolument!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_132","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_132","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_133","type":"Self","speaker":null,"key":"Locale_Mai