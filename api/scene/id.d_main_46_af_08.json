{"id":"d_main_46_af_08","cat":"main","group":{"id":"ch46","label":"Chapter 46 · Rebirth"},"label":"Perfect Timing","stage":null,"prev":"d_main_46_af_07","next":"d_main_46_af_09","speakers":{"andersen":"Andersen","burningum":"Burningum","enikk_op_r":"Enikk","syuen":"Syuen","ingrid":"Ingrid","mustang":"Mustang"},"icons":{"andersen":"si_c903_00_s","burningum":"si_c914_00_s","enikk_op_r":"si_c904_00_s","syuen":"si_c901_00_s","ingrid":"si_c900_00_s","mustang":"si_c902_00_s"},"lines":[{"id":"d_main_46_af_08_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_1","text":"In the Central Government's main conference room...","jump":null,"exit":false,"enter":null,"bg":"BriefingRoom","bgArt":"briefingroom","image":null,"bgm":"bgm_story_fairytalesend_a","movie":null,"shown":["andersen","burningum","syuen","ingrid","mustang"],"affinity":null},{"id":"d_main_46_af_08_2","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_2","text":"All right, let's go over the situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_3","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_3","text":"The most pressing issue is the Ark's power source.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_4","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_4","text":"It's only operating at 20% of its former output, and that number continues to decrease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_5","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_5","text":"Second is the matter of Dorothy's sentencing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_6","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_6","text":"The incident was severe enough to cause casualties. On top of that, it really rattled the public.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_7","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_7","text":"Speaking of, we've got an open Deputy Chief position now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_8","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_8","text":"Anyone have any candidates in mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_9","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_08_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_10","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_11","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_08_11","text":"I-I do. I-it's still a little early to say, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_12","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_12","text":"Hmm. Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_13","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_13","text":"And third.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_14","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_14","text":"A gunfight in the middle of the city, following the incident with Sixo, all sorts of rumors are spreading.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_15","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_15","text":"Public confidence has taken a serious hit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_16","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_16","text":"We need to gradually resolve this, but we're out of ideas at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_17","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_08_17","text":"The Ark's power source is the most critical issue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_r"],"affinity":null},{"id":"d_main_46_af_08_18","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_08_18","text":"The Ark's infrastructure will gradually become paralyzed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_19","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_08_19","text":"No viable alternative has been identified as of yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_20","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_20","text":"Can't we just go to the surface and bring back a truckload of supplies?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_21","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_21","text":"Supplies near the Ark have been completely depleted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_22","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_22","text":"We'd need to venture much farther, and the risk and time required increase sharply the farther we go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_23","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_46_af_08_23","text":"Also, it's not just a matter of supplies. Even if supplies come in, we lack the power to process them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_24","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_24","text":"Le public sentiment c'est much more sérieux.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_25","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_25","text":"Mystérieux groups are forming in large numbers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_26","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_46_af_08_26","text":"We do not know when or where or what kind of problème will arise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_27","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_27","text":"The conference chamber falls silent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_28","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_08_28","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_29","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_30","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_08_30","text":"{AccountData.NickName}. W-we would like to hear your thoughts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_31","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_31","text":"Hmm. I believe you would have an appropriate solution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_32","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_32","text":"After all, you are the Commander of the Commando Unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_34","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_34","text":"Everyone looks at me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_35","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_35","text":"Bearing the weight of expectations, I open my mouth to speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_36","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_36","text":"I propose the Third Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_37","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_37","text":"Silence falls over the chambers once more.","jump":null,"exit":false,"enter":null,"bg":"ArkCore_On","bgArt":"arkcore_on","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_38","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_38","text":"I press on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_39","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_39","text":"The Ark's power source is effectively beyond saving. Which means, we would have no choice but to abandon the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_beforethenextstep","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_40","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_40","text":"The surface has more natural resources in abundance, such as sunlight and water.","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_41","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_41","text":"In contrast, the Ark consumes vast amounts of energy just to sustain light and water sources.","jump":null,"exit":false,"enter":null,"bg":"Ark_02","bgArt":"ark_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_42","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_42","text":"Yes, our infrastructure will falter at first, but we can't just sit back and wait for death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_43","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_43","text":"Everyone in the conference room listens quietly.","jump":null,"exit":false,"enter":null,"bg":"BriefingRoom","bgArt":"briefingroom","image":null,"bgm":null,"movie":null,"shown":["andersen","burningum","syuen"],"affinity":null},{"id":"d_main_46_af_08_44","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_44","text":"I propose the Third Surface Reclamation War, with Dorothy leading the charge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_45","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_45","text":"We legitimize everything Dorothy said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_46","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_46","text":"We announce that all of this happened because the Queen descended to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_47","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_47","text":"We attribute the string of incidents that occurred in the Ark to the Queen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_48","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_48","text":"The Central Government kept all this secret to prepare for the Third Surface Reclamation War,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_49","text":"but in the wake of Dorothy's revelation, decided to go public to prevent anything worse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_50","text":"Since we cannot let Dorothy's words turn out to be a lie, we place Dorothy at the vanguard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid","mustang"],"affinity":null},{"id":"d_main_46_af_08_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_51","text":"Additionally, I demand the restoration of her reputation and that of the entire Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_52","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_52","text":"... That last request seems rather personal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_a","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_53","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_53","text":"I won't deny it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_54","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_46_af_08_54","text":"Do you think Dorothy will go along with this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_55","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_08_55","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_56","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_56","text":"The Third Surface Reclamation War? Are you out of your mind?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_57","type":"Speech","speaker":"syuen","key":"Locale_MainScenario:d_main_46_af_08_57","text":"The Raptures are infinite. How long are we going to bang our heads against this wall?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_08_58","type":"Speech","speaker":"andersen","