{"id":"msg_m_ex_brid_01","cat":"messenger","group":{"id":"room_brid","label":"Brid · Nikke"},"label":"1. Hi, Commander!","stage":null,"prev":null,"next":"msg_m_ex_brid_02","speakers":{"brid":"Brid"},"icons":{"brid":"si_c070_00_s"},"lines":[{"id":"m_ex_brid_01_1","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_1","text":"Hi, Commander!","jump":null},{"id":"m_ex_brid_01_2","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_2","text":"I'm Brid,","jump":null},{"id":"m_ex_brid_01_3","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_3","text":"a Nikke from Infinity Rail.","jump":null},{"id":"m_ex_brid_01_4","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_4","text":"I'm also a conductor for Ark Express.","jump":null},{"id":"m_ex_brid_01_5","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_5","text":"Looks like we're gonna be working together.","jump":null},{"id":"m_ex_brid_01_6","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_6","text":"Nice to meet you.","jump":null},{"id":"m_ex_brid_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_7","text":"Nice to meet you too.","jump":null},{"id":"m_ex_brid_01_8","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_8","text":"Do you have any questions about me?","jump":null},{"id":"m_ex_brid_01_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_9","text":"Questions?","jump":null},{"id":"m_ex_brid_01_10","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_10","text":"Yes, questions.","jump":null},{"id":"m_ex_brid_01_11","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_11","text":"Whenever a Nikke receives a support request,","jump":null},{"id":"m_ex_brid_01_12","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_12","text":"she should first establish contact with the CO,","jump":null},{"id":"m_ex_brid_01_13","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_13","text":"introduce herself,","jump":null},{"id":"m_ex_brid_01_14","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_14","text":"and elucidate them as to","jump":null},{"id":"m_ex_brid_01_15","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_15","text":"how she should be commanded.","jump":null},{"id":"m_ex_brid_01_16","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_16","text":"Have any other Nikkes contacted you before?","jump":null},{"id":"m_ex_brid_01_17","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_17","text":"Well, not really...","jump":"m_ex_brid_01_19"},{"id":"m_ex_brid_01_18","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_18","text":"Of course.","jump":"m_ex_brid_01_22"},{"id":"m_ex_brid_01_19","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_19","text":"Oh, I see.","jump":null},{"id":"m_ex_brid_01_20","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_20","text":"So I'm the first Nikke who's ever contacted you.","jump":null},{"id":"m_ex_brid_01_21","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_21","text":"That's fine. Let's just start with getting to know each other.","jump":"m_ex_brid_01_23"},{"id":"m_ex_brid_01_22","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_22","text":"Then I assume you're familiar with the process.","jump":null},{"id":"m_ex_brid_01_23","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_23","text":"Allow me to ask again.","jump":null},{"id":"m_ex_brid_01_24","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_24","text":"Do you have any questions about me?","jump":null},{"id":"m_ex_brid_01_25","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_25","text":"Are you usually in the Ark?","jump":null},{"id":"m_ex_brid_01_26","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_26","text":"Yes.","jump":null},{"id":"m_ex_brid_01_27","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_27","text":"Hardly surprising considering","jump":null},{"id":"m_ex_brid_01_28","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_28","text":"that I'm a conductor for Ark Express.","jump":null},{"id":"m_ex_brid_01_29","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_29","text":"I drive the AZX.","jump":null},{"id":"m_ex_brid_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_30","text":"AZX?","jump":null},{"id":"m_ex_brid_01_31","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_31","text":"!","jump":null},{"id":"m_ex_brid_01_32","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_32","text":"Don't tell me you've never heard of AZX?!","jump":null},{"id":"m_ex_brid_01_33","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_33","text":"I've heard of it.","jump":"m_ex_brid_01_35"},{"id":"m_ex_brid_01_34","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_34","text":"Never heard of it.","jump":"m_ex_brid_01_36"},{"id":"m_ex_brid_01_35","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_35","text":"Of course.","jump":"m_ex_brid_01_41"},{"id":"m_ex_brid_01_36","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_36","text":"What are they teaching you at those Military Academy?","jump":null},{"id":"m_ex_brid_01_37","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_37","text":"This should be common knowledge...","jump":null},{"id":"m_ex_brid_01_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_38","text":"I was joking.","jump":null},{"id":"m_ex_brid_01_39","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_39","text":"!!","jump":null},{"id":"m_ex_brid_01_40","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_40","text":"My apologies.","jump":null},{"id":"m_ex_brid_01_41","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_41","text":"I got ahead of myself.","jump":null},{"id":"m_ex_brid_01_42","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_42","text":"Of course, you would have heard of it.","jump":null},{"id":"m_ex_brid_01_43","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_43","text":"Allow me to introduce it in further detail.","jump":null},{"id":"m_ex_brid_01_44","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_44","text":"AZX stands for Ark Zero Express.","jump":null},{"id":"m_ex_brid_01_45","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_45","text":"After AFX, the first train in the Ark, was attacked by terrorists,","jump":null},{"id":"m_ex_brid_01_46","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_46","text":"a new name was formulated, and thus Zero came to be.","jump":null},{"id":"m_ex_brid_01_47","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_47","text":"It offers safer and more expedient transportation for its passengers.","jump":null},{"id":"m_ex_brid_01_48","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_48","text":"What a cool name!","jump":null},{"id":"m_ex_brid_01_49","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_49","text":"Very cool, indeed.","jump":null},{"id":"m_ex_brid_01_50","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_50","text":"My thoughts exactly.","jump":null},{"id":"m_ex_brid_01_51","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_51","text":"That's it.","jump":null},{"id":"m_ex_brid_01_52","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_52","text":"Any other questions?","jump":null},{"id":"m_ex_brid_01_53","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_53","text":"What do you do on your days off?","jump":"m_ex_brid_01_55"},{"id":"m_ex_brid_01_54","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_54","text":"What's your type?","jump":"m_ex_brid_01_61"},{"id":"m_ex_brid_01_55","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_55","text":"Actually,","jump":null},{"id":"m_ex_brid_01_56","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_56","text":"I don't have days off.","jump":null},{"id":"m_ex_brid_01_57","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_57","text":"For me, I'm either working,","jump":null},{"id":"m_ex_brid_01_58","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_58","text":"or on standby waiting for the call.","jump":null},{"id":"m_ex_brid_01_59","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_59","text":"Occasionally, I'll take a moment to decompress,","jump":null},{"id":"m_ex_brid_01_60","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_60","text":"so perhaps you could consider that my \"day off.\"","jump":"m_ex_brid_01_67"},{"id":"m_ex_brid_01_61","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_61","text":"My type?","jump":null},{"id":"m_ex_brid_01_62","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_62","text":"Yeah.","jump":null},{"id":"m_ex_brid_01_63","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_63","text":"AZX.","jump":null},{"id":"m_ex_brid_01_64","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_64","text":"???","jump":null},{"id":"m_ex_brid_01_65","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_65","text":"That's my \"type.\"","jump":null},{"id":"m_ex_brid_01_66","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_66","text":"Nothing else.","jump":null},{"id":"m_ex_brid_01_67","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_67","text":"I see.","jump":null},{"id":"m_ex_brid_01_68","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_68","text":"Considering you're starting to ask me personal questions,","jump":null},{"id":"m_ex_brid_01_69","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_69","text":"I assume you don't have any questions related to working with me.","jump":null},{"id":"m_ex_brid_01_70","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_70","text":"If you don't mind,","jump":null},{"id":"m_ex_brid_01_71","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_71","text":"I should get back to work.","jump":null},{"id":"m_ex_brid_01_72","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_72","text":"By the way,","jump":null},{"id":"m_ex_brid_01_73","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_73","text":"I'm often quite busy.","jump":null},{"id":"m_ex_brid_01_74","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_74","text":"Please keep that in mind.","jump":null},{"id":"m_ex_brid_01_75","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_brid_01_75","text":"Sure.","jump":null},{"id":"m_ex_brid_01_76","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_76","text":"Great.","jump":null},{"id":"m_ex_brid_01_77","type":"Speech","speaker":"brid","key":"Locale_SuddenMessage:m_ex_brid_01_77","text":"See you next time, Commander.","jump":null}],"chat":true}