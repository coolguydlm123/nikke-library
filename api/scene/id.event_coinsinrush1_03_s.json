ed area","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_03_s_19","type":"Speech","speaker":"coinrushsecurity","key":"Locale_MainScenario:event_coinsinrush1_03_s_19","text":"are to be handed over directly to the A.C.P.U.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_03_s_20","type":"Speech","speaker":"coinrushsecurity","key":"Locale_MainScenario:event_coinsinrush1_03_s_20","text":"Now that your companion has arrived, you can explain yourselves at the police station.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_03_s_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinsinrush1_03_s_21","text":"The security guard pulls out his phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_03_s_22","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_coinsinrush1_03_s_22","text":"... And then Rouge snatches it from him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_03_s_23","type":"Speech","speaker":"rouge","key":"Locale_MainScenario:event_coinsinrush1_03_s_23","text":"It's not a serious offense. We can let them go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_03_s_24","type":"Speech","speaker":"rouge","key":"Locale_MainScenario:event_coinsinrush1_03_s_24","text":"After all, they didn't actually enter anywhere they weren't supposed to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image