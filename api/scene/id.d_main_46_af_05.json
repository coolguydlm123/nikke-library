e_MainScenario:d_main_46_af_05_6","text":"Chaos erupts. Nikkes and citizens alike scream.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_7","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_7","text":"One of the Ark's highest authorities, a Deputy Chief, is dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_8","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_46_af_05_8","text":"Dorothy! What have you done...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_9","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_05_9","text":"... It wasn't me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_10","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_11","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_11","text":"I turn my head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_12","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_12","text":"Smoke rises from Deputy Chief Burningum's gun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["burningum"],"affinity":null},{"id":"d_main_46_af_05_13","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_13","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_14","text":"Deputy Chief...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_15","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_15","text":"Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_16","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_16","text":"The verdict.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_17","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_17","text":"I will deliver my judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_r"],"affinity":null},{"id":"d_main_46_af_05_18","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_18","text":"The mobilization of private forces within the Ark without majority consent of Ark leadership.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_19","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_19","text":"The use of live ammunition within the Ark without majority consent of Ark leadership.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_20","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_20","text":"The use of explosives within the Ark without majority consent of Ark leadership.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_21","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_21","text":"The meaningless sacrifice of Nikkes in the process.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_22","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_22","text":"Furthermore, the misuse of classified research data pertaining to corruption without majority consent of Ark leadership.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_23","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_23","text":"All of the above actions resulted in considerable disorder within the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_24","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_24","text":"I hereby deliver judgment on Deputy Chief Burningum, who carried out summary execution on Deputy Chief Doban, the party responsible for the aforementioned offenses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_25","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_25","text":"On the basis that Deputy Chief Doban's actions could have further destabilized the Ark's already turbulent situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_26","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_26","text":"On the basis of the potential threat posed to the Ark by unnecessarily provoking the Pilgrim, Dorothy, an unidentified entity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_27","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_27","text":"Furthermore, on the basis that Deputy Chief Doban held no meaningful influence over the Ark's current operations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_28","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_28","text":"I hereby rule Deputy Chief Burningum's summary execution of Doban a justified act.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_29","type":"Speech","speaker":"enikk_op_r","key":"Locale_MainScenario:d_main_46_af_05_29","text":"Please note that this ruling factored in the special circumstances of the situation being treated as wartime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_30","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_30","text":"... Whew.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_31","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_31","text":"Good. That's a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_32","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_32","text":"Burningum, who is drenched in sweat, looks at Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_33","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_33","text":"Dorothy stares back with a shocked expression.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_34","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_34","text":"... A real relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_35","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_35","text":"Burningum surveys the Nikkes filling the streets, and the citizens watching everything unfold from a distance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_36","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_36","text":"Then he whispers to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_37","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_37","text":"Help me put the Nikkes and the citizens at ease.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_38","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_38","text":"Wh-what...? Why don't you do it yourself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_39","type":"Speech","speaker":"burningum","key":"Locale_MainScenario:d_main_46_af_05_39","text":"I'm not good with crowded places.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_40","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_40","text":"V-very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_41","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_41","text":"A private call comes through from Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["enikk_op_c"],"affinity":null},{"id":"d_main_46_af_05_42","type":"Speech","speaker":"enikk_op_c","key":"Locale_MainScenario:d_main_46_af_05_42","text":"I will dispatch personnel to retrieve the body of the former Deputy Chief Doban.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_43","type":"Speech","speaker":"enikk_op_c","key":"Locale_MainScenario:d_main_46_af_05_43","text":"Additionally, I will request that Elysion treat the Nikkes afflicted with corruption.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_44","type":"Speech","speaker":"enikk_op_c","key":"Locale_MainScenario:d_main_46_af_05_44","text":"They should be treatable with the Vapaus we have secured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_45","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_45","text":"So you knew about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_46","type":"Speech","speaker":"enikk_op_c","key":"Locale_MainScenario:d_main_46_af_05_46","text":"Yes, but I am the only one who does, so there is no need for concern.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_47","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_47","text":"Good. I'll leave it in your hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_48","type":"Speech","speaker":"enikk_op_c","key":"Locale_MainScenario:d_main_46_af_05_48","text":"Very well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_49","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_49","text":"I look around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_50","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_50","text":"I see the trembling eyes of the countless Nikkes and citizens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_51","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_51","text":"At the end of their gazes, Dorothy stands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_52","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_52","text":"I take a deep breath,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_53","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_53","text":"and point at Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_54","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_54","text":"This is Dorothy, the second leader of the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_55","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_05_55","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_56","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_56","text":"The Goddess Squad is not a legend. They existed, and their leader stands before you now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_57","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_05_57","text":"What on earth are you saying?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_58","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_58","text":"Dorothy is innocent. I can vouch for her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_59","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_59","text":"You all know what Dorothy has done for the Ark in its time of need.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_60","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_60","text":"I will personally guarantee Dorothy's safety,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_61","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_61","text":"as the Commander of the Counters, the Commando Unit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_62","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_46_af_05_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_63","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_63","text":"Former Deputy Chief Doban...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_64","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_64","text":"He attempted to frame and execute Dorothy. His motives are currently under investigation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_65","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_65","text":"His actions were no different from acts of terrorism, including the discharge of firearms, and the planting of bombs inside Nikkes to use them as weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_66","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_66","text":"He was executed by Deputy Chief Burningum.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_67","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_67","text":"Should I say more? Do I need to address what Dorothy, or even what Doban said?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_68","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_68","text":"As I mull these things over, my eyes meet Burningum's.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_69","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_69","text":"He subtly shakes his head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_70","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_71","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_71","text":"This is all I can share at the moment. Further details will be provided in a statement from the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_46_af_05_72","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_46_af_05_72","text":"From here on, please follow any directives issued by the Central Government. Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null