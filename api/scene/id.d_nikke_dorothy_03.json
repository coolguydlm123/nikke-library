":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dorothy_03_92","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_dorothy_03_92","text":"So stop following me around and bothering me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dorothy_03_93","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_dorothy_03_93","text":"Have I made myself clear?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dorothy_03_94","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dorothy_03_94","text":"You say that, but your face is telling me another story.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dorothy_03_95","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_dorothy_03_95","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dorothy_03_96","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dorothy_03_96","text":"Why are you pushing me away?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dorothy_03_97","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dorothy_03_97","text":"You're forcibly convincing yourself that you have to hate humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dorothy_03_98","type":"Speech","speaker":"dorothy","key":"Locale_NikkeEpisode:d_nikke_dorothy_03_98","text":"!!!","jump":null,"exit":fal