{"id":"event_marian1_04_s","cat":"event","group":{"id":"ev40124","label":"MARIA-n · Part 1"},"label":"A Faint Memory: A","stage":null,"prev":"event_marian1_intermission_01","next":"event_marian1_04_e","speakers":{"mirror_r":"Mirror","talkative":"Chatterbox"},"icons":{"mirror_r":"si_c982_00_s"},"lines":[{"id":"event_marian1_04_s_1","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_1","text":"I don't mean to be rude, but I'm not someone you can just call whenever you want.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01","bgArt":"wasteland_01","image":null,"bgm":"event_bgm_maria-n_atrocityh","movie":null,"shown":["talkative","mirror_r"],"affinity":null},{"id":"event_marian1_04_s_2","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_2","text":"So, what is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_3","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_3","text":"You must have a good reason for calling me here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_4","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_4","text":"I found something interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_5","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_5","text":"Oh, is that so? And you just had to share it with me? I didn't realize we were on such friendly terms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_6","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_7","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_7","text":"Fine. I came all this way, so I might as well hear you out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_8","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_8","text":"This is what I found.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_9","text":"Chatterbox lifts a concrete pillar lying on the ground,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_10","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_10","text":"revealing a dead Maria-n beneath it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_11","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_11","text":"A human imposter crushed to death. What's so interesting about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_12","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_12","text":"Look over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_13","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_13","text":"Chatterbox points at the wall of a collapsed building.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_14","text":"Three Maria-ns lie dead, slumped against it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_15","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_15","text":"... The Ark must have come up with a new mass-produced model.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_16","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_16","text":"Do you think one extra model poses some great threat to Raptures?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_17","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_17","text":"What exactly do you take us for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_18","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_18","text":"They aren't mass-produced.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_19","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_19","text":"None of their bodies' specs, weapons, or equipment is mass-production grade.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_20","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_20","text":"They are each their own individual.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_21","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_22","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_22","text":"I don't know. Are you sure you're not just reading into it? It would make more sense that they're high-spec, mass-produced models.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_23","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_23","text":"Judging by the time... it should take another hour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_24","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_24","text":"Wait here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_25","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_25","text":"... For what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_26","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_26","text":"In an hour you'll see something more interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_27","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_27","text":"Chatterbox, I understand you want to impress me due to how close I am with the Queen, but this isn't the way to do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_28","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_28","text":"I don't exactly have a ton of free time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_29","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_29","text":"I guarantee you won't regret it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_30","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_31","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_31","text":"Sure, okay. I'll stick around for one hour.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_32","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_32","text":"... Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_33","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_33","text":"We hit the hour mark a while back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_34","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_34","text":"Yes. Ten minutes ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_35","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_35","text":"When will we be seeing this \"more interesting\" thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_36","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_36","text":"You lack patience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_37","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_37","text":"It's here. Watch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_38","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_38","text":"A transport ship lands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_39","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_39","text":"Maria-n steps out and moves along, glancing around her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_40","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_40","text":"A moment later, she's killed by a Rapture's attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_41","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_41","text":"The transport ship departs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_42","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_43","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_43","text":"Just a little longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_44","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_44","text":"One hour later, another transport ship lands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_45","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_45","text":"Another Maria-n steps out and begins to move while surveying her surroundings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_46","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_46","text":"Shortly after, she is crushed beneath a building that collapses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_47","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_47","text":"... What is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_48","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_48","text":"It feels like a twisted nightmare.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_49","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_49","text":"They keep coming. There have been over thirty of them, and that's just what I've seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_50","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_50","text":"What, so the transport ship brings one of those human imposters here, and when that one dies, another identical one is brought here again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_51","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_51","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_52","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_52","text":"... Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_53","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_53","text":"That's the question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_54","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_54","text":"After about five days, the dead human imposters dissolve completely. No trace is left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_55","type":"Speech","speaker":"talkative","key":"Locale_MainScenario:event_marian1_04_s_55","text":"What do you think? Pretty interesting, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_56","type":"Speech","speaker":"mirror_r","key":"Locale_MainScenario:event_marian1_04_s_56","text":"... I'll let you know after I've watched a while longer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_57","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_57","text":"Mirror and Chatterbox don't move from that spot for two days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_58","text":"In that time, numerous Maria-ns appear, only to meet their demise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_marian1_04_s_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_marian1_04_s_59","text":"Sometimes alone, sometimes several at once.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"