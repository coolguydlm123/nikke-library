{"id":"memorial_102601","cat":"memorial","group":{"id":"memorial102600","label":"Call Logs · Jonathan_report"},"label":"day48.mp4","stage":null,"prev":null,"next":"memorial_102602","speakers":{},"icons":{},"lines":[{"id":"memorial_102601_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_26_01_description","text":"(File corrupted, audio only)"},{"id":"memorial_102601_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_26_01_description","text":"My name is Jonathan Cross."},{"id":"memorial_102601_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_26_01_description","text":"Age 28."},{"id":"memorial_102601_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_26_01_description","text":"To complete the investigation entrusted to me by the lab, I brought 9 Nikkes to the surface, 5 of which are mass-production types."},{"id":"memorial_102601_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_26_01_description","text":"It is our 48th day on the surface. I've started to make these recordings because my ComLink was destroyed beyond repair in yesterday's battle, and I can no longer report back to the Ark."}]}