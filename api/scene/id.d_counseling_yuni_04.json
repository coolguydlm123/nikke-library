{"id":"d_counseling_yuni_04","cat":"counsel","group":{"id":"char5006","label":"Yuni"},"label":"Advising Yuni: 04","stage":null,"prev":"d_counseling_yuni_03","next":"d_counseling_yuni_05","speakers":{"yuni":"Yuni"},"icons":{"yuni":"si_c160_00_s"},"lines":[{"id":"d_counseling_yuni_04_1","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_1","text":"I want to use this whip to attack the Raptures,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["yuni"],"affinity":"_0"},{"id":"d_counseling_yuni_04_2","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_2","text":"but Mihara always stops me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_04_3","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_3","text":"Why? I'm much better with a whip than a gun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_04_4","text":"Because Raptures don't feel any pain.","jump":"d_counseling_yuni_04_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_yuni_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_04_5","text":"Because the whip hurts more than the gun.","jump":"d_counseling_yuni_04_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_yuni_04_6","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_6","text":"Ah...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_04_7","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_7","text":"That's why... I guess even if I did use it, they wouldn't be able to appreciate it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_04_8","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_8","text":"You're so smart, Commander!","jump":"d_counseling_yuni_04_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_04_9","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_9","text":"No, Commander. That's not it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_04_10","type":"Speech","speaker":"yuni","key":"Locale_Counseling:d_counseling_yuni_04_10","text":"It's not a matter of which hurts more. It's something else entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_yuni_04_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_yuni_04_11","text":"Yuni teaches me how to use the whip.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}