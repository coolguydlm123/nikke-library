{"id":"d_counseling_leona_17","cat":"counsel","group":{"id":"char5092","label":"Leona"},"label":"Advising Leona: 17","stage":null,"prev":"d_counseling_leona_16","next":"d_counseling_leona_18","speakers":{"leona":"Leona"},"icons":{"leona":"si_c382_00_s"},"lines":[{"id":"d_counseling_leona_17_1","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_1","text":"There's a saying, \"A lion always hunts to the hilt, even when trying to catch a rabbit.\"","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["leona"],"affinity":"_0"},{"id":"d_counseling_leona_17_2","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_2","text":"What's your takeaway from that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_17_3","text":"That you should try your best, no matter if the task is big or small.","jump":"d_counseling_leona_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_leona_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_17_4","text":"Surviving in the wild isn't easy.","jump":"d_counseling_leona_17_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_leona_17_5","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_5","text":"A fairly cookie-cutter answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_6","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_6","text":"But did you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_7","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_7","text":"Rabbits are faster than you think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_8","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_8","text":"For a lion, catching a rabbit isn't as easy as you may imagine.","jump":"d_counseling_leona_17_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_9","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_9","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_10","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_10","text":"You're the first person to tell me that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_11","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_11","text":"In the unforgiving environment that is nature, you have to give your utmost to every hunt, regardless of the size of the prey.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_12","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_12","text":"On top of that, rabbits can run much faster than you might think.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_13","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_17_13","text":"I appreciate you sharing your thoughts with me, Zoo Keeper.","jump":"d_counseling_leona_17_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_17_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_leona_17_14","text":"I have an enjoyable time with Leona.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}