{"id":"event_overzone2_01_s","cat":"event","group":{"id":"ev80304","label":"OVER ZONE · Part 2"},"label":"Utopia: A","stage":null,"prev":null,"next":"event_overzone2_01_e","speakers":{"snowwhite":"Snow White","hongryeon":"Scarlet","rapunzel":"Rapunzel","dorothy":"Dorothy","collectrobot":"Collection Robot","manvoice":"Male Voice"},"icons":{"snowwhite":"si_c220_00_s","hongryeon":"si_c222_00_s","rapunzel":"si_c221_00_s","dorothy":"si_c233_00_s","collectrobot":"si_c931_00_s","manvoice":"si_c911_00_s"},"lines":[{"id":"event_overzone2_01_s_1","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_01_s_1","text":"...","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"ambient_scn_wind","movie":null,"shown":["snowwhite","hongryeon","rapunzel"],"affinity":null},{"id":"event_overzone2_01_s_2","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_2","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_3","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_s_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_4","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_s_4","text":"Is she able to get up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_5","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_5","text":"Not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_6","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_6","text":"Her own mental fortitude will be the deciding factor. Regardless, it won't be easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_7","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_7","text":"If you think I look haggard, Dorothy is doing far worse than I.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_8","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_01_s_8","text":"I'm going to go out and forage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_9","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_01_s_9","text":"I realize it's bad timing, but we need materials.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_10","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_s_10","text":"I'll go with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_11","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_11","text":"I shall keep watch over Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_12","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_s_12","text":"Everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["dorothy","collectrobot"],"affinity":null},{"id":"event_overzone2_01_s_13","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_13","text":"Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_14","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_s_14","text":"Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_15","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_s_15","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_16","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_s_16","text":"Of course. I'm fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_17","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_01_s_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_18","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_s_18","text":"I got a message from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_19","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_s_19","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_20","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_20","text":"Thou does not say this in jest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_21","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_s_21","text":"Of course not. Let's listen to it together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_22","type":"Speech","speaker":"collectrobot","key":"Locale_MainScenario:event_overzone2_01_s_22","text":"Voice transmission from the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_23","type":"Speech","speaker":"collectrobot","key":"Locale_MainScenario:event_overzone2_01_s_23","text":"Would you like to listen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_24","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_s_24","text":"Yes, play message.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_25","type":"Speech","speaker":"collectrobot","key":"Locale_MainScenario:event_overzone2_01_s_25","text":"*Buzz* *Buzz*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_26","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_26","text":"To the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_signal","movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_27","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_27","text":"First and foremost, our deepest condolences for the death of your squad leader, Liliweiss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_28","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_28","text":"Many of those in the Ark are grieving this great loss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_29","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_29","text":"We also thank you for guiding Operation: Guardian Ark to its completion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_30","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_30","text":"On behalf of all the Ark's citizens, I would like to express our gratitude to you for a job well done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_31","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_31","text":"We are currently looking into ways to supply additional troops and resources, but there have been numerous delays due to many ongoing issues within the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_32","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_32","text":"We apologize for the inconvenience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_33","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_33","text":"Due to these unforeseen complications, the operation has been temporarily put on hold.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_34","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_34","text":"Additional complications have arisen on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_35","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_35","text":"Therefore, we must entrust the only remaining forces above the surface, the formidable Goddess Squad, with an additional assignment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_36","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_36","text":"Should you resolve these issues, which I will go over in detail momentarily, the Ark will successfully be sealed, and peace will prevail.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_37","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_37","text":"After you have listened to this message, please come to a decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_38","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_38","text":"Of course, the final decision lies squarely with the acting leader, Dorothy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_39","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_39","text":"We humans are eternally grateful for everything you have done for us up until now. We are forever in your debt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_40","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_40","text":"So please, do not feel pressured to sway your decision one way or the other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_41","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:event_overzone2_01_s_41","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_42","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_42","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_43","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:event_overzone2_01_s_43","text":"Is that all there is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_44","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:event_overzone2_01_s_44","text":"No. There's more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_45","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_45","text":"Play it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_46","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_46","text":"Your orders are as follows: \n1. Destroy the Alva particle generator in order to disrupt Raptures' ability to communicate with one another.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_47","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_47","text":"The generator is powerful enough that it can negatively affect systems within the Ark itself, even from such a great distance. It is for this reason that we have been unable to make progress in certain areas with the sealing of the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_48","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_48","text":"2. Annihilate the Rapture hordes in certain designated areas.","jump":null,"exit":false,"enter":null,"bg":"Desert_02","bgArt":"desert_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_49","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_49","text":"At these specific coordinates, sealing efforts are being conducted in close proximity to the surface.\nThe loud noises generated by construction are likely to be detected by Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_50","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_50","text":"3. Destroy the freight elevator.","jump":null,"exit":false,"enter":null,"bg":"Elevator","bgArt":"elevator","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_51","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_51","text":"This elevator was originally used to deliver food and other materials to the Ark, and will not be used after it is sealed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_52","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_52","text":"Given that it provides a direct connection to the Ark, it could potentially be used by Raptures. To prevent any potential and disastrous misuse, it must be destroyed at all costs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_53","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_53","text":"...","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":null,"movie":null,"shown":["rapunzel"],"affinity":null},{"id":"event_overzone2_01_s_54","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_54","text":"Should you choose to accept this mission, you are to start with destroying the Alva particle generator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_55","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_55","text":"It is the shortest distance from the Ark itself. Once that is destroyed, we will be able to establish direct communication with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_56","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_56","text":"That is all. We await your decision.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_57","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_57","text":"I do not know if this will be of any influence,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_58","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_58","text":"but the Ark is anxiously awaiting the return of the Goddess Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_59","type":"Speech","speaker":"manvoice","key":"Locale_MainScenario:event_overzone2_01_s_59","text":"We will ensure that you are sufficiently rewarded for all the sacrifices you have made.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_60","type":"Speech","speaker":"collectrobot","key":"Locale_MainScenario:event_overzone2_01_s_60","text":"The voice message has ended.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_61","type":"Speech","speaker":"collectrobot","key":"Locale_MainScenario:event_overzone2_01_s_61","text":"There are 0 messages left.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_overzone2_01_s_62","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:event_overzone2_01_s_62","text":"... Uh-huh."