{"id":"d_main_05_07","cat":"main","group":{"id":"ch5","label":"Chapter 5 · Wonderland"},"label":"Unlimited","stage":"5-12 STAGE · End","prev":"d_main_05_06","next":"d_main_05_08_s","speakers":{"ludmilla":"Ludmilla","alice":"Alice","Narration":"Narration","Self":"Commander"},"icons":{"ludmilla":"si_c190_00_s","alice":"si_c191_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_05_07_1","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_1","text":"Nice digs. Better than I expected. You should be able to rest here.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":"bgm_story_inwonderland","movie":null,"shown":["alice","ludmilla"],"affinity":null},{"id":"d_main_05_07_2","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_2","text":"Alice, I have something I want to discuss with my servant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_3","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_3","text":"Could you excuse us for a moment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_4","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_07_4","text":"No problem, I'll see if there are any of the Queen of Hearts's underlings nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_5","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_5","text":"Thank you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_6","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_05_07_6","text":"Alice runs out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_7","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_8","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_8","text":"Will she be in danger?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_9","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_9","text":"Not at all. Alice can take care of herself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_10","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_10","text":"Allow me to reintroduce myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_11","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_11","text":"I'm Ludmilla. My squad goes by the name Unlimited. The girl with me is Alice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_mystery","movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_12","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_12","text":"We're responsible for rescuing Nikkes who are lost on the surface and sending them back to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_13","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_13","text":"You could say we're sort of like pathfinders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_14","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_14","text":"If you ever find yourself lost on the surface, go north. I'm sure you've heard that old chestnut.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_15","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_15","text":"Well, that's because north is where you'll find Unlimited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_16","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_16","text":"However, this is the first time we've saved a human.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_17","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_17","text":"Anyway, didn't you say you were heading to a research base?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_18","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_18","text":"I don't know what your goal is, but that place is a no-go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_19","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_19","text":"That research base now belongs to the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_20","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_20","text":"That's why we've been reduced to becoming wandering nomads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_21","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_21","text":"Is it occupied?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_22","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_22","text":"No, something different. They've... changed it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_23","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_23","text":"It's been changed into something else entirely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_24","text":"We have to go there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_25","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_25","text":"Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_26","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_26","text":"If I want to find Chatterbox, I need to meet up with the Pilgrims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_27","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_27","text":"That doesn't sound like any ordinary mission a Commander would be overseeing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_28","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_28","text":"Why are you looking for the Pilgrims?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_29","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_29","text":"I want to find out the truth about the death of a good friend of mine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_30","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_31","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_31","text":"Was this friend a Nikke?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_32","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_32","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_33","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_33","text":"So you consider Nikkes to be your friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_34","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_34","text":"The relationship between a Commander and their Nikkes couldn't be any clearer. Master and slave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_35","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_35","text":"Tell me, do you refer to them as your friends just so you can get more use out of them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_36","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_36","text":"Or are you so arrogant that you actually believe they're honored that you address them in such a way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_37","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_37","text":"I didn't come here to have a debate. A friend is a friend.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_38","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_39","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_39","text":"Seems that you're quite serious about this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_40","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_40","text":"All the information on the Pilgrims is inside the research base.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_41","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_41","text":"If you can manage to reunite with your teammates and recapture the research base, you'll find all the answers inside there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_42","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_42","text":"I want to know, just how strong are your teammates?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_43","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_43","text":"Stronger than you'll ever be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_44","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_44","text":"Good answer!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_45","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_45","text":"... There's one more thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_46","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_46","text":"Alice...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_47","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_05_07_47","text":"... I will fight alongside her. We'll defeat the Queen of Hearts together.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_48","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_48","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_49","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_49","text":"Haha. If we were in a movie right now, you'd make for one hell of a good villain!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_50","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_50","text":"Alice! Let's go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_51","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_05_07_51","text":"Huh... Wh-what? Oh, yes, ma'am!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_05_07_52","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_05_07_52","text":"Guess I woke her up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}