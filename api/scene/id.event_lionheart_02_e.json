":null,"shown":null,"affinity":null},{"id":"event_lionheart_02_e_82","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_02_e_82","text":"I should have known you'd see through me, Nero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_02_e_83","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_02_e_83","text":"Okay...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_02_e_84","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_02_e_84","text":"The reason I brought us all out here today,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_02_e_85","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_02_e_85","text":"is because I wanted to test something out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_02_e_86","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_lionheart_02_e_86","text":"Test what out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_02_e_87","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_02_e_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lionheart_02_e_88","type":"Speech","speaker":"leona_no","key":"Locale_SubScenario:event_lionheart_02_e_88","text":"If the animals would be okay without us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movi