rothy","key":"Locale_SuddenStory:d_ex_redash_03_3_19","text":"What's a kid doing in a place like this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_3_20","type":"Speech","speaker":"rapunzel_o","key":"Locale_SuddenStory:d_ex_redash_03_3_20","text":"Who are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_3_21","type":"Speech","speaker":"snowwhite_o","key":"Locale_SuddenStory:d_ex_redash_03_3_21","text":"I-I'm Snow White, Grimms Model No. 4.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_3_22","type":"Speech","speaker":"snowwhite_o","key":"Locale_SuddenStory:d_ex_redash_03_3_22","text":"I wanted to give a proper self-introduction, but considering how desperate the situation is, we'll have to skip the formalities for the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_3_23","type":"Speech","speaker":"commander","key":"Locale_SuddenStory:d_ex_redash_03_3_23","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_3_24","type":"Speech","speaker":"liliweiss","key":"Locale_SuddenStory:d_ex_redash_03_3_24","text":"Snow White!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_03_3_25","type":"Speech","speaker":"snowwhite_o","key":"Locale_SuddenStory:d_ex_redash_03_3_25","text":"There's no time. Hand over your weapons to me, and I'll fix them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"a