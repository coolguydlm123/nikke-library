{"id":"msg_m_ex_signal_01","cat":"messenger","group":{"id":"room_signal","label":"Signal · Nikke"},"label":"1. Umm...","stage":null,"prev":null,"next":"msg_m_ex_signal_02","speakers":{"signal":"Signal"},"icons":{"signal":"si_c022_00_s"},"lines":[{"id":"m_ex_signal_01_1","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_1","text":"Umm...","jump":null},{"id":"m_ex_signal_01_2","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_2","text":"Hello!","jump":null},{"id":"m_ex_signal_01_3","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_3","text":"I'm Signal. We're going on this mission together!","jump":null},{"id":"m_ex_signal_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_4","text":"Nice to meet you.","jump":null},{"id":"m_ex_signal_01_5","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_5","text":"Nice to meet you too!","jump":null},{"id":"m_ex_signal_01_6","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_6","text":"Um...","jump":null},{"id":"m_ex_signal_01_7","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_7","text":"Actually...","jump":null},{"id":"m_ex_signal_01_8","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_8","text":"The reason why I'm texting you today","jump":null},{"id":"m_ex_signal_01_9","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_9","text":"is that I wanted to ask you something.","jump":null},{"id":"m_ex_signal_01_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_10","text":"Say it.","jump":null},{"id":"m_ex_signal_01_11","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_11","text":"Do you...","jump":null},{"id":"m_ex_signal_01_12","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_12","text":"like watching TV, movies, and things like that?","jump":null},{"id":"m_ex_signal_01_13","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_13","text":"Yeah, I guess.","jump":"m_ex_signal_01_15"},{"id":"m_ex_signal_01_14","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_14","text":"I don't like or hate it.","jump":"m_ex_signal_01_16"},{"id":"m_ex_signal_01_15","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_15","text":"Oh, I see!","jump":"m_ex_signal_01_18"},{"id":"m_ex_signal_01_16","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_16","text":"Ah,","jump":null},{"id":"m_ex_signal_01_17","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_17","text":"I see.","jump":"m_ex_signal_01_18"},{"id":"m_ex_signal_01_18","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_18","text":"How about you? Do you like watching TV series?","jump":null},{"id":"m_ex_signal_01_19","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_19","text":"You mean, me?","jump":null},{"id":"m_ex_signal_01_20","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_20","text":"Speaking of which...","jump":null},{"id":"m_ex_signal_01_21","type":"Monologue","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_21","text":"There was no reply for a long time.","jump":null},{"id":"m_ex_signal_01_22","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_22","text":"Signal?","jump":null},{"id":"m_ex_signal_01_23","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_23","text":"I'm right here.","jump":null},{"id":"m_ex_signal_01_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_24","text":"Is there anything that's difficult for you to talk about?","jump":null},{"id":"m_ex_signal_01_25","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_25","text":"No, no... It's just...","jump":null},{"id":"m_ex_signal_01_26","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_26","text":"I was afraid that you might have issues","jump":null},{"id":"m_ex_signal_01_27","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_27","text":"and was opposed to","jump":null},{"id":"m_ex_signal_01_28","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_28","text":"Nikkes watching TV","jump":null},{"id":"m_ex_signal_01_29","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_29","text":"or stuff like that.","jump":null},{"id":"m_ex_signal_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_30","text":"Don't worry, I don't.","jump":null},{"id":"m_ex_signal_01_31","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_31","text":"Ah, that's awesome!","jump":null},{"id":"m_ex_signal_01_32","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_32","text":"Yes, I absolutely love TV series!","jump":null},{"id":"m_ex_signal_01_33","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_33","text":"But!","jump":null},{"id":"m_ex_signal_01_34","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_34","text":"I only watch it during breaks.","jump":null},{"id":"m_ex_signal_01_35","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_35","text":"It doesn't interfere with the missions assigned to me at all.","jump":null},{"id":"m_ex_signal_01_36","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_36","text":"Plus, I only watch the TV in the dorm.","jump":null},{"id":"m_ex_signal_01_37","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_37","text":"It's true!","jump":null},{"id":"m_ex_signal_01_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_38","text":"Actually, it's okay to watch it outside the dorm.","jump":null},{"id":"m_ex_signal_01_39","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_39","text":"!!","jump":null},{"id":"m_ex_signal_01_40","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_40","text":"Really?","jump":null},{"id":"m_ex_signal_01_41","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_41","text":"Yes.","jump":null},{"id":"m_ex_signal_01_42","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_42","text":"Gasp!!","jump":null},{"id":"m_ex_signal_01_43","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_43","text":"You are so generous, Commander!","jump":null},{"id":"m_ex_signal_01_44","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_44","text":"Thanks.","jump":null},{"id":"m_ex_signal_01_45","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_45","text":"I will definitely work hard!","jump":null},{"id":"m_ex_signal_01_46","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_46","text":"Really, really hard!","jump":null},{"id":"m_ex_signal_01_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_signal_01_47","text":"All right, then. I look forward to working with you.","jump":null},{"id":"m_ex_signal_01_48","type":"Speech","speaker":"signal","key":"Locale_SuddenMessage:m_ex_signal_01_48","text":"Me too!","jump":null}],"chat":true}