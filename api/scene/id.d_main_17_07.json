{"id":"d_main_17_07","cat":"main","group":{"id":"ch17","label":"Chapter 17 · Purpose"},"label":"The World You Choose","stage":"17-19 STAGE · Start","prev":"d_main_17_06","next":"d_main_17_08","speakers":{"hongryeon":"Scarlet","rapi":"Rapi","snowwhite":"Snow White","rapunzel":"Rapunzel","shifty":"Shifty","ingrid":"Ingrid","marian":"Marian","anis":"Anis"},"icons":{"hongryeon":"si_c222_00_s","rapi":"si_c010_00_s","snowwhite":"si_c220_00_s","rapunzel":"si_c221_00_s","shifty":"si_c907_00_s","ingrid":"si_c900_00_s","marian":"si_c013_00_s","anis":"si_c012_00_s"},"lines":[{"id":"d_main_17_07_1","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_1","text":"Very well then. Say what you were going to say.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":"bgm_story_6f6e6573656c66","movie":null,"shown":["hongryeon","rapunzel"],"affinity":null},{"id":"d_main_17_07_2","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_2","text":"We first learned about the existence of NIMPH...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["snowwhite"],"affinity":null},{"id":"d_main_17_07_3","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_17_07_3","text":"Talk about the explanation given by Exia.","jump":"d_main_17_07_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_4","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_17_07_4","text":"Talk about Mihara's memory wipe.","jump":"d_main_17_07_19","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_5","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_5","text":"So that clever little Nikke told you about the existence of NIMPH.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_6","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_6","text":"What of it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_7","text":"What is that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_8","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_8","text":"What does it matter to us when you came about this knowledge?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_9","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_9","text":"I believed you would have put more effort into persuading us, but it seems I was wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_17_07_10","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_10","text":"Or, could it be you don't truly require the Vapaus as much I thought, perchance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_17_07_11","text":"I will tell you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_12","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_12","text":"No, I want them to tell it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_13","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_13","text":"Were you not the one who asked to find the Vapaus?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_14","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_14","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_15","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_15","text":"Then show me that you mean it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_16","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_16","text":"Prove to me that you believe what you're doing is right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_17","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_17","text":"Can you do that for me, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_18","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_17_07_18","text":"I need to collect my thoughts and try again.","jump":"d_main_17_07_2","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_19","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_19","text":"You were saddened at the fact one of your colleagues had gone through a memory wipe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_20","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_20","text":"What of it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_21","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_21","text":"Is such a thing not common in the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_22","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_22","text":"Humans wish to exert control over the Nikkes,\nfor they are petrified of potential Mind Switches.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_23","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_23","text":"If a mind switch were to occur, their fear is that the Nikkes will turn their guns away from the Raptures and instead point towards them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_24","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_24","text":"You yourself have seen Nikkes go through memory wipes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_25","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_25","text":"Do you think the NIMPH should be removed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_26","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_26","text":"The decisive factor is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_27","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_17_07_27","text":"Marian's corrosion.","jump":"d_main_17_07_38","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_28","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_17_07_28","text":"Matis's corrosion.","jump":"d_main_17_07_30","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_29","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_29","text":"Marian? You speak of the lady you entrusted to us.","jump":"d_main_17_07_38","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_30","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_30","text":"Matis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_31","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_31","text":"Who is this you speak of so suddenly?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_32","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_32","text":"Do you believe we are familiar with all the women your surround yourself with?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_33","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_33","text":"That's just...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_34","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_34","text":"Allow me to put this plainly. We have no idea who you are referring to, and we do not care.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_35","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_35","text":"Do not think you can persuade us with such execrable anecdotes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_36","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_36","text":"If you want to convince us, you will need to speak more carefully.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_37","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_17_07_37","text":"I need to think about this more carefully.","jump":"d_main_17_07_26","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_38","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_07_38","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_39","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_39","text":"She was defeated by Chatterbox, but if she did not have the NIMPH to begin with, she would have become one of the Heretics.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_40","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_40","text":"Yes. She would have been better off without the NIMPH. There would have been no corrosion and no memory wipe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_41","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_41","text":"That is what you are trying so say, no?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_42","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_42","text":"However,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_43","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_43","text":"Do you think that the NIMPH has only negative effects on Nikkes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_44","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_44","text":"Be it to escape the horrors of the battlefield or debilitating depression,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_45","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_45","text":"there are many Nikkes who voluntarily undergo a memory wipe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_46","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_46","text":"Above all, the very existence of NIMPH grants Nikkes a form of eternal life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_47","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_47","text":"Against this infinity, the horrors of the battlefield do not seem so abominable. It gives them the courage required to take on tough missions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_48","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_48","text":"Don't you think they need the NIMPH?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_49","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_49","text":"It should be their decision to make.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_50","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_50","text":"My oh my. Choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_51","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_51","text":"It doesn't matter if they want to live for all eternity, or only for a finite period of time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_52","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_52","text":"I want to make a world where all Nikkes can decide their own future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_53","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_07_53","text":"And that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_54","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_07_54","text":"that is the reason you wish to use the Vapaus.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_55","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_55","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_56","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_07_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_57","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_57","text":"A world where Nikkes decide their own future...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_58","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_58","text":"A scandalous statement if I ever heard one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_59","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_59","text":"If we were Nikkes belonging to the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_60","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_60","text":"you'd be accused of subversion, and your head would no longer be attached to your shoulders.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_61","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_07_61","text":"Nikkes capable of making their own decisions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_62","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_07_62","text":"Your dream is a long way from reality. In the Ark, stability is found in submission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_63","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_17_07_63","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_64","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_07_64","text":"Nevertheless, your idealism intrigues me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_65","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_07_65","text":"I'm inclined to agree with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_66","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_07_66","text":"Rather than just leaving behind fragments of the past, I want to leave a key to the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_67","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_07_67","text":"Scarlet, Snow White. What do you think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_68","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_68","text":"I agree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_69","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_69","text":"I believe there's no harm in informing them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_70","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_70","text":"Even if we try to keep it a secret,\nit will be revealed one way or the other.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_71","type":"Speech","speaker":"hongryeon","key":"Locale_MainScenario:d_main_17_07_71","text":"The last thing I want is to be an impediment to future progress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_72","type":"Speech","speaker":"rapunzel","key":"Locale_MainScenario:d_main_17_07_72","text":"What about you, Snow White?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_73","type":"Speech","speaker":"snowwhite","key":"Locale_MainScenario:d_main_17_07_73","text":"You two are already in agreement, what do you need me for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_17_07_74","type":"Speech","spea