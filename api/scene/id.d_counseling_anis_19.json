{"id":"d_counseling_anis_19","cat":"counsel","group":{"id":"char3005","label":"Anis"},"label":"Advising Anis: 19","stage":null,"prev":"d_counseling_anis_18","next":"d_counseling_anis_20","speakers":{"anis":"Anis"},"icons":{"anis":"si_c012_00_s"},"lines":[{"id":"d_counseling_anis_19_1","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_1","text":"Do you like dogs?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["anis"],"affinity":"_0"},{"id":"d_counseling_anis_19_2","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_2","text":"A long time ago, I met a dog. It must have liked me since it bounded right up to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_3","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_3","text":"It was the first time I had ever seen that dog, yet it made a beeline straight for me...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_19_4","text":"You must have felt uncomfortable.","jump":"d_counseling_anis_19_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_anis_19_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_anis_19_5","text":"You must have been happy.","jump":"d_counseling_anis_19_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_anis_19_6","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_6","text":"Yes. I didn't really like it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_7","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_7","text":"I knew it didn't mean any harm. It just liked me is all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_8","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_8","text":"But nevertheless, it did make me feel uncomfortable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_9","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_9","text":"I suppose it's just hard to accept such blind affection.","jump":"d_counseling_anis_19_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_10","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_10","text":"Hm... Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_11","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_11","text":"I suppose so, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_12","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_12","text":"It made me question why it was so fond of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_13","type":"Speech","speaker":"anis","key":"Locale_Counseling:d_counseling_anis_19_13","text":"I didn't like how it just threw caution to the wind and ran right over to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_anis_19_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_anis_19_14","text":"Anis and I talk about animals.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}