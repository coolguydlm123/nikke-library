{"id":"msg_m_ex_matis_04","cat":"messenger","group":{"id":"room_matis","label":"Matis · Group"},"label":"5. Ugh. Honestly.","stage":null,"prev":"msg_m_ex_matis_03","next":"msg_m_ex_matis_05","speakers":{"maxwell":"Maxwell","laplace":"Laplace","drake":"Drake"},"icons":{"maxwell":"si_c102_00_s","laplace":"si_c100_00_s","drake":"si_c101_00_s"},"lines":[{"id":"m_ex_matis_04_1","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_1","text":"Ugh. Honestly.","jump":null},{"id":"m_ex_matis_04_2","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_2","text":"I can't even.","jump":null},{"id":"m_ex_matis_04_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_04_3","text":"What's wrong?","jump":null},{"id":"m_ex_matis_04_4","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_4","text":"These two are driving me crazy.","jump":null},{"id":"m_ex_matis_04_5","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_5","text":"Who, exactly?","jump":null},{"id":"m_ex_matis_04_6","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_6","text":"Are you talking about Drake and Birdie?","jump":null},{"id":"m_ex_matis_04_7","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_7","text":"No!","jump":null},{"id":"m_ex_matis_04_8","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_8","text":"She is talking about Laplace and Maxwell.","jump":null},{"id":"m_ex_matis_04_9","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_9","text":"Why would I talk about myself?","jump":null},{"id":"m_ex_matis_04_10","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_04_10","text":"What on earth is going on?","jump":null},{"id":"m_ex_matis_04_11","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_11","text":"Oh,","jump":null},{"id":"m_ex_matis_04_12","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_12","text":"I'm sorry, Cutey.","jump":null},{"id":"m_ex_matis_04_13","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_13","text":"You must be confused.","jump":null},{"id":"m_ex_matis_04_14","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_14","text":"While I converse with these two,","jump":null},{"id":"m_ex_matis_04_15","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_15","text":"I want to hear your opinion.","jump":null},{"id":"m_ex_matis_04_16","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_16","text":"That's basically like you're tattling on us!","jump":null},{"id":"m_ex_matis_04_17","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_17","text":"That's not very heroic of you, Maxwell.","jump":null},{"id":"m_ex_matis_04_18","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_18","text":"What is this?","jump":null},{"id":"m_ex_matis_04_19","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_19","text":"Ratting on someone or talking about them behind their back","jump":null},{"id":"m_ex_matis_04_20","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_20","text":"is despicable!","jump":null},{"id":"m_ex_matis_04_21","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_21","text":"If you have any grievances with us, say it to our face.","jump":null},{"id":"m_ex_matis_04_22","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_22","text":"I'm about to.","jump":null},{"id":"m_ex_matis_04_23","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_23","text":"Oh?","jump":null},{"id":"m_ex_matis_04_24","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_24","text":"Here we go.","jump":null},{"id":"m_ex_matis_04_25","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_25","text":"It's like this, Cutey.","jump":null},{"id":"m_ex_matis_04_26","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_26","text":"All of us share a bedroom together in our dorm,","jump":null},{"id":"m_ex_matis_04_27","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_27","text":"which we do in order to respond quickly should anything come up.","jump":null},{"id":"m_ex_matis_04_28","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_28","text":"But recently, Drake and Laplace","jump":null},{"id":"m_ex_matis_04_29","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_29","text":"have been so noisy while they sleep.","jump":null},{"id":"m_ex_matis_04_30","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_30","text":"!!!","jump":null},{"id":"m_ex_matis_04_31","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_31","text":"!!!","jump":null},{"id":"m_ex_matis_04_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_04_32","text":"How are they noisy, exactly?","jump":null},{"id":"m_ex_matis_04_33","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_33","text":"For one thing,","jump":null},{"id":"m_ex_matis_04_34","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_34","text":"Laplace snores something awful.","jump":null},{"id":"m_ex_matis_04_35","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_35","text":"If I had to write it out, it'd be something like this:","jump":null},{"id":"m_ex_matis_04_36","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_36","text":"Drrrrrkkkkkkuahhh!!!","jump":null},{"id":"m_ex_matis_04_37","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_37","text":"Phewww...","jump":null},{"id":"m_ex_matis_04_38","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_38","text":"Drrrrrkkkkkkuahhh!!!!!!!!","jump":null},{"id":"m_ex_matis_04_39","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_39","text":"Phewwwww...","jump":null},{"id":"m_ex_matis_04_40","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_40","text":"Like that.","jump":null},{"id":"m_ex_matis_04_41","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_41","text":"That was Laplace snoring?","jump":null},{"id":"m_ex_matis_04_42","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_42","text":"I thought that was a construction crew working at night.","jump":null},{"id":"m_ex_matis_04_43","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_43","text":"A hero that snores?","jump":null},{"id":"m_ex_matis_04_44","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_44","text":"Unacceptable!","jump":null},{"id":"m_ex_matis_04_45","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_45","text":"You're no better, Drake.","jump":null},{"id":"m_ex_matis_04_46","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_46","text":"You mean I snore as well?","jump":null},{"id":"m_ex_matis_04_47","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_47","text":"No, but you talk in your sleep.","jump":null},{"id":"m_ex_matis_04_48","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_48","text":"Everyone, hands up!! Make sure to raise your hands while crossing the road!","jump":null},{"id":"m_ex_matis_04_49","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_49","text":"Toss all your coins in this donation box!!","jump":null},{"id":"m_ex_matis_04_50","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_50","text":"Stuff like that.","jump":null},{"id":"m_ex_matis_04_51","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_51","text":"I knew it!","jump":null},{"id":"m_ex_matis_04_52","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_52","text":"You talk like a hero in your sleep.","jump":null},{"id":"m_ex_matis_04_53","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_53","text":"That's all well and good,","jump":null},{"id":"m_ex_matis_04_54","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_54","text":"but all that yelling of hers wakes me up.","jump":null},{"id":"m_ex_matis_04_55","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_matis_04_55","text":"If it's as bad as you make it out to be, it might be a good idea to switch to an individual room.","jump":null},{"id":"m_ex_matis_04_56","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_56","text":"Do you think so?","jump":null},{"id":"m_ex_matis_04_57","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_57","text":"Ha...","jump":null},{"id":"m_ex_matis_04_58","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_58","text":"Well,","jump":null},{"id":"m_ex_matis_04_59","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_59","text":"since it's come to this,","jump":null},{"id":"m_ex_matis_04_60","type":"Speech","speaker":"laplace","key":"Locale_SuddenMessage:m_ex_matis_04_60","text":"I'll have to find out what Maxwell's sleeping habits are as well.","jump":null},{"id":"m_ex_matis_04_61","type":"Speech","speaker":"drake","key":"Locale_SuddenMessage:m_ex_matis_04_61","text":"That's a good idea.","jump":null},{"id":"m_ex_matis_04_62","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_62","text":"I'd like to see you try.","jump":null},{"id":"m_ex_matis_04_63","type":"Speech","speaker":"maxwell","key":"Locale_SuddenMessage:m_ex_matis_04_63","text":"I'm going to apply for an individual room.","jump":null}],"chat":true}