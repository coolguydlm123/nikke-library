ech","speaker":"mihara_b","key":"Locale_Counseling:d_counseling_mihara_bondingchain_08_11","text":"It's just a guess, but I probably kept coming up with excuses to see him more often. Hehe.","jump":"d_counseling_mihara_bondingchain_08_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_bondingchain_08_12","type":"Speech","speaker":"mihara_b","key":"Locale_Counseling:d_counseling_mihara_bondingchain_08_12","text":"Of course, the fact that my life is on the line is plenty stimulating, so I don't have time to rest now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mihara_bondingchain_08_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_mihara_bondingchain_08_13","text":"Mihara lets out a bitter smile as her fingers gently brush the necklace around her neck.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}