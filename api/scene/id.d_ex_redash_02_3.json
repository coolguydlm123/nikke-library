m":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_02_3_76","type":"Speech","speaker":"hongryeon_o","key":"Locale_SuddenStory:d_ex_redash_02_3_76","text":"Dost thou retreat from me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_02_3_77","type":"Speech","speaker":"dorothy","key":"Locale_SuddenStory:d_ex_redash_02_3_77","text":"No, I'm heading back to the base.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_redash_02_3_78","type":"Narration","speaker":"Narration","key":"Locale_SuddenStory:d_ex_redash_02_3_78","text":"Playback ends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}