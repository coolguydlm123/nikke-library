{"id":"d_counseling_grave_05","cat":"counsel","group":{"id":"char5125","label":"Grave"},"label":"Advising Grave: 05","stage":null,"prev":"d_counseling_grave_04","next":"d_counseling_grave_06","speakers":{"grave_p":"Grave","Self":"Commander","Narration":"Narration","Monologue":"Monologue"},"icons":{"grave_p":"si_c514_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_counseling_grave_05_1","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_1","text":"Sometimes, it doesn't feel real that Cinderella has opened her eyes.","jump":null,"exit":false,"enter":null,"bg":"CountryVillage_d","bgArt":"countryvillage_d","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["grave_p"],"affinity":"_0"},{"id":"d_counseling_grave_05_2","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_2","text":"It's as if everything up to now has been a dream,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_3","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_3","text":"and when I wake up, I'll still be carrying her coffin while wandering around the Crystal Region.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_grave_05_4","text":"This is no dream. This is reality.","jump":"d_counseling_grave_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_grave_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_grave_05_5","text":"This is a dream.","jump":"d_counseling_grave_05_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_grave_05_6","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_6","text":"Yes, indeed... Hearing such words does give me reassurance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_7","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_7","text":"But I still have no small amount of anxiety.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_8","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_8","text":"You are completely different from any other human I've known.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_9","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_9","text":"Perhaps that's why sometimes, I feel like you're from a dream.","jump":"d_counseling_grave_05_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_10","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_10","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_11","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_11","text":"I... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_12","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_12","text":"It's as I feared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_13","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_13","text":"Cinderella waking up, humans helping me... It's all a dream.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_14","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_14","text":"Then how do I wake up...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_15","type":"Self","speaker":"Self","key":"Locale_Counseling:d_counseling_grave_05_15","text":"Er... Sorry. I was only kidding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_16","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_16","text":"Is that... so?","jump":"d_counseling_grave_05_17","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_17","type":"Self","speaker":"Self","key":"Locale_Counseling:d_counseling_grave_05_17","text":"If you don't believe me, go ahead and pinch yourself...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_18","type":"Speech","speaker":"grave_p","key":"Locale_Counseling:d_counseling_grave_05_18","text":"Like my cheek?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_grave_05_19","type":"Narration","speaker":"Narration","key":"Locale_Counseling:d_counseling_grave_05_19","text":"*Pinch*","jump":null,"exit":false,"