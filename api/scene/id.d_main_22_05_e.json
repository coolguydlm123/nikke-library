null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_14","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_14","text":"Sakura drops to one knee and takes out her gun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_15","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_15","text":"What are you doing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_16","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_16","text":"We've got ourselves an unwanted guest. This is what they get for crashing our party.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_17","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_17","text":"Are you actually gonna shoot someone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_18","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_18","text":"It's a suppression bullet. Don't worry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_19","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_19","text":"*Bang*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_20","text":"The gunshot rings out amongst the haze of smoke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_21","type":"Speech","speaker":"eh","key":"Locale_MainScenario:d_main_22_05_e_21","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_22","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_22","text":"You got 'em!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_23","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_23","text":"No, I missed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_24","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_24","text":"This smoke... this is no normal smoke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_25","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_25","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_26","text":"Eventually, the smoke inside the casino slowly dissipates.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_27","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_27","text":"Everyone turns frantically towards the center display.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_28","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_28","text":"The glass box has been smashed to pieces. There is nothing inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_29","text":"There is a canister lying on the floor, with tendrils of smoke are coming out of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_30","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_05_e_30","text":"Our prize... it was stolen!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_31","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_05_e_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_32","type":"Speech","speaker":"blanc","key":"Locale_MainScenario:d_main_22_05_e_32","text":"First things first, let's confirm if anyone's been injured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_33","type":"Speech","speaker":"noir","key":"Locale_MainScenario:d_main_22_05_e_33","text":"Y-yes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_22_05_e_34","text":"Blanc and Noir rush inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_35","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_35","text":"I thought they'd move as a group. Never figured they'd use a solo operator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_36","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_36","text":"My body is going numb. There must be Alva particles mixed in with the smoke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_37","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_37","text":"It looks like the plan was made with us in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_38","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_38","text":"This is all your fault. You've been way out of line lately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_39","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_39","text":"You basically advertised our presence to anyone and everyone who cared to know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_40","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_40","text":"Shut up. This is how I work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_41","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_41","text":"The necklace was stolen. Should be easy to pawn for cash.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_42","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_42","text":"How's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_43","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_43","text":"Jewels are a dime a dozen on the Dark Net. Tracking a specific gemstone would be next to impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_44","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_44","text":"But not entirely impossible, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_45","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_46","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_46","text":"That's the first sensible thing you've said in ages.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_47","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_47","text":"I'll search the Dark Net. Even if they attempt to offload the jewels in pieces, we should be able to pick up the trail due to the sheer volume.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_48","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_48","text":"Then I'll go out to the Outer Rim and pound some answers out of people. I'm sure I'll turn up something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_49","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_49","text":"Hey. You got anything for me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_50","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_50","text":"I don't know exactly what's going on, but it sounds serious. I want to help.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_51","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_51","text":"All right, you head to the Ark and gather information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_52","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_52","text":"What kind of information?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_53","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_53","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_54","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_54","text":"Heavenly Ascension is orchestrating a large-scale terrorist attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_55","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_55","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_56","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_56","text":"We received some intel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_57","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_57","text":"I hear Heavenly Ascension is gathering materials to be used for an attack, with Coin Rush as the primary target.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_58","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_58","text":"Rosanna and I put on that little charade to stall them and prevent it from happening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_59","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_59","text":"If that's what you were doing, why didn't you let Blanc and Noir know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_60","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_60","text":"Don't be dense. What do you think they would have done if I told them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_61","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_61","text":"They would have reported it straight to the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_62","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_63","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_63","text":"Planning an attack on the Ark is a crime punishable by death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_64","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_64","text":"They'd be willing to burn the Outer Rim to the ground if it meant getting rid of Heavenly Ascension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_65","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_65","text":"There would be countless innocent victims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_66","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_66","text":"So you two came up with that entire act on your own?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_67","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_67","text":"Our actions needed to be perceived as a criminal organization operating out of greed and not someone attempting to thwart terrorist activities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_68","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_68","text":"Why didn't you tell me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_69","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_69","text":"Not to brag, but it's not unheard of for the Peony Association to offer free protection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_70","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_70","text":"You simply don't have enough people for the same offer to seem feasible. For every one member you have, we have 30.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_71","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_71","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_72","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_72","text":"How can I trust you with such an important task, when I had no idea how many agents Heavenly Ascension would send?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_73","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_73","text":"... Although we certainly didn't expect them to send just one person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_74","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_74","text":"Still, we could have acted together!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_75","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_75","text":"You've got spunk, and I admire that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_76","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_76","text":"But it won't be enough for the type of task we're dealing with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_77","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_77","text":"... Wait.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_78","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_78","text":"D-did my coming here ruin everything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_79","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_79","text":"That remains to be seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_80","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_80","text":"As of now, you haven't ruined anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_81","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_81","text":"We have to put a stop to their terrorist plot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_82","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_82","text":"Make it seem like it never existed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_83","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_83","text":"That way, no one gets hurt.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_84","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_84","text":"... Got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_85","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_85","text":"So you need me to scour the Dark Net, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_86","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:d_main_22_05_e_86","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_87","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:d_main_22_05_e_87","text":"Outer Rim for me. Sakura has the Dark Net. You, go to the Ark. Idiot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_22_05_e_88","type":"Speech","speaker":"moran","key":"Locale_MainScenario:d_main_22_05_e_88","text":"O-okay. Got it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"mo