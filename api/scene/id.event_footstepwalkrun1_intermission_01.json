{"id":"event_footstepwalkrun1_intermission_01","cat":"event","group":{"id":"ev40066","label":"FOOTSTEP, WALK, RUN · Part 1"},"label":"A Curious Story","stage":null,"prev":"event_footstepwalkrun1_03_e","next":"event_footstepwalkrun1_04_s","speakers":{"seira":"Seira","squadleader":"Squad Leader","rapi_m":"Rapi"},"icons":{"seira":"si_c251_00_s","squadleader":"si_c303_00_s","rapi_m":"si_c994_00_s"},"lines":[{"id":"event_footstepwalkrun1_intermission_01_1","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_1","text":"I propose a toast!","jump":null,"exit":false,"enter":null,"bg":"Bar","bgArt":"bar","image":null,"bgm":"bgm_inark","movie":null,"shown":["rapi_m","seira","squadleader"],"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_2","type":"Speech","speaker":"squadleader","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_2","text":"I don't have the energy to make any speeches. Let's just drink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_3","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_3","text":"Aw, c'mon! We all made it out alive, didn't we? That's more than we could have hoped for, so we oughta celebrate!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_4","type":"Speech","speaker":"squadleader","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_4","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_5","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_5","text":"Don't people usually get killed when they go to the surface? We all made it out unscathed, so that calls for a toast if you ask me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_6","type":"Speech","speaker":"squadleader","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_6","text":"Fine. Do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_7","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_7","text":"The squad 09-10F sits around the table with cheap drinks and snacks, chattering noisily amongst themselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_8","text":"The atmosphere is a celebratory one in light of their mission being a success.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_9","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_9","text":"In the midst of the commotion, Rapi quietly sips her drink without saying a word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_10","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_11","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_11","text":"This tastes strange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_12","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_12","text":"Rapi!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_13","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_13","text":"You were a real crackshot out there. You looked like those illustrations they've got in the instruction manuals, pew pew pew!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_14","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_14","text":"Were you some kind of assassin when you were human? Hahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_15","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_15","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_16","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_16","text":"Then how come you're so good at shooting?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_17","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_17","text":"I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_18","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_18","text":"Right, right. I guess it's possible you're just a natural.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_19","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_19","text":"What did you do when you were human, anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_20","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_20","text":"What do you mean by that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_21","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_21","text":"You know, what were your hobbies? Dreams? Aspirations? Stuff like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_22","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_22","text":"I didn't have anything. Nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_23","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_24","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_24","text":"No hobbies?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_25","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_25","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_26","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_26","text":"No favorite food?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_27","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_27","text":"None.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_28","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_28","text":"No turn ons or turn offs?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_29","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_29","text":"Negative.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_30","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_31","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_31","text":"I see what's happening here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_32","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_32","text":"You're the type who builds up walls and doesn't warm up easily to people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_33","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_33","text":"Well, you better brace yourself, 'cause you'll find I don't give up easily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_34","text":"*Bang*!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_35","text":"Seira suddenly slumps forward, her head slamming onto the table as she falls asleep.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_36","type":"Speech","speaker":"squadleader","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_36","text":"Wow. That's my first time seeing someone pass out after drinking half a cup of booze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_37","type":"Speech","speaker":"squadleader","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_37","text":"One of you barely makes a sound, and the other makes such a racket I could tear my hair out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_38","type":"Speech","speaker":"squadleader","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_38","text":"Talk about a real pair of oddballs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_39","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_39","text":"Rapi, what's your favorite color?","jump":null,"exit":false,"enter":null,"bg":"Desert_01","bgArt":"desert_01","image":null,"bgm":null,"movie":null,"shown":["seira"],"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_40","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_40","text":"I don't have one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_41","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_41","text":"Hmm... Then how about red? I think it suits you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_42","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_42","text":"If you say so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_43","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_43","text":"Rapi, do you have any aspirations or anything like that?","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_44","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_44","text":"I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_45","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_45","text":"Well, as for me, I'd like to...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_46","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_46","text":"... Actually, I'm not going to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_47","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_47","text":"Until you give me an answer, I won't tell you anything about me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_48","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_48","text":"If you want to hear my story, then you've gotta give me a proper answer. Got it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_49","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_49","text":"I'm tellin' you, you better bust out the tissues, 'cause my story is a real tearjerker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_50","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_50","text":"Dang, that was tough.","jump":null,"exit":false,"enter":null,"bg":"Storage","bgArt":"storage","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_51","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_51","text":"Did you ever travel around when you were a human?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_52","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_52","text":"No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_53","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_53","text":"Is there anywhere you want to go?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_54","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_54","text":"Not sure. I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_55","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_55","text":"Come on, you're telling me there isn't a single place you're interested in going?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_56","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_56","text":"I don't know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_57","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_58","type":"Speech","speaker":"seira","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_01_58","text":"Hey. Rapi.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02","bgArt":"wasteland_02","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun1_intermission_01_59","type":"Speech","speaker":"rapi_m","key":"Locale_MainScenario:event_footstepwalkrun1_intermission_0