{"id":"d_nikke_kilo_03","cat":"bond","group":{"id":"char5053","label":"Kilo"},"label":"Straight Down the Middle","stage":null,"prev":"d_nikke_kilo_02","next":"d_nikke_kilo_04","speakers":{"Narration":"Narration","kilo":"Kilo","rapi":"Rapi","Self":"Commander","talos":"T.A.L.O.S.","anis":"Anis","neon":"Neon"},"icons":{"Narration":"si_c999_00_s","kilo":"si_c977_00_s","rapi":"si_c010_00_s","talos":"si_c361_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_nikke_kilo_03_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_03_1","text":"Elysion Headquarters. 12th Tactical Training Ground.","jump":null,"exit":false,"enter":null,"bg":"Desert_01","bgArt":"desert_01","image":null,"bgm":"bgm_inark","movie":null,"shown":["rapi","anis","neon","kilo","talos"],"affinity":null},{"id":"d_nikke_kilo_03_2","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_2","text":"Wow, this place is massive!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_3","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_3","text":"It looks just like it does up on the surface, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_4","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_4","text":"After all, Elysion is a company that values practical combat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_5","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_5","text":"That was my first time meeting Miss Ingrid in person... is she really okay with all this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_6","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_6","text":"She just kept repeating \"manned weapon\" and \"tactical\" over and over...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_7","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_7","text":"It's fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_8","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_03_8","text":"That's how she is all the time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_9","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_9","text":"Oh... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_10","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_03_10","text":"All right Rapi, I'll leave the explanations to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_11","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_11","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_12","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_12","text":"We're going to assess you in your combat, search & rescue, production, and repair abilities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_13","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_13","text":"You'll be assigned a score for each segment, which is graded according to Elysion's standards.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_14","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_14","text":"That will give us a better idea of which areas we need to work on, after which we'll re-run those tests.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_15","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_15","text":"Looking at that second round of results should help us figure out which specific area you excel in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_16","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_16","text":"So I'll finally know what I'm good at!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_17","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_17","text":"That's the idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_18","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_18","text":"Got it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_19","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_19","text":"All right, let's begin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_20","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_03_20","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_21","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_21","text":"That concludes the combat test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_22","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_22","text":"What was my score?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_23","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_23","text":"Your specific scores will be provided once you've completed all the tests.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_24","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_24","text":"As for areas which could be improved,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_25","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_25","text":"I recommend you utilize a wider array of weapons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_26","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_26","text":"I also suggest using standardized ammunition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_27","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_27","text":"Does T.A.L.O.S. only have one weapon?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_28","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_28","text":"Uh... yes. For now, it's just a machine gun attached to the arm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_29","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_03_29","text":"Correction. I am also equipped with 2 frontal Vulcans and a hydraulic fist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_30","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_30","text":"Oh, well sure, but we don't ever really use those.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_31","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_31","text":"Why not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_32","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_32","text":"Uh... I guess since they're kind of weak? And can only be used at close range.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_33","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_33","text":"... Okay. What do you use as ammunition?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_34","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_34","text":"We produce specialized ammunition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_35","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_35","text":"If we ran out of ammo while out on a mission, we'd be in a world of trouble,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_36","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_36","text":"so we only use ammunition that we manufacture ourselves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_37","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_37","text":"What materials do you use?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_38","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_38","text":"Reinforced plastic, gunpowder, and...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_39","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_39","text":"Okay. That's all I need to hear.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_40","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_40","text":"Let's move on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_41","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_03_41","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_01_n","bgArt":"wasteland_01_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_42","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_42","text":"That does it for the search test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_43","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_43","text":"You should increase your detection range and simplify your target selection.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_44","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_44","text":"Right now, your detection range is quite narrow, and you're being a bit broad with your target criteria.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_45","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_45","text":"You think so? I can track around 50 different categories of targets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_46","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_46","text":"Why would you ever cast a net that wide?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_47","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_47","text":"I dunno... you never know what will happen during a mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_48","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_48","text":"You might find yourself in need of some wood or plastic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_49","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_49","text":"... Fine. Next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_50","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_03_50","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_51","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_51","text":"That concludes the rest of the tests.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_52","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_52","text":"As far as your ability to conduct a rescue operation is concerned, you're outfitted with a variety of tools: tubes, parachutes, and ropes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_53","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_53","text":"Yep! That's so we can handle rescue missions on land, sea, and air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_54","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_54","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_55","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_03_55","text":"In terms of production, you're equipped with a 3D printer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_56","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_56","text":"You never know what you might need to manufacture!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_57","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_57","text":"With this handy printer, we can make all sorts of small objects that you might not have thought to bring,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_58","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_58","text":"but turn out to be of vital importance later on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_59","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_03_59","text":"We also use it to make specialized ammunition.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_03_60","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_ni