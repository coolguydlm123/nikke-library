{"id":"event_arkranger2_01_s","cat":"event","group":{"id":"ev40113","label":"ARK RANGER · Part 2"},"label":"Heroes Needed: A","stage":null,"prev":null,"next":"event_arkranger2_01_e","speakers":{"moran_d_f":"Moran","director":"Director","moran_d":"Moran","blue":"Ark Ranger Blue","red":"Ark Ranger Red","black":"Ark Ranger Black"},"icons":{"moran_d_f":"si_c281_00_s","director":"si_c999_00_s","moran_d":"si_c281_02_s","blue":"si_c572_00_s","red":"si_c571_00_s","black":"si_c570_00_s"},"lines":[{"id":"event_arkranger2_01_s_1","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_1","text":"Hehehe...","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":"bgm_story_darklord","movie":null,"shown":["moran_d_f"],"affinity":null},{"id":"event_arkranger2_01_s_2","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_2","text":"Foolish Ark Rangers. You should know better than anyone that further resistance is futile.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_3","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_3","text":"But since you insist, I suppose I could play this little game with you until the end. If nothing else, it'll be entertaining.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_4","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_4","text":"So go on, struggle as much as you like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_5","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_5","text":"Watching you suffer has become my favorite pastime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_6","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_6","text":"Haha... hahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_7","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_7","text":"The time is near.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_8","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_8","text":"Soon the Ark shall be in my hands, and all will bow before Darkflower, the Shadow Empress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_9","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_9","text":"It makes me giddy just thinking about it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_10","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_10","text":"Mwahaha... *cough, cough*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_11","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_11","text":"Cut, cut, cut!","jump":null,"exit":false,"enter":null,"bg":"ArkRangerOffice","bgArt":"arkrangeroffice","image":null,"bgm":"none","movie":null,"shown":["moran_d"],"affinity":null},{"id":"event_arkranger2_01_s_12","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_12","text":"You were doing so well, and then you just started coughing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tuffguys","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_13","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_13","text":"Agh, sorry. I'm not used to doing such a high-pitched laugh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_14","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_14","text":"No worries, no worries. You're doing great.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_15","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_15","text":"Wanna go again? Let's get one more take of just the final laugh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["moran_d_f"],"affinity":null},{"id":"event_arkranger2_01_s_16","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_16","text":"Sure! Here goes!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_17","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_17","text":"Mwahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_18","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_18","text":"Whoa, there. I love the enthusiasm, but let's wait for the cameras to start rolling, yeah? Haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["moran_d"],"affinity":null},{"id":"event_arkranger2_01_s_19","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_19","text":"Oh, sorry...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_20","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_20","text":"You're good, you're good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_21","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_21","text":"All right. Ready... action!","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":["moran_d_f"],"affinity":null},{"id":"event_arkranger2_01_s_22","type":"Speech","speaker":"moran_d_f","key":"Locale_MainScenario:event_arkranger2_01_s_22","text":"Mwahahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_23","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_23","text":"Cut! Nice!","jump":null,"exit":false,"enter":null,"bg":"ArkRangerOffice","bgArt":"arkrangeroffice","image":null,"bgm":null,"movie":null,"shown":["moran_d"],"affinity":null},{"id":"event_arkranger2_01_s_24","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_24","text":"Oh, that was good?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_25","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_25","text":"It sure was. Nice work. We're gonna take a breather and then start with the next scene.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_26","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_26","text":"All right, everyone! Moving on to the next scene! Let's get ready!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_27","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_27","text":"It's gonna take a while to set up the shot, so feel free to head to the break room if you want, Moran.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_28","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_28","text":"Sure. See you in a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_29","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger2_01_s_29","text":"*Swing*","jump":null,"exit":false,"enter":null,"bg":"TtstarWatingRoom","bgArt":"ttstarwatingroom","image":null,"bgm":null,"movie":null,"shown":["red","blue","black"],"affinity":null},{"id":"event_arkranger2_01_s_30","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_30","text":"Phew...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_31","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_31","text":"Hey there, Darkflower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_32","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_32","text":"You done?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_33","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_33","text":"Yeah. I never knew laughing could be so hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_34","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_34","text":"You're doing good, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_35","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_35","text":"Agreed. Here, come have a seat.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_36","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_36","text":"Oh, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_37","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_37","text":"I've been meaning to ask you, how did you manage to land this role?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_38","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_38","text":"The competition must've been insane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_39","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_39","text":"You didn't threaten your way in, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_40","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_40","text":"As a member of Underworld Queen, you probably could've just walked in, cracked your knuckles, and...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_41","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_41","text":"That's not what happened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_42","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_42","text":"Hmm... I don't know if I can say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_43","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_43","text":"If it's not something you can talk about, you don't have to tell us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_44","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_44","text":"That being said, I do think it'd be better if we cleared the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_45","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_45","text":"It's always good to know about the people you work with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_46","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_46","text":"So are you saying she should tell us, or she shouldn't?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_47","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_47","text":"Give the girl a break. If you keep grilling her like that, you're gonna get a beating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_48","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_48","text":"If that does happen, you'll be the first to get one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_49","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_49","text":"Whoa, scary.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_50","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_50","text":"Anyway...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_51","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_51","text":"Mustang's the one who forced me into this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_52","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_52","text":"Mustang? That's a surprise. He doesn't usually stuff like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_53","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_53","text":"She probably threatened him with a beating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_54","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_54","text":"I didn't, and stop talking about beatings unless you really want one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_55","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_55","text":"Do you all remember when those crystals started popping up around the Ark a little while back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_56","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_56","text":"I got tangled up with the person behind the whole thing and ended up taking a lot of the blame.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_57","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_57","text":"I cleared my name, but there are still a bunch of people who don't believe me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_58","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_58","text":"So in order to improve my image, I got cast as the villain in the Ark Rangers movie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_59","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_59","text":"I see. Then it's damage control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_60","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_60","text":"Hm... I guess you could say that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_61","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_61","text":"It's a little weird, though, isn't it? People in those situations usually do volunteer work or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_62","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_62","text":"This is just how Mustang handles things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_63","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_63","text":"At least he didn't make me do a swimsuit photo shoot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_64","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_64","text":"Huh...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_65","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_65","text":"At any rate, that's how I ended up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_66","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_66","text":"... But I don't really know if I'm doing a good job. What do you all think?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_67","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_67","text":"Your acting isn't bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_68","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_68","text":"Really? I tried to imagine myself as Rosanna while doing it. Maybe I've got more talent than I thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_69","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_69","text":"Darkflower is the kind of villain who isn't particularly bright, but she doesn't realize it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_70","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_70","text":"She's also petty, which is where you see her humanity. It makes her a good character.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_71","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_71","text":"It's a challenging role, but when you play it, it's like you're her. You've got talent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_72","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_72","text":"That's... a compliment, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_73","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_73","text":"For sure. Huge compliment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_74","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_74","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_75","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_75","text":"You know, I figured it'd be rude to show up without knowing about the show, so I watched the entire Ark Rangers series beforehand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_76","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_76","text":"It's really good. I get why people like it so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_77","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_77","text":"Now that I'm in it, I'll do my best not to mess it up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_78","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_78","text":"Sounds good. Can't wait to see what you do with the role.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_79","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_79","text":"I'm looking forward to working with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_80","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_80","text":"Me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_81","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_81","text":"By the way, Ark Ranger Black is a lion, Red is a bull, and Blue is a hawk, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_82","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_82","text":"Why not go with dinosaurs instead of run-of-the-mill animals? They're way stronger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_83","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_83","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_84","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_84","text":"Run-of-the-mill... animals...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_85","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_85","text":"Who says dinosaurs are stronger?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_86","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_86","text":"Who doesn't? Just look at them. They're way bigger, for one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_tepidappleade","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_87","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_87","text":"And they breathe fire too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_88","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_88","text":"... Where did you read that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_89","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_89","text":"Listen, Moran. Nothing beats the bull. One hit with those horns sends anything flying, dinosaur or otherwise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_90","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_90","text":"And the hawk can attack from the air without getting attacked. No animal on the ground stands a chance against something it can't hit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_91","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_91","text":"What are you talking about? Dinosaurs use lightning too. You think being in the air makes you safe?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_92","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_92","text":"Again, where in the world are you getting this information?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_93","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_93","text":"Argh, this is so frustrating.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_94","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_94","text":"You're telling me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_95","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_95","text":"Enough. This argument is pointless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_96","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_96","text":"We all know that the lion is the strongest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_97","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_97","text":"If you're gonna mediate, don't pick a side!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_98","type":"Speech","speaker":"director","key":"Locale_MainScenario:event_arkranger2_01_s_98","text":"Ark Rangers! Darkflower! We're ready to start shooting!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_99","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_99","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_100","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger2_01_s_100","text":"Tch... You got off lucky this time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_101","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger2_01_s_101","text":"We'll settle this later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_102","type":"Speech","speaker":"moran_d","key":"Locale_MainScenario:event_arkranger2_01_s_102","text":"Hmph. I'm looking forward to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger2_01_s_103","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger2_01_s_103","text":"Or... how about we just drop it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}