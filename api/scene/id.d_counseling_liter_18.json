{"id":"d_counseling_liter_18","cat":"counsel","group":{"id":"char5011","label":"Liter"},"label":"Advising Liter: 18","stage":null,"prev":"d_counseling_liter_17","next":"d_counseling_liter_19","speakers":{"liter":"Liter"},"icons":{"liter":"si_c082_00_s"},"lines":[{"id":"d_counseling_liter_18_1","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_1","text":"You can tell a lot about a person by how they clean. I get a big kick out of it.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["liter"],"affinity":"_0"},{"id":"d_counseling_liter_18_2","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_2","text":"Rapi, to be honest, is kinda boring. She doesn't spill anything, and never makes a mess.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_3","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_3","text":"If I see gunpowder residue everywhere, I know Neon is the culprit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_4","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_4","text":"And for Anis...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_18_5","text":"Soda cans lying everywhere?","jump":"d_counseling_liter_18_7","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_liter_18_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_liter_18_6","text":"Socks all strewn about?","jump":"d_counseling_liter_18_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_liter_18_7","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_7","text":"Precisely. I think she has soda instead of blood pumping through her veins.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_8","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_8","text":"She's always tossing the cans on the floor when she's done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_9","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_9","text":"At least put them all in one spot! Everywhere I go, I'm stepping on cans!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_10","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_10","text":"If I see one more can, I'm gonna lose it!","jump":"d_counseling_liter_18_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_11","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_11","text":"Yes! Why on earth does she take off her socks wherever she goes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_12","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_12","text":"Just how many pairs of socks does she have, anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_13","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_13","text":"You'd think she just wears them once and then buys another pair later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_14","type":"Speech","speaker":"liter","key":"Locale_Counseling:d_counseling_liter_18_14","text":"Wait... I think that may be actually what's happening! That's it! I'm gonna go talk to her!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_liter_18_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_liter_18_15","text":"Liter and I look for Anis.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}