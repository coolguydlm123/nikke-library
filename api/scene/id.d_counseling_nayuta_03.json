{"id":"d_counseling_nayuta_03","cat":"counsel","group":{"id":"char5155","label":"Nayuta"},"label":"Advising Nayuta: 03","stage":null,"prev":"d_counseling_nayuta_02","next":"d_counseling_nayuta_04","speakers":{"nayuta":"Nayuta"},"icons":{"nayuta":"si_c223_00_s"},"lines":[{"id":"d_counseling_nayuta_03_1","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_1","text":"I have cast mine eyes upon a few portraits of thee from Persinette,","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"bgm_story_halo","movie":null,"shown":["nayuta"],"affinity":"_0"},{"id":"d_counseling_nayuta_03_2","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_2","text":"yet I find thee far more comely in person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_03_3","text":"... What was I doing in the photo?","jump":"d_counseling_nayuta_03_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_nayuta_03_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_03_4","text":"So... what did you think of that risqué painting?","jump":"d_counseling_nayuta_03_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_nayuta_03_5","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_5","text":"Pray, tarry a moment whilst I do strive to call it to mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_6","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_6","text":"Verily...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_7","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_7","text":"the greater part of the portraits did portray thee in a state most unguarded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_8","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_8","text":"Yet one remaineth most impress'd upon my memory:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_9","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_9","text":"a visage of thee in slumber, filling the frame entire.","jump":"d_counseling_nayuta_03_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_10","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_10","text":"'Twas, verily, a painting of the licentious kind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_11","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_11","text":"Art thou curious what posture it didst depict?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_12","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_12","text":"If so,","jump":"d_counseling_nayuta_03_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_13","type":"Speech","speaker":"nayuta","key":"Locale_Counseling:d_counseling_nayuta_03_13","text":"then perchance, upon thy next encounter with Persinette, thou shouldst entreat her to grant thee a viewing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_nayuta_03_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_nayuta_03_14","text":"I make up my mind never to ask her to show me.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}