{"id":"d_counseling_snowcrane_17","cat":"counsel","group":{"id":"char5168","label":"Snow Crane"},"label":"Advising Snow Crane: 17","stage":null,"prev":"d_counseling_snowcrane_16","next":"d_counseling_snowcrane_18","speakers":{"snowcrane":"Snow Crane"},"icons":{"snowcrane":"si_c620_00_s"},"lines":[{"id":"d_counseling_snowcrane_17_1","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_1","text":"Promises are important,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["snowcrane"],"affinity":"_0"},{"id":"d_counseling_snowcrane_17_2","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_2","text":"so you should always keep them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_17_3","text":"Yeah, you've got to do your best to keep them, no matter what.","jump":"d_counseling_snowcrane_17_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_snowcrane_17_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_17_4","text":"But sometimes, things happen, and you just can't, right?","jump":"d_counseling_snowcrane_17_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_snowcrane_17_5","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_5","text":"You're absolutely right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_6","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_6","text":"You never know what might happen in life, but once you allow even one exception, it never really stops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_7","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_7","text":"So we have to do everything we can to keep our promises.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_8","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_8","text":"That's how important they are.","jump":"d_counseling_snowcrane_17_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_9","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_9","text":"I understand what you're trying to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_10","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_10","text":"You never know what might happen in life, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_11","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_11","text":"But... I think that once you start allowing exceptions, it becomes easier to lose your resolve to keep your promises.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_12","type":"Speech","speaker":"snowcrane","key":"Locale_Counseling:d_counseling_snowcrane_17_12","text":"So I believe we should always do our very best to keep them.","jump":"d_counseling_snowcrane_17_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_snowcrane_17_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_snowcrane_17_13","text":"I talk with Snow Crane about the importance of promises.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}