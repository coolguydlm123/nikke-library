ll},{"id":"d_nikke_cinderella_02_12","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_12","text":"As for the ingredients...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_13","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_13","text":"I think onions, potatoes, and some soup powder should do the trick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_14","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_14","text":"Wait a minute.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_15","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_15","text":"Those sound like ingredients you have to procure from up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_16","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_16","text":"Yes, and?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_17","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_17","text":"Ingredients from the surface are at a premium here in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_18","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_18","text":"Instead, most food is processed from Splendamin.","jump":nul