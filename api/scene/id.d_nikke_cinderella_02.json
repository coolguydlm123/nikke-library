lla_02_32","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_32","text":"I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_33","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_33","text":"I thought my taste buds had been affected due to my slumber.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_34","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_34","text":"I guess not.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_35","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_35","text":"It's simply that Splendamin is revolting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_36","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_36","text":"Hey, it's not so bad!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_37","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_37","text":"Yeah, I think it's delicious!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_cinderella_02_38","type":"Speech","speaker":"cinderella","key":"Locale_NikkeEpisode:d_nikke_cinderella_02_38","text":"This \"Splendamin\" is a universal substitute meant to feed humanity, yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm