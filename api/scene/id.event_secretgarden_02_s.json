_s_19","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_02_s_19","text":"That's why we have to protect these important species, so they don't die out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_02_s_20","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_02_s_20","text":"Only by doing that can we guarantee a better future for them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_02_s_21","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_02_s_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_02_s_22","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_02_s_22","text":"Er... I didn't say anything bad, did I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_02_s_23","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_02_s_23","text":"No, not at all. I was only thinking about how much you and I have in common.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_02_s_24","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_02_s_24","text":"Hehe, really? I think so too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_02_s_25","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_02_s_25","text":"I'm sure that our dreams will come t