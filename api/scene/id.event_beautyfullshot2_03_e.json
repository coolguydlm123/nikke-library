{"id":"event_beautyfullshot2_03_e","cat":"event","group":{"id":"ev40052","label":"BEAUTY FULL SHOT · Part 2"},"label":"Something Dark and Something Black: B","stage":null,"prev":"event_beautyfullshot2_03_s","next":"event_beautyfullshot2_intermission","speakers":{"viper":"Viper","rosanna_s":"Rosanna","viper_s":"Viper","jackal":"Jackal"},"icons":{"viper":"si_c112_00_s","rosanna_s":"si_c283_00_s","viper_s":"si_c112_02_s","jackal":"si_c111_00_s"},"lines":[{"id":"event_beautyfullshot2_03_e_1","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_1","text":"Exotic. The squad I'm associated with. The rank I was given in the world of the Ark.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_recognition_underworld","movie":null,"shown":["viper"],"affinity":null},{"id":"event_beautyfullshot2_03_e_2","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_2","text":"What I do is simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_3","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_3","text":"I reside in the Outer Rim, the garbage dump where the Ark tosses all of its refuse. There, I gather all sorts of information and report it back to the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_4","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_4","text":"I do this to ensure nothing poses a threat to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_5","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_5","text":"I also conduct myself accordingly so that the Outer Rim doesn't collapse upon itself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_6","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_6","text":"The Ark needs a garbage bin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_7","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_7","text":"The Outer Rim is a filthy collection of dim and dingy alleyways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_8","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_8","text":"I wander through these veritable gutters, trafficking information.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_9","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_9","text":"Honesty and kindness have no place in my line of work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_10","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_10","text":"In this cesspool, people will stab you in your back for their own benefit without a moment's hesitation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_11","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_11","text":"I've done what I've had to do to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_12","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_12","text":"This was the lot in life which was assigned to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_13","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_13","text":"I've deceived.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_14","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_14","text":"I've spread rumors. I've betrayed others.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_15","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_15","text":"And I survived,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_16","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_16","text":"until one day,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_17","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_17","text":"people started calling me Viper.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["sakura","rosanna","moran"],"affinity":null},{"id":"event_beautyfullshot2_03_e_18","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_18","text":"Underworld Queen came to the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_19","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_19","text":"They keep the unseemly elements in check. They're a dark force feared by all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_20","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_20","text":"But to me, they were resplendent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_21","type":"Speech","speaker":"viper","key":"Locale_MainScenario:event_beautyfullshot2_03_e_21","text":"However, my admiration quickly turned into jealousy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_beautyfullshot2_03_e_22","text":"Rosanna has Viper pinned to the ground.","jump":null,"exit":false,"enter":null,"bg":"EventScene_BeautyFullShot_03","bgArt":"eventscene_beautyfullshot_03","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_23","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_23","text":"I knew it. It's obvious what you do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_floraltribute","movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_24","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_24","text":"Who do you think you are, turning your nose up at me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_25","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_25","text":"What's the difference between you and me, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_26","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_26","text":"We've both gotten our hands plenty dirty,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_27","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_27","text":"so why did you get out while I'm still down there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_28","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_28","text":"Because you chose to live the way you have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_29","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_29","text":"Don't say it was to survive. I've heard that pathetic excuse too many times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_30","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_30","text":"Anyone who managed to claw their way out of that hellhole would froth at the mouth if they heard you spew that line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_31","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_31","text":"What am I supposed to do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_32","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_32","text":"Do you see this choker on my neck?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_33","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_33","text":"Do you even know what this does?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_34","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_34","text":"It's a shackle put on me by the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_35","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_35","text":"They give me impossible tasks, and if I don't do them, it will explode.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_36","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_36","text":"Does that sound like I have a choice in the matter?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_37","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_37","text":"If it were me, I would cut it and die on my own terms.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_38","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_38","text":"That's easier said than done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_39","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_39","text":"You've never been thrown into a situation like this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_40","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_40","text":"that's why you can stand there and put on your holier-than-thou act.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_41","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_41","text":"You've had everything handed to you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_42","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_42","text":"Haha, I have everything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_43","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_43","text":"Do you think all that I have was given to me at birth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_44","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_44","text":"At least you weren't thrown into the gutter with nothing like I was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_45","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_45","text":"It's not fair.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_46","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_46","text":"You think this is the life I wanted?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_47","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_47","text":"I never wanted to end up like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_48","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_48","text":"The Ark is the only reason I've sunk this low.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_49","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_50","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_50","text":"Argh, I can't stand it!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_51","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_51","text":"Sometimes I just wish the Ark would disappear. Then everyone would be equal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_52","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_52","text":"That's a dangerous thing to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_53","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_53","text":"Do you like the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_54","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_54","text":"You must.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_55","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_55","text":"You get to sip on nice wine, order your underlings around, and wear nice clothes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_56","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_56","text":"You can have anything you want.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_57","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_57","text":"Learning how to drive a boat, surfing... Those things are so far removed from my reality that it's not even funny.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_58","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_58","text":"You can freely switch to a body for swimming as long as you wish. If you wanted, you could enjoy every single thing the Ark has to offer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_59","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_59","text":"As for me? All I have is this old broken-down brick of a phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_60","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_60","text":"All I can do is skim through outdated magazines and pretend that I know something, anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_61","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_61","text":"Oh, give it a rest. You made your bed,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_62","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_62","text":"but what have you done to get out of it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_63","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_63","text":"If you ask me, nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_64","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_64","text":"Let me ask you something. Why did you come here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_65","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_65","text":"Why are you so obsessed with taking photos?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_66","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_66","text":"Are you planning on selling them off somewhere?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_67","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_67","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_68","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_68","text":"You strike me as the kind of person who would do that thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_69","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_69","text":"As for why I think that, you only have yourself to blame.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_70","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_70","text":"I believe you had plenty of opportunities to get out, but you never took them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_71","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_71","text":"So what if there were?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_72","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_72","text":"I'm too busy trying to keep myself alive. I don't have time to dream of better things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_73","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_73","text":"Whereas you have nothing but time. You have so many opportunities and so much power.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_74","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_74","text":"You think you've resigned yourself to living in the darkness?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_75","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_75","text":"Fine, then let me tell you what I see in you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_76","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_76","text":"You shine so bright. Too bright. I can't stand it. I want it all to come crashing down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_77","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_77","text":"Why can't I have that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_78","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_78","text":"Answer me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_79","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_79","text":"Why do you have everything, while I have nothing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_80","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_80","text":"What's so different between you and me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_81","type":"Speech","speaker":"rosanna_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_81","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_82","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_82","text":"If one small thing, one tiny event, had transpired differently, I would have been where you're standing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_83","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_83","text":"You've got the nerve to call me tenacious?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_84","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_84","text":"You, of all people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_85","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_85","text":"Why do I desire something when it's not even mine?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot2_03_e_86","type":"Speech","speaker":"viper_s","key":"Locale_MainScenario:event_beautyfullshot2_03_e_86","text":"It's because I don't have anything!","jump":null,"exit":false,"enter":null,"bg":null