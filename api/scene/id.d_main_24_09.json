ll,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_20","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_24_09_20","text":"Don't even think about wiping your own memory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_21","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_24_09_21","text":"If any self-destruct signal is detected, the NIMPH will forcibly—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_22","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_09_22","text":"Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_23","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_09_23","text":"You don't need to worry about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_24","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_09_24","text":"I know how impressive my memory is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_25","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_09_25","text":"I'd be a fool to want to destroy it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_26","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_26","text":"That's what she said.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["rapi","neon","anis"],"affinity":null},{"id":"d_main_24_09_27","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_27","text":"Full of bravado until the bitter end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_28","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_28","text":"What about the Underworld Queen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_29","text":"They're...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_30","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_30","text":"It happened AGAIN?! I will not let this stand!","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_mystery","movie":null,"shown":["doban","mustang"],"affinity":null},{"id":"d_main_24_09_31","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_31","text":"Why are Tetra's squads interfering with the Central Government anyway?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_32","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_32","text":"Considérant what you've done up until now, I don't think you should even be talking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_33","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_33","text":"The Ark was under siege! It doesn't take a genius to know it had to come from that garbage heap!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_34","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_34","text":"I saw E.H. with my own two eyes! She was getting on the elevator and she had a bomb in her hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_35","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_35","text":"And yet, you let her get away as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_36","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_36","text":"...!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_37","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_37","text":"Let me ask you something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_38","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_38","text":"Did you have any evidence to","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_39","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_39","text":"back up these accusations you have against the Outer Rim?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_40","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_40","text":"Are you deaf? I just told you, that place is a hotbed for terrorists!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_41","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_41","text":"If you had eyes, you would have seen for yourself","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_42","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_42","text":"that there wasn't une seule personne in the entire Outer Rim who was armed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_43","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_43","text":"Tell me then, on what grounds could you possibly justify marching in there with your petite armée?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_44","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_44","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_45","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_45","text":"It sounds to me like you were conducting a massacre.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_46","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_46","text":"What if it was? What are you going to go about it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_47","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_47","text":"?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_48","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_48","text":"What has the Outer Rim ever done for the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_49","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_49","text":"We could wipe it off the map, and Enikk wouldn't say a word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_50","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_50","text":"Are you willing to accept les répercussions?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_51","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_51","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_52","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_52","text":"La raison Enikk isn't making a move is simple.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_53","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_53","text":"She knows that my Queens could crush you like un insecte.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_54","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_54","text":"And do you truly believe that the Outer Rim doesn't benefit the Ark in any way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_55","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_55","text":"If so, vous are sorely mistaken.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_56","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_56","text":"What kind of gibberish is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_57","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_57","text":"Très bien, go ahead. Go straight to the Outer Rim and fire away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_58","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_58","text":"I won't stop you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_59","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_59","text":"Let's see for ourselves what judgment Enikk will reach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_60","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_61","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_61","text":"Go on, hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_62","type":"Speech","speaker":"doban","key":"Locale_MainScenario:d_main_24_09_62","text":"... I don't feel like it right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_63","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_63","text":"Oh. That's too bad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_64","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_64","text":"I would like to remind you of one thing, however.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_65","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_65","text":"When my Queens were protégeaient the Outer Rim,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_66","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_66","text":"they also saved your skin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_67","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_67","text":"You owe me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_68","text":"That's more or less what was said.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["rapi","neon","anis"],"affinity":null},{"id":"d_main_24_09_69","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_69","text":"But they couldn't escape the fact that they roughed up Central Government troops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_70","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_70","text":"Sakura, Rosanna, and Moran were all about to get their memories wiped, \nbut Mustang stepped in and made a deal with the government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_71","text":"In exchange for them keeping their memories, Tetra's main broadcasting channel will be handed over to the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_72","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_72","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_73","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_73","text":"It's the only reason the Underworld Queens aren't walking vegetables right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_74","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_74","text":"But then how is Mustang going to make any money?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_75","text":"He's got his fingers in a lot of pies, so losing the broadcasting channel won't be a death blow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_76","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_76","text":"However, the Central Government will now have virtually complete control over all broadcasting systems in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_77","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_77","text":"I just met with Mustang briefly and he seemed fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_78","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_78","text":"C'est bon, Anis.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":null,"movie":null,"shown":["mustang"],"affinity":null},{"id":"d_main_24_09_79","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:d_main_24_09_79","text":"Fighting up from the bottom is my spécialité!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_80","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_80","text":"That's what he said.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":["rapi","neon","anis"],"affinity":null},{"id":"d_main_24_09_81","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_81","text":"Mustang will be fine. He always is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_82","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_82","text":"Thanks to him, the Outer Rim didn't sustain too much damage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_83","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_83","text":"Commanding everyone to lay down their weapons was a masterstroke. If everyone had been armed, they'd have gotten drawn into the carnage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_84","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_84","text":"What about Yuni and Mihara?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_85","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_85","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_86","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_86","text":"Yuni has been placed in solitary confinement at the Rehabilitation Center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_87","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_87","text":"She's refusing to speak, and is more or less catatonic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_88","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_88","text":"Running a brain scan is impossible since she doesn't have any NIMPH, so the Central Government is at a loss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_89","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_89","text":"They won't be forgiving her for that shelter escapade of hers, so I can't see things ending well for her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_90","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_90","text":"She'll remain locked in solitary confinement until it's certain that she's behind the shelter incident.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_91","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_91","text":"Once it's been confirmed, then what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_92","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_92","text":"She'll be scrapped.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_93","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_93","text":"... I see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_94","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_94","text":"And Mihara?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_95","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_95","text":"Mihara...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_96","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_96","text":"Yuni and the three of us were all shot by Crow's suppression bullets, but Mihara got shot in the head by a termination pistol.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_97","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_97","text":"The damage was extensive, and she was sent to the Repair Center.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_98","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_98","text":"However, her NIMPH interfered with the brain surgery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_99","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_99","text":"It most likely perceived the operation as an external attack.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_100","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_101","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_101","text":"They were left with no choice but to remove the NIMPH,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_102","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_102","text":"and it was during this procedure that a memory wipe occurred.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_103","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_103","text":"Then what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_104","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_104","text":"After some treatment, her NIMPH was re-uploaded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_105","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_105","text":"She's still recovering at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_106","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_106","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_107","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_107","text":"At any rate, everything more or less seems to be under control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_108","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_108","text":"As for the Raptures, there are only a few stragglers left in the Ark, so things should settle down soon enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_109","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_109","text":"The shelter will be re-opened once we've confirmed all Raptures have been eliminated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_110","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_110","text":"This was a big one, in every sense of the word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_111","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_111","text":"They're going to declare that the hole in the Ark's roof was a result of deterioration from the facility's aging.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_112","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_112","text":"If word gets out that this all occurred because of one Nikke's doing, the Central Government's reputation will hit rock bottom.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_113","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_113","text":"The ironic thing is that, as a result, popular opinion regarding Nikkes is now at an all-time high.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_114","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_114","text":"It's become more apparent than ever how indispensable Nikkes are to protecting humanity. Especially after Matis's display up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_115","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_115","text":"I'm sure the Central Government is intending to use this newfound goodwill to its advantage.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_116","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_116","text":"So, this is what the Ark chose...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_117","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_117","text":"What happened to Syuen?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_118","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_118","text":"Yuni really did a number on her, so she's in intensive care right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_119","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_119","text":"When she's able to walk again, she'll be judged by Enikk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_120","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_120","text":"We'll just have to wait and see what happens next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_121","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_121","text":"There's something I still don't get, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_122","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_122","text":"Why do you think Crow shot suppression bullets at us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_123","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_123","text":"She must have wanted to push the Commander to the brink.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_124","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_124","text":"Of course, the moment you think about it, the holes start to show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_125","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_125","text":"It doesn't matter how much mental fortitude you have. If you want to be free from the NIMPH, then your Inhibitor needs to be deactivated. There's no way around that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_126","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_126","text":"I realize that now, but in the heat of the moment, I wasn't thinking straight.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_127","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_127","text":"I don't blame you. Crow was probably counting on that happening.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_128","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_128","text":"Crow's ultimate goal was for the Commander to avenge our supposed deaths.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_129","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_129","text":"Once you'd killed her, it wouldn't matter that we were still alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_130","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_130","text":"At that point, it'd be too late. You'd have crossed that line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_131","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_131","text":"What a sadistic trick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_132","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_132","text":"But Rapi, how were you able to move first?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_133","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_133","text":"I... used it a little bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_134","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_134","text":"You mean Red Hood?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_135","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_135","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_136","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_136","text":"How are you feeling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_137","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_137","text":"I'm okay. It was only for a moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_138","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_138","text":"Um, that's a relief, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_139","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_24_09_139","text":"Sorry to interrupt, but it's time, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_140","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_140","text":"All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_141","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_24_09_141","text":"I'll walk with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_142","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_142","text":"Enikk's gonna make her verdict... this shouldn't be a big deal, right?","jump":null,"exit":fa