{"id":"d_main_24_09","cat":"main","group":{"id":"ch24","label":"Chapter 24 · Banishment"},"label":"Afterwards","stage":"24-26 STAGE · Start","prev":"d_main_24_08_e","next":"d_main_24_10","speakers":{"neon":"Neon","Self":"Commander","ingrid":"Ingrid","crow":"Crow","anis":"Anis","doban":"Doban","mustang":"Mustang","rapi":"Rapi"},"icons":{"neon":"si_c011_00_s","ingrid":"si_c900_00_s","crow":"si_c110_00_s","anis":"si_c012_00_s","doban":"si_c939_00_s","mustang":"si_c902_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_24_09_1","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_1","text":"Okay, let me break this down.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":"bgm_inark","movie":null,"shown":["rapi","neon","anis"],"affinity":null},{"id":"d_main_24_09_2","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_2","text":"Let's start with Crow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_3","text":"Rapi blasted her right in the dome with a well-timed suppression bullet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_4","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_4","text":"She was knocked unconscious, got carried away by the Central Government, and had a brain scan conducted on her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_5","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_5","text":"That scan confirmed she was the ringleader behind the recent string of attacks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_6","text":"It also confirmed that everyone else involved was merely being used by her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_7","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_24_09_7","text":"And the punishment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_24_09_8","text":"Well, about that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_9","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_24_09_9","text":"Even though your NIMPH was operating normally, \nyou will be studied extensively for the various acts of wanton violence you have committed.","jump":null,"exit":false,"enter":null,"bg":"Jail","bgArt":"jail","image":null,"bgm":null,"movie":null,"shown":["crow","ingrid"],"affinity":null},{"id":"d_main_24_09_10","type":"Speech","speaker":"crow","key":"Locale_MainScenario:d_main_24_09_10","text":"Studied?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_11","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_24_09_11","text":"We believe that you are able to control the NIMPH using your own will alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_24_09_12","type":"Speech","speaker":"ingrid","key":"Locale_MainScenario:d_main_24_09_12","text":"This requires further investigation.","jump":null,"exit":false