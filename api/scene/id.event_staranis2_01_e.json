hown":null,"affinity":null},{"id":"event_staranis2_01_e_133","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis2_01_e_133","text":"Um... I'm gonna go shower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_134","type":"Speech","speaker":"riss","key":"Locale_MainScenario:event_staranis2_01_e_134","text":"Y-you guys have all worked so hard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_135","type":"Speech","speaker":"riss","key":"Locale_MainScenario:event_staranis2_01_e_135","text":"Things are going to be good from here on out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_136","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_136","text":"In a meeting room at Tetra Line's entertainment planning department.","jump":null,"exit":false,"enter":null,"bg":"BriefingRoom","bgArt":"briefingroom","image":null,"bgm":"none","movie":null,"shown":["mustang_past"],"affinity":null},{"id":"event_staranis2_01_e_137","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_137","text":"Around twenty people are seated inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_138","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_138","text":"At the center, Mustang watches the massive screen and begins to speak.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_139","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_139","text":"Well, that about settles it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"event_bgm_trueentertainment","movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_140","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_140","text":"They're not fit to be pop stars. There's nothing special about them, and their individual skills are downright pathetic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_141","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_141","text":"That blond one is passable, but even she's only small-time at best.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_142","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_142","text":"We'll have to package them and carry them on image alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_143","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_143","text":"... Tch, that's a headache. We've already used up everything worth using.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_144","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_144","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_145","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_145","text":"Mustang taps his finger on the table.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_146","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_146","text":"For a while, the sound of soft tapping is all that fills the room.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_147","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_147","text":"Then it stops.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_148","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_148","text":"Hey, you've got the Ark's stress metrics ready, right? Pull them up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_149","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_149","text":"The screen changes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_150","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_150","text":"Just as I thought, the failed surface reclamation hit harder than expected. And on top of that, Pretty's dead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_151","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_151","text":"No surprise the stress is piling up. At this rate, something in the Ark is bound to snap.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_152","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_152","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_153","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_153","text":"Good, we'll use them as the outlet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_154","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_154","text":"Take those things and come up with two proposals each. I want ways to let the Ark's citizens vent their stress.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_155","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_155","text":"I don't care how far you push it. Have them ready by this time tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_156","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis2_01_e_156","text":"I'll wire a billion to whoever I pick. Dismissed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_01_e_157","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis2_01_e_157","text":"The meeting room empties in a flurry of movement.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event