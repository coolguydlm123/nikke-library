{"id":"d_counseling_quiry_02","cat":"counsel","group":{"id":"char5082","label":"Quiry"},"label":"Advising Quiry: 02","stage":null,"prev":"d_counseling_quiry_01","next":"d_counseling_quiry_03","speakers":{"quiry":"Quiry"},"icons":{"quiry":"si_c033_00_s"},"lines":[{"id":"d_counseling_quiry_02_1","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_02_1","text":"You know those documents you sent to me this morning?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["quiry"],"affinity":"_0"},{"id":"d_counseling_quiry_02_2","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_02_2","text":"One of them is missing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_02_3","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_02_3","text":"Don't forget it next time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_quiry_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_quiry_02_4","text":"Are you sure that's right?","jump":"d_counseling_quiry_02_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_quiry_02_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_quiry_02_5","text":"Will do. Good catch, Quiry.","jump":"d_counseling_quiry_02_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_quiry_02_6","type":"Speech","speaker":"quiry","key":"Locale_Counseling:d_counseling_quiry_02_6","text":"I'm positive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"