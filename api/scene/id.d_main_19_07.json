{"id":"d_main_19_07","cat":"main","group":{"id":"ch19","label":"Chapter 19 · Eden"},"label":"Reason of Birth","stage":"19-27 STAGE · End","prev":"d_main_19_06","next":"d_main_19_08_s","speakers":{"Narration":"Narration","harran":"Harran","Self":"Commander"},"icons":{"Narration":"si_c999_00_s","harran":"si_c230_00_s"},"lines":[{"id":"d_main_19_07_1","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_19_07_1","text":"*caw caw*","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02_n","bgArt":"wasteland_02_n","image":null,"bgm":"bgm_story_exiter","movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_2","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_2","text":"That's much better.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["harran"],"affinity":null},{"id":"d_main_19_07_3","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_3","text":"You can come out now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_4","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_07_4","text":"You're quite strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_5","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_5","text":"As I should be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_6","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_6","text":"Only the strong survive up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_7","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_7","text":"You won't get to the top of the food chain by being weak, that's for sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_8","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_07_8","text":"Is Commander Johan by any chance...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_9","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_9","text":"As strong as I am?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_10","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_10","text":"You of all people should know, considering that knuckle sandwich he gave you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_11","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_11","text":"At first, he was a weak human much like yourself.","jump":null,"exit":false,"enter":null,"bg":"EventScene_Chap_19_01","bgArt":"eventscene_chap_19_01","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_12","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_12","text":"But then he swapped his broken bones and tattered skin for mechanical parts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_13","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_13","text":"He even managed to cover up all the gaps resulting from the surgeries.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_14","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_14","text":"Before I met him, I thought all humans were doomed to be prey for all eternity.","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02_n","bgArt":"wasteland_02_n","image":null,"bgm":null,"movie":null,"shown":["harran"],"affinity":null},{"id":"d_main_19_07_15","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_15","text":"Thanks to him, I've come around slightly on that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_16","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_07_16","text":"What made him do this to himself?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_17","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_17","text":"He's obsessed with reclaiming the Surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_18","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_18","text":"The thought of it has consumed him entirely, more than anyone else I've seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_19","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_19","text":"For him, reclaiming the Surface will never come to pass if left to bureaucrats pontificating over it during their lunch meetings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_20","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_20","text":"The sunshine. The smell of the grass.","jump":null,"exit":false,"enter":null,"bg":"Grassland","bgArt":"grassland","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_21","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_21","text":"The flow of the water, and the windswept valleys on a breezy day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_22","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_22","text":"He intends for all of it to come to pass by his hand alone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_23","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_23","text":"Achieving this is his entire purpose in life.","jump":null,"exit":false,"enter":null,"bg":"FlowerGarden","bgArt":"flowergarden","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_24","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_24","text":"He's willing to do anything to make his dream a reality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_25","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_25","text":"...","jump":null,"exit":false,"enter":null,"bg":"WasteLand_02_n","bgArt":"wasteland_02_n","image":null,"bgm":null,"movie":null,"shown":["harran"],"affinity":null},{"id":"d_main_19_07_26","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_26","text":"Now let me ask you something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_27","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_27","text":"Are you not a commander, sent from the Ark, to recapture the surface as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_28","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_28","text":"Yet, even with Vapaus within your grasp, you claimed you'd use it instead to liberate the Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_29","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_29","text":"What if, as a result, a Heretic survives,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_30","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_30","text":"and threatens your precious homestead and its people?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_31","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_31","text":"What would you do then?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_32","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_07_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_33","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_07_33","text":"Put everything I have on the line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_34","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_34","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_35","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_35","text":"And does that include...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_36","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_19_07_36","text":"Yes. My life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_37","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_37","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_38","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_38","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_39","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_39","text":"How disappointing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_07_40","type":"Speech","speaker":"harran","key":"Locale_MainScenario:d_main_19_07_40","text":"If there is anything of less value than a human life, I do not know of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}