{"id":"d_counseling_admi_02","cat":"counsel","group":{"id":"char5030","label":"Admi"},"label":"Advising Admi: 02","stage":null,"prev":"d_counseling_admi_01","next":"d_counseling_admi_03","speakers":{"admi":"Admi"},"icons":{"admi":"si_c172_00_s"},"lines":[{"id":"d_counseling_admi_02_1","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_1","text":"Because of Privaty and me, Yulha ended up overworking herself.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["admi"],"affinity":"_0"},{"id":"d_counseling_admi_02_2","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_2","text":"I'm quite concerned about her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_3","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_3","text":"Is there anything I can do to help her out?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_02_4","text":"Just say 'Thank you.' She would appreciate that.","jump":"d_counseling_admi_02_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_admi_02_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_admi_02_5","text":"Tell her you'll help her with her work from now on.","jump":"d_counseling_admi_02_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_admi_02_6","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_6","text":"Say 'Thank you'?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_7","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_7","text":"I imagine she would be pretty embarrassed to hear me say that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_8","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_8","text":"But, you're right. I really should say it to her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_9","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_9","text":"That was very helpful. Thank you very much, Commander.","jump":"d_counseling_admi_02_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_10","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_10","text":"Hm... I think Yulha would be furious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_11","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_11","text":"She'd probably tell me to just worry about doing my own job instead of messing with hers.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_12","type":"Speech","speaker":"admi","key":"Locale_Counseling:d_counseling_admi_02_12","text":"But, thank you anyway. I'll take it into consideration.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_admi_02_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_admi_02_13","text":"I talk with Admi about Yulha.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}