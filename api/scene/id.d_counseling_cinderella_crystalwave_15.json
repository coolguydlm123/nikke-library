{"id":"d_counseling_cinderella_crystalwave_15","cat":"counsel","group":{"id":"char5175","label":"Cinderella: Crystal Wave"},"label":"Advising Cinderella: Crystal Wave: 15","stage":null,"prev":"d_counseling_cinderella_crystalwave_14","next":"d_counseling_cinderella_crystalwave_16","speakers":{"cinderella_s":"Cinderella","Monologue":"Monologue"},"icons":{"cinderella_s":"si_c515_00_s"},"lines":[{"id":"d_counseling_cinderella_crystalwave_15_1","type":"Monologue","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_1","text":"Penguin No. 1 is running toward Cinderella from afar.","jump":null,"exit":false,"enter":null,"bg":"JungleIsland_Out_d","bgArt":"jungleisland_out_d","image":null,"bgm":"event_bgm_wtu_seabreeze","movie":null,"shown":["cinderella_s"],"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_2","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_2","text":"Why does that penguin keep following me around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_3","text":"Can I follow you around too?","jump":"d_counseling_cinderella_crystalwave_15_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_cinderella_crystalwave_15_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_4","text":"Because you're just that beautiful.","jump":"d_counseling_cinderella_crystalwave_15_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_cinderella_crystalwave_15_5","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_5","text":"Of course you can.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_6","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_6","text":"It's only natural to be drawn to beautiful things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_7","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_7","text":"I was just about to go for a walk. Come with me.","jump":"d_counseling_cinderella_crystalwave_15_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_8","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_8","text":"Of course I'm beautiful, but so is everyone else here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_9","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_9","text":"You make it sound like I'm the only one who is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_10","type":"Monologue","speaker":"Monologue","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_10","text":"Cinderella pulls out her hand mirror and holds it up to my face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_11","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_11","text":"See? You're beautiful too, Prince.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_12","type":"Speech","speaker":"cinderella_s","key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_12","text":"That wasn't a very beautiful thing to say. You should look at yourself in a mirror more often.","jump":"d_counseling_cinderella_crystalwave_15_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_cinderella_crystalwave_15_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_cinderella_crystalwave_15_13","text":"Penguin No. 1 and I follow Cinderella.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}