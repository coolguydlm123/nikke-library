:null,"affinity":null},{"id":"d_ex_wingofvictory_09_76","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_09_76","text":"Even though it went straight into a lion's mouth?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_77","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenStory:d_ex_wingofvictory_09_77","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_78","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenStory:d_ex_wingofvictory_09_78","text":"During the day, starfish like to remain in the sunlight,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_79","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenStory:d_ex_wingofvictory_09_79","text":"but at night, they prefer dark places, like spots under rocks and in other crevices.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_80","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenStory:d_ex_wingofvictory_09_80","text":"It just told me it liked being in Timi's mouth because it was dark and cozy inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_81","type":"Speech","speaker":"timi","key":"Locale_SuddenStory:d_ex_wingofvictory_09_81","text":"*Graul*?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_82","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_09_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_83","type":"Speech","speaker":"leona_no","key":"Locale_SuddenStory:d_ex_wingofvictory_09_83","text":"Well... I guess that makes sense.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_84","type":"Speech","speaker":"leona_no","key":"Locale_SuddenStory:d_ex_wingofvictory_09_84","text":"In that case, would it like to hang out in Timi's mouth while we head back?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_85","type":"Speech","speaker":"anchor_m","key":"Locale_SuddenStory:d_ex_wingofvictory_09_85","text":"Sure!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_86","type":"Speech","speaker":"timi","key":"Locale_SuddenStory:d_ex_wingofvictory_09_86","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_87","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_09_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_88","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_09_88","text":"And so, the already thoroughly bizarre stroll","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_wingofvictory_09_89","type":"Monologue","speaker":null,"key":"Locale_SuddenStory:d_ex_wingofvictory_09_89","text":"ended with a lion becoming a temporary carriage for a