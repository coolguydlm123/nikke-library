{"id":"d_counseling_aria_10","cat":"counsel","group":{"id":"char5070","label":"Aria"},"label":"Advising Aria: 10","stage":null,"prev":"d_counseling_aria_09","next":"d_counseling_aria_11","speakers":{"aria":"Aria"},"icons":{"aria":"si_c432_00_s"},"lines":[{"id":"d_counseling_aria_10_1","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_1","text":"I run through the gamut of emotions while on stage.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["aria"],"affinity":"_0"},{"id":"d_counseling_aria_10_2","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_2","text":"But the strongest of them is still loneliness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_3","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_3","text":"The unfolding stories, the expectation of the audience, and the arrangement made with everyone. All of this is up on me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_10_4","text":"You'll always have your music, Aria.","jump":"d_counseling_aria_10_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_aria_10_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_aria_10_5","text":"You'll always have me, Aria.","jump":"d_counseling_aria_10_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_aria_10_6","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_6","text":"... That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_7","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_7","text":"Music can help me forget my loneliness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_8","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_8","text":"So actually, I'm not alone at all.","jump":"d_counseling_aria_10_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_9","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_9","text":"But you're not on stage with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_10","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_10","text":"Perhaps we could perform together one day, but the chances of that are slim to none.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_11","type":"Speech","speaker":"aria","key":"Locale_Counseling:d_counseling_aria_10_11","text":"Are you even listening to what I'm saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_aria_10_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_aria_10_12","text":"Aria shares with me the feelings she experiences while on stage.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}