{"id":"msg_m_nikke_volume_05","cat":"messenger","group":{"id":"room_volume_s","label":"Volume · Chat"},"label":"1. Did you see the news? What's going on?","stage":null,"prev":null,"next":null,"speakers":{"volume":"Volume"},"icons":{"volume":"si_c431_00_s"},"lines":[{"id":"m_nikke_volume_05_1","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_volume_05_1","text":"Did you see the news? What's going on?","jump":null},{"id":"m_nikke_volume_05_2","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_2","text":"No, what's up?","jump":null},{"id":"m_nikke_volume_05_3","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_volume_05_3","text":"People think we're dating.","jump":null},{"id":"m_nikke_volume_05_4","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_4","text":"Ah, so it was finally released!","jump":null},{"id":"m_nikke_volume_05_5","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_volume_05_5","text":"You better start explaining.","jump":null},{"id":"m_nikke_volume_05_6","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_6","text":"Hmm?","jump":null},{"id":"m_nikke_volume_05_7","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_7","text":"There's nothing to explain.","jump":null},{"id":"m_nikke_volume_05_8","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_8","text":"I'm the one that leaked it.","jump":null},{"id":"m_nikke_volume_05_9","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_volume_05_9","text":"What is that?","jump":null},{"id":"m_nikke_volume_05_10","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_10","text":"I said, it was me.","jump":null},{"id":"m_nikke_volume_05_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_volume_05_11","text":"Why?","jump":null},{"id":"m_nikke_volume_05_12","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_12","text":"Cause I like you.","jump":null},{"id":"m_nikke_volume_05_13","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_volume_05_13","text":"Where are you? I'm coming over.","jump":null},{"id":"m_nikke_volume_05_14","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_14","text":"Right now? Okay. I'm in the practice room.","jump":null},{"id":"m_nikke_volume_05_15","type":"Speech","speaker":"volume","key":"Locale_NikkeEpisode:m_nikke_volume_05_15","text":"When you get here, I hope you'll give me the answer I'm looking for.","jump":null}],"chat":true}