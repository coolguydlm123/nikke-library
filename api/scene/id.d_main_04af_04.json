{"id":"d_main_04af_04","cat":"main","group":{"id":"ch4","label":"Chapter 4 · Bouquet"},"label":"Floral Tribute","stage":null,"prev":"d_main_04af_03","next":"d_main_04af_05","speakers":{"andersen":"Andersen","Self":"Commander","Narration":"Narration","mihara":"Mihara","yuni":"Yuni","anis":"Anis","neon":"Neon","rapi":"Rapi"},"icons":{"andersen":"si_c903_00_s","Narration":"si_c999_00_s","mihara":"si_c161_00_s","yuni":"si_c160_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","rapi":"si_c010_00_s"},"lines":[{"id":"d_main_04af_04_1","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_1","text":"Long time no see. I'm sorry to call you in like this, what with your leg and all.","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":["andersen"],"affinity":null},{"id":"d_main_04af_04_2","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_2","text":"I've been informed of a rather serious matter.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_3","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_3","text":"The way you command your Nikkes is rather unorthodox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_4","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_4","text":"You must be quite displeased with how we intend on erasing their memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_5","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_5","text":"So tell me, how are you feeling?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_6","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_04af_04_6","text":"Depressed.","jump":"d_main_04af_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_7","type":"Choice","speaker":null,"key":"Locale_MainScenario:d_main_04af_04_7","text":"I'd rather not talk about it.","jump":"d_main_04af_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_8","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_8","text":"Are you sure about that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_9","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_9","text":"You asked me before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_10","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_10","text":"if I knew anything about Marian being corrupted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_11","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_11","text":"The answer is yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_12","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_12","text":"As long as you keep it a secret, I will tell you everything I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_13","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_04_13","text":"Your secret is safe with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_14","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_14","text":"Not the most convincing answer in the world..","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_15","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_15","text":"Fine then. Since you've agreed, I'll tell you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_16","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_16","text":"Someone inside the Ark tampered with the Nikkes and sent them up to the surface to sabotage our operations.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_17","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_17","text":"We're not entirely convinced if it's a one-man operation, or a group who's behind all this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_18","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_18","text":"Regardless, I believe they're working with the Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_19","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_04_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_20","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_20","text":"If I had told you this before, you would have said it was impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_21","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_21","text":"But now you know I speak the truth... because you've met Chatterbox.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_22","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_22","text":"Raptures with a mind of their own, capable of speech.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_23","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_23","text":"You understand what I'm saying, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_24","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_24","text":"This method of corruption, implanting a code into a Nikke's brain and bending them to your will, this is not something humans are capable of yet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_25","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_25","text":"No, this is the Raptures' forte.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_26","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_26","text":"Someone used that technology to implant something in those Nikkes' brains, then sent them up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_27","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_27","text":"It's safe to assume they have a man on the inside.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_28","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_28","text":"No ordinary citizen could pull this off either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_29","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_29","text":"They gained access to the Aegis Barriers without being discovered, and they must have been using a separate communication line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_30","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_30","text":"It's almost certainly someone high up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_31","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_04_31","text":"What should we do?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_32","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_32","text":"I want to catch them, whoever they are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_33","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_33","text":"I believe you feel the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_34","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_34","text":"Chatterbox is their link to the inside, I'm sure of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_35","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_35","text":"You have to do everything in your power to track Chatterbox down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_36","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_36","text":"Find it, and the truth will be revealed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_37","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_04_37","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_38","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_38","text":"Now if you'll excuse me, I have a meeting in five minutes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_39","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_04af_04_39","text":"Why are you helping me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_40","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_41","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_41","text":"Consider it a small consolation to those Nikkes with no feelings, no memories...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_42","type":"Speech","speaker":"andersen","key":"Locale_MainScenario:d_main_04af_04_42","text":"And no control over their own lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_43","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_04af_04_43","text":"Two days later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_44","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_44","text":"Hello, I'm Mihara.","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":"bgm_mystery","movie":null,"shown":["mihara","yuni"],"affinity":null},{"id":"d_main_04af_04_45","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_45","text":"You're my new teammate, Yuni, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_46","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_46","text":"Yep, this is Yuni!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_47","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_47","text":"Aren't you a little cutie!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_48","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_48","text":"We're a team now, so we should try and get along.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_49","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_49","text":"Tell me, Yuni, what do you like?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_50","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_50","text":"What about you, Mihara? What do you like?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_51","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_51","text":"Um, well... I'm fresh out of the factory, so I may need to look into that a bit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_52","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_52","text":"Yuni knows it all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_53","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_53","text":"Hmm?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_54","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_54","text":"Everything that you like.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_55","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_55","text":"What kind of people you like. What food you love. Your hobbies, where you like to go...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_56","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_56","text":"Yuni knows all of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_57","type":"Speech","speaker":"mihara","key":"Locale_MainScenario:d_main_04af_04_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_58","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_58","text":"All you have to do is trust Yuni...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_59","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_59","text":"Yuni...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_04af_04_60","type":"Speech","speaker":"yuni","key":"Locale_MainScenario:d_main_04af_04_60","text":"will turn you into Mihara. promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":