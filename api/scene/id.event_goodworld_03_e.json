type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_81","text":"do you feel the Ark has become a better place than it was before?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_82","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_83","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_83","text":"Would you like me to be honest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_84","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_84","text":"Yes, that's what they asked of me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_85","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_85","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_86","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_86","text":"The methods have changed, but things haven't improved in the slightest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_87","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_03_e_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_88","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_88","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_89","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_89","text":"Of course, people's lives are far better than they used to be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_90","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_90","text":"I mean, even someone like me, a former war orphan, now runs a cafe on Royal Road.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_91","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_91","text":"And thanks to Evergreen, I've been able to keep this youthful appearance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_92","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_92","text":"But... people's hearts are still sick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_93","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_93","text":"If anything, they've just grown worse in a different way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_94","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_94","text":"They've grown so used to peace in the Ark that they've forgotten the war is still raging on the surface,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_95","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_95","text":"forgotten who made that peace possible in the first place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_96","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_96","text":"And now we even have a ridiculous term like \"Nikkephobe.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_97","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_97","text":"Yes, thanks to Pretty, Tetra Line, and those well-known squads,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_98","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_98","text":"Nikke rights have improved beyond recognition since the Second Surface Reclamation War.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_99","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_99","text":"And yet, whenever something happens in the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_100","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_100","text":"people are still quick to pin the blame on the Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_101","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_101","text":"Peace has become a given. And with that, they've grown complacent. Ungrateful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_102","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_102","text":"Just like so many who once belonged to our foundation...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_103","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_103","text":"never satisfied with the support they were given,\nfoolish enough to try taking the foundation's money, only to end up facing your judgment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_104","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_03_e_104","text":"... Face your judgment?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_105","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_105","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_106","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_106","text":"Yeah, you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_107","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_107","text":"I'm sorry for being so negative at our last meeting,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_108","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_108","text":"but I really don't think this society has improved at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_109","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_109","text":"That's just how I see it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_110","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_110","text":"Thank you. I've listened carefully to everything you shared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_111","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_111","text":"And I appreciate you seeing this through to the very end.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_112","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_03_e_112","text":"I hope your days ahead are filled with peace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_03_e_113","type":"Speech","speaker":"sara","key":"Locale_SubScenario:event_goodworld_03_e_113","text":"Thank you for everything, Miss Snow Crane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}