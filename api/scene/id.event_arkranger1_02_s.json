 she lands, she knows. Her legs and hip joints are wrecked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_56","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_56","text":"But the expressions of those three people in her arms, looking up at her, make her forget all the pain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_57","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_s_57","text":"Run straight that way! Don't look back!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_58","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_58","text":"The rescued individuals thank her and run off as instructed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_59","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_59","text":"Ark Ranger Black staggers as she looks around her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_60","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_60","text":"In another burning building, someone else is waiting on the rooftop to be rescued.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_61","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_61","text":"Black shuts down both her pain sensors and temperature sensors and runs toward the flames.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_62","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_62","text":"She drives a kick into the entrance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_63","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_63","text":"The door bursts open.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_64","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_64","text":"*Whooooosh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_65","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_65","text":"A great wall of flames engulf her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_s_66","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_s_66","text":"She falls unconscious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}