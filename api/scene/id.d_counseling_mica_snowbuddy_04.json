{"id":"d_counseling_mica_snowbuddy_04","cat":"counsel","group":{"id":"char5104","label":"Mica: Snow Buddy"},"label":"Advising Mica: Snow Buddy: 04","stage":null,"prev":"d_counseling_mica_snowbuddy_03","next":"d_counseling_mica_snowbuddy_05","speakers":{"mica_w":"Mica"},"icons":{"mica_w":"si_c062_00_s"},"lines":[{"id":"d_counseling_mica_snowbuddy_04_1","type":"Speech","speaker":"mica_w","key":"Locale_Counseling:d_counseling_mica_snowbuddy_04_1","text":"The hot spring is fantastic.","jump":null,"exit":false,"enter":null,"bg":"HotSpringInnIn_d","bgArt":"hotspringinnin_d","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mica_w"],"affinity":"_0"},{"id":"d_counseling_mica_snowbuddy_04_2","type":"Speech","speaker":"mica_w","key":"Locale_Counseling:d_counseling_mica_snowbuddy_04_2","text":"It relaxes you, and all your fatigue just melts away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_snowbuddy_04_3","type":"Speech","speaker":"mica_w","key":"Locale_Counseling:d_counseling_mica_snowbuddy_04_3","text":"Do you enjoy it as well, Old-Timer?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mica_snowbuddy_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mica_snowbuddy_04_4","text":"It's the best. I try and go whenever I have the chance.","jump":"d_counseling_mica_snowbuddy_04_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mica_snowbuddy_04_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mica_snowbuddy_04_5","text":"It's great, but the water is a tad too hot.","jump":"d_counseling_mica_snowbuddy_04_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100