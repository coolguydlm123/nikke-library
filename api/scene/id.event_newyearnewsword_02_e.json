eech","speaker":"hongryeon_o","key":"Locale_SubScenario:event_newyearnewsword_02_e_31","text":"How would you know that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_02_e_32","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_02_e_32","text":"Just a hunch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_02_e_33","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_02_e_33","text":"She would have been facing something she'd never been up against before,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_02_e_34","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_02_e_34","text":"and there were many things precious to her that she had to protect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_02_e_35","type":"Speech","speaker":"hongryeon_o","key":"Locale_SubScenario:event_newyearnewsword_02_e_35","text":"If thine own strength is so formidable, then surely there is no need for apprehension.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_02_e_36","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_02_e_36","text":"Heh, you think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_newyearnewsword_02_e_37","type":"Speech","speaker":"janghwa","key":"Locale_SubScenario:event_newyearnewsword_02_e_37","text":"She was