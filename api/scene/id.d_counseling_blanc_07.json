{"id":"d_counseling_blanc_07","cat":"counsel","group":{"id":"char5008","label":"Blanc"},"label":"Advising Blanc: 07","stage":null,"prev":"d_counseling_blanc_06","next":"d_counseling_blanc_08","speakers":{"blanc":"Blanc"},"icons":{"blanc":"si_c270_00_s"},"lines":[{"id":"d_counseling_blanc_07_1","type":"Speech","speaker":"blanc","key":"Locale_Counseling:d_counseling_blanc_07_1","text":"There are times when we come across rude customers.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["blanc"],"affinity":"_0"},{"id":"d_counseling_blanc_07_2","type":"Speech","speaker":"blanc","key":"Locale_Counseling:d_counseling_blanc_07_2","text":"How do you think we should handle them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_blanc_07_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_blanc_07_3","text":"Treat them the same way they treat you.","jump":"d_counseling_blanc_07_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_blanc_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_blanc_07_4","text":"Let me take care of them.","jump":"d_counseling_blanc_07_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_blanc_07_5","type":"Speech","speaker":"blanc","key":"Locale_Counseling:d_counseling_blanc_07_5","text":"No way!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_blanc_07_6","type":"Speech","speaker":"blanc","key":"Locale_Counseling:d_counseling_blanc_07_6","text":"At that the end of the day, they're still our customers.","jump":null,"exit":false,"enter":null