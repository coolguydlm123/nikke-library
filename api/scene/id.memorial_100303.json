{"id":"memorial_100303","cat":"memorial","group":{"id":"memorial100300","label":"Call Logs · Call Log 017515"},"label":"4:17 PM","stage":null,"prev":"memorial_100302","next":"memorial_100304","speakers":{"B":"B","A":"A"},"icons":{},"lines":[{"id":"memorial_100303_1","type":"Speech","speaker":"B","key":"Locale_Memorial:memorial_03_03_description","text":"Hello?"},{"id":"memorial_100303_2","type":"Speech","speaker":"A","key":"Locale_Memorial:memorial_03_03_description","text":"Are you all right?"},{"id":"memorial_100303_3","type":"Speech","speaker":"B","key":"Locale_Memorial:memorial_03_03_description","text":"I'm okay. I tried getting out as fast as possible, but something didn't feel right."},{"id":"memorial_100303_4","type":"Speech","speaker":"A","key":"Locale_Memorial:memorial_03_03_description","text":"Get out of there now."},{"id":"memorial_100303_5","type":"Speech","speaker":"B","key":"Locale_Memorial:memorial_03_03_description","text":"I can't. The roads have collapsed."},{"id":"memorial_100303_6","type":"Speech","speaker":"A","key":"Locale_Memorial:memorial_03_03_description","text":"Well, you can't stay there! Use your legs!"},{"id":"memorial_100303_7","type":"Speech","speaker":"B","key":"Locale_Memorial:memorial_03_03_description","text":"I told you, I can't make it!"},{"id":"memorial_100303_8","type":"Speech","speaker":"A","key":"Locale_Memorial:memorial_03_03_description","text":"Well, what should we do then?!"},{"id":"memorial_100303_9","type":"Speech","speaker":"B","key":"Locale_Memorial:memorial_03_03_description","text":"I-I don't know."},{"id":"memorial_100303_10","type":"Speech","speaker":"A","key":"Locale_Memorial:memorial_03_03_description","text":"Honey."},{"id":"memorial_100303_11","type":"Speech","speaker":"B","key":"Locale_Memorial:memorial_03_03_description","text":"The soldiers are broadcasting something. I'll call you later."}]}