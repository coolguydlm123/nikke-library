ck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_12","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_12","text":"The operation is almost coming to an end, and yet the sea road is nowhere to be seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_13","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_13","text":"So I have been making some designs in my spare time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_14","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_14","text":"It's a lifeboat that can withstand the weight of Nikkes,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_15","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_15","text":"and it can be made using only materials that are found on this island.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_16","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_16","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_17","type":"Speech","speaker":"yan_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_17","text":"Are you being for real?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_18","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_18","text":"Of course I am. What reason would I have to lie to you all?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_19","type":"Speech","speaker":"yan_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_19","text":"Then why didn't you say anything until now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_20","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_20","text":"I didn't want to get everyone's hopes up until I knew it could be done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_21","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_21","text":"There's nothing worse than giving someone false hope, then tearing it away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_22","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_22","text":"Wow, you're officially number two on the list of people I respect the most. Master being number one, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_23","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_23","text":"Do you ever stop talking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bg