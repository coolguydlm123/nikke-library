{"id":"event_bluewaterisland2_02_s","cat":"event","group":{"id":"ev40021","label":"BLUEWATER ISLAND · Part 2"},"label":"Escape: A","stage":null,"prev":"event_bluewaterisland2_01_e","next":"event_bluewaterisland2_02_e","speakers":{"liter_s":"Liter","neon_s":"Neon","Self":"Commander","yan_s":"Yan","rapi_s":"Rapi","mary_s":"Mary"},"icons":{"liter_s":"si_c082_01_s","neon_s":"si_c014_00_s","yan_s":"si_c201_01_s","rapi_s":"si_c010_02_s","mary_s":"si_c132_00_s"},"lines":[{"id":"event_bluewaterisland2_02_s_1","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_1","text":"What have you two been up to?","jump":null,"exit":false,"enter":null,"bg":"LogHouseIn_n","bgArt":"loghousein_n","image":null,"bgm":"bgm_distress","movie":null,"shown":["yan_s","liter_s","rapi_s","mary_s"],"affinity":null},{"id":"event_bluewaterisland2_02_s_2","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_2","text":"You're gonna have to hold onto your hats for this one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon_s"],"affinity":null},{"id":"event_bluewaterisland2_02_s_3","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_3","text":"Today, Master and I... discovered the true secret behind the ultimate vacation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_4","type":"Speech","speaker":"liter_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_4","text":"What in the world are you on about this time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_bluewaterisland2_02_s_5","type":"Speech","speaker":"neon_s","key":"Locale_SubScenario:event_bluewaterisland2_02_s_5","text":"That's it! I'm calling you out! You're alwa