illa_w","key":"Locale_MainScenario:event_neverland1_03_s_30","text":"You're free to enjoy them right now if you'd like. It's perfectly okay with me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_neverland1_03_s_31","type":"Self","speaker":null,"key":"Locale_MainScenario:event_neverland1_03_s_31","text":"Then let's hurry and complete our mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_neverland1_03_s_32","type":"Speech","speaker":"ludmilla_w","key":"Locale_MainScenario:event_neverland1_03_s_32","text":"Before you go, can I ask you something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_neverland1_03_s_33","type":"Speech","speaker":"ludmilla_w","key":"Locale_MainScenario:event_neverland1_03_s_33","text":"Snowfield isn't quite complete yet,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_neverland1_03_s_34","type":"Speech","speaker":"ludmilla_w","key":"Locale_MainScenario:event_neverland1_03_s_34","text":"so I'd really appreciate it if you could help me while you're out here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_neverland1_03_s_35","type":"Speech","speaker":"ludmilla_w","key":"Locale_MainScenario:event_neverland1_03_s_35","text":"There are still a lot of things around here that need to be organized,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_neverland1_03_s_36","type":"Speech","speaker":"ludmilla_w","key":"Locale_MainScenario:event_neverland1_03_s_36","text":"and we're short-handed at t