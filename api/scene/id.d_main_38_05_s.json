_main_38_05_s_28","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_s_28","text":"I don't think many people saw that video, to be honest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_29","text":"That's probably true, but things like this tend to spread through word-of-mouth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_s_30","text":"But what if someone sees that and recognizes you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_31","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_31","text":"So what? My face was already plastered on screens from those news reports.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_32","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_s_32","text":"Oh, right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_33","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_34","text":"Sure, there might be a few people who recognize me, but only a few.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_35","text":"I'm sure there are people out there making wild assumptions and badmouthing me. They'll make fun of me for being on such a strange show so soon after being in the news.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_36","text":"People say all kinds of terrible things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_37","text":"Let them talk. I don't need to pay them any mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_38","text":"I could never see or hear a word of what they say,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_39","text":"and they'll keep gossiping in their own little warped world for the rest of their lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_40","text":"Hehe, they'll have a real good time talking crap about me, but I'll never give it one second of my time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_41","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_s_41","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_42","text":"They'll act like their opinions are so important, assuming I must be paying attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_43","text":"Then they'll get mad when I don't acknowledge them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_44","text":"Hehe, who knows what they're saying? If I don't look, then I'll never know, and I don't care!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_45","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_s_45","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_47","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_47","text":"Sorry. I kinda went on a tear there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_48","type":