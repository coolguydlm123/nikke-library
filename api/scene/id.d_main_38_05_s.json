enario:d_main_38_05_s_14","text":"That's what you're upset about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_15","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_38_05_s_15","text":"Did your message even get sent in the first place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_16","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_17","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_38_05_s_17","text":"Anis pulls out her phone and plays a saved video.","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_18","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_38_05_s_18","text":"In the video, Anis speaks directly into the camera.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_19","text":"Hey there, long time no see.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_38_05_s_20","text":"I'll be waiting at the place where we all shared a tearful moment together for the first time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_38_05_s_21","type":"Speech","speaker":"anis",