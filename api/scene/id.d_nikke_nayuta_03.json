id":"d_nikke_nayuta_03_21","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_21","text":"Thou art one who taketh pleasure in smiting maidens in jest,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_22","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_22","text":"and in making acquaintance with them beyond what need requireth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_23","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_23","text":"That's not...","jump":"d_nikke_nayuta_03_25","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_24","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_24","text":"Rapi...!","jump":"d_nikke_nayuta_03_25","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_25","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_25","text":"Haha, wouldst thou deny it so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_26","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_26","text":"Verily... ere I was aware, mine own heart had yielded itself unto thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_27","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_27","text":"... Why's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_28","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_28","text":"Hmm...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_29","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_29","text":"I deem it not begotten solely of the utterances of the other Forerunners.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_30","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_31","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_31","text":"Methinks...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_32","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_32","text":"'tis rather born of having beheld the speech and comportment of the maidens that do attend thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_33","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_33","text":"You mean Matis and Rapi?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_34","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_34","text":"So it is. Yet the other maidens are included, nonetheless.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_35","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_35","text":"Nayuta stops and turns to face me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_36","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_36","text":"I, too, do possess some knowledge touching the history of the Ark,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_37","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_37","text":"and right well do I know how the Nikkes are entreated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_38","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_38","text":"Oft hath mine eyes beheld","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_39","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_39","text":"how those who name themselves commanders do deal with them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_40","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_40","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_41","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_41","text":"When first I heard the tale from the Forerunner maidens,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_42","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_42","text":"I believed it not that one such as thee could verily exist.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_43","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_43","text":"Thus did I resolve to behold it with mine own eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_44","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_44","text":"So... is that why you've been wandering around?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_45","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_45","text":"Haha. Not for that cause alone, though in part it was indeed so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_46","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_46","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_47","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_47","text":"Haha, my most humble apologies. 'Twas a slip of the tongue.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_48","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_48","text":"Aye...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_49","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_49","text":"'tis but one among many reasons, verily.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_50","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_50","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_51","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_51","text":"At any rate, to meet thee here atop the White Giant,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_52","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_52","text":"and share such words as these...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_53","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_53","text":"Verily, the workings of fate doth surpass all understanding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_54","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_54","text":"Fate...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_55","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_55","text":"Verily,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_56","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_56","text":"betwixt thee and the maidens doth exist a bond most strong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_57","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_57","text":"And such a bond doth stand as testament to the depth of thine affections for one another.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_58","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_58","text":"Having beheld this, I too do find myself, unawares, placing my trust in thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_59","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_59","text":"... Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_60","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_60","text":"Haha, I hath strayed from the path of our tale.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_61","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_61","text":"Yet, in sooth, the answer lieth in that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_62","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_62","text":"thou art a man of vast capacity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_63","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_63","text":"Therefore... it is by reason thereof that thou art able to choose such a course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_64","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_65","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_65","text":"Verily, thy approach doth stand as the true and rightful path.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_66","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_66","text":"Of this, at least, I remain most assured.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_67","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_67","text":"Yet...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_68","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_68","text":"Yet...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_69","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_69","text":"Yet one cannot always take the righteous way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_weare","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_70","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_70","text":"To be righteous oft doth bring inefficiency.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_71","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_71","text":"And inefficiency doth...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_72","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_72","text":"maketh it more likely that thou shalt fail to attain thine aims.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_73","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_73","text":"Then, what if I try again...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_74","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_74","text":"If there be no second chance...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_75","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_75","text":"and if the stake be this world itself...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_76","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_76","text":"then the matter differeth, doth it not?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_77","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_78","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_78","text":"What's your goal, Nayuta?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_79","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_79","text":"It differeth not from thee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_80","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_80","text":"Yet my path... mayhap lies otherwise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_81","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_81","text":"And what way would that be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_82","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_82","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_83","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpi