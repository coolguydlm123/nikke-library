{"id":"d_nikke_nayuta_03","cat":"bond","group":{"id":"char5155","label":"Nayuta"},"label":"Q&A: Forbearance","stage":null,"prev":"d_nikke_nayuta_02","next":"d_nikke_nayuta_04","speakers":{"nayuta_n":"Nayuta"},"icons":{"nayuta_n":"si_c9008_00_s"},"lines":[{"id":"d_nikke_nayuta_03_1","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_1","text":"Nayuta and I stroll slowly on top of Whaley.","jump":null,"exit":false,"enter":null,"bg":"WhaleyBack","bgArt":"whaleyback","image":null,"bgm":"none","movie":null,"shown":["nayuta_n"],"affinity":null},{"id":"d_nikke_nayuta_03_2","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_2","text":"Of thy reason I have heard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_impression","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_3","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_3","text":"Yet prithee, wherefore hast thou resolved","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_4","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_4","text":"to hold discourse with the Maleficent Beast Quartet?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_5","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_5","text":"Well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_6","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_6","text":"At Nayuta's question, I retrace my memories.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_7","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_7","text":"... Just because.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_8","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_8","text":"Heh... in sooth, sayest thou there be no cause?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_9","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_9","text":"I'd say it's more like...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_10","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_10","text":"I briefly explain to Nayuta what happened with the Four Beasts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_11","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_11","text":"Actually, they were the ones who wanted to talk first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_12","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_nayuta_03_12","text":"They heard that conversation is the cornerstone of evolution.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_nayuta_03_13","type":"Speech","speaker":"nayuta_n","key":"Locale_NikkeEpisode:d_nikke_nayuta_03_13","text":"A wise sentiment indeed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"sh