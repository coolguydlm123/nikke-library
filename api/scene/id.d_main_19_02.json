inity":null},{"id":"d_main_19_02_7","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_02_7","text":"Absolutely. Security is of utmost importance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_02_8","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_02_8","text":"Let's not do this. How about an open exchange of information? Both sides. One question, one answer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_02_9","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_02_9","text":"What are you all looking for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_02_10","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_02_10","text":"No, wait! First, tell me about \"sewage\".","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_02_11","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_19_02_11","text":"It's where sewer water flows from.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_02_12","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_19_02_12","text":"... Are you for real right now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_19_02_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_19_02_13","text":"It's a place where Heretics are created.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"