{"id":"d_counseling_mori_01","cat":"counsel","group":{"id":"char5139","label":"Mori"},"label":"Advising Mori: 01","stage":null,"prev":null,"next":"d_counseling_mori_02","speakers":{"mori":"Mori"},"icons":{"mori":"si_c590_00_s"},"lines":[{"id":"d_counseling_mori_01_1","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_1","text":"Why are you being so nice to me?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mori"],"affinity":"_0"},{"id":"d_counseling_mori_01_2","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_2","text":"You haven't known me for very long.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_3","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_3","text":"If there's something you want from me, then just tell me. At least then I'll know that I'm being used sooner rather than later, and it'll hurt less.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mori_01_4","text":"Actually, there is something I want from you.","jump":"d_counseling_mori_01_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mori_01_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mori_01_5","text":"I don't have any ulterior motives.","jump":"d_counseling_mori_01_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mori_01_6","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_6","text":"... Well, I suppose you being honest is a good thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_7","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_7","text":"So, what is it that you want?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_8","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_mori_01_8","text":"Stay here today and get a good rest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_9","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_9","text":"What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_10","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_10","text":"Did I hear you right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_11","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_11","text":"All you want is... for me to rest, and not work?","jump":"d_counseling_mori_01_14","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_12","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_12","text":"That's what everyone says.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mori_01_13","type":"Speech","speaker":"mori","key":"Locale_Counseling:d_counseling_mori_01_13","text":"But th