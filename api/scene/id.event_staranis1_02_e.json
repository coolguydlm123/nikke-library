{"id":"event_staranis1_02_e","cat":"event","group":{"id":"ev40108","label":"STAR ANIS · Part 1"},"label":"Meet & Meat: B","stage":null,"prev":"event_staranis1_02_s","next":"event_staranis1_03_s","speakers":{"meatmeetowner":"Meet & Meat Owner","anis_idol":"Anis","hanson":"Hanson","prika_o":"Prika","mint_o":"Mint","anis_human":"Anis","mint":"Mint","prika":"Prika"},"icons":{"meatmeetowner":"si_c999_00_s","anis_idol":"si_c9021_01_s","hanson":"si_c9023_00_s","prika_o":"si_c601_00_s","mint_o":"si_c600_00_s","anis_human":"si_c9021_00_s","mint":"si_c600_01_s","prika":"si_c601_01_s"},"lines":[{"id":"event_staranis1_02_e_1","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_1","text":"Great job, everyone!","jump":null,"exit":false,"enter":null,"bg":"FastFood","bgArt":"fastfood","image":null,"bgm":"event_bgm_staranis_dreamsandthestage","movie":null,"shown":["anis_idol","mint_o","prika_o","hanson"],"affinity":null},{"id":"event_staranis1_02_e_2","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_2","text":"Performing takes a lot out of you, so make sure you eat plenty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_3","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_3","text":"Thanks! Can't wait to dig in!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_4","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_4","text":"Oh my, you're the leader? Quite the firecracker!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_5","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_5","text":"Want me to pile on some more meat?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_6","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_6","text":"Thank you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_7","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_7","text":"Go on, eat up. I'll bring some more right over.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_8","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_02_e_8","text":"The owner of Meet & Meat walks into the kitchen with a big grin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_9","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_10","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_10","text":"That was a great performance today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_11","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_11","text":"Right? We totally nailed it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_12","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_02_e_12","text":"We even got used to that floor, even though it felt like it might collapse any second.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_13","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_13","text":"We're doing this for a week, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_14","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_14","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_15","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_15","text":"I think two people showed up during our second performance.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_16","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_16","text":"Who did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_17","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_17","text":"Music fans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_18","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_02_e_18","text":"... How'd you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_19","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_19","text":"They have a certain look in their eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_20","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_20","text":"Since there are so many pop stars these days, the fans end up competing too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_21","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_21","text":"Everyone wants to say they were there from the start.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_22","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_02_e_22","text":"...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_23","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_23","text":"You know that feeling when you find a place that becomes your spot? Like you discovered it before anyone else.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_24","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_02_e_24","text":"Ah, I get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_25","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_25","text":"Fans like that usually help spread the word, so for rookies like us, they can make a big difference.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_26","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_26","text":"Hmm... We didn't get much of a reaction today, but at least we caught their attention.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_27","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_27","text":"If I had to guess, we'll probably start seeing a few more people from tomorrow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_28","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_28","text":"Wait, what? Even after we performed right outside the meat place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_29","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_29","text":"Tsk, tsk. You really don't pay attention, huh, Anis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_30","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_30","text":"This place has an excellent location.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_31","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_31","text":"We're right in the middle of downtown, and there's tons of foot traffic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_32","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_02_e_32","text":"Yeah, there's people everywhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_33","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_33","text":"Ohh! Then we'll get noticed without even trying, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_34","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_34","text":"That's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_35","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_35","text":"Oh, that reminds me, Boss...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_36","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_36","text":"How'd you manage to convince the owner?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_37","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_37","text":"If she can afford a place in a location like this, it's hard to believe she doesn't have the budget for advertising.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_38","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_38","text":"And... to be honest, she doesn't really strike me as someone who's into pop stars.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_39","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_39","text":"It's a secret.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_40","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_40","text":"Huh? Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_41","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_41","text":"My boy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_42","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_02_e_42","text":"A bowl of Nutrium is set on the table with a dull thud.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_43","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_43","text":"He's been working at Tetra for about seven years now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_44","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_44","text":"When he first started, he drank so much at a company dinner that he was completely plastered. He would've ended up sleeping on the street if this gentleman here hadn't taken him home.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_45","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_45","text":"Bet you were sweating buckets hauling him all the way there, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_46","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_46","text":"... That was a long time ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_47","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_47","text":"Turns out he was a director at Tetra, would you believe it? Honestly, my boy's probably the only new hire who's ever been carried home on a director's back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_48","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_48","text":"And when he went in the next day, the director had even bought him some hangover medicine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_49","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_49","text":"After that, my son started watching everything he did, saying he couldn't believe someone could be that good of a person.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_50","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_50","text":"From what I can tell, he still treats the director as a role model.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_51","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_52","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_52","text":"Look at you, getting all embarrassed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_53","type":"Speech","speaker":"mint_o","key":"Locale_MainScenario:event_staranis1_02_e_53","text":"Are you feeling shy?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_54","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_02_e_54","text":"Don't be shy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_55","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_55","text":"You guys...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_56","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_56","text":"So you used that favor to pull some strings and get us this gig?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_57","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_57","text":"No, I didn't...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_58","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_58","text":"I saw this awkward guy wandering around with his head down and thought, \"Haven't I seen that face somewhere before?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_59","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_59","text":"So I took a closer look, and it turned out to be that director from back then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_60","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_60","text":"I figured running into him like that must've been fate, so I asked if he'd help promote my shop.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_61","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_61","text":"But honestly, why'd you leave Tetra? If you were a director at one of the Big Three, you could've done just about anything you wanted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_62","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_63","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_02_e_63","text":"Because... there was nothing I could do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_64","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_64","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_65","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_66","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_66","text":"Well, everyone's got their own story, don't they?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_67","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_67","text":"Go on, dig in. And if you need more, just let me know, all right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_68","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_02_e_68","text":"I-I mean, this is already a lot! But I'll let you know if we need more!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_02_e_69","type":"Speech","speaker":"meatmeetowner","key":"Locale_MainScenario:event_staranis1_02_e_69","text":"All right, all right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":nul