le_MainScenario:event_beautyfullshot1_01_e_49","text":"The people will be misled by this muckraking, and it will spur them into taking action against you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_mystery","movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_50","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_50","text":"We cannot react, yet we also cannot sit by and do nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_51","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:event_beautyfullshot1_01_e_51","text":"I think you're making mountains out of molehills here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_52","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_52","text":"I'd ask you to remember Pretty, the first idol the Ark ever had.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_53","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_53","text":"Think about how she perished.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_54","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:event_beautyfullshot1_01_e_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_55","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:event_beautyfullshot1_01_e_55","text":"...","jump"