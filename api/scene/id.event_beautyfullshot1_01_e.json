ll,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_25","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_25","text":"And you want to know what will happen then? That deceitful slander will become la vérité.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_26","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_26","text":"In the minds of du public, they'll believe it as fact, even if they're not being présenter with the entire picture.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_27","type":"Speech","speaker":"sakura","key":"Locale_MainScenario:event_beautyfullshot1_01_e_27","text":"False rumors are something we can deal with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_28","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:event_beautyfullshot1_01_e_28","text":"It's easy to put those to bed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_29","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_29","text":"Très bien, then let's practice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_30","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_30","text":"Imaginons I'm someone you meet while you're out and about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_31","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_31","text":"Wow, n'est-ce pas Rosanna? I saw you on TV recently. You're a gangster, right? So cool!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_32","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_32","text":"That coat of yours must have cost une fortune. You probablement got it by ripping someone off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_33","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_33","text":"You know that film producer from Tetra who went missing? I heard that you were the one who put the kibosh on her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_34","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_34","text":"Is that true?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_35","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:event_beautyfullshot1_01_e_35","text":"What the... what is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_36","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_36","text":"I read un article sur Internet where someone saw you walking outside","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_37","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_37","text":"lugging around an oversized suitcase.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_38","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:event_beautyfullshot1_01_e_38","text":"That's none of your business.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_39","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_39","text":"Do you protest too much, perhaps? Should I take that as a \"yes\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_40","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:event_beautyfullshot1_01_e_40","text":"What are you talking about? Get lost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_41","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_beautyfullshot1_01_e_41","text":"Hey, did you all hear that? She just told me to get lost!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_42","type":"Speech","speaker":"rosanna","key":"Locale_MainScenario:event_beautyfullshot1_01_e_42","text":"What in the world is going on here?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_beautyfullshot1_01_e_43","type":"Speech","s