{"id":"d_counseling_mary_07","cat":"counsel","group":{"id":"char5026","label":"Mary"},"label":"Advising Mary: 07","stage":null,"prev":"d_counseling_mary_06","next":"d_counseling_mary_08","speakers":{"mary":"Mary"},"icons":{"mary":"si_c130_00_s"},"lines":[{"id":"d_counseling_mary_07_1","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_07_1","text":"Hm... While I was walking through the Outpost,","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["mary"],"affinity":"_0"},{"id":"d_counseling_mary_07_2","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_07_2","text":"I saw lots of people who should come to the hospital, but they haven't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_07_3","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_07_3","text":"Why are they all avoiding coming to the hospital?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_mary_07_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_07_4","text":"They're scared of you.","jump":"d_counseling_mary_07_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_mary_07_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_mary_07_5","text":"They're scared of the hospital.","jump":"d_counseling_mary_07_9","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_mary_07_6","type":"Speech","speaker":"mary","key":"Locale_Counseling:d_counseling_mary_07_6","text":"Am I really that bad?","jump":null,"exit":false,"enter":null,"bg