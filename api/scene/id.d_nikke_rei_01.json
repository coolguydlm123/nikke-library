l,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rei_01_6","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_rei_01_6","text":"Now... where was I again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rei_01_7","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_rei_01_7","text":"Ah, right. Given that your courses will be more difficult and your after-school activities will take up more of your time,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rei_01_8","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_rei_01_8","text":"we know we're asking a lot of you. Set a good example for your fellow classmen in the lower grades.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rei_01_9","type":"Speech","speaker":"rei","key":"Locale_NikkeEpisode:d_nikke_rei_01_9","text":"I can't believe I'm in my third year...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rei_01_10","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_rei_01_10","text":"Ah yes, I nearly forgot. This is Commander {AccountData.NickName}.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rei_01_11","type":"Speech","speaker":"ether","key":"Locale_NikkeEpisode:d_nikke_rei_01_11","text":"The Commander will be your substitute until the cooperation evaluation of this semester.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_rei_01_12","type":"Speech","speaker":"ether","k