eaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_79","text":"Meanwhile, this old reading room was reconfigured into a Forbidden Library.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_80","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_80","text":"The most important part of my job is—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_81","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_81","text":"Oh, Forbidden Library. I like that! That's what I'm gonna call this place from now on.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_82","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_82","text":"Anyway, my job is to oversee this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_83","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_83","text":"Since everything in here is highly classified information, which cannot leave this room under any circumstance,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_84","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_84","text":"I therefore have to get my memories wiped after working. It's the same for Phantom and Label with their jobs.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_85","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_85","text":"But it's particularly intense for you. A daily occurrence, from what I gather.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_86","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_86","text":"Yes. At least.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_87","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_87","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_88","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_88","text":"At least?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_89","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_89","text":"I once had my memory wiped more than 10 times in a single day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_90","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_90","text":"For a while there, it negatively affected my work, and things started piling up...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_91","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_91","text":"But it wasn't because I was slacking off! Promise!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_92","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_92","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_93","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_93","text":"You've got a strange look on your face.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_94","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_94","text":"Was it something I said?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_95","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_95","text":"Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_96","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_96","text":"With what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_97","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_97","text":"Getting your memory wiped that often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_98","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_98","text":"Oh, that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_99","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_99","text":"Of course I don't enjoy it. What a silly question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_100","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_100","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_101","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_101","text":"Do you know how annoying it is to shuttle back and forth to Elysion headquarters all the time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_102","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_102","text":"On top of that, I have to make the trip right after work.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_103","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_103","text":"I've been asking them to place a memory wipe device in my room or somewhere close, but they shot that idea down quick. Said it'd be too difficult to maintain the machine that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_104","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_104","text":"Our Boss is a good person, but she is a bit stuck in her ways.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_105","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_105","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_106","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_106","text":"*Pfft*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_107","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_107","text":"What's so funny?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_108","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_108","text":"Nothing, I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_109","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_109","text":"I was just thinking about what a good person you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_110","type":"Self","speaker":null,"key":"Locale_SubScenario:event_arcanearchive_04_e_110","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arcanearchive_04_e_111","type":"Speech","speaker":"arcana","key":"Locale_SubScenario:event_arcanearchive_04_e_111","text":"I'm simply doing what's expected of me.","jump":null,"exit":false,"enter":null,