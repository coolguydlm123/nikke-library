,"type":"Speech","speaker":"laplace_p","key":"Locale_SuddenStory:d_ex_police_12_46","text":"I've been all over the Outpost!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_47","type":"Speech","speaker":"laplace_p","key":"Locale_SuddenStory:d_ex_police_12_47","text":"Of course I've been to the train station!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_48","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_12_48","text":"Then have you been to the mall or the gym lately?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_49","type":"Speech","speaker":"laplace_p","key":"Locale_SuddenStory:d_ex_police_12_49","text":"Of course! Why do you ask?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_50","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_12_50","text":"You weren't going around the Outpost yelling, were you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_51","type":"Speech","speaker":"laplace_p","key":"Locale_SuddenStory:d_ex_police_12_51","text":"Heroes don't yell!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_52","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_12_52","text":"Huh? Then I guess it wasn't Laplace after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_53","type":"Speech","speaker":"miranda","key":"Locale_SuddenStory:d_ex_police_12_53","text":"But everyone said they heard some strange noises.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_54","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_12_54","text":"Laplace, have you been running around yelling, \"Hero power\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_55","type":"Speech","speaker":"laplace_p","key":"Locale_SuddenStory:d_ex_police_12_55","text":"Hahaha! It's only natural for a hero to shout, \"Hero power!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_56","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_12_56","text":"So, did you call out and ask if anyone needed help?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_57","type":"Speech","speaker":"laplace_p","key":"Locale_SuddenStory:d_ex_police_12_57","text":"That's right! That's the fastest way to find out where help is needed!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_58","type":"Self","speaker":null,"key":"Locale_SuddenStory:d_ex_police_12_58","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_59","type":"Speech","speaker":"poli","key":"Locale_SuddenStory:d_ex_police_12_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_ex_police_12_60","type":"Speech","spea