e":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain2_05_e_73","text":"Who... are you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_74","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_seayouagain2_05_e_74","text":"With a great struggle, Helm pries her heavy eyelids open.","jump":null,"exit":false,"enter":null,"bg":"EventScene_SeaYouAgain_02_3","bgArt":"eventscene_seayouagain_02_3","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_75","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_seayouagain2_05_e_75","text":"The surface of the water up above is illuminated by the dazzling sunlight, but part of it is obscured by a familiar shadow.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_76","type":"Speech","speaker":"helm","key":"Locale_MainScenario:event_seayouagain2_05_e_76","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_77","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_seayouagain2_05_e_77","text":"Before her is something she only dared to dream about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_78","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_seayouagain2_05_e_78","text":"But now, before her very eyes, are her dreams made reality.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_seayouagain2_05_e_79","text":"The fourth member of Aegis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_seayouagain2_05_e_80","text":"The Admire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}