":"Speech","speaker":"helm_s","key":"Locale_MainScenario:event_seayouagain2_05_e_60","text":"Where are Mast and Anchor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_61","type":"Speech","speaker":"helm_s","key":"Locale_MainScenario:event_seayouagain2_05_e_61","text":"They'll be worried if they don't see me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_62","type":"Speech","speaker":"helm_s","key":"Locale_MainScenario:event_seayouagain2_05_e_62","text":"I'm so ashamed. I said I would protect him. \nThat I would return after completing the mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_63","type":"Speech","speaker":"helm_s","key":"Locale_MainScenario:event_seayouagain2_05_e_63","text":"... But I'm sure they'll do fine without me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_64","type":"Speech","speaker":"helm_s","key":"Locale_MainScenario:event_seayouagain2_05_e_64","text":"Mast and Anchor will get the job done. They're part of the Aegis Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_65","type":"Speech","speaker":"helm_s","key":"Locale_MainScenario:event_seayouagain2_05_e_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_seayouagain2_05_e_66","type":"Speech","speaker":"helm_s","key":"Locale_MainScenario:event_seayouagain2_05_e_66","text":"It's getting harder to breathe, and my eyelids are