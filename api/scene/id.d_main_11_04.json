{"id":"d_main_11_04","cat":"main","group":{"id":"ch11","label":"Chapter 11 · The Strongest"},"label":"High-Quality Toy","stage":"11-15 STAGE · Start","prev":"d_main_11_03","next":"d_main_11_05","speakers":{"shifty":"Shifty","maxwell":"Maxwell","laplace":"Laplace","ingrid_op":"Ingrid","rapi":"Rapi","drake":"Drake","syuen_op":"Syuen","syuen_op_r":"Syuen","shifty_c":"Shifty"},"icons":{"shifty":"si_c907_00_s","maxwell":"si_c102_00_s","laplace":"si_c100_00_s","ingrid_op":"si_c900_00_s","rapi":"si_c010_00_s","drake":"si_c101_00_s","syuen_op":"si_c901_00_s","syuen_op_r":"si_c901_00_s","shifty_c":"si_c907_00_s"},"lines":[{"id":"d_main_11_04_1","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_04_1","text":"Come in, Matis.","jump":null,"exit":false,"enter":null,"bg":"Desert_01","bgArt":"desert_01","image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["shifty","maxwell","drake","laplace"],"affinity":null},{"id":"d_main_11_04_2","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_04_2","text":"I keep being contacted by Elysion. They want an explanation for why the mission has been disrupted.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_3","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_3","text":"Laplace, you explain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_4","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_04_4","text":"Please tell them it was an accident. Completely unintentional.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_5","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_04_5","text":"I keep telling them that but they keep asking for an explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_6","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_04_6","text":"Just keep telling them what I said.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_7","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_04_7","text":"I'm an operator, not some robot who repeats the same thing ad nauseam!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_8","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_04_8","text":"Practice makes perfect.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_9","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_04_9","text":"What are you talking about?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_main_11_04_10","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_10","text":"Excuse me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["ingrid_op"],"affinity":null},{"id":"d_main_11_04_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_04_11","text":"... Instructor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_kneeldownfools","movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_12","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_12","text":"You're in the operation room? Uh-oh... that can't be good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_13","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_13","text":"Explain. Why have you disrupted Absolute's mission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_14","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_14","text":"Am I right in assuming your intentions are nefarious in nature?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_15","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_15","text":"No, Boss. It's not like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_16","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_16","text":"Do you want to obtain the Heretic fragment for Matis alone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_17","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_17","text":"Or do you just relish in making fools out of the Absolute squad?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_18","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_18","text":"Could you be declaring war against Elysion?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_19","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_19","text":"Or perhaps even intending on destroying us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_20","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_20","text":"She is fuming... we are so screwed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_21","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_04_21","text":"C'mon, where's your backbone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_22","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_22","text":"You try and talk to her then!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_23","type":"Speech","speaker":"drake","key":"Locale_MainScenario:d_main_11_04_23","text":"I would, but she's so hard to talk to, y'know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_24","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_24","text":"I hate you so much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_25","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_25","text":"I'm afraid this matter cannot be overlooked. I will be making an official report to the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_26","type":"Speech","speaker":"syuen_op","key":"Locale_MainScenario:d_main_11_04_26","text":"Oh come on, stop your bickering.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi","syuen_op"],"affinity":null},{"id":"d_main_11_04_27","type":"Speech","speaker":"shifty","key":"Locale_MainScenario:d_main_11_04_27","text":"Umm... these rooms are typically only meant for one person...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["shifty"],"affinity":null},{"id":"d_main_11_04_28","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_28","text":"I'm glad you're here. I was just questioning Matis about what they've done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["ingrid_op","syuen_op_r"],"affinity":null},{"id":"d_main_11_04_29","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_29","text":"Guys. No need to worry. I'll deal with this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_30","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_30","text":"It's precisely because you are always letting them slide that they do things like sabotaging missions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_31","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_31","text":"So what if they did? Your Nikkes just don't cut the mustard. Isn't that right, ladies?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_32","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_32","text":"Well... we can't entirely absolve ourselves from bla...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_33","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_33","text":"Be quiet. I don't want to hear any apologies now or moving forward.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_34","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_34","text":"I don't want an apology. Just an explanation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_35","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_35","text":"I told them to do it. Satisfied?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_36","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_36","text":"What are you going to do? Why are you making such a big deal out of this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_37","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_37","text":"That's why you're getting so many lines in your face, you old bag.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_38","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_38","text":"You call yourself a CEO? God help Missiles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_39","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_39","text":"I told you not to call us that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_40","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_40","text":"I need to go back and prepare for the press conference, where I'll be covering Missiles' hostile actions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_41","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_41","text":"If you call us Missiles one more time...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_42","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_42","text":"Missiles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_43","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_44","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_44","text":"Missiles.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_45","type":"Speech","speaker":"syuen_op_r","key":"Locale_MainScenario:d_main_11_04_45","text":"All right, you and me. Outside, right now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_46","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_11_04_46","text":"I'd love to.","jump":null,"exit":false,"enter":null,"bg":nul