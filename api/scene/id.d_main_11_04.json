l,"bgm":null,"movie":null,"shown":["maxwell","rapi","laplace"],"affinity":null},{"id":"d_main_11_04_54","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_54","text":"Wha.. Us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_55","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_04_55","text":"I've never seen Syuen treat Nikkes like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_56","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_56","text":"Well, not to brag, but we are pretty awesome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_57","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_57","text":"One thing never changes though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_58","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_04_58","text":"What's that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_59","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_59","text":"The fact that we're Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_60","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_60","text":"Sure, she values us... for what we can do as Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_61","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_61","text":"She knew our battery power was almost depleted, but still sent us up to the surface without a second thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_62","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_04_62","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_63","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_63","text":"To her, we're just objects that can get the job done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_64","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_64","text":"Playthings she can use to show off and bolster her reputation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_65","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_65","text":"We don't cross the line or want any more out of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_66","type":"Speech","speaker":"maxwell","key":"Locale_MainScenario:d_main_11_04_66","text":"She's always been this way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_67","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_04_67","text":"Come on, no need to dwell on the negative! All we need is courage!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_68","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_04_68","text":"Let's go! We're gonna find the Heretic fragment!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_69","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_04_69","text":"And we'll share this accomplishment with Absolute right down the middle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_70","type":"Speech","speaker":"laplace","key":"Locale_MainScenario:d_main_11_04_70","text":"Now that is justice in the truest sense!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_11_04_71","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_11_04_71","text":"How 'honorable' of you to give us half the glory.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}