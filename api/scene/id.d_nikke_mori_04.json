":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_79","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_79","text":"If she does the bare minimum to pass the test and heads to another squad,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_80","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_80","text":"she'll only end up being treated the same way she always has.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_81","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_mori_04_81","text":"Oh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_82","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_82","text":"I can't let that happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_83","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_83","text":"We need to show her how to make an effort and also survive up on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_84","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_84","text":"We won't always be there to help her, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_85","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_mori_04_85","text":"That's true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_86","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_86","text":"Even if she passes the test, there's no guarantee that she'll be assigned to our squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_87","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_87","text":"That's why we need to teach her how to survive on her own.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_88","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_88","text":"That's the only way she can truly leave the Incubator Squad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_89","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_89","text":"I understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_90","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_90","text":"I'll impart as many survival skills as I can so that she can make it on the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_91","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_mori_04_91","text":"Me too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_92","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_mori_04_92","text":"Same here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_93","type":"Speech","speaker":"mori","key":"Locale_NikkeEpisode:d_nikke_mori_04_93","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["mori"],"affinity":null},{"id":"d_nikke_mori_04_94","type":"Speech","speaker":"mori","key":"Locale_NikkeEpisode:d_nikke_mori_04_94","text":"How to make an effort and survive...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_95","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_95","text":"In the days that follow, the Counters and Mori train together on a daily basis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_96","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_96","text":"If you want to survive on the surface, preparation is key.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_97","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_97","text":"That applies to everyone, no matter how weak or strong you are.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_98","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_98","text":"Rapi spreads out various pieces of survival gear in front of Mori:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_99","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_mori_04_99","text":"A compass, a map, a first aid kit, a rope, an intrenching tool, and many other pieces of equipment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_100","type":"Speech","speaker":"mori","key":"Locale_NikkeEpisode:d_nikke_mori_04_100","text":"There's so much here...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_101","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_101","text":"This is the bare minimum that you need to have on your person at all times.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_102","type":"Speech","speaker":"mori","key":"Locale_NikkeEpisode:d_nikke_mori_04_102","text":"All of this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_103","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_103","text":"Yes. No matter what squad you're assigned to, if it's a squad that goes to the surface, you'll need to have these.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_104","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_mori_04_104","text":"This equipment will increase your chances of survival, even if only slightly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_105","type":"Speech","speaker":"mori","key":"Locale_NikkeEpisode:d_nikke_mori_04_105","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_mori_04_106","t