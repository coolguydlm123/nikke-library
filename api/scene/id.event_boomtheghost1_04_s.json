,"key":"Locale_MainScenario:event_boomtheghost1_04_s_6","text":"Survivalist!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_7","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_7","text":"This isn't good! I've got to perform CPR! It's a special method I devised for falls from 2 meters or more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_8","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_8","text":"Wouldn't it be better if we bonk him on the head with a wrench?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_9","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_9","text":"What are you talking about! Electric shocks would be far more effective!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_10","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_10","text":"Urgh...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_11","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_11","text":"Oh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_12","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_12","text":"Elegg...? Centi... Tove...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_13","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_13","text":"Whew... you're awake. Thank goodness.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_14","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_14","text":"We were getting worried.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_15","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_15","text":"I must have gotten hit by one of those steel crates...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_16","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_16","text":"Uh, actually...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_17","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_17","text":"You weren't paying attention to where you were going and accidentally slammed into a fence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_18","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_18","text":"It was pretty funny to see, actually.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_19","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_19","text":"The fence got all bent up, too. Your body is something else!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_20","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_21","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_21","text":"N-no way... I wouldn't do something like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_22","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_22","text":"I seem to recall someone suggesting that we dive into the ocean, or try to fly away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_23","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_23","text":"I wasn't myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_24","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_24","text":"I... I was possessed by a ghost. Yeah. That's it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_25","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_25","text":"Hehe. Right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_26","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_26","text":"After all, someone like you surely wouldn't be so scared of ghosts","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_27","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_27","text":"that you'd be terrified beyond the capacity for rational thought.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_28","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_28","text":"... Is everyone else okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_29","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_29","text":"We all got separated, so I'm not sure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_30","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_30","text":"This is bad. Whenever people get split up in horror movies, they get picked off one by one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_31","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_31","text":"We've got to regroup and figure out what to do next.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_32","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_32","text":"Although I don't think, even with all our heads put together, we'll be able to come up with a genius plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_33","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_33","text":"That may be true, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_34","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_34","text":"That's precisely why we need your help,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_35","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_35","text":"Mr. Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_36","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_36","text":"Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_37","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_37","text":"I've got a hunch,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_38","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_38","text":"and I need your help to put it to the test.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_39","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_39","text":"All you've got to do,","jump":null,"exit":false,"enter":null,"bg":"Deck_n","bgArt":"deck_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_40","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_40","text":"is go hug a ghost.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_41","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_41","text":"... Come again?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_42","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_42","text":"Give one of those ghosts a big ol' bear hug!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_43","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_43","text":"In fact, I see one right over there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_44","type":"Monologue","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_44","text":"At the end of the hallway, a ghost can be seen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_45","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_45","text":"After some close observation, I've noticed these ghosts always head straight toward us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_46","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_46","text":"Maybe they're just after some affection?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_47","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_47","text":"But what if I get possessed? Er... not that I'm scared, mind you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_48","type":"Speech","speaker":"tove_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_48","text":"Dunno. Maybe we could use the Heimlich maneuver to force it out of you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_49","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_49","text":"I don't think that's how possession works.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_50","type":"Speech","speaker":"centi_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_50","text":"Once again, I propose a wrench to the head.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_51","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_51","text":"I'm not a mechanical device that you can fix by smacking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_52","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_52","text":"It won't come to that, promise.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_53","type":"Self","speaker":null,"key":"Locale_MainScenario:event_boomtheghost1_04_s_53","text":"How do you know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_54","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_54","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_55","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_55","text":"Ms. Centi, Ms. Tove. I don't think Mr. Commander is up to it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_56","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_56","text":"He's too scared, so we'll have to nix the plan.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_57","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:event_boomtheghost1_04_s_57","text":"It might be for the best. We wouldn't want him wetting his pants and embarrassing himself, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_boomtheghost1_04_s_58","type":"Speech","speaker":"elegg_s","key":"Locale_MainScenario:ev