ity":null},{"id":"event_staranis1_intermission_01_76","type":"Speech","speaker":"prika_o","key":"Locale_MainScenario:event_staranis1_intermission_01_76","text":"Wait, even the stuff's gone?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_77","type":"Speech","speaker":"anis_idol","key":"Locale_MainScenario:event_staranis1_intermission_01_77","text":"Uh... Boss, we're screwed, aren't we?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_78","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_intermission_01_78","text":"Wait a moment...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_79","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_79","text":"Hanson steps out of the office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_80","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_80","text":"A muffled voice drifts through the door. It sounds like he's on the phone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_81","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_81","text":"Before long, the voice rises into shouting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_82","type":"Narration","speaker":null,"key":"L