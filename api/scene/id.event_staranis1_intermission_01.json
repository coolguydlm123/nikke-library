{"id":"event_staranis1_intermission_01","cat":"event","group":{"id":"ev40108","label":"STAR ANIS · Part 1"},"label":"The Ringing Phones","stage":null,"prev":"event_staranis1_03_e","next":"event_staranis1_04_s","speakers":{"anis_human":"Anis","mint":"Mint","hanson":"Hanson","prika":"Prika","mustang_past":"Mustang","yoyo":"Yoyo","mint_o":"Mint","prika_o":"Prika","anis_idol":"Anis"},"icons":{"anis_human":"si_c9021_00_s","mint":"si_c600_01_s","hanson":"si_c9023_00_s","prika":"si_c601_01_s","mustang_past":"si_c9022_00_s","yoyo":"si_c9024_00_s","mint_o":"si_c600_00_s","prika_o":"si_c601_00_s","anis_idol":"si_c9021_01_s"},"lines":[{"id":"event_staranis1_intermission_01_1","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_1","text":"We did it! We made the charts!","jump":null,"exit":false,"enter":null,"bg":"EventScene_staranis_03_1","bgArt":"eventscene_staranis_03_1","image":null,"bgm":"event_bgm_staranis_shootforthestars","movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_2","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_intermission_01_2","text":"We're only 98th on the indie charts, though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_3","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_3","text":"Hey! What's wrong with 98th place?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_4","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_4","text":"Let's see... if the major charts go up to 50, and the indie charts go to 100...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_5","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_5","text":"That means we're 148th out of all the pop stars out there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_6","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_intermission_01_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_7","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_intermission_01_7","text":"Well, when you put it that way, we really are something, huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_8","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_8","text":"Hehe! Damn right we are!","jump":null,"exit":false,"enter":null,"bg":"HansonOffice","bgArt":"hansonoffice","image":null,"bgm":null,"movie":null,"shown":["anis_human","mint","prika","hanson"],"affinity":null},{"id":"event_staranis1_intermission_01_9","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_9","text":"Just wait, Yoyo... I'm coming for you!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_10","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_intermission_01_10","text":"Just don't kill anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_11","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_intermission_01_11","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_12","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_12","text":"Hey, what's with the sighing? It's way too nice a day for that!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_13","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_intermission_01_13","text":"No, that was a sigh of relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_14","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_14","text":"So, got any other good news for us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_15","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_intermission_01_15","text":"Wait till you hear this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_16","type":"Speech","speaker":"hanson","key":"Locale_MainScenario:event_staranis1_intermission_01_16","text":"We've already got five requests for regular gigs, and we're in talks with three more venues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_17","type":"Speech","speaker":"prika","key":"Locale_MainScenario:event_staranis1_intermission_01_17","text":"Whoa...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_18","type":"Speech","speaker":"mint","key":"Locale_MainScenario:event_staranis1_intermission_01_18","text":"Seriously?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_19","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_19","text":"Oh wow, the original song's that good?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_20","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_20","text":"T.T. STAR kicks off promotions with their original track, All Eyes On Me, and steadily climbs into the indie charts' Top 100.","jump":null,"exit":false,"enter":null,"bg":"EventScene_staranis_03_1","bgArt":"eventscene_staranis_03_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_21","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_21","text":"Fans are starting to take notice, and posts about the group are appearing in fan communities.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_22","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_22","text":"It's only a small start, but T.T. STAR is beginning to make their presence known.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_23","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_23","text":"Tch...","jump":null,"exit":false,"enter":null,"bg":"Office","bgArt":"office","image":null,"bgm":"event_bgm_staranis_yoyo","movie":null,"shown":["mustang_past","yoyo"],"affinity":null},{"id":"event_staranis1_intermission_01_24","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_24","text":"I thought you'd be pleased to see your son coming along so nicely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_25","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_25","text":"Getting a little too bold again, aren't you? Go on, call him my son one more time. I'm dying to see how that ends.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_26","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_26","text":"So, did your declaration of war go the way you hoped?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_27","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_27","text":"Yes, perfectly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_28","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_28","text":"... Honestly, I wasn't sure she was even worth the visit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_29","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_29","text":"But I'm glad I took your advice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_30","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_30","text":"Seeing her still crawling around in the gutter... was even more satisfying than I imagined,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_31","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_31","text":"far more than worth the risk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_32","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_32","text":"See? Nothing's more entertaining than someone else's misery.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_33","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_33","text":"Now then, what happened with that little matter from the past?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_34","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_34","text":"That's already been dealt with.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_35","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_35","text":"... Just as I expected. The slightest prod, and she reacted immediately.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_36","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_36","text":"She would never stoop to leaking anything to the press.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_37","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_37","text":"She said she'd crush me with skill alone. Bwhahaha! Ah, pardon me, she was quite adamant that she'd defeat me with just talent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_38","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_38","text":"She's a simple fool, so she'll stick to that, which makes things perfectly safe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_39","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_39","text":"You're awfully confident about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_40","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_40","text":"... Well, I have my reasons for believing that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_41","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_41","text":"Judging by what she's been doing lately, she'll destroy herself soon enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_42","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_42","text":"She's plastering her face everywhere these days.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_43","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_43","text":"It's stupid. That kind of overexposure only ruins your image.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_44","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_44","text":"No, that was the right call.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_45","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_45","text":"People with nothing to their name need to get their faces out there as much as possible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_46","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_46","text":"Putting on airs when you've got nothing behind you just makes the fall that much harder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_47","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_47","text":"Unless you've got real power backing you, playing mysterious gets you nowhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_48","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_48","text":"Though in your case, mystique isn't a strategy. It's a necessity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_49","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_49","text":"Imagine how troublesome it'd be if word got around that you were behind a school bullying scandal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_50","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_50","text":"You made sure that little problem was taken care of, didn't you? Because if this blows up, I won't let it slide, even if it's you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_51","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_51","text":"Yoyo pulls out a small device from inside her clothes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_52","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_52","text":"I've got it all recorded.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_53","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_staranis1_intermission_01_53","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_54","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_54","text":"\"The program and manual... consider them a small gesture from me.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_55","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_55","text":"\"We're colleagues chasing the same dream. We should be supporting each other.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_56","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_56","text":"\"You're not better than me at a single thing.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_57","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_57","text":"\"Number one? Ha. Seriously? If this is what passes for number one, it must be easy.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_58","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_58","text":"\"Hah, turns out the Ark's entertainment scene isn't worth shit!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_59","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_59","text":"\"Anis, I get that you're angry, but don't drag the whole industry into it.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_60","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_60","text":"\"I'm going to crush you.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_61","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_61","text":"\"I'll grind you into the dirt and show you the difference between us.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_62","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_62","text":"\"I'll stomp you so hard you won't even dare look at me again.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_63","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_63","text":"\"Don't do this.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_64","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_64","text":"\"Piss off.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_65","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_65","text":"\"Anis... don't do this.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_66","type":"Speech","speaker":"anis_human","key":"Locale_MainScenario:event_staranis1_intermission_01_66","text":"\"Aaaagh! I said get the hell out!\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_67","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_67","text":"The risk management team already took care of the edit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_68","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_staranis1_intermission_01_68","text":"If she tries to expose it, we'll say she acted out of jealousy toward the top pop star.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_69","type":"Speech","speaker":"mustang_past","key":"Locale_MainScenario:event_staranis1_intermission_01_69","text":"Excellent.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis1_intermission_01_70","type":"Speech","speaker":"yoyo","key":"Locale_MainScenario:event_star