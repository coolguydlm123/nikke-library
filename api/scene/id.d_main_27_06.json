:d_main_27_06_60","text":"So, it's up to us to find out why and how it is that they came to be here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_06_61","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_06_61","text":"One thing is for certain: they didn't occur naturally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_06_62","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_06_62","text":"They were clearly placed here","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_27_06_63","type":"Speech","speaker":"elegg","key":"Locale_MainScenario:d_main_27_06_63","text":"intentionally by someone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null}]}