e like this, n'est-ce pas?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_13","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_13","text":"And make no mistake, Tetra Line bears a grande part of the blame, oui?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_14","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_14","text":"I will rebuild Tetra Line.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_15","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_15","text":"I will cut away every négatif élément, and transform it into an entreprise devoted solely to true entertainment, rien d'autre.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_16","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:event_staranis2_05_e_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_17","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_17","text":"I'm going to create entertainment that's nothing but pure joie.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_18","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_18","text":"But with Tetra, as it is now? Impossible, c'est impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_19","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_19","text":"You will take full autorité, and erase every trace of négativité.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_20","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_20","text":"I care not for heavy losses.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_21","type":"Speech","speaker":"mustang","key":"Locale_MainScenario:event_staranis2_05_e_21","text":"Cut out le problème, éradiquez-le, down to the roots.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_22","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:event_staranis2_05_e_22","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_23","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:event_staranis2_05_e_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_24","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:event_staranis2_05_e_24","text":"Fine, I'll do it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_staranis2_05_e_25","type":"Speech","speaker":"mrsmiss","key":"Locale_MainScenario:event_staranis2_05_e_25","text":"No telling how long it'll last, but I'll lend my strength to your vision.","jump":null,"exit":false,"e