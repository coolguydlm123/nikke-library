":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_67","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_67","text":"yet people around her are constantly telling her what to do. On top of that, none of the procedures have helped so far.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_68","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_68","text":"It's clear to me that she's frustrated.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_69","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_69","text":"It used to be like that for me as well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_70","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_01_s_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_71","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_71","text":"I want to show her that nothing in this world is impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_72","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_72","text":"It's true that the process might be difficult,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_73","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_73","text":"but if you keep at it, it absolutely works.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_74","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_74","text":"It's the reason why all winning athletes say similar things during their post-victory interviews.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_75","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_75","text":"They talk about how it's the result of never giving up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_76","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_76","text":"That's not an empty platitude.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_77","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_77","text":"If you really put in the effort and persevere, nothing is impossible.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_78","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_78","text":"Even if you fall hundreds of times, you'll get back up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_79","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_79","text":"That's what I want to make her understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_80","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_80","text":"... Am I talking too much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_81","type":"Self","speaker":"Self","key":"Locale_SubScenario:event_lifeagain_01_s_81","text":"I think what you're saying is incredibly meaningful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_82","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_82","text":"Really? I'm glad you think so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_83","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_83","text":"I hope Nadia will feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_lifeagain_01_s_84","type":"Speech","speaker":"rumani","key":"Locale_SubScenario:event_lifeagain_01_s_84","text":"Anyway, why don't we go and meet her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}