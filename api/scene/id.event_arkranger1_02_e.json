{"id":"event_arkranger1_02_e","cat":"event","group":{"id":"ev40112","label":"ARK RANGER · Part 1"},"label":"Toward What Lies Beyond: B","stage":null,"prev":"event_arkranger1_02_s","next":"event_arkranger1_03_s","speakers":{"black":"Ark Ranger Black","red":"Ark Ranger Red","blue":"Ark Ranger Blue"},"icons":{"black":"si_c570_00_s","red":"si_c571_00_s","blue":"si_c572_00_s"},"lines":[{"id":"event_arkranger1_02_e_1","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_e_1","text":"Ark Ranger Black opens her eyes to find herself in the Repair Center.","jump":null,"exit":false,"enter":null,"bg":"Hospital","bgArt":"hospital","image":null,"bgm":"none","movie":null,"shown":["black","red","blue"],"affinity":null},{"id":"event_arkranger1_02_e_2","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_e_2","text":"She quickly looks around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_3","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_e_3","text":"Ark Rangers Red and Blue are sitting beside her bed, watching her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_4","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_4","text":"What's going on...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_5","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_5","text":"I see you're finally awake. You absolute lunatic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_6","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_6","text":"Why am I here...? I was in the middle of rescuing people from a fire...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_7","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_7","text":"You got hit by a backdraft. Be glad your brain didn't get cooked.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_intotheswarm","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_8","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_8","text":"A backdraft...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_9","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_9","text":"You don't know what that is?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_10","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_10","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_11","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_11","text":"You still ran straight into a fire without knowing what backdrafts are? You're insane.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_12","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger1_02_e_12","text":"Red.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_13","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_13","text":"What were you thinking?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_14","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_14","text":"What do you mean? Someone had to rescue those civilians.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_15","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_15","text":"Who do you think you are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_16","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_17","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_17","text":"Black.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_18","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_18","text":"We're not heroes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_19","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_19","text":"Sure, we're heroes on TV, but out here in the real world, we're just regular Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_20","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_20","text":"Of course, we can save someone hanging from a ledge,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_21","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_21","text":"catch a pickpocket, or help someone who's getting roughed up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_22","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_22","text":"We can be heroic.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_23","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_23","text":"But only to a certain degree.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_24","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_24","text":"Just be satisfied with that. We're not real heroes after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_25","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_25","text":"... Maybe you're right, and my abilities may be insignificant.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_26","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_26","text":"But that doesn't mean my heart is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_27","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_28","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_28","text":"I want to become a real hero. One who actually saves people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_29","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_29","text":"Not just a hero who only exists in a TV show, but a real-life one.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_30","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_30","text":"You're being a nuisance, you dummy!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_31","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_31","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_32","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_32","text":"Do you even know the first thing about firefighting? What about protocols for a building collapse?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_33","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_33","text":"Do you know first aid? Can you even set a splint?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_34","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_35","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_35","text":"You know nothing, and you think transforming and charging in looking cool is all it takes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_36","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger1_02_e_36","text":"Red, Black meant well...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_37","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_37","text":"Good intentions aren't enough! You need the skills to back it up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_38","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_38","text":"Especially when it comes to saving lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_39","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_39","text":"You fool. You wanna know what good that showboating of yours did?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_40","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_40","text":"Onlookers swarmed the already narrow entrance to the scene of fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_41","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_41","text":"The A.F.F. lost control of the situation, so Triangle and A.C.P.U. rapid response units had to be deployed to drive them away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_42","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_42","text":"The delayed access meant it took even longer to put out the fire.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_43","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_43","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_44","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_44","text":"Were there... casualties?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_45","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_46","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_46","text":"No, so count yourself lucky.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_47","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_47","text":"If a single person had died, that would've been on you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_48","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger1_02_e_48","text":"Red!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_49","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_49","text":"Please, Black. I'm begging you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_50","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_50","text":"We're just entertainers,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_51","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_51","text":"not real heroes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_52","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_52","text":"All we need to do is give people courage through our show.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_53","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_53","text":"Don't be overly ambitious outside of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_54","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_54","text":"Red...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_chapter40_field_turningpoint","movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_55","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_55","text":"What, you punk?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_56","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_56","text":"Where do I begin?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_57","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_57","text":"... What do you mean?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_58","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_58","text":"Where do I even begin... to become a real hero?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_59","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_60","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_60"