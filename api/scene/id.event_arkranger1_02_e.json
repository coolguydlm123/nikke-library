key":"Locale_MainScenario:event_arkranger1_02_e_67","text":"And replace that flimsy ultralight body of yours.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_68","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_68","text":"A standard body's heavier, but it's much sturdier. You'll be able to do a lot more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_69","type":"Speech","speaker":"blue","key":"Locale_MainScenario:event_arkranger1_02_e_69","text":"Are you trying to talk her out of it, or encourage her? Make up your mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_70","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_70","text":"She'll hit a wall soon enough. Not everyone's cut out to be a hero.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_71","type":"Speech","speaker":"black","key":"Locale_MainScenario:event_arkranger1_02_e_71","text":"Thank you, Red.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_72","type":"Speech","speaker":"red","key":"Locale_MainScenario:event_arkranger1_02_e_72","text":"... Tch.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_arkranger1_02_e_73","type":"Narration","speaker":null,"key":"Locale_MainScenario:event_arkranger1_02_e_73","text":"Ark Ranger Red stands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm"