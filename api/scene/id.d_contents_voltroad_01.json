{"id":"d_contents_voltroad_01","cat":"event","group":{"id":"ev80403","label":"Event 80403"},"label":"Woof!","stage":null,"prev":null,"next":"d_contents_voltroad_02","speakers":{"rapi":"Rapi","volt":"Volt","frima":"Frima"},"icons":{"rapi":"si_c010_00_s","volt":"si_c933_00_s","frima":"si_c142_00_s"},"lines":[{"id":"d_contents_voltroad_01_1","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_1","text":"Okay, let's commence the briefing.","jump":null,"exit":false,"enter":null,"bg":"LogHouseOut_d","bgArt":"loghouseout_d","image":null,"bgm":"event_bgm_bluewater_minigame","movie":null,"shown":["volt","rapi_s","frima_s"],"affinity":null},{"id":"d_contents_voltroad_01_2","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_2","text":"Our exploration has two goals.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_3","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_3","text":"One is to find new sites where resources can be gathered.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_4","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_4","text":"It doesn't matter what type of resource.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_5","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_5","text":"Food, minerals, energy sources... The Ark has a deficit of just about everything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_6","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_6","text":"So far we have been exploring only using the naked eye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_7","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_7","text":"I'm sure that will change, however, once you join us and we can make use of your brilliant sense of smell.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_8","type":"Speech","speaker":"volt","key":"Locale_SubScenario:d_contents_voltroad_01_8","text":"Woof!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_9","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_9","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_10","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_10","text":"Goal two.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_11","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_11","text":"Uncover any information we can get our hands on regarding this island's former residents.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_12","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_12","text":"According to Deputy Chief Burningum, this was an important dig site before the 1st Invasion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_13","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_13","text":"Numerous excavation groups have been to this place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_14","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_14","text":"There are many different places on this island that may contain records of them:","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_15","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_15","text":"Resorts, harbors, floating houses, etc.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_16","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_16","text":"This area has been poorly preserved, however, so it's been assigned to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_17","type":"Speech","speaker":"volt","key":"Locale_SubScenario:d_contents_voltroad_01_17","text":"Woof woof!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_18","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_18","text":"... That covers the briefing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_19","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_19","text":"If you find anything, report it to me and the Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_20","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_20","text":"Give us a loud bark, or, if you can, pick up any resources you find and bring them to us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_21","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_21","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_22","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_22","text":"Can I trust you to do that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_23","type":"Speech","speaker":"volt","key":"Locale_SubScenario:d_contents_voltroad_01_23","text":"Woof!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_24","type":"Monologue","speaker":null,"key":"Locale_SubScenario:d_contents_voltroad_01_24","text":"Volt lets out a resounding bark and darts off into the woods.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_25","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_26","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_26","text":"I don't know if this is the right way to go about things,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_27","type":"Speech","speaker":"rapi","key":"Locale_SubScenario:d_contents_voltroad_01_27","text":"but there's no way I can do this alone, so any help is welcome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_contents_voltroad_01_28","type":"Speech","speaker":"frima","key":"Locale_SubScenario:d_contents_voltroad_01_28","text":"... Cool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}