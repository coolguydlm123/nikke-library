ream of.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_06_e_100","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_06_e_100","text":"Talk about pressure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_06_e_101","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_06_e_101","text":"Oh, I didn't mean to make you feel stressed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_06_e_102","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_06_e_102","text":"Not every choice I make will necessarily be for the sake of a better world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_06_e_103","type":"Self","speaker":null,"key":"Locale_SubScenario:event_goodworld_06_e_103","text":"I'm only trying to protect what matters to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_06_e_104","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_06_e_104","text":"Hmm, then how about this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_06_e_105","type":"Speech","speaker":"snowcrane","key":"Locale_SubScenario:event_goodworld_06_e_105","text":"I'll watch over you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_goodworld_06_e_106","type":"Self","speaker":null,"key":"Locale_SubScenario:event