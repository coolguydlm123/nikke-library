null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_68","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_01_68","text":"What seems to be the problem?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_69","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_69","text":"Ah, right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_70","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_70","text":"T.A.L.O.S. got stuck in the mud,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_71","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_71","text":"and there's no way I can get it out by myself.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_72","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_72","text":"All this highfalutin technology, undone by ordinary, everyday mud. There's something comical about that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_73","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_01_73","text":"So all we need to do is extract T.A.L.O.S. from the mire?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_74","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_74","text":"If you could, that'd be great!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_75","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_01_75","text":"A moment later.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_76","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_76","text":"Awesome, thanks! We'd have been toast if it weren't for you guys.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_77","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_77","text":"Actually, I should probably think about adding an emergency escape function.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_78","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_78","text":"T.A.L.O.S., where are your manners? Thank these kind people for what they've done.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_79","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_79","text":"Thank you for helping.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_80","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_80","text":"Holy crap, that thing talks?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_81","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_01_81","text":"...","jump"