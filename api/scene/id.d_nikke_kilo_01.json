mp":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_20","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_kilo_01_20","text":"Much appreciated. I'll leave this in your capable hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_21","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_01_21","text":"Anything we should know about?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_22","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_kilo_01_22","text":"She is currently housed in something akin to a mech suit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_23","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_23","text":"... Huh?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_24","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_01_24","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_25","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_01_25","text":"A moment later. Inside a nearby abandoned building.","jump":null,"exit":false,"enter":null,"bg":"RuinIndoor","bgArt":"ruinindoor","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_26","type":"Speech","speaker":"kilo_op_c","key":"Locale_NikkeEpisode:d_nikke_kilo_01_26","text":"T.A.L.O.S.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["talos","kilo_op_c"],"affinity":null},{"id":"d_nikke_kilo_01_27","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_27","text":"Yes, Kilo?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_28","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_28","text":"You did send that distress signal, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_29","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_29","text":"Affirmative. Signal was sent using normal transmission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_30","type":"Speech","speaker":"kilo_op_c","key":"Locale_NikkeEpisode:d_nikke_kilo_01_30","text":"Then how come no one's coming to rescue us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_31","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_31","text":"Processing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_32","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_32","text":"Intel indicates that there is a large Rapture horde passing nearby.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_33","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_33","text":"In order to avoid any conflict, permission to use the nearby elevator has been approved only for select squads.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_34","type":"Speech","speaker":"kilo_op_c","key":"Locale_NikkeEpisode:d_nikke_kilo_01_34","text":"So in other words, there's no guarantee that anyone's coming to get us?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_35","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_35","text":"Not necessarily. The Special Commandos known as Counters have taken the elevator and moved up to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_36","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_36","text":"They were deployed to protect one of the elevators which fell within the Raptures' purview.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_37","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_37","text":"In correlating the combat capabilities of the Counters and the difficulty of the mission at hand,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_38","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_38","text":"my calculations indicate there is a 92% chance that the Counters have already completed their mission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_39","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_39","text":"There is also a 96% chance that they will come to rescue us after receiving a message from M.M.R.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_40","type":"Speech","speaker":"kilo_op_c","key":"Locale_NikkeEpisode:d_nikke_kilo_01_40","text":"Really? Phew... that's a relief.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_41","type":"Speech","speaker":"kilo_op_c","key":"Locale_NikkeEpisode:d_nikke_kilo_01_41","text":"I thought we were gonna end up buying the farm up here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_42","type":"Speech","speaker":"talos","key":"Locale_NikkeEpisode:d_nikke_kilo_01_42","text":"There is a 99% chance that they will establish contact with us within 60 seconds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_43","type":"Speech","speaker":"kilo","key":"Locale_NikkeEpisode:d_nikke_kilo_01_43","text":"Seriously?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_44","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_01_44","text":"Target found.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi","anis","neon"],"affinity":null},{"id":"d_nikke_kilo_01_45","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_01_45","text":"... At least, I believe so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_46","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_01_46","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_47","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_47","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_48","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_48","text":"Mana wasn't kidding. It's actually a robot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_49","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_01_49","text":"Is that thing actually real?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_50","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_50","text":"You're telling me there's a Nikke inside that thing?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_51","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_01_51","text":"Uh... Should we knock?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_52","type":"Speech","speaker":"kilo_op_c","key":"Locale_NikkeEpisode:d_nikke_kilo_01_52","text":"Hold on just a second, I'm coming out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["kilo_op_c"],"affinity":null},{"id":"d_nikke_kilo_01_53","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_01_53","text":"*Whoosh*","jump":null,"