{"id":"d_nikke_kilo_01","cat":"bond","group":{"id":"char5053","label":"Kilo"},"label":"Waiting Giant","stage":null,"prev":null,"next":"d_nikke_kilo_02","speakers":{"Narration":"Narration","rapi":"Rapi","anis":"Anis","neon":"Neon","Self":"Commander","mana":"Mana","Monologue":"Monologue","kilo_op_c":"Kilo","talos":"T.A.L.O.S.","kilo":"Kilo"},"icons":{"Narration":"si_c999_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s","mana":"si_c290_00_s","kilo_op_c":"si_c977_00_s","talos":"si_c361_00_s","kilo":"si_c977_00_s"},"lines":[{"id":"d_nikke_kilo_01_1","type":"Narration","speaker":"Narration","key":"Locale_NikkeEpisode:d_nikke_kilo_01_1","text":"On the surface.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03_d","bgArt":"cityforest_03_d","image":null,"bgm":"bgm_story_girlstalk","movie":null,"shown":["rapi","anis","neon"],"affinity":null},{"id":"d_nikke_kilo_01_2","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_01_2","text":"Enemy down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_3","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_3","text":"Phew... that wore me out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_4","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_01_4","text":"Was that the last of them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_5","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_01_5","text":"Yes. The elevator is secure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_6","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_6","text":"I can't believe they actually assigned us to protect an elevator from being destroyed by a horde of Raptures.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_7","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_kilo_01_7","text":"They call us Special Commandos, but it's starting to feel like we're little more than pest control.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_8","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_kilo_01_8","text":"Was that the last one for now, Master?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_9","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_01_9","text":"Yes, for now. We'll have another similar operation in three days' time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_10","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_kilo_01_10","text":"Let's head back. We've got a lot of paperwork waiting for us in the office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_11","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_kilo_01_11","text":"... All right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_kilo_01_12","type":"Speech","speaker":"mana","key":"Locale_NikkeEpisode:d_nikke_kilo_01_12","text":"Is the operation over?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"