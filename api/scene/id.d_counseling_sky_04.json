{"id":"d_counseling_sky_04","cat":"counsel","group":{"id":"char5188","label":"Sky"},"label":"Advising Sky: 04","stage":null,"prev":"d_counseling_sky_03","next":"d_counseling_sky_05","speakers":{"sky":"Sky"},"icons":{"sky":"si_c530_00_s"},"lines":[{"id":"d_counseling_sky_04_1","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_1","text":"What do you think you'd do if we suddenly hit turbulence?","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["sky"],"affinity":"_0"},{"id":"d_counseling_sky_04_2","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_2","text":"On an aircraft I'm flying, I mean.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_04_3","text":"I'd trust you and stay calm.","jump":"d_counseling_sky_04_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_sky_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_sky_04_4","text":"I'd find somewhere safe to take cover.","jump":"d_counseling_sky_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_sky_04_5","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_5","text":"... You trust me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_6","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_6","text":"Hehe. Thank you, Captain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_7","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_7","text":"I'll make sure to live up to that trust and always fly safely.","jump":"d_counseling_sky_04_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_8","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_8","text":"That could actually be dangerous, Captain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_9","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_9","text":"It's best not to move around during turbulence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_10","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_10","text":"All you need to do is stay in your seat, make sure your seatbelt's fastened, and follow my instructions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_11","type":"Speech","speaker":"sky","key":"Locale_Counseling:d_counseling_sky_04_11","text":"I'll keep you safe.","jump":"d_counseling_sky_04_12","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_sky_04_12","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_sky_04_12","text":"Sky and I talk about turbulence.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}