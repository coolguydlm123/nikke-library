{"id":"d_counseling_leona_02","cat":"counsel","group":{"id":"char5092","label":"Leona"},"label":"Advising Leona: 02","stage":null,"prev":"d_counseling_leona_01","next":"d_counseling_leona_03","speakers":{"leona":"Leona"},"icons":{"leona":"si_c382_00_s"},"lines":[{"id":"d_counseling_leona_02_1","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_1","text":"It really eats me up inside how so many people are scared of Timi, just because he's a lion.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["leona"],"affinity":"_0"},{"id":"d_counseling_leona_02_2","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_2","text":"Especially when he's as cute as he is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_3","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_3","text":"What do you think I can do to make people realize how charming he can be?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_02_4","text":"Promote the shelter volunteer program more heavily.","jump":"d_counseling_leona_02_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_leona_02_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_leona_02_5","text":"Make him wear a dog mask.","jump":"d_counseling_leona_02_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_leona_02_6","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_6","text":"That's a great idea!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_7","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_7","text":"That way, more people will come to the shelter and get to see Timi for who he really is.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_8","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_8","text":"Once they realize how awesome he is, they're sure to spread the word.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_9","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_9","text":"Thanks for the suggestion, Zoo Keeper.","jump":"d_counseling_leona_02_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_10","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_10","text":"No, we can't do that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_11","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_11","text":"Timi's face is integral to his charm.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_12","type":"Speech","speaker":"leona","key":"Locale_Counseling:d_counseling_leona_02_12","text":"We can't cover that up!","jump":"d_counseling_leona_02_13","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_leona_02_13","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_leona_02_13","text":"I have a conversation with Leona about Timi's charm.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}