{"id":"msg_m_ex_sugar_01","cat":"messenger","group":{"id":"room_sugar","label":"Sugar · Nikke"},"label":"1. Hey,","stage":null,"prev":null,"next":"msg_m_ex_sugar_02","speakers":{"sugar":"Sugar"},"icons":{"sugar":"si_c140_00_s"},"lines":[{"id":"m_ex_sugar_01_1","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_1","text":"Hey,","jump":null},{"id":"m_ex_sugar_01_2","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_2","text":"do you like motorbikes?","jump":null},{"id":"m_ex_sugar_01_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_3","text":"I do, though I don't really ride them that well.","jump":null},{"id":"m_ex_sugar_01_4","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_4","text":"Really?","jump":null},{"id":"m_ex_sugar_01_5","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_5","text":"You said","jump":null},{"id":"m_ex_sugar_01_6","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_6","text":"you are at the Outpost?","jump":null},{"id":"m_ex_sugar_01_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_7","text":"Yes.","jump":null},{"id":"m_ex_sugar_01_8","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_8","text":"Is that a good place for riding?","jump":null},{"id":"m_ex_sugar_01_9","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_9","text":"It's really wide, definitely suitable for motorbikes.","jump":null},{"id":"m_ex_sugar_01_10","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_10","text":"The Ark is far too small.","jump":null},{"id":"m_ex_sugar_01_11","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_11","text":"I'd always encounter an obstacle whenever I try to speed up.","jump":null},{"id":"m_ex_sugar_01_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_12","text":"Sounds like a hassle to ride there.","jump":null},{"id":"m_ex_sugar_01_13","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_13","text":"Oh,","jump":null},{"id":"m_ex_sugar_01_14","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_14","text":"that's because I never slow down,","jump":null},{"id":"m_ex_sugar_01_15","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_15","text":"just hit the gas and speed away.","jump":null},{"id":"m_ex_sugar_01_16","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_16","text":"That way, she doesn't slow down as much.","jump":null},{"id":"m_ex_sugar_01_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_17","text":"??","jump":null},{"id":"m_ex_sugar_01_18","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_18","text":"Whatever,","jump":null},{"id":"m_ex_sugar_01_19","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_19","text":"I will be there soon.","jump":null},{"id":"m_ex_sugar_01_20","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_20","text":"Let's ride together.","jump":null},{"id":"m_ex_sugar_01_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_21","text":"Sure. Anytime.","jump":null},{"id":"m_ex_sugar_01_22","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_22","text":"Anytime?","jump":null},{"id":"m_ex_sugar_01_23","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_23","text":"Great, I'll come now.","jump":null},{"id":"m_ex_sugar_01_24","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_24","text":"Get your motorbike ready.","jump":null},{"id":"m_ex_sugar_01_25","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_25","text":"By the way, what's your bike model?","jump":null},{"id":"m_ex_sugar_01_26","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_26","text":"SWORD-ZII","jump":"m_ex_sugar_01_28"},{"id":"m_ex_sugar_01_27","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_27","text":"KNIGHT-AOZ","jump":"m_ex_sugar_01_28"},{"id":"m_ex_sugar_01_28","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_28","text":"Oh.","jump":null},{"id":"m_ex_sugar_01_29","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_29","text":"Nice choice.","jump":null},{"id":"m_ex_sugar_01_30","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_30","text":"It's an old-type, but a masterpiece,","jump":null},{"id":"m_ex_sugar_01_31","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_31","text":"and has an excellent design.","jump":null},{"id":"m_ex_sugar_01_32","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_32","text":"It may not be obvious to everybody,","jump":null},{"id":"m_ex_sugar_01_33","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_33","text":"but you have quite an eye.","jump":null},{"id":"m_ex_sugar_01_34","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_34","text":"You're exaggerating.","jump":null},{"id":"m_ex_sugar_01_35","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_35","text":"There is not a single bad person among bike-lovers.","jump":null},{"id":"m_ex_sugar_01_36","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_36","text":"From now on, you are going to be my partner.","jump":null},{"id":"m_ex_sugar_01_37","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_sugar_01_37","text":"Glad to be with you, partner.","jump":null},{"id":"m_ex_sugar_01_38","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_38","text":"Okay then.","jump":null},{"id":"m_ex_sugar_01_39","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_39","text":"See you soon,","jump":null},{"id":"m_ex_sugar_01_40","type":"Speech","speaker":"sugar","key":"Locale_SuddenMessage:m_ex_sugar_01_40","text":"Partner.","jump":null}],"chat":true}