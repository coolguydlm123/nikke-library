biscuit","key":"Locale_SubScenario:event_secretgarden_04_s_53","text":"You know what he said?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_04_s_54","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_04_s_54","text":"Oh, don't worry your pretty little head, mon petit pup. The deadline isn't that important.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_04_s_55","type":"Speech","speaker":"biscuit","key":"Locale_SubScenario:event_secretgarden_04_s_55","text":"I'm sure Syuen would be the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_04_s_56","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_04_s_56","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_04_s_57","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_04_s_57","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_04_s_58","type":"Self","speaker":null,"key":"Locale_SubScenario:event_secretgarden_04_s_58","text":"Flora, do you have any good ideas?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_04_s_59","type":"Speech","speaker":"flora","key":"Locale_SubScenario:event_secretgarden_04_s_59","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_secretgarden_04_s_60","type":"Speech",