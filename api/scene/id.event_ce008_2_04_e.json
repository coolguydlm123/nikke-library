{"id":"event_ce008_2_04_e","cat":"event","group":{"id":"ev40103","label":"Collab 08 · Part 2"},"label":"Talks & Threats: B","stage":null,"prev":"event_ce008_2_04_s","next":"event_ce008_2_05_s","speakers":{"jennifer":"Jennifer","jane":"Jane","rane":"Rain"},"icons":{"jennifer":"si_c999_00_s","jane":"si_c9010_00_s","rane":"si_c9011_00_s"},"lines":[{"id":"event_ce008_2_04_e_1","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_1","text":"On the way up to Jennifer's office,","jump":null,"exit":false,"enter":null,"bg":"SchoolCorridor_n","bgArt":"schoolcorridor_n","image":null,"bgm":"bgm_story_empathize","movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_2","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_2","text":"I can feel countless eyes on me, but I don't see anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_3","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_3","text":"They must all be hiding...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_4","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_4","text":"I stop in front of the door, take a short breath,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_5","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_5","text":"and knock carefully.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_6","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_6","text":"*Knock, knock*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_7","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_7","text":"Please come in.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_8","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_8","text":"*Creeeak*","jump":null,"exit":false,"enter":null,"bg":"GoodOffice_n","bgArt":"goodoffice_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_9","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_9","text":"...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_10","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_10","text":"The first thing I see when I step inside...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_11","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_11","text":"are Chisato and Takina in restraints.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_12","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_12","text":"*Sigh*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_13","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_13","text":"You made it. We've been waiting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_14","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_14","text":"Give me a moment. I'll make some coffee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_15","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_15","text":"*Clatter, clatter*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_16","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_16","text":"Jennifer calmly begins brewing coffee.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_17","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_17","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_18","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_18","text":"Why are you doing this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_19","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_19","text":"Hm? I'm afraid you'll have to be more specific.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_20","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_20","text":"Do you mean taking in abandoned children, feeding them, and raising them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_21","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_21","text":"Well, I absolutely adore children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_22","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_22","text":"There's nothing more endearing than when they look at me with those bright, shiny eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_23","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_23","text":"Jennifer approaches me and sets down a mug filled with coffee.","jump":null,"exit":false,"enter":null,"bg":"EventScene_liecauserecoil_02_1","bgArt":"eventscene_liecauserecoil_02_1","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_24","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_24","text":"You know that's not what I'm really asking.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_25","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_25","text":"Oh? Is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_26","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_26","text":"Then... is this the sort of answer you were hoping for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_27","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_27","text":"I do what I do because there are so many children who need me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_28","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_28","text":"They \"need\" you...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_29","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_29","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_30","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_30","text":"In this suffocatingly small Ark, just look at how many children are left without any protection at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_31","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_31","text":"Children like that come to me,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_32","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_32","text":"because even if they're abandoned by everyone else, they still have to survive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_33","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_33","text":"All I did was provide children who have nowhere to go with a way to be useful.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_34","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_35","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_35","text":"One by one, people started seeking us out once they realized the value of these children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_36","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_36","text":"And that was the finishing touch on this little community,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_37","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_37","text":"where the children and I belong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_38","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_38","text":"Though, to be honest, this most recent client was unusually troublesome.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_39","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_39","text":"There are so many people who say they're too poor to pay taxes, yet they're willing to spend money at a place like this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_40","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_40","text":"It's unfortunate, but that's reality... Hahaha!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_41","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_41","text":"Do you actually think everything you're doing can be forgiven?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_42","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_42","text":"No, I wouldn't imagine so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_43","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_43","text":"But you know what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_44","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_44","text":"The whole reason I was able to establish myself here was thanks to you, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_45","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_45","text":"What are you talking about...?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_46","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_46","text":"Our center had used to have a number of issues.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_47","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_47","text":"We were making money off of the children, but we weren't particularly good at it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_48","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_48","text":"The children would either die, or they had to reach a certain age before they could bring in any money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_49","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_49","text":"Back then, I was actually raising the children with my own money!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_50","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_50","text":"Ridiculous, right? I'm not a philanthropist, haha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_51","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_51","text":"Some of them would even get scared and run away. From a business standpoint, it was a complete loss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_52","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_52","text":"And that's when I reached out to you, Commander. Hehe.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_53","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_53","text":"Meaning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_54","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_54","text":"You thought I was suspicious even then, didn't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_55","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_55","text":"Because you were.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_56","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_56","text":"That's right! I was suspicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_57","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_57","text":"People who do this kind of work tend to get used to their circumstances. They stop feeling any sense of danger.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_58","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_58","text":"Once that happens, they lose the ability to distinguish between what looks suspicious and what's perfectly normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_59","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_59","text":"But thanks to you, Commander, I realized something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_60","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_60","text":"The thought hit me, \"Oh, this won't do. At this rate, I'm going to get caught.\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_61","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_61","text":"I wasn't about to get dragged off to the Rehabilitation Center. I hadn't even made that much money yet!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_62","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_62","text":"So I took care of everything that might look suspicious from the outside,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_63","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_63","text":"and I started raising the children properly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_64","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_64","text":"As assassins, of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_65","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_65","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_66","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_66","text":"People are interesting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_67","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_67","text":"If someone steals a piece of candy, they think it was a child,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_68","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_68","text":"and if someone kills someone, they think it was an adult.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_69","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_69","text":"See, when a crime is committed, people usually look at whoever is most likely to have a motive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_70","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_70","text":"I took advantage of that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_71","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_71","text":"And I have you to thank for all of this, Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_72","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_72","text":"Don't be ridiculous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_73","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_73","text":"Why is it ridiculous?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_74","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_74","text":"Everything needs a catalyst, after all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_75","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_75","text":"Children who were once abused and considered worthless now have a home in this center, where they can laugh and play.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_76","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_76","text":"Thank you for being our catalyst.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_77","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_78","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_78","text":"This is going nowhere.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_79","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_79","text":"She's just trying to rattle me. I need to ignore it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_80","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_80","text":"So what's your point?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_81","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_81","text":"Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_82","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_82","text":"I think you and I are a good match,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_83","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_83","text":"so I'd like to make you an offer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_84","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_84","text":"Be my business partner.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_85","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_85","text":"Your business partner?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_86","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_86","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_87","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_87","text":"I doubt being a Commander pays all that well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_88","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_88","text":"Seeing how you risk your life for a living, I'm sure your expenses add up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_89","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_89","text":"I'll give you thirty percent each month.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_90","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_90","text":"Based on last month, that would be about... this much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_91","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_91","text":"Jennifer shows me a calculator with a number on it that's far larger than I expected.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_92","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_92","text":"It's a lot, isn't it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_93","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_93","text":"In a society where money brings with it power, this amount is more than enough to change your life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_94","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_94","text":"The children get to live in a warm home, and we continue to make a lot of money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_95","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_95","text":"You want me to take the money and keep my mouth shut?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_96","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_96","text":"Well, I suppose you could think of it that way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_97","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_97","text":"I don't mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_98","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_98","text":"What matters is this: I'm offering you a huge share of the life I've built.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_99","type":"Self","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_99","text":"... Sorry, but I'm not the type to be swayed by money.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_100","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_100","text":"Oh, is that so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_101","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_101","text":"Then you leave me no other choice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_102","type":"Speech","speaker":"jennifer","key":"Locale_SubScenario:event_ce008_2_04_e_102","text":"Come in, children.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_103","type":"Narration","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_103","text":"*Creeeak*","jump":null,"exit":false,"enter":null,"bg":"GoodOffice_n","bgArt":"goodoffice_n","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_104","type":"Monologue","speaker":null,"key":"Locale_SubScenario:event_ce008_2_04_e_104","text":"The door I came in through earlier opened.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_105","type":"Speech","speaker":"jane","key":"Locale_SubScenario:event_ce008_2_04_e_105","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["jane","rane"],"affinity":null},{"id":"event_ce008_2_04_e_106","type":"Speech","speaker":"rane","key":"Locale_SubScenario:event_ce008_2_04_e_106","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_ce008_2_04_e_107","type":"Monolog