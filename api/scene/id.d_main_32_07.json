ie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_29","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_29","text":"You heard me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_30","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_30","text":"Oh, I was... around.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_31","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_31","text":"Were you there the whole time?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_32","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_32","text":"... Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_33","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_33","text":"Then how is it that you only found out just now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_34","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_34","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_35","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_35","text":"Don't you dare give me more vague platitudes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_36","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_36","text":"Where were you? Tell me the truth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_37","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_37","text":"I just...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_38","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_38","text":"Spit it out!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_39","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_39","text":"I... went to Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_40","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_40","text":"Eden?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_41","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_41","text":"Are you out of your mind?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_42","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_42","text":"Why would you go there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_43","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_43","text":"What did you do there?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_44","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_44","text":"Nothing much. Just said hi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_45","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_45","text":"Ugh, this is like pulling teeth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_46","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_46","text":"Honestly! I just said hi, that's all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_47","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_47","text":"Were you followed?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_48","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_48","text":"No. I'm certain of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_49","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_49","text":"Okay, that's a relief, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_50","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_50","text":"*Sigh*... Sometimes I don't know what to do with you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_51","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_51","text":"I told you to keep a close eye on that entire area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_52","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_52","text":"You know that's the closest area to the tunnel. If anything were to go wrong, it would happen there first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_53","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_53","text":"I even planted crystals there! Do you have any idea how valuable those are?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_54","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_54","text":"Yes, I know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_55","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_55","text":"If you knew that, then why did you wander off somewhere else?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_56","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_56","text":"Because this place is boring. There's nothing here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_57","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_57","text":"What do you think you'll possibly find elsewhere that will be so fun?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_58","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_58","text":"We promised each other that we'd try to do our best, and you're already unable to resist temptation?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_59","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_59","text":"You've got to straighten up. I gave you the area closest to the tunnel precisely because you said you were bored.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_60","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_60","text":"Okay, okay. Sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_61","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_61","text":"Still, I found the coffin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_62","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_62","text":"*Sigh*...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_63","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_63","text":"So now we need to find a way to open it, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_64","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_64","text":"Yes. If we were to force it open, we could potentially kill Anachiro, so I'm leaving it be for now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_65","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_65","text":"However, I don't think that woman will tell me how to open this thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_66","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_66","text":"Open it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_67","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_67","text":"Did you hear me? I said that would kill her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_68","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_68","text":"And? You're talking like we know her personally.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_69","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_69","text":"All we need is her body,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_70","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_70","text":"so just open it already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_71","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_71","text":"Dead or alive, we can still use her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_72","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_72","text":"But don't you think she could teach us a few things?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_73","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_73","text":"I doubt it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_74","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_74","text":"She could make a good addition to our team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_75","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_75","text":"She's a dinosaur. I don't want any old geezers on our team.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_76","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_76","text":"Why not? It'd be nice to have an addition to the family.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_77","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_77","text":"Pssh, the only reason you would even semi-want that is because you're so lonely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_78","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_