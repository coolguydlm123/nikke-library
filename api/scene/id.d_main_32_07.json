,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_14","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_14","text":"I found this, but I have no clue how to open it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_15","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_15","text":"What's inside it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_16","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_16","text":"Anachiro.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_17","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_17","text":"She's sleeping inside this thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_18","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_19","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_19","text":"You found it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_20","type":"Speech","speaker":"behemoth","key":"Locale_MainScenario:d_main_32_07_20","text":"Yeah.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_32_07_21","type":"Speech","speaker":"soundonly","key":"Locale_MainScenario:d_main_32_07_21","text":"How?","jum