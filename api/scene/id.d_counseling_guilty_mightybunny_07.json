{"id":"d_counseling_guilty_mightybunny_07","cat":"counsel","group":{"id":"char5182","label":"Guilty: Mighty Bunny"},"label":"Advising Guilty: Mighty Bunny: 07","stage":null,"prev":"d_counseling_guilty_mightybunny_06","next":"d_counseling_guilty_mightybunny_08","speakers":{"guilty_b":"Guilty"},"icons":{"guilty_b":"si_c404_00_s"},"lines":[{"id":"d_counseling_guilty_mightybunny_07_1","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_1","text":"They say the bunnies who rank lower in rabbit hierarchies groom those who rank higher.","jump":null,"exit":false,"enter":null,"bg":"CoinRushMainHall","bgArt":"coinrushmainhall","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["guilty_b"],"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_2","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_2","text":"Which is why I wanna just...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_3","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_3","text":"*Lick*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_4","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_4","text":"G-Guilty?!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_5","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_5","text":"How does it feel getting licked by me, Counselor?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_6","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_6","text":"Pretty good, I guess.","jump":"d_counseling_guilty_mightybunny_07_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_guilty_mightybunny_07_7","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_7","text":"Let me groom you instead.","jump":"d_counseling_guilty_mightybunny_07_10","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_guilty_mightybunny_07_8","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_8","text":"You guess...? You aren't sure?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_9","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_9","text":"I thought you'd be happier about it.","jump":"d_counseling_guilty_mightybunny_07_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_10","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_10","text":"Huh...? No, lower-ranking rabbits are supposed to groom the higher-ranking ones...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_11","type":"Self","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_11","text":"I'm your counselor, Guilty. It's my responsibility to help with your rehabilitation. That doesn't somehow put me above you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_12","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_12","text":"Heheh... Well in that case... now I'm excited.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_13","type":"Speech","speaker":"guilty_b","key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_13","text":"All right, Counselor... You're up.","jump":"d_counseling_guilty_mightybunny_07_15","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_14","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_14","text":"Guilty closes her eyes and leans her head toward me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_guilty_mightybunny_07_15","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_guilty_mightybunny_07_15","text":"Guilty and I spend time together grooming each other like rabbits.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}