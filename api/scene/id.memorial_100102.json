{"id":"memorial_100102","cat":"memorial","group":{"id":"memorial100100","label":"Memoirs · A Man's Memoir"},"label":"August 21, XX.","stage":null,"prev":"memorial_100101","next":"memorial_100103","speakers":{},"icons":{},"lines":[{"id":"memorial_100102_1","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_02_description","text":"No one has come to my rescue."},{"id":"memorial_100102_2","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_02_description","text":"Has the army been defeated?"},{"id":"memorial_100102_3","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_02_description","text":"That can't be. The TV said we were winning the war against the Raptures."},{"id":"memorial_100102_4","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_02_description","text":"They just haven't found me yet."},{"id":"memorial_100102_5","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_02_description","text":"I have to try to make the SOS signal stronger."},{"id":"memorial_100102_6","type":"Speech","speaker":null,"key":"Locale_Memorial:memorial_01_02_description","text":"I'm a bit worried about the power, but help will be here soon enough. Everything will work out in the end."}]}