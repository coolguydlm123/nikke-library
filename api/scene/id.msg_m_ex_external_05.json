{"id":"msg_m_ex_external_05","cat":"messenger","group":{"id":"room_external","label":"Extrinsic · Group"},"label":"5. Partner,","stage":null,"prev":"msg_m_ex_external_04","next":null,"speakers":{"guillotine":"Guillotine","maiden":"Maiden"},"icons":{"guillotine":"si_c180_00_s","maiden":"si_c181_00_s"},"lines":[{"id":"m_ex_external_05_1","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_1","text":"Partner,","jump":null},{"id":"m_ex_external_05_2","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_2","text":"I think the time for judgment has come.","jump":null},{"id":"m_ex_external_05_3","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_3","text":"??","jump":null},{"id":"m_ex_external_05_4","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_4","text":"Guillotine,","jump":null},{"id":"m_ex_external_05_5","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_5","text":"this isn't a courtroom.","jump":null},{"id":"m_ex_external_05_6","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_6","text":"No one here","jump":null},{"id":"m_ex_external_05_7","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_7","text":"needs your judgment.","jump":null},{"id":"m_ex_external_05_8","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_8","text":"Haha!","jump":null},{"id":"m_ex_external_05_9","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_9","text":"The One-Winged Dark Lord does not make mistakes.","jump":null},{"id":"m_ex_external_05_10","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_10","text":"The one who will receive judgment tonight","jump":null},{"id":"m_ex_external_05_11","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_11","text":"is Red Rose.","jump":null},{"id":"m_ex_external_05_12","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_12","text":"Yes, Maiden, you!","jump":null},{"id":"m_ex_external_05_13","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_13","text":"...","jump":null},{"id":"m_ex_external_05_14","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_14","text":"I can't take much more of this.","jump":null},{"id":"m_ex_external_05_15","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_15","text":"Don't worry about it.","jump":"m_ex_external_05_17"},{"id":"m_ex_external_05_16","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_16","text":"You must endure, for that is the destiny of the Red Rose.","jump":"m_ex_external_05_19"},{"id":"m_ex_external_05_17","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_17","text":"That's easy for you to say.","jump":null},{"id":"m_ex_external_05_18","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_18","text":"You don't have to deal with her ramblings day in and day out.","jump":"m_ex_external_05_21"},{"id":"m_ex_external_05_19","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_19","text":"Not you too,","jump":null},{"id":"m_ex_external_05_20","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_20","text":"Commander!","jump":"m_ex_external_05_21"},{"id":"m_ex_external_05_21","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_21","text":"What's gotten into Guillotine this time?","jump":null},{"id":"m_ex_external_05_22","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_22","text":"Beats me.","jump":null},{"id":"m_ex_external_05_23","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_23","text":"What did I do to deserve this?","jump":null},{"id":"m_ex_external_05_24","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_24","text":"If your memory fails you,","jump":null},{"id":"m_ex_external_05_25","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_25","text":"allow me to refresh it for you.","jump":null},{"id":"m_ex_external_05_26","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_26","text":"That day, the fog was unusually thick.","jump":null},{"id":"m_ex_external_05_27","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_27","text":"Not a single strand of light could penetrate its thick malaise.","jump":null},{"id":"m_ex_external_05_28","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_28","text":"An extraordinarily tranquil night,","jump":null},{"id":"m_ex_external_05_29","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_29","text":"as if not a single spark of life was left.","jump":null},{"id":"m_ex_external_05_30","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_30","text":"That's when I heard it.","jump":null},{"id":"m_ex_external_05_31","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_31","text":"The cries of a rose trapped in the dungeon.","jump":null},{"id":"m_ex_external_05_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_32","text":"Are you saying you heard Maiden's voice?","jump":null},{"id":"m_ex_external_05_33","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_33","text":"That's right.","jump":null},{"id":"m_ex_external_05_34","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_34","text":"At first, I thought my ears deceived me.","jump":null},{"id":"m_ex_external_05_35","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_35","text":"So horrific were the screeches,","jump":null},{"id":"m_ex_external_05_36","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_36","text":"that I tried to ignore it at first.","jump":null},{"id":"m_ex_external_05_37","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_37","text":"Even the One-Winged Dark Lord in my right eye","jump":null},{"id":"m_ex_external_05_38","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_38","text":"remained silent.","jump":null},{"id":"m_ex_external_05_39","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_39","text":"What did you hear?","jump":null},{"id":"m_ex_external_05_40","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_40","text":"That's it.","jump":null},{"id":"m_ex_external_05_41","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_41","text":"I'm done","jump":null},{"id":"m_ex_external_05_42","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_42","text":"with this conversation.","jump":null},{"id":"m_ex_external_05_43","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_43","text":"I'm leaving.","jump":null},{"id":"m_ex_external_05_44","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_44","text":"Are you running away,","jump":null},{"id":"m_ex_external_05_45","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_45","text":"Corrupted Red Rose?","jump":null},{"id":"m_ex_external_05_46","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_46","text":"Enough with the ridiculous nicknames!","jump":null},{"id":"m_ex_external_05_47","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_47","text":"Were you dreaming?","jump":null},{"id":"m_ex_external_05_48","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_48","text":"Haha.","jump":null},{"id":"m_ex_external_05_49","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_49","text":"I would rather it be a dream.","jump":null},{"id":"m_ex_external_05_50","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_50","text":"But I saw and heard it all too clearly.","jump":null},{"id":"m_ex_external_05_51","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_51","text":"Slipping through the darkness,","jump":null},{"id":"m_ex_external_05_52","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_52","text":"covered in a blanket from head to toe,","jump":null},{"id":"m_ex_external_05_53","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_53","text":"was she, the one and only corrupted rose.","jump":null},{"id":"m_ex_external_05_54","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_54","text":"Much like a disembodied voice,","jump":null},{"id":"m_ex_external_05_55","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_55","text":"floating in another world.","jump":null},{"id":"m_ex_external_05_56","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_56","text":"!!","jump":null},{"id":"m_ex_external_05_57","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_57","text":"You were playing a game!","jump":null},{"id":"m_ex_external_05_58","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_58","text":"That's right.","jump":null},{"id":"m_ex_external_05_59","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_59","text":"So deeply was she immersed in that world","jump":null},{"id":"m_ex_external_05_60","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_60","text":"that she wasn't even aware that","jump":null},{"id":"m_ex_external_05_61","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_61","text":"her own voice was","jump":null},{"id":"m_ex_external_05_62","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_62","text":"disturbing the One-Winged Dark Lord.","jump":null},{"id":"m_ex_external_05_63","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_63","text":"Did you record it by any chance?","jump":null},{"id":"m_ex_external_05_64","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_64","text":"What are you talking about?!","jump":null},{"id":"m_ex_external_05_65","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_65","text":"Partner.","jump":null},{"id":"m_ex_external_05_66","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_66","text":"Of course I did.","jump":null},{"id":"m_ex_external_05_67","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_67","text":"If you come to my location, I shall let you hear it.","jump":null},{"id":"m_ex_external_05_68","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_68","text":"Where are you? I'll come right away.","jump":null},{"id":"m_ex_external_05_69","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_69","text":"Where the crescent moon rises,","jump":null},{"id":"m_ex_external_05_70","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_70","text":"where the shadow of the church steeple is visible,","jump":null},{"id":"m_ex_external_05_71","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_71","text":"you will find me and the One-Winged Dark Lord.","jump":null},{"id":"m_ex_external_05_72","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_external_05_72","text":"Okay.","jump":null},{"id":"m_ex_external_05_73","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_73","text":"No!","jump":null},{"id":"m_ex_external_05_74","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_74","text":"Wait!","jump":null},{"id":"m_ex_external_05_75","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_75","text":"I'm certain","jump":null},{"id":"m_ex_external_05_76","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_76","text":"Guillotine is lying about the recording.","jump":null},{"id":"m_ex_external_05_77","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_77","text":"She's just teasing me...","jump":null},{"id":"m_ex_external_05_78","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_78","text":"aren't you?","jump":null},{"id":"m_ex_external_05_79","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_79","text":"\"Ah, nice!\"","jump":null},{"id":"m_ex_external_05_80","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_80","text":"\"Scarlet Peach Pie\"","jump":null},{"id":"m_ex_external_05_81","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_81","text":"Argh!!","jump":null},{"id":"m_ex_external_05_82","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_82","text":"\"I'll buff you right now\"","jump":null},{"id":"m_ex_external_05_83","type":"Speech","speaker":"guillotine","key":"Locale_SuddenMessage:m_ex_external_05_83","text":"\"Huh?\"","jump":null},{"id":"m_ex_external_05_84","type":"Speech","speaker":"maiden","key":"Locale_SuddenMessage:m_ex_external_05_84","text":"Stop!","jump":null},{"id":"m_ex_external_05_85","type":"Speech","speaker":"guillotine","key":"Lo