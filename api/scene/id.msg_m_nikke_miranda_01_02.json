{"id":"msg_m_nikke_miranda_01_02","cat":"messenger","group":{"id":"room_mr0","label":"Mr. 0 · Chat"},"label":"2. Is it really you, Leader?","stage":null,"prev":"msg_m_nikke_miranda_01_01","next":null,"speakers":{"miranda":"Miranda","mr0":"Mr. 0"},"icons":{"miranda":"si_c032_00_s"},"lines":[{"id":"m_nikke_miranda_01_02_1","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_1","text":"Is it really you, Leader?","jump":null},{"id":"m_nikke_miranda_01_02_2","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_2","text":"Yes.","jump":null},{"id":"m_nikke_miranda_01_02_3","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_3","text":"Anyway, Miranda.","jump":null},{"id":"m_nikke_miranda_01_02_4","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_4","text":"Yes! I'm not Anyway Miranda, but Miranda!","jump":null},{"id":"m_nikke_miranda_01_02_5","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_5","text":"Well, Miranda.","jump":null},{"id":"m_nikke_miranda_01_02_6","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_6","text":"Not Well Miranda, but...","jump":null},{"id":"m_nikke_miranda_01_02_7","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_7","text":"Enough!","jump":null},{"id":"m_nikke_miranda_01_02_8","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_8","text":"Yes.","jump":null},{"id":"m_nikke_miranda_01_02_9","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_9","text":"Please leave the A.C.P.U. now.","jump":null},{"id":"m_nikke_miranda_01_02_10","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_10","text":"Wh-why?","jump":null},{"id":"m_nikke_miranda_01_02_11","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_11","text":"What why? There is no need to supervise there anymore.","jump":null},{"id":"m_nikke_miranda_01_02_12","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_12","text":"There haven't been any major problems during the supervision period.","jump":null},{"id":"m_nikke_miranda_01_02_13","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_13","text":"It's just a waste of manpower to continue.","jump":null},{"id":"m_nikke_miranda_01_02_14","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_14","text":"And...","jump":null},{"id":"m_nikke_miranda_01_02_15","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_15","text":"It must be a burden for the A.C.P.U. that you are always there.","jump":null},{"id":"m_nikke_miranda_01_02_16","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_16","text":"No, it's not.","jump":null},{"id":"m_nikke_miranda_01_02_17","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_17","text":"No? How come?","jump":null},{"id":"m_nikke_miranda_01_02_18","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_18","text":"I heard that you directed traffic and it only became messier.","jump":null},{"id":"m_nikke_miranda_01_02_19","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_19","text":"You looked for the missing children and ended up getting lost yourself.","jump":null},{"id":"m_nikke_miranda_01_02_20","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_20","text":"I'm not a burden anymore! Really!","jump":null},{"id":"m_nikke_miranda_01_02_21","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_21","text":"I don't believe it.","jump":null},{"id":"m_nikke_miranda_01_02_22","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_22","text":"Then I'll prove it to you!","jump":null},{"id":"m_nikke_miranda_01_02_23","type":"Speech","speaker":"mr0","key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_23","text":"Hmm?","jump":null},{"id":"m_nikke_miranda_01_02_24","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:m_nikke_miranda_01_02_24","text":"I'm working really hard here!","jump":null}],"chat":true}