:null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_intermission_01_139","type":"Choice","speaker":null,"key":"Locale_MainScenario:event_coinsinrush1_intermission_01_139","text":"I-is that so?","jump":"event_coinsinrush1_intermission_01_141","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_intermission_01_140","type":"Choice","speaker":null,"key":"Locale_MainScenario:event_coinsinrush1_intermission_01_140","text":"Mm. Exactly as a maid should be.","jump":"event_coinsinrush1_intermission_01_141","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_intermission_01_141","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush1_intermission_01_141","text":"Oh! Now that you've joined, the team's looking pretty darn good.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_intermission_01_142","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush1_intermission_01_142","text":"Me, Pal, and Ade are running the field,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_intermission_01_143","type":"Speech","speaker":"milk_b","key":"Locale_MainScenario:event_coinsinrush1_intermission_01_143","text":"while Exia handles intel from the base.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_coinsinrush1_intermission_01_144","type":"Speech","speaker":"exia_b","key":"Locale_MainScenario:event_coinsinrush1_intermission_01_144","text":"Yaaay...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,