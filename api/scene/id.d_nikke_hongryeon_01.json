{"id":"d_nikke_hongryeon_01","cat":"bond","group":{"id":"char5041","label":"Scarlet"},"label":"Sticking Your Neck Out","stage":null,"prev":null,"next":"d_nikke_hongryeon_02","speakers":{"hongryeon":"Scarlet","privaty":"Privaty","rapi":"Rapi","anis":"Anis","neon":"Neon"},"icons":{"hongryeon":"si_c222_00_s","privaty":"si_c170_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","neon":"si_c011_00_s"},"lines":[{"id":"d_nikke_hongryeon_01_1","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_1","text":"Now then, ye maidens. I shall not say it twice.","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":"bgm_enemyclose","movie":null,"shown":["hongryeon","privaty","rapi"],"affinity":null},{"id":"d_nikke_hongryeon_01_2","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_2","text":"Move but a finger,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_3","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_3","text":"and the life of the lad ye hold so dear shall be forfeit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_4","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_4","text":"So still thy tongues, and lend me thine ears.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_5","type":"Speech","speaker":"privaty","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_5","text":"Ugh...!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_6","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_6","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_7","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_7","text":"Right now, a gleaming blade","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_8","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_8","text":"is aimed at my neck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_9","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_9","text":"If I so much as move, my head will be gone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_10","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_10","text":"Aye, that's it. Hold thy places, all of ye.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_11","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_11","text":"*Ding*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_12","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_12","text":"The elevator door opens.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_13","type":"Speech","speaker":"privaty","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_13","text":"Commander!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_14","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_14","text":"Oho!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_15","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_15","text":"The blade draws ever closer to your neck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_16","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_17","type":"Speech","speaker":"privaty","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_17","text":"You... coward!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_18","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_18","text":"Hoho, what praise is this thou bestowest?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_19","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_19","text":"With a sword at my neck, Scarlet backs into the elevator.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_20","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_20","text":"Well then, ye maidens,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_21","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_21","text":"fare thee well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_22","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_22","text":"With that, the elevator doors close.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_23","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_23","text":"*Whew*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_24","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_24","text":"At that moment, a sense of adrenaline washes over me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi","anis","neon"],"affinity":null},{"id":"d_nikke_hongryeon_01_25","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_25","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_26","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_26","text":"A week earlier...","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_27","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_27","text":"Well met, my good Lord.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_menu_commandersroom","movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_01_28","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_28","text":"Let us sup a draught or two!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_29","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_29","text":"Here? Now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_30","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_30","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_31","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_31","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_32","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_32","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_33","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_33","text":"Now then, what spirits hast thou to set afore me this day?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_34","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_34","text":"Let them, if it may be, be a touch stronger than those we partook of aforetime.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_35","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_35","text":"Good grief...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_36","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_36","text":"You seem to come here pretty often for a Pilgrim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_37","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_37","text":"It hath been but three days since I was last hither, so whatever dost thou mean by \"often\"?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_38","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_38","text":"I missed this place so much that i wash mine face with drops of sorrow during mine slumber.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_39","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_39","text":"I'd bet you were drooling in your sleep at the thought of drinking!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_40","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_40","text":"Oho, what barbed wit!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_41","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_41","text":"Wouldn't thou agree that it is nice to share a drink with friends?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_42","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_42","text":"Sure, but I still say you're here way too often.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_43","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_43","text":"Is there a problem, perchance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_44","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_44","text":"No, it's just that...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_45","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_45","text":"How do I put this? It just seems that there's less mystique to the word Pilgrim now.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_46","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_46","text":"This is but a word. One conjured within thy imagination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_47","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_47","text":"I be a Nikke. Thou art a Nikke. We are all Nikkes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_48","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_48","text":"Pilgrim is naught but mere skimble-skamble. Hence, why should'st we be classified this way when we are all growing older together?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_49","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_49","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_50","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_50","text":"That's right. If you think about it, we've all been dealt the same rotten hand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_51","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_51","text":"Hear, hear!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_52","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_52","text":"Food's ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_53","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_53","text":"There's Splendamin with flavors, like pizza, hamburger and chocolate. So what are you craving for?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_54","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_54","text":"Oh, aught is fine.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_55","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_55","text":"Better yet, serve me some spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_56","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_56","text":"I hast brought along some things from the surface today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_57","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_57","text":"... Did you really now?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_58","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_58","text":"Let us see now...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_nikke_hongryeon_01_59","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_59","text":"Scarlet starts rummaging through her pockets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_60","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_60","text":"Oh, here it is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_61","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_61","text":"With that, Scarlet pulls out","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_62","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_62","text":"a colorful fruit of some sort.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_63","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_63","text":"A fruit...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_64","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_64","text":"What... is this?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_65","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_65","text":"I doth believe \"fruit\" is its appellation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_66","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_66","text":"No, that can't be right. Aren't fruits usually squishy and come in a cup?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_67","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_67","text":"That's fruit-flavored Splendamin.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_68","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_68","text":"Oh, right...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_69","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_69","text":"Since the ancient times, naught is better than having fruits when one drinks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_70","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_70","text":"So, if thou shall, please bring out thy finest spirits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_71","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_71","text":"I'll bring some out. Be right back.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_72","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_72","text":"Oh, yes please.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_73","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_73","text":"Rapi makes her way toward a certain direction.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_74","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_74","text":"Wow! Who knows when was the last time I've seen a fresh fruit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_75","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_75","text":"Well, thou hast been good to me, so I pulled some strings to make this happen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_76","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_76","text":"In that case, let us drink and be merry today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_77","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_77","text":"After saying so, this meeting with Scarlet goes on for a long time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_78","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_78","text":"5 days ago...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_01_79","type":"Speech","speaker":"hongryeon","key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_79","text":"Worthy fellow, wouldst thou care for some spirits?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_whosdumber","movie":null,"shown":["hongryeon"],"affinity":null},{"id":"d_nikke_hongryeon_01_80","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_01_80","text":"Sure, come on!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,