{"id":"d_main_09af_01","cat":"main","group":{"id":"ch9","label":"Chapter 9 · Secret"},"label":"Restraint","stage":null,"prev":"d_main_09_06_e","next":"d_main_09af_02","speakers":{"privaty":"Privaty","rapi":"Rapi","Self":"Commander","anis":"Anis","yulha":"Yulha","neon":"Neon","admi":"Admi","Narration":"Narration"},"icons":{"privaty":"si_c170_00_s","rapi":"si_c010_00_s","anis":"si_c012_00_s","yulha":"si_c171_00_s","neon":"si_c011_00_s","admi":"si_c172_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_main_09af_01_1","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_1","text":"Stop.","jump":null,"exit":false,"enter":null,"bg":"ElevatorOut","bgArt":"elevatorout","image":null,"bgm":"bgm_story_stormbreakers","movie":null,"shown":["privaty","rapi","yulha","admi","anis","neon"],"affinity":null},{"id":"d_main_09af_01_2","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_2","text":"What is it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_3","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_3","text":"Please explain why you went up to the surface without permission.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_4","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_4","text":"Have you not heard of the Commando unit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_5","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_5","text":"I have. However...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_6","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_6","text":"We have a certain degree of autonomy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_7","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_7","text":"In other words, Triangle has no right to question our actions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_8","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_8","text":"You may be a Commando unit,\nbut Triangle is no ordinary unit either. We are part of the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_9","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_9","text":"Therefore, we have the right to question you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_10","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_10","text":"I haven't received any prior notice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_11","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_11","text":"Did you, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_12","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_09af_01_12","text":"No, I haven't.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_01_13","text":"Did you hear that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_14","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_14","text":"It sounds to me like you're not going to cooperate with us. Am I correct in that assumption?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_15","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_15","text":"Why should we have to listen to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_16","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_16","text":"Privaty,\nlet's just haul them off.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_17","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_17","text":"Hell, we can just shoot them right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_18","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_18","text":"Like we did with that hacker.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_19","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_19","text":"What was her name again... Exia, was it?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_01_20","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_21","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_21","text":"What's wrong?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_22","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_22","text":"You didn't know her, did you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_23","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_23","text":"Did you have any secret video communications with her?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_24","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_01_24","text":"Can you make any sense of what she's saying?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_25","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_09af_01_25","text":"No idea.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_26","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_26","text":"Anyways, we need to question you.\nI suggest you follow us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_27","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_27","text":"If you want us to do anything,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_28","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_28","text":"you need to show me an official notice formally issued from the Deputy Chief or above.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_29","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_29","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_30","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_09af_01_30","text":"Let's go, Privaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_31","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_09af_01_31","text":"We're not getting anywhere with this.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_32","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_32","text":"I'm not finished with you, Rapi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_33","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_33","text":"I should have known you wouldn't fall for a dirty trick like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_34","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_34","text":"Not finished with me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_35","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_35","text":"That's right. We're sworn enemies, you and I. The current score is...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_36","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_09af_01_36","text":"Rapi had her memories erased.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_37","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_37","text":"!!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_38","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_38","text":"The current score is 21 to 0. Naturally, I'm in the lead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_39","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_39","text":"Huh? Isn't it the opposite?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_40","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_40","text":"Yulha. Be quiet.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_41","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_41","text":"However, since you had your memory erased,\nI will wipe the slate clean for your sake.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_42","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_42","text":"So, do try harder going forward.\nI'll enjoy a little challenge.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_43","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_43","text":"Don't let me down!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_44","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_44","text":"Let's go, everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_45","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_45","text":"... Tsk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_46","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_46","text":"Let's go, Admi.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_47","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_09af_01_47","text":"Yes, Yulha.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_48","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_09af_01_48","text":"What a letdown.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_49","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_49","text":"Ah, and one more thing, Counters.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_50","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_09af_01_50","text":"The Central Government is always watching. Keep that in mind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_51","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_09af_01_51","text":"The Triangle Squad leaves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_52","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_01_52","text":"If that's true, what would be the point of appointing us as a Commando unit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_53","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_53","text":"Seems like we're not very popular amongst the Central Government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_54","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_01_54","text":"You think this type of thing will happen often?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_55","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_55","text":"Most likely.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_56","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_09af_01_56","text":"What a pain in the neck...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_57","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_09af_01_57","text":"Let's go. We need to check if Exia is alive.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_58","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_09af_01_58","text":"Since we have to check if Exia is alive,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_09af_01_59","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_09af_01_59","text":"we should speak with Andersen.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}