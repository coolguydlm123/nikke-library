{"id":"d_main_49_02","cat":"main","group":{"id":"ch49","label":"Chapter 49 · Final Battle"},"label":"Time to Believe","stage":"49-11 STAGE · End","prev":"d_main_49_01","next":"d_main_49_03","speakers":{"eh_n":"E.H.","outerrimman":"Outer Rim Citizen","viper":"Viper","jackal":"Jackal","ingrid_op":"Ingrid","syuen_op":"Syuen","mustang_op":"Mustang","privaty":"Privaty","yulha":"Yulha","admi":"Admi"},"icons":{"eh_n":"si_c113_00_s","outerrimman":"si_c918_00_s","viper":"si_c112_00_s","jackal":"si_c111_00_s","ingrid_op":"si_c900_00_s","syuen_op":"si_c901_00_s","mustang_op":"si_c902_00_s","privaty":"si_c170_00_s","yulha":"si_c171_00_s","admi":"si_c172_00_s"},"lines":[{"id":"d_main_49_02_1","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_1","text":"Please just cooperate. I'm begging you.","jump":null,"exit":false,"enter":null,"bg":"OuterRim","bgArt":"outerrim","image":null,"bgm":"bgm_story_outerrim","movie":null,"shown":["jackal","viper","eh_n","outerrimman"],"affinity":null},{"id":"d_main_49_02_2","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_2","text":"No. I refuse.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_3","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_3","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_4","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_4","text":"All of you here feel the same way?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_5","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_5","text":"E.H. looks out over the dozens of people gathered in the square.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_6","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_6","text":"They all look back at her with determination in their eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_7","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_7","text":"... I'll take that as a yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_8","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_8","text":"I don't get it. Why are you all acting like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_9","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_9","text":"We were born in the Outer Rim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_10","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_10","text":"We've lived here our whole lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_11","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_11","text":"The Ark is no more than a fantasy to us. We only know it by name, but that's it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_12","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_12","text":"In other words, this is all there is to our world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_13","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_13","text":"The Outer Rim is our world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_14","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_14","text":"We don't want to leave our world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_15","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_15","text":"There's a saying...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_16","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_16","text":"Those who spend a long time in prison eventually come to see it as their home. They don't want to leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_17","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_17","text":"We feel the same way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_18","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_18","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_19","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_20","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_20","text":"We will accept our fate here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_21","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_21","text":"We appreciate what you're trying to do. We're truly grateful that you're trying to save our miserable little lives.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_22","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_22","text":"But we've made up our minds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_23","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_23","text":"We've decided to lay ourselves to rest in the Outer Rim, our world.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_24","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_24","text":"E.H. looks again at the faces of those gathered in the square.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_25","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_25","text":"She makes eye contact with each and every one of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_26","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_26","text":"Their eyes filled with unwavering determination.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_27","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_28","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_28","text":"... All right. I understand how you feel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_29","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_29","text":"So be it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_30","type":"Speech","speaker":"outerrimman","key":"Locale_MainScenario:d_main_49_02_30","text":"Thank you. Instead of worrying about people like us—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_31","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_31","text":"Jackal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_32","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_32","text":"Yep!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_33","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_33","text":"Jackal kicks off the ground, leaping into the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_34","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_34","text":"*Wham! Pow! Thwack! Crash! Bang!*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_35","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_35","text":"In the blink of an eye, Jackal knocks everyone in the square unconscious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_36","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_36","text":"Silence falls over the square.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_37","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_37","text":"So we just gotta move them?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_38","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_38","text":"No, leave them. I'll contact Underworld Queen and have them send their people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_39","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_39","text":"I don't even know how many times we've had to do this already.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_40","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_40","text":"Do these people like the Outer Rim thaaat much?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_41","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_41","text":"It's not that I don't understand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_42","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_42","text":"Infinite possibilities can instill infinite fear in some people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_43","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_43","text":"So we're just throwing them into a world of never-ending fear? Without their permission?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_44","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_44","text":"Yes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_45","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_45","text":"They're gonna resent us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_46","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_46","text":"They may resent us, but they'll do so under the real sun.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_47","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_47","text":"... ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_48","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_48","text":"Let's go. We have to get this done today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_49","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_49","text":"What's with the sudden rush?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_50","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_50","text":"You'd think we were ascending tomorrow or something.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_51","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_51","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_52","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_52","text":"Wait, seriously?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_53","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_53","text":"Things must not be going well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_54","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_54","text":"The Ark probably wanted to be as thoroughly prepared as possible, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_55","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_55","text":"I suppose there's a reason they're in such a rush.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_56","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_56","text":"Whoa, so we're going up to the surface tomorrow?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_57","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_57","text":"And we never have to go back underground?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_58","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_58","text":"Yup, probably.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_59","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_59","text":"Whoa!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_60","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_60","text":"Are you that excited?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_61","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_61","text":"Yeah! The surface rocks!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_62","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_62","text":"You can run forever and ever! And there's so much good food!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_63","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_63","text":"There's also so much to do, and all these funny-looking animals up there!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_64","type":"Speech","speaker":"jackal","key":"Locale_MainScenario:d_main_49_02_64","text":"I can't wait to go!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_65","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_65","text":"Haha, I like how easy you are to please! ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_66","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_66","text":"People like you are the ones who'll thrive up there.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_67","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_67","text":"I'm jealous.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_68","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_68","text":"It's easy to become someone who's easy to please, Boss.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_69","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_69","text":"If you stop caring about what you stand to gain or lose, you can be free. ♡","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_70","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_70","text":"That's why you and I will never be free.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_71","type":"Speech","speaker":"viper","key":"Locale_MainScenario:d_main_49_02_71","text":"Haha, you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_72","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_72","text":"Still, I have no intention of sacrificing anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_73","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_73","text":"Let's hurry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_74","type":"Speech","speaker":"eh_n","key":"Locale_MainScenario:d_main_49_02_74","text":"We have to bring everyone to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_75","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_49_02_75","text":"The time has finally come to repay a century of humiliation!","jump":null,"exit":false,"enter":null,"bg":"City_d","bgArt":"city_d","image":null,"bgm":"bgm_story_chapter49_3rdreclamationwar","movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_76","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_49_02_76","text":"Humanity will reclaim the surface!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["privaty"],"affinity":null},{"id":"d_main_49_02_77","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_49_02_77","text":"We'll show them who the surface truly belongs to!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_78","type":"Speech","speaker":"ingrid_op","key":"Locale_MainScenario:d_main_49_02_78","text":"Elysion, the master of tactics, will make those Raptures pay once and for all!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_79","type":"Speech","speaker":"syuen_op","key":"Locale_MainScenario:d_main_49_02_79","text":"\"Advanced\" doesn't begin to cover just how far the Ark's technology has come.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_80","type":"Speech","speaker":"syuen_op","key":"Locale_MainScenario:d_main_49_02_80","text":"It's on a whole other level. There's simply no way we could lose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_81","type":"Speech","speaker":"syuen_op","key":"Locale_MainScenario:d_main_49_02_81","text":"So all of you have nothing to worry about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_82","type":"Speech","speaker":"syuen_op","key":"Locale_MainScenario:d_main_49_02_82","text":"Missilis will deliver the surface to you on a silver platter, so get the celebrations ready.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_83","type":"Speech","speaker":"mustang_op","key":"Locale_MainScenario:d_main_49_02_83","text":"La Third Surface Reclamation War! Coming soon!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_84","type":"Speech","speaker":"mustang_op","key":"Locale_MainScenario:d_main_49_02_84","text":"Le moment that will décider the Ark's future is almost here!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_85","type":"Speech","speaker":"mustang_op","key":"Locale_MainScenario:d_main_49_02_85","text":"Are you scared?! Are you terrified?! Non, don't worry!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_86","type":"Speech","speaker":"mustang_op","key":"Locale_MainScenario:d_main_49_02_86","text":"Tetra's chéries are équipées with Entertainment Power!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_87","type":"Speech","speaker":"mustang_op","key":"Locale_MainScenario:d_main_49_02_87","text":"We'll bring you l'ultimate entertainment: reclaiming the surface!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_88","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_88","text":"Privaty watches the CEOs' announcement for the Third Surface Reclamation War playing on a billboard in the Ark's downtown area.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_89","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_89","text":"Next, a program where key Central Government officials go on about all the benefits that will come after the war.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_90","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_90","text":"Wherever she looks, the message is the same.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_91","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_91","text":"Privaty can't tear her gaze away from the billboard.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_92","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_49_02_92","text":"Somebody lightly taps her on the shoulder.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["yulha","admi"],"affinity":null},{"id":"d_main_49_02_93","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_93","text":"... Oh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_94","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_94","text":"What are you doing? Did you suddenly get the urge to watch TV?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_95","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_95","text":"Sorry. I can't believe I got distracted when we're this busy...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_96","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_96","text":"Let's go. We've got work to do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_97","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_97","text":"Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_98","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_98","text":"Seems like you've got a lot of complaints.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_99","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_99","text":"I... No... That's not true.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_100","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_100","text":"You're quite the liar.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_101","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_101","text":"Wh-what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_102","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_102","text":"Are you unhappy that they're only painting things in a positive light?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_103","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_103","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_104","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_104","text":"Yeah. Everyone's talking like we're sure to win this war and usher in some golden era.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_105","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_105","text":"Of course, I don't disagree with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_106","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_106","text":"We'll win the war, and the Ark will ascend to the surface.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_107","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_107","text":"I'm sure a bright future is waiting for us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_108","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_108","text":"On the other hand, there'll be plenty of bad things in store for us, too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_109","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_109","text":"Most people won't be able to adapt to the sudden change in environment, and we'll be exposing ourselves to all sorts of diseases.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_110","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_110","text":"The notion of what's valuable will change too, throwing our economy into disarray.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_111","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_111","text":"Countless jobs will disappear, and countless others will be created.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_112","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_112","text":"One of the civilians I forcibly evacuated to a shelter earlier said he'd just gotten a job as a mechanic for the Dome of Eternity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_113","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_113","text":"He said he'd worked tirelessly for the last five years despite his difficult circumstances.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_114","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_114","text":"... Now those past five years have all been for nothing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_115","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_115","text":"Honestly, I think the war has far more downsides than benefits—","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_116","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_116","text":"Go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_117","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_117","text":"Wait for us in the executive shelter. You're only getting in our way.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_118","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_118","text":"Yulha...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_119","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_119","text":"Don't go to the regular shelters. That negative attitude of yours could be contagious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_120","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_120","text":"Go on. Leave.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_121","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_121","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_122","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_122","text":"Those downsides you mentioned. We know about them. Everyone does.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_123","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_123","text":"But there's nothing we can do.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_124","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_124","text":"When we only have one choice, what good is there in sitting around complaining about everything?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_125","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_125","text":"You have to do whatever it takes to focus on the positives. Even then, there's no telling whether things will work out.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_126","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_126","text":"Your attitude right now isn't helping at all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_127","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_127","text":"I...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_128","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_128","text":"Privaty.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_129","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_129","text":"Put your trust in the current government.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_130","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_130","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_131","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_131","text":"It was probably just the same when people first came down to the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_132","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_132","text":"Everything must have felt uncertain, and maybe nothing went according to plan...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_133","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_133","text":"Yet somehow, they managed to build the Ark we have today.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_134","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_134","text":"Of course, it's far from perfect, but this place has become home to many people.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_135","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_135","text":"The surface won't be any different.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_136","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_136","text":"At first, there'll be nothing but uncertainty and chaos,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_137","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_137","text":"but soon, everything will go back to normal.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_138","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_138","text":"That's our job and the Central Government's too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_139","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_139","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_140","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_140","text":"I understand. I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_141","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_141","text":"Hmph. You're worse than a kid.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_142","type":"Speech","speaker":"privaty","key":"Locale_MainScenario:d_main_49_02_142","text":"I-I said I'm sorry.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_143","type":"Speech","speaker":"yulha","key":"Locale_MainScenario:d_main_49_02_143","text":"Let's move to the next area. We need to pick up the pace.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_49_02_144","type":"Speech","speaker":"admi","key":"Locale_MainScenario:d_main_49_02_144","text":"...","jump":null,"exit":false,"enter":null,"bg":nu