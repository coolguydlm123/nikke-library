:null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_124","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_liter_05_124","text":"I've got a question.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_125","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_125","text":"Ask away.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_126","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_liter_05_126","text":"How do you want people to remember you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_127","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_127","text":"Me?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_128","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_128","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_129","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_129","text":"Heh heh.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_130","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_130","text":"I shall say no more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_131","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_131","text":"The things I've left behind will speak on my behalf.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_132","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_132","text":"So, there's no need for any long-winded prattle.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}