{"id":"d_nikke_liter_05","cat":"bond","group":{"id":"char5011","label":"Liter"},"label":"Death Without Regrets","stage":null,"prev":"d_nikke_liter_04","next":null,"speakers":{"rapi":"Rapi","Self":"Commander","neon":"Neon","liter":"Liter","Monologue":"Monologue","anis":"Anis","volt":"Volt","Narration":"Narration"},"icons":{"rapi":"si_c010_00_s","neon":"si_c011_00_s","liter":"si_c082_00_s","anis":"si_c012_00_s","volt":"si_c933_00_s","Narration":"si_c999_00_s"},"lines":[{"id":"d_nikke_liter_05_1","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_05_1","text":"Welcome back, Commander.","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["rapi","neon","liter"],"affinity":null},{"id":"d_nikke_liter_05_2","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_liter_05_2","text":"How's Anis?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_3","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_05_3","text":"She's still in bed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_4","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_05_4","text":"I saw her playing with her phone in bed.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_5","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_5","text":"... Maybe I should just go back...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_6","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_05_6","text":"Liter, you don't have to be the one to apologize first.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_7","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_7","text":"Who said I was gonna apologize?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_8","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_05_8","text":"Huh? So, you want another fight?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_9","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_9","text":"No, that's not it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_10","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_10","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_11","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_11","text":"I figured I'd just give her some advice from someone who's gone through it all.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_12","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_05_12","text":"... I see.\nHope you have a nice talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_13","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_13","text":"Okay, thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_14","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_liter_05_14","text":"Anis lies in bed with her back turned to everyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":["anis"],"affinity":null},{"id":"d_nikke_liter_05_15","type":"Self","speaker":"Self","key":"Locale_NikkeEpisode:d_nikke_liter_05_15","text":"Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_16","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_16","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_17","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_17","text":"You don't even respond to your Commander now?\nWhere on earth did you learn manners like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_18","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_18","text":"I've got nothing to say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_19","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_19","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_20","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_20","text":"Josh Humett.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_fairytalesend_if","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_21","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_21","text":"??","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_22","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_22","text":"Go on and look him up. You've got your phone in hand anyway, don't you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_23","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_24","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_liter_05_24","text":"For a moment, only the sound of fingers tapping on a phone screen fills the air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_25","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_25","text":"A Commander who was killed in action 15 years ago.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_26","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_26","text":"And?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_27","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_27","text":"There's nothing else. What was the point of that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_28","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_28","text":"That's the future that awaits you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_29","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_29","text":"Ah, you mean death? You don't have to tell me what I already know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_30","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_30","text":"Whether it's a Rapture or some accident, I'm gonna die anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_31","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_31","text":"You'll die leaving behind nothing","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_32","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_32","text":"but a meaningless name and a record of your death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_33","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_33","text":"So what?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_34","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_34","text":"Josh Humett.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_35","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_35","text":"He was my Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_36","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_36","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_37","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_37","text":"Just like today, back then there were plenty of hopeless, good-for-nothing Commanders.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_38","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_38","text":"But Josh was the only one shining among all that trash.","jump":null,"exit":false,"enter":null,"bg":"JunkMountain","bgArt":"junkmountain","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_39","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_39","text":"He was kind, considerate, and still had a conscience.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_40","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_40","text":"A fine fellow he was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_41","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_41","text":"If I had to pick one flaw, it would be that he lived life on a whim.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["rapi"],"affinity":null},{"id":"d_nikke_liter_05_42","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_42","text":"He didn't have any dreams about the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon"],"affinity":null},{"id":"d_nikke_liter_05_43","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_43","text":"Back then, I didn't think it was wrong.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_44","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_44","text":"I was just like you, Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_45","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_45","text":"I couldn't understand what the point was in dreaming about the future when you don't even know when you'll die.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_46","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_46","text":"Still...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_47","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_47","text":"And Josh Humett died.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_48","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_48","text":"He was killed by a Rapture during an operation,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_49","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_49","text":"while protecting a Nikke.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_50","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_50","text":"That naive girl who had just come up to the surface for the first time and was excitedly wandering all over the place.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_51","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_51","text":"...","jump":null,"exit":false,"enter":null,"bg":"NikkeRoom","bgArt":"nikkeroom","image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_52","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_52","text":"He never dreamed about the future.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_53","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_53","text":"So when he shut his eyes, it looked like he died satisfied.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_54","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_54","text":"And that should've been enough.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_55","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_55","text":"At least, it seemed like it, anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_56","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_56","text":"But the problem came after he died.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_57","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_57","text":"The Central Government sent someone to sort through his belongings.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_58","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_58","text":"One of them said,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_59","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_59","text":"\"Sheesh, this guy lived a total mess of a life. There's nothing worth keeping, huh?\"","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_60","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_60","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_61","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_61","text":"That's what it came down to.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_62","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_62","text":"Josh Humett killed in action. And that's all you'll find if you look him up.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_63","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_63","text":"Not a single thing was left to show what kind of person he was.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_64","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_64","text":"I'm the only one who truly knows about him.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_65","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_65","text":"That poor guy just left this world without leaving anything behind.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_66","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_66","text":"And because of that, he even became the subject of all sorts of nasty rumors.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_67","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_67","text":"They say that he harassed Nikkes, that he embezzled squad funds, and whatnot. Filthy lies, the lot of 'em.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_68","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_68","text":"What does it matter? The dead can't see or hear a damn thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_69","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_69","text":"It's the ones left behind who have it the hardest.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_70","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_71","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_71","text":"I told them he wasn't that kind of person, that they'd all gotten the wrong idea... but it was no use.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_72","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_72","text":"With nothing left behind to prove it, my words were no different from shouting into thin air.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_73","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_73","text":"And so, his death remains incomplete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_74","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_74","text":"A sad thing, that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_75","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_75","text":"You're... prepping for death?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_76","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_76","text":"Yes, every day.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_77","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_77","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_78","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_78","text":"Dream of the future and leave proof of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_79","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_79","text":"Leave traces throughout your life that show you lived fully, and let them speak on your behalf.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_80","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_80","text":"Even if you suddenly die one day, you'll go with a complete death.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_81","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_81","text":"That way, those left behind won't have to suffer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_82","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_82","text":"... I know it well. You're a good kid, Anis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_83","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_83","text":"That's why I hope your death will be complete.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_84","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_84","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_85","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_liter_05_85","text":"Anis gets up slowly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_86","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_86","text":"Well, that's not gonna be easy.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_87","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_87","text":"Aye, that's right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_88","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_88","text":"Let's clean things up then.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":["neon","rapi"],"affinity":null},{"id":"d_nikke_liter_05_89","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_89","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"none","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_90","type":"Speech","speaker":"rapi","key":"Locale_NikkeEpisode:d_nikke_liter_05_90","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_91","type":"Speech","speaker":"neon","key":"Locale_NikkeEpisode:d_nikke_liter_05_91","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_92","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_92","text":"Uh... I get the whole thing about a completed death and all,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":"bgm_story_herecomestrouble","movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_93","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_93","text":"but what does that have to do with cleaning?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_94","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_94","text":"Cleaning is the absolute basics of leading a fulfilled life.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_95","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_95","text":"If you can't handle that right, how can you dream of the future?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_96","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_96","text":"Huh? So it's part of the training? Like, how to live right or something?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_97","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_97","text":"It sure is. Took you long enough to get it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_98","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_98","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_99","type":"Speech","speaker":"anis","key":"Locale_NikkeEpisode:d_nikke_liter_05_99","text":"All right, I'll just go to the bathroom real quick.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_100","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_100","text":"Sure thing.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_101","type":"Monologue","speaker":"Monologue","key":"Locale_NikkeEpisode:d_nikke_liter_05_101","text":"Anis slips away quietly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_102","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_102","text":"Now, Volt, let's go wait by the window outside the building.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_103","type":"Speech","sp