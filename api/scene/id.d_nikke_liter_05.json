_110","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_liter_05_110","text":"Are you satisfied now?","jump":"d_nikke_liter_05_112","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_111","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_111","text":"It's nothing. Anis did all the work.","jump":"d_nikke_liter_05_113","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_112","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_112","text":"Well, I can't say for sure.","jump":"d_nikke_liter_05_113","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_113","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_113","text":"I don't expect Anis to change overnight, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_114","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_114","text":"As long as she changes, it's okay if it takes time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_115","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_115","text":"After all, we Nikkes have plenty of time.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_liter_05_116","type":"Speech","speaker":"liter","key":"Locale_NikkeEpisode:d_nikke_liter_05_116","text":"So, Greenhorn, here's what you have to do: keep Anis alive until she changes.","jump":null,"exit":false,"enter":null,"bg":null,