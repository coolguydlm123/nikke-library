":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_6","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_6","text":"There are still more tests to run,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_7","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_7","text":"and I'd like to gather some additional data while I'm at it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_8","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_8","text":"Cecil meets Scarlet's gaze.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_9","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_9","text":"... But it's important not to leave anything unresolved, either.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_10","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_10","text":"We'll have time while Rapunzel undergoes her tests.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_11","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_11","text":"Now, which flower shall I prepare for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_12","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_12","text":"I would fain behold a rose.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_13","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_13","text":"Unfortunately, we don't have any roses growing in Eden at the moment.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_14","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_14","text":"Alas,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_15","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_15","text":"'tis a pity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_16","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_16","text":"But we do have rose seeds.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_17","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_17","text":"If those will do, shall I prepare some for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_18","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_18","text":"Aye, 'twould please me greatly!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_19","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_19","text":"I should like nothing better than to plant them with mine own hands.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_20","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_20","text":"Understood.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_21","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_21","text":"Thou hast my thanks, Maiden Cecil.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_22","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_22","text":"Might I trouble thee for a few more favors, perchance?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_23","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_23","text":"By all means.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_24","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_24","text":"Forgive me for troubling thee yet again,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_25","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_25","text":"but wouldst thou procure me a small sign and a wine cup?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_26","type":"Speech","speaker":"cecil","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_26","text":"... Do you need alcohol as well?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_27","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_27","text":"If it be possible, I should welcome it gladly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_28","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_28","text":"But for now, water shall suffice.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_29","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_29","text":"When all is done and we have returned,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_30","type":"Speech","speaker":"hongryeon_g","key":"Locale_NikkeEpisode:d_nikke_hongryeon_goddeath_03_30","text":"then shall we share a cup and converse at our leisure.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_hongryeon_goddeath_03_31","type":"Speech","speaker":"cecil","key"