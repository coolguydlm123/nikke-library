{"id":"d_main_06_03","cat":"main","group":{"id":"ch6","label":"Chapter 6 · Pilgrim"},"label":"Cozy Rest","stage":"6-6 STAGE · End","prev":"d_main_06_02","next":"d_main_06_04","speakers":{"ludmilla":"Ludmilla","Self":"Commander","alice":"Alice","rapi":"Rapi","Narration":"Narration","anis":"Anis"},"icons":{"ludmilla":"si_c190_00_s","alice":"si_c191_00_s","rapi":"si_c010_00_s","Narration":"si_c999_00_s","anis":"si_c012_00_s"},"lines":[{"id":"d_main_06_03_1","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_1","text":"Rest in here.","jump":null,"exit":false,"enter":null,"bg":"ArkRuinIndoor","bgArt":"arkruinindoor","image":null,"bgm":"bgm_frostpillar","movie":null,"shown":["alice","ludmilla","rapi","anis","neon"],"affinity":null},{"id":"d_main_06_03_2","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_03_2","text":"Seems like you've been following the Pilgrims for a while now. Why?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_3","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_3","text":"Do you really want to know?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_4","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_4","text":"Two reasons.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_5","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_5","text":"One, I'd rather not say.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_6","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_6","text":"Two, I just feel like this is something