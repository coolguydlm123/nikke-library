,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_43","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_06_03_43","text":"They may have woken up!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_06_03_44","text":"... Sleeping princesses?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_45","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_45","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_46","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_06_03_46","text":"We must leave at once!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_47","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_47","text":"... Okay, let's go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}