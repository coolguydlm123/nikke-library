6_03_14","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_03_14","text":"Alice bounds over to you and sits down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_15","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_03_15","text":"Despite yourself, you do feel a certain sense of warmth.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_16","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:d_main_06_03_16","text":"Is that a heating suit?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_17","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_17","text":"No, it's a cooling suit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_18","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_18","text":"Alice's body temperature is abnormally high. This suit helps suppress it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_19","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_19","text":"If you spread yourself too thin, you won't get a wink of sleep. Alice should be able to help you with that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_20","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_06_03_20","text":"Does that feel warm, Rabbity?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_21","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_03_21","text":"... You can't help but close your eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_22","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_03_22","text":"A wave of exhaustion washes over you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_23","type":"Speech","speaker":"alice","key":"Locale_MainScenario:d_main_06_03_23","text":"Don't worry, I'll be right here.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_24","type":"Self","speaker":"Self","key":"Locale_MainScenario:d_main_06_03_24","text":"You close your eyes.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_25","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_03_25","text":"A pleasant warmth enshrouds your body.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_26","type":"Speech","speaker":"ludmilla","key":"Locale_MainScenario:d_main_06_03_26","text":"Sleep well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_27","type":"Monologue","speaker":null,"key":"Locale_MainScenario:d_main_06_03_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_06_03_28","type":"Narration","speaker":"Narration","key":"Locale_MainScenario:d_main_06_03_28","text":