":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_62","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_62","text":"... Cheers.","jump":"d_nikke_dolla_05_64","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_63","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_63","text":"Cheers!","jump":"d_nikke_dolla_05_64","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_64","type":"Monologue","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_64","text":"Dolla looks this way, quietly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_65","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_65","text":"How are you feeling?","jump":"d_nikke_dolla_05_67","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_66","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_66","text":"Will you stop messing with the Dark Net?","jump":"d_nikke_dolla_05_75","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_67","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_67","text":"Oh, Client, you also know that we... are different from humans.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_68","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_68","text":"When the pain sensor turns off, we don't feel the pain or anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_69","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_69","text":"But it's usually on most of the time. So being injured is still a bummer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_70","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_70","text":"I'm sorry I couldn't save you earlier.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_71","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_71","text":"... What?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_72","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_72","text":"You fool. You would be a burden in that situation.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_73","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_73","text":"It had been so hard to take care of myself. What more taking care of you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_74","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_74","text":"But... thank you for saying that.","jump":"d_nikke_dolla_05_85","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_75","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_75","text":"... No.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_76","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_76","text":"That is something I can't give up, no matter how much I like you, Client.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_77","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_77","text":"I must climb to the top of the Ark by all means, and the Dark Net is the best tool.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_78","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_78","text":"It would be a high loss for me to abandon it, but...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_79","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_79","text":"I promise you that I won't get wounded like that once more.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_80","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_80","text":"After all, you said it was for my sake, right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_81","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_81","text":"I respect your decision.","jump":"d_nikke_dolla_05_83","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_82","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_82","text":"I will watch you, as a commander.","jump":"d_nikke_dolla_05_84","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_83","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_83","text":"... Thank you, Client. You really understand everything I'm thinking.","jump":"d_nikke_dolla_05_85","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_84","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_84","text":"You can do whatever you want and keep watching me until I take over all the Big Three.","jump":"d_nikke_dolla_05_85","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_85","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_85","text":"I finish the drink in the glass.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_86","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_86","text":"... Listen, Client.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_87","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_87","text":"Although this time, I was a bit reckless, I gained a lot.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_88","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_88","text":"Actually, the buyers of those corpses are the personnel of Missilis.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_89","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_89","text":"They contacted me today and said they want to hang our company's large screen on the external wall of their head office.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_90","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_90","text":"They selected us among a few other companies... Because through that transaction, we impressed them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_91","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_91","text":"... After the big screen set up, the return for marketing should be very remarkable.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_92","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_92","text":"The symbol of high-tech, the product chosen by Missilis. How was that for a slogan?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_93","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_93","text":"All of this won't be \"acting upon a plan,\" will it?","jump":"d_nikke_dolla_05_95","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_94","type":"Choice","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_94","text":"It won't be long before you take over the Ark's economy.","jump":"d_nikke_dolla_05_97","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_95","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_95","text":"Of course. I won't start anything without being clear about the profits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_96","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_96","text":"I'll slowly build my margins, and everyone will finally remember my existence.","jump":"d_nikke_dolla_05_99","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_97","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_97","text":"Seriously, I'm not kidding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_98","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_98","text":"Just wait and see. One day I will let everyone remember my existence.","jump":"d_nikke_dolla_05_99","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_99","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_99","text":"They'll remember me not as a \"Nikke,\" a combat weapon, but as the best entrepreneur of the century.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_100","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_100","text":"So, another drink?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_101","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_101","text":"Two orders of Smooch in the Sand.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_102","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_102","text":"... I guess that you like this name very much, correct?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_103","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_103","text":"Well, I like it too, if it's with... you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_104","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_104","text":"How about trying it once? Although this is not the beach.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_105","type":"Self","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_105","text":"I nod.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_106","type":"Speech","speaker":"dolla","key":"Locale_NikkeEpisode:d_nikke_dolla_05_106","text":"Then close your eyes, Client.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_107","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_107","text":"You can feel the Softness of the lips.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_nikke_dolla_05_108","type":"Narration","speaker":null,"key":"Locale_NikkeEpisode:d_nikke_dolla_05_108","text":"The sweet scent of tropical fruits flows on your tongue...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}