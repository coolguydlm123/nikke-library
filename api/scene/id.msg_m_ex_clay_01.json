{"id":"msg_m_ex_clay_01","cat":"messenger","group":{"id":"room_clay","label":"Clay · Nikke"},"label":"1. Hi Coach!","stage":null,"prev":null,"next":"msg_m_ex_clay_02","speakers":{"clay":"Clay"},"icons":{"clay":"si_c551_00_s"},"lines":[{"id":"m_ex_clay_01_1","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_1","text":"Hi Coach!","jump":null},{"id":"m_ex_clay_01_2","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_2","text":"This is Clay","jump":null},{"id":"m_ex_clay_01_3","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_3","text":"from Rewind! Hehehe!","jump":null},{"id":"m_ex_clay_01_4","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_clay_01_4","text":"Hello, Clay.","jump":null},{"id":"m_ex_clay_01_5","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_5","text":"Hehe! I heard I'll be working together with you,","jump":null},{"id":"m_ex_clay_01_6","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_6","text":"so I wanted to pop in and say hi!","jump":null},{"id":"m_ex_clay_01_7","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_7","text":"As far as cheerleading goes, I'm still working on some of the more difficult moves,","jump":null},{"id":"m_ex_clay_01_8","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_8","text":"but I'm confident in my ability","jump":null},{"id":"m_ex_clay_01_9","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_9","text":"to engage with the audience.","jump":null},{"id":"m_ex_clay_01_10","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_10","text":"I'll put my best foot forward with everything we do,","jump":null},{"id":"m_ex_clay_01_11","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_11","text":"promise!","jump":null},{"id":"m_ex_clay_01_12","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_clay_01_12","text":"Glad to hear that!","jump":null},{"id":"m_ex_clay_01_13","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_13","text":"Hehe.","jump":null},{"id":"m_ex_clay_01_14","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_14","text":"I'm in the practice room now,","jump":null},{"id":"m_ex_clay_01_15","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_15","text":"getting ready for our next competition!","jump":null},{"id":"m_ex_clay_01_16","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_16","text":"I can't believe that","jump":null},{"id":"m_ex_clay_01_17","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_17","text":"I'm actually practicing with Bay, my role model!","jump":null},{"id":"m_ex_clay_01_18","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_18","text":"Thinking back, I was sooo lucky during my audition!","jump":null},{"id":"m_ex_clay_01_19","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_19","text":"Hehehe.","jump":null},{"id":"m_ex_clay_01_20","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_clay_01_20","text":"It wasn't luck. You worked hard to get where you are.","jump":null},{"id":"m_ex_clay_01_21","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_21","text":"Oh no, not at all! T_T","jump":null},{"id":"m_ex_clay_01_22","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_22","text":"I still have a long way to go, so I need to work even harder!","jump":null},{"id":"m_ex_clay_01_23","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_23","text":"That way, Bay and I can ensure that Rewind stays up and running.","jump":null},{"id":"m_ex_clay_01_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_clay_01_24","text":"You're quite impressive.","jump":null},{"id":"m_ex_clay_01_25","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_25","text":"Thanks, hehe.","jump":null},{"id":"m_ex_clay_01_26","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_26","text":"For that, today's training is all about honing in on my rhythm!","jump":null},{"id":"m_ex_clay_01_27","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_27","text":"Oh,","jump":null},{"id":"m_ex_clay_01_28","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_28","text":"Bay just got back.","jump":null},{"id":"m_ex_clay_01_29","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_29","text":"I better get back to practice!","jump":null},{"id":"m_ex_clay_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_clay_01_30","text":"Good luck.","jump":null},{"id":"m_ex_clay_01_31","type":"Speech","speaker":"clay","key":"Locale_SuddenMessage:m_ex_clay_01_31","text":"Same to you, Coach!","jump":null}],"chat":true}