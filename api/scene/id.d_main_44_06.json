{"id":"d_main_44_06","cat":"main","group":{"id":"ch44","label":"Chapter 44 · Path"},"label":"The Unknown Tears","stage":"44-30 STAGE · Start","prev":"d_main_44_05","next":"d_main_44_07","speakers":{"cecil_op_r":"Cecil","anis_i":"Anis","rapi_red":"Rapi","papillon_op_l":"Papillon","snowwhite_h":"Snow White"},"icons":{"cecil_op_r":"si_c929_00_s","anis_i":"si_c017_00_s","rapi_red":"si_c016_00_s","papillon_op_l":"si_c890_00_s","snowwhite_h":"si_c471_00_s"},"lines":[{"id":"d_main_44_06_1","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_1","text":"Leaving already? You just got here.","jump":null,"exit":false,"enter":null,"bg":"Eden","bgArt":"eden","image":null,"bgm":"bgm_chapter44_field_ashesofeden","movie":null,"shown":["anis_i","rapi_red","cecil_op_r","papillon_op_l"],"affinity":null},{"id":"d_main_44_06_2","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_06_2","text":"Yeah. We have to move fast.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_3","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_3","text":"The fact that you haven't brought up Vapaus tells me you've decided to resolve it yourself at the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_4","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_06_4","text":"That's right... It won't be on Eden's level, but we can forge it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_5","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_5","text":"Awfully bold of you to trust the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_6","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_6","text":"But it's the right call. A situation could arise at any time in Eden.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_7","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_7","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_8","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_8","text":"If you bring us the technology to manufacture Nikkes, we'll provide you with the technology to manufacture Vapaus bullets.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_9","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_9","text":"Consider it a technological exchange.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_06_10","text":"I thought you hated the Ark?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_11","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_11","text":"I do. That much goes without saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_12","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_12","text":"However, this is for your benefit as well. It's impossible to maintain a good relationship where only one side benefits.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_13","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_06_13","text":"Wow, look at you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_14","type":"Speech","speaker":"cecil_op_r","key":"Locale_MainScenario:d_main_44_06_14","text":"All right then, get home safe. I'll be waiting to hear from you.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_15","type":"Narration","speaker":null,"key":"Locale_MainScenario:d_main_44_06_15","text":"*Beep*","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_16","type":"Speech","speaker":"anis_i","key":"Locale_MainScenario:d_main_44_06_16","text":"Well, aren't you busy, Commander.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_17","type":"Speech","speaker":"rapi_red","key":"Locale_MainScenario:d_main_44_06_17","text":"It's like this wherever we go.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_18","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_44_06_18","text":"Papillon...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_19","type":"Speech","speaker":"papillon_op_l","key":"Locale_MainScenario:d_main_44_06_19","text":"Hmm? Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_44_06_