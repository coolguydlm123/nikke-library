{"id":"d_counseling_ether_04","cat":"counsel","group":{"id":"char3010","label":"Ether"},"label":"Advising Ether: 04","stage":null,"prev":"d_counseling_ether_03","next":"d_counseling_ether_05","speakers":{"ether":"Ether"},"icons":{"ether":"si_c291_00_s"},"lines":[{"id":"d_counseling_ether_04_1","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_1","text":"Hey, No.7.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["ether"],"affinity":"_0"},{"id":"d_counseling_ether_04_2","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_2","text":"How would you feel if I used you as a test subject for some dangerous experiments?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_04_3","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ether_04_3","text":"Just give me a heads-up beforehand.","jump":"d_counseling_ether_04_5","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_ether_04_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_ether_04_4","text":"I don't believe you'd do something like that.","jump":"d_counseling_ether_04_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_ether_04_5","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_5","text":"You actually think I'd do that to you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_04_6","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_6","text":"That makes me a little sad.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_04_7","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_7","text":"I always think I take pretty good care of you, in my own special way.","jump":"d_counseling_ether_04_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_04_8","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_8","text":"Precisely! How could I ever subject my precious No. 7 to experiments like that?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_04_9","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_9","text":"I'm glad you have so much faith in me. Don't let that change.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_04_10","type":"Speech","speaker":"ether","key":"Locale_Counseling:d_counseling_ether_04_10","text":"No matter what I tell you to do, you have to do it, because you trust me. Right?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_ether_04_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_ether_04_11","text":"I tell Ether not to carry out any more dangerous experiments.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}