{"id":"d_main_25_06","cat":"main","group":{"id":"ch25","label":"Chapter 25 · Tracking"},"label":"Only Did My Best","stage":"25-21 STAGE · Start","prev":"d_main_25_05_e","next":"d_main_25_07_s","speakers":{"anis":"Anis","neon":"Neon","dorothy":"Dorothy"},"icons":{"anis":"si_c012_00_s","neon":"si_c011_00_s","dorothy":"si_c233_00_s"},"lines":[{"id":"d_main_25_06_1","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_06_1","text":"Anis, Neon.","jump":null,"exit":false,"enter":null,"bg":"CityForest_03","bgArt":"cityforest_03","image":null,"bgm":"bgm_chaser","movie":null,"shown":["anis","neon"],"affinity":null},{"id":"d_main_25_06_2","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_2","text":"Yes?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_3","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_3","text":"What's up?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_4","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_06_4","text":"Are you okay?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_5","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_5","text":"Yes. I'm okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_6","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_6","text":"I was a bit hurt though.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_7","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_06_7","text":"I don't believe she intended to be malicious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_8","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_8","text":"Are you kidding? She was as hostile as could be.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_9","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_9","text":"Calling us useless sacks of dog crap that hold people back... right to our faces!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_10","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_06_10","text":"... She didn't quite phrase it like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_11","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_11","text":"Whose side are you on, Commander?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_12","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_12","text":"We've been through hell and high water together,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_13","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_13","text":"but it sounds to me like you're siding with someone you've just met.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_14","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_14","text":"You need to pick a side right now. Otherwise, we're going on strike.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_15","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_06_15","text":"I didn't mean it like that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_16","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_16","text":"We were only kidding.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_17","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_17","text":"We were?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_18","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_18","text":"... Well, there was some truth to it...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_19","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_19","text":"I know that Neon and I weren't much help during the recent incident in the Ark.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_20","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_20","text":"Crow played us for fools, and then when the Heretics and Chatterbox appeared,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_21","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_21","text":"our contribution didn't exactly amount to much.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_22","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_22","text":"What? That's not true. I made a lotta contributions.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_23","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_23","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_24","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_24","text":"Didn't I?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_25","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_25","text":"Even though Rapi did all the heavy lifting,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_26","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_26","text":"that's not to say you didn't do anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_27","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_27","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_28","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_28","text":"Oh, for crying out loud, fine. You played a crucial role.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_29","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_29","text":"Better?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_30","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_30","text":"I... I guess...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_31","type":"Self","speaker":null,"key":"Locale_MainScenario:d_main_25_06_31","text":"You did great, Neon.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_32","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_32","text":"... Okay.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_33","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_33","text":"Anyway, Dorothy wasn't entirely off the mark with her comments.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_34","text":"To keep it 100% real between us, I've felt it too.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_35","text":"We've been really struggling ever since Rapi disappeared.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_36","text":"The Commander has had to take on more and more responsibilities, while I personally haven't made notable improvements.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_37","text":"Now, that's not to say that I haven't improved. I have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_38","text":"However, I think I'm quickly approaching my limit.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_39","text":"To be fair though, fighting on the battlefield has never been my bag.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_40","text":"If I keep this up...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_41","text":"Well... you know.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_42","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_42","text":"I might really end up dragging Rapi or the Commander down.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_43","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_43","text":"Since we're being honest with each other, I've been somewhat concerned about my lack of firepower.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_44","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_44","text":"Is there any kind of hack I can use to boost up several levels at once?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_45","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_45","text":"I doubt it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_46","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_46","text":"The world rewards time and dedication with these things.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_47","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_47","text":"The truth hurts.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_48","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_48","text":"That it does.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_49","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_49","text":"But Anis...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_50","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_50","text":"You know how we are. Don't you think we could use a little more confidence?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_51","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_51","text":"There's a fine line between confidence and delusion.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_52","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_52","text":"That's not what I'm saying.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_53","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_53","text":"If we always compare ourselves to Rapi, we're bound to come up short.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_54","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_54","text":"Unless we stop doing that, we won't be able to do anything.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_55","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_55","text":"Sure, there are areas in which we're lacking,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_56","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_56","text":"but there are just as many where we excel.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_57","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_57","text":"Instead of beating ourselves up about how we might be a burden, how we're pulling our weight, etc.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_58","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_58","text":"I say we could use a bit more confidence.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_59","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_59","text":"It's all about giving our best with the assets we have.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_60","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_60","text":"You think so?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_61","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_61","text":"Of course.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_62","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_62","text":"I guess you're right.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_63","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_63","text":"Rapi wouldn't have cared one iota about all this anyway.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_64","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_64","text":"She'd never feel that she was the only one doing all the heavy lifting.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_65","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_65","text":"She's always given her best,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_66","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_66","text":"but she never lorded it over us or anyone else. She never looked down on anyone or acted superior.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_67","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_67","text":"Whatever the outcome, she simply did her best, and she would be happy if things went well.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_68","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_68","text":"If things didn't go well, she didn't blame anyone.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_69","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_69","text":"She would chalk it up to luck.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_70","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_70","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_71","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_71","text":"This might sound conceited, but I believe the reason Rapi is like that","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_72","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_72","text":"was because she had trustworthy squadmates who brought out the best in her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_73","type":"Speech","speaker":"neon","key":"Locale_MainScenario:d_main_25_06_73","text":"Us.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_74","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_74","text":"Exactly.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_75","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_75","text":"That's why, even at a time like this,","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_76","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_76","text":"she believed in us and rushed ahead.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_77","type":"Speech","speaker":"anis","key":"Locale_MainScenario:d_main_25_06_77","text":"She knew we would come to find her.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_25_06_78","type":"Speech","speaker":"neon","key