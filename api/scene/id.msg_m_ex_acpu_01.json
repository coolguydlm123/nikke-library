{"id":"msg_m_ex_acpu_01","cat":"messenger","group":{"id":"room_acpu","label":"A.C.P.U. · Group"},"label":"1. I have a question!","stage":null,"prev":null,"next":"msg_m_ex_acpu_02","speakers":{"miranda":"Miranda","poli":"Poli"},"icons":{"miranda":"si_c032_00_s","poli":"si_c030_00_s"},"lines":[{"id":"m_ex_acpu_01_1","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_1","text":"I have a question!","jump":null},{"id":"m_ex_acpu_01_2","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_2","text":"No texting while on duty.","jump":null},{"id":"m_ex_acpu_01_3","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_3","text":"Aren't you responsible for traffic direction today?","jump":null},{"id":"m_ex_acpu_01_4","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_4","text":"Don't forget citizens are watching you!","jump":null},{"id":"m_ex_acpu_01_5","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_5","text":"Ah, texting is prohibited?!","jump":null},{"id":"m_ex_acpu_01_6","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_6","text":"Yes, it is!","jump":null},{"id":"m_ex_acpu_01_7","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_7","text":"So how come you're texting right now?","jump":null},{"id":"m_ex_acpu_01_8","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_8","text":"Cuz I'm not responsible for enforcing traffic today!","jump":null},{"id":"m_ex_acpu_01_9","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_9","text":"I see!","jump":null},{"id":"m_ex_acpu_01_10","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_10","text":"Emm...","jump":null},{"id":"m_ex_acpu_01_11","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_11","text":"But","jump":null},{"id":"m_ex_acpu_01_12","type":"Speech","speaker":"poli",