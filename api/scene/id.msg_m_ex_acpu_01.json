ll},{"id":"m_ex_acpu_01_26","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_26","text":"Huh?","jump":null},{"id":"m_ex_acpu_01_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_acpu_01_27","text":"Where? And when?","jump":null},{"id":"m_ex_acpu_01_28","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_28","text":"I was supposed to be on duty downtown,","jump":null},{"id":"m_ex_acpu_01_29","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_29","text":"and I suddenly realized there were unfamiliar buildings all around me!","jump":null},{"id":"m_ex_acpu_01_30","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_acpu_01_30","text":"Aren't you a police officer?","jump":null},{"id":"m_ex_acpu_01_31","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_31","text":"Yup, I know!","jump":null},{"id":"m_ex_acpu_01_32","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_acpu_01_32","text":"So how could you get lost while on duty?","jump":null},{"id":"m_ex_acpu_01_33","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_33","text":"That's what I wanna know.","jump":null},{"id":"m_ex_acpu_01_34","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_34","text":"Ah.","jump":null},{"id":"m_ex_acpu_01_35","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_35","text":"I wanted to find a high-rise building,","jump":null},{"id":"m_ex_acpu_01_36","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_36","text":"... but I lost all my sense of direction on the way.","jump":null},{"id":"m_ex_acpu_01_37","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_37","text":"I thought you're tasked with traffic enforcement today.","jump":null},{"id":"m_ex_acpu_01_38","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_38","text":"Yep!","jump":null},{"id":"m_ex_acpu_01_39","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_39","text":"Then, why would you find a high-rise building?","jump":null},{"id":"m_ex_acpu_01_40","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_40","text":"A high-rise building offers a better view!","jump":null},{"id":"m_ex_acpu_01_41","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_41","text":"Aha","jump":null},{"id":"m_ex_acpu_01_42","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_42","text":"Got it.","jump":null},{"id":"m_ex_acpu_01_43","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_43","text":"Miranda","jump":null},{"id":"m_ex_acpu_01_44","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_44","text":"Eh?","jump":null},{"id":"m_ex_acpu_01_45","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_45","text":"I will tell them you're performing a special task today.","jump":null},{"id":"m_ex_acpu_01_46","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_46","text":"So, find your way back by yourself, Okay?","jump":null},{"id":"m_ex_acpu_01_47","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_47","text":"Huh?","jump":null},{"id":"m_ex_acpu_01_48","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_48","text":"As a police officer, you shouldn't get lost!","jump":null},{"id":"m_ex_acpu_01_49","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_49","text":"Such a shame!","jump":null},{"id":"m_ex_acpu_01_50","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_50","text":"I won't help you find the way back!!!","jump":null},{"id":"m_ex_acpu_01_51","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_51","text":"How can I get back myself when I'm already lost?","jump":null},{"id":"m_ex_acpu_01_52","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_52","text":"No idea!","jump":null},{"id":"m_ex_acpu_01_53","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_53","text":"Since you're so fond of tall buildings,","jump":null},{"id":"m_ex_acpu_01_54","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_54","text":"go find one and use the nice view you love so much to find the right way, woof!","jump":null},{"id":"m_ex_acpu_01_55","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_55","text":"!!!!!","jump":null},{"id":"m_ex_acpu_01_56","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_56","text":"So that's how you do it!","jump":null},{"id":"m_ex_acpu_01_57","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_57","text":"As expected of an experienced officer like Poli!!","jump":null},{"id":"m_ex_acpu_01_58","type":"Speech","speaker":"miranda","key":"Locale_SuddenMessage:m_ex_acpu_01_58","text":"I'll go find the right way now!!!!","jump":null},{"id":"m_ex_acpu_01_59","type":"Speech","speaker":"poli","key":"Locale_SuddenMessage:m_ex_acpu_01_59","text":"Whoa.","jump":null},{"id":"m_ex_acpu_01_60","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_acpu_01_60","text":"Good luck.","jump":null}],"chat":true}