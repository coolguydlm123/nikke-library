{"id":"d_counseling_trina_05","cat":"counsel","group":{"id":"char5134","label":"Trina"},"label":"Advising Trina: 05","stage":null,"prev":"d_counseling_trina_04","next":"d_counseling_trina_06","speakers":{"trina":"Trina"},"icons":{"trina":"si_c412_00_s"},"lines":[{"id":"d_counseling_trina_05_1","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_1","text":"The birds above my head all have different personalities.","jump":null,"exit":false,"enter":null,"bg":"CommanderRoom","bgArt":"commanderroom","image":null,"bgm":"bgm_story_backtonormal","movie":null,"shown":["trina"],"affinity":"_0"},{"id":"d_counseling_trina_05_2","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_2","text":"This means they often quarrel, but they always stick close to me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_05_3","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_3","text":"Haha, even though I see them every day, they never cease to intrigue me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_05_4","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_05_4","text":"Maybe they mistook you for a nest.","jump":"d_counseling_trina_05_6","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_100"},{"id":"d_counseling_trina_05_5","type":"Choice","speaker":null,"key":"Locale_Counseling:d_counseling_trina_05_5","text":"You're their family.","jump":"d_counseling_trina_05_8","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_120"},{"id":"d_counseling_trina_05_6","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_6","text":"Oh, that could be it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_05_7","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_7","text":"My body is often a resting place for them, after all.","jump":"d_counseling_trina_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_05_8","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_8","text":"Oh my goodness!","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_05_9","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_9","text":"People often throw around the term \"pet\" when I bring them up, but that's the first time someone has called them family.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_05_10","type":"Speech","speaker":"trina","key":"Locale_Counseling:d_counseling_trina_05_10","text":"You always find a way to touch my heart, Sun.","jump":"d_counseling_trina_05_11","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_trina_05_11","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_trina_05_11","text":"I talk with Trina about the birds above her head.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}