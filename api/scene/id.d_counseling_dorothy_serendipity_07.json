orothy_s","key":"Locale_Counseling:d_counseling_dorothy_serendipity_07_12","text":"...","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_serendipity_07_13","type":"Speech","speaker":"dorothy_s","key":"Locale_Counseling:d_counseling_dorothy_serendipity_07_13","text":"Did you have something to say to me, Your Grace?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_serendipity_07_14","type":"Speech","speaker":"dorothy_s","key":"Locale_Counseling:d_counseling_dorothy_serendipity_07_14","text":"Don't lurk over there in the distance. Come over here and talk.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_serendipity_07_15","type":"Speech","speaker":"dorothy_s","key":"Locale_Counseling:d_counseling_dorothy_serendipity_07_15","text":"You're distracting me.","jump":"d_counseling_dorothy_serendipity_07_16","exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"},{"id":"d_counseling_dorothy_serendipity_07_16","type":"Narration","speaker":null,"key":"Locale_Counseling:d_counseling_dorothy_serendipity_07_16","text":"I share a somewhat tense tea time with Dorothy.","jump":null,"exit":false,"enter":null,"bg":"none","bgArt":"none","image":null,"bgm":null,"movie":null,"shown":null,"affinity":"_0"}]}