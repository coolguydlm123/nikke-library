lready getting up in my grill?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_33","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_33","text":"I'm not looking to pick a fight. I'm simply curious.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_34","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_34","text":"Well... No reason in particular.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_35","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_35","text":"I'm just tired of it.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_36","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_36","text":"Tired of having to risk my life every day, following orders from morons who wouldn't know their ass from a hole in the ground.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_37","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_37","text":"They're always spouting off gibberish about how Nikkes are supposed to risk their lives for humanity.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_38","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_38","text":"Honestly, I don't care all that much about humanity reclaiming the surface and all that.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_39","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_39","text":"The people in the Ark are garbage. All of them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_40","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_40","text":"Being told to do this and that really gets on my nerves.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_41","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_41","text":"So I didn't listen to them, and this is where it got me.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_42","type":"Speech","speaker":"rapi","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_42","text":"Amazing. Many people have the same thoughts as you, but few act on them.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_43","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilogue_43","text":"... Thanks.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"event_footstepwalkrun2_epilogue_44","type":"Speech","speaker":"anis","key":"Locale_MainScenario:event_footstepwalkrun2_epilo