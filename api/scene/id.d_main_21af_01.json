ity":null},{"id":"d_main_21af_01_56","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_21af_01_56","text":"Just think of the publicity. Isn't that enough for you?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21af_01_57","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_21af_01_57","text":"... I suppose so.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21af_01_58","type":"Speech","speaker":"papillon","key":"Locale_MainScenario:d_main_21af_01_58","text":"Then what would the Ark gain from welcoming you back into the fold?","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21af_01_59","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_21af_01_59","text":"I can give them what they've been so curious about.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21af_01_60","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_21af_01_60","text":"The one thing they've been dying to have, but could never obtain.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null},{"id":"d_main_21af_01_61","type":"Speech","speaker":"dorothy","key":"Locale_MainScenario:d_main_21af_01_61","text":"I will give them all that Eden has to offer.","jump":null,"exit":false,"enter":null,"bg":null,"bgArt":null,"image":null,"bgm":null,"movie":null,"shown":null,"affinity":null}]}