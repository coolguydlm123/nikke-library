{"id":"msg_m_ex_admi_05","cat":"messenger","group":{"id":"room_admi","label":"Admi · Nikke"},"label":"5. Commander.","stage":null,"prev":"msg_m_ex_admi_04","next":"msg_m_ex_admi_06","speakers":{"admi":"Admi"},"icons":{"admi":"si_c172_00_s"},"lines":[{"id":"m_ex_admi_05_1","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_1","text":"Commander.","jump":null},{"id":"m_ex_admi_05_2","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_2","text":"What's wrong?","jump":null},{"id":"m_ex_admi_05_3","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_3","text":"I...","jump":null},{"id":"m_ex_admi_05_4","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_4","text":"...","jump":null},{"id":"m_ex_admi_05_5","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_5","text":"...","jump":null},{"id":"m_ex_admi_05_6","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_6","text":"...","jump":null},{"id":"m_ex_admi_05_7","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_7","text":"What is it?","jump":null},{"id":"m_ex_admi_05_8","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_8","text":"It's a bit hard to say.","jump":null},{"id":"m_ex_admi_05_9","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_9","text":"Does it have something to do with Privaty?","jump":"m_ex_admi_05_11"},{"id":"m_ex_admi_05_10","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_10","text":"Does it have something to do with Yulha?","jump":"m_ex_admi_05_13"},{"id":"m_ex_admi_05_11","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_11","text":"!!","jump":null},{"id":"m_ex_admi_05_12","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_12","text":"How did you know?","jump":"m_ex_admi_05_17"},{"id":"m_ex_admi_05_13","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_13","text":"No.","jump":null},{"id":"m_ex_admi_05_14","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_14","text":"Yulha did give me a scolding, but that was it.","jump":null},{"id":"m_ex_admi_05_15","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_15","text":"Then, it's got to be Privaty.","jump":null},{"id":"m_ex_admi_05_16","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_16","text":"!!","jump":"m_ex_admi_05_17"},{"id":"m_ex_admi_05_17","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_17","text":"Did you two have a fight?","jump":null},{"id":"m_ex_admi_05_18","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_18","text":"No, it's just...","jump":null},{"id":"m_ex_admi_05_19","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_19","text":"Er...","jump":null},{"id":"m_ex_admi_05_20","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_20","text":"...","jump":null},{"id":"m_ex_admi_05_21","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_21","text":"...","jump":null},{"id":"m_ex_admi_05_22","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_22","text":"...","jump":null},{"id":"m_ex_admi_05_23","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_23","text":"I saw something.","jump":null},{"id":"m_ex_admi_05_24","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_24","text":"What did you see?","jump":null},{"id":"m_ex_admi_05_25","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_25","text":"Privaty was carrying my bag","jump":null},{"id":"m_ex_admi_05_26","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_26","text":"and admiring herself in the mirror with a contented expression.","jump":null},{"id":"m_ex_admi_05_27","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_27","text":"Oh.","jump":null},{"id":"m_ex_admi_05_28","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_28","text":"Yeah...","jump":null},{"id":"m_ex_admi_05_29","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_29","text":"Maybe she just thought the bag looked nice and wanted to give it a try.","jump":"m_ex_admi_05_31"},{"id":"m_ex_admi_05_30","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_30","text":"Maybe she wants to feel young again.","jump":"m_ex_admi_05_31"},{"id":"m_ex_admi_05_31","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_31","text":"But what if it's not so simple?","jump":null},{"id":"m_ex_admi_05_32","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_32","text":"I seem to have stumbled upon something I shouldn't have.","jump":null},{"id":"m_ex_admi_05_33","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_33","text":"I'm not sure how I should face Privaty from now on.","jump":null},{"id":"m_ex_admi_05_34","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_34","text":"Sigh, I'm conflicted.","jump":null},{"id":"m_ex_admi_05_35","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_35","text":"Just pretend you didn't see anything and act normally.","jump":"m_ex_admi_05_39"},{"id":"m_ex_admi_05_36","type":"Choice","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_36","text":"Just go ahead and ask her straight up.","jump":"m_ex_admi_05_37"},{"id":"m_ex_admi_05_37","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_37","text":"I'd love to, but I can't seem to bring myself to do it.","jump":null},{"id":"m_ex_admi_05_38","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_38","text":"Then, just act like you didn't see a thing.","jump":"m_ex_admi_05_39"},{"id":"m_ex_admi_05_39","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_39","text":"Yeah, that seems like the best option.","jump":null},{"id":"m_ex_admi_05_40","type":"Self","speaker":null,"key":"Locale_SuddenMessage:m_ex_admi_05_40","text":"Let's keep all this between the two of us.","jump":null},{"id":"m_ex_admi_05_41","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_41","text":"Okay!","jump":null},{"id":"m_ex_admi_05_42","type":"Speech","speaker":"admi","key":"Locale_SuddenMessage:m_ex_admi_05_42","text":"Thank you for listening, Commander.","jump":null}],"chat":true}